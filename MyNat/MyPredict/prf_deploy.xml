<?xml version="1.0" encoding="UTF-8"?>
<!-- ANT_PRF_SCRIPT (do not remove) -->
<!-- (C) Copyright Software AG 2022 -->
<project name="MyNat" default="help">
<description>"Deploy Predict Components"</description>
    <target name="help" description="Show a help screen">
        <!-- display help screen -->
        <echo message="************************************************************************"/>
        <echo message="* Natural Predict Plugin Ant Script"/>
        <echo message="*"/>
        <echo message="* This script supports the deployment processing for Predict"/>
        <echo message="*"/>
        <echo message="* The following targets are available:"/>
        <echo message="*     unload"/>
        <echo message="*         Unload Predict Objects."/>
        <echo message="*"/>
        <echo message="*     load"/>
        <echo message="*         Load Predict Objects."/>
        <echo message="*"/>
        <echo message="*     generate"/>
        <echo message="*         Generate Predict Objects."/>
        <echo message="*"/>
        <echo message="*"/>
        <echo message="* (C) Copyright Software AG 2022"/>
        <echo message="************************************************************************"/>
    </target>

    <target name="-setProperties">
        <!-- ### ANT_DEPLOY_PROPERTIES_START ### -->
        <property environment="env"/>
        <property name="prf.natural.ant.script.one.version" value="9.3.1.0" />
        <property name="prf.natural.ant.project.name" value="MyNat" />
        <property name="prf.natural.ant.project.rootdir" value="${prf.natural.workspace.location}" />
        <property name="prf.natural.ant.server.host" value="localhost" />
        <property name="prf.natural.ant.server.port" value="2800" />
        <property name="prf.natural.ant.server.environment" value="localhost2800" />
        <property name="prf.natural.ant.server.parameters" value="" />
        <property name="prf.natural.ant.server.user" value="MSU" />
        <property name="prf.natural.ant.server.password" value="" />
        <property name="prf.natural.ant.server.usessl" value="NO" />
        <property name="prf.natural.ant.server.ia" value="=" />
        <property name="prf.natural.ant.server.id" value="," />
        <property name="prf.natural.ant.server.loglevel" value="ALL" />
        <property name="prf.natural.ant.server.truststore" value="" />
        <property name="prf.natural.ant.server.truststorepassword" value="" />
        <!-- ### ANT_DEPLOY_PROPERTIES_END ###   -->
    </target>

    <path id="prf.natural.ant.searchpath">
        <pathelement location="${prf.natural.eclipse.bundle.location}/com.softwareag.naturalone.predict.common/bin"/>
        <pathelement location="${natural.eclipse.bundle.location}/com.softwareag.naturalone.natural.ndvserveraccess/bin"/>
        <pathelement location="${natural.eclipse.bundle.location}/com.softwareag.naturalone.natural.auxiliary/bin"/>
        <pathelement location="${natural.eclipse.bundle.location}/com.softwareag.natural.tools/bin"/>
        <pathelement path="${classpath}"/>
        <sort>
            <reverse xmlns="antlib:org.apache.tools.ant.types.resources.comparators">
                <date/>
            </reverse>
            <fileset dir="${prf.natural.eclipse.home}" erroronmissingdir="false">
                <include name="plugins/com.softwareag.naturalone.predict.common*.jar"/>
                <include name="plugins/com.softwareag.naturalone.natural.ndvserveraccess*.jar"/>
                <include name="plugins/com.softwareag.naturalone.natural.auxiliary*.jar"/>
                <include name="plugins/com.softwareag.natural.tools*.jar"/>
            </fileset>
        </sort>
        <sort>
            <reverse xmlns="antlib:org.apache.tools.ant.types.resources.comparators">
                <date/>
            </reverse>
            <fileset dir="./" erroronmissingdir="false">
                <include name="plugins/com.softwareag.naturalone.predict.common*.jar"/>
                <include name="plugins/com.softwareag.naturalone.natural.ndvserveraccess*.jar"/>
                <include name="plugins/com.softwareag.naturalone.natural.auxiliary*.jar"/>
                <include name="plugins/com.softwareag.natural.tools*.jar"/>
            </fileset>
        </sort>
    </path>

    <target name="unload" depends="-setProperties" >
        <java
            failonerror="false"
            fork="false"
            classname="com.softwareag.naturalone.predict.common.script.MainScript"
            classpathref="prf.natural.ant.searchpath">
            <arg line="unload"/>
            <arg value="${prf.natural.ant.server.host}"/>
            <arg value="${prf.natural.ant.server.port}"/>
            <arg value="${prf.natural.ant.server.environment}"/>
            <arg value="${prf.natural.ant.server.parameters}"/>
            <arg value="${prf.natural.ant.server.user}"/>
            <arg value="${prf.natural.ant.server.password}"/>
            <arg value="${prf.natural.ant.server.usessl}"/>
            <arg file="."/>
            <arg value="${prf.natural.ant.server.ia}"/>
            <arg value="${prf.natural.ant.server.id}"/>
            <arg value="${prf.natural.ant.server.loglevel}"/>
            <arg value="${prf.natural.ant.server.truststore}"/>
            <arg value="${prf.natural.ant.server.truststorepassword}"/>
        </java>
    </target>

    <target name="load" depends="-setProperties" >
        <java
            failonerror="false"
            fork="false"
            classname="com.softwareag.naturalone.predict.common.script.MainScript"
            classpathref="prf.natural.ant.searchpath">
            <arg value="load"/>
            <arg value="${prf.natural.ant.server.host}"/>
            <arg value="${prf.natural.ant.server.port}"/>
            <arg value="${prf.natural.ant.server.environment}"/>
            <arg value="${prf.natural.ant.server.parameters}"/>
            <arg value="${prf.natural.ant.server.user}"/>
            <arg value="${prf.natural.ant.server.password}"/>
            <arg value="${prf.natural.ant.server.usessl}"/>
            <arg file="."/>
            <arg value="${prf.natural.ant.server.ia}"/>
            <arg value="${prf.natural.ant.server.id}"/>
            <arg value="${prf.natural.ant.server.loglevel}"/>
            <arg value="${prf.natural.ant.server.truststore}"/>
            <arg value="${prf.natural.ant.server.truststorepassword}"/>
        </java>
    </target>

    <target name="generate" depends="-setProperties" >
        <java
            failonerror="false"
            fork="false"
            classname="com.softwareag.naturalone.predict.common.script.MainScript"
            classpathref="prf.natural.ant.searchpath">
            <arg value="generate"/>
            <arg value="${prf.natural.ant.server.host}"/>
            <arg value="${prf.natural.ant.server.port}"/>
            <arg value="${prf.natural.ant.server.environment}"/>
            <arg value="${prf.natural.ant.server.parameters}"/>
            <arg value="${prf.natural.ant.server.user}"/>
            <arg value="${prf.natural.ant.server.password}"/>
            <arg value="${prf.natural.ant.server.usessl}"/>
            <arg file="."/>
            <arg value="${prf.natural.ant.server.ia}"/>
            <arg value="${prf.natural.ant.server.id}"/>
            <arg value="${prf.natural.ant.server.loglevel}"/>
            <arg value="${prf.natural.ant.server.truststore}"/>
            <arg value="${prf.natural.ant.server.truststorepassword}"/>
        </java>
    </target>


</project>

