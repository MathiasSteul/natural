<!-- ******************************************************************************
	NOTE:
		In order to run ApplinX as a module within the Framework Application,
		uncomment the 2 commented sections (servlet & servlet-mapping) and follow these steps :
		1. Replace $APPLINX_HOMDIR with your ApplinX installation directory
		2. Replace $LOGGER_MODE with one of these values:
			appserver - the logging info will be redirected to your application server log file
			applinx - the logging info will be redirected to applinx log file.
		3. If you have properties file for configuration changes you need to set the path in
			com.sabratec.prpfile param value.
	****************************************************************************** -->

<!-- *****************    BEGIN COMMENT  - UNCOMMENT FOR RUNNING APPLINX SERVER IN LOCAL MODE  *****
	<servlet id="applinx_servlet">
		<servlet-name>applinx</servlet-name>
		<servlet-class>com.sabratec.applinx.server.runtime.servlet.GXApplinxServlet</servlet-class>
		<init-param>
			<param-name>com.sabratec.gxhome</param-name>
			<param-value>$APPLINX_HOMEDIR</param-value>
		</init-param>
		<init-param>
			<param-name>com.sabratec.logger</param-name>
			<param-value>$LOGGER_MODE</param-value>
		</init-param>
		<init-param>
			<param-name>com.sabratec.prpfile</param-name>
			<param-value></param-value>
		</init-param>

		<load-on-startup>1</load-on-startup>

	</servlet>
	<servlet id="metadata_servlet_new">
		<servlet-name>services</servlet-name>
		<servlet-class>com.sabratec.applinx.server.runtime.servlet.metadata.GXServletMetadata</servlet-class>
	</servlet>
	<servlet id="generatecode_csharp_servlet">
		<servlet-name>generatecode_csharp</servlet-name>
		<servlet-class>com.sabratec.applinx.server.runtime.servlet.GXCSharpGenerateCodeServlet</servlet-class>
	</servlet>
	<servlet id="generatecode_vbnet_servlet">
		<servlet-name>generatecode_vbnet</servlet-name>
		<servlet-class>com.sabratec.applinx.server.runtime.servlet.GXVBGenerateCodeServlet</servlet-class>
	</servlet>
	<servlet id="generatecode_java_servlet">
		<servlet-name>generatecode_java</servlet-name>
		<servlet-class>com.sabratec.applinx.server.runtime.servlet.GXJavaGenerateCodeServlet</servlet-class>
	</servlet>
	<servlet id="generate_screens_servlet">
		<servlet-name>generate_screens</servlet-name>
		<servlet-class>com.sabratec.applinx.server.runtime.servlet.GXGenerateScreenServlet</servlet-class>
	</servlet>
	<servlet id="generate_page_servlet">
		<servlet-name>generate_page</servlet-name>
		<servlet-class>com.sabratec.applinx.server.runtime.servlet.GXGeneratePageServlet</servlet-class>
	</servlet>
*****************     END COMMENT    ************************************************************* -->


	<!-- ApplinX framework required definitions -->
	<servlet id="z_resourceReader">
		<servlet-name>z_resourceReader</servlet-name>
		<servlet-class>com.sabratec.applinx.j2ee.framework.web.GXFrameworkResourcesServlet</servlet-class>
	</servlet>
	<servlet id="z_redirector">
		<servlet-name>z_redirector</servlet-name>
		<servlet-class>com.sabratec.j2ee.http.redirector.servlet.GXRedirectorServlet</servlet-class>
	</servlet>
	<servlet id="z_container">
		<servlet-name>z_container</servlet-name>
		<servlet-class>com.sabratec.applinx.j2ee.framework.web.GXFramesetServlet</servlet-class>
	</servlet>
	<servlet id="z_keyboardMappings">
		<servlet-name>z_keyboardMappings</servlet-name>
		<servlet-class>com.sabratec.applinx.j2ee.framework.web.GXKeyboardMappingsServlet</servlet-class>
	</servlet>
	<servlet id="z_screenSeqNumber">
		<servlet-name>z_screenSeqNumber</servlet-name>
		<servlet-class>com.sabratec.applinx.j2ee.framework.web.GXScreenSeqNumberServlet</servlet-class>
	</servlet>
	<servlet id="z_clientConfig">
		<servlet-name>z_clientConfig</servlet-name>
		<servlet-class>com.sabratec.applinx.j2ee.framework.web.GXClientConfigServlet</servlet-class>
	</servlet>
     <servlet id="z_emulationDialogs_ndtDownloadWin">
	 	<servlet-name>z_emulationDialogs_ndtDownloadWin</servlet-name>
	 	<servlet-class> com.sabratec.applinx.j2ee.framework.web.ndt.GXNdtDownloadWinServlet</servlet-class>
	 </servlet>
	
	 <servlet-mapping id="z_resourceReader_servletmapping">
		<servlet-name>z_resourceReader</servlet-name>
		<url-pattern>/z_resourceReader.jsp</url-pattern>
	</servlet-mapping>
	 <servlet-mapping id="z_redirector_servletmapping">
		<servlet-name>z_redirector</servlet-name>
		<url-pattern>/z_redirector.jsp</url-pattern>
	</servlet-mapping>
	 <servlet-mapping id="z_container_servletmapping">
		<servlet-name>z_container</servlet-name>
		<url-pattern>/z_container.jsp</url-pattern>
	</servlet-mapping>
	<servlet-mapping id="z_keyboardmappings_servletmapping">
		<servlet-name>z_keyboardMappings</servlet-name>
		<url-pattern>/z_keyboardMappings.jsp</url-pattern>
	</servlet-mapping>
	<servlet-mapping id="z_screenSeqNumber_servletmapping">
		<servlet-name>z_screenSeqNumber</servlet-name>
		<url-pattern>/z_screenSeqNumber.jsp</url-pattern>
	</servlet-mapping>	
	<servlet-mapping id="z_clientConfig_servletmapping">
		<servlet-name>z_clientConfig</servlet-name>
		<url-pattern>/z_clientConfig.jsp</url-pattern>
	</servlet-mapping>	
	<servlet-mapping id="z_emulationDialogs_servletmapping">
		<servlet-name>z_emulationDialogs_ndtDownloadWin</servlet-name>
		<url-pattern>/z_emulationDialogs/z_ndtDownloadWin.jsp</url-pattern>
	</servlet-mapping>

	<!-- Uncomment the GXCheckURLProxyFilter filter to activate the URL permission filter, based on the content of URLPermissions.properties file -->
