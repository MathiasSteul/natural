		<filter-name>GXCheckURLProxyFilter</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping> -->
	
	<!-- End ApplinX framework required definitions -->


	<!-- *****************    BEGIN COMMENT  - UNCOMMENT FOR RUNNING APPLINX SERVER IN LOCAL MODE  *****
	 <servlet-mapping id="execwebservice_bare_servletmapping">
