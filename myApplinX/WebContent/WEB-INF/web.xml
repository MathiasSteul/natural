	</servlet-mapping>
	<servlet-mapping id="programPoolManagerWS">
		<servlet-name>forward</servlet-name>
		<url-pattern>/services/ProgramPoolManager</url-pattern>
	</servlet-mapping>
	 <servlet-mapping id="generatecode_csharp_servletmapping">
		<servlet-name>generatecode_csharp</servlet-name>
		<url-pattern>/csharp-service/*</url-pattern>
	</servlet-mapping>
	 <servlet-mapping id="generatecode_vbnet_servletmapping">
		<servlet-name>generatecode_vbnet</servlet-name>
		<url-pattern>/vb-service/*</url-pattern>
	</servlet-mapping>
	 <servlet-mapping id="generatecode_java_servletmapping">
		<servlet-name>generatecode_java</servlet-name>
		<url-pattern>/java-service/*</url-pattern>
	</servlet-mapping>
	<servlet-mapping id="generate_screens_servletmapping">
		<servlet-name>generate_screens</servlet-name>
		<url-pattern>/generate-screens</url-pattern>
	</servlet-mapping>
	<servlet-mapping id="generate_page_servletmapping">
		<servlet-name>generate_page</servlet-name>
		<url-pattern>/generate-page</url-pattern>
	</servlet-mapping>
	<servlet-mapping id="generate_instant_servletmapping">
		<servlet-name>generate_instant</servlet-name>
		<url-pattern>/generate-instant</url-pattern>
	</servlet-mapping>
	 <servlet-mapping id="metadata_servlet_newmapping">
		<servlet-name>services</servlet-name>
		<url-pattern>/services</url-pattern>
	</servlet-mapping>
*****************     END COMMENT    ************************************************************* -->

	<welcome-file-list>
		<welcome-file>index.jsp</welcome-file>
	</welcome-file-list>

</web-app>
