		<url-pattern>/services/ServerManager</url-pattern>
	</servlet-mapping>
	<servlet-mapping id="serviceManagerWS">
		<servlet-name>forward</servlet-name>
		<url-pattern>/services/ServiceManager</url-pattern>
	</servlet-mapping>
	<servlet-mapping id="sessionManagerWS">
		<servlet-name>forward</servlet-name>
		<url-pattern>/services/SessionManager</url-pattern>
	</servlet-mapping>
