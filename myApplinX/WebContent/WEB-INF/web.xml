		<listener-class>
			com.sabratec.j2ee.http.redirector.servlet.GXRedirectorServletSessionListener
		</listener-class>
	</listener-->

	<!-- Next listener should be uncommented whenever using WAR redeploy (without restarting Tomcat) -->
	<!--listener>
		<listener-class>
			com.sabratec.j2ee.http.servlet.GXApplicationScopeEventsServlet
		</listener-class>
