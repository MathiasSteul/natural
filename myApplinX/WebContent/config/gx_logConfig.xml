<?xml version="1.0" encoding="UTF-8"?>
<Configuration packages="com.sabratec.applinx.framework.log" status="warn" monitorInterval="3">
  <Properties>     
    
	<!--
		<Property name="log.level">info</Property>
		<Property name="log.append">false</Property>
	    <Property name="max.file.size">10240000KB</Property>
        <Property name="max.file.count">10</Property>
        <Property name="log.dir">${sys:com.sabratec.applinx.framework.web.root}/logs</Property>
	-->	
		<Property name="log.dir">${sys:com.sabratec.applinx.framework.web.root:-${sys:java.io.tmpdir}}/logs</Property>
		
  		<!--  framework -->  
        <Property name="framework.log.level">info</Property>
        <Property name="framework.log.dir">${log.dir}</Property>
        <Property name="framework.log.file.name">gxlog_framework.txt</Property>
        <Property name="framework.layout.pattern">%d{ISO8601} %-5p %m%n</Property>  
        <Property name="framework.charset">UTF-8</Property>

		<Property name="framework.log.append">false</Property>
        <Property name="framework.max.file.size">10240000KB</Property>
        <Property name="framework.max.file.count">10</Property>

        
         <!--  framework java.script [Use %u in the file name to write to a single user file]--> 
        <Property name="fw.js.log.level">info</Property>
        <Property name="fw.js.log.dir">${log.dir}</Property>
        <Property name="fw.js.log.file.name">javascript_log.txt</Property>
        <Property name="fw.js.layout.pattern">%d{ISO8601} %-5p %m%n</Property>  
        <Property name="fw.js.charset">UTF-8</Property>

		<Property name="fw.js.log.append">false</Property>
        <Property name="fw.js.max.file.size">10240000KB</Property>
        <Property name="fw.js.max.file.count">10</Property>

  
        <!--  framework performance [Use %u in the file name to write to a single user file]--> 
        <Property name="fw.performance.log.level">off</Property>
        <Property name="fw.performance.log.dir">${log.dir}</Property>
        <Property name="fw.performance.log.file.name">PerformanceLog</Property>
       
        <Property name="fw.performance.log.per.user">false</Property>
        <Property name="fw.performance.log.settings.mode">all</Property>
        <Property name="fw.performance.log.users"></Property>   
		
        <Property name="fw.performance.layout.pattern">%d{ISO8601} %-5p %m%n</Property>  

        <Property name="fw.performance.charset">UTF-8</Property>
		<Property name="fw.performance.write.flat">false</Property>

		<Property name="fw.performance.log.append">false</Property>
        <Property name="fw.performance.max.file.size">10240000KB</Property>
        <Property name="fw.performance.max.file.count">10</Property>

        <Property name="time.to.live.value">15</Property>
        <Property name="time.to.live.unit">minutes</Property>
  </Properties>
    
  <Appenders>

  	<Console name="CONSOLE" target="SYSTEM_OUT">
		<PatternLayout pattern="%d{DEFAULT} [%t] &gt; %m%n" charset="UTF-8" />	
		<ThresholdFilter level="TRACE" onMatch="ACCEPT" onMismatch="DENY"/>
    </Console>
	
    <RollingFile 
    	name="FRAMEWORK_LOG" 
    	fileName="${framework.log.dir}/${framework.log.file.name}" 
    	filePattern="${framework.log.dir}/${framework.log.file.name}_%i.txt"
    	append="${framework.log.append}"
    	immediateFlush="true"
        ignoreExceptions="false">	
        
        <ThresholdFilter level="TRACE" onMatch="ACCEPT" onMismatch="DENY"/>
        <PatternLayout pattern="${framework.layout.pattern}" charset="${framework.charset}"/>
        
      	<Policies>
			<SizeBasedTriggeringPolicy size="${framework.max.file.size}" />
			<OnStartupTriggeringPolicy />
		</Policies>
		 
		<DefaultRolloverStrategy max="${framework.max.file.count}" >
    		<Delete basePath="${framework.log.dir}" maxDepth="1">
      			<IfFileName glob="${framework.log.file.name}*">
          				<IfAccumulatedFileCount exceeds="${framework.max.file.count}" />
     			 </IfFileName>
    		</Delete>
  		</DefaultRolloverStrategy>
    </RollingFile>
    
   
	<RollingFile 
    	name="JAVASCRIPT_LOG" 
    	fileName="${fw.js.log.dir}/${fw.js.log.file.name}" 
    	filePattern="${fw.js.log.dir}/${fw.js.log.file.name}_%i.txt"
    	append="${fw.js.log.append}"
    	immediateFlush="true"
        ignoreExceptions="false">	
        
        <PatternLayout pattern="${fw.js.layout.pattern}" charset="${fw.js.charset}"/>
        
      	<Policies>
			<SizeBasedTriggeringPolicy size="${fw.js.max.file.size}" />
			<OnStartupTriggeringPolicy />
		</Policies>
		 
		<DefaultRolloverStrategy max="${fw.js.max.file.count}" >
    		<Delete basePath="${fw.js.log.dir}" maxDepth="1">
      			<IfFileName glob="${fw.js.log.file.name}*">
          				<IfAccumulatedFileCount exceeds="${fw.js.max.file.count}" />
     			 </IfFileName>
    		</Delete>
  		</DefaultRolloverStrategy>
    </RollingFile> 

    <Routing name="PERFORMANCE_LOG">
    	<Routes pattern="${ctx:fw.performance.log.user}">
        	<Route>
    			<RollingFile 	
					name="PERFORMANCE_LOG"
					fileName="${fw.performance.log.dir}/${ctx:fw.performance.log.user}.csv"
					filePattern="${fw.performance.log.dir}/${ctx:fw.performance.log.user}*_%i.csv"
					append="${fw.performance.log.append}">
					<!--CsvParameterLayout delimeter=","/-->
				
					<GXPerformanceLogCSVLayout charset="${fw.performance.charset}" /> <!-- old usage:  param name="WriteFlat" value="false"/ -->
					<Policies>
						<SizeBasedTriggeringPolicy size="${fw.performance.max.file.size}" />
					</Policies>
					<DefaultRolloverStrategy max="${fw.performance.max.file.count}" />
				</RollingFile>
			</Route>
    	</Routes>
    	<IdlePurgePolicy timeToLive="${time.to.live.value}" timeUnit="${time.to.live.unit}"/>
    </Routing>
	
  </Appenders>
  
  
  <Loggers>
		
	<!-- ********* Web application  and  ApplinX Framework Logger  *********  -->
	<Logger additivity="false" name="com.sabratec" level="${framework.log.level}">
		<appender-ref ref="FRAMEWORK_LOG"/>
	</Logger>
	
	
	<!-- ********* Java script logger  ********* -->
	<!--  Sample log for single user -->
	<!--  Copy this section and change {Session-ID} for the specific session id-->
	<!-- category additivity="true" name="com.sabratec.applinx.framework.performance_log.{SESSION-ID}"-->
	<Logger additivity="false" name="com.sabratec.applinx.framework.web.jsengine.javascriptData" level="${fw.js.log.level}">
		<appender-ref ref="JAVASCRIPT_LOG"/>
	</Logger>
	
	
	<!-- ********* Performance  ********* -->
	<Logger additivity="false" name="com.sabratec.applinx.framework.performance_log" level="${fw.performance.log.level}">
		<appender-ref ref="PERFORMANCE_LOG"/>
	</Logger>

     <Root level="off">
      <AppenderRef ref="CONSOLE"/>
    </Root>
	
  </Loggers>
</Configuration>