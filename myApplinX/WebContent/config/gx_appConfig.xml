<GXWebAppConfig xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	webWindowName=""
    useCache="false" 
    writePerformanceLog="false"
    useModalWindows="false"
    useKeyboardPFKeys="true"
    reflectHostProtected="true" 
    reflectEmulationBehaviour="false"
    reflectFGColors="false"
    reflectBGColors="false"
    reflectMaxlength="false" 
    trimLabels="false" 
    useFolders="false"
    virtualDir=""
    designMode="true" 
    performSyncCheckInInstant="false"
    supportDupAndFieldMark="false"
	promptBeforeSessionTimeOut="true"
	screenLocker="template/screenLocker.htm"
    xsi:type="java:com.sabratec.applinx.framework.GXWebAppConfig">

    <!-- sessionId,description,password: $(SESSION_ID)=web server session id, $(IP)= End user IP address -->
	<!-- Possible serverURL values:
	//		standard connection to applinx (replacement of setServerAddress and setServerPort)
                <param-value>applinx://127.0.0.1:2323</param-value>
	//		local connection to applinx (only if applinx servlet is enabled in /WEB-INF/web.xml
	//		<param-value>local://applinx</param-value>
	-->
    <sessionConfig 
    	serverURL="applinx://localhost:2323" 
    	applicationName="InstantDemo"
		sessionId="$(SESSION_ID)"
		password=""
		serviceName=""
		description="$(IP)"
		hostUserName=""
		hostPassword=""
    	xsi:type="java:com.sabratec.applinx.framework.GXConfig"/>
	<!-- Posible defaultExtension values: txt,csv -->
    <naturalDataTransferConfig automaticDownload="false" defaultExtension="txt" />
    <tableBuildConfig 
        reflectFGColor="false" 
        reflectBGColor="false" 
        cloneComboxOnClientSide="true"
        reflectHostProtected="false"
        alternateColors="true" 
        alternateCssName="gx_tbl_alternating2"
        trimLabels="false" 
    	fromRow="1"
        toRow="1" 
        xsi:type="java:com.sabratec.applinx.framework.tables.GXTableBuildConfig"/>
    <!--  Font size = 0 -> Dynamic font by resolution   -->
    <instantConfig fontSize="0">
    	<renderArea
    		startRow="0"
    		startColumn="0"
    		endRow="0"
    		endColumn="0"
    	/>
        <tableConfig 
        	renderAlternatingCssClass="true"
            adjustNeighbours="true"
            tableAlternating1CssClass="gx_tbl_alternating1"
            tableAlternating2CssClass="gx_tbl_alternating2"
            tableCssClass="gx_tbl" 
            enabled="true"/>
        <windowFrameConfig 
        	windowFrameCssClass="gx_wnd" 
        	enabled="true"/>
    	<!-- colorMode: 0=All, 1=None, 2=Reversed video -->
        <emulationConfig 
        	renderEmulationAttributes="true" 
        	colorMode="0"
            renderIntensifiedCss="true" 
            renderAppFieldCss="true" 
            enabled="true"/>
        <!-- renderingType: 0=links, 1=Buttons, 2=Delete -->
        <hostKeysConfig 
        	hostKeyCss="gx_hky" 
        	renderingType="2" 
        	enabled="true"/>
    </instantConfig>
    <!-- userName: $(SESSION_ID)=web server session id, $(IP)= End user IP address -->
    <singleSignOnConfig 
    	enabled="false">
        <ssoExecuter 
        	actionKey="[enter]" 
        	xsi:type="java:com.sabratec.applinx.framework.sso.GXSSOSendKeysExecuter"/>
        <signOnScreenRecognizer 
            xsi:type="java:com.sabratec.applinx.framework.sso.GXSignOnScreenAutomaticRecognizer"/>
        <userPasswordRetriever 
            userParameterName="userid" 
        	passwordParameterName="passwd"
            xsi:type="java:com.sabratec.applinx.framework.web.sso.GXHttpRequestUserPasswordRetriever"/>
    </singleSignOnConfig>
    <macroConfig 
    	encryptData="true" 
    	flicker="0" 
    	userName="$(IP)"
    	xsi:type="java:com.sabratec.applinx.framework.emulation.macros.GXMacroConfig"/>
</GXWebAppConfig>
