<?xml version="1.0" encoding="UTF-8"?>
<GXClientConfig xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="java:com.sabratec.applinx.framework.web.jsengine.GXClientConfig">
	<!--  labelFocus: 0-none , 1-underline   , 2-bold -->
	<!--  useArrows:  0-none , 1-input fields, 2-all screen -->
    <instantEmulatorConfig
        useKeyboardPfKeys="true" 
        tabOnInputsOnly="true" 
        useArrows="1"
        labelFocus="1"
    	caretAtEndOfField="false"
        autoSkipAllFields="false" 
        showBlinkingFields="true"
        blockNumericFields="false"
        selectFieldOnFocus="true" 
        doubleClickActionKey="[enter]"
        handleMenuSelection="false" 
        blinkingCaret="false"
	/>

    <windowConfig 
        defaultOpenedWindowLeft="1"
        openedWindowAttributes="resizable=yes,status=yes,toolbar=no,scrollbars=no"
        defaultOpenedWindowTop="1" 
    />

	<!--  labelFocus: 0-none , 1-underline   , 2-bold -->
	<!--  useArrows:  0-none , 1-input fields, 2-all screen -->
    <webEmulatorConfig 
    	userExitsFile="js/userExits.js"
    	loadEmulationComponent="false"
        loadPrinter="false" 
        useKeyboardPfKeys="true" 
        tabOnInputsOnly="false"
        labelFocus="0" 
        caretAtEndOfField="false"
        autoSkipAllFields="false" 
        showBlinkingFields="false"
        blockNumericFields="false" 
        selectFieldOnFocus="true"
        blinkingCaret="false"
        useArrows="1"
		checkHostScreenUpdate="true"
    />

	<!--  logLevel: 0-Error , 1-Warnings , 2-Massage 3-Debug(shows debug console in the browser) -->
    <engineConfig
    	promptOnBrowserClose="true"
        logoffMessage="The session will be disconnected. Would you like to continue?"
        logLevel="0"
         debugModules="z_engine.js,z_window.js,z_typeAhead.js,z_emulator.js,z_ndt.js,z_keyboardMapping.js,z_browserUtil.js,z_log.js,z_stringUtil.js,z_event.js"
        showLogConsole="false"
    />
</GXClientConfig>
