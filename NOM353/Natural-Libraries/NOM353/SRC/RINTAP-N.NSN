* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    RINTAP-N
* Version   1.3
* Function  Installed Customer Applications
*
* Maintenance
* uuuuuuuu yyyy-mm-dd iTrac       Remark
* mrs      1993-06-24             created
* fhi      2016-11-15 NOMALL-1961 Use new task IDs
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER USING RINTAP-P
************************************************************************
LOCAL
1 SYSTEM-DEFAULTS VIEW OF NRM-MONITOR
  2 M-CUSTOM-APPL     (1:5)
  2 REDEFINE M-CUSTOM-APPL
    3 M-AP-TAB        (1:5)
      4 M-AP-TITLE    (A32)
      4 M-AP-LIBRARY  (A8)
      4 M-AP-COMMAND  (A8)
      4 M-AP-PARAM    (A25)
      4 M-AP-FILLER   (A177)
  2 C*M-CUSTOM-APPL
1 I                   (P2)
1 #MONIT-ID           (A16)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET  RINTAP-TAB (*)
#MONIT-ID := F#MONITOR-TASK-ID1 (<>)
FNDMO. FIND SYSTEM-DEFAULTS WITH M-MONITOR-ID = #MONIT-ID
  FOR I = 1 TO C*M-CUSTOM-APPL
    RINTAP-PRODNAME  (I) := M-AP-TITLE (I)
    RINTAP-LIBRARY   (I) := M-AP-LIBRARY (I)
    RINTAP-COMMAND   (I) := M-AP-COMMAND (I)
    RINTAP-PARAMETER (I) := M-AP-PARAM (I)
  END-FOR
END-FIND
*
END
