DEFINE DATA GLOBAL USING MONIT-GL
INDEPENDENT
1 +G-NOMEXIT-ACTIVE         (L/1:20)
1 +NOD-CURRENT-NAME         (A16)
1 +NOD-LOCAL-NODE           (N5)
1 +CMRDC                    (A1)
1 +TRACE-ORDER              (A1)
* -----------------------------LDA's-----------------------------------
LOCAL USING RMSPL--L
LOCAL USING RMSR---L
LOCAL USING RMSR---E
LOCAL USING RCCTYP-E
LOCAL USING RMODTY-E
LOCAL USING RMSETSTE
LOCAL USING EOMRPM-E
LOCAL USING RLOG-L
LOCAL USING VUXDEF-L   /* defined unix nodes
LOCAL USING XXUX---P   /* parameters for unix access
LOCAL USING NOMRPCXP   /* parameters for unix Meta Data
LOCAL USING XXHASH-P
LOCAL USING N-41002L
LOCAL USING RMTASK-E
LOCAL USING NOMWK--P
LOCAL USING NOMFNC-E
*
LOCAL
1 SOURCE VIEW OF NRM-SOURCE
  2 SR-ID
  2 SR-CONTROL-FLAG
  2 SR-TYPE
  2 SR-MONITOR-ID
  2 SR-RECEIPT-STAMP    /* NOMALL-2422 BLI
  2 SR-ATTRIBUTES-IDENT
  2 SR-SPOOL-ATTRIBUTES
  2 SR-SPOOL-ATTR-EXTENDED    (1:120)
  2 SR-CC-TYPE
  2 SR-RECORD-LENGTH
  2 SR-NUMBER-OF-LINES
  2 SR-OBJECT-TYPE
  2 SR-OBJECT-TIME
1 ORDER VIEW OF NRM-ORDER
  2 OD-ID
  2 OD-TYPE
  2 OD-MONITOR-ID
  2 OD-USER-ID
  2 OD-PARAMETER              (1:1)
  2 REDEFINE OD-PARAMETER
    3 OD-MASTER               (A25)
  2 REDEFINE OD-PARAMETER
    3 OD-IDENT                (A8)
    3 OD-FILLER1              (A17)
    3 OD-DBID                 (N3)
    3 OD-FNR                  (N3)
    3 OD-RETRY-COUNT          (N3)
    3 OD-DBID-N5              (N5)
    3 OD-FNR-N5               (N5)
    3 OD-REP-FORMAT           (A1)
  2 OD-TIME-CREATED
  2 OD-TIME-SCHEDULED
  2 OD-SOURCE-ID              (P10)
  2 OD-MAX-RETRIES            (N3)
  2 OD-RETRY-INTERVAL         (N5)
1 REPORT VIEW OF NRM-REPORTS-NEW /*SU7
  2 R-REPNAME
  2 R-USERID
  2 R-TYPE
  2 R-IDENT-FILES             (A50/1:10) /*SU7
  2 C*R-IDENT-FILES
  2 R-PRINT-JOBCARD           (1:3)
  2 REDEFINE R-PRINT-JOBCARD
    3 #JOBCARD                (A216)
  2 R-REP-FORMAT
*
1 #CONTROL                    (A65)
1 REDEFINE #CONTROL
  2 #CONTROL-TYPE             (I2)
  2 REDEFINE #CONTROL-TYPE
    3 #CONTROL-TYPE-B         (B2)
  2 #CONTROL-IDENT            (A63)
1 #GETATTR                    (A197) /* File Attributes
1 REDEFINE #GETATTR
  2 #REST                     (A5)
  2 #OWNER                    (A8)
  2 #SIZE                     (N10) /* Bytes
  2 #MOD-DATE-TIME            (N14) /* yyyymmddhhmmss
  2 #GETATTR-FILLER           (A158)
  2 #FILE-LOCKED              (A1)
1 #ATTRIBUTES
  2 #RECORD-LENGTH            (N3)
  2 #NUMBER-OF-LINES          (P10)
  2 #USER-ID                  (A8)
  2 #SOURCE-TYPE              (I2)
  2 #CONTROL-FLAG             (A1)
1 #R-IDENT                    (A82)
1 REDEFINE #R-IDENT
  2 #R-IDENT-TYPE             (I2)
  2 #R-IDENT-ITEM             (A80)
*
1 #STEP                       (P5)
1 #UX-FUNCTION                (A8)
1 #FILES-INDEX                (P5)  /* 'FOR'-loop in R-IDENT-FILE       S
1 #UX-NODE-INDEX              (P5)  /* 'FOR'-loop in UX-NODE
1 #PATH                       (A70)  /* Unix path of a specific no      de
1 #PATH1                      (A250) /* BLI NOMALL-2445 was A70
1 #CONTAINR-DB                (N5)
1 #CONTAINR-FNR               (N5)
1 #OD-TYPE                    (B2) /* for 'WRITE-AN-ORDER' routine
1 #OD-TYPE-N                  (N4) /* for 'WRITE-AN-ORDER' routine
1 REDEFINE #OD-TYPE-N              /* for 'WRITE-AN-ORDER' routine
  2 #OD-TYPE-A                (A4) /* for 'WRITE-AN-ORDER' routi  ne
1 #ORDER-FOUND                (L)  /* for 'WRITE-AN-ORDER' routine
1 #OD-TIME-SCHEDULED          (T)  /* for 'WRITE-AN-ORDER' routine
1 #R-TYPE-IDENT               (A83)/* Search for report
1 #R-TYPE                     (A1) /* Report Type
1 #FILE-PROCESSED             (L)  /* Source and Orders created
1 #OPSYS                      (A8) /* Operating System of Unix node
1 #FILES-REMAINING            (A)  DYNAMIC /* NOMALL-1903 was (A9700)
1 #STACK-FUNCTION             (A10) /* Stack for Unix parameters
1 #STACK-RC                   (N1)         /* Return code for stack
1 #I                          (I4)         /* Counter for DIR command
1 #TIMESTAMP                  (A15) /* Time Stamp for rename
1 REDEFINE #TIMESTAMP
  2 #TIMESTAMP-D              (A8)         /* date part
  2 #TIMESTAMP-T              (A7)         /* time part
1 #P-ERC                      (P3)
1 #FO-FILE                    (A140)
1 #FILE-IX                    (I4)
1 #FILE-IX-FROM               (I4)
1 #FILE-IX-TO                 (I4)
1 #FILE-IX-LAST               (N10)
1 #FO-FILE-TAB                (A/*) DYNAMIC
1 #FO-SIZE                    (N10/*)
1 #FO-STATUS                  (A1/*)   /* 'O'=Open, 'B'=Blacklisted
1 #FO-ERC                     (N4/*)   /* last error no occurred
1 #FO-ERT                     (A250/*) /* last error text occurred
1 #FO-ERL                     (I4/*)   /* last error line
1 #POS                        (I4)
1 #LEN                        (I4)
1 #LEN1                       (I4)
1 #LEN-RECORD                 (I4)
1 #SUSP-REMEMBER              (A1)
1 #POS-ABS                    (I4)
1 #POS-END                    (I4)
1 #POS-LEN                    (I4)
1 #FILE-NAME-IN               (A250)
1 #FILE-ID                    (A)    DYNAMIC
1 #FILE-NAME-MSG              (A250)
1 #RECEIPT-STAMP              (A1)
1 RMSETTIM
  2 FUNCTION                  (A1)
  2 ERC                       (N4)
  2 MSG                       (A250)
  2 TIME                      (I4)
1 #NO-FILES                   (I4)
1 #NO-FILES-MAX               (I4) CONST <200>
1 #FOUND                      (L)
1 #SPOOL-ATTRIBUTES-COMP      (A250)
1 #SPOOL-UNIX-PATH-COMP       (A70)
1 #TRACING                    (L)
1 #ZEROBYTE                   (A2)
1 #MIME-TYPE                  (A81)
1 #META-ERROR                 (L)
1 #CATDATE                    (A19)
1 #I4                         (I4)
1 #MAX-RETRIES                (N3)
1 #RETRY-INTERVAL             (N5)
1 #LINE                       (I4)
1 #TYPE-I                     (I2)
1 #SOURCE-ISN                 (P10)    /* NOMALL-2422 BLI
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
FORMAT (0) LS=133 PS=60
*
IF G-TRACE GE *LEVEL AND G-TRACE-SET = SCAN ('SCAN')
  #TRACING := TRUE
  RMSETTIM.FUNCTION := 'S'
  PERFORM RMSETTIM-SETTIME RMSETTIM
END-IF
IF +TRACE-ORDER = ' ' /* not yet determined from jobcards
  PERFORM RMGTRACE-GET-SETTINGS
END-IF
COMPRESS ";" H'00' TO #ZEROBYTE LEAVING NO
INCLUDE CMRDC
IF #TRACING
  G-TRACE-MSG := 'Start Scanning Unix Files'
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  PERFORM XXCATAL-GET-CATDATE #CATDATE
  COMPRESS *PROGRAM 'cataloged at' #CATDATE TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG /* BLI NOMALL-2446
END-IF
CALLNAT 'N-MONERR' #MAX-RETRIES #RETRY-INTERVAL
*
REDUCE ARRAY #FO-FILE-TAB TO 0
REDUCE ARRAY #FO-SIZE     TO 0
REDUCE ARRAY #FO-STATUS   TO 0
REDUCE ARRAY #FO-ERC      TO 0
REDUCE ARRAY #FO-ERT      TO 0
REDUCE ARRAY #FO-ERL      TO 0
EXPAND ARRAY #FO-FILE-TAB TO (1:50)
EXPAND ARRAY #FO-SIZE     TO (1:50)
EXPAND ARRAY #FO-STATUS   TO (1:50)
EXPAND ARRAY #FO-ERC      TO (1:50)
EXPAND ARRAY #FO-ERT      TO (1:50)
EXPAND ARRAY #FO-ERL      TO (1:50)
RDUX. READ UX-NODES BY UX-NODE-NAME
  ACCEPT IF NOT(UX-NODE-SUSPEND ='D' OR='E')
  #SUSP-REMEMBER := UX-NODE-SUSPEND
  IF #TRACING
    COMPRESS 'Processing node' UX-NODE-NAME UX-NODE-SUSPEND
      TO G-TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END-IF
  +NOD-CURRENT-NAME := UX-NODE-NAME
  CALLNAT 'RMSETSTN' #EQU-ANALYSE-UNIX +NOD-LOCAL-NODE
    G-NATRP-DBID G-NATRP-FNR
    G-SHUTDOWN G-TASK-NUMBER
  END TRANSACTION
  RESET P-ERT P-ERC
*
  STEPS. FOR #STEP = 1 TO 3
    RESET G-NATRP-ERC G-NATRP-ERT #UX-FUNCTION #LINE
    DECIDE ON FIRST VALUE OF #STEP
      VALUE 1
* info about node and environment
        #UX-FUNCTION := 'INFO'
        PERFORM UNIX-FUNCTION
        #OPSYS := P-OPSYS
        PERFORM SET-SUSPEND
      VALUE 2
        PERFORM SCAN-DESTINATION
      VALUE 3
        PERFORM MSG-SUSPEND
        PERFORM MOVE-BLACKLISTED
      ANY
        IF UX-NODE-SUSPEND = 'S' OR = 'E'
          PERFORM MSG-SUSPEND
          ESCAPE BOTTOM (STEPS.)
        END-IF
        IF G-NATRP-ERC NE 0 AND G-NATRP-ERC NE 2043 /* reactivated node
          PERFORM WRITE-ERROR-LOG
          END TRANSACTION
          ESCAPE BOTTOM (STEPS.)
        END-IF
      NONE
        IGNORE
    END-DECIDE
  END-FOR                                  /* end of STEPS.
*
  RESET G-NATRP-ERC G-NATRP-ERT P-ERT P-ERC #LINE
  #UX-FUNCTION := 'LOGOUT'
  PERFORM UNIX-FUNCTION
END-READ
RESET G-NATRP-ERC G-NATRP-ERT P-ERT P-ERC #LINE
IF #TRACING
  G-TRACE-MSG := 'End of Scanning Unix Files'
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  RMSETTIM.FUNCTION := 'G'
  PERFORM RMSETTIM-SETTIME RMSETTIM
  PERFORM XXRLOG-WRITE-LOG 'T' RMSETTIM.MSG
END-IF
END TRANSACTION
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************--
DEFINE SUBROUTINE SET-SUSPEND
************************************************************************--
IF #SUSP-REMEMBER ='M' OR='L'
  ESCAPE ROUTINE
END-IF
IF #TRACING                               /* BLI NOMALL-2446
  COMPRESS 'SET-SUSPEND Remember' #SUSP-REMEMBER 'ERC' G-NATRP-ERC
    TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
GETUX1. GET UX-NODES *ISN (RDUX.)
DECIDE ON EVERY VALUE OF G-NATRP-ERC
  VALUE 0
    UX-NODE-SUSPEND := 'A'                /* time for A is set after DTA
  VALUE 5,1581
* user or pwd invalid
    IF G-NATRP-ERT = SCAN('NPR3416')      /* NOMALL-2088
* pwd invalid
        OR G-NATRP-ERT = SCAN('NPR0009')  /* NOMALL-2088
* wrong NPR version
        OR G-NATRP-ERC = 1581             /* NOMALL-2274
      UX-NODE-SUSPEND := 'E'
      IF UX-NODE-TIME-STORED NE 'E'       /* BLI1 start
        UX-NODE-TIME-STORED := 'E'
        UX-NODE-SUSPENDED := *TIMX        /* set time
        RESET UX-NODE-SUSP-MAX-MSG
      END-IF                              /* BLI1 end
    ELSE
      UX-NODE-SUSPEND := 'S'
    END-IF
  NONE
    UX-NODE-SUSPEND := 'S'
END-DECIDE
IF UX-NODE-SUSPEND = 'S' AND              /* BLI1 start
    UX-NODE-TIME-STORED NE 'S'
  UX-NODE-TIME-STORED := 'S'
  UX-NODE-SUSPENDED := *TIMX              /* suspended start time
  RESET UX-NODE-SUSP-MAX-MSG
END-IF                                    /* BLI1 end
UPDATE (GETUX1.)
END TRANSACTION
*
END-SUBROUTINE /* SET-SUSPEND
*
************************************************************************--
DEFINE SUBROUTINE RESET-SUSPENDED /* BLI1
************************************************************************--
IF #SUSP-REMEMBER ='M' OR='L'
  ESCAPE ROUTINE
END-IF
IF #TRACING
  MOVE 'RESET-SUSPENDED' TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
GETUX2. GET UX-NODES *ISN (RDUX.)
IF UX-NODE-SUSPEND = 'A'
    AND UX-NODE-TIME-STORED NE 'A'
  UX-NODE-TIME-STORED := 'A'
  UX-NODE-SUSPENDED := *TIMX
  RESET UX-NODE-SUSP-MAX-MSG
END-IF
UPDATE (GETUX2.)
END TRANSACTION
*
END-SUBROUTINE /* RESET-SUSPENDED
*
************************************************************************--
DEFINE SUBROUTINE MSG-SUSPEND
************************************************************************--
IF #SUSP-REMEMBER ='M' OR='L'
  ESCAPE ROUTINE
END-IF
RESET G-NATRP-ERC G-NATRP-ERT         /* BLI1 start
IF UX-NODE-SUSPEND = 'S' AND
    UX-NODE-SUSP-MAX-MSG = ' ' AND
    UX-NODE-SUSP-TIME-INT > 0 AND                           /* BLI2
    *TIMX - UX-NODE-SUSPENDED > UX-NODE-SUSP-TIME-INT * 600 /* BLI3
  G-NATRP-ERC := 2071                 /* exceeded maximum suspended time
  G-NATRP-ERT := UX-NODE-NAME
  #LINE       := *LINE
  PERFORM WRITE-ERROR-LOG
  GETUX3. GET UX-NODES *ISN (RDUX.)
  UX-NODE-SUSP-MAX-MSG := 'X'
  UPDATE (GETUX3.)
  END TRANSACTION
  ESCAPE ROUTINE
END-IF
IF #SUSP-REMEMBER NE UX-NODE-SUSPEND  /* flag has changed
  IF UX-NODE-SUSPEND = 'A'
    G-NATRP-ERC := 2043               /* node reactivated
    G-NATRP-ERT := UX-NODE-NAME
    #LINE       := *LINE
  ELSE
    IF UX-NODE-SUSPEND = 'S'
      IF UX-NODE-SUSP-MAX-MSG = ' '   /* BLI1 below maximum suspend time
        G-NATRP-ERC := 2026           /* node suspended
        G-NATRP-ERT := UX-NODE-NAME
        #LINE       := *LINE
      END-IF
    ELSE                              /* UX-NODE-SUSPEND = 'E'
      G-NATRP-ERC := 2069             /* node deactivated by monitor
      G-NATRP-ERT := UX-NODE-NAME
      #LINE       := *LINE
    END-IF
  END-IF
  IF G-NATRP-ERC NE 0
    PERFORM WRITE-ERROR-LOG
  END-IF                              /* BLI1 end
END-IF
END TRANSACTION
*
END-SUBROUTINE /* MSG-SUSPEND
*
************************************************************************--
DEFINE SUBROUTINE SCAN-DESTINATION
************************************************************************--
FORUX. FOR #UX-NODE-INDEX = 1 TO C*UX-NODE-ACCESS
  RESET G-NATRP-ERC G-NATRP-ERT #LINE
  #PATH         := UX-NODE-PATH         (#UX-NODE-INDEX)
  #CONTAINR-DB  := UX-NODE-CONTAINER-DB (#UX-NODE-INDEX)
  #CONTAINR-FNR := UX-NODE-CONTAINER-FNR (#UX-NODE-INDEX)
  IF #CONTAINR-DB = 0 OR #CONTAINR-FNR = 0
    #CONTAINR-DB  := UX-NODE-CONTAINER-DB (1)
    #CONTAINR-FNR := UX-NODE-CONTAINER-FNR (1)
  END-IF
*
  PERFORM PROCESS-UNIX-PATH
  IF UX-NODE-SUSPEND = 'E' OR UX-NODE-SUSPEND = 'S'
    ESCAPE BOTTOM
  END-IF
*
END-FOR
*
END-SUBROUTINE /* SCAN-DESTINATION
*
************************************************************************--
DEFINE SUBROUTINE PROCESS-UNIX-PATH
************************************************************************--
RESET #NO-FILES
IF #TRACING
  COMPRESS 'Processing Path:' #PATH TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
#STACK-FUNCTION := 'PUSH' /* stack parameter for XXUX---N
CALLNAT 'XXUXST-N' #STACK-FUNCTION #STACK-RC XXUX---P
IF #STACK-RC NE 0
  G-NATRP-ERC := 5
  #LINE       := *LINE
  COMPRESS *PROGRAM *LINE 'Internal error: Stack overflow'
    TO G-NATRP-ERT
  ESCAPE ROUTINE
END-IF
REPEAT /*read all files from specified directory:
  REDUCE DYNAMIC #MR-P-BUFFER     TO 0
  REDUCE DYNAMIC #FILES-REMAINING TO 0
  COMPRESS #PATH '*' TO P-FILE-NAME LEAVING NO
  P-ERC := #P-ERC /* continue if P-ERC was 19 before
  #UX-FUNCTION := 'DTA'
  PERFORM UNIX-FUNCTION
  DECIDE FOR FIRST CONDITION            /* NOMALL-2470 before EVERY
    WHEN G-NATRP-ERT = SCAN '3339'      /* 'file not found'
        OR G-NATRP-ERC = 2036           /* NOMALL-2088
        OR G-NATRP-ERT = SCAN 'NPR0012'
      IF #TRACING
        COMPRESS 'No files found:' P-FILE-NAME TO G-TRACE-MSG
        PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
        COMPRESS 'Error:' G-NATRP-ERC G-NATRP-ERT TO G-TRACE-MSG
        PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
      END-IF
      RESET G-NATRP-ERC G-NATRP-ERT P-ERC P-ERT #FILES-REMAINING
        #LINE #P-ERC                    /* NOMALL-2470
      PERFORM RESET-SUSPENDED           /* BLI1
    WHEN G-NATRP-ERC=0 OR=19
        OR G-NATRP-ERT = SCAN('3345')   /* same as G-NATRP-ERC = 19
      IF G-NATRP-ERC=19
          OR G-NATRP-ERT = SCAN('3345') /* NOMALL-2088
        #P-ERC := 19                    /* not all objects were passed
      ELSE
        RESET #P-ERC
      END-IF
      PERFORM RESET-SUSPENDED           /* BLI1
      #FILES-REMAINING := #MR-P-BUFFER
      IF #TRACING                       /* NOMALL-2470
        COMPRESS 'Files found:' #MR-P-BUFFER
          TO G-TRACE-MSG
        PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
        COMPRESS 'Error:' G-NATRP-ERC G-NATRP-ERT TO G-TRACE-MSG
        PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
      END-IF
      EXAMINE #FILES-REMAINING FOR #ZEROBYTE GIVING POSITION #POS
      DECIDE FOR FIRST CONDITION
        WHEN #POS = 1
          RESET #FILES-REMAINING
        WHEN #POS > 1
          SUBTRACT 1 FROM #POS
          #FILES-REMAINING := SUBSTR(#FILES-REMAINING,1,#POS)
        WHEN NONE
          IGNORE
      END-DECIDE
* *****
      REPEAT /* handle all files given in #FILES-REMAINING:
        UNTIL #FILES-REMAINING = ' ' OR #NO-FILES > #NO-FILES-MAX
        ADD 1 TO #NO-FILES
        RESET G-NATRP-ERC G-NATRP-ERT #LINE
        SEPARATE #FILES-REMAINING INTO P-FILE-NAME
          REMAINDER #FILES-REMAINING WITH DELIMITER ';'
        #FILE-NAME-IN := P-FILE-NAME
* Do not accept filenames containing blanks:
        EXAMINE P-FILE-NAME FOR ' ' REPLACE '_' GIVING NUMBER #LEN
        IF #TRACING                       /* NOMALL-2470
          COMPRESS P-FILE-NAME ' #LEN:' #LEN  TO G-TRACE-MSG
          PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
          COMPRESS 'Error:' G-NATRP-ERC G-NATRP-ERT TO G-TRACE-MSG
          PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
        END-IF
        IF #LEN NE 0
          PERFORM MOVE-TO-TEMP-DIR
          G-NATRP-ERC := 1121
          #LINE       := *LINE
          #FILE-NAME-MSG := P-FILE-NAME
          PERFORM CREATE-NAME-FOR-MSG
          G-NATRP-ERT := #FILE-NAME-MSG
          PERFORM WRITE-ERROR-LOG
          ESCAPE TOP
        END-IF
        RESET #ATTRIBUTES #SOURCE-ATTRIBUTES #SPOOL-ATTRIBUTES
          G-NATRP-ERC G-NATRP-ERT
        PERFORM PROCESS-UNIX-FILE /* handle current file
        IF UX-NODE-SUSPEND = 'E' OR UX-NODE-SUSPEND = 'S'
          COMPRESS UX-NODE-NAME ':' #PATH #FILE-NAME-IN
            TO #FO-FILE LEAVING NO
          EXAMINE #FO-FILE-TAB (*) FOR #FO-FILE GIVING INDEX #FILE-IX
          IF #FILE-IX NE 0
            PERFORM DELETE-IX-ENTRY
          END-IF
          RESET #P-ERC
          ESCAPE BOTTOM
        END-IF
      END-REPEAT
* *****
      IF #TRACING AND #NO-FILES > #NO-FILES-MAX
        COMPRESS #NO-FILES-MAX 'files processed. Remaining files will'
          'be processed in next cycle.' TO G-TRACE-MSG
        PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
      END-IF
*
    WHEN NONE
      IF P-ERT NE ' '
        G-NATRP-ERC:= 5
        COMPRESS *PROGRAM P-ERT TO G-NATRP-ERT
* set node to 'E' or 'S'
        PERFORM SET-SUSPEND        /* BLI NOMALL-2470
      ELSE
        COMPRESS *PROGRAM 'Error' P-ERC 'occurred' TO G-NATRP-ERT
      END-IF
      PERFORM WRITE-ERROR-LOG
      RESET G-NATRP-ERC G-NATRP-ERT #LINE #P-ERC
  END-DECIDE
*
  UNTIL #P-ERC NE 19 /* 19 = more files to be read via NPR
END-REPEAT
*
IF #TRACING
  COMPRESS UX-NODE-SUSPEND 'Finished Path:' #PATH TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
*
#STACK-FUNCTION := 'POP' /* restore parameter for XXUX---N
CALLNAT 'XXUXST-N' #STACK-FUNCTION #STACK-RC XXUX---P
IF #STACK-RC NE 0
  G-NATRP-ERC := 5
  #LINE       := *LINE
  COMPRESS *PROGRAM *LINE 'Internal error: Stack overflow' TO G-NATRP-ERT
  ESCAPE ROUTINE
END-IF
*
END-SUBROUTINE /* PROCESS-UNIX-PATH
*
************************************************************************--
DEFINE SUBROUTINE MOVE-TO-TEMP-DIR
************************************************************************--
* #PATH and #FILE-NAME-IN must be set
INCLUDE RMSCUX-C '#FILE-NAME-IN' ' '
*
END-SUBROUTINE /* MOVE-TO-TEMP-DIR
*
************************************************************************--
DEFINE SUBROUTINE PROCESS-UNIX-FILE
************************************************************************--
RESET #FILE-PROCESSED #SOURCE-ISN     /* BLI NOMALL-2422
/* Ignore nom meta data file / intermediate data file:
IF #FILE-NAME-IN = MASK (*'.nomxml') OR=MASK ('nomout-'*)
  ESCAPE ROUTINE
END-IF
#STACK-FUNCTION := 'PUSH' /* stack parameter for XXUX---N
CALLNAT 'XXUXST-N' #STACK-FUNCTION #STACK-RC XXUX---P
IF #STACK-RC NE 0
  G-NATRP-ERC := 5
  #LINE       := *LINE
  COMPRESS *PROGRAM *LINE 'Internal error: Stack overflow'
    TO G-NATRP-ERT
  ESCAPE ROUTINE
END-IF
IF #TRACING
  COMPRESS 'Processing File:' #FILE-NAME-IN TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
#R-TYPE := 'M' /* Master definitions first
REPDEF. REPEAT
  #RECEIPT-STAMP := 'Q' /* query receipt stamp for file
  COMPRESS #PATH #FILE-NAME-IN TO #FILE-ID LEAVING NO
  CALLNAT 'RMRCSTMP'
    #RECEIPT-STAMP
    SEQUENTIAL-FILE-UNIX
    UX-NODE-NAME
    #FILE-ID
    #TRACING 1X
  IF      #RECEIPT-STAMP NE ' ' /* someone is busy with it
      AND #RECEIPT-STAMP NE 'F' /* source record not found,to be created
    G-NATRP-ERC := 9997         /* postpone this file
    ESCAPE BOTTOM(REPDEF.)
  END-IF
  #R-IDENT-TYPE  := REPORT-IDENT-UNIX-PATH
  #R-IDENT-ITEM  := #PATH
  #CONTROL-TYPE  := REPORT-IDENT-UNIX-NODENAME
  #CONTROL-IDENT := UX-NODE-NAME
  COMPRESS #R-TYPE #CONTROL TO #R-TYPE-IDENT LEAVING NO
*
  FINDRP. FIND REPORT WITH R-TYPE-IDENT = #R-TYPE-IDENT
      AND R-IDENT = #R-IDENT            /* match node and path
      WHERE REPORT.R-TYPE = 'D' OR = 'M'
    FORFIL. FOR #FILES-INDEX = 1 TO C*R-IDENT-FILES
      RESET G-NATRP-ERC G-NATRP-ERT #LINE
      NAT41002-FIELD := #FILE-NAME-IN
      NAT41002-MASK  := R-IDENT-FILES (#FILES-INDEX)
      EXAMINE NAT41002-FIELD FOR ' ' GIVING LENGTH IN NAT41002-LENGTH
      NAT41002-WILDCARD     := '?'
      NAT41002-ASTERISK     := '*'
      NAT41002-ALLOW-BLANK  := 'N'
      IF #OPSYS =SCAN 'WIN' OR=SCAN 'Win' OR=SCAN 'win' /*Windows system
        EXAMINE NAT41002-FIELD AND TRANSLATE INTO UPPER CASE
        EXAMINE NAT41002-MASK  AND TRANSLATE INTO UPPER CASE
      END-IF
      EXAMINE NAT41002-MASK FOR ' ' AND DELETE
      IF #TRACING
        COMPRESS 'File name checked:' NAT41002-FIELD
          'with mask' NAT41002-MASK TO G-TRACE-MSG
        PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
        END TRANSACTION
      END-IF
      CALLNAT 'NAT41002' #NAT41002 /* Check for wildcard match
      IF #TRACING
        COMPRESS 'Matched? -->' NAT41002-MATCHED TO G-TRACE-MSG
        PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
        END TRANSACTION
      END-IF
      IF NAT41002-MATCHED NE 'Y' /* wildcards does not match real file
        ESCAPE TOP /*(FORFIL.) next mask
      END-IF
      IF +TRACE-ORDER = 'Y' /* TRACE-ORDER found in jobcards
        COMPRESS 'Task' G-TASK-NUMBER *PROGRAM
          'Report' REPORT.R-REPNAME 'matched file' #FILE-NAME-IN
          'with mask' NAT41002-MASK TO G-TRACE-MSG
        PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
      END-IF
      IF REPORT.R-PRINT-JOBCARD (*) = SCAN('input-cmd=')
        PERFORM MOVE-FILE-XML-TO-TEMP-DIR
        PERFORM EXEC-COMMAND /* on remote system from temp asynchr.
        ESCAPE TOP /*(FORFIL.) next mask
      END-IF
      DECIDE ON EVERY VALUE OF G-NATRP-ERC
        VALUE 0
          PERFORM SET-ATTRIBUTES
        VALUE 0
          PERFORM CREATE-SOURCE-RECORD
        VALUE 0
          PERFORM WRITE-ORDER-RECORDS
        ANY                             /* finally if one of above true
          DECIDE FOR EVERY CONDITION
            WHEN G-NATRP-ERC NE 0
                AND G-NATRP-ERC NE 9997 /* File ignored to check size
              IF G-NATRP-ERC NE 7137
                PERFORM SET-SUSPEND
                G-NATRP-ERC := 5        /* P-ERT already filled *
                #LINE       := *LINE
                #META-ERROR := FALSE
                PERFORM WRITE-ERROR-LOG
              ELSE
                #META-ERROR := TRUE
                G-NATRP-ERT := #FILE-NAME-IN /* BLI NOMALL-2422
                IF #R-TYPE EQ 'M'
                  PERFORM WRITE-ERROR-LOG
                END-IF
              END-IF
            WHEN G-NATRP-ERC = 9997
              IF #TRACING
                COMPRESS 'File:' #FILE-NAME-IN 'skipped.' TO G-TRACE-MSG
                PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
                END TRANSACTION
              END-IF
              ESCAPE BOTTOM (FINDRP.)
            WHEN G-NATRP-ERC NE 0
              IF #TRACING
                COMPRESS 'File:' #FILE-NAME-IN 'got error:'
                  G-NATRP-ERC G-NATRP-ERT TO G-TRACE-MSG
                PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
                END TRANSACTION
              END-IF
              ESCAPE TOP
            WHEN NONE
              IF NOT #FILE-PROCESSED
* If the first matching report is processed, its source is 'free'..
                IF #SOURCE-ISN NE 0   /* NOMALL-2422 BLI start
                  STMP.  GET SOURCE #SOURCE-ISN
* ..set -5amp HERE to 'S' (scanned) directly without RMRCSTMP due to
* many long named unix files are possible
                  IF SOURCE.SR-RECEIPT-STAMP EQ ' ' /* it is 'free'
                    SOURCE.SR-RECEIPT-STAMP := #RECEIPT-STAMP := 'S'
                    UPDATE (STMP.)
                    IF #TRACING
                      COMPRESS 'Stamp set to S for file' #FILE-ID
                        TO G-TRACE-MSG
                      PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
                      COMPRESS
                        'Source record' SR-ID 'short filename'
                        #SPOOL-UNIX-FILE-NAME
                        TO G-TRACE-MSG
                      PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
                    END-IF
                  ELSE
                    IF #RECEIPT-STAMP = 'S' /* already set, whyever BLI4
                      IGNORE
                    ELSE                    /* BLI4 end
                      #RECEIPT-STAMP := 'E'
                    END-IF                  /* BLI4
                  END-IF
                ELSE
                  #RECEIPT-STAMP := 'F'
                END-IF
                IF #RECEIPT-STAMP = 'E' OR = 'F'
**                IF +TRACE-ORDER = 'Y' BLI4 make it transparent
                  COMPRESS 'Task' G-TASK-NUMBER *PROGRAM
                    'Unexpected stamp' #RECEIPT-STAMP
                    TO G-TRACE-MSG
                  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
                  END TRANSACTION
**                END-IF
                  *ERROR-NR := 999     /* should no longer occur...
                END-IF
              END-IF
              #FILE-PROCESSED := TRUE  /* only first report and orders
              END TRANSACTION
              ESCAPE BOTTOM (FORFIL.)
          END-DECIDE
        NONE
          IGNORE
      END-DECIDE
    END-FOR
  END-FIND
  IF #FILE-PROCESSED OR #R-TYPE = 'D' /* second attempt
    IF G-NATRP-ERC =9997 OR=7137  /* File must be ignored for this cycle
        AND #TRACING
      COMPRESS 'File:' #FILE-NAME-IN
        'has been ignored in this cycle due to error:'
        G-NATRP-ERC G-NATRP-ERT TO G-TRACE-MSG
      PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
      END TRANSACTION
    END-IF
    ESCAPE BOTTOM (REPDEF.)
  END-IF
  IF #TRACING
    COMPRESS 'Now try the default report definitions.' TO G-TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
    END TRANSACTION
  END-IF
  #R-TYPE := 'D' /* try it once more with default rep
END-REPEAT
IF #TRACING AND G-NATRP-ERC = 9997
* BLI  NOMALL-2422 use #FILE-NAME-IN instead of #SPOOL-UNIX-FILE-NAME
    AND #FILE-NAME-IN NE MASK (*'.nomxml')
    AND #FILE-NAME-IN NE MASK ('nomout-'*) /* intermediate file
  COMPRESS 'Will be processed later:' #FILE-NAME-IN
    TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
IF NOT #FILE-PROCESSED  /* no reports found
AND G-NATRP-ERC NE 9997 /* 9997 means 'ignore file'                    *
  COMPRESS UX-NODE-NAME ':' #PATH #FILE-NAME-IN
    TO #FO-FILE LEAVING NO
  PERFORM ADD-IX-ENTRY
  #FO-STATUS (#FILE-IX) := 'B'      /* blacklisted
  #FO-ERC    (#FILE-IX) := G-NATRP-ERC
  #FO-ERT    (#FILE-IX) := G-NATRP-ERT
  #FO-ERL    (#FILE-IX) := #LINE
  IF #TRACING
    COMPRESS 'Blacklisted file:' #FO-FILE 'no report or error'
      #FO-ERC (#FILE-IX) #FO-ERT (#FILE-IX) 'in line'
      #FO-ERL (#FILE-IX) TO G-TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
    END TRANSACTION
  END-IF
END-IF
IF G-NATRP-ERC = 9997   /* 9997 means 'ignore file'
  RESET G-NATRP-ERC #LINE
ELSE
  COMPRESS UX-NODE-NAME ':' #PATH #FILE-NAME-IN  /* BLI NOMALL-2422
    TO #FO-FILE LEAVING NO
  EXAMINE #FO-FILE-TAB (*) FOR #FO-FILE GIVING INDEX #FILE-IX
  IF #FILE-IX NE 0
      AND #FO-STATUS (#FILE-IX) = ' '
    PERFORM DELETE-IX-ENTRY
  END-IF
END-IF
IF #TRACING
  COMPRESS 'Finished File:' #FILE-NAME-IN TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
#STACK-FUNCTION := 'POP' /* restore parameter for XXUX---N
CALLNAT 'XXUXST-N' #STACK-FUNCTION #STACK-RC XXUX---P
IF #STACK-RC NE 0
  G-NATRP-ERC := 5
  #LINE       := *LINE
  COMPRESS *PROGRAM  *LINE 'Internal error: Stack overflow'
    TO G-NATRP-ERT
  ESCAPE ROUTINE
END-IF
*
END-SUBROUTINE /* PROCESS-UNIX-FILE
*
************************************************************************--
DEFINE SUBROUTINE CREATE-SOURCE-RECORD
************************************************************************--
RESET #FOUND
#SPOOL-ATTRIBUTES-COMP := #SPOOL-ATTRIBUTES
#SPOOL-UNIX-PATH-COMP  := #SPOOL-UNIX-PATH
#CONTROL-TYPE-B        := SEQUENTIAL-FILE-UNIX
#CONTROL-IDENT         := #UNIX-IDENT
* Does SOURCE record exist (file already handled):
FNDP. FIND SOURCE WITH SR-CONTROL = #CONTROL /* not yet unique
  #SPOOL-ATTRIBUTES := SOURCE.SR-SPOOL-ATTRIBUTES
  XXHASH-PARMS.P-SHORT-NAME := #SPOOL-UNIX-FILE-NAME
  PERFORM GET-LONG-NAME
  IF  #SPOOL-UNIX-PATH-COMP = #SPOOL-UNIX-PATH
  AND #FILE-NAME-IN         = XXHASH-PARMS.P-LONG-NAME                /*
    #FOUND := TRUE
    #SOURCE-ISN := *ISN(FNDP.)                    /* BLI NOMALL-2422
    IF #TRACING
      COMPRESS 'Got source record' SR-ID 'and ident:' #CONTROL-IDENT
        TO  G-TRACE-MSG
      PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
      G-TRACE-MSG := 'Attributes of found source record:'
      PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
      CALLNAT 'RMTRCATT' #SPOOL-ATTRIBUTES G-TRACE-MSG
        SOURCE.SR-ATTRIBUTES-IDENT
      IF G-TRACE-MSG NE ' '
        PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
      END-IF
    END-IF
    ESCAPE BOTTOM (FNDP.)
  END-IF
END-FIND /*(FNDP.)
#SPOOL-ATTRIBUTES := #SPOOL-ATTRIBUTES-COMP
IF NOT #FOUND
  RESET SOURCE /*otherwise e.g. metadata is copied
  REPEAT
    CALLNAT 'RMSRID-N' SOURCE.SR-ID G-NATRP-ERC G-NATRP-ERT
    UNTIL G-NATRP-ERC NE 3145
  END-REPEAT
  IF G-NATRP-ERC NE 0
    RESET LG-OBJECT-NAME
    ESCAPE ROUTINE
  END-IF
  IF #TRACING               /* BLI NOMALL-2446 start
    COMPRESS 'Creating Source Record with SR-' 'ID:' SR-ID
      TO G-TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END-IF
  PERFORM CREATE-SHORT-NAME /* for new SR only
  IF G-NATRP-ERC NE 0
    BACKOUT TRANSACTION     /* for short name
    IF #TRACING
      COMPRESS 'Create Short Name Error' G-NATRP-ERC TO G-TRACE-MSG
      PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
    END-IF
    ESCAPE ROUTINE
  END-IF
  IF +G-NOMEXIT-ACTIVE (2)
    PERFORM CALL-NOM-EXIT-002
  END-IF
  PERFORM META-DATA
  IF G-NATRP-ERC NE 0
    BACKOUT TRANSACTION     /* for short name
    IF #TRACING
      COMPRESS 'Create Source Meta-Data Error' G-NATRP-ERC
        TO G-TRACE-MSG
      PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
    END-IF                  /* BLI NOMALL-2446 end
    ESCAPE ROUTINE
  END-IF
  SOURCE.SR-CONTROL-FLAG     := #CONTROL-FLAG
  SOURCE.SR-TYPE             := #SOURCE-TYPE
  SOURCE.SR-ATTRIBUTES-IDENT := #SOURCE-ATTRIBUTES
  SOURCE.SR-SPOOL-ATTRIBUTES := #SPOOL-ATTRIBUTES
  IF REPORT.R-REP-FORMAT = 'B'
    SOURCE.SR-CC-TYPE := BINARY
  ELSE
    SOURCE.SR-CC-TYPE := ASA-CODE
  END-IF
  SOURCE.SR-RECORD-LENGTH   := #RECORD-LENGTH
  SOURCE.SR-NUMBER-OF-LINES := #NUMBER-OF-LINES
  SOURCE.SR-MONITOR-ID      := G-MONITOR-ID
*
  IF #TRACING
    COMPRESS 'Writing Source Record with SR-' 'ID:' SR-ID
      'TYPE:' SR-TYPE 'MONITOR-ID:' SR-MONITOR-ID
      'NUMBER-OF-LINES:' SR-NUMBER-OF-LINES
      'ATTRBUTES-IDENT:' SR-ATTRIBUTES-IDENT TO G-TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END-IF
*
  SR-OBJECT-TYPE := 'SR'
  SR-OBJECT-TIME := *TIMX
  STORE-SRC.  STORE SOURCE
  #SOURCE-ISN := *ISN(STORE-SRC.)               /* BLI NOMALL-2422
  END TRANSACTION
END-IF
*
END-SUBROUTINE /* CREATE-SOURCE-RECORD
*
************************************************************************--
DEFINE SUBROUTINE WRITE-ORDER-RECORDS
************************************************************************--
* Create order record to load source into container file
#OD-TYPE           := OD-LOAD-SOURCE
#OD-TIME-SCHEDULED := *TIMX                 /* activate at once
PERFORM WRITE-AN-ORDER
* Now store order record to create an active report
#OD-TYPE := OD-CREATE-AR
RESET  #OD-TIME-SCHEDULED                   /* do not activate
PERFORM WRITE-AN-ORDER
G-CYCLE-WAS-IDLE:= FALSE
NOMWK-TASK-TYPE := EQU-CREATE-REPORTS
CALLNAT NOM-WAKE-MONITOR NOMWK-NOMVERS NOMWK-PARMS (*)
NOMWK-TASK-TYPE := EQU-CP-SRCE-BEGIN
CALLNAT NOM-WAKE-MONITOR NOMWK-NOMVERS NOMWK-PARMS (*)
*
END-SUBROUTINE /* WRITE-ORDER-RECORDS
*
************************************************************************--
DEFINE SUBROUTINE WRITE-AN-ORDER
************************************************************************--
RESET #ORDER-FOUND
FDOR. FIND ORDER WITH OD-SOURCE-ID = SOURCE.SR-ID
  #OD-TYPE-N := ORDER.OD-TYPE
  MOVE '00' TO SUBSTR (#OD-TYPE-A,1,2)
  IF #OD-TYPE-N = #OD-TYPE                 /* forget first 2 digits
  AND ORDER.OD-TYPE  < 7500             /* ignore orders in error     /*
  AND ((ORDER.OD-MASTER = REPORT.R-REPNAME                            /*
  AND #OD-TYPE-N    = OD-CREATE-AR)    /* one AR per report           /*
  OR #OD-TYPE-N     = OD-LOAD-SOURCE)                                 /*
    #ORDER-FOUND := TRUE
    IF +TRACE-ORDER = 'Y' /* TRACE-ORDER found in jobcards
      #TYPE-I := ORDER.OD-TYPE
      COMPRESS 'Task' G-TASK-NUMBER *PROGRAM
        'Order already found:' ORDER.OD-ID '- type' #TYPE-I
        '- created'   ORDER.OD-TIME-CREATED
        '- scheduled' ORDER.OD-TIME-SCHEDULED
        '- retry #'   ORDER.OD-RETRY-COUNT TO G-TRACE-MSG
      PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
    END-IF
    ESCAPE BOTTOM (FDOR.)
  END-IF
END-FIND /*(FDOR.)
IF NOT #ORDER-FOUND                        /* not yet created
  REPEAT
    CALLNAT 'RMODID-N' ORDER.OD-ID G-NATRP-ERC G-NATRP-ERT
    UNTIL G-NATRP-ERC NE 3145
  END-REPEAT
*
  IF G-NATRP-ERC NE 0
    RESET LG-OBJECT-NAME
    ESCAPE ROUTINE
  END-IF
  RESET ORDER.OD-PARAMETER (1)
  ORDER.OD-TYPE       := #OD-TYPE
  ORDER.OD-MONITOR-ID := G-MONITOR-ID
  ORDER.OD-USER-ID    := REPORT.R-USERID
  ORDER.OD-MASTER     := REPORT.R-REPNAME
  ORDER.OD-SOURCE-ID  := SOURCE.SR-ID
  ORDER.OD-REP-FORMAT      := REPORT.R-REP-FORMAT
  ORDER.OD-DBID-N5         := #CONTAINR-DB
  ORDER.OD-FNR-N5          := #CONTAINR-FNR
  ORDER.OD-TIME-CREATED    := *TIMX
  ORDER.OD-TIME-SCHEDULED  := #OD-TIME-SCHEDULED
  ORDER.OD-MAX-RETRIES     := #MAX-RETRIES
  ORDER.OD-RETRY-INTERVAL  := #RETRY-INTERVAL
  ORDER.OD-RETRY-COUNT := ORDER.OD-DBID := ORDER.OD-FNR  := 0
*
  IF #TRACING
    COMPRESS ' write order record with OD-'
      'PARAMETER:'      ORDER.OD-PARAMETER (1)
      'TYPE:'           ORDER.OD-TYPE
      'MONITOR-ID:'     ORDER.OD-MONITOR-ID
      'USER-ID:'        ORDER.OD-USER-ID
      'MASTER:'         ORDER.OD-MASTER
      'SOURCE-ID:'      ORDER.OD-SOURCE-ID
      'TIME-CREATED:'   ORDER.OD-TIME-CREATED
      'TIME-SCHEDULED:' ORDER.OD-TIME-SCHEDULED
      'MAX-RETRIES:'    ORDER.OD-MAX-RETRIES
      'RETRY-INTERVAL:' ORDER.OD-RETRY-INTERVAL TO G-TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END-IF
  IF +TRACE-ORDER = 'Y' /* TRACE-ORDER found in jobcards
    #TYPE-I := ORDER.OD-TYPE
    COMPRESS 'Task' G-TASK-NUMBER *PROGRAM
      'Order being created:' ORDER.OD-ID '- type' #TYPE-I
      '- created'   ORDER.OD-TIME-CREATED
      '- scheduled' ORDER.OD-TIME-SCHEDULED
      '- retry #'   ORDER.OD-RETRY-COUNT
      TO G-TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END-IF
*
  STOLO. STORE ORDER
  END OF TRANSACTION
*
END-IF
*
END-SUBROUTINE /* WRITE-AN-ORDER
*
************************************************************************
DEFINE SUBROUTINE SET-ATTRIBUTES /* for source and order records
************************************************************************
* BLI NOMALL-2294 the copy task stopped AR task creation, see below:
* This routine reads and checks the attributes of the physical file.
* If the first orders (OD-LOAD-SOURCE and OD-CREATE-AR) for this file
* are stored, we will skip the XX.. calls in this subroutine.
* The reasons are:
* - the attributes for further OD-CREATE-AR orders are already read/set.
* - the copy task could start (which will lock/delete the file).
* - if XXLOCKED fails, no further OD-CREATE-AR orders can be stored
IF NOT #FILE-PROCESSED                       /* BLI NOMALL-2294
  #STACK-FUNCTION := 'PUSH' /* stack parameter for XXUX---N
  CALLNAT 'XXUXST-N' #STACK-FUNCTION #STACK-RC XXUX---P
  IF #STACK-RC NE 0
    G-NATRP-ERC := 5
    COMPRESS *PROGRAM *LINE 'Internal error: Stack overflow'
      TO G-NATRP-ERT
    ESCAPE ROUTINE
  END-IF
  COMPRESS #PATH #FILE-NAME-IN TO P-FILE-NAME LEAVING NO
  #UNIX-FILE-SPEC := P-FILE-NAME /* A47 IDENT for CONTROL ÜÜ
*
  IF #TRACING
    CALLNAT 'XXLOCKED' XXUX---P G-TRACE
  ELSE
    CALLNAT 'XXLOCKED' XXUX---P
  END-IF
  IF P-ERC NE 0
    G-NATRP-ERC := P-ERC
    G-NATRP-ERT := P-ERT
* NOMALL-2088 use ERC instead scanning ERT
    IF P-ERC = 2036 OR = 2046      /* no ascii file. ..or = inserted
      COMPRESS 'No ASCII file:' P-FILE-NAME TO G-TRACE-MSG
      IF #TRACING
        PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
      END-IF
      RESET  P-ERT G-NATRP-ERT
      G-NATRP-ERC := 9997 /* 'postpone'
    END-IF
    #STACK-FUNCTION := 'POP' /* restore parameter for XXUX---N
    CALLNAT 'XXUXST-N' #STACK-FUNCTION #STACK-RC XXUX---P
    IF #STACK-RC NE 0
      G-NATRP-ERC := 5
      COMPRESS *PROGRAM *LINE 'Internal error: Stack overflow'
        TO G-NATRP-ERT
    END-IF
    ESCAPE ROUTINE
  END-IF
  #GETATTR   := XXUX---P.P-RECORD
  IF #SIZE < 1 /* is empty, ignore this file.
    G-NATRP-ERC := 9997
    IF #TRACING
      COMPRESS 'RC 9997 due to:' 'File processing of'
        XXUX---P.P-FILE-NAME 'postponed, file (still) empty.'
        TO G-TRACE-MSG
      PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
    END-IF
    ESCAPE ROUTINE
  END-IF
  #MIME-TYPE := P-MIME-TYPE
  COMPRESS UX-NODE-NAME ':' #PATH #FILE-NAME-IN  /* BLI NOMALL-2422
    TO #FO-FILE LEAVING NO
  PERFORM ADD-IX-ENTRY
  DECIDE FOR FIRST CONDITION
    WHEN #FILE-LOCKED = 'N'
      RESET #FO-STATUS (#FILE-IX) /* file can be processed.
    WHEN #FILE-LOCKED = 'Y'
      G-NATRP-ERC := 9997
      IF #TRACING
        COMPRESS 'RC 9997 due to:' 'File processing of'
          #FO-FILE-TAB (#FILE-IX)
          'postponed, file locked.' '/ Table-Index:' #FILE-IX
          TO G-TRACE-MSG
        PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
      END-IF
* The following coding has been disabled because we do no more check
* for changed file sizes to determine if another process is currently
* filling and so locking it.
* Routine XXLOCKED will always set locked to 'Y' or 'N' even if it
* could not be set by NPR Unix. In this case we are optimistic and
* assume that the file is not locked.
* This bears the danger that files which are still being written by
* other processes during reading by NOM may be incomplete.
* On Linux this cannot happen, on AIX it is not possible to check for
* locked files. So it is strongly recommended to create the output files
* on AIX in a different directory, and after creation to copy them
* to the input directory of NOM.
*    WHEN +FO-STATUS (#FILE-IX) = 'N'
*      G-NATRP-ERC := 9997 /* New, file to be checked after 10s
*    WHEN #FO-TIME > *TIMX /* File has to wait 10 sec for processing
*      G-NATRP-ERC           := 9997
    WHEN NONE
      RESET #FO-STATUS (#FILE-IX) /* file can be processed.
  END-DECIDE
  #STACK-FUNCTION := 'POP' /* restore parameter for XXUX---N
  CALLNAT 'XXUXST-N' #STACK-FUNCTION #STACK-RC XXUX---P
  IF #STACK-RC NE 0
    G-NATRP-ERC := 5
    COMPRESS *PROGRAM *LINE 'Internal error: Stack overflow' TO G-NATRP-ERT
  END-IF
  IF G-NATRP-ERC NE 0
    ESCAPE ROUTINE
  END-IF
END-IF
*
#SPOOL-UNIX-CONTAINER-DBID  := #CONTAINR-DB
#SPOOL-UNIX-CONTAINER-FNR   := #CONTAINR-FNR
#CONTROL-FLAG               := 'X'
#SOURCE-TYPE                := SEQUENTIAL-FILE-UNIX
#SPOOL-TYPE                 := SEQUENTIAL-FILE-UNIX
#UNIX-NODE-NAME             := UX-NODE-NAME
#RECORD-LENGTH              := 0 /* not given by GETATTR
#NUMBER-OF-LINES            := 0 /* not given by GETATTR
#USER-ID                    := #OWNER
#SPOOL-UNIX-NODE-NAME       := UX-NODE-NAME
#SPOOL-UNIX-USERID          := UX-NODE-USERID
#SPOOL-UNIX-CIPHER-PASSWORD := UX-NODE-PASSWORD
#SPOOL-UNIX-GROUP           := UX-NODE-GROUP
#SPOOL-UNIX-PATH            := #PATH
* BLI NOMALL-2422 #SPOOL-UNIX-FILE-NAME needs short name...
** PERFORM CREATE-SHORT-NAME   BLI NOMALL-2446 see CREATE-SOURCE-RECORD
*
END-SUBROUTINE /* SET-ATTRIBUTES
*
************************************************************************--
DEFINE SUBROUTINE WRITE-ERROR-LOG
************************************************************************--
DECIDE FOR FIRST CONDITION                              /* NOMALL-2088
  WHEN #UX-FUNCTION NE ' ' AND G-NATRP-ERT = SCAN 'NPR3355' /* Exit code
    COMPRESS G-NATRP-ERT '/Fn:' #UX-FUNCTION TO G-NATRP-ERT LEAVING NO
* NOM, SAT or NPR ?
  WHEN NOT (G-NATRP-ERT =MASK (NNNN) OR=MASK (AAANNNN)) /* NOMALL-2088
    COMPRESS G-NATRP-ERC-A G-NATRP-ERT TO G-NATRP-ERT
  WHEN NONE IGNORE
END-DECIDE
PERFORM XXLOGERR-LOG-ERROR 'W' G-NATRP-ERC G-NATRP-ERT
END TRANSACTION
RESET G-NATRP-ERC G-NATRP-ERT #LINE
*
END-SUBROUTINE /* WRITE-ERROR-LOG
*
************************************************************************--
DEFINE SUBROUTINE CALL-NOM-EXIT-002
************************************************************************--
* (Allow modification of spool attributes)
CALLNAT 'NOMEX002' #SPOOL-ATTRIBUTES G-NATRP-ERC G-NATRP-ERT
IF G-NATRP-ERC NE 0
  PERFORM WRITE-ERROR-LOG
END-IF
COMPRESS 'nomex002 erc=' G-NATRP-ERC ',ert=' G-NATRP-ERT
  TO G-TRACE-MSG LEAVING NO
IF #TRACING
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
*
END-SUBROUTINE /* CALL-NOM-EXIT-002
*
************************************************************************--
DEFINE SUBROUTINE UNIX-FUNCTION
************************************************************************--
XXUX---P.P-NODE-NAME       := UX-NODE-NAME
XXUX---P.P-NODE-SUSPEND    := UX-NODE-SUSPEND
XXUX---P.P-FUNCTION        := #UX-FUNCTION
XXUX---P.P-USERID          := UX-NODE-USERID
XXUX---P.P-CIPHER-PASSWORD := UX-NODE-PASSWORD
XXUX---P.P-GROUP           := UX-NODE-GROUP
XXUX---P.P-LOG-FUNCTION    := 'W'
IF #TRACING
  COMPRESS 'Executing Unix Services:' 'P-FUNCTION:'  XXUX---P.P-FUNCTION
    '- P-NODE-NAME:' P-NODE-NAME '- P-USERID:'    P-USERID
    '- P-log-function:' P-LOG-FUNCTION '- P-FILE-NAME:' P-FILE-NAME
    '- P-RECORD:'    XXUX---P.P-RECORD TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  CALLNAT 'XXUX---N' XXUX---P G-TRACE
ELSE
  CALLNAT 'XXUX---N' XXUX---P
END-IF
*
G-NATRP-ERC := P-ERC
COMPRESS UX-NODE-NAME '/' #UX-FUNCTION '/' P-ERT TO G-NATRP-ERT
*
END-SUBROUTINE /* UNIX-FUNCTION
*
************************************************************************--
DEFINE SUBROUTINE MOVE-BLACKLISTED
************************************************************************--
IF *OCC(#FO-STATUS) = 0
  ESCAPE ROUTINE
END-IF
REPEAT
  EXAMINE #FO-STATUS (*) FOR 'B' GIVING INDEX #FILE-IX
  IF #FILE-IX > 0
    IF #META-ERROR
      G-NATRP-ERC := 7137 /* Error in meta-data processing (XML)
    ELSE
      G-NATRP-ERC := 2044 /* no reports found, deleting file:1:
    END-IF
    COMPRESS #FO-FILE-TAB (#FILE-IX) #FO-ERC (#FILE-IX)
      #FO-ERT (#FILE-IX) #FO-ERL (#FILE-IX) TO G-NATRP-ERT
    REPEAT
      EXAMINE G-NATRP-ERT FOR '/' GIVING POSITION #POS
      SEPARATE G-NATRP-ERT INTO #FILE-NAME-MSG REMAINDER G-NATRP-ERT
        WITH DELIMITERS '/'
      UNTIL #POS = 0
    END-REPEAT
    G-NATRP-ERT := #FILE-NAME-MSG
    PERFORM WRITE-ERROR-LOG
*
    RESET #PATH #SPOOL-UNIX-FILE-NAME #FILE-NAME-IN  /* NOMALL-2422 BLI
      G-NATRP-ERC G-NATRP-ERT
    SEPARATE #FO-FILE-TAB (#FILE-IX) INTO #PATH1 /*exclude node notation
      REMAINDER #FO-FILE-TAB (#FILE-IX) WITH DELIMITERS ':'
    REPEAT
      SEPARATE #FO-FILE-TAB (#FILE-IX) INTO #PATH1
        REMAINDER #FO-FILE-TAB (#FILE-IX) WITH DELIMITERS '/'
      IF #FO-FILE-TAB (#FILE-IX) = ' '
**      #SPOOL-UNIX-FILE-NAME := #PATH1      /* NOMALL-2422 BLI
        #FILE-NAME-IN := #PATH1              /* NOMALL-2422 BLI
      ELSE
        COMPRESS #PATH #PATH1 '/' TO #PATH LEAVING NO
      END-IF
      UNTIL #FO-FILE-TAB (#FILE-IX) = ' '
    END-REPEAT
* we need the above extracted #PATH and #FILE-NAME-IN for MOVE-FILE..
    PERFORM MOVE-FILE-XML-TO-TEMP-DIR
    PERFORM DELETE-IX-ENTRY
  END-IF
  UNTIL #FILE-IX = 0
END-REPEAT
*
END-SUBROUTINE /* MOVE-BLACKLISTED
*
************************************************************************--
DEFINE SUBROUTINE ADD-IX-ENTRY
************************************************************************--
IF G-NATRP-ERC NE 0
  PERFORM XXLOGERR-LOG-ERROR 'W' G-NATRP-ERC G-NATRP-ERT
END-IF
EXAMINE #FO-FILE-TAB (*) FOR #FO-FILE GIVING INDEX #FILE-IX
IF #FILE-IX = 0
  IF #FILE-IX-LAST GE *OCC (#FO-FILE-TAB)
    #I := *OCC (#FO-FILE-TAB) + 50
    EXPAND ARRAY #FO-FILE-TAB   TO (1:#I)
    EXPAND ARRAY #FO-SIZE       TO (1:#I)
    EXPAND ARRAY #FO-STATUS     TO (1:#I)
    EXPAND ARRAY #FO-ERC        TO (1:#I)
    EXPAND ARRAY #FO-ERT        TO (1:#I)
    EXPAND ARRAY #FO-ERL        TO (1:#I)
  END-IF
  ADD 1 TO #FILE-IX-LAST
  #FO-FILE-TAB (#FILE-IX-LAST) := #FO-FILE
  #FO-SIZE     (#FILE-IX-LAST) := #SIZE
  #FO-STATUS   (#FILE-IX-LAST) := 'N'  /* file is new
  #FILE-IX                     := #FILE-IX-LAST
ELSE
  #FO-STATUS (#FILE-IX)   := 'O'       /* file is open by someone else
END-IF
IF #TRACING
  COMPRESS 'Added file:' #FO-FILE 'index' #FILE-IX
    'with status' #FO-STATUS (#FILE-IX) TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END TRANSACTION
END-IF
*
END-SUBROUTINE /* ADD-IX-ENTRY
*
************************************************************************--
DEFINE SUBROUTINE DELETE-IX-ENTRY
************************************************************************--
IF #FILE-IX < #FILE-IX-LAST
  #FILE-IX-FROM := #FILE-IX      + 1
  #FILE-IX-TO   := #FILE-IX-LAST - 1
  #I4 := #FILE-IX-FROM /*SU just to reduce space in lines below
  #FO-FILE-TAB (#FILE-IX:#FILE-IX-TO) :=
    #FO-FILE-TAB (#I4:#FILE-IX-LAST)
  #FO-SIZE  (#FILE-IX:#FILE-IX-TO) := #FO-SIZE  (#I4:#FILE-IX-LAST)
  #FO-STATUS(#FILE-IX:#FILE-IX-TO) := #FO-STATUS(#I4:#FILE-IX-LAST)
  #FO-ERC   (#FILE-IX:#FILE-IX-TO) := #FO-ERC   (#I4:#FILE-IX-LAST)
  #FO-ERT   (#FILE-IX:#FILE-IX-TO) := #FO-ERT   (#I4:#FILE-IX-LAST)
  #FO-ERL   (#FILE-IX:#FILE-IX-TO) := #FO-ERL   (#I4:#FILE-IX-LAST)
  REDUCE DYNAMIC #FO-FILE-TAB (#FILE-IX-LAST) TO 0
  RESET #FO-SIZE (#FILE-IX-LAST) #FO-STATUS (#FILE-IX-LAST)
    #FO-ERC (#FILE-IX-LAST)
    #FO-ERT (#FILE-IX-LAST)
    #FO-ERL (#FILE-IX-LAST)
ELSE
  REDUCE DYNAMIC #FO-FILE-TAB (#FILE-IX) TO 0
  RESET #FO-SIZE (#FILE-IX) #FO-STATUS (#FILE-IX)
    #FO-ERC      (#FILE-IX)
    #FO-ERT      (#FILE-IX)
    #FO-ERL      (#FILE-IX)
END-IF
SUBTRACT 1 FROM #FILE-IX-LAST
IF #TRACING
  COMPRESS 'Deleted index' #FILE-IX TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END TRANSACTION
END-IF
*
END-SUBROUTINE /* DELETE-IX-ENTRY
*
************************************************************************--
************************************************************************--
*
************************************************************************--
DEFINE SUBROUTINE MOVE-FILE-XML-TO-TEMP-DIR
************************************************************************--
PERFORM MOVE-TO-TEMP-DIR
RESET G-NATRP-ERC G-NATRP-ERT #LINE
IF #FILE-NAME-IN NE MASK (*'.nomxml')
  INCLUDE RMSCUX-C '#FILE-NAME-IN' '''.nomxml'''
  RESET G-NATRP-ERC G-NATRP-ERT #LINE
END-IF
*
END-SUBROUTINE /* MOVE-FILE-XML-TO-TEMP-DIR
*
************************************************************************--
DEFINE SUBROUTINE EXEC-COMMAND
************************************************************************--
EXAMINE #JOBCARD FOR 'input-cmd=' GIVING POSITION #POS LENGTH #LEN
ADD 11 TO #POS
IF #POS > 11 AND #POS LE #LEN
  COMPRESS #PATH P-FILE-NAME '.cmd' TO P-FILE-NAME LEAVING              NO
  IF P-FILE-NAME = SCAN ('.cmd.cmd') /* functional loop detected
    G-NATRP-ERC := 2050
    G-NATRP-ERT := P-FILE-NAME
    PERFORM WRITE-ERROR-LOG
    RESET G-NATRP-ERC G-NATRP-ERT #LINE
    ESCAPE ROUTINE
  END-IF
  XXUX---P.P-RECORD := SUBSTR (#JOBCARD,#POS)
  EXAMINE XXUX---P.P-RECORD FOR ' ' GIVING LENGTH #LEN
  #LEN-RECORD := #LEN
  REPEAT /* find escaped '"' character and find end of string
    EXAMINE XXUX---P.P-RECORD FOR '""' REPLACE FIRST WITH '"'
      GIVING POSITION #POS
    IF #POS NE 0
      #LEN := #POS + 1
    END-IF
    UNTIL #POS = 0
  END-REPEAT
  IF #LEN LE #LEN-RECORD
    EXAMINE SUBSTR(XXUX---P.P-RECORD,#LEN) FOR '"' GIVING POSITION #POS
    IF #POS NE 0
      #LEN := #LEN + #POS - 2
    ELSE
      #LEN := #LEN-RECORD
    END-IF
  END-IF
  XXUX---P.P-RECORD := SUBSTR (XXUX---P.P-RECORD,1,#LEN)
  EXAMINE XXUX---P.P-RECORD FOR '$1' REPLACE WITH P-TARGET-FILE
  EXAMINE XXUX---P.P-RECORD FOR '%1' REPLACE WITH P-TARGET-FILE
  #UX-FUNCTION := 'SUBMIT'
  PERFORM UNIX-FUNCTION
  IF G-NATRP-ERC NE 0
    ESCAPE ROUTINE
  END-IF
END-IF
*
END-SUBROUTINE /* EXEC-COMMAND
*
************************************************************************--
DEFINE SUBROUTINE META-DATA
************************************************************************--
IF #PATH = ' ' OR #SPOOL-UNIX-FILE-NAME = ' '
  ESCAPE ROUTINE
END-IF
#STACK-FUNCTION := 'PUSH' /* stack parameter for XXUX---N
CALLNAT 'XXUXST-N' #STACK-FUNCTION #STACK-RC XXUX---P
IF #STACK-RC NE 0
  G-NATRP-ERC := 5
  COMPRESS *PROGRAM *LINE  'Internal error: Stack overflow'
    TO G-NATRP-ERT
  ESCAPE ROUTINE
END-IF
RESET NOMRPC-PARMS NOMRPC-DATA #SPOOL-ATTR-EXTENDED XXUX---P
RESIZE DYNAMIC NOMRPC-DATA          TO 0
RESIZE DYNAMIC #SPOOL-ATTR-EXTENDED TO 0
#UX-FUNCTION := 'GETATTR'
XXHASH-PARMS.P-SHORT-NAME := #SPOOL-UNIX-FILE-NAME
PERFORM GET-LONG-NAME
COMPRESS '"' #PATH XXHASH-PARMS.P-LONG-NAME '.nomxml' '"'
  TO P-FILE-NAME LEAVING NO
EXAMINE P-FILE-NAME FOR '"' AND DELETE
PERFORM UNIX-FUNCTION
P-FILE-NAME := #FILE-NAME-IN
IF G-NATRP-ERC NE 0
  RESET G-NATRP-ERT G-NATRP-ERC P-ERC P-ERT #LINE
  IF #TRACING
    COMPRESS 'No meta data accessible:' P-FILE-NAME TO G-TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END-IF
  #STACK-FUNCTION := 'POP' /* stack parameter for XXUX---N
  CALLNAT 'XXUXST-N' #STACK-FUNCTION #STACK-RC XXUX---P
  IF #STACK-RC NE 0
    G-NATRP-ERC := 5
    COMPRESS *PROGRAM *LINE 'Internal error: Stack overflow'
      TO G-NATRP-ERT
  END-IF
  ESCAPE ROUTINE
END-IF
RESET XXUX---P G-NATRP-ERT G-NATRP-ERC
NOMRPC-FUNCTION := 'OPEN'
NOMRPC-DATA := '<?xml version="1.0"  ?>'-'<multi_data>'-'</multi_data>'
PERFORM CALL-NOMRPCX
IF G-NATRP-ERC NE 0
  #STACK-FUNCTION := 'POP' /* stack parameter for XXUX---N
  CALLNAT 'XXUXST-N' #STACK-FUNCTION #STACK-RC XXUX---P
  IF #STACK-RC NE 0
    G-NATRP-ERC := 5
    COMPRESS *PROGRAM *LINE 'Internal error: Stack overflow' TO G-NATRP-ERT
  END-IF
  ESCAPE ROUTINE
END-IF
NOMRPC-FUNCTION := 'PUT'
RESET NOMRPC-DATA
XXHASH-PARMS.P-SHORT-NAME := #SPOOL-UNIX-FILE-NAME
PERFORM GET-LONG-NAME
COMPRESS #PATH XXHASH-PARMS.P-LONG-NAME
  P-FILE-NAME '.nomxml' TO P-FILE-NAME LEAVING NO
P-BINARY     := 'N'
#UX-FUNCTION := 'READ'
READUX. REPEAT
  PERFORM UNIX-FUNCTION
  IF G-NATRP-ERC NE 0  /* No XML file found NOMALL-2088
    ESCAPE BOTTOM (READUX.)
  END-IF
  IF XXUX---P.P-RECORD = SCAN ('<data>') OR = SCAN ('<DATA>')
    G-NATRP-ERC := 2140
    RESET G-NATRP-ERT
    PERFORM WRITE-ERROR-LOG
    #STACK-FUNCTION := 'POP'         /* stack parameter for XXUX---N
    CALLNAT 'XXUXST-N' #STACK-FUNCTION #STACK-RC XXUX---P
    IF #STACK-RC NE 0
      G-NATRP-ERC := 5
      COMPRESS *PROGRAM *LINE 'Internal error: Stack overflow'
        TO G-NATRP-ERT
    END-IF
    ESCAPE ROUTINE
  END-IF
  COMPRESS NOMRPC-DATA XXUX---P.P-RECORD TO NOMRPC-DATA
  IF G-NATRP-ERC NE 0 OR #EOF
    ESCAPE BOTTOM (READUX.)
  END-IF
END-REPEAT
#STACK-FUNCTION := 'POP'                 /* stack parameter for XXUX---N
CALLNAT 'XXUXST-N' #STACK-FUNCTION #STACK-RC XXUX---P
IF #STACK-RC NE 0
  G-NATRP-ERC := 5
  COMPRESS *PROGRAM *LINE 'Internal error: Stack overflow'
    TO G-NATRP-ERT
  ESCAPE ROUTINE
END-IF
PERFORM CALL-NOMRPCX
IF G-NATRP-ERC NE 0
  ESCAPE ROUTINE
END-IF
NOMRPC-FUNCTION := 'CLOSE'
RESET NOMRPC-DATA
RESIZE DYNAMIC NOMRPC-DATA TO 0
PERFORM CALL-NOMRPCX
IF G-NATRP-ERC NE 0
  ESCAPE ROUTINE
END-IF
#LEN := *LENGTH(#SPOOL-ATTR-EXTENDED)
FOR #I = 1 TO 120
  #POS-ABS := (#I - 1) * 250 + 1           /* absolute position of chunk
  IF #POS-ABS > #LEN
    ESCAPE BOTTOM                                           /* That's it
  END-IF
  #POS-END := (#I - 1) * 250 + 250     /* absolute end position of chunk
  IF #POS-END > #LEN
    #POS-LEN := #LEN - #POS-ABS + 1       /* correct length of substring
  ELSE
    #POS-LEN := 250                               /* take the full chunk
  END-IF
  MOVE SUBSTR(#SPOOL-ATTR-EXTENDED,#POS-ABS,#POS-LEN)
    TO SOURCE.SR-SPOOL-ATTR-EXTENDED (#I)
END-FOR
*
END-SUBROUTINE /* META-DATA
*
************************************************************************--
DEFINE SUBROUTINE CALL-NOMRPCX
************************************************************************
CALLNAT 'NOMRPCX' NOMRPC-PARMS
IF NOMRPC-RC NE 0
  G-NATRP-ERC := 7137 /* Error during XML processing
  G-NATRP-ERT := P-FILE-NAME
  BACKOUT TRANSACTION
END-IF
*
END-SUBROUTINE /* CALL-NOMRPCX
*
************************************************************************
DEFINE SUBROUTINE GET-LONG-NAME
************************************************************************
XXHASH-PARMS.P-FUNCTION   := 'L' /*short -> long
XXHASH-PARMS.P-TRACE-HASH := #TRACING
PERFORM XXHASH XXHASH-PARMS
*
END-SUBROUTINE /* GET-LONG-NAME
*
************************************************************************
DEFINE SUBROUTINE CREATE-SHORT-NAME /* for #SPOOL-UNIX-FILE-NAME
************************************************************************
RESET G-NATRP-ERC #LINE
XXHASH-PARMS.P-FUNCTION   := 'S' /* long -> short + store
XXHASH-PARMS.P-LONG-NAME  := #FILE-NAME-IN
XXHASH-PARMS.P-TRACE-HASH := #TRACING
PERFORM XXHASH XXHASH-PARMS
IF XXHASH-PARMS.P-RC = 0
  #SPOOL-UNIX-FILE-NAME := XXHASH-PARMS.P-SHORT-NAME
ELSE
  PERFORM MOVE-TO-TEMP-DIR
  EXAMINE #FILE-NAME-IN FOR ' ' GIVING LENGTH #LEN
  IF #LEN > 10
    SUBTRACT 10 FROM #LEN
  END-IF
  G-NATRP-ERC := 1120
  RESET G-NATRP-ERT
  #FILE-NAME-MSG := #FILE-NAME-IN
  PERFORM CREATE-NAME-FOR-MSG
  G-NATRP-ERT := #FILE-NAME-MSG
  PERFORM WRITE-ERROR-LOG
END-IF
*
END-SUBROUTINE /* CREATE-SHORT-NAME
*
************************************************************************
DEFINE SUBROUTINE CREATE-NAME-FOR-MSG
************************************************************************
EXAMINE #FILE-NAME-MSG FOR ' ' GIVING LENGTH #LEN1
IF #LEN > 30
  COMPRESS SUBSTR(#FILE-NAME-MSG,1,10) '...'
    SUBSTR(#FILE-NAME-MSG,#LEN) TO #FILE-NAME-MSG LEAVING NO
END-IF
*
END-SUBROUTINE /* CREATE-NAME-FOR-MSG
*
END
