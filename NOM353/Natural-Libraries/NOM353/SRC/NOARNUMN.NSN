* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* NOARNUMN - EOM API Active Report List (number)
*
* Maintenance:
* XSETHZ  2002-06-07 created
* XSETHZ  2013-02-14 ES-1499 (new descriptors in NRM-MAIL)
* --------------------------------------------------------------------
DEFINE DATA
PARAMETER
1 #MA-FOLDER-REP-P (A41)
1 #FO-LINKED-FO-ID (A10)
1 #AR-NUMBER       (N7)
************************************************************************
LOCAL
1 MA-N VIEW OF NRM-MAIL
1 FO-L VIEW OF NRM-FOLDER
  2 FO-LINKED-FO-ID
  2 REDEFINE FO-LINKED-FO-ID
    3 FO-LINKED-USER-ID    (A8)
    3 FO-LINKED-ID         (B2)
1 #S-USER-FO-ID            (A10)
1 REDEFINE #S-USER-FO-ID
  2 #S-USER                (A8)
  2 #S-FO-ID               (B2)
1 #MA-FOLDER-REP           (A41)
1  REDEFINE #MA-FOLDER-REP
  2 #MA-FOLDER-USER-ID     (A8)
  2 #MA-FOLDER-ID          (B2)
  2 #MA-REP                (A25)
  2 #MA-RNB                (P11)
1 #MA-FOLDER-REP-E         (A41)
1  REDEFINE #MA-FOLDER-REP-E
  2 #MA-FOLDER-USER-ID-E   (A8)
  2 #MA-FOLDER-ID-E        (B2)
  2 #MA-REP-E              (A25)
  2 #MA-RNB-E              (P11)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET #AR-NUMBER
#MA-FOLDER-REP := #MA-FOLDER-REP-P
#MA-FOLDER-REP-E := #MA-FOLDER-REP-P
#MA-RNB := 0
#MA-RNB-E := 99999999999
FO-L.FO-LINKED-FO-ID := #FO-LINKED-FO-ID
FNMAR2. FIND NUMBER MA-N WITH MA-FOLDER-REP-RNB = #MA-FOLDER-REP
  THRU  #MA-FOLDER-REP-E
#AR-NUMBER := *NUMBER(FNMAR2.)
REPFOL4. REPEAT WHILE FO-L.FO-LINKED-USER-ID NE ' '
  #MA-FOLDER-USER-ID := FO-L.FO-LINKED-USER-ID
  #MA-FOLDER-ID := FO-L.FO-LINKED-ID
  #MA-FOLDER-REP-E := #MA-FOLDER-REP
  #MA-RNB-E := 99999999999
  FNMAR3. FIND NUMBER MA-N WITH MA-FOLDER-REP-RNB = #MA-FOLDER-REP
    THRU  #MA-FOLDER-REP-E
  #AR-NUMBER := #AR-NUMBER + *NUMBER(FNMAR3.)
  #S-USER := FO-L.FO-LINKED-USER-ID
  #S-FO-ID := FO-L.FO-LINKED-ID
  FIND FO-L WITH FO-USER-FO-ID = #S-USER-FO-ID
    IF NO RECORDS FOUND
      ESCAPE BOTTOM (REPFOL4.)
    END-NOREC
  END-FIND
END-REPEAT
*
END
