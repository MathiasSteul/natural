* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    NOMLGUSN
* Version   2.1
* Function  Call RLOG from user exit NOMLGUS to write a user log record
*
*
* Maintenance
* uuu     yyyy-mm-dd s(999999) ...
* fhi     2001-09-20 s(999999) created
* xsetggr 2008-12-05 P300323   add steplibs
* xsetggr 2009-02-10 P300323   delete steplib handling, get err msg lib
*                              by RGETLIB
* SU1     2013-01-31 unused      Deactivate unused data areas
* SU2     2014-11-12 NOMALL-1527 getting rid of coding for old versions-
*                                only restruct
* ----------------------------------------------------------------------
DEFINE DATA
PARAMETER USING NOMLGUSP
************************************************************************
LOCAL USING RLOG-L
LOCAL USING SATLGV1P
LOCAL USING RACTLF-A
*
LOCAL
1 #LFILE         (N5)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET NOMLGUS-ERROR-CODE NOMLGUS-ERROR-TEXT
*
CALLNAT 'SATLGFVN' SATLGV-PARMS
IF SATLGV-RC NE 0
  NOMLGUS-ERROR-CODE := 1542
  #LFILE := 131
  PERFORM GET-ERR-TXT
  ESCAPE ROUTINE
END-IF
*
RESET RACTLF-LOGGING RACTLF-ERROR-LOGGING
RACTLF-LFILE-1 := 91
RACTLF-LFILE-2 := 206
CALLNAT 'RACTLF-N' RACTLF-PARMS
IF RACTLF-ERROR-CODE NE 0
  NOMLGUS-ERROR-CODE := 1542
  #LFILE := 191
  PERFORM GET-ERR-TXT
  ESCAPE ROUTINE
END-IF
*
PL-PARMS.LG-USERID      := *USER
PL-PARMS.LG-CODE        := 'UI'   /* User information
PL-PARMS.LG-MSG         := NOMLGUS-PARMS.LG-MSG
PL-PARMS.LG-OBJECT-NAME := NOMLGUS-PARMS.LG-OBJECT-NAME
CALLNAT 'RLOG' PL-PARMS
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE GET-ERR-TXT
************************************************************************
NOMLGUS-ERROR-TEXT :=F#GETMSG(<NOMLGUS-ERROR-CODE,#LFILE>) /*SU 2018-04
*
END-SUBROUTINE /* GET-ERR-TXT
*
END
