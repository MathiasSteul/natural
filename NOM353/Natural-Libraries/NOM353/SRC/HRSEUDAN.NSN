* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* HRSEUDAN
* Function:  Select a user defined archive
* sju 02-04-23 NOM221   Created
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 #ARCHIVE-TYPE        (A1)
1 #USER-ID             (A8)
1 #USER-TYPE           (A1)
************************************************************************
LOCAL USING VUSARC-L
LOCAL
1 #I                   (P2)
1 #J                   (P2)
1 #NOFLINES            (I2)   CONST <10>
1 #SCREEN  (1:#NOFLINES)
  2 L-NAME             (A8)
  2 L-MONITOR-ID       (A10)
  2 REDEFINE L-MONITOR-ID
    3 L-MONITOR-ID-FIXED(A8)
    3 L-NUMBER          (A1)
1 CV-MARK              (C/1:#NOFLINES)
1 CV-LINE              (C/1:#NOFLINES)
1 L-MARK               (A1/1:#NOFLINES)
1 END-OF-PROCESSING    (L)
1 END-OF-DISPLAY       (L)
1 END-OF-DATA          (L)
1 NEW-SEARCH           (L)
*
1 #ERC                 (N4)
1 #PAGE                (P3)  INIT <1>
1 #NOFPAGES            (I2)  CONST <1>
1 #ARCID               (A10/1:20)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
PERFORM PF-KEYS
#ARCID(#PAGE):= 'USERARC00'
MAIN. REPEAT UNTIL END-OF-PROCESSING
  #I:= 1
  RESET INITIAL END-OF-DATA
  L-NAME(#I):= 'Standard'
  L-MONITOR-ID(#I):= 'USERARC00'
  REA. READ NRM-USER-DEFINED-ARCHIVE BY M-MONITOR-ID = #ARCID(#PAGE)
    IF M-MONITOR-ID NE MASK ('USERARC0'N)
      ESCAPE BOTTOM
    END-IF
    IF #I = #NOFLINES
      PERFORM SCREEN-IO
      IF END-OF-PROCESSING
        ESCAPE BOTTOM (REA.)
      END-IF
    END-IF
    ADD 1 TO #I
    L-NAME(#I):= M-USERARC-NAME
    L-MONITOR-ID(#I):= M-MONITOR-ID
    CV-MARK (#I) := (AD=I)
  END-READ
  DECIDE FOR FIRST CONDITION
    WHEN #I > 0
      END-OF-DATA := TRUE
    WHEN *COUNTER (REA.) = 0
      ESCAPE BOTTOM (MAIN.)
    WHEN ANY
      PERFORM SCREEN-IO
    WHEN NONE
      IGNORE
  END-DECIDE
END-REPEAT
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE SCREEN-IO
************************************************************************
IF #I < #NOFLINES
  CV-MARK (#I+1:#NOFLINES) := (AD=DP)
END-IF
RESET END-OF-DISPLAY
REPEAT
  DECIDE FOR FIRST CONDITION
    WHEN #ERC NE 0
      IGNORE
    WHEN END-OF-DATA AND #PAGE > 1
      #ERC := 12                   /* bottom of data
    WHEN END-OF-DATA AND #PAGE = 1
      #ERC := 14                   /* all
    WHEN NOT END-OF-DATA AND #PAGE = 1
      #ERC := 11                   /* top of data
    WHEN NONE
      #ERC := 13                   /* more
  END-DECIDE
  PERFORM FLIP-DISPLAY
  SET CONTROL 'WC20L40B3/39F'
  SET CONTROL 'M17'
  SET CONTROL 'Y41'
  INPUT WITH TEXT *#ERC
    USING MAP 'HSELUDA&'
  SET CONTROL 'WB'
  SET CONTROL 'M21'
  SET CONTROL 'YB'
  RESET #ERC
  PERFORM COMMAND-PF-KEY
  UNTIL END-OF-DISPLAY
END-REPEAT
RESET #I #SCREEN (*)
*
END-SUBROUTINE /* SCREEN-IO
*
************************************************************************
DEFINE SUBROUTINE COMMAND-PF-KEY
************************************************************************
FOR #J = 1 TO #I
  IF L-MARK (#J) NE ' '
    #ARCHIVE-TYPE := L-NUMBER(#J)
    END-OF-PROCESSING := END-OF-DISPLAY := TRUE
    ESCAPE ROUTINE
  END-IF
END-FOR
DECIDE ON FIRST *PF-KEY
  VALUE 'PF3'
    END-OF-PROCESSING := END-OF-DISPLAY := TRUE
  VALUE 'PF7'
    IF #PAGE > 1
      #PAGE := #PAGE - 1
      END-OF-DATA := FALSE
      END-OF-DISPLAY := NEW-SEARCH := TRUE
    END-IF
  VALUE 'PF8'
    IF NOT END-OF-DATA
      ADD 1 TO #PAGE
      IF #PAGE > #NOFPAGES
        #PAGE := #NOFPAGES
        #ARCID (1:19) := #ARCID (2:20)
      END-IF
      #ARCID (#PAGE) := M-MONITOR-ID
      END-OF-DISPLAY := TRUE
    END-IF
  NONE IGNORE
END-DECIDE
*
END-SUBROUTINE /* COMMAND-PF-KEY
*
************************************************************************
DEFINE SUBROUTINE PF-KEYS
************************************************************************
SET KEY PF1 = PGM PF2 = PGM PF3 = PGM PF4 = PGM PF5 = PGM PF6 = PGM
  PF7 = PGM PF8 = PGM PF9 = PGM PF10 = PGM PF11 = PGM PF12 = PGM
*
END-SUBROUTINE /* PF-KEYS
*
END
