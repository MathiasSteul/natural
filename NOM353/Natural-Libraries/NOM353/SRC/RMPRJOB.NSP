END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
IF G-TRACE GE *LEVEL AND G-TRACE-SET = SCAN ('PRINT')
  #TRACING := TRUE
END-IF
IF #TRACING AND G-TRACE-SET = SCAN ('PRINT')
  FORMAT PS=60 LS=133
END-IF
INCLUDE CMRDC
RESET G-NATRP-ERC G-NATRP-ERT
DECIDE FOR EVERY CONDITION
  WHEN G-NATRP-ERC = 0
    PERFORM INIT-FUNCTION
    LG-MSG := 'init function'
  WHEN G-NATRP-ERC = 0
    PERFORM PROCESS-UNTIL-EOMSTARTSTEP
    LG-MSG := 'process until eomstartstep'
  WHEN G-NATRP-ERC = 0
    IF #BUNDLE
      REPEAT
        PERFORM PROCESS-PRINT-STEP
        IF G-NATRP-ERC NE 0
          ESCAPE ROUTINE
        END-IF
        RMJBST-TEXT (#EOMSTEP-INDEX) := #EOMSTEP-A
        UNTIL #WHOLE-BUNDLE-PROCESSED OR #ALL
      END-REPEAT
    ELSE
      PERFORM PROCESS-PRINT-STEP
    END-IF
  WHEN G-NATRP-ERC = 0
    PERFORM PROCESS-AFTER-EOMENDSTEP
    LG-MSG := 'process after eomstartstep'
  WHEN G-NATRP-ERC = 0
    PERFORM CLOSE-SUBMIT
    LG-MSG := 'close submit'
  WHEN NONE
    IF #TRACING
      PRINT LG-MSG 'erc:' G-NATRP-ERC 'ert:' G-NATRP-ERT /*SU3 (AL=70)
    END-IF
    ESCAPE ROUTINE
END-DECIDE
IF #TRACING
  PRINT *PROGRAM *LINE 'Variable substitution:' /
  FOR #I = 1 TO RMJBST-ENTRIES
    PRINT NOTITLE NOHDR #I RMJBST-VAR (#I) ':=' RMJBST-TEXT(#I)
  END-FOR
END-IF
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE INIT-FUNCTION
************************************************************************
IF *DEVICE = 'COLOR' OR = 'VIDEO' OR = 'PC'
  #TRACING := TRUE
  IF *DATA = 1
    INPUT G-P-POID
  END-IF
END-IF
RESET G-NATRP-ERC
PERFORM GET-PRINT-PARMS
#JCSK-MEMBER := PO-JCL-SKELETON
CALLNAT 'RGETLIB' #JCSK-LIBRARY
COMPRESS #JCSK-LIBRARY 'U' TO #JCSK-LIBRARY LEAVING NO
IF SYSTEM-INFO-VIEW.JOBVAR = 'YES'
  #MONJV-J-ID   := ABS(G-P-POID)
  #MONJV-J-DBID := ABS(G-NATRP-DBID)
  #MONJV-J-FNR  := ABS(G-NATRP-FNR)
  COMPRESS '$' G-NPR-CURRENT-USERID '.' #MONJV-JOB
    TO #MONJV-JOB LEAVING NO
ELSE
  RESET #MONJV-JOB
END-IF
IF SYSTEM-INFO-VIEW.SYSTEM-TYPE = SCAN 'BS2'
AND SYSTEM-INFO-VIEW.JOBVAR = 'YES'                                   /*
  #FOLLOW-PRINTOUT := 'Y'
END-IF
RESET #J
ADD 1 TO #J
RMJBST-VAR (#J) := 'REPORT' RMJBST-TEXT (#J) := PRINTOUTS.PO-REPNAME
ADD 1 TO #J
RMJBST-VAR (#J) := 'BUNDLE' RMJBST-TEXT (#J) := PRINTOUTS.PO-BUNDLE
*
ADD 1 TO #J
RMJBST-VAR (#J) := 'USER'
EXAMINE PRINTOUTS.PO-ATTR-VAR(*) FOR 'USER' GIVING INDEX IN #I
IF #I NE 0
  RMJBST-TEXT (#J) := PRINTOUTS.PO-ATTR-VALUE (#I)
END-IF
IF RMJBST-TEXT (#J) = ' '
  RMJBST-TEXT (#J) := PRINTOUTS.PO-USERID
END-IF
*
RMJBST-ENTRIES := #J
PERFORM COMPRESS-WITH-ESCAPE-CHAR
*
#STRING1 := PRINTOUTS.PO-JOBCARD (1)
PERFORM SUBSTITUTE-VARIABLES
PRINTOUTS.PO-JOBCARD (1) := #STRING1
**   the first jobcard may include <userid>,<account>,<password>
**   if so, separate the ACCOUNT-NUMBER for submit
**
/*SU6 -> BS2SPC-RECORD := #STRING1
/* IF PHYSICAL-PRINTER.PH-PRINTER-TYPE = ##PHYS-BS2 CALLNAT
/* 'BS2SPC-N' BS2SPC-RECORD BS2SPC-PARAMS BS2SPC-PARAMS-FOUND BS2SPC-ERC
/*SU6 <- BS2SPC-ERT #ACCOUNT-NUMBER := BS2SPC-ACCOUNT-NUMBER END-IF
*
#STRING1 := PRINTOUTS.PO-JOBCARD (2)
PERFORM SUBSTITUTE-VARIABLES
PRINTOUTS.PO-JOBCARD (2) := #STRING1
*
#STRING1 := PRINTOUTS.PO-JOBCARD (3)
PERFORM SUBSTITUTE-VARIABLES
PRINTOUTS.PO-JOBCARD (3) := #STRING1
*
ADD 1 TO #J
RMJBST-VAR (#J) :='JOBCARD01' RMJBST-TEXT (#J) :=PRINTOUTS.PO-JOBCARD(1)
ADD 1 TO #J
RMJBST-VAR (#J) :='JOBCARD02' RMJBST-TEXT (#J) :=PRINTOUTS.PO-JOBCARD(2)
ADD 1 TO #J
RMJBST-VAR (#J) :='JOBCARD03' RMJBST-TEXT (#J) :=PRINTOUTS.PO-JOBCARD(3)
*
FOR #I 1 25
  IF PO-ATTR-VAR (#I) NE ' '
    ADD 1 TO #J
    RMJBST-VAR  (#J) := PRINTOUTS.PO-ATTR-VAR   (#I)
    RMJBST-TEXT (#J) := PRINTOUTS.PO-ATTR-VALUE (#I)
  END-IF
END-FOR
*
ADD 1 TO #J
RMJBST-VAR (#J) := 'COPIES'
/*SU6 -> IF PHYSICAL-PRINTER.PH-PRINTER-TYPE = ##PHYS-BS2
/*  IF PRINTOUTS.PO-COPIES > 0 #COPIES := PRINTOUTS.PO-COPIES - 1
/*SU6 <-  RMJBST-TEXT (#J) := #COPIES END-IF ELSE
RMJBST-TEXT (#J) := PRINTOUTS.PO-COPIES
/*SU6 END-IF
*
ADD 1 TO #J
RMJBST-VAR  (#J) := 'PRIORITY' RMJBST-TEXT (#J) := PRINTOUTS.PO-PRIORITY
ADD 1 TO #J
RMJBST-VAR  (#J) := 'EOMSTEP'  RMJBST-TEXT (#J) := #EOMSTEP-A
RMJBST-ENTRIES := #EOMSTEP-INDEX := #J
*
PERFORM CHECK-FOR-PRINT-ALL
*
IF #BUNDLE AND NOT #ALL
  PERFORM GET-OUTJOB-PARMS
  IF #BUNDLE-EMPTY
    ESCAPE ROUTINE
  END-IF
END-IF
*
PERFORM SET-ADDITIONAL-VARIABLES
PERFORM COMPRESS-WITH-ESCAPE-CHAR
IF +G-NOMEXIT-ACTIVE (5)
  NOMEX005-LOGICAL-PRINTER := PO-LOGICAL
  NOMEX005-ENTRIES         := RMJBST-ENTRIES
  NOMEX005-VAR (*)         := RMJBST-VAR (1:40)
  NOMEX005-VALUE (*)       := RMJBST-TEXT (1:40)
  /*  This exit is called by NOM to allow modification
  /*  of print job substitution variables:
  CALLNAT 'NOMEX005' NOMEX005-PARMS (*)
  RMJBST-TEXT (1:40) := NOMEX005-VALUE (*)
END-IF
SET CONTROL 'Z'                /* clear source area
*
END-SUBROUTINE /* INIT-FUNCTION
*
************************************************************************
DEFINE SUBROUTINE CHECK-FOR-PRINT-ALL
************************************************************************
IF PHYSICAL-PRINTER.PH-PRINTER-TYPE = ##PHYS-DISK-MVS OR=##PHYS-TAPE-MVS
/*SU6 OR=##PHYS-BS2 OR=##PHYS-TAPE-VSE             /*
  #ALL := TRUE
END-IF
*
END-SUBROUTINE /* CHECK-FOR-PRINT-ALL
*
************************************************************************
DEFINE SUBROUTINE SET-ADDITIONAL-VARIABLES
************************************************************************
DECIDE ON FIRST VALUE PHYSICAL-PRINTER.PH-PRINTER-TYPE
  VALUE ##PHYS-DISK-MVS
    PERFORM ADDITIONAL-ATTR-DISKMVS
/*SU6  VALUE ##PHYS-BS2 PERFORM ADDITIONAL-ATTR-BS2000
  NONE IGNORE
END-DECIDE
DECIDE ON FIRST VALUE PHYSICAL-PRINTER.PH-PRINTER-TYPE
  VALUE ##PHYS-DISK-MVS, ##PHYS-TAPE-MVS /*SU6 , ##PHYS-TAPE-VSE
    PERFORM SET-EXTRA-DSN-VARIABLES
  NONE IGNORE
END-DECIDE
*
END-SUBROUTINE /* SET-ADDITIONAL-VARIABLES
*
/*SU6 DEFINE SUBROUTINE ADDITIONAL-ATTR-BS2000
*
************************************************************************
DEFINE SUBROUTINE ADDITIONAL-ATTR-DISKMVS
************************************************************************
EXAMINE RMJBST-VAR (*) FOR 'DSNAME' GIVING INDEX #INDEX-DSNAME
ADD 1 TO RMJBST-ENTRIES
RMJBST-VAR (RMJBST-ENTRIES) := 'FULLDSNAME'
RMJBST-TEXT (RMJBST-ENTRIES) := RMJBST-TEXT (#INDEX-DSNAME)
*
EXAMINE RMJBST-VAR (*) FOR 'MEMBER' GIVING INDEX #INDEX-MEMBER
IF RMJBST-TEXT (#INDEX-MEMBER) NE ' '
  COMPRESS RMJBST-TEXT (#INDEX-DSNAME) '(' RMJBST-TEXT (#INDEX-MEMBER)
    ')' TO RMJBST-TEXT (RMJBST-ENTRIES) LEAVING NO
END-IF
EXAMINE RMJBST-VAR (*) FOR 'DISP' GIVING INDEX #INDEX-DISP
*
IF RMJBST-TEXT (#INDEX-DISP) = 'DEL'
  RMJBST-TEXT (#INDEX-DISP) := 'OLD'
END-IF
IF RMJBST-TEXT (#INDEX-DISP) = 'NEW'
  RMJBST-TEXT (#INDEX-DISP) := '(NEW,CATLG)'
END-IF
*
IF RMJBST-TEXT (#INDEX-DISP) = MASK ('(NEW') OR = MASK ('(,')
  IF RMJBST-TEXT (#INDEX-MEMBER) = ' '
    MOVE EDITED *TIMX (EM='.D'YYMMDD'.T'HHIISST) TO #DATETIME
    COMPRESS RMJBST-TEXT (#INDEX-DSNAME) #DATETIME
      TO RMJBST-TEXT (RMJBST-ENTRIES) LEAVING NO
  END-IF
  PERFORM GET-BLKSIZE
  EXAMINE RMJBST-VAR (*) FOR 'SPACE' GIVING INDEX #T
  IF RMJBST-TEXT (#T) = ' '
    IF #BUNDLE
      #PRINTOUT-TYPE := 'B'
      #NAME := PRINTOUTS.PO-BUNDLE
      #RNB  := PRINTOUTS.PO-BUNDRNB
    ELSE
      #PRINTOUT-TYPE := 'R'
      #NAME := PRINTOUTS.PO-REPNAME
      #RNB  := PRINTOUTS.PO-REPRNB
    END-IF
    /* Get SPACE for print data set:
    CALLNAT 'RMGETSZN' RMGETSZN-PARMS
    IF RMJBST-TEXT (#INDEX-MEMBER) = ' '
      EXAMINE #SPACE FOR '§DIR' DELETE
    ELSE
      EXAMINE #SPACE FOR '§DIR' REPLACE ',20'
    END-IF
    RMJBST-TEXT (#T) := #SPACE
  END-IF
END-IF
*
END-SUBROUTINE /* ADDITIONAL-ATTR-DISKMVS
*
************************************************************************
DEFINE SUBROUTINE GET-BLKSIZE
************************************************************************
EXAMINE RMJBST-VAR (*) FOR 'DCB'   GIVING INDEX #T
SATKY-KEYWORD         := 'BLKSIZE'
FOR #I 1 2
  #J := #T + #I - 1
  SATKY-LINE            := RMJBST-TEXT (#J)
  REPEAT UNTIL SATKY-EOL
  CALLNAT SAT-GET-KEY-VALUE /* Get value from line for specified keyword
      SATKY-SATVERS SATKY-PARMS (*)
    IF SATKY-KEYWORD = SCAN 'BLKSIZE'
      IF SATKY-VALUE NE ' '
        EXAMINE SATKY-VALUE ')' DELETE
        #BLKSIZE := VAL (SATKY-VALUE)
        IF #BLKSIZE NE 0
          ESCAPE BOTTOM
        END-IF
      END-IF
    END-IF
  END-REPEAT
END-FOR
IF #BLKSIZE = 0
  #BLKSIZE := 6000
END-IF
*
END-SUBROUTINE /* GET-BLKSIZE
*
************************************************************************
DEFINE SUBROUTINE COMPRESS-WITH-ESCAPE-CHAR
************************************************************************
FOR #I 1 RMJBST-ENTRIES
  IF RMJBST-VAR (#I) = MASK (X) PO-ESCAPE-CHAR
    ESCAPE TOP
  END-IF
  IF RMJBST-VAR (#I) NE ' '
    COMPRESS PO-ESCAPE-CHAR RMJBST-VAR (#I) TO RMJBST-VAR (#I)
      LEAVING NO
  END-IF
END-FOR
*
END-SUBROUTINE /* COMPRESS-WITH-ESCAPE-CHAR
*
************************************************************************
DEFINE SUBROUTINE PROCESS-UNTIL-EOMSTARTSTEP
************************************************************************
RESET #JCSK-LINE-NUMBER #JCSK-START  /* start at beginning each time
COMPRESS PO-ESCAPE-CHAR 'EOMSTARTSTEP' TO #JCSK-END LEAVING NO
PERFORM GET-CARDS
*
END-SUBROUTINE /* PROCESS-UNTIL-EOMSTARTSTEP
*
************************************************************************
DEFINE SUBROUTINE PROCESS-PRINT-STEP
************************************************************************
RESET #JCSK-LINE-NUMBER /* start at beginning each time
* following is required because the class on the printout is
* overwritten by the class on the printer by RMPRJOBN (called in
* GET-OUTJOB-PARMS).
EXAMINE RMJBST-VAR(*) FOR 'CLASS' GIVING INDEX IN I
IF I GT 0
  IF RMJBST-TEXT(I) = ' '
    RMJBST-TEXT(I):= G-PRINT-CLASS
  END-IF
END-IF
COMPRESS PO-ESCAPE-CHAR 'EOMSTARTSTEP' TO #JCSK-START LEAVING NO
COMPRESS PO-ESCAPE-CHAR 'EOMENDSTEP'   TO #JCSK-END   LEAVING NO
PERFORM GET-CARDS
*
END-SUBROUTINE /* PROCESS-PRINT-STEP
*
************************************************************************
DEFINE SUBROUTINE PROCESS-AFTER-EOMENDSTEP
************************************************************************
RESET #JCSK-LINE-NUMBER /* start at beginning each time
COMPRESS PO-ESCAPE-CHAR 'EOMENDSTEP' TO #JCSK-START LEAVING NO
RESET  #JCSK-END
PERFORM GET-CARDS
*
END-SUBROUTINE /* PROCESS-AFTER-EOMENDSTEP
*
************************************************************************
DEFINE SUBROUTINE GET-CARDS
************************************************************************
/*  Check if Source Module exist:
CALLNAT 'N-CHKSRC' #JCSK-LIBRARY #JCSK-MEMBER #EXIST
IF NOT #EXIST
  WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
    'Print failed - JCL Skeleton' #JCSK-MEMBER 'not found.'
  COMPRESS '0716' '0117' TO LG-MSG /* Error submitting print job.
  COMPRESS 'ID =' G-P-POID TO LG-OBJECT-NAME
  PERFORM WRITE-LOG-RECORD
  LG-MSG := '0117'                 /* skeleton does not exist
  PERFORM WRITE-LOG-RECORD
  G-NATRP-ERC := 117               /* skeleton does not exist
  RESET  G-NATRP-ERT
  ESCAPE ROUTINE
END-IF
*
RESET #JCSK-EOF
REPEAT
  CALLNAT 'RMJBSK-N' #JCSK-PARMS  /* Process JCL Skeleton
  IF #JCSK-EOF
    ESCAPE BOTTOM
  END-IF
  #STRING1 := #JCSK-CARD
  PERFORM PROCESS-LINE
END-REPEAT
*
END-SUBROUTINE /* GET-CARDS
*
************************************************************************
DEFINE SUBROUTINE GET-OUTJOB-PARMS
************************************************************************
#BC-BUNDLE    := PRINTOUTS.PO-BUNDLE
#BC-BUNDRNB   := PRINTOUTS.PO-BUNDRNB
#BC-GROUP     := #SAVE-BC-GROUP
#BC-SEQNO     := #SAVE-BC-SEQNO
#BUNDLE-EMPTY := TRUE
BC2. READ BUNDLE-CONTENTS BY BC-BUNDLE-RNB-GROUP-SEQNO-REPRNB =#BC-SUPER
  IF NOT (BC-BUNDLE = #BC-BUNDLE AND BC-BUNDRNB = #BC-BUNDRNB)
    ESCAPE BOTTOM
  END-IF
  #AR-REPNAME:= BC-REPNAME
  #AR-REPRNB := BC-REPRNB
  FIND (1) ACTIVE-REPORTS WITH AR-REPORT-RNB = #AR-REPORT-RNB
    IF AR-NUMBER-OF-LINES NE 0
      #BUNDLE-EMPTY:= FALSE
      PERFORM GET-CURRENT-CHARACTERISTICS
      PERFORM SET-PRINTER-CHARACTERISTICS
      ESCAPE BOTTOM(BC2.)
    END-IF
  END-FIND
END-READ
IF #BUNDLE-EMPTY
  G-NATRP-ERC := 707
  RESET  G-NATRP-ERT
END-IF
*
END-SUBROUTINE /* GET-OUTJOB-PARMS
*
************************************************************************
DEFINE SUBROUTINE PROCESS-BUNDLE-CONTENTS
************************************************************************
#BC-BUNDLE  := PRINTOUTS.PO-BUNDLE
#BC-BUNDRNB := PRINTOUTS.PO-BUNDRNB
#BC-GROUP   := #SAVE-BC-GROUP
#BC-SEQNO   := #SAVE-BC-SEQNO
IF #FIRST
  #ACCEPT := TRUE
  PERFORM READ-ACTIVE-BUNDLE
ELSE
  #ACCEPT := FALSE
END-IF
RESET #COUNTER
CALLNAT 'RGETLIB' NAT00053-LIBRARY
+G-L9-EXISTS:= TRUE
CALLNAT 'NAT00053' NAT00053-PARMS
IF NAT00053-RSP = 0
  CALLNAT 'RMBUNSEQ' #BC-BUNDLE (AD=O) #BC-BUNDRNB (AD=O) +G-L9-EXISTS
END-IF
IF +G-L9-EXISTS
  PERFORM READ-BUNDLE-CONTENTS-NEW
ELSE
  PERFORM READ-BUNDLE-CONTENTS-OLD
END-IF
IF #COUNTER = 0
  #WHOLE-BUNDLE-PROCESSED := TRUE
END-IF
*
END-SUBROUTINE /* PROCESS-BUNDLE-CONTENTS
*
************************************************************************
DEFINE SUBROUTINE READ-BUNDLE-CONTENTS-NEW
************************************************************************
READ BUNDLE-CONTENTS BY BC-BUNDLE-RNB-GROUP-SEQNO-REPRNB = #BC-SUPER
  AT END DATA
    IF NOT #NEW-CHARACTERISTICS
      #WHOLE-BUNDLE-PROCESSED := TRUE
    END-IF
    #END-OF-DATA := TRUE
    PERFORM SUBMIT-BC-LINE
  END-ENDDATA
  IF BC-REPNAME = #SAVE-BC-REPNAME AND BC-REPRNB = #SAVE-BC-REPRNB
    #ACCEPT := TRUE
    ESCAPE TOP
  END-IF
  ACCEPT IF #ACCEPT
  IF BC-BUNDLE NE #BC-BUNDLE OR BC-BUNDRNB NE #BC-BUNDRNB
    #WHOLE-BUNDLE-PROCESSED := TRUE
    ESCAPE BOTTOM
  END-IF
  IF NOT #ALL
    PERFORM GET-CURRENT-CHARACTERISTICS
    IF #NEW-CHARACTERISTICS
      ADD 1 TO #EOMSTEP
      COMPRESS 'OUT' #EOMSTEP-A TO #OUTPUT-REFERENCE LEAVING NO
      PERFORM SET-PRINTER-CHARACTERISTICS
      ESCAPE BOTTOM
    END-IF
  END-IF
  ADD 1 TO #COUNTER
  PERFORM SUBMIT-BC-LINE
  #SAVE-BC-GROUP          := BC-GROUP
  #SAVE-BC-SEQNO          := BC-SEQNO
  #SAVE-BC-REPNAME := BC-REPNAME
  #SAVE-BC-REPRNB         := BC-REPRNB
END-READ
*
END-SUBROUTINE /* READ-BUNDLE-CONTENTS-NEW
*
************************************************************************
DEFINE SUBROUTINE READ-BUNDLE-CONTENTS-OLD
************************************************************************
READ BUNDLE-CONTENTS BY BC-BUNDLE-RNB-GROUP-SEQNO = #BC-SUPER
  AT END DATA
    IF NOT #NEW-CHARACTERISTICS
      #WHOLE-BUNDLE-PROCESSED := TRUE
    END-IF
    #END-OF-DATA := TRUE
    PERFORM SUBMIT-BC-LINE
  END-ENDDATA
  IF BC-REPNAME = #SAVE-BC-REPNAME AND BC-REPRNB = #SAVE-BC-REPRNB
    #ACCEPT := TRUE
    ESCAPE TOP
  END-IF
  ACCEPT IF #ACCEPT
  IF BC-BUNDLE NE #BC-BUNDLE OR BC-BUNDRNB NE #BC-BUNDRNB
    #WHOLE-BUNDLE-PROCESSED := TRUE
    ESCAPE BOTTOM
  END-IF
  IF NOT #ALL
    PERFORM GET-CURRENT-CHARACTERISTICS
    IF #NEW-CHARACTERISTICS
      ADD 1 TO #EOMSTEP
      COMPRESS 'OUT' #EOMSTEP-A TO #OUTPUT-REFERENCE LEAVING NO
      PERFORM SET-PRINTER-CHARACTERISTICS
      ESCAPE BOTTOM
    END-IF
  END-IF
  ADD 1 TO #COUNTER
  PERFORM SUBMIT-BC-LINE
  #SAVE-BC-GROUP   := BC-GROUP
  #SAVE-BC-SEQNO   := BC-SEQNO
  #SAVE-BC-REPNAME := BC-REPNAME
  #SAVE-BC-REPRNB  := BC-REPRNB
END-READ
*
END-SUBROUTINE /* READ-BUNDLE-CONTENTS-OLD
*
************************************************************************
DEFINE SUBROUTINE READ-ACTIVE-BUNDLE
************************************************************************
#AB-BUNDLE  := PO-BUNDLE
#AB-BUNDRNB := PO-BUNDRNB
FIND ACTIVE-BUNDLE WITH AB-BUNDLE-RNB = #AB-BUNDLE-RNB
END-FIND
*
END-SUBROUTINE /* READ-ACTIVE-BUNDLE
*
************************************************************************
DEFINE SUBROUTINE GET-CURRENT-CHARACTERISTICS
************************************************************************
#NEW-CHARACTERISTICS := FALSE
#CURRENT-CHARACTERISTICS.#PRINTER := BUNDLE-CONTENTS.BC-PRINTER
#CURRENT-CHARACTERISTICS.#FORMS   := BUNDLE-CONTENTS.BC-FORM
#CURRENT-CHARACTERISTICS.#FCB     := BUNDLE-CONTENTS.BC-FCB
#CURRENT-CHARACTERISTICS.#CHARS   := BUNDLE-CONTENTS.BC-CHARS
#CURRENT-CHARACTERISTICS.#FLASH   := BUNDLE-CONTENTS.BC-FLASH
#CURRENT-CHARACTERISTICS.#PAGEDEF := BUNDLE-CONTENTS.BC-PAGEDEF
#CURRENT-CHARACTERISTICS.#FORMDEF := BUNDLE-CONTENTS.BC-FORMDEF
IF #CURRENT-CHARACTERISTICS (*) = #PREVIOUS-CHARACTERISTICS (*)
OR (#FIRST AND NOT (#PREVIOUS-CHARACTERISTICS (*) NE ' '))            /*
  #NEW-CHARACTERISTICS := FALSE
ELSE
  #NEW-CHARACTERISTICS := TRUE
END-IF
#PREVIOUS-CHARACTERISTICS (*) := #CURRENT-CHARACTERISTICS (*)
*
END-SUBROUTINE /* GET-CURRENT-CHARACTERISTICS
*
************************************************************************
DEFINE SUBROUTINE SET-PRINTER-CHARACTERISTICS
************************************************************************
IF BC-PRINTER = ' ' /* Get printer attr. + replace current settings:
  CALLNAT 'RMPRJOBN' RMJBST-PARMS PO-LOGICAL
    #CURRENT-CHARACTERISTICS (1:#C) G-NATRP-ERC G-NATRP-ERT
  PERFORM REPLACE-SUBSTITUTION-VALUES
ELSE /* Get printer attr. and replace current settings:
  CALLNAT 'RMPRJOBN' RMJBST-PARMS BC-PRINTER
    #CURRENT-CHARACTERISTICS (1:#C) G-NATRP-ERC G-NATRP-ERT
END-IF
*
END-SUBROUTINE /* SET-PRINTER-CHARACTERISTICS
*
************************************************************************
DEFINE SUBROUTINE REPLACE-SUBSTITUTION-VALUES
************************************************************************
DECIDE FOR EVERY CONDITION
  WHEN #CURRENT-CHARACTERISTICS.#FORMS NE ' '
    EXAMINE RMJBST-VAR (*) FOR 'FORMS' GIVING INDEX #T
    IF #T NE 0
      RMJBST-TEXT (#T) := #CURRENT-CHARACTERISTICS.#FORMS
    END-IF
  WHEN #CURRENT-CHARACTERISTICS.#FCB NE ' '
    EXAMINE RMJBST-VAR (*) FOR 'FCB' GIVING INDEX #T
    IF #T NE 0
      RMJBST-TEXT (#T) := #CURRENT-CHARACTERISTICS.#FCB
    END-IF
  WHEN #CURRENT-CHARACTERISTICS.#CHARS NE ' '
    EXAMINE RMJBST-VAR (*) FOR 'CHARS' GIVING INDEX #T
    IF #T NE 0
      #CHARS-IN := #CURRENT-CHARACTERISTICS.#CHARS
      CALLNAT 'RMCHARSN' #CHARS-IN #CHARS-OUT
      RMJBST-TEXT (#T) := #CHARS-OUT
    END-IF
  WHEN #CURRENT-CHARACTERISTICS.#FLASH NE ' '
    EXAMINE RMJBST-VAR (*) FOR 'FLASH' GIVING INDEX #T
    IF #T NE 0
      RMJBST-TEXT (#T) := #CURRENT-CHARACTERISTICS.#FLASH
    END-IF
  WHEN #CURRENT-CHARACTERISTICS.#PAGEDEF NE ' '
    EXAMINE RMJBST-VAR (*) FOR 'PAGEDEF' GIVING INDEX #T
    IF #T NE 0
      RMJBST-TEXT (#T) := #CURRENT-CHARACTERISTICS.#PAGEDEF
    END-IF
  WHEN #CURRENT-CHARACTERISTICS.#FORMDEF NE ' '
    EXAMINE RMJBST-VAR (*) FOR 'FORMDEF' GIVING INDEX #T
    IF #T NE 0
      RMJBST-TEXT (#T) := #CURRENT-CHARACTERISTICS.#FORMDEF
    END-IF
  WHEN NONE IGNORE
END-DECIDE
*
END-SUBROUTINE /* REPLACE-SUBSTITUTION-VALUES
*
************************************************************************
DEFINE SUBROUTINE SUBMIT-BC-LINE
************************************************************************
DECIDE FOR EVERY CONDITION
  WHEN #WHOLE-BUNDLE-PROCESSED
    IF (ACTIVE-BUNDLE.AB-SEPNO > 0 AND ACTIVE-BUNDLE.AB-SEPMEM = ' ')
    OR (ACTIVE-BUNDLE.AB-SEPMEM > ' ' AND ACTIVE-BUNDLE.AB-SEPNO > 0  /*
    AND NOT (ACTIVE-BUNDLE.AB-SEP-END = 'NONE' OR = 'KEIN'))          /*
      #STRING1 := 'BS TYPE=END'
      PERFORM SUBMIT-LINE
    END-IF
    #STRING1 := 'EP'
    PERFORM SUBMIT-LINE
    #STRING1 := '.'
    PERFORM SUBMIT-LINE
    ESCAPE ROUTINE
  WHEN #END-OF-DATA
    RESET #END-OF-DATA
    #STRING1 := '.'
    PERFORM SUBMIT-LINE
    ESCAPE ROUTINE
  WHEN #COUNTER = 1
    #STRING1 := 'RMPRBU'
    PERFORM SUBMIT-LINE
    COMPRESS G-P-POID G-NPR-USERID #FOLLOW-PRINTOUT #NOMEXIT-6
      'PORTION' 'BATCH' #NSC-ACTIVE TO #STRING1
    PERFORM SUBMIT-LINE
  WHEN #FIRST
    RESET  #FIRST
    IF (ACTIVE-BUNDLE.AB-SEPNO > 0 AND ACTIVE-BUNDLE.AB-SEPMEM = ' ')
    OR (ACTIVE-BUNDLE.AB-SEPMEM > ' ' AND ACTIVE-BUNDLE.AB-SEPNO > 0  /*
    AND NOT(ACTIVE-BUNDLE.AB-SEP-START = 'NONE' OR = 'KEIN'))         /*
      #STRING1 := 'BS TYPE=START'
      PERFORM SUBMIT-LINE
    END-IF
    #STRING1 := 'BV'
    PERFORM SUBMIT-LINE
  WHEN NONE
    IGNORE
END-DECIDE
*
COMPRESS 'RP NAME=' BC-REPNAME TO #STRING1 LEAVING NO
COMPRESS #STRING1 'RNB=' TO #STRING1
COMPRESS #STRING1 BC-REPRNB TO #STRING1 LEAVING NO
COMPRESS #STRING1 'CP=' TO #STRING1
COMPRESS #STRING1 BC-REPNO TO #STRING1 LEAVING NO
PERFORM SUBMIT-LINE
COMPRESS 'SSEP=' BC-STARTSEP TO #STRING1 LEAVING NO
COMPRESS #STRING1 'ESEP=' TO #STRING1
COMPRESS #STRING1 BC-ENDSEP TO #STRING1 LEAVING NO
COMPRESS #STRING1 'SCP=' TO #STRING1
COMPRESS #STRING1 BC-SEPNO TO #STRING1 LEAVING NO
PERFORM SUBMIT-LINE
*
END-SUBROUTINE /* SUBMIT-BC-LINE
*
************************************************************************
DEFINE SUBROUTINE GET-PRINT-PARMS
************************************************************************
FIND (1) PRINTOUTS WITH PO-ID = G-P-POID
  #PRINTER-NODE := PO-NODE
  #PO-ISN       := *ISN
  IF PO-BUNDLE NE ' '
    #BUNDLE     := TRUE
    #AB-BUNDLE  := PO-BUNDLE
    #AB-BUNDRNB := PO-BUNDRNB
  END-IF
  FIND (1) PHYSICAL-PRINTER WITH PH-VTAMID = PO-PHYSICAL-NAME
  END-FIND
END-FIND
*
G-MONITOR-NODE := +NOD-LOCAL-NODE
IF #PRINTER-NODE = 0
  #PRINTER-NODE := +NOD-LOCAL-NODE
END-IF
#MONIT-ID := F#MONITOR-TASK-ID1 (<>)
FIND (1) MONITOR WITH M-MONITOR-ID = #MONIT-ID
  G-DATE-FORMAT  := M-DATE-FORMAT
  IF NOT PRINTOUTS.PO-JOBCARD (*) NE ' '
    PRINTOUTS.PO-JOBCARD (*) := M-JOBCARD (*)
  END-IF
END-FIND
*
END-SUBROUTINE
*
************************************************************************
DEFINE SUBROUTINE PROCESS-LINE
************************************************************************
IF #TRACING AND #STRING1 NE SCAN ('/ REMARK')
  PRINT *PROGRAM *LINE 'Skeleton Line:' #STRING1
END-IF
DECIDE FOR FIRST CONDITION
  WHEN #STRING1 = MASK (.'EOMSTARTSTEP')    IGNORE
  WHEN #STRING1 = MASK (.'EOMENDSTEP')      IGNORE
  WHEN #STRING1 = MASK (.'EOMNATCARDS')     PERFORM PROCESS-NAT-CARDS
  WHEN #STRING1 = MASK (.'EOMNATPARMS')     PERFORM PROCESS-BPRINTD-CARD
  WHEN #STRING1 = MASK (.'EOMOUTPUT')       PERFORM PROCESS-EOMOUTPUT
  WHEN #STRING1 = MASK (.'EOMSTARTOUTJOB')  SUPPRESS-NULL-SUBST := TRUE
  WHEN #STRING1 = MASK (.'EOMSTARTOUTSTEP') SUPPRESS-NULL-SUBST := TRUE
  WHEN #STRING1 = MASK (.'EOMSTARTLST')     SUPPRESS-NULL-SUBST := TRUE
  WHEN #STRING1 = MASK (.'EOMSTARTWKF')     SUPPRESS-NULL-SUBST := TRUE
  WHEN #STRING1 = MASK (.'EOMENDOUTJOB')    SUPPRESS-NULL-SUBST := FALSE
  WHEN #STRING1 = MASK (.'EOMENDOUTSTEP')   SUPPRESS-NULL-SUBST := FALSE
  WHEN #STRING1 = MASK (.'EOMENDLST')       SUPPRESS-NULL-SUBST := FALSE
  WHEN #STRING1 = MASK (.'EOMENDWKF')       SUPPRESS-NULL-SUBST := FALSE
  WHEN #STRING1 = MASK (.'EOMSTARTEDT')     IN-EXEC-EDT := TRUE
  WHEN #STRING1 = MASK (.'EOMENDEDT')       IN-EXEC-EDT := FALSE
  WHEN #STRING1 = MASK (.'EOMPRINTDOC')     PERFORM PROCESS-PRINT-DOC
  WHEN NONE PERFORM SUBMIT-LINE
END-DECIDE
*
END-SUBROUTINE /* PROCESS-LINE
*
************************************************************************
DEFINE SUBROUTINE PROCESS-PRINT-DOC
************************************************************************
/* Dieses Programm erzeugt ein Print-Doc - Kommando aus den
/* übergebenen Spool-Attributen:
CALLNAT 'RMPDOC-N' RMPDOC-SPOOL-ATTRIBUTES
  RMPDOC-SPOOL-ATTRIBUTES-EXT
  RMPDOC-CMD (*) RMPDOC-CMD-OCC RMPDOC-ERROR-CODE RMPDOC-ERROR-TEXT
  RMJBST-ENTRIES RMJBST-VAR (*) RMJBST-TEXT (*)
FOR #I 1 RMPDOC-CMD-OCC
  #STRING1 := RMPDOC-CMD-LINE (#I)
  PERFORM SUBMIT-LINE
END-FOR
*
END-SUBROUTINE /* PROCESS-PRINT-DOC
*
************************************************************************
DEFINE SUBROUTINE PROCESS-NAT-CARDS
************************************************************************
CALLNAT 'RGETLIB' #LIBRARY-ID
IF G-NSC-ACTIVE
  COMPRESS #LIBRARY-ID G-NSC-USERID G-NSC-PASSWORD TO #STRING1
ELSE
  COMPRESS 'LOGON' #LIBRARY-ID TO #STRING1
END-IF
PERFORM SUBMIT-LINE
IF NOT G-NSC-ACTIVE
  #STRING1 :=  'NOMGSTPP'
  PERFORM SUBMIT-LINE
END-IF
COMPRESS 'SETNRMLF' G-NATRP-DBID G-NATRP-FNR TO #STRING1
PERFORM SUBMIT-LINE
IF #TRACING
  #STRING1 := 'TECH'
  PERFORM SUBMIT-LINE
  #STRING1 := 'SYSPROF'
  PERFORM SUBMIT-LINE
END-IF
IF +G-NOMEXIT-ACTIVE (6)
  #NOMEXIT-6 := 'Y'
ELSE
  #NOMEXIT-6 := 'N'
END-IF
IF G-NSC-ACTIVE
  #NSC-ACTIVE := 'Y'
END-IF
IF #BUNDLE
  IF #ALL
    COMPRESS 'RMPRBU' G-P-POID G-NPR-USERID #FOLLOW-PRINTOUT #NOMEXIT-6
      'ALL' 'BATCH' #NSC-ACTIVE TO #STRING1
  ELSE
    PERFORM PROCESS-BUNDLE-CONTENTS
    ESCAPE ROUTINE
  END-IF
ELSE
  COMPRESS 'RMPRRP' G-P-POID G-NPR-USERID #FOLLOW-PRINTOUT #NOMEXIT-6
    'BATCH' #NSC-ACTIVE TO #STRING1
END-IF
PERFORM SUBMIT-LINE
*
END-SUBROUTINE /* PROCESS-NAT-CARDS
*
************************************************************************
DEFINE SUBROUTINE PROCESS-BPRINTD-CARD
************************************************************************
PERFORM GET-REPORT-LINE-SIZE
COMPRESS 'BPRINTD=(1,1,' #LINE-SIZE ')' TO #STRING1 LEAVING NO
PERFORM SUBMIT-LINE
*
END-SUBROUTINE /* PROCESS-BPRINTD-CARD
*
************************************************************************
DEFINE SUBROUTINE PROCESS-EOMOUTPUT
************************************************************************
COMPRESS '// OUTPUT=*.' #OUTPUT-REFERENCE TO #STRING1 LEAVING NO
PERFORM SUBMIT-LINE
*
END-SUBROUTINE /* PROCESS-EOMOUTPUT
*
************************************************************************
DEFINE SUBROUTINE GET-REPORT-LINE-SIZE
************************************************************************
RESET #LINE-SIZE
#AR-REPNAME := PRINTOUTS.PO-REPNAME
#AR-REPRNB  := PRINTOUTS.PO-REPRNB
FIND (1) ACTIVE-REPORTS WITH AR-REPORT-RNB = #AR-REPORT-RNB
  FIND (1) SOURCE WITH SR-ID = AR-SOURCE-ID
    #LINE-SIZE := SR-RECORD-LENGTH
  END-FIND
END-FIND
IF #LINE-SIZE = 0
  #LINE-SIZE := 250
END-IF
FIND (1) REPORT-DEF WITH R-REPNAME = PRINTOUTS.PO-REPNAME
  #AR-SEPMEM := AR-SEPMEM
  IF REPORT-DEF.R-SEPLENG > #LINE-SIZE
    #LINE-SIZE := REPORT-DEF.R-SEPLENG
  END-IF
  IF REPORT-DEF.R-SEPLENG = 0 AND #LINE-SIZE < 133 AND  AR-SEPNO NE 0
  AND NOT(AR-SEP-START='NONE' OR='KEIN' AND AR-SEP-END='NONE' OR='KEIN')
    #LINE-SIZE := 133
  END-IF
END-FIND
*
END-SUBROUTINE /* GET-REPORT-LINE-SIZE
*
************************************************************************
DEFINE SUBROUTINE SUBSTITUTE-VARIABLES
************************************************************************
RMJBST-CARD := #STRING1
/*  Substitute Variables in a Job skeleton:
CALLNAT 'RMJBST-N' RMJBST-PARMS RMJBST-CARD
#STRING1 := RMJBST-CARD
*
END-SUBROUTINE /* SUBSTITUTE-VARIABLES
*
************************************************************************
DEFINE SUBROUTINE SUBMIT-LINE
************************************************************************
PERFORM SUBSTITUTE-VARIABLES
IF #TRACING AND #STRING1 NE SCAN ('/ REMARK')
  PRINT *PROGRAM *LINE 'After Substit:' #STRING1
END-IF
IF (SUPPRESS-NULL-SUBST AND RMJBST-NULL-SUBSTITUTION) OR #STRING1 = ' '
  ESCAPE ROUTINE
END-IF
IF IN-EXEC-EDT AND #STRING1 = MASK ('/')
  COMPRESS '§+:' #STRING1 TO #STRING1 LEAVING NO
END-IF
IF #TRACING AND #STRING1 NE SCAN ('/ REMARK')
  PRINT *PROGRAM *LINE 'To be submted:' #STRING1
END-IF
FIND (1) SUBMIT WITH NODE = #PRINTER-NODE AND CARD = #STRING1
AND ACCOUNT-NUMBER =#ACCOUNT-NUMBER AND MONITOR-JOB-VARIABLE =#MONJV-JOB
  IF SUBMIT.ERROR-CODE > 0
    G-NATRP-ERC := SUBMIT.ERROR-CODE
    G-NATRP-ERT := SUBMIT.ERROR-TEXT
    COMPRESS '0716' G-NATRP-ERT SYSTEM-MESSAGE-CODE
      TO LG-MSG /* Error submitting print job.
    COMPRESS 'ID =' G-P-POID TO LG-OBJECT-NAME
    PERFORM WRITE-LOG-RECORD
    G-NATRP-ERC := 5
  END-IF
END-FIND
*
END-SUBROUTINE /* SUBMIT-LINE
*
************************************************************************
DEFINE SUBROUTINE CLOSE-SUBMIT
************************************************************************
IF #TRACING
  PRINT NOTITLE *PROGRAM 'Close Submit. ACCOUNT =' #ACCOUNT-NUMBER
END-IF
FIND (1) SUBMIT WITH NODE = #PRINTER-NODE AND FUNCTION = 'CLOSE'
  IF SUBMIT.ERROR-CODE NE 0 OR (JOB-NUMBER = 0 AND JOB-ID = ' ')
    G-NATRP-ERC := SUBMIT.ERROR-CODE
    G-NATRP-ERT := SUBMIT.ERROR-TEXT
/*SU6  IF PHYSICAL-PRINTER.PH-PRINTER-TYPE = ##PHYS-BS2
/*SU6 COMPRESS G-NATRP-ERC '/' SYSTEM-MESSAGE-CODE TO LG-MSG LEAVING NO
/*SU6 COMPRESS '0716' LG-MSG TO LG-MSG /* Error submitting print job.
/*SU6    ELSE
    IF G-NATRP-ERC = 0
      G-NATRP-ERC := 721
      RESET  G-NATRP-ERT
      LG-MSG := '0721'
    ELSE
      COMPRESS '0716' G-NATRP-ERT TO LG-MSG /* Error submitting print job.
    END-IF
/*SU6    END-IF
    COMPRESS 'ID =' G-P-POID TO LG-OBJECT-NAME
    PERFORM WRITE-LOG-RECORD
    IF G-NATRP-ERC NE 721
      G-NATRP-ERC := 5
    END-IF
  END-IF
  G-P-JOBNAME := JOB-NAME
/*SU6  IF PHYSICAL-PRINTER.PH-PRINTER-TYPE = ##PHYS-BS2
/*SU6   G-P-JOBID := JOB-ID RESET  G-P-JOBNO G-P-JOBNAME ELSE
  G-P-JOBNO := JOB-NUMBER
  RESET G-P-JOBID
/*SU6 END-IF
  G-P-NODE := #PRINTER-NODE
END-FIND
*
END-SUBROUTINE /* CLOSE-SUBMIT
*
************************************************************************
DEFINE SUBROUTINE WRITE-LOG-RECORD
************************************************************************
LG-USERID := G-LG-USERID
LG-CODE   := 'MO'
CALLNAT 'RLOG' PL-PARMS    /* Write a record to the log
END OF TRANSACTION
*
END-SUBROUTINE /* WRITE-LOG-RECORD
*
************************************************************************
DEFINE SUBROUTINE SET-EXTRA-DSN-VARIABLES
************************************************************************
IF RMJBST-ENTRIES GE K-MAX-RMJBST-ENTRIES
  ESCAPE ROUTINE
END-IF
IF PRINTOUTS.PO-REPNAME NE ' '
  #AR-NAME:= PRINTOUTS.PO-REPNAME
  #AR-RNB := PRINTOUTS.PO-REPRNB
  #RUN-NR := #AR-RNB
  FIND ACTIVE-REPORTS-TIME WITH AR-REPORT-RNB = #AR-REPTIME-RNB
    MOVE EDITED AR-PROCESS-TIME (EM=YYMMDD) TO #DATE-VAR
    MOVE EDITED AR-PROCESS-TIME (EM=HHII) TO #TIME-VAR-A4
  END-FIND
ELSE
  IF PRINTOUTS.PO-BUNDLE NE ' '
    #AB-NAME:= PRINTOUTS.PO-BUNDLE
    #AB-RNB := PRINTOUTS.PO-BUNDRNB
    #RUN-NR := #AB-RNB
    FIND ACTIVE-BUNDLES-TIME WITH AB-BUNDLE-RNB = #AB-BUNTIME-RNB
      MOVE EDITED AB-OPEN-TIME (EM=YYMMDD) TO #DATE-VAR
      MOVE EDITED AB-OPEN-TIME (EM=HHII) TO #TIME-VAR-A4
    END-FIND
  END-IF
END-IF
ADD 1 TO RMJBST-ENTRIES
IF RMJBST-ENTRIES GT K-MAX-RMJBST-ENTRIES
  ESCAPE ROUTINE
END-IF
RMJBST-VAR (RMJBST-ENTRIES):= 'CDATE'
RMJBST-TEXT(RMJBST-ENTRIES):= #DATE-VAR
ADD 1 TO RMJBST-ENTRIES
IF RMJBST-ENTRIES GT K-MAX-RMJBST-ENTRIES
  ESCAPE ROUTINE
END-IF
RMJBST-VAR (RMJBST-ENTRIES):= 'CTIME'
RMJBST-TEXT(RMJBST-ENTRIES):= #TIME-VAR-A4
MOVE EDITED *TIMX (EM=YYMMDD) TO #DATE-VAR
MOVE EDITED *TIMX (EM=HHIISST) TO #TIME-VAR
ADD 1 TO RMJBST-ENTRIES
IF RMJBST-ENTRIES GT K-MAX-RMJBST-ENTRIES
  ESCAPE ROUTINE
END-IF
RMJBST-VAR (RMJBST-ENTRIES):= 'DATE'
RMJBST-TEXT(RMJBST-ENTRIES):= #DATE-VAR
ADD 1 TO RMJBST-ENTRIES
IF RMJBST-ENTRIES GT K-MAX-RMJBST-ENTRIES
  ESCAPE ROUTINE
END-IF
RMJBST-VAR (RMJBST-ENTRIES):= 'TIME'
RMJBST-TEXT(RMJBST-ENTRIES):= #TIME-VAR
ADD 1 TO RMJBST-ENTRIES
IF RMJBST-ENTRIES GT K-MAX-RMJBST-ENTRIES
  ESCAPE ROUTINE
END-IF
RMJBST-VAR (RMJBST-ENTRIES):= 'RUNNR'
RMJBST-TEXT(RMJBST-ENTRIES):= #RUN-NR
*
END-SUBROUTINE /* SET-EXTRA-DSN-VARIABLES
*
END
