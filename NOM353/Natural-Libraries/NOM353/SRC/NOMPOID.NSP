* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    NOMPOID
* Function  Set new POID
*
* Maintenance
* fhi     2011-08-05           created
* SU1     2014-11-17 NOMALL-1450 fill fields for Adabas Vista
* SU2     2016-01-20 NOMALL-1802 do not update Adabas Vista fields
* ---------------------------------------------------------------------
DEFINE DATA LOCAL
1 #CONTROL-KEY           (N7) CONST <9999999>
1 #MAX-KEY               (N7) CONST <9999998>
1 PO VIEW OF NRM-PRINTOUTS
  2 PO-REPRNB
  2 REDEFINE PO-REPRNB
    3 PO-LAST-ID         (P11)
  2 PO-OBJECT-TYPE /*SU1
  2 PO-OBJECT-TIME /*SU1
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
SET KEY ALL
FNDPO. FIND PO WITH PO-ID = #CONTROL-KEY
*
  IF NO RECORDS FOUND
    ENTER
  END-NOREC
*
  INPUT 'Set Last PO-ID to (PF3=END):' PO-LAST-ID
  IF *PF-KEY NE 'ENTR'
    ESCAPE ROUTINE
  END-IF
  IF PO-LAST-ID > #MAX-KEY
    REINPUT 'Enter range 1 ... 9999998 or end with PF3'
  END-IF
*
  IF *NUMBER (FNDPO.) = 0
    PO-OBJECT-TYPE := 'PO' /*SU1 SU2 moved to STORE
    PO-OBJECT-TIME := *TIMX /*SU1 SU2 moved to STORE
    STORE PO
  ELSE
    UPDATE
  END-IF
  END TRANSACTION
*
END-FIND
*
END
