END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
FORMAT (0) LS=133 PS=60
*
IF *MACHINE-CLASS NE 'MAINFRAME' /* This only works on MF
  ESCAPE ROUTINE
END-IF
IF G-TRACE GE *LEVEL AND G-TRACE-SET = SCAN ('SCAN')
  #TRACING := TRUE
END-IF
INCLUDE CMRDC
IF #TRACING
  COMPRESS 'Start Scanning' #SPOOL TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  PERFORM XXCATAL-GET-CATDATE #CATDATE
  COMPRESS *PROGRAM 'cataloged at' #CATDATE TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
CALLNAT 'N-MONERR' #MAX-RETRIES #RETRY-INTERVAL
IF +G-CMASPOOL-VERSION = 0
  FIND CMASPOOL-VERSION WITH M-MONITOR-ID = 'CMASPOOL'
    IF CMASPOOL-VERSION.M-BATCH-MODULE IS (N1)
      +G-CMASPOOL-VERSION:= VAL(CMASPOOL-VERSION.M-BATCH-MODULE)
    END-IF
  END-FIND
  IF +G-CMASPOOL-VERSION LT 1
    +G-CMASPOOL-VERSION:= 1
  END-IF
  WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
    'CA Spool version:' +G-CMASPOOL-VERSION
END-IF
*
RMSETTIM.FUNCTION := 'S'
PERFORM RMSETTIM-SETTIME RMSETTIM
*
RESET #ESFS
*
#ESFS-SEL-FNO := #ESFS-SEL-DES := #ESFS-NEA := 1
#ESFS-SEL-OWN := #ESFS-SEL-GR := 0
#ESFS-SEL-CLS := #ESFS-SEL-FOR := #ESFS-SEL-FCB := #ESFS-SEL-DIS := 0
#ESFS-EPL            := 32
IF +G-CMASPOOL-VERSION = 1
  RESET  #ESFS-E90-FQESEQNO
ELSE
  RESET  #ESFS-E90-FQESEQNO2
END-IF
*
FOR #DEST-INDEX 1 10
  IF G-SCAN-CMASPOOL-IDENT (#DEST-INDEX) = ' '
    ESCAPE ROUTINE
  END-IF
  #ESFS-DES := G-SCAN-CMASPOOL-IDENT (#DEST-INDEX)
  PERFORM SCAN-DESTINATION
END-FOR
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE SCAN-DESTINATION
************************************************************************
IF #TRACING
  COMPRESS 'Scan dest' #ESFS-DES TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
*
REPEAT
*
  #ESFS-STA := G-SCAN-CMASPOOL-VERSION
  #ESFS-OPT := H'A8'                    /* fqe layout instead of fscte
  IF +G-CMASPOOL-VERSION = 1
    #ESFS-FNO := #ESFS-E90-FQESEQNO + 1
  ELSE
    #ESFS-FNO := #ESFS-E90-FQESEQNO2 + 1
  END-IF
*
  CALL ESF-STAT-ROUTINE #ESF-STAT-PARMS (*)
  #ESF-RC := RET (ESF-STAT-ROUTINE)
*
  IF #ESF-RC > H'0000'
    COMPRESS G-MONITOR-ID '/' +NOD-CURRENT-NODE '/' *PROGRAM
      TO LG-OBJECT-NAME LEAVING NO
    WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
      'Unable to process CA Spool' LG-OBJECT-NAME
    COMPRESS 'Error during Scan CA Spool RC=' #ESF-RC-I
      TO G-NATRP-ERT LEAVING NO
    G-NATRP-ERC := 0005
    PERFORM WRITE-ERROR-LOG
    ESCAPE ROUTINE
  END-IF
*
  IF #ESFS-NEU = 0
    ESCAPE BOTTOM
  END-IF
  IF (+G-CMASPOOL-VERSION = 1 AND #ESFS-E90-FQELNCNT > 0)
      OR (+G-CMASPOOL-VERSION = 2 AND #ESFS-E90-FQELNCNT2 > 0)
    PERFORM PROCESS-CMA-QUEUE-ELEMENT
    IF G-NATRP-ERC NE 0
      ESCAPE ROUTINE
    END-IF
    PERFORM ROUT-TO-TEMP-DEVICE
    IF #START-FIRST-ORDER
      #START-FIRST-ORDER:= FALSE
      PERFORM START-FIRST-ORDER-GEN /*RMSC-C
    END-IF
    IF G-NATRP-ERC NE 0
      ESCAPE ROUTINE
    END-IF
  END-IF
*
  IF +G-SCAN-CMASPOOL-TIME-LIMIT NE 0
    RMSETTIM.FUNCTION := 'G'
    PERFORM RMSETTIM-SETTIME RMSETTIM
    IF #TRACING
      PERFORM XXRLOG-WRITE-LOG 'T' RMSETTIM.MSG
      END TRANSACTION
    END-IF
    IF #TIMD > +G-SCAN-CMASPOOL-TIME-LIMIT
      ESCAPE ROUTINE
    END-IF
  END-IF
*
END-REPEAT
*
END-SUBROUTINE /* SCAN-DESTINATION
*
************************************************************************
DEFINE SUBROUTINE PROCESS-CMA-QUEUE-ELEMENT
************************************************************************
RESET #ATTRIBUTES #SOURCE-ATTRIBUTES #SPOOL-ATTRIBUTES
*
#CONTROL-FLAG                := 'X'
#SOURCE-TYPE                 := CMASPOOL
IF +G-CMASPOOL-VERSION = 1
  #CMASPOOL-SID   := #ESFS-E90-FQESID
  #CMASPOOL-DSKEY := #ESFS-E90-FQEDSKEY
  #CMASPOOL-SEQNO := #ESFS-E90-FQESEQNO
  #CMASPOOL-OWNNM := #ESFS-E90-FQEOWNNM
ELSE
  #CMASPOOL-SID   := #ESFS-E90-FQESID2
  #CMASPOOL-DSKEY := #ESFS-E90-FQEDSKEY2
  #CMASPOOL-SEQNO := #ESFS-E90-FQESEQNO2
  #CMASPOOL-OWNNM := #ESFS-E90-FQEOWNNM2
END-IF
IF #TRACING
  COMPRESS 'Process queue element' #CMASPOOL-SID #CMASPOOL-SEQNO
    TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
#CMASPOOL-DEST    := G-SCAN-CMASPOOL-TEMP-DEST
#CMASPOOL-VERSION := G-SCAN-CMASPOOL-VERSION
*
#CONTROL-TYPE  := CMASPOOL
#CONTROL-IDENT := #CMASPOOL-IDENT
*
FNDP. FIND NUMBER SOURCE WITH SR-CONTROL = #CONTROL
IF *NUMBER (FNDP.) = 0
  PERFORM ASSIGN-SPOOL-ATTRIBUTES
  PERFORM CREATE-SOURCE-RECORD
  IF G-NATRP-ERC = 0
    PERFORM CREATE-ORDER-RECORDS
  END-IF
END-IF
*
END-SUBROUTINE /* PROCESS-CMA-QUEUE-ELEMENT
*
************************************************************************
DEFINE SUBROUTINE CREATE-SOURCE-RECORD
************************************************************************
REPEAT
  CALLNAT 'RMSRID-N' SOURCE.SR-ID G-NATRP-ERC G-NATRP-ERT
  UNTIL G-NATRP-ERC NE 3145
END-REPEAT
*
IF G-NATRP-ERC NE 0
  RESET LG-OBJECT-NAME
  PERFORM WRITE-ERROR-LOG
  ESCAPE ROUTINE
END-IF
*
RESET SOURCE.SR-RELATED-ID
*
IF +G-NOMEXIT-ACTIVE (2)
  PERFORM CALL-NOM-EXIT-002
END-IF
*
SOURCE.SR-CONTROL-FLAG     := #CONTROL-FLAG
SOURCE.SR-TYPE             := #SOURCE-TYPE
SOURCE.SR-ATTRIBUTES-IDENT := #SOURCE-ATTRIBUTES
SOURCE.SR-SPOOL-ATTRIBUTES := #SPOOL-ATTRIBUTES
IF #CC-TYPE = 0
  SOURCE.SR-CC-TYPE := NO-CC
ELSE
  SOURCE.SR-CC-TYPE := #CC-TYPE
END-IF
SOURCE.SR-RECORD-LENGTH   := #RECORD-LENGTH
SOURCE.SR-NUMBER-OF-LINES := #NUMBER-OF-LINES
SOURCE.SR-MONITOR-ID      := G-MONITOR-ID
*
IF #TRACING
  COMPRESS 'Create source --->' SOURCE.SR-ID 'lines' #NUMBER-OF-LINES
    'reclen' #RECORD-LENGTH TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
SR-OBJECT-TYPE := 'SR' /*SU2
SR-OBJECT-TIME := *TIMX /*SU2
STORE SOURCE
END OF TRANSACTION
*
END-SUBROUTINE /* PROCESS-CMA-QUEUE-ELEMENT
*
************************************************************************
DEFINE SUBROUTINE ASSIGN-SPOOL-ATTRIBUTES
************************************************************************
PERFORM CHECK-ESFS-E90-FQEFLAG3
*
IF +G-CMASPOOL-VERSION = 1
  #NUMBER-OF-LINES := #ESFS-E90-FQELNCNT
ELSE
  #NUMBER-OF-LINES := #ESFS-E90-FQELNCNT2
END-IF
#RECORD-LENGTH   := 251
*
#SPOOL-TYPE      := CMASPOOL
#SPOOL-CMA-SEQNO := #ESFS-E90-FQESEQNO
IF +G-CMASPOOL-VERSION = 1
  #SPOOL-CMA-OWNNM := #ESFS-E90-FQEOWNNM
  #SPOOL-CMA-FNAM  := #ESFS-E90-FQEOWNNM
  #SPOOL-CMA-WTRNM := #ESFS-E90-FQEWTRNM
  #SPOOL-CMA-DSTNM := #ESFS-E90-FQEDSTNM
  #SPOOL-CMA-CLASS := #ESFS-E90-FQECLASS
  #SPOOL-CMA-COPYS := #ESFS-E90-FQECOPYS
  #SPOOL-CMA-PRIO  := #ESFS-E90-FQEPRIO
  #SPOOL-CMA-LINCT := #ESFS-E90-FQELINCT
  IF #ESFS-E90-FQERETAN = -1 THRU 4095
    #SPOOL-CMA-RETAN := #ESFS-E90-FQERETAN
  ELSE
    #SPOOL-CMA-RETAN := -1
  END-IF
  #SPOOL-CMA-FORMS := #ESFS-E90-FQEFORMS
  #SPOOL-CMA-FCB   := #ESFS-E90-FQEFCB
  #SPOOL-CMA-PRMOD := #ESFS-E90-FQEPRMOD
  #SPOOL-CMA-FORMD := #ESFS-E90-FQEFORMD
  #SPOOL-CMA-PAGED := #ESFS-E90-FQEPAGED
  #SPOOL-CMA-CHARS := #ESFS-E90-FQECHARS
  #SPOOL-CMA-USRID := #ESFS-E90-FQEUSRID
  #SPOOL-CMA-ACTNO := #ESFS-E90-FQEACTNO
  #SPOOL-CMA-ROOM  := #ESFS-E90-FQEROOM
  #SPOOL-CMA-LNCNT := #ESFS-E90-FQELNCNT
  #SPOOL-CMA-PGCNT := #ESFS-E90-FQEPGCNT
  #SPOOL-CMA-SID   := #ESFS-E90-FQESID
  #SPOOL-CMA-PGMNM := #ESFS-E90-FQEPGMNM
  #SPOOL-CMA-FNAM  := #ESFS-E90-FQEOWNNM
ELSE
  #SPOOL-CMA-OWNNM := #ESFS-E90-FQEOWNNM2
  #SPOOL-CMA-FNAM  := #ESFS-E90-FQEOWNNM2
  #SPOOL-CMA-WTRNM := #ESFS-E90-FQEWTRNM2
  #SPOOL-CMA-DSTNM := #ESFS-E90-FQEDSTNM2
  #SPOOL-CMA-CLASS := #ESFS-E90-FQECLASS2
  #SPOOL-CMA-COPYS := #ESFS-E90-FQECOPYS2
  #SPOOL-CMA-PRIO  := #ESFS-E90-FQEPRIO2
  #SPOOL-CMA-LINCT := #ESFS-E90-FQELINCT2
  IF #ESFS-E90-FQERETAN2 = -1 THRU 4095
    #SPOOL-CMA-RETAN := #ESFS-E90-FQERETAN2
  ELSE
    #SPOOL-CMA-RETAN := -1
  END-IF
  #SPOOL-CMA-FORMS := #ESFS-E90-FQEFORMS2
  #SPOOL-CMA-FCB   := #ESFS-E90-FQEFCB2
  #SPOOL-CMA-PRMOD := #ESFS-E90-FQEPRMOD2
  #SPOOL-CMA-FORMD := #ESFS-E90-FQEFORMD2
  #SPOOL-CMA-PAGED := #ESFS-E90-FQEPAGED2
  #SPOOL-CMA-CHARS := #ESFS-E90-FQECHARS2
  #SPOOL-CMA-USRID := #ESFS-E90-FQEUSRID2
  #SPOOL-CMA-ACTNO := #ESFS-E90-FQEACTNO2
  #SPOOL-CMA-ROOM  := #ESFS-E90-FQEROOM2
  #SPOOL-CMA-LNCNT := #ESFS-E90-FQELNCNT2
  #SPOOL-CMA-PGCNT := #ESFS-E90-FQEPGCNT2
  #SPOOL-CMA-SID   := #ESFS-E90-FQESID2
  #SPOOL-CMA-PGMNM := #ESFS-E90-FQEPGMNM2
  #SPOOL-CMA-FNAM  := #ESFS-E90-FQEOWNNM2
END-IF
*
END-SUBROUTINE /* ASSIGN-SPOOL-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE ROUT-TO-TEMP-DEVICE
************************************************************************
RESET #ESFR
#ESFR-STA := G-SCAN-CMASPOOL-VERSION
#ESFR-SEL-DEST := 1
#ESFR-NDS := G-SCAN-CMASPOOL-TEMP-DEST
IF +G-CMASPOOL-VERSION = 1
  #ESFR-FNO := #ESFS-E90-FQESEQNO
  #ESFR-OOW := #ESFS-E90-FQEOWNNM
ELSE
  #ESFR-FNO := #ESFS-E90-FQESEQNO2
  #ESFR-OOW := #ESFS-E90-FQEOWNNM2
END-IF
*
CALL ESF-ROUT-ROUTINE #ESF-ROUT-PARMS
#ESF-RC := RET (ESF-ROUT-ROUTINE)
IF #ESF-RC > H'0000'
  COMPRESS G-MONITOR-ID '/' +NOD-CURRENT-NODE '/' *PROGRAM
    TO LG-OBJECT-NAME LEAVING NO
  WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
    'Unable to change CA Spool destination' LG-OBJECT-NAME
  COMPRESS 'Error during reroute CA Spool RC=' #ESF-RC-I
    TO G-NATRP-ERT LEAVING NO
  G-NATRP-ERC := 0005
  PERFORM WRITE-ERROR-LOG
  ESCAPE ROUTINE
END-IF
*
END-SUBROUTINE /* ROUT-TO-TEMP-DEVICE
*
************************************************************************
DEFINE SUBROUTINE CREATE-ORDER-RECORDS
************************************************************************
IF #TRACING
  G-TRACE-MSG := 'Create order records'
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
RESET  #IDENT (*)
#TJ := 1
#IDENT-VALUE (#TJ) := #SPOOL-CMA-OWNNM               /* file-name
#IDENT-TYPE  (#TJ) := REPORT-IDENT-CMA-FILE-NAME
#IDENT-RTYPE (#TJ) := 'M'
*
#FILE-NAME := #SPOOL-CMA-OWNNM
EXAMINE #FILE-NAME FOR 'X' GIVING LENGTH IN #TL
IF #TL > 0
  IF #TL < 8                                     /* 'FILNAME*'
    ADD 1 TO #TL                                /* 'FILNAM* '
  END-IF                                         /* 'FILNA*  '
  FOR #TI = #TL TO 1 STEP -1                     /* 'FILN*   '
    #FN (#TI) := '*' /* 'FIL*    '
    IF #TI < 8                                   /* 'FI*     '
      RESET #FN (#TI + 1)                       /* 'F*      '
    END-IF                                       /* '*       '
    ADD 1 TO #TJ
    #IDENT-VALUE (#TJ) := #FILE-NAME
    #IDENT-TYPE         (#TJ) := REPORT-IDENT-CMA-FILE-NAME
    #IDENT-RTYPE (#TJ) := 'M'
  END-FOR
END-IF
*
IF #SPOOL-CMA-USRID NE ' '
  ADD 1 TO #TJ
  #IDENT-VALUE (#TJ) := #SPOOL-CMA-USRID
  #IDENT-TYPE  (#TJ) := REPORT-IDENT-CMA-USER-ID
  #IDENT-RTYPE (#TJ) := 'M'
END-IF
*
IF #SPOOL-CMA-FORMS NE ' '
  ADD 1 TO #TJ
  #IDENT-VALUE (#TJ) := #SPOOL-CMA-FORMS
  #IDENT-TYPE  (#TJ) := REPORT-IDENT-CMA-FORM
  #IDENT-RTYPE (#TJ) := 'M'
END-IF
*
IF #SPOOL-CMA-WTRNM NE ' '
  ADD 1 TO #TJ
  #IDENT-VALUE (#TJ) := #SPOOL-CMA-WTRNM
  #IDENT-TYPE  (#TJ) := REPORT-IDENT-CMA-WRITER
  #IDENT-RTYPE (#TJ) := 'M'
END-IF
*
RESET #COUNT
*
PERFORM MASTER-DEFINITIONS-GEN
*
IF #COUNT = 0
  #IDENT-RTYPE (1:#TJ) := 'D'
  PERFORM DEFAULT-DEFINITIONS-GEN
END-IF
*
IF #COUNT = 0
  PERFORM WRITE-LOG-RECORD
ELSE
  PERFORM CREATE-LOAD-ORDER
  #START-FIRST-ORDER:= TRUE
END-IF
*
END-SUBROUTINE /* CREATE-ORDER-RECORDS
*
************************************************************************
DEFINE SUBROUTINE HANDLE-IT-SPEC /*special
************************************************************************
IF #TRACING
  COMPRESS #TYPE 'report=' REPORT.R-REPNAME TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
ADD 1 TO #COUNT
PERFORM WRITE-ORDER-RECORD
*
END-SUBROUTINE /* HANDLE-IT-SPEC
*
************************************************************************
DEFINE SUBROUTINE WRITE-ORDER-RECORD
************************************************************************
REPEAT
  CALLNAT 'RMODID-N' ORDER.OD-ID G-NATRP-ERC G-NATRP-ERT
  UNTIL G-NATRP-ERC NE 3145
END-REPEAT
*
IF G-NATRP-ERC NE 0
  RESET LG-OBJECT-NAME
  PERFORM WRITE-ERROR-LOG
  ESCAPE ROUTINE
END-IF
#OD-TYPE := OD-CREATE-AR
PERFORM WRITE-ORDER-RECORD-GEN /*RMSC-C
#LAST-ORDER-ISN := #ISN
*
END-SUBROUTINE /* WRITE-ORDER-RECORD
*
************************************************************************
DEFINE SUBROUTINE CREATE-LOAD-ORDER
************************************************************************
REPEAT
  CALLNAT 'RMODID-N' ORDER.OD-ID G-NATRP-ERC G-NATRP-ERT
  UNTIL G-NATRP-ERC NE 3145
END-REPEAT
*
IF G-NATRP-ERC NE 0
  RESET LG-OBJECT-NAME
  PERFORM WRITE-ERROR-LOG
  ESCAPE ROUTINE
END-IF
*
RESET   ORDER.OD-PARAMETER (1)
ORDER.OD-TYPE         := OD-LOAD-SOURCE
ORDER.OD-MONITOR-ID   := G-MONITOR-ID
ORDER.OD-USER-ID      := REPORT.R-USERID
ORDER.OD-IDENT        := G-SCAN-CMASPOOL-IDENT (#DEST-INDEX)
ORDER.OD-DBID-N5      := G-SCAN-CMASPOOL-DBID (#DEST-INDEX)
ORDER.OD-FNR-N5       := G-SCAN-CMASPOOL-FNR  (#DEST-INDEX)
ORDER.OD-SOURCE-ID    := SOURCE.SR-ID
ORDER.OD-TIME-CREATED := *TIMX
RESET  ORDER.OD-RETRY-COUNT
ORDER.OD-MAX-RETRIES    := #MAX-RETRIES
ORDER.OD-RETRY-INTERVAL := #RETRY-INTERVAL
*
STOOD. STORE ORDER
#LAST-ORDER-ISN := *ISN (STOOD.)
END OF TRANSACTION
*
END-SUBROUTINE /* CREATE-LOAD-ORDER
*
************************************************************************
DEFINE SUBROUTINE CHECK-ESFS-E90-FQEFLAG3
************************************************************************
* FQEFLAG3 DC    X'00'               FILE ATTRIBUTE FLAG         A-ES8211 00080000
* FQEFLG3A EQU   X'80'               ASA CC                      A-ES8211 00495030
* FQEFLG3M EQU   X'40'               MACHINE CC                  A-ES8211 00495030
* FQEFLG3C EQU   X'08'               COMPRESSION=YES             A-ES8211 00495030
* FQEFLG3T EQU   X'04'               TRC=YES                     A-ES8211 00495040
* FQEFLG3F EQU   X'02'               FSA CHECKPOINT DATA VALID   A-ES9221 00495040
*
SATBT-FLAG := #ESFS-E90-FQEFLAG3
CALLNAT SAT-CHECK-FLAG-BIT-SETTINGS SATBT-SATVERS SATBT-PARMS (*)
DECIDE FOR EVERY CONDITION
  WHEN SATBT-BIT-SET (1)     #CC-TYPE := ASA-CODE
  WHEN SATBT-BIT-SET (2)     #CC-TYPE := MACHINE-CODE
  WHEN SATBT-BIT-SET (5)     #SPOOL-CMA-CMP := 'Y'
  WHEN NOT SATBT-BIT-SET (5) #SPOOL-CMA-CMP := 'N'
  WHEN SATBT-BIT-SET (6)     #SPOOL-CMA-TRC := 'Y'
  WHEN NOT SATBT-BIT-SET (6) #SPOOL-CMA-TRC := 'N'
  WHEN NONE IGNORE
END-DECIDE
*
END-SUBROUTINE /* CHECK-ESFS-E90-FQEFLAG3
*
************************************************************************
DEFINE SUBROUTINE WRITE-LOG-RECORD
************************************************************************
COMPRESS 'CASPOOL' '/' #CMASPOOL-DEST '/' #CMASPOOL-OWNNM
  TO LG-OBJECT-NAME LEAVING NO
COMPRESS '1106' LG-OBJECT-NAME TO LG-MSG
LG-USERID := G-LG-USERID
LG-CODE   := 'NP'
CALLNAT 'RLOG' PL-PARMS
END OF TRANSACTION
*
END-SUBROUTINE /* WRITE-LOG-RECORD
*
************************************************************************
ON ERROR
************************************************************************
  BACKOUT TRANSACTION
  G-NATRP-ERC := 0021
  CALLNAT 'C-NATERN' G-NATRP-ERT
  IF *ERROR-NR NE 3148
    PERFORM WRITE-ERROR-LOG
  END-IF
END-ERROR
*
INCLUDE RMSC-C ' ' ' ' 'PERFORM HANDLE-IT-SPEC'
*
END
