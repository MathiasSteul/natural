* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    Y-OR-N
* Function  Answer the question
*
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* xsetoba 2002-06-19 (CE7553) Create ...
* xsetggr 2002-10-02 (CE7553) changes
* ----------------------------------------------------------------------
DEFINE DATA
       PARAMETER
     1 #USERID                      (A8) /* xsetggr 2002-10-02 in
     1 #ANSW                        (L)
      LOCAL
     1 #A                           (A1) INIT <'N'>
END-DEFINE
*
SET KEY PF3
RESET #ANSW
SET CONTROL 'WL56C8B18/12F'    /* xsetggr 2002-10-02 was 'WL56C6B18/12F'
SET CONTROL 'M5' /* xsetggr 2002-10-02 was 'M3'
* REPEAT/* xsetggr 2002-10-02 out
INPUT WITH TEXT '   ' USING MAP 'Y-OR-NM&'
IF *PF-KEY = 'PF3'
   SET CONTROL 'WB'
   ESCAPE ROUTINE
END-IF
IF #A EQ 'Y'
  MOVE TRUE TO #ANSW
END-IF
* xsetggr 2002-10-02 3 following 4 lines out
* IF #A = 'N' OR #A = 'Y'
*     ESCAPE BOTTOM
*  END-IF
* END-REPEAT
* xsetggr 2002-10-02 insert 3 lines
IF NOT (#A = 'Y' OR = 'N')
  REINPUT *1099 MARK *#A
END-IF
SET CONTROL 'WB'
END
