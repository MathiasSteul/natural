* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    RWKDAY-N
* Version   1.3
* Function  Translate Weekdays from the current language to english and
*           from english to the current language
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* mrs 93-09-15           rewritten
* jvd 97-08-01 p(164220) NOM141ÖNAT23
* sju 00-02-04 p(191763) only works for monday if language not english
* SU1     2015-02-27 NOMALL-1569 restructured
* ----------------------------------------------------------------------
DEFINE DATA
PARAMETER USING RWKDAY-P
************************************************************************
LOCAL USING RWKDAY-E
LOCAL
1 #ENGLISH   (A2/1:7)
1 #CURRENT   (A2/1:7)
1 I          (P2)
1 F          (P2)
1 #DATE      (D)
1 #LANGUAGE  (I1)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET RWKDAY-OUT-WEEKDAYS (*)
*
PERFORM FILL-WEEKDAY-TABS
*
DECIDE ON FIRST RWKDAY-FUNCTION
  VALUE RWKDAY-FROM-CURRENT-TO-ENGLISH
    PERFORM FROM-CURRENT-TO-ENGLISH
  VALUE RWKDAY-FROM-ENGLISH-TO-CURRENT
    PERFORM FROM-ENGLISH-TO-CURRENT
  NONE VALUE
    IGNORE
END-DECIDE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE FROM-CURRENT-TO-ENGLISH
************************************************************************
FOR I = 1 TO 7
  IF RWKDAY-IN-WEEKDAYS (I) NE ' '
    EXAMINE FULL VALUE OF #CURRENT (*)
      FOR FULL VALUE OF RWKDAY-IN-WEEKDAYS (I) GIVING INDEX F
    IF F > 0
      RWKDAY-OUT-WEEKDAYS (I) := #ENGLISH (F)
    ELSE
      RWKDAY-OUT-WEEKDAYS (I) := RWKDAY-IN-WEEKDAYS (I)
    END-IF
  END-IF
END-FOR
*
END-SUBROUTINE /* FROM-CURRENT-TO-ENGLISH
*
************************************************************************
DEFINE SUBROUTINE FROM-ENGLISH-TO-CURRENT
************************************************************************
FOR I = 1 TO 7
  IF RWKDAY-IN-WEEKDAYS (I) NE ' '
    EXAMINE FULL VALUE OF #ENGLISH (*)
      FOR FULL VALUE OF RWKDAY-IN-WEEKDAYS (I) GIVING INDEX F
    IF F > 0
      RWKDAY-OUT-WEEKDAYS (I) := #CURRENT (F)
    ELSE
      RWKDAY-OUT-WEEKDAYS (I) := RWKDAY-IN-WEEKDAYS (I)
    END-IF
  END-IF
END-FOR
*
END-SUBROUTINE /* FROM-ENGLISH-TO-CURRENT
*
************************************************************************
DEFINE SUBROUTINE FILL-WEEKDAY-TABS
************************************************************************
#LANGUAGE := *LANGUAGE
*LANGUAGE := 1
*
#DATE := *DATX
*
FOR I = 1 TO 7
  MOVE EDITED #DATE (EM=N(2)) TO #ENGLISH (I)
  EXAMINE #ENGLISH (I) TRANSLATE INTO UPPER CASE
  ADD 1 TO #DATE
END-FOR
*
*LANGUAGE := #LANGUAGE
#DATE := *DATX
*
FOR I = 1 TO 7
  MOVE EDITED #DATE (EM=N(2)) TO #CURRENT (I)
  EXAMINE #CURRENT(I) TRANSLATE INTO UPPER CASE
  ADD 1 TO #DATE
END-FOR
*
END-SUBROUTINE /* FILL-WEEKDAY-TABS
*
END
