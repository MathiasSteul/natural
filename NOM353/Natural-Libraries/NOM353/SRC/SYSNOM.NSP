* fhi     2009-02-27 P300323 Rename RGETSTEP to NOMGSTEP delivered in SYSTEM
* SU      2013-01-30         comments added
* SU1     2018-07-24 NOMALL-1643 NOM 3.5:remove steplibs SYSLIB,SYSLIBS
* ----------------------------------------------------------------------------
DEFINE DATA
/*SU1 LOCAL USING NOMGSTEL
LOCAL
1 CMUB-CODE                  (B1) INIT <0>
1 CMUB-INFO                  (A32)
1 REDEFINE CMUB-INFO
  2  UB-1                     (N1)
1 CMUB-RETCODE               (N4)
1 #SECURITY-ACTIVE           (L)
/*SU1 1 #I                         (P3)
/*SU1 1 #RET                       (I04)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
OPTIONS USREXIT=ON /*SU1
/*SU1 PERFORM GET-SYSLIBS /*add SYSLIBS for 'NAT00040'(NSC-ACTIVE)
PERFORM NSC-ACTIVE
IF NOT #SECURITY-ACTIVE
  STACK TOP COMMAND 'MENUNOM' /*set steplibs
ELSE
  PERFORM STACK-NOT-MENU-IF-SECURITY /*Natural member SYSSUBST(SYSCMD1)
END-IF
STACK TOP COMMAND 'LOGON' 'SYSNOM'
STACK TOP COMMAND 'SETUP *'
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
/*SU1 DEFINE SUBROUTINE GET-SYSLIBS
*
************************************************************************
DEFINE SUBROUTINE NSC-ACTIVE
************************************************************************
CALLNAT 'NAT00040' CMUB-CODE CMUB-INFO CMUB-RETCODE
IF UB-1 = 0
  #SECURITY-ACTIVE := FALSE
ELSE
  #SECURITY-ACTIVE := TRUE
END-IF
*
END-SUBROUTINE /* NSC-ACTIVE
*
END
