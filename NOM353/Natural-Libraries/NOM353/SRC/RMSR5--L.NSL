DEFINE DATA LOCAL
/* >Natural Source Header 000000
/* :Mode S
/* :CP
/* <Natural Source Header
*   RMSR5--L- Source Attribute       Definition
*   Covers Old Jobnumber N5 Format.
*
*   Maintenance
*   uuu yy-mm-dd s(999999) ...
*   FHI 05-04-18 S(999999) CREATED             FROM RMSR---L
*   NOM3107 SUPPORT 7 BYTE JOBNUMBRS
*   xsetggr 2007-05-02 NOM3201                 Support 5 byte node number
*   XSETGGR 2009-03-02 P314788          CORRECTLENGTH OF #FBS25-DSNAME
*   xsetggr 2009-08-19 P319306          correct node conversion
*   RAYA    2012-08-21 NOMALL-78               DISABL LONG RECORDS
*   SU1     2024-03-07 ES-34613      NOM 3.6:  Remove power
*   ---------------------------------      -----------------------------------
1 #SOURCE-ATTR-5 (A250)
* **CMASPOOL ??
* **SU1 #POWER5-..                                                       -----
*   ---------------------------------      -----------------------------------
*   JES2/JES3 Spool Queue Entry
*   ---------------------------------      -----------------------------------
1 REDEFINE #SOURCE-ATTR-5
  2 #JES5-QUEUE-IDENT (A63)
  2 REDEFINE #JES5-QUEUE-IDENT
    3 #JES5-QUEUE-NODE (N3)
    3 #JES5-QUEUE-JOB-NAME (A8)
    3 #JES5-QUEUE-JOB-NUMBER (N5)
    3 #JES5-QUEUE-GROUP-ID (A20)
*   ---------------------------------      -----------------------------------
*   JES2/JES3 Spool File
*   ---------------------------------      -----------------------------------
1 REDEFINE #SOURCE-ATTR-5
  2 #JES5-IDENT (A63)
  2 REDEFINE #JES5-IDENT
    3 #JES5-NODE (N3)
    3 #JES5-JOB-NAME (A8)
    3 #JES5-JOB-NUMBER (N5)
    3 #JES5-TYPE (A2)
    3 #JES5-DATA-SET-KEY (N7)
  2 #JES5-PROCNAME (A8)
  2 #JES5-STEPNAME (A8)
  2 #JES5-DDNAME (A8)
  2 #JES5-DATA-SET (N5)
  2 #JES5-REP-FORMAT (A1)
* **End of LDA RMSR5--L *********** *************************************
END-DEFINE
