* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RSRTLAY
* SORT LAYOUT
************************************************************************
DEFINE DATA PARAMETER
*
1 #LAYOUT
  2 #LAYOUT-F(P3/10)
  2 #LAYOUT-T(P3/10)
  2 #LAYOUT-S(P3/10)
  2 #LAYOUT-N(P3)
  2 CV-LAYOUT (C/10)
LOCAL
1 #L(P3)
1 #FROM(P3)
1 #TO(P3)
1 #SEQ(P3)
END-DEFINE
RESET #LAYOUT-N
   FOR #L 1 TO 10
    IF #LAYOUT-F(#L) = 0 ESCAPE TOP END-IF
    MOVE #LAYOUT-F(#L) TO #FROM
    MOVE #LAYOUT-T(#L) TO #TO
    MOVE #LAYOUT-S(#L) TO #SEQ
    END-ALL
    SORT BY #SEQ USING #FROM #TO
     ADD 1 TO #LAYOUT-N
       MOVE #FROM TO #LAYOUT-F(#LAYOUT-N)
       MOVE #TO TO #LAYOUT-T(#LAYOUT-N)
       MOVE #SEQ TO #LAYOUT-S(#LAYOUT-N)
    END-SORT
    IF #LAYOUT-N < 10
       RESET #LAYOUT-F(#LAYOUT-N + 1 : 10)
       RESET #LAYOUT-T(#LAYOUT-N + 1 : 10)
       RESET #LAYOUT-S(#LAYOUT-N + 1 : 10)
    END-IF
END
