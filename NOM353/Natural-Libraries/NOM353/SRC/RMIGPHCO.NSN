* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RMIGPHCO
* Function:  copy physical-printer from source to target environment
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 #P-MSG     (N4)
1 #P-VTAMID  (A8)
************************************************************************
LOCAL USING VPHPR-L
LOCAL USING VTPHYS-L
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
FNDS. FIND PHYSICAL-PRINTERS WITH PH-VTAMID = #P-VTAMID
  IF NO RECORDS FOUND
    #P-MSG := 4013
    ESCAPE BOTTOM (FNDS.)
  END-NOREC
  FNDT. FIND MIGRATE-PHYSICAL-PRINTERS WITH PH-VTAMID = #P-VTAMID
    IF NO RECORDS FOUND
      ENTER
    END-NOREC
    MOVE BY NAME PHYSICAL-PRINTERS TO MIGRATE-PHYSICAL-PRINTERS
    IF *NUMBER (FNDT.) = 0
      STORE MIGRATE-PHYSICAL-PRINTERS
    ELSE
      UPDATE (FNDT.)
    END-IF
  END-FIND
END-FIND
END OF TRANSACTION
*
END
