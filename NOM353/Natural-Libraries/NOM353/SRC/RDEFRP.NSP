*
DEFINE WINDOW USER-EXIT-PARMS SIZE 11*49 BASE 07/30 CONTROL SCREEN
*
* NKEW1 <
#JOB_ADD_FIELD := F#SETVAR(<#_JOBCARDS(1:2),#_ADDITIONALPARA(1:2)>)
* NKEW1 >
IF *DATA > 0
  FETCH RETURN 'NRMGETGL'
  FETCH RETURN 'NRMGETAI'
  INPUT (AD=MIT) G-C-FUNC G-C-REPORT #PANEL
END-IF
*
* security check
IF G-FATHER-PROG NE SCAN 'RLIAC'
  PERFORM XXSECURITY-CHECK #PROG G-C-REPORT #ALLOWED
  INCLUDE C-NALLOW /*allowed
END-IF
*
IF G-C-FUNC = 'P'
  FETCH RETURN 'RDELRP'
  INCLUDE C-ESCAPE
END-IF
IF G-C-FUNC NE 'A' /*get/check ident... SU12 ->
  CALLNAT 'RDEFRP-N' G-C-FUNC G-C-REPORT #LEAVE #UNIX-NODENAME
    #IDENT-NAME #IDENT-TYPE
  IF #LEAVE /*do not remove old/mult. ids -> leave it as it is Ü
    G-NATRP-ERC := 29
    FETCH #FATHER-PROG
  END-IF
  IF #IDENT-TYPE = REPORT-UNIX-ATTRIBUTES
    #UNIX := TRUE
    #NODENAME := #UNIX-NODENAME
  END-IF
END-IF /*SU12 <-
CV-KEY := (AD=I)
RESET G-COMMIT G-LINECOM(*)
*
#FUNC   := G-C-FUNC
#REPORT := G-C-REPORT
#AUTODEF := F#MONITOR-USER-AUTODEF (<>)
RESET #DEF-USER #CHK-USER
*
EOM-USER-PROFILE := G-USER-PROFILE
EOM-USER         := G-USERID
EOM-USER-TYPE    := G-USER-TYPE
US. FIND NUMBER USERS WITH USER-ID = G-USERID
IF *NUMBER (US.) = 0
  EOM-DEF-USER := 'Y'
END-IF
*
RESET  EOM-LOGGING
IF G-LOG-REP
  EOM-LOG-TYPES (1) :='R'
END-IF
*
IF #PANEL = 0
  #PANEL := REPORT-GENERAL-ATTRIBUTES
END-IF
*
MAIN-LOOP. REPEAT
  RESET #DISTR-USERS(*)
  EOMRPM-I-NAME           := #REPORT
  EOMRPM-I-ATTRIBUTE-TYPE := #PANEL
  #EOM-FUNCTION            := EOM-FUNCTION
  #EOMRPM-I-ATTRIBUTE-TYPE := EOMRPM-I-ATTRIBUTE-TYPE
  EOM-FUNCTION             := EOM-READ
  EOMRPM-I-ATTRIBUTE-TYPE  := REPORT-SEPARATION-ATTRIBUTES
  CALLNAT 'EOMRPM-N' EOM-PARMS EOMRPM-PARMS EOMMSG-PARMS
  IF EOMRPM-EXIT-USER-NATLIB NE ' ' OR EOMRPM-EXIT-USER-NATPGM NE ' '
  OR EOMRPM-EXIT-STANDARD NE 0                                        /*
    #EXIT-EXISTS := TRUE
  ELSE
    #EXIT-EXISTS := FALSE
  END-IF
*
  EOM-FUNCTION             := EOM-READ
  EOMRPM-I-ATTRIBUTE-TYPE  := REPORT-DISTRIBUTION-ATTRIBUTES
  CALLNAT 'EOMRPM-N' EOM-PARMS EOMRPM-PARMS EOMMSG-PARMS
  IF EOMRPM-LAYOUT-COLFROM(*,*) NE 0
    #LAYOUT-EXISTS := TRUE
  ELSE
    #LAYOUT-EXISTS := FALSE
  END-IF
  EOM-FUNCTION             := #EOM-FUNCTION
  EOMRPM-I-ATTRIBUTE-TYPE  := #EOMRPM-I-ATTRIBUTE-TYPE
*
  DECIDE ON FIRST #FUNC
    VALUE 'A' /*add
      CV-KEY                  := (AD=I)
      EOM-FUNCTION            := EOM-INIT
      EOMRPM-I-ATTRIBUTE-TYPE := REPORT-GENERAL-ATTRIBUTES
      RESET  EOMRPM-GENERAL-ATTRIBUTES
      #PANEL := REPORT-GENERAL-ATTRIBUTES
      RESET  #LANGUAGE
    VALUE 'M' /*modify
      CV-KEY       := (AD=IP)
      EOM-FUNCTION := EOM-READHOLD
    VALUE 'D' /*display
      CV-KEY := CV-MAP := CV-PATH := CV-FILES := CV-UNIX-FILES :=
      CV-UNIX := CV-TYPE := CV-NODE := CV-NOMDB := CV-IDENT := (AD=IP)
      EOM-FUNCTION := EOM-READ
    NONE
      G-NATRP-ERC := 9999
      INCLUDE C-ESCAPE
  END-DECIDE
*
  FIND-LOOP. REPEAT
    CALLNAT 'RGETLIB' #EDIT-LIB2
    COMPRESS #EDIT-LIB2 'U' TO #EDIT-LIB2 LEAVING NO
    RESET EOMMSG-PARMS
    CALLNAT 'EOMRPM-N' EOM-PARMS EOMRPM-PARMS EOMMSG-PARMS
    #TEXT := EOMMSG-TEXT
    IF EOMMSG-NR NE 0
      G-NATRP-ERC := EOMMSG-NR
      G-NATRP-ERT := EOMMSG-TOKEN (1)
      INCLUDE C-ESCAPE
    END-IF
    IF EOMRPM-I-ATTRIBUTE-TYPE = REPORT-GENERAL-ATTRIBUTES /*SU2 ->
      #MODIFIED-BY   := EOMRPM-LAST-UPDATE-USER
      #LAST-MODIFIED := EOMRPM-LAST-UPDATE
      PERFORM GET-SPOOL-PARAMS
      IF NOT #UNIX
        IF EOMRPM-INTERNAL-NODE-ID = 0 /* not specified
          #SPOOL-TYPE  := +NOD-LOCAL-SPOOL-TYPE
          #SYSTEM-TYPE := +NOD-LOCAL-SYSTEM-TYPE
          #NODE-NR     := +NOD-LOCAL-NODE
          /* #NODENAME not shown on mask
        ELSE
          FIND MF-NODE WITH MF-INTERNAL-NODE-ID =EOMRPM-INTERNAL-NODE-ID
            #SPOOL-TYPE  := MF-SPOOL-TYPE
            #SYSTEM-TYPE := MF-SYSTEM-TYPE
            #NODE-NR     := MF-MONITOR-NODE
            #NODENAME    := SUBSTR(MF-MONITOR-ID,3)
          END-FIND
        END-IF
      END-IF
    END-IF /*SU2 <-
    #DISTR-USERS(*) := EOMRPM-EOM-USER-LIST(*)
    #OWNER          := EOMRPM-MASTER-OWNER
*
    SCREEN-LOOP. REPEAT
      IF #LANGUAGE NE *LANGUAGE
        MOVE G-LANGUAGE TO #LANGUAGE *LANGUAGE
        PERFORM INIT-PFKEYS
        PERFORM SET-PFKEYS
        SET KEY PF01=HELP NAMED G-PF-TEXT (1)
        SET KEY PF13=HELP NAMED G-PF-TEXT (1)
        PERFORM INIT-TEXT
      END-IF
*
      IF #FUNC NE 'D' AND NOT #ANY-ERROR
        INCLUDE C-HOLD
      END-IF
*
      PERFORM FLIP-DISPLAY
      SET CONTROL 'L'
      SET CONTROL 'WB'
      CALLNAT 'N-HEADER' L-HEADER G-DATE-FORMAT 'RDEFRPM&'
      IF NOT #ANY-WILDCARD
* force validation if there was a previous wildcard for separators/
* sep exit - we couldn't validate at the time as we would have got a
* NAT1108
        RESET G-MAP-MODIFIED
      ELSE
        RESET #ANY-WILDCARD
        G-MAP-MODIFIED:= TRUE
      END-IF
*
      #REPORT-M := #REPORT
      IF NOT G-DISPLAY-LONG-NAMES
        #REPORT-R := H'FA'
      END-IF
*
      CALLNAT 'N-HEAD2' #MODIFIED-BY #LAST-MODIFIED /*SU2
        #LAST-MOD G-DATE-FORMAT /*SU2
      DECIDE ON FIRST #PANEL
        VALUE REPORT-GENERAL-ATTRIBUTES
          IF #FUNC = 'M' AND G-USER-TYPE = 'A'
            CV-OWN := (AD=I)
          ELSE
            CV-OWN := (AD=IP)
          END-IF
          IF #FUNC = 'D' OR (EOMRPM-REPORT-TYPE = 'C'
              AND NOT(G-NATRP-ERC =1101 OR=1102 OR=1103)) /*SU16
            CV-TYPE := (AD=DP)
          ELSE
            CV-TYPE := (AD=I)
          END-IF
          #NODENAME-OLD := #NODENAME
          #IDENT-NAME-OLD := #IDENT-NAME
          IF #POS = 0
            #POS := POS(G-DIRECT-COMMAND)
          END-IF
          IF #FUNC ='A' OR='M'
            RESET INITIAL CV-NOMDB
          END-IF
          #OLD-KY (*) := EOMRPM-KEYWORDS (*) /*SU20
          INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
            MARK #POS USING MAP 'RDEFRPG&'
          IF #FUNC ='A' OR='M'
            PERFORM HANDLE-NODE
            PERFORM HANDLE-IDENT
          END-IF
          RESET #POS
        VALUE REPORT-DISTRIBUTION-ATTRIBUTES
          IF #POS = 0
            #POS := POS(G-DIRECT-COMMAND)
          END-IF
          IF IN-LAYOUT
            INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
              MARK #POS USING MAP 'RDEFRPL&'
          ELSE
            INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
              MARK #POS USING MAP 'RDEFRPD&'
            DECIDE FOR EVERY CONDITION
              WHEN *PF-KEY='PF10' AND NOT EOMRPM-EOM-USER-LIST(*) NE ' '
                REINPUT *4026
              WHEN *PF-KEY = 'PF10' AND #EXIT-EXISTS
                REINPUT *4038
              WHEN NONE IGNORE
            END-DECIDE
            IF EOMRPM-LAYOUT-COLFROM(*,*) NE 0
              #LAYOUT-EXISTS := TRUE
            ELSE
              #LAYOUT-EXISTS := FALSE
            END-IF
          END-IF
          RESET #POS
        VALUE REPORT-PRINTING-ATTRIBUTES
          IF #ACTIVE-HELP AND EOMRPM-SEPARATOR-COPIES = 0
            EOMRPM-SEPARATOR-COPIES := 1
          END-IF
          IF #MARK2 = 0 /*SU14
            #MARK2 := #POS
          END-IF
          IF #MARK2 = 0
            #MARK2 := POS(G-DIRECT-COMMAND)
          END-IF
          INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
            MARK #MARK2 USING MAP 'RDEFRPP&'
          RESET #MARK2 #POS
        VALUE REPORT-ADDITIONAL-PRINTERS
          IF #MARK-PR = 0
            #MARK-PR := POS(G-DIRECT-COMMAND)
          END-IF
          INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
            MARK #MARK-PR USING MAP 'RDEFRPX&'
          #MARK-PR := POS(G-DIRECT-COMMAND)
        VALUE REPORT-UNIX-ATTRIBUTES
          PERFORM #REPORT-UNIX-ATTRIBUTES
        VALUE REPORT-UNIX-NODE /*unix path
          PERFORM #REPORT-UNIX-NODE
        VALUE REPORT-JES-ATTRIBUTES
          IF #POS = 0
            #POS := POS(G-DIRECT-COMMAND)
          END-IF
          #OLD-CP :=#CODEPAGE :=EOMRPM-JES-CODEPAGE
          INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
            MARK #POS USING MAP 'RDEFRPJ&'
          RESET #POS
          PERFORM HANDLE-CODEPAGE /*SU14
          EOMRPM-JES-CODEPAGE := #CODEPAGE
/*SU21  VALUE REPORT-POWER-ATTRIBUTES
        VALUE REPORT-NAF-ATTRIBUTES /*Natural
          IF #POS = 0
            #POS := POS(G-DIRECT-COMMAND)
          END-IF
          INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
            MARK #POS USING MAP 'RDEFRPN&'
          RESET #POS
        VALUE REPORT-NOMUSR-ATTRIBUTES /*3GL
          PERFORM #REPORT-NOMUSR-ATTRIBUTES
          IF #ESC
            ESCAPE BOTTOM (FIND-LOOP.)
          END-IF
        VALUE REPORT-CMA-ATTRIBUTES
          IF #POS = 0
            #POS := POS(G-DIRECT-COMMAND)
          END-IF
          INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
            MARK #POS USING MAP 'RDEFRPC&'
          RESET #POS
        VALUE REPORT-BS2-ATTRIBUTES
          IF #POS = 0
            #POS := POS(G-DIRECT-COMMAND)
          END-IF
          #OLD-CP :=#CODEPAGE :=EOMRPM-BS2-CODEPAGE
          INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
            MARK #POS USING MAP 'RDEFRPB&'
          RESET #POS
          PERFORM HANDLE-CODEPAGE /*SU14
          EOMRPM-BS2-CODEPAGE := #CODEPAGE
        VALUE REPORT-SEPARATION-ATTRIBUTES
          PERFORM #REPORT-SEPARATION-ATTRIBUTES
        NONE VALUE
          IF #POS = 0
            #POS := POS(G-DIRECT-COMMAND)
          END-IF
          INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
            MARK #POS USING MAP 'RDEFRPG&'
          RESET #POS
      END-DECIDE
      RESET G-NATRP-ERC G-NATRP-ERT
      IF #FUNC = 'A'
        IF G-DISPLAY-LONG-NAMES
          #REPORT := #REPORT-M
        ELSE
          #REPORT := #REPORT-17
        END-IF
      END-IF
*
      INCLUDE RPFKVA-C
      INCLUDE C-DIRECT
*
      IF G-PF-FUNC ='UNDO' OR='DO'
        RESET EOM-LOG-FUNCTION
      END-IF
*
      INCLUDE RPFKED-C
*
      RESET READ-RECORD
      IF (CV-MAP MODIFIED OR CV-KEY MODIFIED OR CV-FILES MODIFIED
      OR CV-UNIX-FILES MODIFIED OR CV-UNIX MODIFIED OR CV-OWN MODIFIED/*
      OR CV-NOMDB MODIFIED OR CV-NODE MODIFIED OR CV-IDENT MODIFIED   /*
      OR (L-MARK-CV (*) MODIFIED AND NOT #PATH-NOT-CHANGED)           /*
      OR G-MAP-MODIFIED  OR CV-TYPE MODIFIED) AND #FUNC NE 'D'        /*
      OR #DEF-USER OR #ANY-ERROR                                      /*
        RESET #ANY-ERROR
        PERFORM CHECK-ACTIVE-HELP
        IF G-NATRP-ERC NE 0 OR #ANY-WILDCARD
          ESCAPE TOP
        END-IF
        IF #CHK-USER
          RESET #DEF-USER
        END-IF
        PERFORM CHECK-USERID
        IF #DEF-USER
          G-NATRP-ERC := 0509
          ESCAPE TOP
        END-IF
        EOMRPM-I-NAME := #REPORT
        EOMRPM-I-ATTRIBUTE-TYPE := #PANEL
        IF #FUNC = 'A'
          EOM-FUNCTION := EOM-ADD
          READ-RECORD := TRUE
        ELSE
          EOM-FUNCTION := EOM-MODIFY
        END-IF
*
        RESET EOMMSG-PARMS #UNIX-NODE-SEL
        CALLNAT 'EOMRPM-N' EOM-PARMS EOMRPM-PARMS EOMMSG-PARMS
        IF EOMMSG-NR = 9876 /*set in EOMRPM-N
          EOMMSG-NR := 0
          #UNIX-NODE-SEL := TRUE
        END-IF
        IF #PANEL = REPORT-GENERAL-ATTRIBUTES AND (#IDENT-CHANGED                                           /*
        OR (G-MAP-MODIFIED AND #UNIX))                                /*
          IF #UNIX /*SU15 ->
            #UNIX-NODENAME := #NODENAME
          ELSE
            RESET #UNIX-NODENAME
          END-IF /*SU15 <-
          CALLNAT 'RDEFRP-N' '-' #REPORT #LEAVE #UNIX-NODENAME
            #IDENT-NAME #IDENT-TYPE
          RESET #IDENT-CHANGED
        END-IF
        IF #PANEL = REPORT-UNIX-ATTRIBUTES
          #PATH-NOT-CHANGED := TRUE
        END-IF
*
        IF #PANEL = REPORT-UNIX-NODE
          #PANEL := REPORT-UNIX-ATTRIBUTES
          RESET  #LANGUAGE
          READ-RECORD := FALSE
          ESCAPE BOTTOM (SCREEN-LOOP.)
        END-IF
        IF EOMMSG-NR = 0
          IF EOM-FUNCTION = EOM-ADD
            G-NATRP-ERC := 31
            #FUNC := 'M'
            RESET #LANGUAGE
          ELSE
            G-NATRP-ERC := 32
          END-IF
          #DISTR-USERS(*) := EOMRPM-EOM-USER-LIST(*)
          #OWNER          := EOMRPM-MASTER-OWNER
        ELSE
          PERFORM CHECK-ERROR-CODE
          IF EOMMSG-NR NE 0
            G-NATRP-ERC := EOMMSG-NR
            COMPRESS EOMMSG-TOKEN (*) TO G-NATRP-ERT
            RESET EOMMSG-NR EOMMSG-TOKEN (*)
            ESCAPE TOP
          END-IF
        END-IF
*
        IF *PF-KEY NE 'PF11' AND #UNIX-NODE-SEL = FALSE
          INCLUDE C-COMMIT
        END-IF
      END-IF
*
      INCLUDE REXDO--C
*
      DECIDE ON FIRST VALUE OF G-PF-FUNC
        VALUE ##PFK-EXIT-SUBFUNC
          DECIDE FOR FIRST CONDITION
            WHEN IN-LAYOUT
              RESET #LANGUAGE IN-LAYOUT
            WHEN IN-PARAM
              IN-PARAM := FALSE
              RESET #LANGUAGE
            WHEN NONE
              IF #PANEL NE REPORT-GENERAL-ATTRIBUTES
                DECIDE ON FIRST VALUE OF #PANEL
                  VALUE REPORT-ADDITIONAL-PRINTERS
                    #PANEL := REPORT-PRINTING-ATTRIBUTES
                  VALUE REPORT-UNIX-NODE
                    #PANEL := REPORT-UNIX-ATTRIBUTES
                  NONE VALUE
                    #PANEL := REPORT-GENERAL-ATTRIBUTES
                END-DECIDE
                RESET #LANGUAGE
                READ-RECORD := TRUE
              END-IF
          END-DECIDE
        VALUE ##PFK-REPORT-DIST
          IF #PANEL NE REPORT-DISTRIBUTION-ATTRIBUTES
            IN-LAYOUT := FALSE
            #PANEL := REPORT-DISTRIBUTION-ATTRIBUTES
            RESET #LANGUAGE
            READ-RECORD := TRUE
          END-IF
        VALUE ##PFK-DOWN
          ADD 1 TO #L-I
          IF #L-I > 10 OR EOMRPM-EOM-USER-LIST (#L-I) = ' '
            SUBTRACT 1 FROM #L-I
          END-IF
        VALUE ##PFK-UP
          IF #L-I > 1
            SUBTRACT 1 FROM #L-I
          END-IF
        VALUE ##PFK-LAYOUT
          IF EOMRPM-EOM-USER-LIST (*) NE ' '
            IN-LAYOUT := TRUE
            RESET #LANGUAGE
            PERFORM LAYOUT-ENTRY
          END-IF
        VALUE ##PFK-REPORT-PRINT
          IF #PANEL NE REPORT-PRINTING-ATTRIBUTES
            #PANEL := REPORT-PRINTING-ATTRIBUTES
            RESET #LANGUAGE
            READ-RECORD := TRUE
          END-IF
        VALUE ##PFK-ADDNAL-PRINTERS
          #PANEL := REPORT-ADDITIONAL-PRINTERS
          RESET #LANGUAGE
          READ-RECORD := TRUE
        VALUE ##PFK-UNIX-NODE
          #PANEL := REPORT-UNIX-NODE
          RESET #LANGUAGE
          READ-RECORD := FALSE
        VALUE ##PFK-REPORT-IDENT
          PERFORM GET-IDENT-PANEL
          RESET #LANGUAGE
          READ-RECORD := TRUE
        VALUE ##PFK-REPORT-SEPAR
          IF #PANEL NE REPORT-SEPARATION-ATTRIBUTES
            #PANEL := REPORT-SEPARATION-ATTRIBUTES
            RESET #LANGUAGE
            READ-RECORD := TRUE
          END-IF
        VALUE ##PFK-REPORT-EXITPARM
          IN-PARAM := TRUE
          RESET #LANGUAGE
        VALUE ##PFK-TRACE
          PERFORM TRACE-REPORT-PROCESSING
        VALUE ##PFK-EDIT
          PERFORM EDIT-SEPARATOR_EXIT
          IF G-LANGUAGE NE *LANGUAGE
            *LANGUAGE := G-LANGUAGE
          END-IF
        VALUE ##PFK-DISPLAY-LONG-NAMES
          IF G-DISPLAY-LONG-NAMES
            G-DISPLAY-LONG-NAMES := FALSE
          ELSE
            G-DISPLAY-LONG-NAMES := TRUE
          END-IF
          READ-RECORD := TRUE
        VALUE ##PFK-RIGHT
          IF #I-BUN < 5
            #I-BUN := #I-BUN + 1
            READ-RECORD := TRUE
          END-IF
        VALUE ##PFK-LEFT
          IF #I-BUN > 1
            #I-BUN := #I-BUN - 1
            READ-RECORD := TRUE
          END-IF
        NONE  IGNORE
      END-DECIDE
*
      IF READ-RECORD = TRUE
        ESCAPE BOTTOM (FIND-LOOP.)
      END-IF
*
    END-REPEAT /*(SCREEN-LOOP.)
  END-REPEAT /*(FIND-LOOP.)
END-REPEAT /*(MAIN-LOOP.)
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE CHECK-ACTIVE-HELP
************************************************************************
CALLNAT 'RGETLIB' #EDIT-LIB2
COMPRESS #EDIT-LIB2 'U' TO #EDIT-LIB2 LEAVING NO
RESET #ACTIVE-HELP    /* NOMALL-1655
DECIDE ON FIRST #PANEL
  VALUE REPORT-GENERAL-ATTRIBUTES
    DECIDE FOR FIRST CONDITION
      WHEN EOMRPM-MASTER-OWNER = SCAN '*'
        REINPUT USING HELP MARK *EOMRPM-MASTER-OWNER
      WHEN EOMRPM-RET-CALENDAR = SCAN '*'
        REINPUT USING HELP MARK *EOMRPM-RET-CALENDAR
      WHEN EOMRPM-REV-CALENDAR = SCAN '*'
        REINPUT USING HELP MARK *EOMRPM-REV-CALENDAR
      WHEN EOMRPM-ARCHIVE-TYPE = SCAN '*'
        REINPUT USING HELP MARK *EOMRPM-ARCHIVE-TYPE
      WHEN EOMRPM-KEYWORDS (*) = SCAN '*' /*SU20
        FOR #I 1 *OCC(EOMRPM-KEYWORDS)
          IF EOMRPM-KEYWORDS (#I) = SCAN '*'
            REINPUT FULL USING HELP MARK *EOMRPM-KEYWORDS (#I)
          END-IF
        END-FOR
      WHEN NONE IGNORE
    END-DECIDE
  VALUE REPORT-DISTRIBUTION-ATTRIBUTES
    FOR H = 1 TO 10
      IF EOMRPM-EOM-USER-LIST (H) = SCAN '*'
        REINPUT USING HELP MARK *EOMRPM-EOM-USER-LIST (H)
      END-IF
    END-FOR
  VALUE REPORT-PRINTING-ATTRIBUTES
    FOR H = 1 TO 5
      IF EOMRPM-PRINTER (H) = SCAN '*'
        REINPUT USING HELP MARK *EOMRPM-PRINTER (H)
      END-IF
    END-FOR
/*SU5 -> new coding - old coding removed
    CALLNAT 'N-SEPMEM' EOMRPM-PARMS.EOMRPM-SEPARATOR-START #OLD-SEPSTART
      'S' 'R' #ANY-WILDCARD #ACTIVE-HELP G-NATRP-ERC G-NATRP-ERT
    IF G-NATRP-ERC NE 0
      #MARK2      := POS(EOMRPM-SEPARATOR-START) /*12
      #ANY-ERROR  := TRUE
      ESCAPE ROUTINE
    END-IF
    CALLNAT 'N-SEPMEM' EOMRPM-PARMS.EOMRPM-SEPARATOR-END #OLD-SEPEND
      'S' 'R' #ANY-WILDCARD #ACTIVE-HELP G-NATRP-ERC G-NATRP-ERT
    IF G-NATRP-ERC NE 0
      #MARK2      := POS(EOMRPM-SEPARATOR-END) /*13
      #ANY-ERROR  := TRUE
      ESCAPE ROUTINE
    END-IF
/*SU5 <-
  VALUE REPORT-SEPARATION-ATTRIBUTES
    #NATPGM := EOMRPM-PARMS.EOMRPM-EXIT-USER-NATPGM
    IF EOMRPM-PARMS.EOMRPM-EXIT-USER-NATPGM NE ' '
      IF EOMRPM-PARMS.EOMRPM-EXIT-USER-NATLIB NE #OLD-EXITLIB
      OR EOMRPM-PARMS.EOMRPM-EXIT-USER-NATPGM NE #OLD-EXITMEM         /*
        IF EOMRPM-PARMS.EOMRPM-EXIT-USER-NATPGM
            = SCAN '*' OR = SCAN '?' OR = SCAN '<' OR = SCAN '>'
          #ANY-WILDCARD:= TRUE
        END-IF
        #MEMBER-TYPE:= 'SEPEXIT '
        CALLNAT 'N-LISMEM' EOMRPM-PARMS.EOMRPM-EXIT-USER-NATLIB
          EOMRPM-PARMS.EOMRPM-EXIT-USER-NATPGM
          #MEMBER-TYPE G-NATRP-ERC G-NATRP-ERT
        #OLD-EXITLIB := EOMRPM-PARMS.EOMRPM-EXIT-USER-NATLIB
        #OLD-EXITMEM := EOMRPM-PARMS.EOMRPM-EXIT-USER-NATPGM
        #POS := POS(EOMRPM-PARMS.EOMRPM-EXIT-USER-NATPGM)
        IF G-NATRP-ERC = 1052
          G-NATRP-ERC := 1079
          G-NATRP-ERT := EOMRPM-PARMS.EOMRPM-EXIT-USER-NATPGM
          #POS        := 3
          #ANY-ERROR  := TRUE
          EOMRPM-PARMS.EOMRPM-EXIT-USER-NATPGM := #NATPGM
          ESCAPE ROUTINE
        END-IF
        IF G-NATRP-ERC = 1070
          RESET G-NATRP-ERC G-NATRP-ERT
          EOMRPM-PARMS.EOMRPM-EXIT-USER-NATPGM := #NATPGM
        END-IF
      END-IF
    END-IF
  VALUE REPORT-ADDITIONAL-PRINTERS
    FOR H = 6 TO 20
      IF EOMRPM-PRINTER (H) = SCAN '*'
        REINPUT USING HELP MARK *EOMRPM-PRINTER (H)
      END-IF
    END-FOR
  NONE VALUE
    IGNORE
END-DECIDE
*
END-SUBROUTINE /* CHECK-ACTIVE-HELP
*
************************************************************************
DEFINE SUBROUTINE CHECK-ERROR-CODE
************************************************************************
DECIDE ON FIRST EOMMSG-NR /*SU15 all REINPUT removed to #POS := ..
  VALUE 0002
    #ANY-ERROR := TRUE
    G-NATRP-ERT := EOMMSG-TOKEN (1)
    IF EOMMSG-FIELD-NAME = 'EOMRPM-MASTER-OWNER'
      #POS := POS(EOMRPM-MASTER-OWNER)
    ELSE
      #POS := POS(EOMRPM-EOM-USER-LIST (EOMMSG-IND1))
    END-IF
  VALUE 0019, 0304, 0305 #POS := POS(#REPORT-M)
  VALUE 0108, 1090       #POS := POS( EOMRPM-PRINTER (EOMMSG-IND1))
  VALUE 0415
    IF EOMMSG-FIELD-NAME = 'EOMRPM-RET-NUMBER'
      #POS := POS(EOMRPM-RET-NUMBER)
    ELSE
      #POS := POS(EOMRPM-REV-NUMBER)
    END-IF
  VALUE 0423
    #ANY-ERROR  := TRUE
    IF EOMMSG-FIELD-NAME = 'EOMRPM-SEPARATOR-START'
      #MARK2 := POS(EOMRPM-SEPARATOR-START) /*12
    ELSE
      #MARK2 := POS(EOMRPM-SEPARATOR-END) /*13
    END-IF
  VALUE 0641
    IF EOMMSG-FIELD-NAME = 'EOMRPM-INTERNAL-NODE'
      #POS := POS(#NODENAME)
    END-IF
  VALUE 0651, 0667
    IF EOMMSG-FIELD-NAME = 'EOMRPM-STD1-IDENT-STRING'
      #POS := POS(EOMRPM-STD1-IDENT-STRING)
    ELSE
      #POS := POS(EOMRPM-STD2-IDENT-STRING)
    END-IF
  VALUE 0104 #POS := POS(EOMRPM-PRINTER(EOMMSG-IND1))
  VALUE 0653
    DECIDE ON FIRST EOMMSG-FIELD-NAME
      VALUE 'EOMRPM-STD1-BREAK-START'
        #POS := POS(EOMRPM-STD1-BREAK-START)
      VALUE 'EOMRPM-STD1-BREAK-END'
        #POS := POS(EOMRPM-STD1-BREAK-END)
      VALUE 'EOMRPM-STD2-BREAK-START'
        #POS := POS(EOMRPM-STD2-BREAK-START (EOMMSG-IND1))
      VALUE 'EOMRPM-STD2-BREAK-END'
        #POS := POS(EOMRPM-STD2-BREAK-END (EOMMSG-IND1))
      VALUE 'EOMRPM-STD3-VALUE-FROM'
        #POS := POS(EOMRPM-STD3-VALUE-FROM (EOMMSG-IND1))
      VALUE 'EOMRPM-STD3-VALUE-TO'
        #POS := POS(EOMRPM-STD3-VALUE-TO (EOMMSG-IND1))
      NONE IGNORE /* REINPUT *EOMMSG-NR
    END-DECIDE
  VALUE 0654
    DECIDE ON FIRST EOMMSG-FIELD-NAME
      VALUE 'EOMRPM-STD1-BREAK-END'
        #POS := POS(EOMRPM-STD1-BREAK-END)
      VALUE 'EOMRPM-STD2-BREAK-END'
        #POS := POS(EOMRPM-STD2-BREAK-END (EOMMSG-IND1))
      VALUE 'EOMRPM-STD3-VALUE-TO'
        #POS := POS(EOMRPM-STD3-VALUE-TO (EOMMSG-IND1))
      NONE IGNORE /* REINPUT *EOMMSG-NR
    END-DECIDE
  VALUE 0655
    IF EOMMSG-FIELD-NAME = 'EOMRPM-STD1-REPORT-PREFIX'
      #POS := POS(EOMRPM-STD1-REPORT-PREFIX)
    ELSE
      #POS := POS(EOMRPM-STD2-REPORT-PREFIX (EOMMSG-IND1))
    END-IF
  VALUE 0656       #POS := POS(EOMRPM-STD2-BREAK-LINE (EOMMSG-IND1))
  VALUE 0670, 0671 #POS := POS(EOMRPM-STD3-IDENT-LINE)
  VALUE 0672, 0673 #POS := POS(EOMRPM-STD3-HEADER-LINES)
  VALUE 0674       #POS := POS(EOMRPM-STD3-REL-CHARACTER (EOMMSG-IND1))
  VALUE 0675, 0676 #POS := POS(EOMRPM-STD3-VALUE (EOMMSG-IND1))
  VALUE 0677       #POS := POS(EOMRPM-STD3-VALUE-TYPE (EOMMSG-IND1))
  VALUE 0678       #POS := POS(EOMRPM-STD3-BOOL-CONNECTOR (EOMMSG-IND1))
  VALUE 1079
    #POS := 3
    #ANY-ERROR  := TRUE
  VALUE 1080
    #POS := 4
    #ANY-ERROR  := TRUE
  VALUE 1081 #POS := POS(EOMRPM-EXIT-USER-3GL)
  VALUE 1083 #POS := POS(EOMRPM-ARC-FACTOR)
  VALUE 1084, 1085
    #POS := POS(EOMRPM-LAYOUT-COLFROM (EOMMSG-IND1, EOMMSG-IND2))
  VALUE 1086
    #POS := POS(EOMRPM-LAYOUT-COLTO (EOMMSG-IND1, EOMMSG-IND2))
  VALUE 1087
    IF EOMMSG-FIELD-NAME = 'EOMRPM-REV-FACTOR'
      #POS := POS(EOMRPM-REV-FACTOR)
    ELSE
      #POS := POS(EOMRPM-RET-FACTOR)
    END-IF
  VALUE 1088 #POS := POS(EOMRPM-RET-ACTION)
  VALUE 1091
    G-NATRP-ERT := EOMMSG-TOKEN (1)
    #POS := POS(EOMRPM-EOM-USER-LIST (EOMMSG-IND1))
  VALUE 1093, 1095, 1096, 1097
    G-NATRP-ERT := EOMMSG-TOKEN (1)
    #POS := POS(EOMRPM-JES-FILES (EOMMSG-IND1))
  VALUE 1099
    DECIDE ON FIRST VALUE OF EOMMSG-FIELD-NAME
      VALUE 'EOMRPM-STORE-IN-DIRECTORY-FILE'
        #POS := POS(EOMRPM-STORE-IN-DIRECTORY-FILE)
      VALUE 'EOMRPM-CREATE-DEFINITION'
        #POS := POS(EOMRPM-CREATE-DEFINITION)
      NONE IGNORE
    END-DECIDE
  VALUE 1101, 1102, 1103 #POS := POS(EOMRPM-REPORT-TYPE)
  VALUE 1104             #POS := POS(EOMRPM-JES-JOB-NAME)
  VALUE 1105
    G-NATRP-ERT := EOMMSG-TOKEN (1)
    #POS := POS(EOMRPM-JES-FILES (EOMMSG-IND1))
  VALUE 1108, 1109       #POS := POS(EOMRPM-ARCHIVE-TYPE)
  VALUE 2003
    IF EOMMSG-FIELD-NAME = 'EOMRPM-REV-CALENDAR'
      #POS := POS(EOMRPM-REV-CALENDAR)
    ELSE
      #POS := POS(EOMRPM-RET-CALENDAR)
    END-IF
  VALUE 2004
    IF EOMMSG-FIELD-NAME = 'EOMRPM-RET-CALENDAR'
      #POS := POS(EOMRPM-RET-CALENDAR)
    ELSE
      #POS := POS(EOMRPM-REV-CALENDAR)
    END-IF
  VALUE 1107             #POS := POS(EOMRPM-ARCHIVE)
  VALUE 1598 /*Unknown codepage :1:
    G-NATRP-ERC := EOMMSG-NR
    G-NATRP-ERT := EOMMSG-TOKEN(1)
    #POS := POS(#CODEPAGE)
  VALUES 2020 : 2049
    DECIDE ON FIRST VALUE OF EOMMSG-FIELD-NAME
      VALUE 'EOMRPM-UNIX-FILES'
        IF EOMMSG-TOKEN (1) IS (N2)
          #I := VAL (EOMMSG-TOKEN (1))
          IF #I < 1 OR #I > 10
            #I := 1
          END-IF
        END-IF
        RESET EOMMSG-TOKEN (1)
        #POS := POS(EOMRPM-UNIX-FILES (#I))
      VALUE 'EOMRPM-UNIX-PATH'
        #POS := POS(EOMRPM-UNIX-PATH)
      NONE
        #POS := POS(EOMRPM-UNIX-NODENAME)
    END-DECIDE
  VALUE 1114
    DECIDE ON FIRST VALUE OF EOMMSG-FIELD-NAME
      VALUE 'EOMRPM-JES-FILES'
        #POS := POS(EOMRPM-JES-FILES(EOMMSG-IND1))
      VALUE 'EOMRPM-BS2-FILES'
        #POS := POS(EOMRPM-BS2-FILES(EOMMSG-IND1))
      VALUE 'EOMRPM-UNIX-FILES'
        #POS := POS(EOMRPM-UNIX-FILES(EOMMSG-IND1))
      VALUE 'EOMRPM-NOMUSR-FILES'
        #POS := POS(EOMRPM-NOMUSR-FILES(EOMMSG-IND1))
      NONE IGNORE
    END-DECIDE
  VALUE 1115 #POS := POS(EOMRPM-JES-FILES(EOMMSG-IND1))
  VALUE 1116 #POS := POS(EOMRPM-JES-FILES(EOMMSG-IND1))
  ANY
    G-NATRP-ERC := EOMMSG-NR
    ESCAPE TOP
  NONE
    IF EOMMSG-NR NE 0 /*instead IGNORE SU19
      REINPUT *EOMMSG-NR,EOMMSG-TOKEN(1),EOMMSG-TOKEN(2),EOMMSG-TOKEN(3)
    END-IF
END-DECIDE /*ON FIRST EOMMSG-NR
*
END-SUBROUTINE /* CHECK-ERROR-CODE
*
************************************************************************
DEFINE SUBROUTINE LAYOUT-ENTRY
************************************************************************
#L-I := *CURS-COL - 24
DIVIDE 9 INTO #L-I REMAINDER #REM
IF #REM = 0
  REINPUT *1200
END-IF
#L-I := #L-I + ((*CURS-LINE - 9) * 5) + 1
IF NOT (#L-I = 1 THRU 10) OR EOMRPM-EOM-USER-LIST (#L-I) = ' '
  REINPUT *1200
END-IF
*
END-SUBROUTINE /* LAYOUT-ENTRY
*
************************************************************************
DEFINE SUBROUTINE NOMUSR-INIT
************************************************************************
#NOMUSR-INTERFACE := EOMRPM-NOMUSR-INTERFACE
CALLNAT 'RSELUSRN' NRM-MONITOR
#NOMUSR-PROMPT-FILES := NRM-MONITOR.#NOMUSR-PROMPT (5)
*
END-SUBROUTINE /* NOMUSR-INIT
*
************************************************************************
DEFINE SUBROUTINE INIT-PFKEYS
************************************************************************
RESET G-PF
*
INCLUDE RPFSTD-C
*
DECIDE FOR EVERY CONDITION
  WHEN #PANEL = REPORT-GENERAL-ATTRIBUTES
    INCLUDE RPFADD-C
  WHEN #PANEL = REPORT-GENERAL-ATTRIBUTES AND #FUNC NE 'A'
  OR #PANEL = REPORT-DISTRIBUTION-ATTRIBUTES OR = REPORT-UNIX-ATTRIBUTES
  OR= REPORT-PRINTING-ATTRIBUTES OR= REPORT-ADDITIONAL-PRINTERS       /*
  OR= REPORT-JES-ATTRIBUTES      OR= REPORT-NOMUSR-ATTRIBUTES         /*
  OR= REPORT-NAF-ATTRIBUTES      OR= REPORT-SEPARATION-ATTRIBUTES     /*
  OR= REPORT-CMA-ATTRIBUTES      OR= REPORT-BS2-ATTRIBUTES            /*
/*SU21  OR= REPORT-POWER-ATTRIBUTES
    INCLUDE RPFCOM-C
  WHEN #PANEL = REPORT-GENERAL-ATTRIBUTES AND #FUNC NE 'A'
    INCLUDE RPFRPD-C
    INCLUDE RPFRPP-C
  WHEN #PANEL = REPORT-GENERAL-ATTRIBUTES AND #FUNC NE 'A'
  AND EOMRPM-REPORT-TYPE NE 'C'                                       /*
    INCLUDE RPFRPI-C
    INCLUDE RPFRPS-C
  WHEN #PANEL =REPORT-DISTRIBUTION-ATTRIBUTES
  OR= REPORT-PRINTING-ATTRIBUTES OR= REPORT-ADDITIONAL-PRINTERS       /*
  OR= REPORT-JES-ATTRIBUTES      OR= REPORT-NOMUSR-ATTRIBUTES         /*
  OR= REPORT-NAF-ATTRIBUTES      OR= REPORT-CMA-ATTRIBUTES            /*
  OR= REPORT-BS2-ATTRIBUTES      OR= REPORT-SEPARATION-ATTRIBUTES     /*
  OR= REPORT-UNIX-ATTRIBUTES     OR= REPORT-UNIX-NODE                 /*
/*SU21 OR=REPORT-POWER-ATTRIBUTES
    INCLUDE RPFESF-C
  WHEN (#PANEL = REPORT-GENERAL-ATTRIBUTES AND #FUNC = 'A')
  OR #PANEL=REPORT-DISTRIBUTION-ATTRIBUTES OR=REPORT-UNIX-ATTRIBUTES  /*
  OR= REPORT-PRINTING-ATTRIBUTES           OR=REPORT-ADDITIONAL-PRINTERS
  OR= REPORT-NOMUSR-ATTRIBUTES             OR=REPORT-NAF-ATTRIBUTES   /*
  OR= REPORT-CMA-ATTRIBUTES                                           /*
  OR (#PANEL = REPORT-SEPARATION-ATTRIBUTES AND IN-PARAM)             /*
    INCLUDE RPFEXT-C
  WHEN #PANEL = REPORT-PRINTING-ATTRIBUTES
  OR (#PANEL = REPORT-SEPARATION-ATTRIBUTES AND NOT IN-PARAM)         /*
    INCLUDE RPFEDT-C
  WHEN #PANEL = REPORT-PRINTING-ATTRIBUTES
    INCLUDE RPFAPR-C
/*SU13  WHEN #PANEL =REPORT-JES-ATTRIBUTES OR=REPORT-POWER-ATTRIBUTES OR
/*SU13     = REPORT-BS2-ATTRIBUTES INCLUDE RPFNAT-C INCLUDE RPFUSR-C
/*SU13 INCLUDE RPFUNX-C
/*SU13  WHEN #PANEL = REPORT-JES-ATTRIBUTES OR = REPORT-POWER-ATTRIBUTES
/*SU13    INCLUDE RPFCMA-C
  WHEN #PANEL = REPORT-DISTRIBUTION-ATTRIBUTES AND IN-LAYOUT
    INCLUDE RPFBRW-C
  WHEN #PANEL = REPORT-DISTRIBUTION-ATTRIBUTES AND NOT IN-LAYOUT
    INCLUDE RPFRPL-C
  WHEN #PANEL = REPORT-SEPARATION-ATTRIBUTES AND IN-PARAM
  AND G-SUPPORT-LONG-NAMES AND EOMRPM-EXIT-STANDARD = 2               /*
    INCLUDE RPFLR--C
  WHEN #PANEL = REPORT-SEPARATION-ATTRIBUTES AND NOT IN-PARAM
    INCLUDE RPFREP-C
    INCLUDE RPFTRA-C
  WHEN  #PANEL = REPORT-UNIX-ATTRIBUTES
    INCLUDE RPFUX2-C /*unix node
  WHEN NONE
    #PANEL := REPORT-GENERAL-ATTRIBUTES
END-DECIDE
SET KEY PF01=HELP NAMED G-PF-TEXT (1)
SET KEY PF13=HELP NAMED G-PF-TEXT (1)
*
CALLNAT 'RPFINI-N' G-PF G-PFB
*
END-SUBROUTINE /* INIT-PFKEYS
*
************************************************************************
DEFINE SUBROUTINE TRACE-REPORT-PROCESSING
************************************************************************
IF EOMRPM-EXIT-STANDARD NE 0
  G-NATRP-ERC := 4114
  ESCAPE ROUTINE
END-IF
IF EOMRPM-EXIT-USER-NATPGM = ' ' OR EOMRPM-EXIT-USER-NATLIB = ' '
  G-NATRP-ERC := 4101
  ESCAPE ROUTINE
END-IF
*
PERFORM COMMIT-WORK
STACK TOP DATA FORMATTED #FUNC #REPORT #PANEL
STACK TOP COMMAND 'RDEFRP'
STACK TOP DATA FORMATTED #REPORT
STACK TOP COMMAND 'RTRARP'
FETCH RETURN 'NRMPUTAI'
STACK TOP COMMAND 'NRMPUTGL'
STOP /* =====> STOP ÜÜ
*
END-SUBROUTINE /* TRACE-REPORT-PROCESSING
*
************************************************************************
DEFINE SUBROUTINE EDIT-SEPARATOR_EXIT
************************************************************************
#CURS-FIELD := *CURS-FIELD
#POS-START  := POS(EOMRPM-SEPARATOR-START)
#POS-END    := POS(EOMRPM-SEPARATOR-END)
#POS-EXIT-MEMBER := POS(EOMRPM-EXIT-USER-NATPGM)
#POS-EXIT-LIB    := POS(EOMRPM-EXIT-USER-NATLIB)
PERFORM S-SEPEDT #PROG #CURS-FIELD #POS-START EOMRPM-SEPARATOR-START
  #POS-END EOMRPM-SEPARATOR-END #POS-EXIT-MEMBER #POS-EXIT-LIB
  EOMRPM-EXIT-USER-NATPGM EOMRPM-EXIT-USER-NATLIB 1X #FUNC #REPORT
  #PANEL
RESET INITIAL #PROG /*SU 2019-02
IF G-NATRP-ERC NE 0
  IF #PANEL = REPORT-SEPARATION-ATTRIBUTES
    #POS := #POS-START
  ELSE
    #MARK2 := #POS-START
  END-IF
  IF G-MAP-MODIFIED
    #ANY-WILDCARD := TRUE /*avoid RESET G-MAP-MODIFIED (see above)
  END-IF
  ESCAPE TOP
END-IF
*
END-SUBROUTINE /* EDIT-SEPARATOR_EXIT
*
************************************************************************
DEFINE SUBROUTINE INIT-TEXT
************************************************************************
#LAN-IDENT (1) := ##TXT-OR
*
FOR I = 1 TO 1
  CALLNAT 'RLTINI-N' #LAN-IDENT (I) #LAN-TEXT  (I) G-TXB
END-FOR
*
END-SUBROUTINE /* INIT-TEXT
*
************************************************************************
DEFINE SUBROUTINE CHECK-USERID
************************************************************************
IF #DEF-USER
  RESET #DEF-USER
  ESCAPE ROUTINE
END-IF
DECIDE ON FIRST VALUE OF #PANEL
  VALUE  REPORT-GENERAL-ATTRIBUTES
    IF EOMRPM-MASTER-OWNER NE #OWNER
      CALLNAT 'RCHKUS' EOMRPM-PARMS.EOMRPM-MASTER-OWNER #EXIST
      IF NOT #EXIST
        IF #AUTODEF = 'P'
          RESET #YES
          #DEF-USER := TRUE
          CALLNAT 'Y-OR-N' EOMRPM-MASTER-OWNER #YES
        END-IF
        IF #AUTODEF = 'Y' OR (#AUTODEF = 'P' AND #YES)
          EOMRPM-DEF-OWNER := 'Y'
          #OWNER := EOMRPM-MASTER-OWNER
          RESET #CHK-USER
        ELSE
          IF #AUTODEF = 'P' AND #YES = FALSE
            #CHK-USER := TRUE
          END-IF
        END-IF
      END-IF
    END-IF
  VALUE REPORT-DISTRIBUTION-ATTRIBUTES
    IF EOMRPM-EOM-USER-LIST(*) NE ' '
      FOR I = 1 10
        IF EOMRPM-EOM-USER-LIST(I) = ' '
          ESCAPE TOP
        END-IF
        IF #DISTR-USERS(I) NE EOMRPM-EOM-USER-LIST(I)
          CALLNAT 'RCHKUL' EOMRPM-EOM-USER-LIST(I) #EXIST
          IF NOT #EXIST
            IF #AUTODEF = 'P'
              #DEF-USER := TRUE
              CALLNAT 'Y-OR-N' EOMRPM-EOM-USER-LIST(I) #YES
            END-IF
            IF #AUTODEF = 'Y' OR (#AUTODEF = 'P' AND #YES)
              EOMRPM-DEF-EOM-USER-LIST (I) := 'Y'
              #DISTR-USERS(I) := EOMRPM-EOM-USER-LIST(I)
              RESET #CHK-USER
            ELSE
              IF #AUTODEF = 'P' AND #YES = FALSE
                #CHK-USER := TRUE
                ESCAPE BOTTOM
              END-IF
            END-IF
          END-IF
        ELSE
          EOMRPM-DEF-EOM-USER-LIST(I) := 'Y'
        END-IF
      END-FOR
    END-IF
  NONE VALUE IGNORE
END-DECIDE
*
END-SUBROUTINE /* CHECK-USERID
*
************************************************************************
DEFINE SUBROUTINE CHECK-STD-ROUTINE /*SU3 -> subroutine
************************************************************************
#CHCKFLD := EOMRPM-EXIT-STANDARD
IF NOT(#CHCKFLD IS (N2)) /*reject negative value /*SU3
  G-NATRP-ERC := 0658
  #POS := POS(EOMRPM-EXIT-STANDARD)
  ESCAPE TOP
END-IF
DECIDE FOR FIRST CONDITION
  WHEN EOMRPM-EXIT-STANDARD =1 THRU 3
    IF *PF-KEY NE 'PF9' AND *PF-KEY NE 'PF3' AND *PF-KEY NE 'PF12'
    AND EOMRPM-STD1-IDENT-LINE =0 AND EOMRPM-STD1-IDENT-STRING =' '   /*
    AND EOMRPM-STD2-IDENT-LINE =0 AND EOMRPM-STD2-IDENT-STRING =' '   /*
    AND EOMRPM-STD3-IDENT-LINE =0 AND EOMRPM-STD3-IDENT-STRING =' '   /*
      G-NATRP-ERC := 0657
      ESCAPE TOP
    END-IF
  WHEN EOMRPM-EXIT-STANDARD = 0
    IGNORE
  WHEN NONE
    G-NATRP-ERC := 0658
    #POS := POS(EOMRPM-EXIT-STANDARD)
    ESCAPE TOP
END-DECIDE
*
END-SUBROUTINE /* CHECK-STD-ROUTINE
*
************************************************************************
DEFINE SUBROUTINE GET-IDENT-PANEL
************************************************************************
PERFORM GET-SPOOL-PARAMS
IF #IDENT-NAME =' ' /*use default SPOOL TYPE:
  DECIDE FOR FIRST CONDITION
/*SU21 WHEN #SPOOL-TYPE = SCAN 'POWR' #PANEL := REPORT-POWER-ATTRIBUTES
    WHEN #SPOOL-TYPE=SCAN 'BS2' OR=SCAN 'SPOOL'
      #PANEL := REPORT-BS2-ATTRIBUTES
    WHEN #SPOOL-TYPE= 'UNIX' /*SU13
      #PANEL := REPORT-UNIX-ATTRIBUTES
    WHEN NONE
      #PANEL := REPORT-JES-ATTRIBUTES
  END-DECIDE
  #IDENT-TYPE := #PANEL
  CALLNAT 'RDEFRP-N' '#' G-C-REPORT #LEAVE #UNIX-NODENAME #IDENT-NAME
    #IDENT-TYPE /*get name
ELSE /*get type from name
  CALLNAT 'RDEFRP-N' '+' G-C-REPORT #LEAVE #UNIX-NODENAME #IDENT-NAME
    #IDENT-TYPE /*get type
  #PANEL := #IDENT-TYPE
END-IF
IF #FUNC = 'D'
  EOM-FUNCTION := EOM-READ
ELSE
  EOM-FUNCTION := EOM-MODIFY
END-IF
CALLNAT 'EOMRPM-N' EOM-PARMS EOMRPM-PARMS EOMMSG-PARMS
*
END-SUBROUTINE /* GET-IDENT-PANEL
*
************************************************************************
DEFINE SUBROUTINE GET-SPOOL-PARAMS
************************************************************************
RESET #SPOOL-CHANGE
IF #UNIX /*SU13
  #SPOOL-TYPE := 'UNIX'
/*????  #SYSTEM-TYPE := +NOD-LOCAL-SYSTEM-TYPE
ELSE
  PERFORM GET-NODE
  IF G-NATRP-ERC NE 0
    ESCAPE ROUTINE
  END-IF
END-IF
IF #SPOOL-TYPE NE #SPOOL-TYPE-OLD AND #SPOOL-TYPE-OLD NE ' '
  #SPOOL-CHANGE := TRUE
END-IF
#SPOOL-TYPE-OLD := #SPOOL-TYPE
*
END-SUBROUTINE /* GET-SPOOL-PARAMS
*
************************************************************************
DEFINE SUBROUTINE GET-NODE
************************************************************************
RESET #SPOOL-TYPE #SYSTEM-TYPE SYSTEM-INFO G-NATRP-ERC G-NATRP-ERT
IF #NODENAME = ' ' OR= +NOD-LOCAL-NAME /*monitor
  #SPOOL-TYPE  := +NOD-LOCAL-SPOOL-TYPE
  #SYSTEM-TYPE := +NOD-LOCAL-SYSTEM-TYPE
  #NODE-NR     := +NOD-LOCAL-NODE
  ESCAPE ROUTINE /*GET-NPR-NODE
END-IF
IF #UNIX
  ESCAPE ROUTINE
END-IF
COMPRESS 'R-' #NODENAME TO #M-MONITOR-ID LEAVING NO
FNDMON. FIND MF-NODE WITH MF-MONITOR-ID = #M-MONITOR-ID
  IF NO RECORDS FOUND
    G-NATRP-ERC := 2024
    #POS := POS(#NODENAME)
    ESCAPE BOTTOM (FNDMON.)
  END-NOREC
  #SPOOL-TYPE  := MF-SPOOL-TYPE
  #SYSTEM-TYPE := MF-SYSTEM-TYPE
  #NODE-NR     := MF-MONITOR-NODE
  #NODENAME    := SUBSTR(MF-MONITOR-ID,3)
END-FIND
*
END-SUBROUTINE /* GET-NODE
*
************************************************************************
DEFINE SUBROUTINE HANDLE-NODE
************************************************************************
IF #NODENAME = ' ' OR=+NOD-LOCAL-NAME
  IF CV-NODE MODIFIED
    G-MAP-MODIFIED := #ANY-WILDCARD:= TRUE
  END-IF
  RESET EOMRPM-INTERNAL-NODE-ID /*#NODE-NR
  #SPOOL-TYPE  := +NOD-LOCAL-SPOOL-TYPE
  IF #SPOOL-TYPE = 'UNIX'
    #UNIX := TRUE
  ELSE
    RESET #UNIX
  END-IF
  #SYSTEM-TYPE := +NOD-LOCAL-SYSTEM-TYPE
  ESCAPE ROUTINE
END-IF
RESET #SELECTED
IF #NODENAME = SCAN '*'
  CALLNAT 'HRSELUXN' ' ' #NODENAME
  IF #NODENAME = SCAN '*' /*nothing selected
    #NODENAME := #NODENAME-OLD
    ESCAPE TOP
  END-IF
  #SELECTED := TRUE
END-IF
IF (CV-NODE MODIFIED OR #SELECTED) AND #NODENAME NE ' '
  G-MAP-MODIFIED := #ANY-WILDCARD:= TRUE
  UX. FIND NUMBER UX-NODES WITH UX-NODE-NAME = #NODENAME
  IF *NUMBER (UX.) NE 0
    #UNIX := TRUE
    #SPOOL-TYPE := 'UNIX'
    RESET EOMRPM-INTERNAL-NODE-ID #NODE-NR
    G-NATRP-ERC := 9219 /*node changed: check path+files(PF7) SU19
    ESCAPE TOP /*INPUT again
  END-IF
  RESET #UNIX
  COMPRESS 'R-' #NODENAME TO #M-MONITOR-ID LEAVING NO
  FNDNOD1. FIND MF-NODE WITH MF-MONITOR-ID = #M-MONITOR-ID
    IF NO RECORDS FOUND
      RESET EOMRPM-INTERNAL-NODE-ID
      ESCAPE BOTTOM (FNDNOD1.)
    END-NOREC
    EOMRPM-INTERNAL-NODE-ID := MF-INTERNAL-NODE-ID
    #NODE-NR                := MF-MONITOR-NODE
    PERFORM GET-NODE /*SU18 read MF-NODE 2. time Ü?
    ESCAPE TOP /*INPUT again
  END-FIND
END-IF
IF #SELECTED
  ESCAPE TOP /*show map again before next action
END-IF
*
END-SUBROUTINE /* HANDLE-NODE
*
************************************************************************
DEFINE SUBROUTINE HANDLE-IDENT /*SU13
************************************************************************
RESET #SELECTED
IF #IDENT-NAME = SCAN '*'
  CALLNAT 'N-CHKIDE' '*' #IDENT-NAME #NODENAME #SPOOL-TYPE #OK
  IF #IDENT-NAME = SCAN '*' OR NOT #OK /*nothing selected / not ok
    #IDENT-NAME := #IDENT-NAME-OLD
    ESCAPE TOP
  END-IF
  #SELECTED := TRUE
END-IF
IF #IDENT-NAME NE ' ' /*check it always, maybe node changed
  CALLNAT 'N-CHKIDE' ' ' #IDENT-NAME #NODENAME #SPOOL-TYPE #OK
  IF #IDENT-NAME NE #IDENT-NAME-OLD OR NOT #OK
    #POS := POS(#IDENT-NAME)
    G-MAP-MODIFIED := #ANY-WILDCARD := #IDENT-CHANGED := TRUE
    ESCAPE TOP
  END-IF
END-IF
IF #IDENT-NAME NE #IDENT-NAME-OLD
  G-MAP-MODIFIED := #ANY-WILDCARD := #IDENT-CHANGED := TRUE
END-IF
*
END-SUBROUTINE /* HANDLE-IDENT
*
************************************************************************
DEFINE SUBROUTINE HANDLE-CODEPAGE /*SU14
************************************************************************
IF #CODEPAGE = SCAN '*'
  CALLNAT 'N-CP-HLP' 'D' #CODEPAGE
  IF #CODEPAGE = SCAN'*' /*nothing selected
    G-NATRP-ERC := 5
    #CODEPAGE := #OLD-CP
    #POS := POS(#CODEPAGE)
    ESCAPE TOP
  END-IF
END-IF
*
END-SUBROUTINE /* HANDLE-CODEPAGE
*
************************************************************************
DEFINE SUBROUTINE #REPORT-UNIX-ATTRIBUTES
************************************************************************
IF EOMRPM-UNIX-NODENAME = ' ' /*SU17
  EOMRPM-UNIX-NODENAME := +NOD-LOCAL-NAME
END-IF
IF #POS = 0
  #POS := POS(G-DIRECT-COMMAND)
END-IF
INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT MARK #POS USING MAP 'RDEFRPI&'
IF EOMRPM-UNIX-NODENAME = ' ' AND *PF-KEY = 'PF11'
  REINPUT *2020 ALARM
END-IF
RESET #POS
IF EOMRPM-UNIX-NODENAME = ' ' OR CV-UNIX MODIFIED
  RESET EOMRPM-UNIX-PATH
/*SU/EVI 2018-04 EOMRPM-UNIX-FORMAT
  IF NOT CV-UNIX-FILES MODIFIED AND EOMRPM-UNIX-FILES(*) NE ' '
    RESET EOMRPM-UNIX-FILES(*)
  END-IF
END-IF
#UNIX-NODENAME := EOMRPM-PARMS.EOMRPM-UNIX-NODENAME
*
END-SUBROUTINE /* #REPORT-UNIX-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE #REPORT-UNIX-NODE /*path
************************************************************************
FDUX. FIND (1) UX-NODES WITH UX-NODE-NAME = EOMRPM-UNIX-NODENAME
  IF NO RECORDS FOUND /* no data entered yet
    ESCAPE BOTTOM (FDUX.)
  END-NOREC
  L-NODE-NAME   := UX-NODE-NAME
  L-PATH (*)    := UX-NODE-PATH          (*)
  L-DBID (*)    := UX-NODE-CONTAINER-DB  (*)
  L-FNR  (*)    := UX-NODE-CONTAINER-FNR (*)
  L-MARK    (*) := ' '
  L-MARK-CV (*) := CV-MAP
  RESET #L-PATH-LEN
  FOR #MARK = 1 TO 10
    EXAMINE L-PATH (#MARK) FOR ' ' GIVING LENGTH IN L-PATH-LEN
    DECIDE FOR EVERY CONDITION
      WHEN L-PATH-LEN > #L-PATH-LEN
        #L-PATH-LEN := L-PATH-LEN
      WHEN L-PATH (#MARK) = ' '
        L-MARK-CV (#MARK) := (AD=NP)
      WHEN NONE IGNORE
    END-DECIDE
  END-FOR
  IF #L-PATH-LEN > 60 /* suppress dbid/fnr
    INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT USING MAP 'RDEFRUX&'
  ELSE
    INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT USING MAP 'RDEFRXX&'
  END-IF
  RESET #MARK-L
  IF *PF-KEY NE 'PF3'
    FOR #MARK = 1 TO 10
      IF L-MARK (#MARK) NE ' '
        IF #MARK-L /* more than one selected
          REINPUT *2027 ALARM
        END-IF
        IF L-PATH(#MARK) = EOMRPM-UNIX-PATH
          #PATH-NOT-CHANGED := TRUE
        ELSE
          RESET #PATH-NOT-CHANGED
        END-IF
        EOMRPM-UNIX-PATH := L-PATH (#MARK)
/**     EOMRPM-UNIX-C-DBID := L-DBID (#MARK) /*currently not modifiable
/**     EOMRPM-UNIX-C-FNR := L-FNR  (#MARK) /*currently not modifiable
        #MARK-L := TRUE
      END-IF
    END-FOR
    IF NOT #MARK-L /* nothing selected
      REINPUT *2027 ALARM
    END-IF
  ELSE /* PF3
    #PATH-NOT-CHANGED := TRUE
  END-IF
END-FIND
*
END-SUBROUTINE /* #REPORT-UNIX-NODE
*
************************************************************************
DEFINE SUBROUTINE #REPORT-SEPARATION-ATTRIBUTES
************************************************************************
IF IN-PARAM
  IF #POS = 0
    #POS := POS(G-DIRECT-COMMAND)
  END-IF
  DECIDE ON FIRST EOMRPM-EXIT-STANDARD
    VALUE 01
      IF G-DISPLAY-LONG-NAMES
        INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
          MARK #POS USING MAP 'RDEFRP4&'
      ELSE
        INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
          MARK #POS USING MAP 'RDEFRP1&'
      END-IF
    VALUE 02
      IF G-DISPLAY-LONG-NAMES
        INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
          MARK #POS USING MAP 'RDEFRP5&'
      ELSE
        INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
          MARK #POS USING MAP 'RDEFRP2&'
      END-IF
    VALUE 03
      INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
        MARK *#POS USING MAP 'RDEFRP3&'
    NONE VALUE
      INPUT WINDOW ='USER-EXIT-PARMS' WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
        MARK #POS USING MAP 'RDEFRPU&'
  END-DECIDE
  RESET #POS
ELSE
  #OLD-EXIT-STANDARD := EOMRPM-EXIT-STANDARD
  IF #POS = 0
    #POS := POS(G-DIRECT-COMMAND)
  END-IF
  INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
    MARK #POS USING MAP 'RDEFRPS&'
  RESET #POS
* user separation member with PF10 if SPF is active
  IF EOMRPM-EXIT-USER-NATPGM = ' ' AND *PF-KEY = 'PF10'
    REINPUT *4025 MARK *EOMRPM-EXIT-USER-NATPGM
  END-IF
  IF EOMRPM-EXIT-USER-NATLIB = ' ' AND EOMRPM-EXIT-USER-NATPGM NE ' '
    EOMRPM-EXIT-USER-NATLIB := #EDIT-LIB2
  END-IF
  IF EOMRPM-EXIT-USER-NATLIB NE ' ' OR EOMRPM-EXIT-USER-NATPGM NE ' '
  OR EOMRPM-EXIT-STANDARD NE 0                                        /*
    #EXIT-EXISTS := TRUE
  ELSE
    #EXIT-EXISTS := FALSE
  END-IF
  IF #EXIT-EXISTS AND #LAYOUT-EXISTS
    REINPUT *4038
  END-IF
  IF *PF-KEY = 'PF10' /*SU16
    #PROG := 'RDEFRP--' /*see S-SEPEDT
  END-IF
  IF EOMRPM-EXIT-STANDARD NE #OLD-EXIT-STANDARD
    RESET EOMRPM-EXIT-PARAMETER (*)
    DECIDE ON FIRST EOMRPM-EXIT-STANDARD
      VALUE 01  RESET EOMRPM-STD1
      VALUE 02  RESET EOMRPM-STD2
      VALUE 03  RESET EOMRPM-STD3
      NONE      IGNORE
    END-DECIDE
  END-IF
END-IF
PERFORM CHECK-STD-ROUTINE /*SU1
*
END-SUBROUTINE /* #REPORT-SEPARATION-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE #REPORT-NOMUSR-ATTRIBUTES /*3GL
************************************************************************
RESET #ESC
IF EOMRPM-NOMUSR-INTERFACE = 0
  PERFORM NOMUSR-INIT
  EOMRPM-NOMUSR-INTERFACE := NRM-MONITOR.#NOMUSR-INTERFACE
  EOMRPM-NOMUSR-IDENT-PROMPT (1:4) := NRM-MONITOR.#NOMUSR-PROMPT (1:4)
  EOMRPM-NOMUSR-FILES-PROMPT := NRM-MONITOR.#NOMUSR-PROMPT (5)
END-IF
IF EOMRPM-NOMUSR-INTERFACE NE 0
  FOR #I 1 4
    IF EOMRPM-NOMUSR-IDENT-PROMPT (#I) NE ' '
      #IDENT-OR (#I) := #LAN-TEXT (1)
      RESET  CV-IDENT-VAL (#I)
    ELSE
      RESET #IDENT-OR (#I)
      CV-IDENT-VAL (#I) := (AD=PN)
    END-IF
  END-FOR
ELSE
  DECIDE FOR FIRST CONDITION
/*SU21 WHEN G-SPOOL-TYPE = SCAN 'POWR' #PANEL := REPORT-POWER-ATTRIBUTES
    WHEN G-SYSTEM-TYPE = SCAN 'BS2'
      #PANEL := REPORT-BS2-ATTRIBUTES
    WHEN NONE
      #PANEL := REPORT-JES-ATTRIBUTES
  END-DECIDE
  RESET #LANGUAGE #POS
  READ-RECORD := TRUE
  #ESC := TRUE /*ESCAPE BOTTOM (FIND-LOOP.)
  ESCAPE ROUTINE
END-IF
IF #POS = 0
  #POS := POS(G-DIRECT-COMMAND)
END-IF
INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT MARK #POS USING MAP 'RDEFRPO&'
RESET #POS
*
END-SUBROUTINE /* #REPORT-NOMUSR-ATTRIBUTES
*
INCLUDE RPFSET-C /*SET-PFKEYS
*
END
