* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* API TO FLUSH A BUNDLE FROM AN EXTERNAL APPLICATION
*
* SJU 99-10-13 AMENDED TO HANDLE WILD CARD BUNDLE NAME
* NEW RETURN CODE: 4 FOR INVALID WILD CARD (EG ABC*DE)
* WCD 00-04-01 CE 7267  RE-CAT VABUND-L CHANGES
* XSISZHA 2000-08-07 (CE7461) EXTEND REPORT AND BUNDLE NAMES
* XSISZHA 2000-08-07 (CE7102) FLUSH BUNDLES WITH PREFIX
* sju 00-11-21 s(999999) Check setting of lfile 131 (SAT log file)
* sju 02-02-25 NOM221    New lfile for active data
* xsetggr 2012-02-01 NOMALL-1100 write language independant msgs to log
* SU1     2014-07-01 NOMALL-1279 fill fields for Adabas Vista
* SU2     2016-01-15 NOMALL-1802 do not update Adabas Vista fields
* ---------------------------------------------------------------------
* INPUT  PARAMETER
*     P-BUNDLE (A25)
*
* OUTPUT  PARAMETER
*     P-RC(N4)   /* RETURN CODE
*
*         0 - CLOSED SUCCESSFULLY
*
*         1 - BUNDLE NOT FOUND OR NOT OPENED
*
* FUNCTION
* THE ROUTINE WILL LOOK FOR AN OPENED BUNDLE WITH THE SAME NAME AND
* CLOSE IT
* ---------------------------------------------------------------------
*
DEFINE DATA PARAMETER
1 P-BUNDLE(A25)
1 P-RC(N4)
* *****
LOCAL USING VABUND-L
LOCAL USING RLOG-L
LOCAL USING SATLGV1P
LOCAL USING RACTLF-A
LOCAL
1 #AB-BUNDLE-STATUS(A27)
1 REDEFINE #AB-BUNDLE-STATUS
  2 #AB-BUNDLE(A25)
  2 #AB-STATUS(A2)
1 #AB-BUNDLE-STATUS-TO(A27)
1 REDEFINE #AB-BUNDLE-STATUS-TO
  2 #AB-BUNDLE-TO(A25)
  2 #AB-STATUS-TO(A2)
1 #I1(I1)
1 #I2(I1)
1 #HIGH-VALUES(A1) CONST <H'FF'>
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
CALLNAT 'SATLGFVN' SATLGV-PARMS
IF SATLGV-RC NE 0
  P-RC:= SATLGV-RC
  ESCAPE ROUTINE
END-IF
RESET RACTLF-LOGGING RACTLF-ERROR-LOGGING
RACTLF-LFILE-1:= 91
RACTLF-LFILE-2:= 206
CALLNAT 'RACTLF-N' RACTLF-PARMS
IF RACTLF-ERROR-CODE NE 0
  P-RC:= 4
  ESCAPE ROUTINE
END-IF
#AB-BUNDLE := P-BUNDLE
#AB-STATUS := 'O'
EXAMINE FULL #AB-BUNDLE FOR ' ' GIVING POSITION IN #I2
IF #I2 = 0
  #I2:= 25
ELSE
  #I2:= #I2 - 1
END-IF
EXAMINE #AB-BUNDLE FOR '*' REPLACE ' ' GIVING POSITION IN #I1
IF #I1 GT 0
  IF #I1 LT #I2
    P-RC:= 4
    ESCAPE ROUTINE
  END-IF
  COMPRESS #AB-BUNDLE #HIGH-VALUES INTO #AB-BUNDLE-TO LEAVING NO
ELSE
  #AB-BUNDLE-TO:= #AB-BUNDLE
END-IF
#AB-STATUS-TO:= #AB-STATUS
*
P-RC := 1
FIND ACTIVE-BUNDLES WITH AB-BUNDLE-STATUS = #AB-BUNDLE-STATUS
    THRU #AB-BUNDLE-STATUS-TO WHERE AB-STATUS = 'O'
  AB-STATUS      := 'P'
  AB-FLUSH-TIME  := *TIMX
/*SU1 AB-OBJECT-TYPE := 'AB' /*SU1
/*SU1 AB-OBJECT-TIME := *TIMX /*SU1
  P-RC := 0
  UPDATE
*
  LG-CODE    := 'AB'
  LG-BUNDLE  := AB-BUNDLE
  LG-BUNDRNB := AB-BUNDRNB
  COMPRESS AB-BUNDLE '/' AB-BUNDRNB TO LG-OBJECT-NAME LEAVING NO
  LG-USERID := *USER
*  COMPRESS 'BUNDLE FORCED TO CLOSE BY' LG-USERID TO LG-MSG LEAVING NO
* xsetggr 2012-02-01 NOMALL-1100 line above out, next line in
  COMPRESS '0488' LG-OBJECT-NAME LG-USERID TO LG-MSG
  CALLNAT 'RLOG' PL-PARMS
  END TRANSACTION
END-FIND
*
END
