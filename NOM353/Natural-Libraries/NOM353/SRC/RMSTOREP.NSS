  2 AR-SOURCE
  2 AR-SENDER
  2 AR-OBJECT-TYPE
  2 AR-OBJECT-TIME
* *****
1 #TIME-T                       (T)
1 #TIME-P                       (P12)
1 #DATE-IN                      (D)
1 #DATE-OUT                     (D)
1 #DATE-A                       (A8)
1 I                             (P2)
1 #AR-REPORT-TIME-INV           (A32)
1 REDEFINE #AR-REPORT-TIME-INV
  2 #AR-REPNAME                 (A25)
  2 #AR-TIME-INV                (P13)
1 #COUNTER                      (I2)
1 #GENERATIONS                  (I2)
1 #ET-COUNT                     (I2)
1 #DATX                         (A8)
1 #REPORT-ATTRIBUTES            (A600)
1 REDEFINE #REPORT-ATTRIBUTES
  2 #REPORT-ATTR
    3 AR-REPNAME                (A25)
    3 AR-REPRNB                 (P11)
    3 AR-MASTER-REPNAME         (A25)
    3 AR-STATUS                 (A1)
    3 AR-EXPIRATION             (A8)
    3 AR-RETENTION-ACTION       (A1)
    3 AR-RETENTION-PERIOD       (A12)
    3 AR-DESC                   (A50)
    3 AR-PROCESS-TIME           (T)
    3 AR-NUMBER-OF-LINES        (P9)
    3 AR-INSERTED               (A1)
    3 AR-CURRENT-LOCATION       (A1)
    3 AR-STORE-NATRPT           (A1)
    3 AR-ORDER-ID               (P10)
    3 AR-SOURCE-ID              (P10)
    3 AR-CC-TYPE                (B2)
    3 AR-RECORD-LENGTH          (N3)
    3 AR-USERID                 (A8)
**  3 FILLER       30X /*SU4 CABINET(A8),WORK(A22), BLI2 comment
    3 AR-HOLD-PRINT             (A1)
    3 AR-SEPMEM                 (A16)
    3 AR-SEPNO                  (P3)
    3 AR-ARCHIVE                (A1)
    3 AR-ARCHIVE-RETENTION      (A5)
    3 AR-ARCHIVE-RECNO          (N8)
    3 AR-ARCHIVE-DATE           (T)
    3 AR-ARCHIVE-DATA-SET       (A44)
    3 AR-REVIVE                 (A1)
    3 AR-REVIVE-EXPIRATION      (A8)
    3 AR-REVIVE-DATE            (T)
    3 AR-REVIVE-RETENTION-PERIOD(A12)
    3 AR-CHARS                  (A20)
    3 AR-DATASET-IDENTIFIER     (A25)
    3 AR-DATASET-KEY            (N7)
    3 AR-DSNO                   (N3)
    3 AR-DSTYPE                 (A2)
    3 AR-FCB                    (A4)
    3 AR-FLASH                  (A4)
    3 AR-FORM                   (A8)
    3 AR-FORMDEF                (A8)
    3 AR-GROUP-ID               (A20)
    3 AR-JOBNAME                (A10)
    3 AR-JOBNO                  (N7)
    3 AR-PROCNAME               (A8)
    3 AR-DDNAME                 (A8)
    3 AR-PAGEDEF                (A8)
    3 AR-RECFM                  (A3)
    3 AR-STEPNAME               (A8)
    3 AR-TRC                    (A3)
    3 AR-COPIES                 (N3)
    3 AR-ARCHIVE-TYPE           (N1)
    3 AR-STYLESHEET-URL         (A70)
    3 AR-REP-FORMAT             (A1)
1 #AR-PRINTERS                  (A12/20) /*SU7 A11 -> A12
1 #AR-NATRPT-DIST               (A8/10)
1 #AR-ARCHIVE-VOLSER            (A6/2)
1 #LOC-SPOOL-ATTRIBUTES         (A250)
1 REDEFINE #LOC-SPOOL-ATTRIBUTES
  2 #LOC-SPOOL-TYPE             (I2)
  2 #LOC-SPOOL-ATTR             (A248)
1 #SOURCE-ATTRIBUTES            (A250)
1 #L                            (I4)
1 #I                            (I2)
1 #META-D                       (A20)
1 #TRACING                      (L)
1 #STRING                       (A251)
1 #CATDATE                      (A19)
1 #G-SPOOL-ATTR-EXTENDED        (A) DYNAMIC
1 #UPD-NAME                     (L/1:2)
1 #UPD-IND                      (I1)
1 #NEW-PATH-NAME-SHORT          (A250)
1 #NODE                         (A20)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
FORMAT (0) LS=133 PS=60
*
************************************************************************
DEFINE SUBROUTINE STORE-OPEN-REPORT
************************************************************************
IF G-TRACE GE *LEVEL
  #TRACING := TRUE
  PERFORM XXCATAL-GET-CATDATE #CATDATE
  COMPRESS 'Start' *PROGRAM 'cataloged at'  #CATDATE TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
INCLUDE CMRDC
*
RESET ACTIVE-REPRTS  /* SU4 #WORK
  +G-ACTIVE-ISN-P10  /* BLI NOMALL-2294
* +G-ACTIVE-ISN-P10 could be set below due to that the old one should be
* handled meanwhile completely (?)
*
/*SU6 MONITNGL-G-NEW-VARIABLES := G-NEW-VARIABLES
/*SU6 RESET  G-AR-REOPENED
/*SU6 G-NEW-VARIABLES := MONITNGL-G-NEW-VARIABLES
ACTIVE-REPRTS.AR-ORDER-ID         := G-ORDER-ID
ACTIVE-REPRTS.AR-SOURCE-ID        := RMEX-SOURCE-ID
ACTIVE-REPRTS.AR-SPOOL-ATTRIBUTES := RMEX-SPOOL-ATTRIBUTES
ACTIVE-REPRTS.AR-REMOTE-CODEPAGE  := RMEX-SOURCE-CODEPAGE
ACTIVE-REPRTS.AR-LOCAL-CODEPAGE   := +NOD-LOCAL-CODEPAGE
ACTIVE-REPRTS.AR-INTERNAL-NODE-ID := REPORTS.R-INTERNAL-NODE-ID
#G-SPOOL-ATTR-EXTENDED   := +G-SPOOL-ATTR-EXTENDED
PERFORM XXMVFI-S-MOVE-FIELD ACTIVE-REPRTS.AR-SPOOL-ATTR-EXTENDED (1:120)
  #G-SPOOL-ATTR-EXTENDED
+G-SPOOL-ATTR-EXTENDED := #G-SPOOL-ATTR-EXTENDED
*
PERFORM STORE-SOURCE-SENDER
*
ACTIVE-REPRTS.AR-CC-TYPE           := RMEX-SOURCE-CC-TYPE
ACTIVE-REPRTS.AR-RECORD-LENGTH     := RMEX-SOURCE-LRECL
ACTIVE-REPRTS.AR-STATUS            := 'O'
ACTIVE-REPRTS.AR-REPNAME           := G-REPORT
ACTIVE-REPRTS.AR-REPRNB            := G-REPRNB
ACTIVE-REPRTS.AR-USERID            := G-JOBUSERID
ACTIVE-REPRTS.AR-RETENTION-ACTION  := G-RETENTION-ACTION
ACTIVE-REPRTS.AR-RETENTION-PERIOD  := REPORTS.R-RETENTION-PERIOD
ACTIVE-REPRTS.AR-SEPMEM            := REPORTS.R-SEPMEM
ACTIVE-REPRTS.AR-ARCHIVE-RETENTION := REPORTS.R-ARCHIVE-RETENTION
FIND REPORT-ATTR WITH R-REPNAME = ACTIVE-REPRTS.AR-REPNAME
  IF NO
    FIND REPORT-ATTR WITH R-REPNAME = R-MASTER-REPNAME
      ACTIVE-REPRTS.AR-REVIVE-RETENTION-PERIOD :=
        REPORT-ATTR.R-REVIVE-RETENTION
    END-FIND
  END-NOREC
  ACTIVE-REPRTS.AR-REVIVE-RETENTION-PERIOD :=
    REPORT-ATTR.R-REVIVE-RETENTION
END-FIND
ACTIVE-REPRTS.AR-SEPNO            := G-SEPNO
ACTIVE-REPRTS.AR-HOLD-PRINT       := G-HOLD
ACTIVE-REPRTS.AR-PROCESS-TIME     := #TIME-T := #TIME-P := *TIMX
ACTIVE-REPRTS.AR-PROCESS-TIME-INV := #CONST-INV-TIME - #TIME-P
ACTIVE-REPRTS.AR-DESC             := REPORTS.R-DESC
FOR I = 1 TO 20
  IF REPORTS.R-PRINTER (I) NE ' '
    ACTIVE-REPRTS.AR-PRINTERS (I) := REPORTS.R-PRINTERS (I)
  ELSE
    RESET ACTIVE-REPRTS.AR-PRINTERS (I)
  END-IF
END-FOR
IF ACTIVE-REPRTS.AR-RETENTION-UNIT = 'G'
  ACTIVE-REPRTS.AR-EXPIRATION := '26991231'
  RESET #AR-TIME-INV
  #AR-REPNAME  := ACTIVE-REPRTS.AR-REPNAME
  #GENERATIONS := ACTIVE-REPRTS.AR-RETENTION-NUM
ELSE
  IF ACTIVE-REPRTS.AR-RETENTION-ACTION = 'A' OR = 'P'
    IF ACTIVE-REPRTS.AR-RETENTION-PERIOD = ' '
      ACTIVE-REPRTS.AR-RETENTION-PERIOD := '010A'
    END-IF
    IF ACTIVE-REPRTS.AR-RETENTION-NUM = 0
      ACTIVE-REPRTS.AR-RETENTION-NUM := 10
    END-IF
    #DATE-IN := *DATX
    CALLNAT 'RCOMED-N' #DATE-IN ACTIVE-REPRTS.AR-RETENTION-PERIOD
      #DATE-OUT
    MOVE EDITED #DATE-OUT (EM=YYYYMMDD) TO #DATE-A
    IF #DATE-A NE '00000102'
      ACTIVE-REPRTS.AR-EXPIRATION := #DATE-A
    END-IF
  END-IF
END-IF
*
ACTIVE-REPRTS.AR-NATRPT-DIST (*)  := G-NATRPT-DIST (*)
ACTIVE-REPRTS.AR-OBJECT-TYPE      := 'AR'
ACTIVE-REPRTS.AR-OBJECT-TIME      := *TIMX
*
IF +G-NOMEXIT-ACTIVE (12)
  #LOC-SPOOL-ATTRIBUTES  := RMEX-SPOOL-ATTRIBUTES
  #SOURCE-ATTRIBUTES     := RMEX-SOURCE-ATTRIBUTES
  MOVE BY NAME ACTIVE-REPRTS TO #REPORT-ATTR
  #AR-PRINTERS       (*) := ACTIVE-REPRTS.AR-PRINTERS       (*)
  #AR-ARCHIVE-VOLSER (*) := ACTIVE-REPRTS.AR-ARCHIVE-VOLSER (*)
  #AR-NATRPT-DIST    (*) := ACTIVE-REPRTS.AR-NATRPT-DIST    (*)
  RESET G-NATRP-ERC G-NATRP-ERT
  CALLNAT 'NOMEX013' #REPORT-ATTRIBUTES #AR-PRINTERS       (*)
    #AR-ARCHIVE-VOLSER (*) #AR-NATRPT-DIST    (*)
    #LOC-SPOOL-ATTRIBUTES #SOURCE-ATTRIBUTES
    #G-SPOOL-ATTR-EXTENDED    /* only to inform BLI2 added
    G-NATRP-ERC G-NATRP-ERT
  IF G-NATRP-ERC NE 0
    BACKOUT TRANSACTION
    IF #TRACING
      COMPRESS 'NOMEX013 ERC:' G-NATRP-ERC ', ERT:' G-NATRP-ERT
        TO G-TRACE-MSG LEAVING NO
      PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
    END-IF
    IF G-NATRP-ERC = 5
      LG-MSG := G-NATRP-ERT
    ELSE
      COMPRESS G-NATRP-ERC G-NATRP-ERT TO LG-MSG
    END-IF
    LG-USERID := G-LG-USERID
    LG-CODE   := 'MO'
    CALLNAT 'RLOG' PL-PARMS
    END OF TRANSACTION
    G-NATRP-ERC := 1020
    COMPRESS G-NATRP-ERC G-REPORT TO LG-MSG
    LG-CODE := 'MO'
    CALLNAT 'RLOG' PL-PARMS
    END OF TRANSACTION
    ESCAPE ROUTINE
  END-IF
  ACTIVE-REPRTS.AR-PRINTERS (*) := G-PRINTERS(*) := #AR-PRINTERS (*)
  ACTIVE-REPRTS.AR-NATRPT-DIST(*):=G-NATRPT-DIST(*):= #AR-NATRPT-DIST(*)
  ACTIVE-REPRTS.AR-HOLD-PRINT:=G-HOLD:= #REPORT-ATTRIBUTES.AR-HOLD-PRINT
  ACTIVE-REPRTS.AR-DESC := #REPORT-ATTRIBUTES.AR-DESC
  FOR. FOR G-JPRINTER-NO = 20 TO 1 STEP -1
    IF G-PRINTERS (G-JPRINTER-NO) NE ' '
      ESCAPE BOTTOM (FOR.)
    END-IF
  END-FOR
  FOR2. FOR G-NATRPT-DIST-NO = 10 TO 1 STEP -1
    IF G-NATRPT-DIST (G-NATRPT-DIST-NO) NE ' '
      ESCAPE BOTTOM (FOR2.)
    END-IF
  END-FOR
END-IF
*
STORE-REP. STORE ACTIVE-REPRTS
RESET #UPD-NAME (*)
#SPOOL-ATTRIBUTES := ACTIVE-REPRTS.AR-SPOOL-ATTRIBUTES
CALLNAT 'RMSPL7-N' #SPOOL-ATTRIBUTES #SPOOL-TYPE
DECIDE ON EVERY VALUE OF #SPOOL-TYPE
  VALUE SEQUENTIAL-FILE-UNIX
    XXHASH-PARMS.P-SHORT-NAME := #SPOOL-UNIX-FILE-NAME
    #NODE := #SPOOL-UNIX-NODE-NAME
  VALUE DIRECT-INPUT
    #UPD-IND := 1
    XXHASH-PARMS.P-SHORT-NAME := #SPOOL-DI-PATH
    PERFORM UPD-NAME
    #NEW-PATH-NAME-SHORT := XXHASH-PARMS.P-SHORT-NAME
    #NODE := 'Direct Input'
    XXHASH-PARMS.P-SHORT-NAME := #SPOOL-DI-FILENAME
  VALUES JES2,JES3,SEQUENTIAL-FILE-BS2,LMS /*SU9 POWER
    RESET #NODE
    FIND MF-NODE WITH
    MF-INTERNAL-NODE-ID = ACTIVE-REPRTS.AR-INTERNAL-NODE-ID           /*
      #NODE := SUBSTR(MF-MONITOR-ID,3)
    END-FIND
  VALUES JES2,JES3
    IF #NODE = ' '
      #NODE := #SPOOL-JES-NODE
    ELSE
      #SPOOL-JES-NODE := MF-MONITOR-NODE
    END-IF
/*SU9  VALUE POWER
  VALUES SEQUENTIAL-FILE-BS2,LMS
    IF #NODE = ' '
      #NODE := #SPOOL-BS2-NODE
    ELSE
      #SPOOL-BS2-NODE := MF-MONITOR-NODE
    END-IF
  ANY
    #UPD-IND := 2
    PERFORM UPD-NAME
  NONE
    #NODE := +NOD-LOCAL-NAME
END-DECIDE
PERFORM BACK-TO-GDA
+G-ACTIVE-ISN-P10 := *ISN(STORE-REP.)
IF ACTIVE-REPRTS.AR-RETENTION-UNIT = 'G'
  PERFORM CHECK-EXPIRED-GENERATIONS
END-IF
AR. GET ACT-REP +G-ACTIVE-ISN-P10
ACT-REP.AR-MASTER-REPNAME := ##MASTER-REPNAME
IF #UPD-NAME (2) /*(2) must be before (1) since SHORT-NAME
  DECIDE ON FIRST VALUE OF #SPOOL-TYPE
    VALUE SEQUENTIAL-FILE-UNIX
      #SPOOL-UNIX-FILE-NAME := XXHASH-PARMS.P-SHORT-NAME
    VALUE DIRECT-INPUT
      #SPOOL-DI-FILENAME  := XXHASH-PARMS.P-SHORT-NAME
    NONE IGNORE
  END-DECIDE
END-IF
IF #UPD-NAME (1)
  #SPOOL-DI-PATH := #NEW-PATH-NAME-SHORT
END-IF
IF #UPD-NAME (*)
  ACT-REP.AR-SPOOL-ATTRIBUTES := #SPOOL-ATTRIBUTES
END-IF
UPDATE (AR.)
*
##AC-SEQNO := 1
COMPRESS ACTIVE-REPRTS.AR-REPNAME '/' ACTIVE-REPRTS.AR-REPRNB
  TO LG-OBJECT-NAME
LG-USERID  := G-LG-USERID
LG-REPNAME := ACTIVE-REPRTS.AR-REPNAME
LG-REPRNB  := ACTIVE-REPRTS.AR-REPRNB
LG-CODE    := 'AR' /*'AD'
COMPRESS ACTIVE-REPRTS.AR-REPNAME '/' ACTIVE-REPRTS.AR-REPRNB
  TO LG-MSG LEAVING NO
COMPRESS '7016' LG-MSG #NODE TO LG-MSG
CALLNAT 'RLOG' PL-PARMS
IF ACTIVE-REPRTS.AR-REMOTE-CODEPAGE NE ACTIVE-REPRTS.AR-LOCAL-CODEPAGE
    AND ACTIVE-REPRTS.AR-LOCAL-CODEPAGE  NE ' ' /* was a conversion
    AND ACTIVE-REPRTS.AR-REMOTE-CODEPAGE NE ' '
  COMPRESS '7020' ACTIVE-REPRTS.AR-REMOTE-CODEPAGE +NOD-LOCAL-CODEPAGE
    TO LG-MSG
  CALLNAT 'RLOG' PL-PARMS
END-IF
END TRANSACTION
*
IF #TRACING
  COMPRESS 'Ended with --->' G-NATRP-ERC-A G-NATRP-ERT TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END TRANSACTION
END-IF
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE STORE-SOURCE-SENDER
************************************************************************
RESET #L #I #SPOOL-ATTRIBUTES #STRING
#SPOOL-ATTRIBUTES := RMEX-SPOOL-ATTRIBUTES
*
IF #SPOOL-TYPE = DIRECT-INPUT
  EXAMINE +G-SPOOL-ATTR-EXTENDED FOR 'source=' GIVING POSITION #L
  IF #L > 0
    SEPARATE SUBSTR(+G-SPOOL-ATTR-EXTENDED,#L) INTO #STRING
      IGNORE WITH DELIMITER ';'
    SEPARATE #STRING INTO #META-D #META-D IGNORE WITH DELIMITER '='
    AR-SOURCE := #META-D
  END-IF
*
  IF #I = 0 AND #L = 0
    RESET AR-SOURCE
  END-IF
*
  RESET #L #I #STRING
  EXAMINE +G-SPOOL-ATTR-EXTENDED FOR 'sender=' GIVING POSITION IN #L
  IF #L > 0                 /* sender data exists
    SEPARATE SUBSTR(+G-SPOOL-ATTR-EXTENDED,#L) INTO #STRING
      IGNORE WITH DELIMITER ';'
    SEPARATE #STRING INTO #META-D #META-D IGNORE WITH DELIMITER '='
    AR-SENDER := #META-D
  END-IF
*
  IF #I = 0  AND #L = 0       /* nos sender data
    RESET AR-SENDER
  END-IF
ELSE                            /* spool type ne direct input
  RESET AR-SOURCE AR-SENDER
END-IF
*
END-SUBROUTINE /* STORE-SOURCE-SENDER
*
************************************************************************
DEFINE SUBROUTINE CHECK-EXPIRED-GENERATIONS
************************************************************************
MOVE EDITED *DATX (EM=YYYYMMDD) TO #DATX
READ ACT-REP BY AR-REPORT-TIME-INV = #AR-REPORT-TIME-INV
  IF ACT-REP.AR-REPNAME NE ACTIVE-REPRTS.AR-REPNAME
    ESCAPE BOTTOM
  END-IF
  IF ACT-REP.AR-CURRENT-LOCATION = 'A' OR ACT-REP.AR-ARCHIVE = '*'
      OR #DATX >= ACT-REP.AR-EXPIRATION
    ESCAPE TOP
  END-IF
  ADD 1 TO #COUNTER
  IF #COUNTER > #GENERATIONS
    ACT-REP.AR-EXPIRATION := #DATX
    UPDATE
    ADD 1 TO #ET-COUNT
    IF #ET-COUNT = 50
      RESET #ET-COUNT
      END TRANSACTION
    END-IF
  END-IF
END-READ
*
END-SUBROUTINE /* CHECK-EXPIRED-GENERATIONS
*
************************************************************************
DEFINE SUBROUTINE BACK-TO-GDA
************************************************************************
ACTIVE-REPORTS.AR-PROCESS-TIME-INV := ACTIVE-REPRTS.AR-PROCESS-TIME-INV
ACTIVE-REPORTS.AR-REPNAME          := ACTIVE-REPRTS.AR-REPNAME
ACTIVE-REPORTS.AR-REPRNB           := ACTIVE-REPRTS.AR-REPRNB
ACTIVE-REPORTS.AR-STATUS           := ACTIVE-REPRTS.AR-STATUS
ACTIVE-REPORTS.AR-EXPIRATION       := ACTIVE-REPRTS.AR-EXPIRATION
ACTIVE-REPORTS.AR-RETENTION-ACTION := ACTIVE-REPRTS.AR-RETENTION-ACTION
ACTIVE-REPORTS.AR-RETENTION-PERIOD := ACTIVE-REPRTS.AR-RETENTION-PERIOD
ACTIVE-REPORTS.AR-DESC             := ACTIVE-REPRTS.AR-DESC
ACTIVE-REPORTS.AR-PROCESS-TIME     := ACTIVE-REPRTS.AR-PROCESS-TIME
ACTIVE-REPORTS.AR-NUMBER-OF-LINES  := ACTIVE-REPRTS.AR-NUMBER-OF-LINES
ACTIVE-REPORTS.AR-INSERTED         := ACTIVE-REPRTS.AR-INSERTED
ACTIVE-REPORTS.AR-CURRENT-LOCATION := ACTIVE-REPRTS.AR-CURRENT-LOCATION
ACTIVE-REPORTS.AR-STORE-NATRPT     := ACTIVE-REPRTS.AR-STORE-NATRPT
ACTIVE-REPORTS.AR-ORDER-ID         := ACTIVE-REPRTS.AR-ORDER-ID
ACTIVE-REPORTS.AR-SOURCE-ID        := ACTIVE-REPRTS.AR-SOURCE-ID
ACTIVE-REPORTS.AR-CC-TYPE          := ACTIVE-REPRTS.AR-CC-TYPE
ACTIVE-REPORTS.AR-RECORD-LENGTH    := ACTIVE-REPRTS.AR-RECORD-LENGTH
ACTIVE-REPORTS.AR-SPOOL-ATTRIBUTES := ACTIVE-REPRTS.AR-SPOOL-ATTRIBUTES
ACTIVE-REPORTS.AR-USERID           := ACTIVE-REPRTS.AR-USERID
ACTIVE-REPORTS.AR-NATRPT-DIST(1:10):= ACTIVE-REPRTS.AR-NATRPT-DIST(1:10)
ACTIVE-REPORTS.AR-PRINTERS (1:20)  := ACTIVE-REPRTS.AR-PRINTERS (1:20)
ACTIVE-REPORTS.AR-HOLD-PRINT       := ACTIVE-REPRTS.AR-HOLD-PRINT
ACTIVE-REPORTS.AR-SEPMEM           := ACTIVE-REPRTS.AR-SEPMEM
ACTIVE-REPORTS.AR-SEPNO            := ACTIVE-REPRTS.AR-SEPNO
ACTIVE-REPORTS.AR-ARCHIVE          := ACTIVE-REPRTS.AR-ARCHIVE
IF ACTIVE-REPORTS.AR-ARCHIVE = ' '
  ACTIVE-REPORTS.AR-ACTIVE := 'X'
ELSE
  RESET ACTIVE-REPORTS.AR-ACTIVE
END-IF
ACTIVE-REPORTS.AR-ARCHIVE-RETENTION := ACTIVE-REPRTS.AR-ARCHIVE-RETENTION
ACTIVE-REPORTS.AR-ARCHIVE-RECNO     := ACTIVE-REPRTS.AR-ARCHIVE-RECNO
ACTIVE-REPORTS.AR-ARCHIVE-DATE      := ACTIVE-REPRTS.AR-ARCHIVE-DATE
ACTIVE-REPORTS.AR-ARCHIVE-DATA-SET  := ACTIVE-REPRTS.AR-ARCHIVE-DATA-SET
ACTIVE-REPORTS.AR-ARCHIVE-VOLSER(1:2):=ACTIVE-REPRTS.AR-ARCHIVE-VOLSER(1:2)
ACTIVE-REPORTS.AR-REVIVE            := ACTIVE-REPRTS.AR-REVIVE
ACTIVE-REPORTS.AR-REVIVE-EXPIRATION := ACTIVE-REPRTS.AR-REVIVE-EXPIRATION
ACTIVE-REPORTS.AR-REVIVE-DATE       := ACTIVE-REPRTS.AR-REVIVE-DATE
ACTIVE-REPORTS.AR-REVIVE-RETENTION-PERIOD :=
  ACTIVE-REPRTS.AR-REVIVE-RETENTION-PERIOD
ACTIVE-REPORTS.AR-ARCHIVE-TYPE      := ACTIVE-REPRTS.AR-ARCHIVE-TYPE
ACTIVE-REPORTS.AR-STYLESHEET-URL    := ACTIVE-REPRTS.AR-STYLESHEET-URL
ACTIVE-REPORTS.AR-REP-FORMAT := ACTIVE-REPRTS.AR-REP-FORMAT
*
END-SUBROUTINE /* BACK-TO-GDA
*
************************************************************************
DEFINE SUBROUTINE UPD-NAME
************************************************************************
/*get rep.-name+rnb:
XXHASH-PARMS.P-FUNCTION := 'L' /*short -> long
PERFORM XXHASH XXHASH-PARMS
IF XXHASH-PARMS.P-REPRNB = ' ' /*dummy record -> update
  XXHASH-PARMS.P-FUNCTION := 'U' /*update record
ELSE /*store new record
  XXHASH-PARMS.P-FUNCTION := 'S' /*long -> short and store
  #UPD-NAME (#UPD-IND) := TRUE /*spool-attr must be updated
END-IF
COMPRESS ACTIVE-REPRTS.AR-REPNAME '/'
  ACTIVE-REPRTS.AR-REPRNB TO XXHASH-PARMS.P-REPRNB LEAVING NO
PERFORM XXHASH XXHASH-PARMS
*
END-SUBROUTINE /* UPD-NAME
*
END-SUBROUTINE /* STORE-OPEN-REPORT
*
END
