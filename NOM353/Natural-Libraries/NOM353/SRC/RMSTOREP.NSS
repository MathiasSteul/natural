  2 AR-PRINTERS                       (1:20)
  2 AR-HOLD-PRINT
  2 AR-SEPMEM
  2 AR-SEPNO
  2 AR-ARCHIVE
  2 AR-ARCHIVE-RETENTION
  2 AR-ARCHIVE-RECNO
  2 AR-ARCHIVE-DATE
