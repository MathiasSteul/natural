G-CALLER := *PROGRAM
IF G-DIRECT-COMMAND NE ' '
  MOVE LEFT G-DIRECT-COMMAND TO G-DIRECT-COMMAND
  IF G-DIRECT-COMMAND IS (N2.1) AND G-DIRECT-COMMAND NE '.'
    COMPRESS '>' G-DIRECT-COMMAND INTO G-DIRECT-COMMAND LEAVING NO
  END-IF
    FETCH RETURN 'NRMCPR'
  DECIDE ON FIRST VALUE OF G-NATRP-ERC
    VALUE 9999
      RESET G-NATRP-ERC
      INCLUDE C-ESCAPE
    VALUE 9997
      RESET G-NATRP-ERC
    NONE /* 0,5,419,420,9998 DO cmd
      ESCAPE TOP
  END-DECIDE
END-IF
