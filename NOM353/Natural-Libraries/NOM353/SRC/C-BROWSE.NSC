* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* ???
DECIDE FOR EVERY  CONDITION
  WHEN #NEWVAL
    RESET #PAGES(*) #MAXP #MAXAP
    #PAGES(1) := #START-KEY
    #CP := #MAXAP := 1
  WHEN #BOT
    #CP := #MAXAP
  WHEN #TOP
    #CP := 1
    INCLUDE C-FORWRD
  WHEN #BACKWARD
    IF #CP < 2
      IGNORE
    ELSE
      IF #SCROLL-AMOUNT < 1
        #SCROLL-AMOUNT := 1
      END-IF
      SUBTRACT #SCROLL-AMOUNT FROM #CP
      IF #CP < 1
        #CP := 1
      END-IF
    END-IF
  WHEN GET-SCREEN IGNORE
  WHEN NONE ESCAPE ROUTINE
END-DECIDE
*
IF #CP >= #MAXAP
  #MAXAP := #CP
END-IF
*
#RSTART := #PAGES(#CP)
*
