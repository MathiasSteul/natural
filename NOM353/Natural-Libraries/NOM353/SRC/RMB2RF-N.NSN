* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    RMB2RF-N
* Function  Build new dsname for a BS2000 spool file by appending the
*           NOM source id and rename the file
*
* Version   1.3
*
* Maintenance
* uuu     yyyy-mm-dd s(999999) ...
* mrs     1995-10-10 s(999999) created
* mwi     1997-03-26 p(263275) let :catid: be a part of the filename
* mwi     1997-06-03 p(162704) reset changes of P(263275)
* fhi     2000-08-24 QA03     Use NAT23006 for error values
* xsetggr 2007-05-02 NOM3201  support 5 byte node numbers
* fhi     2007-07-12 NOM3202   C-NATERR changed, NAD23006 is obsolete.
* fhi     2010-09-03 NOMALL-97 Extend message line
* fhi     2010-09-21 NOMALL-97 Use no more C-NATERR but C-NATERN instead
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 RMB2RF-NODE                  (N5)
1 RMB2RF-SOURCE-ID             (P10)
1 RMB2RF-DSNAME                (A54)
1 RMB2RF-NEW-DSNAME            (A54)
1 RMB2RF-ERROR-CODE            (N4)
1 RMB2RF-ERROR-TEXT            (A250)
* *****
LOCAL
1 VTOC-UPDATE VIEW OF VTOC-UPDATE
  2 ERROR-CODE
  2 ERROR-TEXT
  2 REDEFINE ERROR-TEXT
    3 ERROR-PREFIX (A7)
    3 ERROR-FIL    (A1)
    3 ERROR-TXT    (A49)
  2 SYSTEM-MESSAGE-CODE
*
LOCAL
1 #TMP-DSNAME                (A54)
1 #DSNAME-LENGTH             (I4) CONST <54>
1 #CAT-MAX-LENGTH            (I4) CONST <41>
1 #NEW-DSNAME                (A54)
1 REDEFINE #NEW-DSNAME
  2 #NDS                     (A1/1:#DSNAME-LENGTH)
*
1 #I                         (I4)
1 #J                         (I4)
1 #LEN                       (I4)
1 #FILE-LEN                  (I4)
1 #USER-LEN                  (I4)
1 #PUBSET-LEN                (I4)
1 #PUBSET                    (A8)
1 #USER                      (A10)
1 #FILE                      (A54)
1 #SOURCE-ID                 (N10)
1 REDEFINE #SOURCE-ID
  2 #SOURCE-ID-A10           (A10)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#SOURCE-ID := ABS(RMB2RF-SOURCE-ID)
RESET RMB2RF-ERROR-CODE RMB2RF-ERROR-TEXT
*
PERFORM GET-FILE-NAME-TOKEN
PERFORM BUILD-NEW-DSNAME
PERFORM RENAME-FILE
*
IF #PUBSET NE ' '
  COMPRESS #PUBSET #USER #NEW-DSNAME TO RMB2RF-NEW-DSNAME LEAVING NO
ELSE
  COMPRESS #USER #NEW-DSNAME TO RMB2RF-NEW-DSNAME LEAVING NO
END-IF
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE RENAME-FILE
************************************************************************
RENAME. FIND VTOC-UPDATE WITH NODE = RMB2RF-NODE AND FUNCTION = 'RENAME'
    AND DSNAME   = RMB2RF-DSNAME AND NEWNAME  = #NEW-DSNAME
*
  IF ERROR-CODE NE 0
    RMB2RF-ERROR-CODE := 5000 + ERROR-CODE (RENAME.)
    COMPRESS ERROR-PREFIX (RENAME.) '(' SYSTEM-MESSAGE-CODE (RENAME.)
      ')' ERROR-TXT (RENAME.) TO RMB2RF-ERROR-TEXT
  END-IF
*
END-FIND
*
END-SUBROUTINE  /* RENAME-FILE
*
************************************************************************
DEFINE SUBROUTINE GET-FILE-NAME-TOKEN
************************************************************************
*  Extract file token (pubset, userid, filename) from a given
*  full qualified BS2000 dsname:
CALLNAT 'RMB2FT-N' RMB2RF-DSNAME #FILE #PUBSET #USER
*
EXAMINE #FILE   FOR 'x' GIVING LENGTH IN #FILE-LEN
EXAMINE #PUBSET FOR 'x' GIVING LENGTH IN #PUBSET-LEN
EXAMINE #USER   FOR 'x' GIVING LENGTH IN #USER-LEN
*
END-SUBROUTINE  /* GET-FILE-NAME-TOKEN
*
************************************************************************
DEFINE SUBROUTINE BUILD-NEW-DSNAME
************************************************************************
#NEW-DSNAME := #FILE
*
#FILE-LEN := #DSNAME-LENGTH - (#USER-LEN + #PUBSET-LEN)
IF #FILE-LEN > #CAT-MAX-LENGTH
  #FILE-LEN := #CAT-MAX-LENGTH
END-IF
*
REPEAT
  IF #NEW-DSNAME = ' '
    COMPRESS 'NOM' '.' #SOURCE-ID-A10 TO #TMP-DSNAME LEAVING NO
  ELSE
    COMPRESS #NEW-DSNAME '.' #SOURCE-ID-A10 TO #TMP-DSNAME LEAVING NO
  END-IF
*
  EXAMINE #TMP-DSNAME FOR 'x' GIVING LENGTH IN #LEN
*
  IF #LEN <= #FILE-LEN
    ESCAPE BOTTOM
  END-IF
*
  EXAMINE #NEW-DSNAME FOR 'x' GIVING LENGTH IN #I
  FOR. FOR #J = #I TO 1 STEP -1
    IF #NDS (#J) = '.'
      ESCAPE BOTTOM (FOR.)
    END-IF
  END-FOR
  IF #J = 0
    #J := 1
  END-IF
  RESET #NDS (#J:#DSNAME-LENGTH)
*
END-REPEAT /* BUILD-NEW-DSNAME
*
#NEW-DSNAME := #TMP-DSNAME
*
END-SUBROUTINE /* BUILD-NEW-DSNAME
*
************************************************************************
ON ERROR
************************************************************************
  CALLNAT 'C-NATERN' RMB2RF-ERROR-TEXT
  RMB2RF-ERROR-CODE := 21
  ESCAPE ROUTINE
END-ERROR
*
END
