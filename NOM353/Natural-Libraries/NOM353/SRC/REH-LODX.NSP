DEFINE SUBROUTINE ADD-ARC-TO-ARRAY
***********************************************************************
ADD 1 TO #XDIM
EXPAND ARRAY #PORTABLE-DSNAME-A TO (1:#XDIM)
#PORTABLE-DSNAME-A(#XDIM) := #PORTABLE-DSNAME
END-SUBROUTINE
*
*
***********************************************************************
DEFINE SUBROUTINE CHECK-ARC-DS
***********************************************************************
RESET #ARC-EXISTS
DS. FIND NUMBER AD1 WITH AD-ARCHIVE-DSNAME = #ARCHIVE-DSNAME
IF *NUMBER (DS.) = 0
  /* WRITE 'Not found in NRM-ARCHIVE-DATASET:' #ARCHIVE-DSNAME
  ESCAPE ROUTINE
END-IF
DSREP. FIND NUMBER DR1 WITH DR-ARCHIVE-DSNAME = #ARCHIVE-DSNAME
IF *NUMBER (DSREP.) GT 0
  COMPRESS 'Error: NRM-DATASET-REPORT already contains'
    #ARCHIVE-DSNAME INTO #OUT-STRING
  WRITE #OUT-STRING
  #ARC-EXISTS := TRUE
  ESCAPE ROUTINE
ELSE
  IGNORE
  /* WRITE 'Not found in NRM-DATASET-REPORT:' #ARCHIVE-DSNAME
  /*   / 'Will now be created...'
END-IF
DEL-AR. FIND  AD1 WITH AD-ARCHIVE-DSNAME = #ARCHIVE-DSNAME
  DELETE (DEL-AR.)
END-FIND
IF #LOG GT 0
  COMPRESS 'Info: Replacing entry in NRM-ARCHIVE-DATASET for'
    #ARCHIVE-DSNAME INTO #OUT-STRING
  WRITE #OUT-STRING
END-IF
*
END-SUBROUTINE /* CHECK-ARC-DS
*
*
*
***********************************************************************
DEFINE SUBROUTINE AR-WF-TO-DDM
***********************************************************************
AR1.AR-KEYWORDS(*)             := ARO-KEYWORDS(*)       /* A15/1:6
IF ARO-PROCESS-TIME-INV IS (P13)
  AR1.AR-PROCESS-TIME-INV := VAL(ARO-PROCESS-TIME-INV)  /* A13 := P13
END-IF
AR1.AR-REPNAME                 := ARO-REPNAME           /* A25
IF ARO-REPRNB IS (P11)
  AR1.AR-REPRNB := VAL(ARO-REPRNB)                      /* A11 := P11
END-IF
AR1.AR-MASTER-REPNAME          := ARO-MASTER-REPNAME    /* A25
IF ARO-INTERNAL-NODE-ID IS (P11)                        /* A11 := P11
  AR1.AR-INTERNAL-NODE-ID := VAL(ARO-INTERNAL-NODE-ID)
END-IF
AR1.AR-NODE-UX                 := ARO-NODE-UX           /* A16
AR1.AR-STATUS                  := ARO-STATUS            /* A1
* not set in test from SAGESM     /* GGS01
AR1.AR-EXPIRATION              := ARO-EXPIRATION        /* A8
AR1.AR-RETENTION-ACTION        := ARO-RETENTION-ACTION  /* A1
AR1.AR-RETENTION-PERIOD        := ARO-RETENTION-PERIOD  /* A12
AR1.AR-DESC                    := ARO-DESC              /* A50
AR1.AR-REMOTE-CODEPAGE         := ARO-REMOTE-CODEPAGE   /* A64
AR1.AR-LOCAL-CODEPAGE          := ARO-LOCAL-CODEPAGE    /* A64
IF ARO-PROCESS-TIME IS (P13)
  #P13 := VAL(ARO-PROCESS-TIME)                         /* P13 := A13
  AR1.AR-PROCESS-TIME := #P13                           /* T := P13
END-IF
IF ARO-NUMBER-OF-LINES IS (P8)
  AR1.AR-NUMBER-OF-LINES := VAL(ARO-NUMBER-OF-LINES)    /* A8 := P8
END-IF
AR1.AR-INSERTED                := ARO-INSERTED          /* A1
AR1.AR-CURRENT-LOCATION        := ARO-CURRENT-LOCATION  /* A1
AR1.AR-STORE-NATRPT            := ARO-STORE-NATRPT      /* A1
IF ARO-ORDER-ID IS (P10)
  AR1.AR-ORDER-ID := VAL(ARO-ORDER-ID)                  /* A10 := P10
END-IF
IF ARO-SOURCE-ID IS (P10)
  AR1.AR-SOURCE-ID := VAL(ARO-SOURCE-ID)                /* A10 := P10
END-IF
IF ARO-CC-TYPE = MASK (HHHH)
  MOVE EDITED ARO-CC-TYPE TO AR1.AR-CC-TYPE (EM=HHHH)  /* A4 := B2
END-IF
IF ARO-RECORD-LENGTH IS (N3)
  AR1.AR-RECORD-LENGTH := VAL(ARO-RECORD-LENGTH)        /* A3 := N3
END-IF
*
IF ARO-SPOOL-TYPE IS (I2)
  #SPOOL-TYPE := VAL(ARO-SPOOL-TYPE)                    /* A5 := I2
END-IF
*
* #SPOOL-ATTRIB              := ARO-SPOOL-ATTRIBUTES  /* A248 := A248
*
DECIDE ON FIRST VALUE OF #SPOOL-TYPE
    /*
  VALUE SEQUENTIAL-FILE-BS2  /* 0007
*   ---------------------------------      ----------------------------
*   BS2000
*   ---------------------------------      ----------------------------
    IF ARO-SPOOL-BS2-NODE IS (N5)
      #SPOOL-BS2-NODE := VAL(ARO-SPOOL-BS2-NODE)           /* A5 := N5
    END-IF
    #SPOOL-BS2-JOB-NAME    := ARO-SPOOL-BS2-JOB-NAME       /* A8
    #SPOOL-BS2-USER-ID     := ARO-SPOOL-BS2-USER-ID        /* A8
    #SPOOL-BS2-JOB-ID      := ARO-SPOOL-BS2-JOB-ID         /* A5
    #SPOOL-BS2-ORIGINATOR-JOB-ID := ARO-SPOOL-BS2-ORIGINATOR-JOB-ID
    /* A5
    IF ARO-SPOOL-BS2-COPIES IS (N3)
      #SPOOL-BS2-COPIES := VAL(ARO-SPOOL-BS2-COPIES)       /* A3 := N3
    END-IF
    #SPOOL-BS2-FORM        := ARO-SPOOL-BS2-FORM           /* A8
    #SPOOL-BS2-CHARS       := ARO-SPOOL-BS2-CHARS          /* A16
    #SPOOL-BS2-DSNAME      := ARO-SPOOL-BS2-DSNAME         /* A54
    #SPOOL-BS2-CONTROL-OPTION := ARO-SPOOL-BS2-CONTROL-OPTION /* A16
    #SPOOL-BS2-DESTINATION := ARO-SPOOL-BS2-DESTINATION    /* A8
    #SPOOL-BS2-DEVICE      := ARO-SPOOL-BS2-DEVICE         /* A8
    #SPOOL-BS2-ROTATION    := ARO-SPOOL-BS2-ROTATION       /* A8
    #SPOOL-BS2-DIA         := ARO-SPOOL-BS2-DIA            /* A2
    #SPOOL-BS2-SIZE        := ARO-SPOOL-BS2-SIZE           /* A6
    #SPOOL-BS2-RECFM       := ARO-SPOOL-BS2-RECFM          /* A5
    IF ARO-SPOOL-BS2-RECSIZE IS (N5)
      #SPOOL-BS2-RECSIZE := VAL(ARO-SPOOL-BS2-RECSIZE)     /* A5 := N5
    END-IF
    IF ARO-SPOOL-BS2-BLKSIZE IS (N5)
      #SPOOL-BS2-BLKSIZE := VAL(ARO-SPOOL-BS2-BLKSIZE)     /* A5 := N5
    END-IF
    IF ARO-SPOOL-BS2-SECONDARY IS (N7)
      #SPOOL-BS2-SECONDARY := VAL(ARO-SPOOL-BS2-SECONDARY) /* A7 := N7
    END-IF
    #SPOOL-BS2-ORIG-DSNAME := ARO-SPOOL-BS2-ORIG-DSNAME    /* A54
    #SPOOL-BS2-CLASS       := ARO-SPOOL-BS2-CLASS          /* A4
    /* 8 free
    /*
  VALUE JES2                 /* 0001
    IF ARO-SPOOL-JES-NODE IS (N5)
      #SPOOL-JES-NODE := VAL(ARO-SPOOL-JES-NODE)           /* A5 := N5
    END-IF
    #SPOOL-JES-JOB-NAME    := ARO-SPOOL-JES-JOB-NAME       /* A10
    IF ARO-SPOOL-JES-JOB-NUMBER IS (N7)
      #SPOOL-JES-JOB-NUMBER := VAL(ARO-SPOOL-JES-JOB-NUMBER) /* A7 := N7
    END-IF
    #SPOOL-JES-DSTYPE      := ARO-SPOOL-JES-DSTYPE         /* A2
    IF ARO-SPOOL-JES-DSNO-OLD IS (N3)
      #SPOOL-JES-DSNO-OLD := VAL(ARO-SPOOL-JES-DSNO-OLD)   /* A3 := N3
      IF #SPOOL-JES-DSNO-OLD = 0
        RESET #SPOOL-JES-DSNO-OLD-A3
      END-IF
    END-IF
    IF ARO-SPOOL-JES-DATASET-KEY IS (N7)  /* A7 := N7
      #SPOOL-JES-DATASET-KEY := VAL(ARO-SPOOL-JES-DATASET-KEY)
    END-IF
    #SPOOL-JES-GROUP-ID    := ARO-SPOOL-JES-GROUP-ID       /* A20
    #SPOOL-JES-PROCNAME    := ARO-SPOOL-JES-PROCNAME       /* A8
    #SPOOL-JES-STEPNAME    := ARO-SPOOL-JES-STEPNAME       /* A8
    #SPOOL-JES-DDNAME      := ARO-SPOOL-JES-DDNAME         /* A8
    #SPOOL-JES-CHARS       := ARO-SPOOL-JES-CHARS          /* A20
    #SPOOL-JES-FCB         := ARO-SPOOL-JES-FCB            /* A4
    #SPOOL-JES-FLASH       := ARO-SPOOL-JES-FLASH          /* A4
    #SPOOL-JES-FORM        := ARO-SPOOL-JES-FORM           /* A8
    #SPOOL-JES-FORMDEF     := ARO-SPOOL-JES-FORMDEF        /* A8
    #SPOOL-JES-PAGEDEF     := ARO-SPOOL-JES-PAGEDEF        /* A8
    #SPOOL-JES-TRC         := ARO-SPOOL-JES-TRC            /* A3
    #SPOOL-JES-RECFM       := ARO-SPOOL-JES-RECFM          /* A3
    IF ARO-SPOOL-JES-COPIES IS (N3)
      #SPOOL-JES-COPIES := VAL(ARO-SPOOL-JES-COPIES)       /* A3 := N3
    END-IF
    #SPOOL-JES-UCS         := ARO-SPOOL-JES-UCS            /* A4
    #SPOOL-JES-BURST       := ARO-SPOOL-JES-BURST          /* A3
    #SPOOL-JES-COMPACT     := ARO-SPOOL-JES-COMPACT        /* A8
    IF ARO-SPOOL-JES-LINECT IS (N3)
      #SPOOL-JES-LINECT := VAL(ARO-SPOOL-JES-LINECT)       /* A3 := N3
    END-IF
    #SPOOL-JES-DESTINATION := ARO-SPOOL-JES-DESTINATION    /* A8
    #SPOOL-JES-TRIGGER-DSNAME := ARO-SPOOL-JES-TRIGGER-DSNAME /* A44
    IF ARO-SPOOL-JES-DSNO IS (N5)
      #SPOOL-JES-DSNO := VAL(ARO-SPOOL-JES-DSNO)           /* A5 := N5
    END-IF
    /* 34 free
    /*
  VALUE NAT                  /* 0010
    IF ARO-SPOOL-NAF-DBID-OLD IS (N3)
      #SPOOL-NAF-DBID-OLD := VAL(ARO-SPOOL-NAF-DBID-OLD)   /* A3 := N3
    END-IF
    IF ARO-SPOOL-NAF-FNR-OLD IS (N3)
      #SPOOL-NAF-FNR-OLD := VAL(ARO-SPOOL-NAF-FNR-OLD)     /* A3 := N3
    END-IF
    #SPOOL-NAF-USER-ID     := ARO-SPOOL-NAF-USER-ID        /* A8
    IF ARO-SPOOL-NAF-PNR IS (N2)
      #SPOOL-NAF-PNR := VAL(ARO-SPOOL-NAF-PNR)             /* A2 := N2
    END-IF
    IF ARO-SPOOL-NAF-TIME-FORMAT = 'A'                     /* A1
      #SPOOL-NAF-TIME        := ARO-SPOOL-NAF-DATE-TIME    /* A15
    ELSE
      IF ARO-SPOOL-NAF-TIME-FORMAT = 'T'                   /* A1
        IF ARO-SPOOL-NAF-DATE-TIME IS (P13)
          RESET #SPOOL-NAF-TIME
          #P13 := VAL(ARO-SPOOL-NAF-DATE-TIME)             /* P13 := A15
          #NAF-TIMX := #P13                                /* T := P13
        END-IF
      ELSE
        RESET #SPOOL-NAF-TIME                              /* A15
      END-IF
    END-IF
    #SPOOL-NAF-NATPGM      := ARO-SPOOL-NAF-NATPGM         /* A8
    #SPOOL-NAF-NATLIB      := ARO-SPOOL-NAF-NATLIB         /* A8
    #SPOOL-NAF-FORM        := ARO-SPOOL-NAF-FORM           /* A8
    #SPOOL-NAF-PROFILE     := ARO-SPOOL-NAF-PROFILE        /* A8
    IF ARO-SPOOL-NAF-COPIES IS (N3)
      #SPOOL-NAF-COPIES := VAL(ARO-SPOOL-NAF-COPIES)       /* A3 := N3
    END-IF
    #SPOOL-NAF-NAME        := ARO-SPOOL-NAF-NAME           /* A8
    #SPOOL-NAF-DISP        := ARO-SPOOL-NAF-DISP           /* A1
    IF ARO-SPOOL-NAF-ST-ID IS (P10)
      #SPOOL-NAF-ST-ID := VAL(ARO-SPOOL-NAF-ST-ID)         /* A10 := P10
    END-IF
    IF ARO-SPOOL-NAF-DBID IS (N5)
      #SPOOL-NAF-DBID := VAL(ARO-SPOOL-NAF-DBID)           /* A5 := N5
    END-IF
    IF ARO-SPOOL-NAF-FNR IS (N5)
      #SPOOL-NAF-FNR := VAL(ARO-SPOOL-NAF-FNR)             /* A5 := N5
    END-IF
    #SPOOL-NAF-DEST        := ARO-SPOOL-NAF-DEST           /* A8
    #SPOOL-NAF-OUTPUT      := ARO-SPOOL-NAF-OUTPUT         /* A8
    #SPOOL-NAF-REST        := ARO-SPOOL-NAF-REST           /* 136 free
    /* byte 137 - 141 lost, needed for timestamp
  VALUE SEQUENTIAL-FILE-UNIX
    #SPOOL-UNIX-NODE-NAME  := ARO-SPOOL-UNIX-NODE-NAME        /* (A16)
    #SPOOL-UNIX-USERID     := ARO-SPOOL-UNIX-USERID           /* (A8)
    #SPOOL-UNIX-CIPHER-PASSWORD := ARO-SPOOL-UNIX-CIPHER-PASSWORD
    /* (A32)
    #SPOOL-UNIX-GROUP      := ARO-SPOOL-UNIX-GROUP            /* (A8)
    #SPOOL-UNIX-PATH       := ARO-SPOOL-UNIX-PATH             /* (A70)
    #SPOOL-UNIX-FILE-NAME  := ARO-SPOOL-UNIX-FILE-NAME        /* (A50)
    IF ARO-SPOOL-UNIX-CONTAINER-DBID IS (N5)    /* A5 = N5
      #SPOOL-UNIX-CONTAINER-DBID := VAL(ARO-SPOOL-UNIX-CONTAINER-DBID)
    END-IF
    IF ARO-SPOOL-UNIX-CONTAINER-FNR IS (N5)     /* A5 = N5
      #SPOOL-UNIX-CONTAINER-FNR := VAL(ARO-SPOOL-UNIX-CONTAINER-FNR)
    END-IF
    #SPOOL-UNIX-FILL       := ARO-SPOOL-UNIX-FILL          /* (A20)
    IF ARO-SPOOL-UNIX-SIZE IS (I4)
      #SPOOL-UNIX-SIZE := VAL(ARO-SPOOL-UNIX-SIZE)         /* A10 = I4
    END-IF
  NONE
    IF #LOG GT 0
      WRITE 'Warning: Unknown spool type' #SPOOL-TYPE
        'in portable report file.'
    END-IF
END-DECIDE
*
AR1.AR-SPOOL-ATTRIBUTES := #SPOOL-ATTRIBUTES            /* A250 := A250
*
AR1.AR-SPOOL-ATTR-EXTENDED(1:3)  := ARO-SPOOL-ATTR-EXTENDED(1:3)
/* A250/1:3
AR1.AR-USERID                  := ARO-USERID            /* A8
AR1.AR-NATRPT-DIST(*)          := ARO-NATRPT-DIST(*)    /* A8/1:10
AR1.AR-PRINTERS(*)             := ARO-PRINTERS(*)       /* A12/1:20
AR1.AR-HOLD-PRINT              := ARO-HOLD-PRINT        /* A1
AR1.AR-SEPMEM                  := ARO-SEPMEM            /* A16
IF ARO-SEPNO IS (P3)
  AR1.AR-SEPNO := VAL(ARO-SEPNO)                        /* A3 := P3
END-IF
AR1.AR-ACTIVE                  := ARO-ACTIVE            /* A1
AR1.AR-ARCHIVE                 := ARO-ARCHIVE           /* A1
AR1.AR-ARCHIVE-RETENTION       := ARO-ARCHIVE-RETENTION /* A5
IF ARO-ARCHIVE-RECNO IS (N8)
  AR1.AR-ARCHIVE-RECNO := VAL(ARO-ARCHIVE-RECNO)        /* A8 := N8
END-IF
IF ARO-ARCHIVE-DATE IS (P13)
  #P13 := VAL(ARO-ARCHIVE-DATE)                         /* P13 := A13
  AR1.AR-ARCHIVE-DATE := #P13                           /* T := P13
END-IF
AR1.AR-ARCHIVE-DATA-SET        := ARO-ARCHIVE-DATA-SET  /* A44
AR1.AR-ARCHIVE-VOLSER(*)       := ARO-ARCHIVE-VOLSER(*) /* A6/1:10
* AR1.AR-REVIVE                := ARO-REVIVE            /* A1
/* Report may be revived on source system, but is not revived on
/* target system (yet) => flag must be reset
RESET AR1.AR-REVIVE
* not set in test from SAGESM     /* GGS01
AR1.AR-REVIVE-EXPIRATION       := ARO-REVIVE-EXPIRATION /* A8
IF ARO-REVIVE-DATE IS (P13)
  #P13 := VAL(ARO-REVIVE-DATE)                           /* P13 := A13
  AR1.AR-REVIVE-DATE := #P13                             /* T := P13
END-IF

AR1.AR-REVIVE-RETENTION-PERIOD := ARO-REVIVE-RETENTION-PERIOD  /* A12
AR1.AR-CHARS                   := ARO-CHARS                    /* A20
* AR1.AR-DATASET-IDENTIFIER      := ARO-DATASET-IDENTIFIER       /* A25
IF ARO-DATASET-KEY IS (N7)
  AR1.AR-DATASET-KEY := VAL(ARO-DATASET-KEY)            /* A7 := N7
END-IF
IF ARO-DSNO IS (N3)
  AR1.AR-DSNO := VAL(ARO-DSNO)                          /* A3 := N3
END-IF
AR1.AR-DSTYPE                  := ARO-DSTYPE            /* A2
AR1.AR-FCB                     := ARO-FCB               /* A4
AR1.AR-FLASH                   := ARO-FLASH             /* A4
AR1.AR-FORM                    := ARO-FORM              /* A8
AR1.AR-FORMDEF                 := ARO-FORMDEF           /* A8
AR1.AR-GROUP-ID                := ARO-GROUP-ID          /* A20
AR1.AR-JOBNAME                 := ARO-JOBNAME           /* A10
IF ARO-JOBNO IS (N7)
  AR1.AR-JOBNO := VAL(ARO-JOBNO)                        /* A7 := N7
END-IF
AR1.AR-PROCNAME                := ARO-PROCNAME          /* A8
AR1.AR-DDNAME                  := ARO-DDNAME            /* A8
AR1.AR-PAGEDEF                 := ARO-PAGEDEF           /* A8
AR1.AR-RECFM                   := ARO-RECFM             /* A3
AR1.AR-STEPNAME                := ARO-STEPNAME          /* A8
AR1.AR-TRC                     := ARO-TRC               /* A3
IF ARO-COPIES IS (N3)
  AR1.AR-COPIES := VAL(ARO-COPIES)                      /* A3 := N3
END-IF
IF ARO-ARCHIVE-TYPE IS (N1)
  AR1.AR-ARCHIVE-TYPE := VAL(ARO-ARCHIVE-TYPE)          /* A1 := N1
END-IF
AR1.AR-STYLESHEET-URL          := ARO-STYLESHEET-URL    /* A70
AR1.AR-REP-FORMAT              := ARO-REP-FORMAT        /* A1
AR1.AR-SOURCE                  := ARO-SOURCE            /* A16
AR1.AR-SENDER                  := ARO-SENDER            /* A16
IF ARO-LAST-UPDATE IS (P13)
  #P13 := VAL(ARO-LAST-UPDATE)                          /* P13 := A13
  AR1.AR-LAST-UPDATE := #P13                            /* T := P13
END-IF
AR1.AR-LAST-UPDATE-USER        := ARO-LAST-UPDATE-USER  /* A16
AR1.AR-OBJECT-TYPE             := ARO-OBJECT-TYPE       /* A10
IF ARO-OBJECT-TIME IS (P13)
  #P13 := VAL(ARO-OBJECT-TIME)                          /* P13 := A13
  AR1.AR-OBJECT-TIME := #P13                            /* T := P13
END-IF
*
END-SUBROUTINE
*
*
*
***********************************************************************
DEFINE SUBROUTINE UPD-AR-WITH-I-REC
***********************************************************************
IF AR1.AR-REPNAME NE #REPNAME
  /* WRITE 'REPNAME' AR1.AR-REPNAME '<>' #REPNAME
  AR1.AR-REPNAME := #REPNAME
END-IF
IF AR1.AR-REPRNB NE #REPRNB
  /* WRITE 'REPRNB' AR1.AR-REPRNB '<>' #REPRNB
  AR1.AR-REPRNB := #REPRNB
END-IF
IF AR1.AR-NUMBER-OF-LINES NE #K-NUMLINES
  /* WRITE 'NUMBER-OF-LINES' AR1.AR-NUMBER-OF-LINES '<>' #K-NUMLINES
  AR1.AR-NUMBER-OF-LINES := #K-NUMLINES
END-IF
IF AR1.AR-USERID NE #K-USERID
  /* WRITE 'USERID' AR1.AR-USERID '<>' #K-USERID
  AR1.AR-USERID := #K-USERID
END-IF
IF AR1.AR-SEPMEM NE #K-SEPMEM
  /* WRITE 'SEPMEM' AR1.AR-SEPMEM '<>' #K-SEPMEM
  AR1.AR-SEPMEM := #K-SEPMEM
END-IF
IF AR1.AR-ARCHIVE-DATE NE #I-ARCHIVE-DATE-T
  /* WRITE 'ARCHIVE-DATE' AR1.AR-ARCHIVE-DATE '<>' #I-ARCHIVE-DATE-T
  AR1.AR-ARCHIVE-DATE := #I-ARCHIVE-DATE-T
END-IF
IF AR1.AR-ARCHIVE-DATA-SET NE #ARCHIVE-DSNAME
/* WRITE 'ARCHIVE-DATA-SET' AR1.AR-ARCHIVE-DATA-SET '<>' #ARCHIVE-DSNAME
  AR1.AR-ARCHIVE-DATA-SET := #ARCHIVE-DSNAME
END-IF
IF AR1.AR-CHARS NE #K-CHARS
  /* WRITE 'CHARS' AR1.AR-CHARS '<>' #K-CHARS
  AR1.AR-CHARS := #K-CHARS
END-IF
IF AR1.AR-DSNO NE #DSNO
  /* WRITE 'DSNO' AR1.AR-DSNO '<>' #DSNO
  AR1.AR-DSNO := #DSNO
END-IF
IF AR1.AR-DSTYPE NE #DSTYPE
  /* WRITE 'DSTYPE' AR1.AR-DSTYPE '<>' #DSTYPE
  AR1.AR-DSTYPE := #DSTYPE
END-IF
IF AR1.AR-FCB NE #K-FCB
  /* WRITE 'FCB' AR1.AR-FCB '<>' #K-FCB
  AR1.AR-FCB := #K-FCB
END-IF
IF AR1.AR-FLASH NE #K-FLASH
  /* WRITE 'FLASH' AR1.AR-FLASH '<>' #K-FLASH
  AR1.AR-FLASH := #K-FLASH
END-IF
IF AR1.AR-FORM NE #K-FORM
  /* WRITE 'FORM' AR1.AR-FORM '<>' #K-FORM
  AR1.AR-FORM := #K-FORM
END-IF
IF AR1.AR-JOBNAME NE #JOBNAME
  /* WRITE 'JOBNAME' AR1.AR-JOBNAME '<>' #JOBNAME
  AR1.AR-JOBNAME := #JOBNAME
END-IF
IF AR1.AR-JOBNO NE #JOBNO
  /* WRITE 'JOBNO' AR1.AR-JOBNO '<>' #JOBNO
  AR1.AR-JOBNO := #JOBNO
END-IF
IF AR1.AR-RECFM NE #K-RECFM
  /* WRITE 'RECFM' AR1.AR-RECFM '<>' #K-RECFM
  AR1.AR-RECFM := #K-RECFM
END-IF
IF AR1.AR-TRC NE #K-TRC
  /* WRITE 'TRC' AR1.AR-TRC '<>' #K-TRC
  AR1.AR-TRC := #K-TRC
END-IF
END-SUBROUTINE
*
*
*
***********************************************************************
DEFINE SUBROUTINE UPD-AR-LIKE-ARCHIVE
***********************************************************************
RESET AR1.AR-ARCHIVE-VOLSER(1:10)
AR1.AR-ARCHIVE-VOLSER(1) := AR1.AR-ARCHIVE-VOLSER(2) := 'FILSYS'
/*
AR1.AR-ARCHIVE := '*'
AR1.AR-CURRENT-LOCATION := 'A'
RESET AR1.AR-ACTIVE
/*
IF AR1.AR-ARCHIVE NE 'R'
  RESET AR1.AR-EXPIRATION AR1.AR-SOURCE-ID
END-IF
END-SUBROUTINE
*
*
*
***********************************************************************
DEFINE SUBROUTINE MA-WF-TO-DDM
***********************************************************************
MA1.MA-USERID := MAO-USERID
IF MAO-FO-ID = MASK (HHHH)
  MOVE EDITED MAO-FO-ID TO MA1.MA-FO-ID (EM=HHHH)       /* A4 := B2
END-IF
MA1.MA-REPNAME := MAO-REPNAME                           /* A25
IF MAO-REPRNB IS (P11)
  MA1.MA-REPRNB := VAL(MAO-REPRNB)                      /* A11 := P11
END-IF
IF MAO-INV-TIME IS (P13)                                /* A13 := P13
  MA1.MA-INV-TIME := VAL(MAO-INV-TIME)
END-IF
MA1.MA-STATUS := MAO-STATUS                             /* A1
FOR #CNTR = 1 TO 10
  IF MAO-FROM(#CNTR) IS (N3)                      /* A3/1:10 := P3/1:10
    MA1.MA-FROM(#CNTR) := VAL(MAO-FROM(#CNTR))
  END-IF
  IF MAO-TO(#CNTR) IS (N3)                        /* A3/1:10 := P3/1:10
    MA1.MA-TO(#CNTR) := VAL(MAO-TO(#CNTR))
  END-IF
END-FOR
IF MAO-HEADLINES IS (N3)
  MA1.MA-HEADLINES := VAL(MAO-HEADLINES)                /* A3 := N3
END-IF
MA1.MA-CURRENT-LOCATION := MAO-CURRENT-LOCATION         /* A1
/* MA1.MA-CURRENT-LOCATION := 'A'
IF MAO-PROCESS-TIME IS (P13)
  MA1.MA-PROCESS-TIME := VAL(MAO-PROCESS-TIME)          /* A13 := P13
END-IF
IF MAO-PROCESS-TIME-INV IS (P13)
  MA1.MA-PROCESS-TIME-INV := VAL(MAO-PROCESS-TIME-INV)  /* A13 := P13
END-IF
MA1.MA-OBJECT-TYPE := MAO-OBJECT-TYPE                   /* A10
IF MAO-OBJECT-TIME IS (P13)
  #P13 := VAL(MAO-OBJECT-TIME)
  MA1.MA-OBJECT-TIME := #P13                            /* A13 := T
END-IF
END-SUBROUTINE
*
*
*
***********************************************************************
DEFINE SUBROUTINE BACKOUT
***********************************************************************
NOMUS-FUNCTION := NOMUS-FCT-BACKOUT
CALLNAT NOM-USER-MAINTENANCE
  NOMUS-NOMVERS NOMUS-PARMS (*)
*
IF NOMUS-ERROR-CODE NE 0
  PRINT '=' NOMUS-ERROR-CODE
  PRINT '=' NOMUS-ERROR-TEXT
END-IF
END-SUBROUTINE
*
*
*
*
*
*
IF *MACHINE-CLASS = 'MAINFRAME'
  COMPRESS 'Machine-Class' *MACHINE-CLASS 'not supported.'
    INTO #OUT-STRING
  WRITE #OUT-STRING
  ESCAPE ROUTINE
END-IF
*
*
INPUT (AD=MIT'_' IP=OFF) 'Enter access code ..' #ACCESS-CODE
IF #ACCESS-CODE NE *PROGRAM
  WRITE 'Wrong access code. Stopping..'
  ESCAPE ROUTINE
END-IF
*
*
NOMUS-NOMVERS  := NOM-CURRENT-VERSION
NOMUS-USER     := *USER
NOMUS-LANGUAGE := *LANGUAGE
NOMUS-LOG-TYP  := 'U'
NOMUS-USER-ID  := *USER
RESET NOMUS-ERROR-CODE
  NOMUS-ERROR-TEXT
* read record from users file
RESET NOMUS-ATTR(*)
NOMUS-FUNCTION := NOMUS-FCT-READ
CALLNAT NOM-USER-MAINTENANCE
  NOMUS-NOMVERS NOMUS-PARMS (*)
IF NOMUS-ERROR-CODE NE 0
  PRINT '=' NOMUS-ERROR-CODE
  PRINT '=' NOMUS-ERROR-TEXT
  ESCAPE ROUTINE
END-IF
PERFORM BACKOUT
IF NOMUS-PROF-TYPE NE 'A'
  WRITE 'User' NOMUS-USER-ID 'is not an administrator. The type is'
    NOMUS-PROF-TYPE
    / 'Stopping ...'
  ESCAPE ROUTINE
END-IF
*
* Enter entry in Monitor log
*
PL-PARMS.LG-USERID := *USER
PL-PARMS.LG-CODE   :=  'MO'
COMPRESS 'Program' *PROGRAM 'started' INTO PL-PARMS.LG-MSG
CALLNAT 'RLOG' PL-PARMS
END TRANSACTION
*
*
*
*
*
*
#PORTABLE-DSNAME := '*.P'
#PATH := '$HOME'
#ALL-MAIL-RECS-TO-SAGESM := 'N'
#LOG := 1
#LOAD := 'N'
*
INPUT (AD=MIW'_' IP=OFF CD=NE)
  /// 'Read Portable Archive and Data (Work File 1):' (YEI)
  / '-' (45) (YEI) /
  / 'Portable Archive Path .......' (TU) #PATH (AL=44)
  / 'Portable Archive Name .......' (TU) #PORTABLE-DSNAME
  / 'Log output ...............' (TU) #LOG '(0-3)'
  /// 'Press enter to continue.     ' (TU)
*
IF *PF-KEY = 'PF3' OR #PATH = MASK('.')
  ESCAPE ROUTINE
END-IF
*
IF #PORTABLE-DSNAME = SCAN('*') OR = SCAN('?')
  #FILE := 'lsout.txt'
  COMPRESS #PATH '/' #FILE INTO #PATH-FILE LEAVING NO
  COMPRESS H'22' #PATH '/' #FILE H'22' INTO #PATH-FILE-22 LEAVING NO
  COMPRESS 'ls' #PATH '>' #PATH-FILE-22 INTO #OS-CMD
  CALL 'SHCMD' #OS-CMD 'SCREENIO'
  #RC := RET('SHCMD')
  IF #RC = 0 THEN
    DEFINE WORK FILE 8 #PATH-FILE
    MASK := #PORTABLE-DSNAME
    READ WORK FILE 8 #ENTRIES-LINE
      /* WILDCARD default is '?', ASTERISK default is '*'
      /* MATCHED return value 'Y' or 'N'
      FIELD := #ENTRIES-LINE
      RESET LENGTH
      CALLNAT 'NAT00083' FIELD MASK WILDCARD ASTERISK LENGTH MATCHED
      IF MATCHED = 'Y'
        #PORTABLE-DSNAME := #ENTRIES-LINE
        PERFORM ADD-ARC-TO-ARRAY
      END-IF
    END-WORK
  ELSE
    IF #LOG GT 1
      WRITE '''ls > lsout.txt'' error, RC=' #RC
    END-IF
  END-IF
*
  COMPRESS 'rm' #PATH-FILE INTO #OS-CMD
  CALL 'SHCMD' #OS-CMD 'SCREENIO'
  #RC := RET('SHCMD')
  IF #RC = 0 THEN
    IGNORE
  ELSE
    IF #LOG GT 1
      WRITE '''rm lsout.txt'' error, RC=' #RC
    END-IF
  END-IF
*
ELSE
  PERFORM ADD-ARC-TO-ARRAY
END-IF
*
IF #LOG GT 0
  WRITE 'Portable files found'
    / '--------------------'
  FOR #XDIM = 1 TO *OCC(#PORTABLE-DSNAME-A)
    WRITE #XDIM #PORTABLE-DSNAME-A(#XDIM) (AL=50)
  END-FOR
END-IF
*
*
*
*
FOR #XDIM = 1 TO *OCC(#PORTABLE-DSNAME-A)
*
  COMPRESS #PATH '/' #PORTABLE-DSNAME-A(#XDIM) INTO #WF-1 LEAVING NO
  DEFINE WORK FILE 1 #WF-1 TYPE 'ASCII'
*
  READ WORK FILE 1 #TEXT-RECORD GIVING LENGTH #RECORD-LENGTH
    DECIDE ON FIRST VALUE OF #T-RECORD-TYPE
      VALUE 'A'     /* NRM-ARCHIVE-DATASET
        ADO := #TEXT-RECORD
        #ARCHIVE-DSNAME := ADO-ARCHIVE-DSNAME
        IF #ARCHIVE-DSNAME-1ST = '$'
          RESET #ARCHIVE-DSNAME-1ST
          MOVE LEFT #ARCHIVE-DSNAME TO #ARCHIVE-DSNAME
        END-IF
      VALUE 'I'
        WF-ID-RECORD := #TEXT-RECORD
        ESCAPE BOTTOM
      NONE IGNORE
    END-DECIDE
  END-WORK
  CLOSE WORK 1
*
*
  FUNCTION_CODE := 5
  L_FILE := 91
  CALLNAT 'NAT23001' PARAMETER_BLOCK P_RESP
  COMPRESS '(' DBID ',' FNR ')' INTO #NOM-AD LEAVING NO
*
  ENV-VARIABLE := 'EOM_ARC'
  CALLNAT 'NAT00081'  NAD00081
  #EOM_ARC := CHAR-STRING
  ENV-VARIABLE := 'ONEMAILREC'
  RESET CHAR-STRING
  CALLNAT 'NAT00081'  NAD00081
  IF CHAR-STRING NE ' '
    INPUT (AD=MIW'_' IP=OFF CD=NE)
      /// 'Write Archive to $EOM_ARC (Work File 2) and LFILE 91:' (YEI)
      / '-' (53) (YEI) /
      / 'NOM Active Data (LFILE 91) ..' (TU) #NOM-AD (AD=ODL CD=TU)
      / 'Portable File Name ..........' (TU) #PORTABLE-DSNAME-A(#XDIM)
      (AD=ODL AL=40 CD=TU)
      / '$EOM_ARC ....................' (TU) #EOM_ARC
      (AD=ODL AL=40 CD=TU)
      / 'Archive File Name ...........' (TU) #ARCHIVE-DSNAME
      / 'Load Archive and Reports ....' (TU) #LOAD '(Y/N)'
      / 'Add 1 entry only to NRM-MAIL: SAGESM -'
      / '  #Listeneingang/#Inbasket ..' (TU) #ALL-MAIL-RECS-TO-SAGESM
      '(Y/N)'
  ELSE
*
    INPUT (AD=MIW'_' IP=OFF CD=NE)
      /// 'Write Archive to $EOM_ARC (Work File 2) and LFILE 91:' (YEI)
      / '-' (53) (YEI) /
      / 'NOM Active Data (LFILE 91) ..' (TU) #NOM-AD (AD=ODL CD=TU)
      / 'Portable File Name ..........' (TU) #PORTABLE-DSNAME-A(#XDIM)
      (AD=ODL AL=40 CD=TU)
      / '$EOM_ARC ....................' (TU) #EOM_ARC
      (AD=ODL AL=40 CD=TU)
      / 'Archive File Name ...........' (TU) #ARCHIVE-DSNAME
      / 'Load Archive and Reports ....' (TU) #LOAD '(Y/N)'
  END-IF
*
  IF *PF-KEY = 'PF3' OR #ARCHIVE-DSNAME = MASK('.')
    ESCAPE BOTTOM
  END-IF
  IF #LOAD = 'N'
    WRITE 'Skipping archive' #ARCHIVE-DSNAME
    ESCAPE TOP
  END-IF
*
  /* Add entry to user log
  PL-PARMS.LG-USERID      := *USER
  PL-PARMS.LG-CODE        := 'UI'   /* User information
  PL-PARMS.LG-OBJECT-NAME := *PROGRAM
  COMPRESS #PORTABLE-DSNAME-A(#XDIM) 'loading.'
    INTO PL-PARMS.LG-MSG
  CALLNAT 'RLOG' PL-PARMS
  END TRANSACTION
*
  COMPRESS '$EOM_ARC/' #ARCHIVE-DSNAME INTO #WF-2 LEAVING NO
  DEFINE WORK FILE 2 #WF-2 TYPE 'PORTABLE'
*
*
  COMPRESS CHAR-STRING '/' #ARCHIVE-DSNAME INTO CHAR-STRING LEAVING NO
  IF #LOG GT 0
    WRITE 'Reading from portable Work File 1' #WF-1
      / 'Writing to LFILE 91 and archive Work File 2'
      #ARCHIVE-DSNAME (AL=35)
  END-IF
*
  PERFORM CHECK-ARC-DS
  IF #ARC-EXISTS
    IF #LOG GT 0
      WRITE 'Skipping archive'
    END-IF
    ESCAPE TOP
  END-IF
*
  COMPRESS 'ls' CHAR-STRING '1>/dev/null 2>&1' INTO #OS-CMD /*
  CALL 'SHCMD' #OS-CMD 'NOSCREENIO'
  #RC := RET('SHCMD')
  IF #RC = 0 THEN
    COMPRESS CHAR-STRING 'already exists.' INTO #OUT-STRING
    IF #LOG GT 0
      WRITE #OUT-STRING
        / 'Archive will be replaced.'
        /
    END-IF
  END-IF
*
  RESET #CNT
  ADD 1 TO #ARCS-TOTAL
*
  READ WORK FILE 1 #TEXT-RECORD GIVING LENGTH #RECORD-LENGTH
*
    DECIDE ON FIRST VALUE OF #T-RECORD-TYPE
      VALUE 'A'     /* NRM-ARCHIVE-DATASET
        ADO := #TEXT-RECORD
        RESET AD1
        /*
*       AD1.AD-ARCHIVE-DSNAME := ADO-ARCHIVE-DSNAME          /* A44
        /* Use DS/file name from INPUT
        AD1.AD-ARCHIVE-DSNAME := #ARCHIVE-DSNAME             /* A44
        IF ADO-CREATED IS (P13)
          #P13 := VAL(ADO-CREATED)
          AD1.AD-CREATED := #P13                             /* A13 := T
        END-IF
        IF ADO-CREATED-INV IS (P13)
          #P13 := VAL(ADO-CREATED-INV)
          AD1.AD-CREATED-INV := #P13                         /* A13 := T
        END-IF
        /* ADO-EXPIRATION-DATE := '20211231'        /* GGS01
        AD1.AD-EXPIRATION-DATE := ADO-EXPIRATION-DATE        /* A8
        /* ADO-EXPIRATION-DATE-PHYS := '20211231'   /* GGS01
        AD1.AD-EXPIRATION-DATE-PHYS := ADO-EXPIRATION-DATE-PHYS /* A8
        AD1.AD-CONDENSE-OUTPUT := ADO-CONDENSE-OUTPUT        /* A1
        IF ADO-ORIGINAL-REPORT-COUNT IS (P7)                 /* A7 = P7
          AD1.AD-ORIGINAL-REPORT-COUNT := VAL(ADO-ORIGINAL-REPORT-COUNT)
        END-IF
        FOR #CNTR = 1 TO 20
          IF ADO-VOLSERS(#CNTR) NE ' '
            ADO-VOLSERS(#CNTR) := 'FILSYS'
          END-IF
          AD1.AD-VOLSERS(#CNTR) := ADO-VOLSERS(#CNTR)        /* A6/1:20
        END-FOR
        AD1.AD-MARK-FOR-CONDENSE := ADO-MARK-FOR-CONDENSE    /* A1
        IF ADO-ARCHIVE-TYPE IS (N1)
          AD1.AD-ARCHIVE-TYPE := VAL(ADO-ARCHIVE-TYPE)       /* A1 := N1
        END-IF
        AD1.AD-OBJECT-TYPE := ADO-OBJECT-TYPE                /* A10
        IF ADO-OBJECT-TIME IS (P13)
          #P13 := VAL(ADO-OBJECT-TIME)
          AD1.AD-OBJECT-TIME := #P13                         /* A13 := T
        END-IF
        /*
        /* Check if not already there
        /* Adapt timestamps
        /* Check what is done in subroutine UPD-AR for NRM-
        /*
        STORE AD1
        ADD 1 TO #ET      /* BLI >>
        IF #ET > 500
          END TRANSACTION
          RESET #ET
        END-IF            /* << BLI
        /*
        IF #LOG GT 2
          WRITE 'Stored in NRM-ARCHIVE-DATASET:' AD1.AD-ARCHIVE-DSNAME
        END-IF
        /*
      VALUE 'D'    /* NRM-DATASET-REPORT
        /*
        DRO := #TEXT-RECORD
        RESET DR1
        /*
        IF #LOG GT 1
          WRITE 'Processing report:' DRO-REPNAME DRO-REPRNB
        END-IF
        /* Check for duplicates, before any record will be written
        #AR-REPNAME := DRO-REPNAME
        IF DRO-REPRNB IS (P11)
          #AR-REPRNB := VAL(DRO-REPRNB)
        END-IF
        FIND NUMBER DR1 WITH DR-REPORT-RNB = #AR1-KEY
        IF *NUMBER >  0
          DREPL. FIND DR1 WITH DR-REPORT-RNB = #AR1-KEY   /* BLI
            IF DR1.DR-ARCHIVE-DSNAME NE #ARCHIVE-DSNAME
              WRITE 'Error: Duplicate entry in NRM-DATASET-REPORT'
                / 'An entry for report' #AR-REPNAME 'with Rnb'
                #AR-REPRNB
                / 'already exists for archive' DR1.DR-ARCHIVE-DSNAME
                / 'Replacing it' /* BLI
              DELETE(DREPL.)     /* BLI
              ESCAPE BOTTOM
            END-IF
          END-FIND
        END-IF
        FIND NUMBER AR1 WITH AR-REPORT-RNB = #AR1-KEY
        IF *NUMBER >  0
          AREPL. FIND AR1 WITH AR-REPORT-RNB = #AR1-KEY         /* BLI
            IF AR1.AR-ARCHIVE-DATA-SET = #ARCHIVE-DSNAME
              WRITE 'Error: Duplicate entry in NRM-ACTIVE-REPORTS'
                / 'An entry for report' #AR-REPNAME 'with Rnb'
                #AR-REPRNB
                / 'already exists for archive' AR1.AR-ARCHIVE-DATA-SET
                / 'Replacing the Active Report'                 /* BLI
              DELETE (AREPL.)                                   /* BLI
              ESCAPE BOTTOM
            END-IF
          END-FIND
        END-IF
        /*
*       DR1.DR-ARCHIVE-DSNAME := DRO-ARCHIVE-DSNAME             /* A44
        /* Use DS/file name from INPUT
        DR1.DR-ARCHIVE-DSNAME := #ARCHIVE-DSNAME                /* A44
        DR1.DR-REPNAME        := DRO-REPNAME                    /* A25
        IF DRO-REPRNB IS (P11)
          DR1.DR-REPRNB := VAL(DRO-REPRNB)               /* A11 := P11
        END-IF
        DR1.DR-STATUS               := DRO-STATUS               /* A1
        /* DRO-EXPIRATION-DATE := '20211231'        /* GGS01
        DR1.DR-EXPIRATION-DATE      := DRO-EXPIRATION-DATE      /* A8
        /* not set in test from SAGESM              /* GGS01
        DR1.DR-EXPIRATION-DATE-ORIG := DRO-EXPIRATION-DATE-ORIG /* A8
        DR1.DR-OBJECT-TYPE          := DRO-OBJECT-TYPE          /* A10
        IF DRO-OBJECT-TIME IS (P13)
          #P13 := VAL(DRO-OBJECT-TIME)
          DR1.DR-OBJECT-TIME := #P13                     /* A13 := T
        END-IF
        /*
        /*
        STORE DR1
        ADD 1 TO #ET      /* BLI >>
        IF #ET > 500
          END TRANSACTION
          RESET #ET
        END-IF            /* << BLI
        /*
        IF #LOG GT 2
          WRITE 'Stored in NRM-DATASET-REPORT:' DR1.DR-ARCHIVE-DSNAME
        END-IF
        /*
      VALUE 'I'
        /*
        IF #ALL-MAIL-RECS-TO-SAGESM = 'Y'
          RESET  #FIRST-REC
        END-IF
        RESET #ID-RECORD
        WF-ID-RECORD := #TEXT-RECORD
        /*
        #I-RECORD-TYPE := WF-RECORD-TYPE  /* A1  ALWAYS 'I'
        #ARCHIVE-FROM  := WF-ARCHIVE-FROM /* A1
        /* S-SPOOL, D-DATABASE, C-CONNECT
        #REPNAME       := WF-REPNAME      /* A25 := A25
        IF WF-REPRNB IS (P11)
          #REPRNB      := VAL(WF-REPRNB)  /* P7 TO A11
        END-IF
        #JOBNAME       := WF-JOBNAME      /* A8
        IF WF-JOBNO IS (N7)
          #JOBNO       := VAL(WF-JOBNO)   /* N7 TO A7
        END-IF
        IF WF-NODE IS (N5)
          #NODE        := VAL(WF-NODE)    /* N5 TO A5
        END-IF
        #DSTYPE        := WF-DSTYPE       /* A2
        IF WF-DSNO IS (N7)
          #DSNO        := VAL(WF-DSNO)    /* N7 TO A7
        ELSE
          RESET #DSNO-A7
        END-IF
        IF WF-I-ARCHIVE-DATE IS (P13)     /* P13(T) TO A13
          #I-ARCHIVE-DATE := VAL(WF-I-ARCHIVE-DATE)
        END-IF
        #K-CABINET     := WF-CABINET      /* A8
        #K-INDICATOR   := WF-INDICATOR    /* A3
        #K-CHARS       := WF-CHARS        /* A16
        #K-RECFM       := WF-RECFM        /* A3
        #K-FCB         := WF-FCB          /* A4
        #K-FLASH       := WF-FLASH        /* A4
        #K-FORM        := WF-FORM         /* A8
        #K-TRC         := WF-TRC          /* A3
        #K-SEPMEM      := WF-SEPMEM       /* A8
        IF WF-CREATED IS (P13)
          #P13         := VAL(WF-CREATED) /* P13 TO A13 := T
          #K-CREATED   := #P13
        END-IF
        IF WF-NUMLINES IS (P7)            /* P7 TO A7
          #K-NUMLINES  := VAL(WF-NUMLINES)
        END-IF
        #K-USERID      := WF-USERID       /* A8
        /*
        /*
        RESIZE DYNAMIC #WKF-RECORD TO 0
        #WKF-RECORD := #ID-RECORD
        /*
        WRITE WORK FILE 2 VARIABLE #WKF-RECORD
        /*
        ADD 1 TO #CNT
        IF #LOG GT 2
          WRITE 'Report I-header:' #REPNAME 'Rnb:' #REPRNB
        END-IF
        /*
      VALUE 'R'    /* NRM-ACTIVE-REPORTS
        ARO := #TEXT-RECORD
        RESET AR1 #SPOOL-ATTRIBUTES

        #AR-REPNAME := ARO-REPNAME
        IF ARO-REPRNB IS (P11)
          #AR-REPRNB := VAL(ARO-REPRNB)
        END-IF
        IF #AR-REPNAME NE #REPNAME OR
            #AR-REPRNB NE #REPRNB
          IF #LOG GT 0
            WRITE 'Key from I-rec:' #REPNAME #REPRNB 'and AR-rec:'
              #AR-REPNAME #AR-REPRNB 'do not match'
          END-IF
        END-IF
        FIND NUMBER AR1 WITH AR-REPORT-RNB = #AR1-KEY
        IF *NUMBER =  0
          PERFORM AR-WF-TO-DDM
          PERFORM UPD-AR-WITH-I-REC
          PERFORM UPD-AR-LIKE-ARCHIVE /* Set flags for "archived"
          STORE AR1
        ELSE
          /* Should not happen
          FIND AR1 WITH AR-REPORT-RNB = #AR1-KEY
            PERFORM AR-WF-TO-DDM
            PERFORM UPD-AR-WITH-I-REC
            PERFORM UPD-AR-LIKE-ARCHIVE /* Set flags for "archived"
            UPDATE
          END-FIND
        END-IF
        ADD 1 TO #ET      /* BLI >>
        IF #ET > 500
          END TRANSACTION
          RESET #ET
        END-IF            /* << BLI
        /*
        IF #LOG GT 2
          WRITE 'Stored in NRM-ACTIVE-REPORTS:' #AR-REPNAME 'Rnb:'
            #AR-REPRNB
        END-IF
        /*
      VALUE 'M'    /* NRM-MAIL
        /*
        MAO := #TEXT-RECORD
        RESET MA1
        /*
        /*
        #MA-REPNAME := MAO-REPNAME
        IF MAO-REPRNB IS (P11)
          #MA-REPRNB := VAL(MAO-REPRNB)
        END-IF
        #MA-USERID := MAO-USERID
        /*
        IF #ALL-MAIL-RECS-TO-SAGESM = 'Y'
          IF NOT #FIRST-REC
            /* Add uid SAGESM for #Listeneingang/#Inbasket only
            MAO-FO-ID := '0001'
            #MA-USERID := MAO-USERID := 'SAGESM'
          END-IF
        ELSE
          /*                                   GGS02 >>
          /* 1. FO-ID '0001' is always #Listeneingang/#Inbasket and does not
          /* need to be adapted.
          /* 2. If no folder name is delivered, the FO-ID cannot be adapted.
          IF MAO-FO-ID NE '0001' AND MAO-FO-NAME NE ' '
            #FO-USER-ID := MAO-USERID
            #FO-NAME    := MAO-FO-NAME
            RESET #FO-ID-A4
            FIND FO1 WITH FO-USER-NAME = #FO-USER-NAME
              IF NO RECORDS FOUND
                /* No usable folder exists, may cause problems
                /* when the folder will be created after the MAIL record
                /* and a different FO-ID will be generated.
                #FO-ID-A4 := 'none'
                ESCAPE BOTTOM
              END-NOREC
              MOVE EDITED FO1.FO-ID (EM=HHHH) TO #FO-ID-A4
            END-FIND
            IF #FO-ID-A4 = 'none'
              IF #LOG GT 0
                COMPRESS 'Folder' #FO-NAME 'for user' #FO-USER-ID 'not found.'
                  INTO #OUT-STRING
                WRITE NOTITLE NOHDR #OUT-STRING (AL=72)
                WRITE 'Entering uid SAGESM for #Listeneingang/#Inbasket instead,'
                WRITE 'if it does not already exist.'
              END-IF
              MAO-FO-ID := '0001'
              #MA-USERID := MAO-USERID := 'SAGESM'
            ELSE
              IF MAO-FO-ID = #FO-ID-A4
                IGNORE
                /* Folder ID from source system is equal to target system
                /* No problem will come up, active reports will be found
              ELSE
                /* Folder ID from source system is not equal to target system
                /* Active reports may not be found, take existing FO-ID from
                /* target
                IF #LOG GT 2
                  COMPRESS 'FO-ID changed' MAO-FO-ID '>' #FO-ID-A4
                    'in mail rec for' #MA-REPNAME 'and' MAO-FO-NAME
                    INTO #OUT-STRING
                  WRITE NOTITLE NOHDR #OUT-STRING (AL=72)
                END-IF
                MAO-FO-ID := #FO-ID-A4
              END-IF
            END-IF
          END-IF
        END-IF
        /*                                   << GGS02
        IF NOT #FIRST-REC
          IF MAO-FO-ID = MASK (HHHH)
            MOVE EDITED MAO-FO-ID TO #MA-FO-ID (EM=HHHH)
          END-IF
          FIND NUMBER MA1 WITH MA-FOLDER-REP-RNB = #MA-FOLDER-REP-RNB
          IF *NUMBER = 0
            PERFORM MA-WF-TO-DDM
            STORE MA1
          ELSE
            FIND MA1 WITH MA-FOLDER-REP-RNB = #MA-FOLDER-REP-RNB
              PERFORM MA-WF-TO-DDM
              UPDATE
            END-FIND
          END-IF
          ADD 1 TO #ET      /* BLI >>
          IF #ET > 500
            END TRANSACTION
            RESET #ET
          END-IF            /* << BLI
          IF #ALL-MAIL-RECS-TO-SAGESM = 'Y'
            #FIRST-REC := TRUE
          END-IF
          /*
          IF #LOG GT 2
            COMPRESS 'Stored in NRM-MAIL:' #MA-REPNAME 'Uid:' #MA-USERID
              'Fo-id:' #MA-FO-ID 'Rnb:' #MA-REPRNB
              INTO #OUT-STRING
            WRITE #OUT-STRING
          END-IF
        END-IF
        /*
        /*
      VALUE 'T'
        /*
        IF #RECORD-LENGTH > 252
          IF #LOG GT 0
            WRITE 'Warning: Record length =' #RECORD-LENGTH 'is > 252'
          END-IF
        END-IF
        /* Compress archive records
        COMPCB-OP:='C'
        COMPCB-CHAR:='N'                  /* 'N' - New parm list
        SUBTRACT 1 FROM #RECORD-LENGTH
        COMPCB-ILEN := #RECORD-LENGTH
        COMPCB-ILEN-OLD := #RECORD-LENGTH /* For compat
        IF #RECORD-LENGTH > 251
          COMPCB-ILEN := 251
          COMPCB-ILEN-OLD := 251           /* For compat
        END-IF
        RESET #F-TEXT
        IF #SPOOL-TYPE =  SEQUENTIAL-FILE-BS2  /* 0007        GGS03 >>
            AND SUBSTR(#T-TEXT,1,1) = H'00'
          MOVE ' ' TO SUBSTR(#T-TEXT,1,1)
        END-IF                                             /* GGS03
        CALLNAT 'R-NRMCMP' COMPCB #T-TEXT #F-TEXT
          G-NATRP-ERC G-NATRP-ERT
        #RECORD-LENGTH := COMPCB-OLEN
        RESET COMPCB-OLEN                 /* Zero output length
        IF #RECORD-LENGTH = 0             /* still using old nsmcmp ?
          #RECORD-LENGTH := COMPCB-OLEN-OLD
        END-IF
        ADD 1 TO #RECORD-LENGTH
        #T-TEXT := #F-TEXT
        /*
        RESIZE DYNAMIC #WKF-RECORD TO 0
        MOVE SUBSTR (#TEXT-RECORD,1,#RECORD-LENGTH) TO #WKF-RECORD
        WRITE WORK FILE 2 VARIABLE #WKF-RECORD
        /*
        RECORDS-WRITTEN := TRUE
        /*
      VALUE 'E'
        #END-FOUND := TRUE
      NONE VALUE
        IF #LOG GT 0
          WRITE 'Warning: Unknown Record type' #T-RECORD-TYPE
            'in portable report file.'
        END-IF
    END-DECIDE
*
  END-WORK
*
  CLOSE WORK 1
  CLOSE WORK 2
*
  /* Add entry to user log
  PL-PARMS.LG-USERID      := *USER
  PL-PARMS.LG-CODE        := 'UI'   /* User information
  PL-PARMS.LG-OBJECT-NAME := *PROGRAM
  COMPRESS #ARCHIVE-DSNAME 'created with' #CNT 'reports.'
    INTO PL-PARMS.LG-MSG
  CALLNAT 'RLOG' PL-PARMS
  END TRANSACTION
  /*
  /*
  IF #LOG GT 0
    COMPRESS #CNT 'reports loaded to' #ARCHIVE-DSNAME
      INTO #OUT-STRING2
    IF #END-FOUND
      COMPRESS 'Load archive no.' #XDIM 'finished, all records read.'
        INTO #OUT-STRING
      WRITE NOTITLE NOHDR #OUT-STRING (AL=54)
        *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
        / #OUT-STRING2
    ELSE
      COMPRESS 'Load archive no.' #XDIM 'not finished correct.'
        INTO #OUT-STRING
      WRITE NOTITLE NOHDR #OUT-STRING (AL=54)
        *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
        / 'Warning: end marker not found.'
        / #OUT-STRING2
    END-IF
  END-IF
*
  IF AD1.AD-ORIGINAL-REPORT-COUNT NE #CNT
    FIND  AD1 WITH AD-ARCHIVE-DSNAME = #ARCHIVE-DSNAME
      AD1.AD-ORIGINAL-REPORT-COUNT := #CNT
      UPDATE
    END-FIND
    END TRANSACTION
  END-IF
*
  ADD #CNT TO #CNT-TOTAL
*
END-FOR
*
WRITE '-' (7) / 'Summary' / '-' (7)
COMPRESS #ARCS-TOTAL 'archive(s) with total' #CNT-TOTAL
  'reports loaded.' INTO #OUT-STRING
WRITE #OUT-STRING
  / '-' (15)
  / 'End processing.'
  / '-' (15)
*
REDUCE ARRAY #PORTABLE-DSNAME-A TO 0
*
END
