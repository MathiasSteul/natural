* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RDELCF - Confirm deletion of an Object
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 #P-OBJECT          (A10)
1 #P-RELATIONS-EXIST (L)
1 #P-CONFIRMED       (L)
************************************************************************
LOCAL
1 #OBJECT            (A10)
1 #ERC               (N4)
1 #CV                (C)     INIT <(AD=DP)>
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET #P-CONFIRMED
SET CONTROL 'Y41'
SET CONTROL 'WC06L49B10/15F'
SET CONTROL 'M3'
IF #P-RELATIONS-EXIST
  #ERC := 26
END-IF
INPUT WITH TEXT *#ERC USING MAP 'RDELCFM&'
DECIDE FOR FIRST CONDITION
  WHEN *PF-KEY = 'PF3'
    IGNORE
  WHEN #P-OBJECT NE #OBJECT
    REINPUT *0004 MARK *#OBJECT
  WHEN NONE
    #P-CONFIRMED := TRUE
END-DECIDE
SET CONTROL 'WB'
SET CONTROL 'YB'
END
