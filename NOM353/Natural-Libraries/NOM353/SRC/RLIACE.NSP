************************************************************************
* Main line
************************************************************************
*
DEFINE WINDOW WARNING
*
RESET L-SCREEN-SAVE-AREA /*SU5
CALLNAT 'NARPSEC' G-USER-PROFILE 'DAC' #ALLOWED
INCLUDE C-NALLOW
*
CALLNAT 'NARPSEC' G-USER-PROFILE 'MAC' #UPDATE
CALLNAT 'NARPSEC' G-USER-PROFILE 'PAC' #DELETE
CALLNAT 'NARPSEC' G-USER-PROFILE 'ARC' #ARCHIVE
CALLNAT 'NARPSEC' G-USER-PROFILE 'REV' #REVIVE
*
DECIDE ON FIRST *DATA
  VALUE -1,0
    INCLUDE C-ESCAPE
  VALUE 1,6 /*SU5 1,2
    INPUT #S-REPNAME #S-KEYWORD (*) #S-AND /*SU5
    #O-REPNAME := #S-REPNAME
    #REPNAME   := #S-REPNAME
    #PAGE := 1
    PERFORM INITIALISATION
    GET-SCREEN := TRUE
    #FATHER-PROG := 'RLISRP'
  VALUE 8 /*SU5 was 3,4
    INPUT #S-REPNAME #S-USER-ID #S-FO-ID #S-KEYWORD (*) #S-AND /*SU5
    #O-REPNAME := #S-REPNAME
    #REPNAME   := #S-REPNAME
    #PAGE := 1
    PERFORM INITIALISATION
    GET-SCREEN := TRUE
    #FATHER-PROG := 'RLIACS'
    PERFORM READ-FOLDER
  NONE /* *DATA = 7 see #7
    PERFORM READ-FROM-STACK
    PERFORM INIT-LINECOM
    PERFORM LINE-COMMANDS
    #DEF-LOC := #S-LOCATION
END-DECIDE
/*SU5 -> #L-KEYWORD := #S-KEYWORD
/* EXAMINE #L-KEYWORD '*' GIVING POSITION #K-LEN IF #K-LEN > 0
/*SU5 <- RESET #L-KEYWORD-V (#K-LEN:15) SUBTRACT 1 FROM #K-LEN END-IF
FOR #I-KY=1 TO 4 /*SU5
  CALLNAT 'SELALPHA' #S-KEYWORD (#I-KY) #F-KY (#I-KY) #T-KY(#I-KY) #L-15
END-FOR
IF #S-EXPDATE NE ' '
  CALLNAT 'IODATE-N' 'M' 'L' #S-EXPDATE #L-EXPDATE G-DATE-FORMAT
    #ERROR-CODE #ERROR-TEXT
  IF #ERROR-CODE NE 0
    #S-EXPDATE := #L-EXPDATE := ' '
  ELSE
    #O-EXPDATE := #L-EXPDATE
  END-IF
END-IF
*
PERFORM INIT-TEXT
G-CALLER := *PROGRAM
*
IF #S-DATE = ' ' AND #S-ARCHIVE-FLAG = ' ' AND #S-REVIVE-FLAG = ' '
AND #S-LOCATION = ' '                                                 /*
  DECIDE FOR EVERY CONDITION
    WHEN #S-MAILED = ' ' AND +G-RLIACE-SEL-MAILED-OK NE ' '
      #S-MAILED     := +G-RLIACE-SEL-MAILED-OK
      #S-MAILED-F   := +G-RLIACE-SEL-MAILED-F-OK
      #S-MAILED-F-P := #S-MAILED-F
      #S-MAILED-T   := +G-RLIACE-SEL-MAILED-T-OK
      #S-MAILED-T-P := #S-MAILED-T
      #O-MAILED     := #S-MAILED
    WHEN #S-DATE = ' ' AND +G-RLIACE-SEL-DATE-OK NE ' '
      #S-DATE     := +G-RLIACE-SEL-DATE-OK
      #S-DATE-F   := +G-RLIACE-SEL-DATE-F-OK
      #S-DATE-F-P := #S-DATE-F
      #S-DATE-T   := +G-RLIACE-SEL-DATE-T-OK
      #S-DATE-T-P := #S-DATE-T
      #O-DATE     := #S-DATE
    WHEN #S-ARCHIVE-FLAG = ' ' AND +G-RLIACE-SEL-ARC-FLAG-OK NE ' '
      #S-ARCHIVE-FLAG := +G-RLIACE-SEL-ARC-FLAG-OK
      #O-ARCHIVE-FLAG := #S-ARCHIVE-FLAG
    WHEN #S-REVIVE-FLAG = ' ' AND +G-RLIACE-SEL-REV-FLAG-OK NE ' '
      #S-REVIVE-FLAG := +G-RLIACE-SEL-REV-FLAG-OK
      #O-REVIVE-FLAG := #S-REVIVE-FLAG
    WHEN #S-LOCATION = ' ' AND +G-RLIACE-SEL-LOCATION-OK NE ' '
        AND #FATHER-PROG = 'RLISRP'
      #S-LOCATION := +G-RLIACE-SEL-LOCATION-OK
    WHEN ANY
      GET-SCREEN := NEW-SEARCH := TRUE
      PERFORM INITIALISATION
    WHEN NONE
      IGNORE
  END-DECIDE
END-IF
* --------------------------------------- main -------------------------
MAIN. REPEAT
  UNTIL END-OF-PROCESSING
  IF GET-SCREEN
    PERFORM GET-SCREEN
    RESET GET-SCREEN NEW-SEARCH
  END-IF
  PERFORM SCREEN-IO
END-REPEAT
INCLUDE C-ESCAPE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE GET-SCREEN
************************************************************************
RESET #I L-SCR (*)
IF #PAGE > #MAXAP
  #MAXAP := #PAGE
END-IF
RESET #SCAN-RECORDS
/*SU5 #SCAN-TIME := *TIMX
DECIDE FOR FIRST CONDITION
  WHEN #S-SOURCE-SENDER NE ' '
    PERFORM OPO-ACTIVE-REPORTS
  WHEN #S-USER-ID NE ' '
    PERFORM ACTIVE-REPORTS-IN-FOLDER
  WHEN G-USER-TYPE = 'A'
    PERFORM ALL-ACTIVE-REPORTS
  WHEN NONE
    PERFORM MAILED-ACTIVE-REPORTS
END-DECIDE
*
END-SUBROUTINE /* GET-SCREEN
*
************************************************************************
DEFINE SUBROUTINE OPO-ACTIVE-REPORTS
************************************************************************
GET-SCREEN-OPO. REPEAT
  RDAR. READ ACTIVE-REPORT BY AR-SOURCE-SENDER-TIME-INV = #F-KEY (#PAGE)
    #L-SOURCE := AR-SOURCE
    #L-SENDER  := AR-SENDER
    #L-TIM-INV := AR-PROCESS-TIME-INV
    #TIME-INV  := AR-PROCESS-TIME-INV
    IF #S-SOURCE-SENDER > ' '  AND AR-SOURCE > #T-SOURCE
      ESCAPE BOTTOM (RDAR.)
    END-IF
    IF #I >= #NOFLINES
      ESCAPE BOTTOM (GET-SCREEN-OPO.)
    END-IF
    SELECTED := TRUE
    PERFORM SELECT-RECORD
    IF SELECTED
      ADD 1 TO #I
      PERFORM DATA-TO-SCREEN
    END-IF
  END-READ
  END-OF-DATA := TRUE
  ESCAPE BOTTOM (GET-SCREEN-OPO.)
END-REPEAT
*
END-SUBROUTINE /* OPO-ACTIVE-REPORTS
*
************************************************************************
DEFINE SUBROUTINE ALL-ACTIVE-REPORTS
************************************************************************
GET-SCREEN-ALL. REPEAT
  RESET #EOL
  REAAR. READ ACTIVE-REPORT BY AR-REPORT-TIME-INV = #F-KEY (#PAGE)
    PERFORM #WAIT /*SU5
    #L-REPORT   := AR-REPNAME
    #L-TIME-INV := AR-PROCESS-TIME-INV
    #TIME-INV   := AR-PROCESS-TIME-INV
    IF AR-REPNAME NE #T-REPORT OR AR-PROCESS-TIME-INV > #T-TIME-INV
      #EOL := TRUE
      #LAST-PAGE-KEY := #F-KEY (#PAGE)
      #LAST-PAGE     := #PAGE
      ESCAPE BOTTOM (REAAR.)
    END-IF
    IF #I >= #NOFLINES
      ESCAPE BOTTOM (GET-SCREEN-ALL.)
    END-IF
    IF #I = 0  /* at start of page go to the start-page isn
    AND #ISN (#PAGE) NE 0 AND *ISN (REAAR.) NE #ISN(#PAGE)            /*
    AND #L-TIM-INV-SAVE (#PAGE) = #L-TIME-INV                         /*
      ESCAPE TOP
    END-IF
    #ISN-REAAR := *ISN(REAAR.)
    #AR-REPNAME := AR-REPNAME
    #AR-RNB := AR-REPRNB
    SELECTED := TRUE
    PERFORM SELECT-RECORD
    IF SELECTED
      ADD 1 TO #I
      PERFORM DATA-TO-SCREEN
    END-IF
  END-READ
  END-OF-DATA := TRUE
  ESCAPE BOTTOM (GET-SCREEN-ALL.)
END-REPEAT
*
END-SUBROUTINE /* ALL-ACTIVE-REPORTS
*
************************************************************************
DEFINE SUBROUTINE MAILED-ACTIVE-REPORTS
************************************************************************
GET-SCREEN-MA. REPEAT
  REAMA. READ MAIL BY MA-USER-REP-TIME = #F-KEY (#PAGE)
    PERFORM #WAIT /*SU5
    #L-REPNAME := MA-REPNAME
    #L-USERID  := MA-USERID
    #L-TIME    := MA-INV-TIME
    #TIME-INV  := MA-INV-TIME
    IF #L-REPNAME NE #T-REPNAME OR #L-USERID  NE #T-USERID
    OR #L-TIME    >  #T-TIME                                          /*
      ESCAPE BOTTOM (REAMA.)
    END-IF
    IF #I >= #NOFLINES
      ESCAPE BOTTOM (GET-SCREEN-MA.)
    END-IF
    #AR-REPNAME := MAIL.MA-REPNAME
    #AR-RNB     := MAIL.MA-REPRNB
    FNDA. FIND ACTIVE-REPORT WITH AR-REPORT-RNB = #AR-REPNAME-RNB
      IF NO RECORDS FOUND
        ENTER
      END-NOREC
      SELECTED := TRUE
      PERFORM SELECT-RECORD
      IF SELECTED
        ADD 1 TO #I
        PERFORM DATA-TO-SCREEN
      END-IF
    END-FIND
  END-READ
*
  END-OF-DATA := TRUE
  ESCAPE BOTTOM (GET-SCREEN-MA.)
END-REPEAT
*
END-SUBROUTINE /* MAILED-ACTIVE-REPORTS
*
************************************************************************
DEFINE SUBROUTINE ACTIVE-REPORTS-IN-FOLDER
************************************************************************
GET-SCREEN-FO. REPEAT
  REAFO. READ MAIL BY MA-FOLDER-REP-TIME = #F-KEY (#PAGE)
    PERFORM #WAIT /*SU5
    #L-REP     := MA-REPNAME
    #L-USER-ID := MA-USERID
    #L-FO-ID   := MA-FO-ID
    #L-TIM     := MA-INV-TIME
    #TIME-INV  := MA-INV-TIME
    IF #L-USER-ID NE #T-USER-ID OR #L-FO-ID   NE #T-FO-ID
    OR #L-REP     NE #T-REP     OR #L-TIM     >  #T-TIM               /*
      ESCAPE BOTTOM (REAFO.)
    END-IF
    IF #I >= #NOFLINES
      ESCAPE BOTTOM (GET-SCREEN-FO.)
    END-IF
    #AR-REPNAME := MAIL.MA-REPNAME
    #AR-RNB     := MAIL.MA-REPRNB
    FNDAR. FIND ACTIVE-REPORT WITH AR-REPORT-RNB = #AR-REPNAME-RNB
      IF NO RECORDS FOUND
        ENTER
      END-NOREC
      SELECTED := TRUE
      PERFORM SELECT-RECORD
      IF SELECTED
        ADD 1 TO #I
        PERFORM DATA-TO-SCREEN
      END-IF
    END-FIND
  END-READ
  END-OF-DATA := TRUE
  ESCAPE BOTTOM (GET-SCREEN-FO.)
END-REPEAT
*
END-SUBROUTINE /* ACTIVE-REPORTS-IN-FOLDER
*
************************************************************************
DEFINE SUBROUTINE SELECT-RECORD
************************************************************************
DECIDE FOR FIRST CONDITION
  WHEN #S-ARCHIVE-FLAG NE ' '
  AND #S-ARCHIVE-FLAG NE ACTIVE-REPORT.AR-ARCHIVE                     /*
    SELECTED := FALSE
  WHEN #S-REVIVE-FLAG NE ' '
  AND #S-REVIVE-FLAG NE ACTIVE-REPORT.AR-REVIVE                       /*
    SELECTED := FALSE
  WHEN #S-LOCATION NE ' ' AND NOT(#S-LOCATION = '*' OR = 'B')
  AND #S-LOCATION NE ACTIVE-REPORT.AR-CURRENT-LOCATION                /*
    SELECTED := FALSE
  WHEN #S-LOCATION = 'B'
  AND NOT (ACTIVE-REPORT.AR-CURRENT-LOCATION ='S' OR='D')   /*SU3 OR='C'
    SELECTED := FALSE
  WHEN NOT (#S-DATE = ' ' OR = '*')
  AND NOT (ACTIVE-REPORT.AR-PROCESS-TIME = #S-DATE-F THRU #S-DATE-T)  /*
    SELECTED := FALSE
  WHEN #F-KY (*) NE ' '
    CALLNAT 'N-KY1' AR-KEYWORDS(*) #F-KY (*) #T-KY (*) #S-AND /*SU5
      SELECTED
/*SU5 -> SELECTED := FALSE FOR I 1 TO 6 IF #K-LEN EQ 0
/* IF AR-KEYWORDS(I) EQ #L-KEYWORD SELECTED := TRUE END-IF
/* ELSE EXAMINE SUBSTRING (AR-KEYWORDS(I), 1, #K-LEN) FOR #L-KEYWORD
/*SU5 <- GIVING NUMBER F IF F =1 SELECTED := TRUE END-IF END-IF END-FOR
  WHEN (#S-EXPDATE NE ' ' AND AR-EXPIRATION > #S-EXPDATE)
  OR   (#S-SOURCE-SENDER > ' ' AND AR-REPNAME NE #S-REPNAME)          /*
  OR   (#S-SOURCE-SENDER > ' ' AND AR-SOURCE > #T-SOURCE)             /*
  OR (#S-SOURCE-SENDER > ' ' AND NOT AR-SENDER=#SENDER-F THRU #T-SENDER)
    SELECTED := FALSE
  WHEN NONE
    IGNORE
END-DECIDE
*
END-SUBROUTINE /* SELECT-RECORD
*
************************************************************************
DEFINE SUBROUTINE SCREEN-IO
************************************************************************
IF #I < #NOFLINES
  CV-MARK (#I+1:#NOFLINES) := (AD=DP)
  CV-LINE (#I+1:#NOFLINES) := (AD=D)
END-IF
RESET END-OF-DISPLAY
REPEAT
  CALLNAT 'N-HEADER' L-HEADER G-DATE-FORMAT 'RLIACEM&' /*SU4
  #M-REPNAME := #S-REPNAME
  IF NOT G-DISPLAY-LONG-NAMES
    #M-REPNAME-A(18) := H'FA'
  END-IF
  IF #LANGUAGE NE *LANGUAGE
    #LANGUAGE := *LANGUAGE
    CALLNAT 'ROTINI-N' ##EQO-ACTIVE-REPORT G-OBJ-TYPE G-OTB
    PERFORM INIT-LINECOM
    PERFORM PF-KEYS
    RESET #FLIP-LINES (*)
  END-IF
  INCLUDE RMVHLP-C
  IF #FLIP-LINES (1) = ' '
    CALLNAT 'RFLIPG-N' G-LC #FLIP-LINES (*)
  END-IF
  G-LINECOM (*) := #FLIP-LINES (*)
  PERFORM SET-PFKEYS
  SET CONTROL 'M21'
  DECIDE FOR FIRST CONDITION
    WHEN G-NATRP-ERC NE 0 IGNORE
    WHEN END-OF-DATA AND #PAGE > 1     G-NATRP-ERC := 12 /*bot
    WHEN END-OF-DATA AND #PAGE = 1     G-NATRP-ERC := 14 /*all
    WHEN NOT END-OF-DATA AND #PAGE = 1 G-NATRP-ERC := 11 /*top
    WHEN NONE                          G-NATRP-ERC := 13 /*more
  END-DECIDE
  PERFORM FLIP-DISPLAY
  RESET #WARNING
  DECIDE ON FIRST #PANEL
    VALUE 2
      INPUT WITH TEXT *G-NATRP-ERC, G-NATRP-ERT
        MARK *G-DIRECT-COMMAND USING MAP 'RLIACE2&'
    VALUE 3
      INPUT WITH TEXT *G-NATRP-ERC, G-NATRP-ERT
        MARK *G-DIRECT-COMMAND USING MAP 'RLIACE3&'
    VALUE 4
      INPUT WITH TEXT *G-NATRP-ERC, G-NATRP-ERT
        MARK *G-DIRECT-COMMAND USING MAP 'RLIACE4&'
    VALUE 5
      INPUT WITH TEXT *G-NATRP-ERC, G-NATRP-ERT
        MARK *G-DIRECT-COMMAND USING MAP 'RLIACE5&'
    VALUE 6
      INPUT WITH TEXT *G-NATRP-ERC, G-NATRP-ERT
        MARK *G-DIRECT-COMMAND USING MAP 'RLIACE1&'
    VALUE 7
      INPUT WITH TEXT *G-NATRP-ERC, G-NATRP-ERT
        MARK *G-DIRECT-COMMAND USING MAP 'RLIACE7&'
    VALUE 8
      INPUT WITH TEXT *G-NATRP-ERC, G-NATRP-ERT
        MARK *G-DIRECT-COMMAND USING MAP 'RLIACE8&'
    NONE VALUE
      INPUT WITH TEXT *G-NATRP-ERC, G-NATRP-ERT
        MARK *G-DIRECT-COMMAND USING MAP  'RLIACE-&'
  END-DECIDE
  RESET G-NATRP-ERC G-NATRP-ERT
  PERFORM COMMAND-PF-KEY
  UNTIL END-OF-DISPLAY
END-REPEAT
*
END-SUBROUTINE /* SCREEN-IO
*
************************************************************************
DEFINE SUBROUTINE DATA-TO-SCREEN
************************************************************************
RESET #BIN-SIZE
IF ACTIVE-REPORT.AR-USERID = G-USERID
  L-OWNER (#I) := TRUE
END-IF
L-RNB (#I) := ACTIVE-REPORT.AR-REPRNB
IF #PANEL = 1 OR = 3 OR = 6 OR = 7
  MOVE EDITED ACTIVE-REPORT.AR-PROCESS-TIME (EM=HH':'II) TO L-TIME(#I)
  MOVE EDITED ACTIVE-REPORT.AR-PROCESS-TIME (EM=YYYYMMDD) TO #DATE
ELSE
  #TIME-P13 := #CONST-INV-TIME - MAIL.MA-INV-TIME-P13
  #TIME := #TIME-P13
  MOVE EDITED #TIME (EM=HH':'II) TO L-TIME(#I)
  MOVE EDITED #TIME (EM=YYYYMMDD) TO #DATE
END-IF
CALLNAT 'IODATE-N' 'M' 'S' #DATE L-DATE (#I) G-DATE-FORMAT
  #ERROR-CODE #ERROR-TEXT
*
IF ACTIVE-REPORT.AR-DESC NE ' '
  L-DESC (#I) := ACTIVE-REPORT.AR-DESC
ELSE
  L-DESC (#I) := #DESC
END-IF
IF ACTIVE-REPORT.AR-SOURCE = ' ' AND ACTIVE-REPORT.AR-SENDER = ' '
  RESET L-SOURCE-SENDER(#I)
ELSE
  COMPRESS AR-SOURCE '/' AR-SENDER TO L-SOURCE-SENDER (#I) LEAVING NO
END-IF
L-SOURCE-ID (#I) := ACTIVE-REPORT.AR-SOURCE-ID
L-ARCHIVE   (#I) := ACTIVE-REPORT.AR-ARCHIVE
L-REVIVE    (#I) := ACTIVE-REPORT.AR-REVIVE
L-LOC       (#I) := ACTIVE-REPORT.AR-CURRENT-LOCATION
IF ACTIVE-REPORT.AR-REVIVE = '*'
  CALLNAT 'IODATE-N' 'M' 'S' ACTIVE-REPORT.AR-REVIVE-EXPIRATION
    L-REVIVE-EXP (#I) G-DATE-FORMAT #ERROR-CODE #ERROR-TEXT
END-IF
*
IF ACTIVE-REPORT.AR-EXPIRATION NE ' '
  CALLNAT 'IODATE-N' 'M' 'S' ACTIVE-REPORT.AR-EXPIRATION
    L-EXPIRATION (#I) G-DATE-FORMAT #ERROR-CODE #ERROR-TEXT
END-IF
*
IF ACTIVE-REPORT.AR-ARCHIVE = '*' OR = 'R' OR = 'P'
  FNDDR. FIND DATASET-REPORT WITH DR-REPORT-RNB = #AR-REPNAME-RNB
    IF NO RECORDS FOUND
      ENTER
    END-NOREC
    CALLNAT 'IODATE-N' 'M' 'S' DATASET-REPORT.DR-EXPIRATION-DATE
      L-ARCHIVE-EXP (#I) G-DATE-FORMAT #ERROR-CODE #ERROR-TEXT
  END-FIND
END-IF
IF ACTIVE-REPORT.AR-CC-TYPE = BINARY
  I := #I
  PERFORM READ-ACTIVE-REP
  IF #BIN-SIZE NE 0
    COMPRESS #BIN-SIZE 'K' TO L-LINES(#I) LEAVING NO
  ELSE
    L-LINES(#I) := '--K'
  END-IF
ELSE
  L-LINES (#I) := ACTIVE-REPORT.AR-NUMBER-OF-LINES
END-IF
*
DECIDE ON FIRST MAIL.MA-STATUS
  VALUE 'C'
    L-MESSAGE (#I) := #LAN-TXT (1)
  VALUE 'P'
    L-MESSAGE (#I) := #LAN-TXT (2)
  NONE VALUE
    IGNORE
END-DECIDE
IF +G-NOMEXIT-ACTIVE (8)
  PERFORM USER-EXIT-8
END-IF
*
END-SUBROUTINE /* DATA-TO-SCREEN
*
************************************************************************
DEFINE SUBROUTINE INIT-LINECOM
************************************************************************
DECIDE FOR FIRST CONDITION
  WHEN #S-USER-ID NE ' ' AND #S-USER-ID NE G-USERID
    G-LC-IDENT (01) := ##EQU-BROWSE
    G-LC-IDENT (02) := ##EQU-PRINT
    G-LC-IDENT (03) := ##EQU-FILE-AREPORT
    G-LC-IDENT (04) := ##EQU-MODIFY
    G-LC-IDENT (05) := ##EQU-DISPLAY
    G-LC-IDENT (06) := ##EQU-ARCHIVE
    G-LC-IDENT (07) := ##EQU-REVIVE
    G-LC-IDENT (08) := ##EQU-USERS
    G-LC-IDENT (09) := ##EQU-BUNDLE
    G-LC-IDENT (10) := ##EQU-XREF-BUNDLES
    G-LC-IDENT (11) := ##EQU-DISPLAY-DEFINITION
    G-LC-IDENT (12) := ##EQU-SPOOL-ATTR
    G-LC-NUM        := 12
  WHEN #S-USER-ID NE ' '
    G-LC-IDENT (01) := ##EQU-BROWSE
    G-LC-IDENT (02) := ##EQU-DELETE
    G-LC-IDENT (03) := ##EQU-MODIFY
    G-LC-IDENT (04) := ##EQU-DISPLAY
    G-LC-IDENT (05) := ##EQU-ARCHIVE
    G-LC-IDENT (06) := ##EQU-REVIVE
    G-LC-IDENT (07) := ##EQU-PRINT
    G-LC-IDENT (08) := ##EQU-FILE-AREPORT
    G-LC-IDENT (09) := ##EQU-DISTRIBUTE
    G-LC-IDENT (10) := ##EQU-CONFIRM-PRINT
    G-LC-IDENT (11) := ##EQU-USERS
    G-LC-IDENT (12) := ##EQU-BUNDLE
    G-LC-IDENT (13) := ##EQU-XREF-BUNDLES
    G-LC-IDENT (14) := ##EQU-DISPLAY-DEFINITION
    G-LC-IDENT (15) := ##EQU-SPOOL-ATTR
    G-LC-NUM        := 15
  WHEN NONE
    G-LC-IDENT (01) := ##EQU-BROWSE
    G-LC-IDENT (02) := ##EQU-DELETE
    G-LC-IDENT (03) := ##EQU-MODIFY
    G-LC-IDENT (04) := ##EQU-DISPLAY
    G-LC-IDENT (05) := ##EQU-ARCHIVE
    G-LC-IDENT (06) := ##EQU-REVIVE
    G-LC-IDENT (07) := ##EQU-PRINT
    G-LC-IDENT (08) := ##EQU-DISTRIBUTE
    G-LC-IDENT (09) := ##EQU-CONFIRM-PRINT
    G-LC-IDENT (10) := ##EQU-USERS
    G-LC-IDENT (11) := ##EQU-BUNDLE
    G-LC-IDENT (12) := ##EQU-XREF-BUNDLES
    G-LC-IDENT (13) := ##EQU-DISPLAY-DEFINITION
    G-LC-IDENT (14) := ##EQU-SPOOL-ATTR
    G-LC-NUM        := 14
END-DECIDE
CALLNAT 'RLCINI-N' G-OBJ-TYPE G-LC G-LCB
*
END-SUBROUTINE /* INIT-LINECOM
*
************************************************************************
DEFINE SUBROUTINE PF-KEYS
************************************************************************
PERFORM INIT-PFKEYS
PERFORM SET-PFKEYS
*
END-SUBROUTINE /* PF-KEYS
*
************************************************************************
DEFINE SUBROUTINE INIT-SELECTION-KEYS
************************************************************************
IF #S-SOURCE-SENDER > ' '
  EXAMINE #S-SOURCE-SENDER FOR '/' GIVING POSITION IN #M
  IF #M = 0
    #SOURCE-F := SUBSTR(#S-SOURCE-SENDER,1,16)
    RESET #SENDER-F
  ELSE
    IF #M = 1
      RESET #SOURCE-F
    ELSE
      #K := #M - 1
      #SOURCE-F := SUBSTR(#S-SOURCE-SENDER,1,#K)
    END-IF
    #M := #M + 1
    #SENDER-F := SUBSTR(#S-SOURCE-SENDER,#M,16)
  END-IF
*
  IF #SOURCE-F NE SCAN '*'
    #F-SOURCE(1) := #SOURCE-F
    IF #SOURCE-F = ' '
      #T-SOURCE := H'FF'
    ELSE
      #T-SOURCE := #SOURCE-F
    END-IF
  ELSE
    EXAMINE #SOURCE-F FOR '*' DELETE
    #F-SOURCE (1) := #SOURCE-F
    COMPRESS #SOURCE-F H'FF' TO #T-SOURCE LEAVING NO
  END-IF
*
  IF #SENDER-F NE SCAN '*'
    IF #SENDER-F = ' '
      #T-SENDER := H'FF'
    ELSE
      #T-SENDER  := #SENDER-F
    END-IF
    RESET #F-SENDER(1)
  ELSE
    EXAMINE #SENDER-F FOR '*' DELETE
    #F-SENDER (1) := #SENDER-F
    COMPRESS #SENDER-F H'FF' TO #T-SENDER LEAVING NO
  END-IF
*
  #F-TIM-INV(1)  := #CONST-INV-TIME
  RESET #T-TIM-INV
  #START-SOURCE  := #SOURCE-F
  #START-SENDER  := #SENDER-F
  #START-TIM-INV := #CONST-INV-TIME
ELSE
  DECIDE FOR FIRST CONDITION
    WHEN #S-USER-ID NE ' '
      #F-USER-ID         (1)  := #S-USER-ID
      #F-FO-ID           (1)  := #S-FO-ID
      #F-REP             (1)  := #REPNAME
      RESET  #F-TIM      (1)
      #T-USER-ID              := #S-USER-ID
      #T-FO-ID                := #S-FO-ID
      #T-REP                  := #REPNAME
      #T-TIM                  := #CONST-INV-TIME
      #START-USER-ID          := #S-USER-ID
      #START-FO-ID            := #S-FO-ID
      #START-REP              := #REPNAME
      RESET #START-TIM
      IF NOT (#S-MAILED = ' ' OR = '*')
        #F-TIM (1) := #CONST-INV-TIME - #S-MAILED-T-P
        #T-TIM     := #CONST-INV-TIME - #S-MAILED-F-P
        #START-TIM := #CONST-INV-TIME - #S-MAILED-T-P
      END-IF
    WHEN G-USER-TYPE = 'A'
      #F-REPORT          (1) := #REPNAME
      #T-REPORT              := #REPNAME
      #T-TIME-INV            := #CONST-INV-TIME
      RESET  #F-TIME-INV (1)
      #START-REPORT         := #REPNAME
      RESET #START-TIME-INV
      IF NOT (#S-DATE = ' ' OR = '*')
        #F-TIME-INV (1) := #CONST-INV-TIME - #S-DATE-T-P
        #T-TIME-INV     := #CONST-INV-TIME - #S-DATE-F-P
        #START-TIME-INV := #CONST-INV-TIME - #S-DATE-T-P
      END-IF
    WHEN NONE
      #F-USERID         (1)  := G-USERID
      #F-REPNAME (1)         := #REPNAME
      RESET  #F-TIME    (1)
      #T-USERID              := G-USERID
      #T-REPNAME             := #REPNAME
      #T-TIME                := #CONST-INV-TIME
      #START-USERID         := G-USERID
      #START-REPNAME := #REPNAME
      RESET  #START-TIME
      IF NOT (#S-MAILED = ' ' OR = '*')
        #F-TIME (1) := #CONST-INV-TIME - #S-MAILED-T-P
        #T-TIME     := #CONST-INV-TIME - #S-MAILED-F-P
        #START-TIME := #CONST-INV-TIME - #S-MAILED-T-P
      END-IF
  END-DECIDE
END-IF
*
END-SUBROUTINE /* INIT-SELECTION-KEYS
*
************************************************************************
DEFINE SUBROUTINE COMMAND-PF-KEY
************************************************************************
IF G-DIRECT-COMMAND = ' '
  PERFORM CHECK-PF-KEY
END-IF
DECIDE ON FIRST VALUE OF G-DIRECT-COMMAND             /* test local
  VALUE 'HELP'   REINPUT USING HELP                   /* commands
  VALUE 'FOLLOW' PERFORM FOLLOW-MONITOR
  VALUE ' '      PERFORM CHECK-MODIFICATIONS
  VALUE 'EXIT'   END-OF-PROCESSING := END-OF-DISPLAY := TRUE /*ret fath
  VALUE 'FLIP'   PERFORM FLIP-HANDLE
  VALUE 'MENU' /*ret menui
    END-OF-PROCESSING := END-OF-DISPLAY := TRUE
    INCLUDE C-MENU
  VALUE 'UP'
    PERFORM CHECK-MODIFICATIONS
    IF #PAGE > 1 AND NOT NEW-SEARCH
      RESET #ISN (#PAGE) #F-KEY (#PAGE) L-SCR (*) #L-TIM-INV-SAVE(#PAGE)
      SUBTRACT 1 FROM #PAGE
      END-OF-DISPLAY := GET-SCREEN := TRUE
      END-OF-DATA    := FALSE
    END-IF
  VALUE 'DOWN'
    PERFORM CHECK-MODIFICATIONS
    IF NOT END-OF-DATA AND NOT NEW-SEARCH
      ADD 1 TO #PAGE
      IF #PAGE > #NOFPAGES
        #PAGE := #NOFPAGES
        #F-KEY (1:#NOFPAGES - 1) := #F-KEY (2:#NOFPAGES)
        #ISN (1:#NOFPAGES - 1) := #ISN (2:#NOFPAGES)
      END-IF
      RESET L-SCR (*)
      #F-KEY (#PAGE)          := #L-KEY
      #ISN          (#PAGE)   := *ISN(REAAR.)
      #L-TIM-INV-SAVE (#PAGE) := #TIME-INV
      END-OF-DISPLAY := GET-SCREEN := TRUE
      END-OF-DATA    := FALSE
    END-IF
  VALUE 'TOP'
    PERFORM CHECK-MODIFICATIONS
    RESET L-SCR (*)
    #MAXAP := 1
    #F-KEY(1) := #START-KEY
    #PAGE := 1
    GET-SCREEN := END-OF-DISPLAY := TRUE
    END-OF-DATA := FALSE
  VALUE 'BOT'
    PERFORM CHECK-MODIFICATIONS
    IF NOT NEW-SEARCH
      IF NOT #EOL AND #LAST-PAGE-KEY  NE ' '
        #PAGE := #LAST-PAGE
        RESET #ISN (#PAGE) #F-KEY (#PAGE) L-SCR (*)
        #F-KEY(#PAGE) := #LAST-PAGE-KEY
        GET-SCREEN := END-OF-DISPLAY := TRUE
        END-OF-DATA    := FALSE
      END-IF
    END-IF
  VALUE 'LEFT'
    DECIDE ON FIRST #PANEL
      VALUE 7  #PANEL := 3
      VALUE 3  #PANEL := 6
      VALUE 6  #PANEL := 1
      VALUE 8  #PANEL := 4
      VALUE 4  #PANEL := 5
      VALUE 5  #PANEL := 2
      NONE VALUE IGNORE
    END-DECIDE
    VALUE 'RIGHT'  DECIDE ON FIRST #PANEL
      VALUE 1 #PANEL := 6
      VALUE 6 #PANEL := 3
      VALUE 3 #PANEL := 7
      VALUE 2 #PANEL := 5
      VALUE 5 #PANEL := 4
      VALUE 4 #PANEL := 8
      NONE VALUE IGNORE
    END-DECIDE
  VALUE 'EXT'
    IF G-SUPPORT-LONG-NAMES
      IF G-DISPLAY-LONG-NAMES
        G-DISPLAY-LONG-NAMES := FALSE
      ELSE
        G-DISPLAY-LONG-NAMES := TRUE
      END-IF
    END-IF
  ANY            RESET G-DIRECT-COMMAND
  NONE           PERFORM EXECUTE-DIRECT-COMMAND
END-DECIDE
*
END-SUBROUTINE /* COMMAND-PF-KEY
*
************************************************************************
DEFINE SUBROUTINE CHECK-PF-KEY
************************************************************************
G-PF-KEY := *PF-KEY
EXAMINE G-PF-KEY FOR 'PF' REPLACE ' '
MOVE LEFT G-PF-KEY TO G-PF-KEY
IF G-PF-KEY IS (N4)
  G-PF-IND := VAL (G-PF-KEY)
  G-DIRECT-COMMAND := G-PF-CODE (G-PF-IND)
ELSE
  G-PF-FUNC := *PF-KEY
END-IF
*
END-SUBROUTINE /* CHECK-PF-KEY
*
************************************************************************
DEFINE SUBROUTINE EXECUTE-DIRECT-COMMAND
************************************************************************
MOVE LEFT G-DIRECT-COMMAND TO G-DIRECT-COMMAND
IF G-DIRECT-COMMAND IS (N2.1) AND G-DIRECT-COMMAND NE '.'
  COMPRESS '>' G-DIRECT-COMMAND TO G-DIRECT-COMMAND LEAVING NO
END-IF
FETCH RETURN 'NRMCPR'
SET CONTROL 'WMB'
DECIDE ON FIRST VALUE OF G-NATRP-ERC
  VALUE 0,5,419,420,9998 IGNORE
  VALUE 9997 RESET G-NATRP-ERC
  VALUE 9999
    RESET G-NATRP-ERC
    END-OF-DISPLAY := END-OF-PROCESSING := TRUE
  NONE              ESCAPE ROUTINE
END-DECIDE
*
END-SUBROUTINE /* EXECUTE-DIRECT-COMMAND
*
************************************************************************
DEFINE SUBROUTINE CHECK-MODIFICATIONS
************************************************************************
INIT-SELECTION := FALSE
DECIDE FOR EVERY CONDITION
  WHEN #O-REPNAME NE #S-REPNAME
    #O-REPNAME     := #S-REPNAME
    #REPNAME       := #S-REPNAME
    INIT-SELECTION := TRUE
    PERFORM READ-DESCRIPTION
  WHEN #O-ARCHIVE-FLAG NE #S-ARCHIVE-FLAG
    #O-ARCHIVE-FLAG := #S-ARCHIVE-FLAG
    +G-RLIACE-SEL-ARC-FLAG-OK := #S-ARCHIVE-FLAG
  WHEN #O-REVIVE-FLAG NE #S-REVIVE-FLAG
    #O-REVIVE-FLAG := #S-REVIVE-FLAG
    +G-RLIACE-SEL-REV-FLAG-OK := #S-REVIVE-FLAG
  WHEN (#O-LOCATION NE #S-LOCATION OR CV-LOCATION MODIFIED)
  AND #FATHER-PROG = 'RLISRP'                                         /*
    #O-LOCATION := #S-LOCATION
    +G-RLIACE-SEL-LOCATION-OK := #S-LOCATION
  WHEN (#O-LOCATION NE #S-LOCATION OR CV-LOCATION MODIFIED)
  AND #FATHER-PROG = 'RLIACS' AND #S-LOCATION NE #DEF-LOC             /*
    #O-LOCATION := #S-LOCATION
    +G-RLIACE-SEL-LOCATION-OK := #S-LOCATION
  WHEN #O-DATE NE #S-DATE
    #O-DATE := #S-DATE
    #DATE11 := #O-DATE
    PERFORM INIT-DAT-KEYS
    IF #ERROR-CODE NE 0
      REINPUT *#ERROR-CODE, #ERROR-TEXT
    END-IF
    #O-DATE   := #DATE11
    #S-DATE   := #DATE11
    #S-DATE-F := #DATE-F
    #S-DATE-F-P := #S-DATE-F
    #S-DATE-T := #DATE-T
    #S-DATE-T-P := #S-DATE-T
    +G-RLIACE-SEL-DATE-OK   := #S-DATE
    +G-RLIACE-SEL-DATE-F-OK := #S-DATE-F
    +G-RLIACE-SEL-DATE-T-OK := #S-DATE-T
    INIT-SELECTION := TRUE
  WHEN #O-MAILED NE #S-MAILED
    #O-MAILED := #S-MAILED
    #DATE11 := #O-MAILED
    PERFORM INIT-DAT-KEYS
    IF #ERROR-CODE NE 0
      REINPUT *#ERROR-CODE, #ERROR-TEXT
    END-IF
    #O-MAILED     := #DATE11
    #S-MAILED     := #DATE11
    #S-MAILED-F   := #DATE-F
    #S-MAILED-F-P := #S-MAILED-F
    #S-MAILED-T   := #DATE-T
    #S-MAILED-T-P := #S-MAILED-T
    +G-RLIACE-SEL-MAILED-OK   := #S-MAILED
    +G-RLIACE-SEL-MAILED-F-OK := #S-MAILED-F
    +G-RLIACE-SEL-MAILED-T-OK := #S-MAILED-T
    INIT-SELECTION := TRUE
  WHEN #O-EXPDATE NE #L-EXPDATE
    IF #L-EXPDATE EQ ' ' OR #L-EXPDATE EQ '*'
      RESET #L-EXPDATE #S-EXPDATE #O-EXPDATE
    ELSE
      RESET #ERROR-CODE #ERROR-TEXT
* can use #S-EXPDATE safely as of now, IODATE-N doesn't change value
* of this field if error code is returned
      CALLNAT 'IODATE-N' 'V' 'L' #S-EXPDATE #L-EXPDATE G-DATE-FORMAT
        #ERROR-CODE #ERROR-TEXT
      IF #ERROR-CODE NE 0
        REINPUT *#ERROR-CODE, #ERROR-TEXT
      END-IF
      #O-EXPDATE := #L-EXPDATE
    END-IF
  WHEN  CV-SOURCE MODIFIED
    INIT-SELECTION := TRUE
  WHEN ANY
    IF INIT-SELECTION
      PERFORM INIT-SELECTION-KEYS
    END-IF
    #PAGE := 1
    NEW-SEARCH  := END-OF-DISPLAY := GET-SCREEN := TRUE
    END-OF-DATA := FALSE
    #MAXAP := 1
  WHEN NONE
    PERFORM LINE-COMMANDS
END-DECIDE
*
END-SUBROUTINE /* CHECK-MODIFICATIONS
*
************************************************************************
DEFINE SUBROUTINE INITIALISATION
************************************************************************
DECIDE FOR EVERY CONDITION
  WHEN NOT END-OF-PROCESSING
    INCLUDE CVIDEO
    G-FLIP-STATUS := 'P'
    PERFORM INIT-SELECTION-KEYS
  WHEN NOT END-OF-PROCESSING
    PERFORM READ-DESCRIPTION
  WHEN NONE
    IGNORE
END-DECIDE
IF G-USER-TYPE = 'A' AND #S-USER-ID = ' '
  #PANEL := 1
ELSE
  #PANEL := 2
END-IF
*
END-SUBROUTINE /* INITIALISATION
*
************************************************************************
DEFINE SUBROUTINE READ-DESCRIPTION
************************************************************************
FNDR. FIND REPORT WITH R-REPNAME = #REPNAME
  IF NO RECORDS FOUND
    ENTER
  END-NOREC
  #DESC := R-DESC
END-FIND
*
END-SUBROUTINE /* READ-DESCRIPTION
*
************************************************************************
DEFINE SUBROUTINE READ-FOLDER
************************************************************************
#FO-USER-ID := #S-USER-ID
#FO-ID      := #S-FO-ID
FNDFO. FIND FOLDER WITH FO-USER-FO-ID = #FO-USER-FO-ID
  IF NO RECORDS FOUND
    ESCAPE BOTTOM (FNDFO.)
  END-NOREC
  IF FOLDER.FO-LINKED-FO-ID NE ' '
    FIND LINKED-FOLDER WITH FO-USER-FO-ID = FOLDER.FO-LINKED-FO-ID
      #DEF-LOC := LINKED-FOLDER.FO-DEFAULT-LOCATION
    END-FIND
  ELSE
    #DEF-LOC := FOLDER.FO-DEFAULT-LOCATION
  END-IF
END-FIND
#S-LOCATION := #DEF-LOC
*
END-SUBROUTINE /* READ-FOLDER
*
************************************************************************
DEFINE SUBROUTINE INIT-PFKEYS
************************************************************************
INCLUDE RPFSTD-C
INCLUDE RPFBRW-C
INCLUDE RPFLR--C
INCLUDE RPFEXT-C
CALLNAT 'RPFINI-N' G-PF G-PFB
*
END-SUBROUTINE /* INIT-PFKEYS
*
************************************************************************
DEFINE SUBROUTINE STACK-SCREEN
************************************************************************
FOR F = 1 TO *OCC(L-SCREEN-SEG-L)
  IF L-SCREEN-SEG-L (F) = H'00'
    L-SCREEN-SEG-L (F) := H'01'
    L-SCREEN-SEG-FLAG (F) := TRUE
  ELSE
    L-SCREEN-SEG-FLAG (F) := FALSE
  END-IF
END-FOR
STACK TOP DATA FORMATTED L-SCREEN-SEGMENT (*) L-SCREEN-SEG-FLAG (*)
#STACK-PGM := *PROGRAM /*SU5 line below
STACK TOP DATA FORMATTED #STACK-PGM 'X' 'X' 'X' 'X' 'X' 'X' /*#7 *DATA=7
STACK TOP COMMAND *PROGRAM
RESET F
*
END-SUBROUTINE /* STACK-SCREEN
*
************************************************************************
DEFINE SUBROUTINE READ-FROM-STACK
************************************************************************
INPUT #STACK-PGM
IF #STACK-PGM NE *PROGRAM
  *ERROR-NR := 999 /* internal error, should not occur
END-IF
INPUT (LS=202) L-SCREEN-SEGMENT (*) L-SCREEN-SEG-FLAG (*)
FOR F = 1 TO *OCC(L-SCREEN-SEG-FLAG)
  IF L-SCREEN-SEG-FLAG (F) = TRUE
    L-SCREEN-SEG-L (F) := H'00'
  END-IF
END-FOR
*
END-SUBROUTINE /* READ-FROM-STACK
*
************************************************************************
DEFINE SUBROUTINE LINE-COMMANDS
************************************************************************
INCLUDE RLCMTI-C
* validate Line Commands
FOR I 1 TO #NOFLINES
  IF L-IDENT (I) = ##EQU-CONFIRM-PRINT OR= ##EQU-DISTRIBUTE
  OR= ##EQU-BROWSE OR= ##EQU-BUNDLE OR= ##EQU-PRINT OR= ##EQU-ARCHIVE /*
    PERFORM CHECK-SOURCE
  END-IF
  DECIDE ON FIRST VALUE OF L-IDENT (I)
    VALUE ##EQU-BROWSE
      PERFORM READ-ACTIVE-REP
      IF #BIN
        REINPUT *725  MARK *L-MARK(I) ALARM
      END-IF
    VALUE ##EQU-DELETE
      IF NOT #DELETE
        REINPUT *0020 MARK *L-MARK(I) ALARM
      END-IF
    VALUE ##EQU-BUNDLE
      IF NOT(L-LOC(I) ='D' OR='S') /*SU3 OR='C')
        REINPUT *0426 MARK *L-MARK(I) ALARM
      END-IF
    VALUE ##EQU-ARCHIVE
      IF NOT #ARCHIVE
        REINPUT *0020 MARK *L-MARK(I) ALARM
      END-IF
    VALUE ##EQU-REVIVE
      IF NOT #REVIVE
        REINPUT *0020 MARK *L-MARK(I) ALARM
      END-IF
    VALUE ##EQU-PRINT
      PERFORM READ-ACTIVE-REP
      IF #BIN AND NOT #WARNING AND #SPOOL-DI-FILETYPE NE 'prn'
        #WARNING := TRUE
        INPUT WINDOW='WARNING' USING MAP 'RLIACFW&'
        #WIN-PFKEY := *PF-KEY
        DECIDE ON FIRST VALUE OF #WIN-PFKEY
          VALUE 'PF3'
            RESET L-IDENT (I) L-MARK (I)
            G-NATRP-ERC := 428 /* Report not queued for printing.
          VALUE 'PF5'
            IGNORE
          NONE
            REINPUT ' '
        END-DECIDE
      END-IF
    NONE  IGNORE
  END-DECIDE
END-FOR
*
FOR #J = 1 TO #NOFLINES
  DECIDE ON FIRST VALUE OF L-IDENT (#J)
    VALUE ##EQU-BROWSE
      RESET L-MARK (#J) L-IDENT (#J)
      G-C-REPORT := #REPNAME
      G-C-REPRNB := L-RNB(#J)
      PERFORM STACK-SCREEN
      FETCH 'RDISRP' G-C-REPORT G-C-REPRNB
    VALUE ##EQU-DISPLAY
      RESET L-MARK (#J) L-IDENT (#J)
      G-C-REPORT := #REPNAME
      G-C-REPRNB := L-RNB(#J)
      G-C-FUNC := 'D'
      GET-SCREEN := TRUE
      PERFORM STACK-SCREEN
      FETCH 'RDEFAR'
    VALUE ##EQU-DELETE
      RESET L-MARK (#J) L-IDENT (#J)
      G-C-REPORT := #REPNAME
      G-C-REPRNB := L-RNB(#J)
      GET-SCREEN := TRUE
      PERFORM STACK-SCREEN
      FETCH 'RDELAR'
    VALUE ##EQU-MODIFY
      RESET L-MARK (#J) L-IDENT (#J)
      G-C-REPORT := #REPNAME
      G-C-REPRNB := L-RNB(#J)
      G-C-FUNC := 'M'
      GET-SCREEN := TRUE
      PERFORM STACK-SCREEN
      FETCH 'RDEFAR'
    VALUE ##EQU-PRINT
      RESET L-MARK (#J) L-IDENT (#J)
      G-C-REPORT := #REPNAME
      G-C-REPRNB := L-RNB(#J)
      FETCH RETURN 'RPRTAR'
    VALUE ##EQU-ARCHIVE
      RESET L-MARK (#J) L-IDENT (#J)
      G-C-REPORT := #REPNAME
      G-C-REPRNB := L-RNB(#J)
      GET-SCREEN := TRUE
      PERFORM STACK-SCREEN
      FETCH 'RARCAR'
    VALUE ##EQU-REVIVE
      RESET L-MARK (#J) L-IDENT (#J)
      G-C-REPORT := #REPNAME
      G-C-REPRNB := L-RNB(#J)
      GET-SCREEN := TRUE
      PERFORM STACK-SCREEN
      FETCH 'RREVAR'
    VALUE ##EQU-DISTRIBUTE
      RESET L-MARK (#J) L-IDENT (#J)
      G-C-REPORT := #REPNAME
      G-C-REPRNB := L-RNB(#J)
      PERFORM DISTRIBUTE-REPORT
    VALUE ##EQU-BUNDLE
      RESET L-MARK (#J) L-IDENT (#J)
      G-C-REPORT := #REPNAME
      G-C-REPRNB := L-RNB(#J)
      PERFORM BUNDLE-REPORT
    VALUE ##EQU-USERS
      RESET L-MARK (#J) L-IDENT (#J)
      G-C-REPORT := #REPNAME
      G-C-REPRNB := L-RNB(#J)
      PERFORM STACK-SCREEN
      FETCH 'RXRFRU'
    VALUE ##EQU-XREF-BUNDLES
      RESET L-MARK (#J) L-IDENT (#J)
      G-C-REPORT := #REPNAME
      G-C-REPRNB := L-RNB(#J)
      PERFORM STACK-SCREEN
      FETCH 'RXRPBU'
    VALUE ##EQU-DISPLAY-DEFINITION
      RESET L-MARK (#J) L-IDENT (#J)
      G-C-FUNC := 'D'
      G-FATHER-PROG := *PROGRAM
      G-C-REPORT := #REPNAME
      PERFORM STACK-SCREEN
      FETCH 'RDEFRP'
    VALUE ##EQU-CONFIRM-PRINT
      GET-SCREEN := TRUE
      RESET L-MARK (#J) L-IDENT (#J)
      G-C-REPORT := #REPNAME
      G-C-REPRNB := L-RNB(#J)
      GET-SCREEN := TRUE
      PERFORM STACK-SCREEN
      FETCH 'RCONFPRT'
    VALUE ##EQU-FILE-AREPORT
      GET-SCREEN := TRUE
      RESET L-MARK (#J) L-IDENT (#J)
      GET-SCREEN := TRUE
      PERFORM STACK-SCREEN
      IF #S-USER-ID NE ' '
        FETCH 'RFILAR' #S-USER-ID #REPNAME L-RNB (#J)
      ELSE
        FETCH 'RFILAR' G-USERID #REPNAME L-RNB (#J)
      END-IF
    VALUE ##EQU-SPOOL-ATTR
      RESET L-MARK (#J) L-IDENT (#J)
      G-C-REPORT := #REPNAME
      G-C-REPRNB := L-RNB(#J)
      G-C-FUNC := 'S'
      PERFORM STACK-SCREEN
      FETCH 'RDEFAR'
    NONE VALUE
      IGNORE
  END-DECIDE
END-FOR
*
END-SUBROUTINE /* LINE-COMMANDS
*
************************************************************************
DEFINE SUBROUTINE READ-ACTIVE-REP
************************************************************************
RESET #BIN #BIN-SIZE
#REPORT := #REPNAME
#RNB    := L-RNB   (I)
FIND ACTIVE-REPORT WITH AR-REPORT-RNB = #REPORT-RNB
  IF AR-CC-TYPE = BINARY
    #BIN := TRUE
    #SPOOL-ATTRIBUTES := AR-SPOOL-ATTRIBUTES
    IF NOT(#SPOOL-DI-SIZE = #I4 OR = 0)
/*SU1 #BIN-SIZE := (#SPOOL-DI-SIZE / 1024 + 1) * 3 / 4
      #BIN-SIZE := (#SPOOL-DI-SIZE / 1024) * 3 / 4 + 1 /*SU1
    END-IF
  END-IF
END-FIND
*
END-SUBROUTINE /* READ-ACTIVE-REP
*
************************************************************************
DEFINE SUBROUTINE INIT-TEXT
************************************************************************
#LAN-IDENT (1) := ##TXT-CONFIRM-PRINT
#LAN-IDENT (2) := ##TXT-CONFIRMED-PRINT
FOR J = 1 TO #NOT
  IF #LAN-IDENT (J) NE 0
    CALLNAT 'RLTINI-N' #LAN-IDENT (J) #LAN-TXT   (J) G-TXB
  END-IF
END-FOR
*
END-SUBROUTINE /* INIT-TEXT
*
************************************************************************
DEFINE SUBROUTINE CHECK-SOURCE
************************************************************************
IF L-LOC (I) = 'A'
* REINPUT *0426 MARK *L-MARK(I) ALARM                /* BLI NOMALL-1829
  REINPUT *0441 MARK *L-MARK(I) ALARM                /* BLI NOMALL-1829
END-IF
IF L-SOURCE-ID (I) = 0
  ESCAPE ROUTINE
END-IF
IF L-REVIVE (I) = '*' AND L-LOC(I) = 'D'
  ESCAPE ROUTINE
END-IF
*
IF G-USE-OWNER
  #AR-REPNAME := #REPNAME
  #AR-RNB            := L-RNB (I)
  FIND ACTIVE-REPORT-OWNER WITH AR-REPORT-RNB = #AR-REPNAME-RNB
    IF AR-USERID NE G-NPR-USERID-CURRENT
      FIND NRM-SOURCE WITH SR-ID = L-SOURCE-ID (I)
      END-FIND
      IF NRM-SOURCE.SR-TYPE NE NOM-DATA-BASE
        #SAVE-NPR-USERID := G-NPR-USERID
        G-NPR-USERID := AR-USERID
        PERFORM LOGON-TO-ESY
        IF G-NATRP-ERC NE 0
          G-NPR-USERID := #SAVE-NPR-USERID
          ESCAPE ROUTINE
        END-IF
        RESET G-NATRP-ERC G-NATRP-ERT
        G-NPR-USERID := #SAVE-NPR-USERID
      END-IF
    END-IF
*
  END-FIND
END-IF
*
RESET #ERROR-CODE #ERROR-TEXT SOURCE-EXIST
CALLNAT 'RMSRCK-N' #ERROR-CODE #ERROR-TEXT L-SOURCE-ID (I) SOURCE-EXIST
IF #ERROR-CODE NE 0
  REINPUT *#ERROR-CODE, #ERROR-TEXT MARK *L-MARK(I) ALARM
END-IF
IF NOT SOURCE-EXIST
  REINPUT *0426 MARK *L-MARK(I) ALARM
END-IF
*
END-SUBROUTINE /* CHECK-SOURCE
*
************************************************************************
DEFINE SUBROUTINE INIT-DAT-KEYS
************************************************************************
RESET #ERROR-CODE #ERROR-TEXT
IF #DATE11 = '*' OR = ' '
  RESET #DATE-F
  MOVE EDITED '20901231235959' TO #DATE-T (EM=YYYYMMDDHHIISS)
  ESCAPE ROUTINE
END-IF
IF NOT #DATE9-1 = '=' OR = '<' OR = '>'
  COMPRESS '=' #DATE9 TO #DATE9 LEAVING NO
END-IF
IF NOT #DATE11-1 = '=' OR = '<' OR = '>'
  COMPRESS '=' #DATE11 TO #DATE11 LEAVING NO
END-IF
*
CALLNAT 'IODATE-N' 'V' 'A' #DATE8 #DATE11-2 G-DATE-FORMAT
  #ERROR-CODE #ERROR-TEXT
IF #ERROR-CODE NE 0
  ESCAPE ROUTINE
END-IF
*
DECIDE FOR FIRST CONDITION
  WHEN #DATE11-1 = '='
    COMPRESS #DATE8 '000000' TO #DATE14 LEAVING NO
    MOVE EDITED #DATE14 TO #DATE-F   (EM=YYYYMMDDHHIISS)
    COMPRESS #DATE8 '235959' TO #DATE14 LEAVING NO
    MOVE EDITED #DATE14 TO #DATE-T   (EM=YYYYMMDDHHIISS)
  WHEN #DATE11-1 = '>'
    COMPRESS #DATE8 '000000' TO #DATE14 LEAVING NO
    MOVE EDITED #DATE14 TO #DATE-F  (EM=YYYYMMDDHHIISS)
    MOVE EDITED '20901231235959' TO #DATE-T (EM=YYYYMMDDHHIISS)
  WHEN #DATE11-1 = '<'
    RESET #DATE-F
    COMPRESS #DATE8 '235959' TO #DATE14 LEAVING NO
    MOVE EDITED #DATE14 TO #DATE-T  (EM=YYYYMMDDHHIISS)
  WHEN NONE
    IGNORE
END-DECIDE
*
END-SUBROUTINE /* INIT-DAT-KEYS
*
************************************************************************
DEFINE SUBROUTINE USER-EXIT-8
************************************************************************
INCLUDE NOMEX08C                  /* invoke exit
*
IF NOMEX008-ERROR-CODE EQ 0
  L-MESSAGE (#I) := NOMEX008-MESSAGE
ELSE
  COMPRESS 'E:' NOMEX008-ERROR-CODE TO L-MESSAGE (#I)
END-IF
*
END-SUBROUTINE /* USER-EXIT-8
*
INCLUDE RPFSET-C /*set-pfkeys
INCLUDE RTIMWIN /*#WAIT
*
