* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RSCHRP-N - increase a given date by a given period
*
* Maintenance
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 #P-IN-DATE                   (D)
1 #P-PERIOD                    (A5)
1 #P-OUT-DATE                  (D)
************************************************************************
LOCAL
1 ERROR                        (L)
1 #RETENTION                   (A5)
1 REDEFINE #RETENTION
  2 #RET-V                     (A1/1:5)
1 #LEN                         (P1)
1 #FACTOR                      (A1)
1 #VALUE                       (N5)
1 #DATE-A                      (A8)
1 REDEFINE #DATE-A
  2 #YYYY                      (N4)
  2 #MM                        (N2)
  2 #DD                        (N2)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET  #P-OUT-DATE
PERFORM VALIDATE-INPUT
DECIDE FOR FIRST CONDITION
  WHEN ERROR
    IGNORE
  WHEN #FACTOR = 'D'
    PERFORM INCREASE-BY-DAYS
  WHEN #FACTOR = 'W'
    PERFORM INCREASE-BY-WEEKS
  WHEN #FACTOR = 'M'
    PERFORM INCREASE-BY-MONTH
  WHEN #FACTOR = 'Y'
    PERFORM INCREASE-BY-YEAR
  WHEN NONE
    IGNORE
END-DECIDE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-INPUT
************************************************************************
MOVE #P-PERIOD TO #RETENTION
IF #RETENTION IS (N4)
  #FACTOR := 'D'
ELSE
  EXAMINE #RETENTION FOR 'X' GIVING LENGTH IN #LEN
  #FACTOR := #RET-V (#LEN)
  IF #LEN < 2   OR NOT(#RET-V(#LEN) = 'D' OR = 'W' OR = 'M' OR = 'Y')
    ERROR := TRUE
  END-IF
  RESET #RET-V(#LEN)
END-IF
IF NOT #RETENTION IS (N4)
  ERROR := TRUE
ELSE
  #VALUE := VAL(#RETENTION)
END-IF
*
END-SUBROUTINE /* VALIDATE-INPUT
*
************************************************************************
DEFINE SUBROUTINE INCREASE-BY-DAYS
************************************************************************
#P-OUT-DATE := #P-IN-DATE + #VALUE
*
END-SUBROUTINE /* INCREASE-BY-DAYS
*
************************************************************************
DEFINE SUBROUTINE INCREASE-BY-WEEKS
************************************************************************
#VALUE := #VALUE * 7
PERFORM INCREASE-BY-DAYS
*
END-SUBROUTINE /* INCREASE-BY-WEEKS
*
************************************************************************
DEFINE SUBROUTINE INCREASE-BY-MONTH
************************************************************************
MOVE EDITED #P-IN-DATE (EM=YYYYMMDD) TO #DATE-A
REPEAT
  UNTIL #VALUE = 0
  ADD 1 TO #MM
  IF #MM > 12
    ADD 1 TO #YYYY
    #MM := 1
  END-IF
  SUBTRACT 1 FROM #VALUE
END-REPEAT
PERFORM VALID-DAY
MOVE EDITED #DATE-A TO #P-OUT-DATE (EM=YYYYMMDD)
*
END-SUBROUTINE /* INCREASE-BY-MONTH
*
************************************************************************
DEFINE SUBROUTINE INCREASE-BY-YEAR
************************************************************************
MOVE EDITED #P-IN-DATE (EM=YYYYMMDD) TO #DATE-A
ADD #VALUE TO #YYYY
PERFORM VALID-DAY
MOVE EDITED #DATE-A TO #P-OUT-DATE (EM=YYYYMMDD)
*
END-SUBROUTINE /* INCREASE-BY-YEAR
*
************************************************************************
DEFINE SUBROUTINE VALID-DAY
************************************************************************
REPEAT
  UNTIL #DATE-A = MASK (YYYYMMDD)
  SUBTRACT 1 FROM #DD
  IF #DD < 1
    #DD := 31
    SUBTRACT 1 FROM #MM
    IF #MM < 1
      #MM := 12
      SUBTRACT 1 FROM #YYYY
    END-IF
  END-IF
END-REPEAT
*
END-SUBROUTINE /* VALID-DAY
*
END
