* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* --------------------------------------------------------------------
* Subprogram  NOARFF-N
* Version    2.2.1
* Function   NOM API Active Report Maintenance
*            Function: ADD-BC-RECORD
*
* Maintenance:
* XSETHZ  2002-08-24   created
* sju 05-03-16 NOM31   NAT AM=NOM
* fhi 05-04-21 NOM3107 Support 7-byte job numbers
* fhi 07-05-01 NOM3201 Support P11 format run-numbers
* xsetggr 2008-05-05 p(304350) restow due to changes in RMSPL--L
* SU1     2014-11-05 NOMALL-1450 fill fields for Adabas Vista
* SU2     2015-11-23 NOMALL-1784 avoid NAT1301 (P10->B4/I4 - big ISNs)
* SU3     2016-08-12 NOMALL-1814(NOM3.5) remove AdaVista fields
* SU4     2024-03-07 ES-34613    NOM 3.6 Remove power
* --------------------------------------------------------------------
DEFINE DATA
PARAMETER
1 #P-BUNDLE                (A25)
1 #P-BUNDRNB               (P11)
1 #P-REPNAME               (A25)
1 #P-REPRNB                (P11)
1 #P-N-BUNDRNB             (P11)
1 #P-SEPMEM                (A16)
1 #P-SPOOL-ATTRIBUTES      (A250)
1 #P-ISN                   (P10)   /* out /*SU2 was (I4)
1 #P-DESC                  (A50)
1 #P-MSG-NR                (N4)   /* out
************************************************************************
LOCAL USING VBURP-L
LOCAL USING RMSPL--L
LOCAL USING RMSR---E
LOCAL
1 BC-VISTA VIEW OF NRM-BUNDLE-CONTENTS /*SU3
  2 BC-OBJECT-TYPE
  2 BC-OBJECT-TIME
1 BUNDLES VIEW OF NRM-BUNDLES
  2 B-DESC
  2 B-FLAG-REPSEP
1 BR VIEW OF NRM-BUNDLE-REPORT
  2 BR-GROUP
  2 BR-SEQNO
  2 BR-REPNO
  2 BR-PRINTER
  2 BR-PAGEDEF
  2 BR-FORMDEF
1 #BC-SUPER                (A62)
1 REDEFINE #BC-SUPER
  2 #BC-BUNDLE             (A25)
  2 #BC-BUNDRNB            (P11)
  2 #BC-REPNAME            (A25)
  2 #BC-REPRNB             (P11)
1 #BUNDLE-REPORT           (A50)
1 REDEFINE #BUNDLE-REPORT
  2 #BUNDLE                (A25)
  2 #REPORT                (A25)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#BC-SUPER.#BC-BUNDLE  := #P-BUNDLE
#BC-SUPER.#BC-BUNDRNB := #P-BUNDRNB
#BC-SUPER.#BC-REPNAME := #P-REPNAME
#BC-SUPER.#BC-REPRNB  := #P-REPRNB
FNDBC2. FIND NUMBER BUNDLE-CONTENTS WITH
  BC-BUNDLE-RNB-REPORT-RNB = #BC-SUPER
IF *NUMBER (FNDBC2.) > 0
  #P-MSG-NR := 0437   /* report is already contained in bundle
  ESCAPE ROUTINE
END-IF
BC-VISTA.BC-OBJECT-TYPE := 'BC' /*SU1
BC-VISTA.BC-OBJECT-TIME := *TIMX /*SU1
S. STORE BC-VISTA
#P-ISN := *ISN(S.)
BC-GET. GET BUNDLE-CONTENTS #P-ISN
BUNDLE-CONTENTS.BC-REPNAME := #P-REPNAME
BUNDLE-CONTENTS.BC-REPRNB  := #P-REPRNB
BUNDLE-CONTENTS.BC-BUNDLE  := #P-BUNDLE
BUNDLE-CONTENTS.BC-BUNDRNB := #P-N-BUNDRNB
BUNDLE-CONTENTS.BC-GROUP   := SUBSTR(#P-BUNDLE,1,8)
BUNDLE-CONTENTS.BC-SEPMEM := #P-SEPMEM
BUNDLE-CONTENTS.BC-SEQNO  := 999
FIND (1) BUNDLES WITH B-BUNDLE = #P-BUNDLE
  IF NO RECORDS FOUND
    #P-MSG-NR:= 0408      /* bundle not defined
    ESCAPE ROUTINE
  END-NOREC
  IF BUNDLES.B-FLAG-REPSEP = 'Y'
    BUNDLE-CONTENTS.BC-SEPNO := 1
  END-IF
  #P-DESC := BUNDLES.B-DESC
  #BUNDLE-REPORT.#BUNDLE := #P-BUNDLE
  #BUNDLE-REPORT.#REPORT := #P-REPNAME
  FIND (1) BR WITH BR-BUNDLE-REPORT = #BUNDLE-REPORT
    BUNDLE-CONTENTS.BC-GROUP := BR-GROUP
    IF BR-SEQNO NE 0
      BUNDLE-CONTENTS.BC-SEQNO := BR-SEQNO
    END-IF
    BUNDLE-CONTENTS.BC-REPNO   := BR.BR-REPNO
    BUNDLE-CONTENTS.BC-PRINTER := BR.BR-PRINTER
    BUNDLE-CONTENTS.BC-PAGEDEF := BR.BR-PAGEDEF
    BUNDLE-CONTENTS.BC-FORMDEF := BR.BR-FORMDEF
  END-FIND
END-FIND
#SPOOL-ATTRIBUTES := #P-SPOOL-ATTRIBUTES
CALLNAT 'RMSPL7-N' #SPOOL-ATTRIBUTES #SPOOL-TYPE
DECIDE ON FIRST #SPOOL-TYPE
  VALUE JES2, JES3
    BUNDLE-CONTENTS.BC-CHARS   := #SPOOL-JES-CHARS
    BUNDLE-CONTENTS.BC-FCB     := #SPOOL-JES-FCB
    BUNDLE-CONTENTS.BC-FORM    := #SPOOL-JES-FORM
    BUNDLE-CONTENTS.BC-FLASH   := #SPOOL-JES-FLASH
    IF #SPOOL-JES-PAGEDEF NE ' '
      BUNDLE-CONTENTS.BC-PAGEDEF := #SPOOL-JES-PAGEDEF
    END-IF
    IF #SPOOL-JES-FORMDEF NE ' '
      BUNDLE-CONTENTS.BC-FORMDEF := #SPOOL-JES-FORMDEF
    END-IF
    BUNDLE-CONTENTS.BC-REPNO   := #SPOOL-JES-COPIES
/*SU4  VALUE POWER
  VALUE CMASPOOL
    BUNDLE-CONTENTS.BC-REPNO   := #SPOOL-CMA-COPYS
    BUNDLE-CONTENTS.BC-FORM    := #SPOOL-CMA-FORMS
    BUNDLE-CONTENTS.BC-FCB     := #SPOOL-CMA-FCB
    BUNDLE-CONTENTS.BC-PAGEDEF := #SPOOL-CMA-PAGED
    BUNDLE-CONTENTS.BC-FORMDEF := #SPOOL-CMA-FORMD
  VALUE NAF, NAT
    BUNDLE-CONTENTS.BC-REPNO   := #SPOOL-NAF-COPIES
    BUNDLE-CONTENTS.BC-FORM    := #SPOOL-NAF-FORM
  VALUE SEQUENTIAL-FILE-BS2
    BUNDLE-CONTENTS.BC-REPNO   := #SPOOL-BS2-COPIES
    BUNDLE-CONTENTS.BC-FORM    := #SPOOL-BS2-FORM
  NONE VALUE IGNORE
END-DECIDE
UPDATE (BC-GET.)
*
END
