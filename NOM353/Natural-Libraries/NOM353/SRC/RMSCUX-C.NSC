* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    RMSCUX-C
* Function  Copycode for scan Unix files: Move file to temp directory
* Version   3.4
*
* Maintenance
* uuu    yyyy-mm-dd s(999999)  Comment
* ------ ---------- ---------  ----------------------------------------
* fhi     2014-02-11 NOMALL-1338 replace MOVE function by mv command
* fhi     2014-02-20 NOMALL-1338 Use long command fields
* fhi     2014-03-07 NOMALL-1363 Use FILE/MOVE again, no more mv
*                                because NPR 2.1.4.20 is able to handle
* fhi     2014-10-21 NOMALL-79   Introduce long filenames
* SU1     2015-08-11 NOMALL-1690 XXHASH restructure
* fhi     2018-11-15 NOMALL-2160 MOVE to temp does not work
* fhi     2019-08-16 NOMALL-2294 Log successful MOVE
* BLI     2019-12-04 NOMALL-2294 Only successful MOVE returns 2070
* ---------------------------------------------------------------------
#TIMESTAMP-D := *DATN
#TIMESTAMP-T := *TIMN
#UX-FUNCTION := 'MOVE'
COMPRESS #PATH &1& &2& TO P-FILE-NAME LEAVING NO
COMPRESS UX-NODE-TEMPDIR &1& &2& '.' #TIMESTAMP
  TO P-TARGET-FILE LEAVING NO
EXAMINE P-FILE-NAME   FOR '//' REPLACE '/'
EXAMINE P-TARGET-FILE FOR '//' REPLACE '/'
PERFORM UNIX-FUNCTION
* fhi     2019-08-14 NOMALL-2294 start insertion
IF +TRACE-ORDER = 'Y' /* TRACE-ORDER found in jobcards
  COMPRESS 'Task' G-TASK-NUMBER *PROGRAM
    'Move of file' P-FILE-NAME 'to' P-TARGET-FILE
    'returned' G-NATRP-ERC G-NATRP-ERT
    TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
* fhi     2019-08-14 NOMALL-2294 end   insertion
IF G-NATRP-ERC EQ 0          /* BLI NOMALL-2294
  COMPRESS '2070' XXUX---P.P-FILE-NAME XXUX---P.P-NODE-NAME
    TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'W' G-TRACE-MSG
ELSE
  IF P-FILE-NAME NE SCAN('.nomxml') /* NOMALL-2160 fhi in
    PERFORM WRITE-ERROR-LOG
  END-IF
END-IF
END TRANSACTION /* NOMALL-2294 fhi in
