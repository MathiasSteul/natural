* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* NOMAR01N - Active Reports Maintenance
* Version   3.1
*
* Maintenance:
* uuu     yyyy-mm-dd s(999999) ....
* xsetggr 2007-05-25 P(294775) created
* xsetggr 2007-07-12 NOM3201   Support P11 format run numbers
* fhi     2007-07-12 NOM3202   C-NATERR changed, NAD23006 is obsolete.
* xsetggr 2008-02-20 p(294775) changes in NOMAR--P
* xsetggr 2008-05-05 p(304350) restow due changes in EOMARM-P, NOMAR--P
* xsetggr 2008-08-11 p(300323) add steplibs
* xsetggr 2009-02-10 p(300323) remove steplib handling,
*                              change getting value of EOM-LIBRARY
* fhi     2009-02-27 P300323 Rename RGETSTEP to NOMGSTEP delivered in SYSTEM
* fhi     2009-05-20 N3463     Extend metadata
* fhi     2010-09-03 NOMALL-97 Extend message line
* fhi     2010-09-21 NOMALL-97 Use no more C-NATERR but C-NATERN instead
* SU1     2013-01-31 unused      Deactivate unused data areas
* SU2     2014-11-12 NOMALL-1527 getting rid of coding for old versions
* SU3     2018-04-05 NOMALL-1961 Use new task IDs
**----------------------------------------------------------------------
DEFINE DATA PARAMETER USING NOMAR--P
*
LOCAL USING EOM----P
LOCAL USING EOMMSG-P
LOCAL USING NOMAR--E
LOCAL USING EOMARM-P
LOCAL USING SATFNC3E
LOCAL USING SATLF02P
LOCAL USING RACTLF-A
LOCAL
1 USER VIEW OF NRM-USERS
  2 USER-PROFILE
1 #LFILE-CHANGED               (L)
1 #NOM-DBID                    (N5)
1 #NOM-FNR                     (N5)
1 #LFILE-ACTIVE-CHANGED        (L)
1 #NOM-DBID-ACTIVE             (N5)
1 #NOM-FNR-ACTIVE              (N5)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET NOMAR-ERROR-CODE NOMAR-ERROR-TEXT
*
DECIDE FOR EVERY CONDITION
  WHEN NOMAR-NOM-FNR NE 0 AND NOMAR-NOM-DBID NE 0
    SATLF-LFILE := 206
    PERFORM GET-NOM-LFILE
    #NOM-DBID   := SATLF-DBID-N5
    #NOM-FNR    := SATLF-FNR-N5
    SATLF-LFILE := 206
    PERFORM SET-NOM-LFILE
    #LFILE-CHANGED := TRUE
  WHEN SATLF-ERROR-CODE = 0 AND
      NOMAR-NOM-DBID-ACTIVE NE 0 AND NOMAR-NOM-FNR-ACTIVE NE 0
    PERFORM SET-ACTIVE-LFILE
  WHEN NOMAR-ERROR-CODE = 0
    PERFORM OBJECT-MAINTENANCE
  WHEN #LFILE-CHANGED
    SATLF-LFILE := 206
    PERFORM SET-OLD-NOM-LFILE
  WHEN #LFILE-ACTIVE-CHANGED
    SATLF-LFILE   := 91
    SATLF-DBID-N5 := #NOM-DBID-ACTIVE
    SATLF-FNR-N5  := #NOM-FNR-ACTIVE
    PERFORM SET-LFILE
  WHEN NONE
    IGNORE
END-DECIDE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE OBJECT-MAINTENANCE
************************************************************************
/*SU2 IF NOMAR-NOMVERS < 32 NOMAR-REPRNB := NOMAR-REPRNB-V31 END-IF
RESET  EOM-LOGGING EOM-LOG-TYPES (*)
EOMARM-I-ATTRIBUTE-TYPE := NOMAR-ATTRIBUTE-TYPE
EOMARM-I-NAME := NOMAR-REPNAME
EOMARM-I-RNB := NOMAR-REPRNB
IF NOT (NOMAR-LANGUAGE = 1 OR = 2)
  EOM-LANGUAGE := *LANGUAGE
ELSE
  EOM-LANGUAGE := NOMAR-LANGUAGE
END-IF
EOM-USER := NOMAR-USERID
FIND USER WITH USER-ID = EOM-USER
  EOM-USER-PROFILE := USER-PROFILE
END-FIND
EOM-VERSION      := NOMAR-NOMVERS
EOM-LOG-TYPES(1) := NOMAR-LOG-TYP
EOM-FUNCTION     := NOMAR-FUNCTION
*
* retrieving of NOM library is done by using central NOM steplib routine
* NOMGSTEP
*
CALLNAT 'RGETLIB' EOM-LIBRARY
*
EOMARM-I-DEF-OWNER := EOM-DEF-USER  := F#MONITOR-USER-AUTODEF (<>) /*SU3
*
DECIDE ON FIRST NOMAR-FUNCTION
  VALUE NOMAR-FCT-READ, NOMAR-FCT-READHOLD,
      NOMAR-FCT-READ-NEXT, NOMAR-FCT-READHOLD-NEXT
    RESET NOMAR-ATTRIBUTES(*)
    PERFORM CALL-INTERNAL-API
    NOMAR-ATTRIBUTES (1:3) := EOMARM-ATTRIBUTES (1:3)
    NOMAR-REPNAME          := EOMARM-I-NAME
    NOMAR-REPRNB           := EOMARM-I-RNB
    NOMAR-EOF := EOMARM-EOF
  VALUE NOMAR-FCT-MODIFY
    EOMARM-ATTRIBUTES (1:3) := NOMAR-ATTRIBUTES (1:3)
    PERFORM CALL-INTERNAL-API
  VALUE NOMAR-FCT-DELETE
    PERFORM CALL-INTERNAL-API
  VALUE NOMAR-FCT-PRINT
    EOMARM-I-PRINTER        := NOMAR-PRINTER
    EOMARM-I-PRINT-COPIES   := NOMAR-PRINT-COPIES
    EOMARM-ATTRIBUTES (1:3) := NOMAR-ATTRIBUTES (1:3)
    PERFORM CALL-INTERNAL-API
  VALUE NOMAR-FCT-COMMIT
    PERFORM CALL-INTERNAL-API
  VALUE NOMAR-FCT-BACKOUT
    PERFORM CALL-INTERNAL-API
  NONE VALUE
    EOMMSG-NR := NOMAR-ERROR-CODE := 20 /*Function not allowed
    PERFORM GET-ERR-TXT
END-DECIDE
*
END-SUBROUTINE /* OBJECT-MAINTENANCE
*
************************************************************************
DEFINE SUBROUTINE CALL-INTERNAL-API
************************************************************************
RESET EOMMSG-PARMS
CALLNAT 'EOMARM-N' EOM-PARMS EOMARM-PARMS EOMMSG-PARMS
IF EOMMSG-NR NE 0
  NOMAR-ERROR-CODE := EOMMSG-NR
  IF EOMMSG-TEXT = ' '
    PERFORM GET-ERR-TXT
  ELSE
    NOMAR-ERROR-TEXT := EOMMSG-TEXT
  END-IF
  ESCAPE ROUTINE
END-IF
*
END-SUBROUTINE /* CALL-INTERNAL-API
*
************************************************************************
DEFINE SUBROUTINE GET-NOM-LFILE
************************************************************************
SATLF-FUNCTION := 'GET'
CALLNAT SAT-GET-SET-LFILE SATLF-SATVERS SATLF-PARMS (*)
*
END-SUBROUTINE /* GET-NOM-LFILE
*
************************************************************************
DEFINE SUBROUTINE SET-LFILE
************************************************************************
SATLF-FUNCTION := 'SET'
CALLNAT SAT-GET-SET-LFILE SATLF-SATVERS SATLF-PARMS (*)
*
END-SUBROUTINE /* SET-LFILE
*
************************************************************************
DEFINE SUBROUTINE SET-NOM-LFILE
************************************************************************
SATLF-DBID-N5 := NOMAR-NOM-DBID
SATLF-FNR-N5  := NOMAR-NOM-FNR
PERFORM SET-LFILE
*
END-SUBROUTINE /* SET-NOM-LFILE
*
************************************************************************
DEFINE SUBROUTINE SET-OLD-NOM-LFILE
************************************************************************
SATLF-DBID-N5 := #NOM-DBID
SATLF-FNR-N5  := #NOM-FNR
PERFORM SET-LFILE
*
END-SUBROUTINE /* SET-OLD-NOM-LFILE
*
************************************************************************
DEFINE SUBROUTINE SET-ACTIVE-LFILE
************************************************************************
IF NOMAR-NOM-DBID-ACTIVE NE 0 AND NOMAR-NOM-FNR-ACTIVE NE 0
  SATLF-LFILE      := 91
  PERFORM GET-NOM-LFILE
  #NOM-DBID-ACTIVE := SATLF-DBID-N5
  #NOM-FNR-ACTIVE  := SATLF-FNR-N5
  SATLF-DBID-N5    := NOMAR-NOM-DBID-ACTIVE
  SATLF-FNR-N5     := NOMAR-NOM-FNR-ACTIVE
  PERFORM SET-LFILE
  #LFILE-ACTIVE-CHANGED:= TRUE
  ESCAPE ROUTINE
END-IF
RESET RACTLF-LOGGING RACTLF-ERROR-LOGGING
RACTLF-LFILE-1:= 91
RACTLF-LFILE-2:= 206
CALLNAT 'RACTLF-N' RACTLF-PARMS
IF RACTLF-ERROR-CODE NE 0
  NOMAR-ERROR-CODE := 4
  ESCAPE ROUTINE
END-IF
*
END-SUBROUTINE /* SET-ACTIVE-LFILE
*
************************************************************************
DEFINE SUBROUTINE GET-ERR-TXT
************************************************************************
* SU 2018-04
NOMAR-ERROR-TEXT := F#GETMSG (<NOMAR-ERROR-CODE,EOMMSG-TOKEN(1:3)>)
*
END-SUBROUTINE /* GET-ERR-TXT
*
************************************************************************
ON ERROR
************************************************************************
  IF #LFILE-CHANGED
    SATLF-LFILE := 206
    PERFORM SET-OLD-NOM-LFILE
  END-IF
  IF #LFILE-ACTIVE-CHANGED
    SATLF-LFILE   := 91
    SATLF-DBID-N5 := #NOM-DBID-ACTIVE
    SATLF-FNR-N5  := #NOM-FNR-ACTIVE
    PERFORM SET-LFILE
  END-IF
  IF *ERROR-NR = 82
    WRITE *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II':'SS'.'T)
      'Missing NOM steplibs' //
      'Please call NOM steplib routine NOMGSTEP before call of NOM API.'
  END-IF
  NOMAR-ERROR-CODE := NOMAR-ERROR-TEXT := 21
  CALLNAT 'C-NATERN' NOMAR-ERROR-TEXT 'W'
  ESCAPE ROUTINE
END-ERROR
*
END
