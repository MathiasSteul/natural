* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* NOMERR-N - get error text from SYSERR
*
* Parameters:
* Input ..... P-ERC (N4)     - SYSERR error code
* Input ..... P-TEXT (A32/3) - substituted variables in SYSERR texts
* Output .... P-ERT (A250)   - error text from SYSERR
*
* Maintenance
* uuuuuu  yyyy-mm-dd s(999999) ...
* xsetggr 2009-02-10 P300323  created
* fhi     2010-09-03 NOMALL-97 Extend message line
* ---------------------------------------------------------------------
DEFINE DATA
PARAMETER
1 P-ERC     (N4)     /* in
1 P-TXT     (A32/3)  /* in
1 P-ERT     (A250)
************************************************************************
INDEPENDENT
1 +STEPLIB-TABLE (A8/8)
*
LOCAL USING SATFNC3E
LOCAL USING SATMS--P
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
 SATMS-GET-ERROR-TYPE := 'U'
 SATMS-GET-ERROR-CODE := P-ERC
 SATMS-GET-MSG-DYNA(*):= P-TXT (*)
 SATMS-GET-ERROR-APPL := +STEPLIB-TABLE(1)
 SATMS-GET-LANGUAGE   := *LANGUAGE
 CALLNAT SAT-GET-ERROR-TEXT SAT-CURRENT-VERSION SATMS-PARMS (*)
  IF SATMS-ERROR-CODE = 0
    P-ERT := SATMS-GET-SHORT-TEXT
  ELSE
    P-ERC := SATMS-ERROR-CODE
    P-ERT := SATMS-GET-SHORT-TEXT
  END-IF
END
