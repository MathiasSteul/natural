DEFINE DATA LOCAL
/* >Natural Source Header 000000
/* :Mode S
/* :CP
/* <Natural Source Header
*  ---------------------------------------------------------------------
*  Member     EDIT-CB
*  Function
*  Version    1.3
*
*  Maintenance
*  uuu yy-mm-dd s(999999) ....
*  gw  94-01-26 S(999999) use new  B   4fields for recnum and rectop
*                         fields ED-RECNUM and ED-RECTOP renamed to
*                         ED-RECNUM- OLDand ED-RECTOP-OLD
*  XSETHZ  2000-08-15 (CE7461)          EXTEND REPORT AND BUNDLE NAMES
*  xsetggr 2007-05-23 NOM3201           Support 11 byte run number
*  ---------------------------------------------------------------------
1 EDIT-CB (B4) /* EDITOR CONTROL BLOCK
1 REDEFINE EDIT-CB /* REDEF. BEGIN : EDIT-CB
  2 ED-CTADR (B4) /* CONTROL AREA ADDRESS
1 ED-DTADR (B4) /* DATA AREA ADDRESS
1 REDEFINE ED-DTADR /* REDEF. BEGIN : ED-DTADR
  2 ED-RECTOP (B4) /* NEW TOP RECNO
1 ED-ADABAS (B4) /* ADDRESS OF ADABAS
1 REDEFINE ED-ADABAS /* REDEF. BEGIN : ED-ADABAS
  2 ED-RECNUM (B4) /* NEW RECORD NUMBER
1 ED-ENV (B1) /* ENVIROUNMENT
1 REDEFINE ED-ENV /* REDEF. BEGIN : ED-ENV
  2 ED-NEWNUM (A1) /* 'Y' - USE NEW B4 REC-NUMBER
1 ED-NATVER (B1) /* NATURAL VERSION
1 ED-CTPLACE (B1) /* CONTROL DATA PLACE (BP OR SA)
1 ED-DTPLACE (B1) /* DATA PLACE (BP OR SA)
1 ED-CTLEN (B2) /* CONTROL AREA LENGTH (IN K)
1 ED-BPLEN (B2) /* BUFFER POOL LENGTH (IN K)
1 ED-SESNUM (B2) /* SESSION NUMBER
1 ED-REQUEST (A4) /* REQUEST FROM THE EDITOR
1 ED-DSTYPE (A3) /* DATA SET TYPE
1 ED-SYSID (A1) /* SYSTEM ID
1 ED-BPUSE (B1) /* USE / DO NOT USE BUFFER POOL
1 ED-SYSNUM (B1) /* DATA SET NUMBER (FOR SYSOUT)
1 ED-SYSNAME (A2) /* DATA SET NAME (FOR SYSOUT)
1 ED-DBID (B1) /* DBID - FOR NATURAL PROCESS
1 ED-UCMND (B1) /* USER COMMANDS CHECK
1 ED-NODE (B1) /* NODE - FOR NATURAL PROCESS
1 ED-RENUM (B1) /* RENUM AMOUNT
1 ED-DSNAME (A44) /* DATA SET NAME
1 ED-MEMBER (A8) /* MEMBER NAME
1 ED-VOLSER (A6) /* VOLSER FOR PDS OR SEQ
1 ED-PASSWD (A8) /* PASSWORD FOR THE FILE
1 ED-MCMND (A50) /* MAIN COMMAND
1 REDEFINE ED-MCMND /* REDEF. BEGIN : ED-MCMND
  2 DOS-LIBRARY (A8) /* DOS - LIBRARY NAME
  2 DOS-SUBLIB (A8) /* DOS - SUB LIBRARY
  2 DOS-MEMBER-TYPE (A8) /* DOS - MEMBER TYPE
  2 DOS-VSAM-CATALOG (A8) /* DOS - VSAM CATALOG
1 ED-SCMND (A8) /* SECONDARY COMMAND
1 ED-SCROLL (A4) /* SCROLL
1 ED-CAREA (B2) /* CURSOR AREA
1 ED-CROW (B2) /* CURSOR ROW
1 ED-CCLM (B2) /* CURSOR COLUMN
1 ED-RECLEN (B2) /* RECORD LENGTH
1 ED-RECNUM-OLD (B2) /* # OF RECORDS IN THE FILE
1 ED-RECMAX (B2) /* MAXIMUM RECORDS FOR FILE
1 ED-RECTOP-OLD (B2) /* TOP RECORD
1 ED-PRFLEN (B2) /* WANTED PREFIX LENGTH
1 ED-PRFENT (B2) /* LENGTH OF EACH PREFIX ENTRY
1 ED-SCRLEN (B2) /* LENGTH OF SCREEN LINE
1 ED-SCRNUM (B2) /* # OF LINES IN EACH SCREEN
1 ED-SCRMAX (B2) /* MAXIMUM LINES FOR A SCREEN
1 ED-LINENTL (B2) /* LENGTH OF EACH LINE ENTRY
1 ED-LINETYPE (B1) /* WANTED TYPE OF LINE
1 ED-UPDTFILE (B1) /* ALLOW OR DISALLOW UPDATE
1 ED-UPDTSES (B1) /* # of updated session
1 ED-OMSGNUM (B2) /* OLD MESSAGE NUMBER
1 ED-OERRNUM (B2) /* OLD ERROR NUMBER
1 ED-NEWCB (A1) /* Y - NEW CB
1 ED-SYSBR (A1) /* Y - PARTIAL SYSOUT BROWSE
1 ED-FLINE (A80) /* FIRST LINE
1 ED-PROF1 (A20) /* USER PROFILE
1 REDEFINE ED-PROF1 /* REDEF. BEGIN : ED-PROF1
  2 PROF-CAPS (A1) /* TRANSLATE TO UPPER CASE
  2 PROF-HEX (A1) /* DISPLAY HEXADECIMAL MODE
  2 PROF-NULLS (A1) /* PUT NULLS AT END OF LINE
  2 PROF-JUSTIFY (A1) /* JUSTIFICATION : L,R,B
  2 PROF-LOGCHR (A1) /* CHARACTER FOR LOGICAL TAB
  2 PROF-RECOVERY (A1) /* PERFORM RECOVERY
  2 PROF-AUTOSAVE (A1) /* DO AUTOMATIC SAVE AT END
  2 PROF-AUTOREN (A1) /* DO AUTOMATIC RENUMBERING
  2 PROF-LOG (A1) /* LOG  ON / OFF
  2 PROF-PHSTAB (A1) /* PHYSICAL TABULATION
  2 PROF-PHSCHR (B1) /* CHARACTER FOR PHYSICAL TAB
  2 PROF-LANGUAGE (B1) /* LANGUAGE
  2 PROF-DIRECTION (B1) /* DIRECTION OF NUMBERS
  2 PROF-MSO (A1) /* MULTI SESSION OPRERATION
  2 PROF-MASK (A1) /* MASK ON/OFF
  2 PROF-RENUM (B1) /* RENUMBERING AMOUNT
  2 PROF-FIX (A1) /* FIX ON / OFF
  2 PROF-FIXLEN (B1) /* FIX LENGTH IF 0 - FIX IS OFF
  2 PROF-ADVANCE (A1) /* ADVANCE YES / NO
  2 PROF-PROTECT (A1) /* PROTECT YES / NO / INSERT
1 ED-USER (A8) /* USER
1 ED-DATE (A8) /* DATE
1 ED-TIME (A8) /* TIME
1 ED-OJOBNUM (B2) /* OLD JOB NUMBER (FOR SYSOUT)
1 ED-ALARM (B1) /* NEED OF ALARM
1 ED-BLKNUM (B2) /* # OF BLOCKS OF BP FILE
1 ED-BLKLEN (B2) /* LENGTH OF BP BLOCK
1 ED-SRAFREE (B4) /* FREE AREA IN SOURCE AREA
1 ED-FILECHG (B1) /* 1 - FILE HAS BEEN CHANGED
1 ED-ORCVNUM (B4) /* OLD # OF RECOVERY FILE
1 ED-UDATA (A32) /* USER DATA
1 ED-PROF2 (A12) /* PROFILE - SECOND PART
1 REDEFINE ED-PROF2 /* REDEF. BEGIN : ED-PROF2
  2 PROF-ESCAPE (A1) /* ESCAPE ON / OFF / ZUL
  2 PROF-ESCHAR (A1) /* ESCAPE CHARACTER
  2 PROF-ESCDIR (A1) /* ESCAPE DIRECTION + OR -
  2 PROF-ESCDISP (A1) /* ESCAPE DISP
  2 PROF-EMPTY (A1) /* EMPTY ON/OFF
  2 PROF-INSERT (A1) /* INSERT ON/OFF
  2 PROF-HYPHENATION (A1) /* HYPHENATION ON/OFF
  2 PROF-HSYMBOL (A1) /* HYPHENATION SYMBOL
  2 PROF-HCHAR (B1) /* HYPHENATION CHARACTER
  2 PROF-TWOLANG (B1) /* SECOND LANGUAGE ID
  2 PROF-DECIMAL (A1) /* DECIMAL CHARACTER
  2 PROF-AORDER (A1) /* AUTO ORDER YES/NO
1 ED-FFU1 (B3) /* FOR FUTURE USE
1 ED-RCVNUM (B4) /* RECOVERY FILE #
1 ED-MSGNUM (B2) /* MESSAGE NUMBER
1 ED-ERRNUM (B2) /* ERROR NUMBER
1 ED-JOBNUM (B2) /* JOB NUMBER (FOR SYSOUT)
1 ED-PROF3 (A20) /* THIRD PROFILE
1 REDEFINE ED-PROF3 /* REDEFINE PROF3
  2 PROF-ATTRDATA (A1) /* PUT ATTRIBUTE IN DATA YES/NO
  2 PROF-ATTRDEF (B1) /* DEFUALT ATTRIBUTE CHARACTER
  2 PROF-ATTRH (B1) /* HIGH LIGHT ATTRIBUTE CHAR
  2 PROF-ATTRP (B1) /* PROTECTED ATTRIBUTE CHAR
  2 PROF-LIMIT (A1) /* SCAN LIMIT ON/OFF
1 ED-FILE (A132)
1 REDEFINE ED-FILE /* REDEF. BEGIN : ED-FILE
  2 ED-PM-TYPE (A3)
  2 ED-PM-SYSTEM (A1)
  2 ED-PM-DSNAME (A54)
  2 ED-PM-MEMBER (A10)
  2 ED-PM-VOLSER (A6)
  2 ED-PM-PASSWD (A8)
  2 ED-PM-DBID (B1)
  2 ED-PM-NODE (B1)
*  ---------------------------------------------------------------------
*  NOM Fields
*  ---------------------------------------------------------------------
1 REDEFINE ED-FILE /* REDEF. BEGIN : ED-FILE
  2 ED-NRM-LOCATION (A1)
  2 ED-NRM-REPNAME (A25) /* (A17) XSETHZ  (CE7461)
  2 ED-NRM-REPRNB (P11) /* (P7) xsetggr NOM3201
  2 ED-NRM-MAXREC (P9)
  2 ED-NRM-LAYOUT (B21) /* F(474)
  2 REDEFINE ED-NRM-LAYOUT /* REDEF. BEGIN : ED-NRM-LAYOUT
    3 ED-NRM-HEAD (B1)
    3 ED-NRM-RANGES (10)
      4 ED-NRM-FCOL (B1)
      4 ED-NRM-TCOL (B1)
  2 ED-NRM-FROMLINE (P9)
  2 ED-NRM-TOLINE (P9)
  2 ED-NRM-DBID (P3)
  2 ED-NRM-ASA-CODE-ON (A1)
  2 ED-NRM-LRECL (P3) /* GW 92-04-01
  2 ED-NRM-SOURCE-ISN (P10)
  2 ED-NRM-SOURCE-TYPE (I2)
  2 ED-NRM-SOURCE-CC-TYPE (I2)
  2 ED-NRM-SOURCE-IDENT (A49) /* (A51) xsetggr NOM3201
*  ---------------------------------------------------------------------
1 ED-E-PROGRAM (A8) /* PROGRAM NAME (FOR EDIT)
1 ED-B-PROGRAM (A8) /* PROGRAM NAME (FOR BROWSE)
1 ED-FFU2 (A32) /* FOR FUTURE USE
END-DEFINE
