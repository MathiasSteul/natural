* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    C-Forwrd
* Version   2.2
* Maintenance
* uuu yy-mm-dd s(999999) ...
* fhi 02-10-30 fhi101    switch on optimizer compiler
* SU1     2016-07-25 NOMALL-1518 NOM3.5 deactivate opt.Compiler
* ----------------------------------------------------------------------
/*STRUCT OFF
/*SU1 OPTIONS MCG=(INDX=ON,OVFLW=ON,DIGTCHCK=ON) /*fhi101 inserted
  WHEN #FORWARD
    IF #END-OF-DATA
      ESCAPE ROUTINE
    END-IF
    IF #CP = #NOFPAGES
      #PAGES(1 : #NOFPAGES - 1) := #PAGES(2 : #NOFPAGES)
      RESET #PAGES(#CP)
      #PAGES(#CP) := #LAST-KEY
    ELSE
      IF #SCROLL-AMOUNT < 1
        #SCROLL-AMOUNT := 1
      END-IF
      IF #CP + #SCROLL-AMOUNT <= #MAXAP
        #CP := #CP + #SCROLL-AMOUNT
      ELSE
        ADD 1 TO #CP
      END-IF
      IF #CP > #MAXAP
        #PAGES(#CP) := #LAST-KEY
      END-IF
    END-IF
/*SU1 OPTIONS MCG=(OFF) /*fhi101 inserted
** End of C-FORWRD *****************************************************
