  '1', /*CURSOR    13 ok
  ' ', /*DELETE   -14
  '1', /*DOWN      15 ok
  ' ', /*UHALF    -16
  '1', /*END       17 ok
  '1', /*EXCLUDE   18 ok
  '1', /*FIND      19 ok
  ' ', /*UPAGE    -20 ??
  '1', /*HEX       21 ok NOM
  ' ', /*HOME     -22
  '1', /*INCLUDE   23 ok
  ' ', /*SHIFT    -24
  '1', /*LABEL     25 ok
  ' ', /*LC       -26 V351--
  '1', /*LEFT      27 ok
  ' ', /*LIBRARY  -28
  '1', /*LOCATE    29 ok
  ' ', /*MAX      -30
  ' ', /*MEMBER   -31
  ' ', /*SUBMEM   -32
  '1', /*NOP      -33 ÜÜÜÜ ATTENTION: MUST BE SET ÜÜÜÜ but WHY ??
  '1', /*X         34 ok (=exclude)
  ' ', /*NULLS    -35 V351
  '1', /*PROFILE   36 ok for trace or.. (RESET to remove)
  '1', /*QUIT      37 ok
  ' ', /*RCHANGE  -38 V351--
  ' ', /*RECOVER  -39 V351--
  ' ', /*RENUMBER -40 V351--
  '1', /*RESET     41 ok
  '1', /*RFIND     42 ok
  '1', /*RIGHT     43 ok
  ' ', /*SAVE     -44 V351--
  '1', /*Y         45 ok (=locate .y)
  ' ', /*SORT     -46 V351-- ???
  ' ', /*DHALF    -47
  ' ', /*DPAGE    -48
  ' ', /*SUBMIT   -49 V351--
  ' ', /*INSERT   -50
  ' ', /*REBUILD  -51 V351--
  ' ', /*TABS     -52 V351--
  '1', /*TOP       53 ok
  ' ', /*UC       -54 V351--
  '1', /*UP        55 ok
  ' ', /*XSWAP    -56 V351--
  ' ', /*CREATEALL-57 V351--
  ' ', /*LANG     -58 V351 parm err
  ' ', /*DIRECTION-59 V351--
  ' ', /*CTYPE    -60 V351 parm err
  ' ', /*MSO      -61 V351--
  ' ', /*DELWORD  -62 V351--
  ' ', /*UNDO     -63 V351--
  ' ', /*FILE     -64 V351--
  ' ', /*TYPE     -65 V351 parm err
  ' ', /*?????    -66 not defined ÜÜ
  ' ', /*MASK     -67 V351
  ' ', /*POWER    -68 V351--
  ' ', /*ORDER    -69 V351--
  ' ', /*CENTER   -70
  ' ', /*JLEFT    -71
  ' ', /*JRIGHT   -72
  ' ', /*NEXT     -73 V351
  ' ', /*PREV     -74 V351
  ' ', /*UNREN    -75 V351--
  ' ', /*OREPLACE -76
  '1', /*FIX       77 ok
  ' ', /*ADVANCE   78 would be nice, but do not work Ü
  ' ', /*COPYSRA  -79 V351--  no error (copy source area) ??
  '1', /*PRINT     80 ok NOM
  '1', /*PROTECT   81 ok
  ' ', /*ESCAPE   -82 V351--  no error ??
  '1', /*EXPORT    83 ok  NOM
  ' ', /*IMPORT   -84 V351-- ÜÜÜ must be set to activate export ÜÜ???
  ' ', /*EMPTY    -85 V351
  ' ', /*DX       -86
  ' ', /*DY       -87
  ' ', /*DX_Y     -88
  ' ', /*EX       -89
  ' ', /*EY       -90
  ' ', /*EX_Y     -91
  ' ', /*POINT    -92 V351--
  ' ', /*BUILD    -93 V351--
  ' ', /*HYPHEN   -94 V351--
  ' ', /*JUSTIFY  -95 V351
  ' ', /*TWOLANG  -96 V351--
  ' ', /*AORDER   -97 V351
  ' ', /*PUTATTR  -98 V351--
  ' ', /*WINDOW   -99  V351--
  ' ', /*CWINDOW  -100 V351--
  ' ', /*MWINDOW  -101 V351--
  ' ', /*DWINDOW  -102 V351--
  ' ', /*LOG      -103 V351--  no error ??
  '1', /*LIMIT     104 V351-- / for FIND ok
  ' ', /*COPY     -105 V351 ??
