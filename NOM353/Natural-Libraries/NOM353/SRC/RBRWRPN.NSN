* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RBRWRPN - allowed editor main cmds (browse AR): bits as bytes for
*   CALL 'EDITOR'
*     ED-REQUEST := 'AMCS' /* allow main commands
*     ED-MCMND := #BYTE
*   See NSPF92(ISP-USES / for editor line cmds: RBRWRPN2
* Maintenance
* SU1 2023-12-11 NOMALL-2489 created for hex on MF
************************************************************************
DEFINE DATA
PARAMETER
1 #BYTE         (A15)  /*out: 15 bytes with 120 bites
1 REDEFINE #BYTE
  2 #BYTE1      (A1)
************************************************************************
LOCAL
1 #MAX          (I2) CONST <120>
1 #BITS         (A1/#MAX) INIT (V) <  /*=8*15
* x: ' '=not allowed / '1'=allowed
* y: '-'=not allowed is ok
* NR: nr. from word doc. editor engine (BOE)
* REMARK: V351-- means: cmd in V351 without error, but nothing happens
*         ok: allow is ok
*  x    CMD        yNR REMARK
*  -    ---------  --- -------
  ' ', /*CLEAR     -1
  ' ', /*AUTOSAVE  -2 V351
  ' ', /*PAGE      -3
  '1', /*BNDS       4 ok / for FIND
  '1', /*BOTTOM     5 ok
  '1', /*CANCEL     6 ok
  ' ', /*CAPS      -7 V351
  ' ', /*CHANGE    -8 V351--
  ' ', /*CLIBRARY  -9
  '1', /*COLS      10 ok
  ' ', /*OCOPY    -11
