*                              without parm:Required parameter miss
  ' ', /*NEXTF    -108 V351--
  ' ', /*PREVF    -109 V351--
  ' ', /*SEQUENCE -110 V351--
  ' ', /*STATS    -111 V351--
  ' ', /*NUMBER   -112 V351--
  ' ', /*OWINDOW  -113 V351--
  ' ', /*ADD      -114 V351--
  ' '> /*MESSAGE  -115
1 REDEFINE #BITS
  2 #BIT1       (A1)
1 NAT00038-LEN  (B2)
1 NAT00038-RC   (N4)
1 #I            (I2)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET #BYTE
FOR #I =1 TO #MAX
  IF #BITS (#I) NE '1'
    #BITS (#I) := '0'
  END-IF
END-FOR
* Bits to bytes:
NAT00038-LEN := #MAX / 8 /* 120/8=15 byte
CALLNAT 'NAT00038' 'Y' #BYTE1 #BIT1 NAT00038-LEN NAT00038-RC
IF NAT00038-RC NE 0
  PRINT *DAT4I *TIME(AL=8) *PROGRAM '>> NAT00038 rc:' NAT00038-RC
    'bits:' #BITS (*)
END-IF
**FOR #I =11 TO 11
**  MOVE H'FF' TO SUBSTR(#BYTE,#I,1) /*??? does export work ?
**END-FOR
