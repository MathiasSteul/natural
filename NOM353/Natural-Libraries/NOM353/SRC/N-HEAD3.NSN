* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
************************************************************************
* Member    N-HEAD3
* Version   3.5.2
* Function  generate string for 'since/seit'
*   <i>2022-03-26 14:22
*   Usage: INPUT (AD=O) #STAT-OUT (AD=I DY=<D#) /*<i> means intensified
*
* Maintenance
* uuuuuuu yyyy-mm-dd Issue
* BLI     2022-08-15 NOMALL-2505 adapted from N-HEAD2
************************************************************************
*
DEFINE DATA PARAMETER
1 #STAT-DATE         (T)   /*in
1 REDEFINE #STAT-DATE
  2 #STAT-DATE_P13   (P13)
1 #STAT-OUT          (A22) BY VALUE RESULT /*out
1 DATE-FORMAT        (A1)
* *****
LOCAL
1 #A_A10             (A10)
1 #A_A8              (A8)
1 #D-ON              (A1) CONST <H'01'> /*dark on
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET #STAT-OUT
IF #STAT-DATE_P13 NE MASK(NNNNNNNNNNNNZ) OR #STAT-DATE = 0
  ESCAPE ROUTINE
END-IF
IF *LANGUAGE = 2
  #STAT-OUT := 'seit'
ELSE
  #STAT-OUT := 'since'
END-IF
DECIDE ON EVERY VALUE OF DATE-FORMAT
  VALUE 'A','B'
    MOVE EDITED #STAT-DATE (EM=MM'/'DD'/'YYYY) TO #A_A10
  VALUE 'E','F'
    MOVE EDITED #STAT-DATE (EM=DD'/'MM'/'YYYY) TO #A_A10
  VALUE 'G','H'
    MOVE EDITED #STAT-DATE (EM=DD'.'MM'.'YYYY) TO #A_A10
  NONE /* ' ','I','J'
    MOVE EDITED #STAT-DATE (EM=YYYY'-'MM'-'DD) TO #A_A10
END-DECIDE
MOVE EDITED #STAT-DATE (EM=HH':'II) TO #A_A8 /*':'SS
COMPRESS #STAT-OUT #D-ON #A_A10 #D-ON #A_A8
  TO #STAT-OUT LEAVING NO
MOVE RIGHT #STAT-OUT TO #STAT-OUT
*
END
