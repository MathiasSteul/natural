* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    Rselect
* Version   2.1
* Function  Specification of selection criteria
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* sju 00-05-31 p179982   created
* xsiszha 2000-08-15 (CE7461) Extend Report and Bundle Names
* SU1     2016-08-02 NOMALL-1518 NOM3.5 deactivate opt.Compiler
* ----------------------------------------------------------------------
DEFINE DATA
GLOBAL USING  NRM-GL
*
INDEPENDENT
/*SU 2018-10-16 1 +G-RLIACE-SEL-MAILED                 (A11)
/*SU 2018-10-16 1 +G-RLIACE-SEL-MAILED-F               (T)
/*SU 2018-10-16 1 +G-RLIACE-SEL-MAILED-T               (T)
/*SU 2018-10-16 1 +G-RLIACE-SEL-DATE                   (A11)
/*SU 2018-10-16 1 +G-RLIACE-SEL-DATE-F                 (T)
/*SU 2018-10-16 1 +G-RLIACE-SEL-DATE-T                 (T)
/*SU 2018-10-16 1 +G-RLIACE-SEL-ARC-FLAG               (A1)
/*SU 2018-10-16 1 +G-RLIACE-SEL-REV-FLAG               (A1)
/*SU 2018-10-16 1 +G-RLIACE-SEL-LOCATION               (A1)
1 +G-RLIACF-SEL-REPNAME                (A25)
1 +G-RLIACF-SEL-ARC-FLAG               (A1)
1 +G-RLIACF-SEL-REV-FLAG               (A1)
1 +G-RLIACF-SEL-LOCATION               (A1)
/*SU 2018-10-16 1 +G-RLIACS-SEL-REPNAME                (A25)
1 +G-RLISAB-SEL-ABUNDLE                (A25)
1 +G-RLISAB-SEL-STAT                   (A1)
1 +G-RLISAB-SEL-COORD                  (A8)
1 +G-RLISAD-SEL-DSN                    (A44)
1 +G-RLISBC-SEL-GROUP                  (A8)
1 +G-RLISBC-SEL-REPNAME                (A25)
1 +G-RLISBR-SEL-REPNAME                (A25)
1 +G-RLISBR-SEL-GROUP                  (A8)
1 +G-RLISBU-SEL-REPORT                 (A25)
1 +G-RLISBU-SEL-BUNDLE                 (A25)
1 +G-RLISBU-SEL-AUTHORIZATION          (A8)
1 +G-RLISCA-SEL-CAL                    (A8)
1 +G-RLISDL-SEL-LIST                   (A8)
1 +G-RLISDL-SEL-AUTHORIZATION          (A8)
1 +G-RLISDR-SEL-REPORT                 (A25)
1 +G-RLISFO-SEL-FOLDER                 (A16)
1 +G-RLISPH-SEL-PID                    (A8)
/*SU 2018-10-16 1 +G-USER-TYPE                         (A1)
1 +G-RLISPO-SEL-REPNAME                (A25)
1 +G-RLISPO-SEL-PID                    (A8)
/*SU 2018-10-16 1 +G-RLISPO-SEL-STATUS                 (A1)
1 +G-RLISRP-SEL-REPNAME                (A25)
1 +G-RLISRP-SEL-AUTHORIZATION          (A8)
1 +G-RLISRP-SEL-REPORT-TYPE            (A1)
1 +G-RLISPR-SEL-PID                    (A8)
1 +G-RLISPR-SEL-PHYSICAL               (A8)
1 +G-RLISPR-SEL-AUTHORIZATION          (A8)
1 +G-RLISUS-SEL-USERID                 (A8)
************************************************************************
LOCAL  USING  RPFK---L
*
LOCAL
1 #FUNC                                (A1)
1 #USER                                (A8)
1 CV-MAP                               (C) INIT < (AD=I CD=NE)>
1 L-HEADER                             (A78)
1 #FATHER-PROG                         (A8) INIT <'RMENU'>
1 #LANGUAGE                            (I1)
1 #PANEL                               (I1) INIT <1>
1 #INVALID-AUTH-BU                     (L)
1 #INVALID-AUTH-RP                     (L)
1 #INVALID-AUTH-PR                     (L)
1 #INVALID-AUTH-DL                     (L)
1 #G-RLISDR-SEL-REPORT                 (A25)
1 REDEFINE #G-RLISDR-SEL-REPORT
  2 #G-RLISDR-SEL-REPORT-17            (A17)
  2 #G-RLISDR-SEL-REPORT-R             (A8)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET G-COMMIT G-LINECOM(*)
*
#FUNC := 'M'
#USER := G-USERID
*
MAIN-LOOP. REPEAT
  SCREEN-LOOP. REPEAT
    IF #LANGUAGE NE *LANGUAGE
      #LANGUAGE := *LANGUAGE
      PERFORM INIT-PFKEYS
      PERFORM SET-PFKEYS
    END-IF
*
    PERFORM FLIP-DISPLAY
    SET CONTROL 'L'
    SET CONTROL 'WB'
    CALLNAT 'N-HEADER' L-HEADER G-DATE-FORMAT 'RSELCT1&'
    RESET G-MAP-MODIFIED G-NATRP-ERC G-NATRP-ERT
*
    IF #PANEL = 1
      IF G-DISPLAY-LONG-NAMES
        INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
          MARK *G-DIRECT-COMMAND USING MAP 'RSELCT3&'
      ELSE
        INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
          MARK *G-DIRECT-COMMAND USING MAP 'RSELCT1&'
      END-IF
    ELSE
      #G-RLISDR-SEL-REPORT := +G-RLISDR-SEL-REPORT
      IF NOT G-DISPLAY-LONG-NAMES
        #G-RLISDR-SEL-REPORT-R := H'FA'
      END-IF
      INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
        MARK *G-DIRECT-COMMAND USING MAP 'RSELCT2&'
      IF G-DISPLAY-LONG-NAMES
        +G-RLISDR-SEL-REPORT := #G-RLISDR-SEL-REPORT
      ELSE
        +G-RLISDR-SEL-REPORT := #G-RLISDR-SEL-REPORT-17
      END-IF
    END-IF
*
    INCLUDE RPFKVA-C
    DECIDE ON FIRST VALUE OF G-PF-FUNC
      VALUE 'HELP'     REINPUT USING HELP
      VALUE 'EXIT'     ESCAPE BOTTOM(MAIN-LOOP.)
      VALUE 'FLIP'     PERFORM FLIP-HANDLE
      VALUE 'UP'       #PANEL:= 1
      VALUE 'DOWN'     #PANEL:= 2
      VALUE 'EXT'
        IF G-DISPLAY-LONG-NAMES
          G-DISPLAY-LONG-NAMES := FALSE
        ELSE
          G-DISPLAY-LONG-NAMES := TRUE
        END-IF
        RESET #LANGUAGE
      VALUE 'RESET'
        IF #PANEL = 1
          RESET +G-RLIACF-SEL-ARC-FLAG +G-RLIACF-SEL-LOCATION
            +G-RLIACF-SEL-REPNAME +G-RLIACF-SEL-REV-FLAG
            +G-RLISAB-SEL-ABUNDLE +G-RLISAB-SEL-COORD
            +G-RLISAB-SEL-STAT +G-RLISBC-SEL-GROUP
            +G-RLISBC-SEL-REPNAME +G-RLISBR-SEL-GROUP
            +G-RLISBR-SEL-REPNAME +G-RLISBU-SEL-AUTHORIZATION
            +G-RLISBU-SEL-BUNDLE +G-RLISBU-SEL-REPORT
            +G-RLISPO-SEL-PID +G-RLISPO-SEL-REPNAME
            +G-RLISRP-SEL-AUTHORIZATION
            +G-RLISRP-SEL-REPNAME +G-RLISRP-SEL-REPORT-TYPE
/*SU 2018-10-16 +G-RLISPO-SEL-STATUS
        ELSE
          RESET +G-RLISPH-SEL-PID +G-RLISPR-SEL-PID
            +G-RLISPR-SEL-PHYSICAL +G-RLISPR-SEL-AUTHORIZATION
            +G-RLISAD-SEL-DSN +G-RLISCA-SEL-CAL
            +G-RLISDL-SEL-LIST +G-RLISDL-SEL-AUTHORIZATION
            +G-RLISDR-SEL-REPORT +G-RLISFO-SEL-FOLDER +G-RLISUS-SEL-USERID
        END-IF
      VALUE 'RESETALL'
        RESET +G-RLIACF-SEL-ARC-FLAG +G-RLIACF-SEL-LOCATION
          +G-RLIACF-SEL-REPNAME +G-RLIACF-SEL-REV-FLAG
          +G-RLISAB-SEL-ABUNDLE +G-RLISAB-SEL-COORD
          +G-RLISAB-SEL-STAT +G-RLISBC-SEL-GROUP
          +G-RLISBC-SEL-REPNAME +G-RLISBR-SEL-GROUP
          +G-RLISBR-SEL-REPNAME +G-RLISBU-SEL-AUTHORIZATION
          +G-RLISBU-SEL-BUNDLE +G-RLISBU-SEL-REPORT
          +G-RLISPO-SEL-PID +G-RLISPO-SEL-REPNAME
/*SU 2018-10-16 +G-RLISPO-SEL-STATUS
          +G-RLISRP-SEL-AUTHORIZATION
          +G-RLISRP-SEL-REPNAME +G-RLISRP-SEL-REPORT-TYPE
          +G-RLISPH-SEL-PID +G-RLISPR-SEL-PID
          +G-RLISPR-SEL-PHYSICAL +G-RLISPR-SEL-AUTHORIZATION
          +G-RLISAD-SEL-DSN +G-RLISCA-SEL-CAL +G-RLISDL-SEL-LIST
          +G-RLISDL-SEL-AUTHORIZATION +G-RLISDR-SEL-REPORT
          +G-RLISFO-SEL-FOLDER +G-RLISUS-SEL-USERID
      VALUE 'MENU'     ESCAPE BOTTOM(MAIN-LOOP.)
      ANY     RESET G-DIRECT-COMMAND
      NONE    IGNORE
    END-DECIDE
    INCLUDE C-DIRECT
*
    IF (CV-MAP MODIFIED OR G-MAP-MODIFIED)
      PERFORM CHECK-ACTIVE-HELP
      PERFORM VALIDATE-INPUT
    END-IF
  END-REPEAT
END-REPEAT
IF #INVALID-AUTH-BU
  +G-RLISBU-SEL-AUTHORIZATION:= G-USERID
END-IF
IF #INVALID-AUTH-RP
  +G-RLISRP-SEL-AUTHORIZATION:= G-USERID
END-IF
IF #INVALID-AUTH-DL
  +G-RLISDL-SEL-AUTHORIZATION:= G-USERID
END-IF
IF #INVALID-AUTH-PR
  +G-RLISPR-SEL-AUTHORIZATION:= G-USERID
END-IF
IF G-PF-FUNC = 'MENU'
  FETCH #FATHER-PROG
END-IF
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE CHECK-ACTIVE-HELP
************************************************************************
ESCAPE ROUTINE
*
END-SUBROUTINE /* CHECK-ACTIVE-HELP
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-INPUT
************************************************************************
IF G-USER-TYPE = 'A' ESCAPE ROUTINE END-IF
IF NOT (+G-RLISBU-SEL-AUTHORIZATION =' ' OR=G-USERID OR='*' OR='PUBLIC')
  #INVALID-AUTH-BU:= TRUE
  REINPUT *0911 MARK *+G-RLISBU-SEL-AUTHORIZATION
END-IF
IF NOT (+G-RLISRP-SEL-AUTHORIZATION =' ' OR=G-USERID OR='*' OR='PUBLIC')
  #INVALID-AUTH-RP:= TRUE
  REINPUT *0911 MARK *+G-RLISRP-SEL-AUTHORIZATION
END-IF
IF NOT (+G-RLISDL-SEL-AUTHORIZATION =' ' OR=G-USERID OR='*' OR='PUBLIC')
  #INVALID-AUTH-DL:= TRUE
  REINPUT *0911 MARK *+G-RLISDL-SEL-AUTHORIZATION
END-IF
IF NOT (+G-RLISPR-SEL-AUTHORIZATION =' ' OR=G-USERID OR='*' OR='PUBLIC')
  #INVALID-AUTH-PR:= TRUE
  REINPUT *0911 MARK *+G-RLISPR-SEL-AUTHORIZATION
END-IF
*
END-SUBROUTINE /* VALIDATE-INPUT
*
************************************************************************
DEFINE SUBROUTINE INIT-PFKEYS
************************************************************************
INCLUDE RPFSTD-C
INCLUDE RPFBRW-C
INCLUDE RPFEXT-C
G-PF-IDENT(10):= ##PFN-RESET-ALL
G-PF-CODE(10) := ##PFK-RESET-ALL
G-PF-IDENT(22):= ##PFN-RESET-ALL
G-PF-CODE(22) := ##PFK-RESET-ALL
G-PF-IDENT(11):= ##PFN-RESET
G-PF-CODE(11) := ##PFK-RESET
G-PF-IDENT(23):= ##PFN-RESET
G-PF-CODE(23) := ##PFK-RESET
CALLNAT 'RPFINI-N' G-PF G-PFB
*
END-SUBROUTINE /* INIT-PFKEYS
* --------------------------------------- set pfkeys -------------------
INCLUDE RPFSET-C
*
END
