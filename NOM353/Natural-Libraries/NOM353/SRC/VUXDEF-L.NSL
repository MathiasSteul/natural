DEFINE DATA LOCAL
/* >Natural Source Header 000000
/* :Mode S
/* :CP
/* <Natural Source Header
*   VUXDEF-L                            DEFINITIONS FOR UNIX NODES
*   MAINTENANCE:
*   USER ID YYYY-MM-DD MARK             COMMENT
*   --------------------------------------------------------------------
*   FHI 2000-08-29 S(196560)            CREATED
*   SU1 2014-06-23 NOMALL-1281                 show last update user+date
*   SU2 2018-02-26 NOM 3.5                     CP
*   SU3 2020-12-01 NOMALL-2440 del.  field     UX-EMAIL-RECIPIENTS
*   BLI 2022-08-05 NOMALL-2505 SUSP. TIME
*   SU4 2022-12-21 NOMALL-2601 susp. msg       NOM2071 after x min.
* ***********************************************************************
1 UX-NODES VIEW OF NRM-UX-NODES
  2 UX-LAST-UPDATE (T) /*SU1
  2 UX-LAST-UPDATE-USER (A16) /*SU1
  2 UX-NODE-NAME (A16)
  2 UX-NODE-DESCRIPTION (A50)
  2 UX-NODE-USERID (A8)
  2 UX-NODE-PASSWORD (A32)
  2 UX-NODE-GROUP (A8)
  2 UX-NODE-SUSPEND (A1)
  2 UX-NODE-SUSPENDED (T) /*status upd. time BLI
  2 UX-NODE-SUSPENDED-SW (A50) /*BLI
  2 REDEFINE UX-NODE-SUSPENDED-SW
    3 UX-NODE-TIME-STORED (A1) /*status at upd. time
    3 UX-NODE-SUSP-MAX-MSG (A1) /*NOM2071 given
    3 UX-NODE-SUSP-TIME-INT_A4 (A4) /*SU4
    3 REDEFINE UX-NODE-SUSP-TIME-INT_A4
      4 UX-NODE-SUSP-TIME-INT (N4) /*min. until NOM2071
  2 UX-NODE-TIMEOUT (N2.0)
  2 UX-NODE-TEMPDIR (A70)
  2 C*UX-NODE-ACCESS
  2 UX-NODE-ACCESS
    3 UX-NODE-PATH (A70/1:10)
    3 UX-NODE-CONTAINER-DB (N5.0/1:10)
    3 UX-NODE-CONTAINER-FNR (N5.0/1:10)
* **End of LDA VUXDEF-L *************************************************
END-DEFINE
