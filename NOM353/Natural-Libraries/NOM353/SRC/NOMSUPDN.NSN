* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member       NOMSUPDN
* Version      1.3
* Function     Check for presence of superdescriptor
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* gw  98-03-24 s(279421) created
* gw  98-07-16 p(172297) recat for build list active bundle redesign
*                        to include prerequisites
* fhi     2008-07-24 P307319   restow due to changes in DDM NRM-BUNDLE-CONTENTS
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
*
01  P-FIELD-NAME                  (A2)
01  P-SUPDE-EXISTS                (L)
*
            LOCAL
01  BUNDLE-CONTENTS  VIEW OF NRM-BUNDLE-CONTENTS
    02  BC-BUNDLE-RNB-GROUP-SEQNO-REPRNB
*
END-DEFINE
* --------------------------------------- main -------------------------
*
P-SUPDE-EXISTS := TRUE
*
DECIDE ON FIRST VALUE P-FIELD-NAME
   VALUE 'L9'
         HISTOGRAM (1) BUNDLE-CONTENTS
                       FOR BC-BUNDLE-RNB-GROUP-SEQNO-REPRNB
         END-HISTOGRAM
   NONE
         P-SUPDE-EXISTS := FALSE
         WRITE 'Invalid field name' P-FIELD-NAME 'requested.'
END-DECIDE
* --------------------------------------- on error ---------------------
ON ERROR
   IF *ERROR-NR = 3061
      P-SUPDE-EXISTS := FALSE
      ESCAPE ROUTINE
   END-IF
END-ERROR
END
