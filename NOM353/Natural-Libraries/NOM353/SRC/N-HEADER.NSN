* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* N-HEADER - generate header line
*
* jwo 1997-10-07 p(163166) Change date to y2k format
* sju 2000-03-03 p(191368) Support new date formats: B,F,H,J
************************************************************************
*
DEFINE DATA PARAMETER
1 MAIN-LINE             (A78)
1 REDEFINE    MAIN-LINE
  2 #FIL3               (A1)
  2 #NOW                (A8)
  2 #FIL4               (A1)
  2 FILLER1             (A12)
  2 #HEADER             (A35)
  2 #FIL2               (A10)
  2 #FIL5               (A1)
  2 #TODAY              (A10)
1 DATE-FORMAT           (A1)
1 MAP-NAME              (A8)
************************************************************************
LOCAL
1 #LANGUAGE             (A1)
1 #DD                   (D)
1 #DATN                 (A8)
1 #NEW-FORMAT           (L) INIT <TRUE>
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#FIL3 := #FIL5 := '<'
#FIL4 := '>'
#LANGUAGE := *LANGUAGE
PERFORM C-TODAY
#NOW := *TIME
*
#HEADER := '**** ENTIRE OUTPUT MANAGEMENT ****'
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE C-TODAY
************************************************************************
#DATN := *DATN
MOVE EDITED #DATN  TO #DD(EM=YYYYMMDD)
IF #NEW-FORMAT EQ FALSE
  DECIDE ON EVERY VALUE OF DATE-FORMAT
    VALUE ' ','I' MOVE EDITED #DD (EM=YY'-'MM'-'DD) TO #TODAY
    VALUE 'A'     MOVE EDITED #DD (EM=MM'/'DD'/'YY) TO #TODAY
    VALUE 'E'     MOVE EDITED #DD (EM=DD'/'MM'/'YY) TO #TODAY
    VALUE 'G'     MOVE EDITED #DD (EM=DD'.'MM'.'YY) TO #TODAY
    NONE IGNORE
  END-DECIDE
  MOVE RIGHT #TODAY TO #TODAY
ELSE
  DECIDE ON EVERY VALUE OF DATE-FORMAT
    VALUE ' ','I','J' MOVE EDITED #DD (EM=YYYY'-'MM'-'DD) TO #TODAY
    VALUE 'A','B'     MOVE EDITED #DD (EM=MM'/'DD'/'YYYY) TO #TODAY
    VALUE 'E','F'     MOVE EDITED #DD (EM=DD'/'MM'/'YYYY) TO #TODAY
    VALUE 'G','H'     MOVE EDITED #DD (EM=DD'.'MM'.'YYYY) TO #TODAY
    NONE IGNORE
  END-DECIDE
END-IF
*
END-SUBROUTINE /* C-TODAY
*
END
