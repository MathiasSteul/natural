* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RSCHED-N
* Function:    Scheduling routine
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* mrs 93-09-14           doesn't work if language ne 1
* jvd 97-08-01 p(164220) NOM141ÖNAT23
* xsetggr 05-01-11 nom31 different sort order for NGC
* SU1     2015-02-27 NOMALL-1569 restructured
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 #P-ACT-TIME                 (T)     /*     (I)
1 #P-START                    (A4)    /*     (I)
1 #P-INTERVAL                 (A4)    /*     (I)
1 REDEFINE #P-INTERVAL
  2 #P-HOURS                  (N2)
  2 #P-MINUTES                (N2)
1 #P-END                      (A4)    /*     (I)
1 #P-WEEKDAYS                 (A2/1:7) /*    (I)
1 #P-INPUT-DAYS               (A3/1:30) /*   (I)
1 #P-CALENDAR                 (A8)    /*     (I)
1 #P-BEFORE-AFTER             (A1)    /*     (I)
1 #P-TIME                     (T)     /*     (O)
************************************************************************
LOCAL
1 #T-TIME                     (T)
1 #DATE                       (D)
1 #START-DATE                 (D)
1 #LIMIT-DATE                 (D)
1 #DDD                        (A3)
1 REDEFINE #DDD
  2 #DDD-FIL                  (A1)
  2 #DD                       (N2)
1 #N-DATE                     (A8)
1 REDEFINE #N-DATE
  2 #N-YEAR                   (N4)
  2 #N-MM                     (N2)
  2 #N-DD                     (N2)
1 #OLD-YEAR                   (N4)
1 #CURRENT-DATE               (D)
1 #WD                         (A2)
1 #I                          (P2)
1 #BEFORE-AFTER               (A1)
1 END-OF-PROCESSING           (L)
1 #TIME-A                     (A14)
1 REDEFINE #TIME-A
  2 #DATE-A                   (A8)
  2 #HHII-A                   (A4)
  2 #SECONDS-A                (A2)
1 CALENDAR VIEW OF NRM-CALENDARS
  2 CA-WORKING-DAYS           (A31/1:12)
  2 REDEFINE CA-WORKING-DAYS
    3 CA-WTAB                 (1:12)
      4 DAY                   (A1/1:31)
1 #CA-CALENDAR-ID             (A12)
1 REDEFINE #CA-CALENDAR-ID
  2 #CA-CALENDAR              (A8)
  2 #CA-YEAR                  (N4)
1 #P-MONTHLY-DAYS             (A3/1:30)
1 #LANGUAGE                   (I1)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#P-MONTHLY-DAYS (*) := #P-INPUT-DAYS (*)
DECIDE FOR EVERY CONDITION
  WHEN #P-INTERVAL = '0000' OR #P-INTERVAL NE MASK (NNNN)
    #P-INTERVAL := '0001'
  WHEN #P-START NE MASK (NNNN)
    #P-START := '0000'
  WHEN #P-END = '0000' OR #P-END NE MASK (NNNN)
    #P-END := '2359'
  WHEN NONE IGNORE
END-DECIDE
*
DECIDE FOR FIRST CONDITION
  WHEN #P-WEEKDAYS (*)     NE ' '
    #LANGUAGE := *LANGUAGE
    *LANGUAGE := 1
    PERFORM WEEKDAYS
    *LANGUAGE := #LANGUAGE
  WHEN #P-MONTHLY-DAYS (*) NE ' '
    PERFORM SORT-DAYS
    IF #P-MONTHLY-DAYS(*) = 'ALL'
      PERFORM ABSOLUTE-DAYS
    ELSE
      PERFORM MONTHLY-DAYS
    END-IF
  WHEN NONE
    PERFORM ABSOLUTE-DAYS
END-DECIDE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE ABSOLUTE-DAYS
************************************************************************
#DATE                := #P-ACT-TIME
#CURRENT-DATE := #P-ACT-TIME
PERFORM HOLIDAY
IF #DATE = #CURRENT-DATE
  PERFORM TEST-TIME
  IF NOT END-OF-PROCESSING
    #DATE := #DATE + 1
    PERFORM HOLIDAY
  END-IF
END-IF
IF NOT END-OF-PROCESSING
  MOVE EDITED #DATE       (EM=YYYYMMDD) TO #DATE-A
  #HHII-A :=        #P-START
  #SECONDS-A :=        '00'
  MOVE EDITED #TIME-A TO #P-TIME (EM=YYYYMMDDHHIISS)
END-IF
*
END-SUBROUTINE /* ABSOLUTE-DAYS
*
************************************************************************
DEFINE SUBROUTINE WEEKDAYS
************************************************************************
#DATE                := #P-ACT-TIME
#CURRENT-DATE := #P-ACT-TIME
REPEAT
  UNTIL END-OF-PROCESSING
  MOVE EDITED #DATE (EM=N(2)) TO #WD
  EXAMINE #WD TRANSLATE INTO UPPER CASE
  EXAMINE FULL VALUE OF #P-WEEKDAYS (*) FOR #WD GIVING NUMBER #I
  IF #I > 0
    PERFORM HOLIDAY
    IF #DATE = #CURRENT-DATE
      PERFORM TEST-TIME
    ELSE
      #P-TIME := #DATE
      MOVE EDITED #DATE       (EM=YYYYMMDD) TO #DATE-A
      #HHII-A    := #P-START
      #SECONDS-A := '00'
      MOVE EDITED #TIME-A TO #P-TIME (EM=YYYYMMDDHHIISS)
      END-OF-PROCESSING := TRUE
    END-IF
  END-IF
  #DATE := #DATE + 1
END-REPEAT
*
END-SUBROUTINE /* WEEKDAYS
*
************************************************************************
DEFINE SUBROUTINE MONTHLY-DAYS
************************************************************************
#CURRENT-DATE := #P-ACT-TIME
MOVE EDITED #P-ACT-TIME (EM='0'DD) TO #DDD
#I := 1
REPEAT
  UNTIL #I > 30 OR #P-MONTHLY-DAYS (#I)  = '999'
    OR #P-MONTHLY-DAYS (#I) >= #DDD
  ADD 1 TO #I
END-REPEAT
IF #I = 1 AND #P-MONTHLY-DAYS (#I) = '999'
  ESCAPE ROUTINE
END-IF
REPEAT
  UNTIL END-OF-PROCESSING
  IF #P-MONTHLY-DAYS (#I) = '999' OR #I > 30
    #I := 1
    MOVE EDITED #P-ACT-TIME (EM=YYYYMMDD) TO #N-DATE
    ADD 1 TO #N-MM
    IF #N-MM > 12
      ADD 1 TO #N-YEAR
      #N-MM := 1
    END-IF
    #DDD  := #P-MONTHLY-DAYS (#I)
    #N-DD := #DD
    PERFORM VALID-DAY
    MOVE EDITED #N-DATE TO #DATE (EM=YYYYMMDD)
  ELSE
    MOVE EDITED #P-ACT-TIME (EM=YYYYMMDD) TO #N-DATE
    #DDD  := #P-MONTHLY-DAYS (#I)
    #N-DD := #DD
    PERFORM VALID-DAY
    MOVE EDITED #N-DATE TO #DATE (EM=YYYYMMDD)
  END-IF
  PERFORM HOLIDAY
  IF #DATE = #CURRENT-DATE
    PERFORM TEST-TIME
  ELSE
    #P-TIME := #DATE
    MOVE EDITED #DATE       (EM=YYYYMMDD) TO #DATE-A
    #HHII-A    := #P-START
    #SECONDS-A :=       '00'
    MOVE EDITED #TIME-A TO #P-TIME (EM=YYYYMMDDHHIISS)
    END-OF-PROCESSING := TRUE
  END-IF
  ADD 1 TO #I
END-REPEAT
*
END-SUBROUTINE /* MONTHLY-DAYS
*
************************************************************************
DEFINE SUBROUTINE TEST-TIME
************************************************************************
MOVE EDITED #P-ACT-TIME (EM=YYYYMMDD) TO #DATE-A
#HHII-A    := #P-END
#SECONDS-A := '00'
MOVE EDITED #TIME-A TO #P-TIME (EM=YYYYMMDDHHIISS)
#T-TIME := #P-TIME
IF #P-ACT-TIME LE #P-TIME
  MOVE EDITED #P-ACT-TIME (EM=YYYYMMDD) TO #DATE-A
  #HHII-A    := #P-START
  #SECONDS-A := '00'
  MOVE EDITED #TIME-A TO #P-TIME (EM=YYYYMMDDHHIISS)
  REPEAT
    WHILE #P-ACT-TIME > #P-TIME
    #P-TIME := #P-TIME + (#P-HOURS * 36000) + (#P-MINUTES * 600)
  END-REPEAT
  IF #P-TIME > #T-TIME
    #P-TIME := #T-TIME
  END-IF
  END-OF-PROCESSING := TRUE
END-IF
*
END-SUBROUTINE /* TEST-TIME
*
************************************************************************
DEFINE SUBROUTINE HOLIDAY
************************************************************************
IF #P-CALENDAR = ' '
  ESCAPE ROUTINE
END-IF
MOVE EDITED #P-ACT-TIME (EM=HHII) TO #HHII-A
IF #HHII-A >= #P-END                               /* if current-time
  #LIMIT-DATE := #CURRENT-DATE + 1                /* ge end-time
ELSE                                             /* limit for before
  #LIMIT-DATE := #CURRENT-DATE                    /* Holiday = current
END-IF                                             /* day plus 1
#START-DATE := #DATE
#BEFORE-AFTER := #P-BEFORE-AFTER
REPEAT
  MOVE EDITED #DATE (EM=YYYYMMDD) TO #N-DATE
  IF #OLD-YEAR NE #N-YEAR
    #OLD-YEAR := #N-YEAR
    PERFORM READ-CALENDAR
  END-IF
  IF CALENDAR.DAY (#N-MM, #N-DD) = 'W'
    ESCAPE BOTTOM
  END-IF
  IF #BEFORE-AFTER = 'B' AND #DATE <= #LIMIT-DATE
    #BEFORE-AFTER := 'A'
    #DATE := #START-DATE
  END-IF
  IF #BEFORE-AFTER = 'B'
    #DATE := #DATE - 1
  ELSE
    #DATE := #DATE + 1
  END-IF
END-REPEAT
*
END-SUBROUTINE /* HOLIDAY
*
************************************************************************
DEFINE SUBROUTINE READ-CALENDAR
************************************************************************
#CA-CALENDAR := #P-CALENDAR
#CA-YEAR := #OLD-YEAR
FNDC. FIND CALENDAR WITH CA-CALENDAR-ID = #CA-CALENDAR-ID
  IF NO RECORDS FOUND
    MOVE ALL 'W' TO CA-WORKING-DAYS (*)
    ESCAPE BOTTOM
  END-NOREC
END-FIND
*
END-SUBROUTINE /* READ-CALENDAR
*
************************************************************************
DEFINE SUBROUTINE SORT-DAYS
************************************************************************
CALLNAT 'RSCHSR-N' #P-MONTHLY-DAYS (*)
*
END-SUBROUTINE /* SORT-DAYS
*
************************************************************************
DEFINE SUBROUTINE VALID-DAY
************************************************************************
REPEAT
  UNTIL #N-DATE = MASK (YYYYMMDD)
  #N-DD := #N-DD - 1
  IF #N-DD < 1
    #N-DD := 31
    #N-MM := #N-MM - 1
    IF #N-MM < 1
      #N-MM := 12
      #N-YEAR := #N-YEAR - 1
    END-IF
  END-IF
END-REPEAT
*
END-SUBROUTINE /* VALID-DAY
*
END
