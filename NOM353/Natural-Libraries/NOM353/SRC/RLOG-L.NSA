DEFINE DATA PARAMETER
/* >Natural Source Header 000000
/* :Mode S
/* :CP
/* <Natural Source Header
*   xsiszha 2000-07-27 (CE7461)                Extend Report and Bundle Names
*   NOM3107 SUPPORT 7 BYTE JOBNUMBRS                                     ames
*   xsetggr 2007-05-02 NOM3201                 Support 5 byte node number
*   2018-10-30 copied from RLOG-P
* ***********************************************************************
1 PL-PARMS
  2 LG-USERID (A8)
  2 LG-CODE (A2)
  2 LG-MSG (A250) BY VALUE RESULT
  2 LG-OBJECT-NAME (A60)
  2 LG-TIME (T)
  2 LG-REPNAME (A25)
  2 LG-REPRNB (P11)
  2 LG-BUNDLE (A25)
  2 LG-BUNDRNB (P11)
  2 LG-PRINTER (A8)
  2 LG-JOBNAME (A8)
  2 LG-JOBNO (N7)
  2 LG-NODE (N5)
  2 LG-FUNCTION (A10) BY VALUE OPTIONAL
* **End of PDA RLOG-P ***************************************************
END-DEFINE
