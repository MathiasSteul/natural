* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RMIGCHKU - checks whether user is defined as administator of the
*            target environment
*
* Maintenance:
* uuu     yyyy-mm-dd s(999999)
* xsetggr 2005-01-31           due changes in VUSERS-L and VTUSER-L
* xsetggr 2008-10-30 p(309496) return apppropeiate error-code
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 #P-USERID  (A8)
1 #P-ERC      (N4)
************************************************************************
LOCAL USING VTUSER-L
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
FNDU. FIND MIGRATE-USERS WITH USER-ID = #P-USERID
  IF NO RECORDS FOUND
    #P-ERC:= 4032
    ESCAPE BOTTOM (FNDU.)
  END-NOREC
  IF PROF-TYPE = 'A'
    RESET #P-ERC
  ELSE
    #P-ERC := 4033
  END-IF
END-FIND
*
END
