* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RMINIT - Initialize NOM Monitor for Online testing
*
* Maintenance:
* uuu yy-mm-dd s(999999) ....
* gw  98-11-02  s(999999) 5 byte dbid /fnr
* fhi 02-04-05  fhi01     adapt to NOM221 needs
* fhi 05-09-01 P(266530)  Adapt to start monitor online on Unix
* fhi 17-03-15 NOMALL-1961 Do not use 'MAIN' as monitor id
* ----------------------------------------------------------------------
DEFINE DATA GLOBAL USING MONIT-GL
LOCAL
1 #EOM-SYSF           (A10)
1 REDEFINE #EOM-SYSF
  2 #EOM-DBID         (N5)
  2 #EOM-FNR          (N5)
1 #SAT-SYSF           (A10)
1 REDEFINE #SAT-SYSF
  2 #SAT-DBID         (N5)
  2 #SAT-FNR          (N5)
1 #SAT-LIBRARY        (A8)
1 #SAT-MEMBER         (A8)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
G-TRACE          := 100
G-MONITOR-ID     := 'MAINTASK'
G-WAIT-MINIMUM   := 5
G-WAIT-MAXIMUM   := 30
G-WAIT-INCREMENT := 5
G-MONITOR-NODE   := 40
#EOM-DBID        := 9
#EOM-FNR         := 247
#SAT-DBID        := 9
#SAT-FNR         := 150
#SAT-LIBRARY     := 'SYSSATU'
#SAT-MEMBER      := 'SP00040'
*
INPUT (AD=MI)
  'MONITOR ID .............' G-MONITOR-ID
  / 'MONITOR Minimum-Wait ...' G-WAIT-MINIMUM
  / 'MONITOR Maximum-Wait ...' G-WAIT-MAXIMUM
  / 'MONITOR Increment ......' G-WAIT-INCREMENT
  / 'MONITOR Node ...........' G-MONITOR-NODE
  / 'NOM     SYSF ...........' #EOM-SYSF
  / 'SAT     SYSF ...........' #SAT-SYSF
  / 'SAT     Library ........' #SAT-LIBRARY
  / 'SAT     Member .........' #SAT-MEMBER
*
IF *MACHINE-CLASS = 'MAINFRAME'
  FETCH 'RMINIT' G-MONITOR-ID G-WAIT-MINIMUM G-WAIT-MAXIMUM
    G-WAIT-INCREMENT G-MONITOR-NODE #EOM-SYSF #SAT-SYSF
    #SAT-LIBRARY #SAT-MEMBER
ELSE
  FETCH 'RMINIT' 1 #EOM-SYSF
END-IF
*
END
