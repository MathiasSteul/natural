* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RDEFPO - Define a Printout
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* gw  93-07-01 s(999999) created
* mrs 93-11-15 s(999999) printer-type commented out (rdefpr-n)
* mrs 93-12-14 s(999999) not needed add pf-key
* gw  95-12-11 s(222350) user exit to allow/disallow access to NSPF
* gw  96-09-09 s(250901) avoid NAT1106 when invoking NSPF
* gw  98-03-13 s(278970) save search values in independent variables
* wcd 00-04-01 CE 7267   New PFkey for additional printers in RPFK---L
* xsiszha 2000-08-15 (CE7461)  Extend Report and Bundle Names
* fhi     2002-10-30 fhi101    switch on optimizer compiler
* sju     2004-04-22 p(250355) check EOMMSG-NR
* xsetggr 2007-05-30 p(294790) changes in eompom-p
* xsetggr 2007-06-27 NOM3201   support 5 byte node and 11 byte run numbe
*                              numbers, restow - changes in eompom-parms
* xsetggr 2007-11-05 NRT2768   show size of binary documents in bytes
* xsetggr 2008-02-24 add parm to RBINSZ-N
* xsetggr 2008-03-11 p(302778) change format of RBINSZ-N parms
* xsetggr 2008-05-05 p(304350) get size of binary docs from spool attr.
* xsetggr 2008-06-10 p(292935) display error text in status field
* fhi     2008-07-24 P307319   restow due to changes in DDM NRM-BUNDLE-CONTENTS
* fhi     2010-02-19 P321483   Show standard message for 'X' status     ONTENTS
* fhi     2010-09-03 NOMALL-97 Extend message line
* xsetggr 2011-02-24 NOMALL-865 display location of spool file for po of
*                               WRTSPOOL printers
* xsetggr 2011-05-11 NOMALL-986 fill EOM-LIBRARY, EOM-USER-LIBRARY
* raya    2012-02-01 NOMALL-1096 error-text a250 in EOMPOL-P stow only
* raya    2012-12-05 NOMALL-1220 when wrtspool with jobname
* SU1     2013-01-31 unused      Deactivate unused data areas
* raya    2013-03-03 NOMALL-1233 change check-binary-files
* fhi     2015-05-18 NOMALL-1552 Show real size, not base64 size
* SU2     2016-08-01 NOMALL-1518 NOM3.5 deactivate opt.Compiler+S-SEPEDT
* fhi     2016-11-15 NOMALL-1961 Use new task IDs
* NKEW1   2024-07-24 EF-4541     Decide what to show on map with func
* ----------------------------------------------------------------------
DEFINE DATA GLOBAL USING  NRM-GL
* -----------------------------LDA's------------------------------------
LOCAL USING RPFK---L
LOCAL USING EOM----E
LOCAL USING EOM----P
LOCAL USING EOMPOM-E
LOCAL USING EOMPOM-P
LOCAL USING EOMPHTYE
LOCAL USING EOMMSG-P
LOCAL USING XXGMSG-A
LOCAL USING RTXT---L
LOCAL USING RCCTYP-E
LOCAL USING RMSPL--L
LOCAL USING EOMPOL-P
LOCAL USING N-SPOOLA
LOCAL USING CONST-L /* NKEW1 changed
*
LOCAL
1 ACTIVE-REPORTS VIEW OF NRM-ACTIVE-REPORTS
  2 AR-CC-TYPE
  2 AR-SPOOL-ATTRIBUTES
1 BUNDLE-CONTENTS VIEW OF NRM-BUNDLE-CONTENTS
  2 BC-REPNAME
  2 BC-REPRNB
1 PO VIEW OF NRM-PRINTOUTS
  2 PO-DDNAME
*
1 #FUNC                      (A1)
1 #PRINTER                   (A8)
1 CV-KEY                     (C)
1 CV-MAP                     (C) INIT <(AD=I CD=NE)>
1 CV-JOBPARMS                (C) INIT <(AD=I CD=NE)>
1 L-HEADER                   (A78)
1 READ-RECORD                (L)
1 #FATHER-PROG               (A8) INIT <'RLISPO'>
1 #LANGUAGE                  (I1)
1 #PANEL                     (I2)
1 #MAP-IND                   (I1) INIT <1>
1 #MAP-DYNAMIC               (11)
  2 #MAP-VALUE-FROM-COL      (I2)
  2 #MAP-VALUE-TO-COL        (I2)
  2 #MAP-LINE                (A77)
  2 REDEFINE #MAP-LINE
    3 #MAP-LINE-A1           (A1/1:77)
1 #I                         (I2)
1 #J                         (I2)
1 #K                         (I2)
1 #L                         (I2)
1 #IX                        (I2)
1 #MAP-OCC                   (I1) CONST <11>
1 #CP                        (I2) INIT <1>
1 #END-OF-DATA               (L)
1 #M-NAME                    (A25)
1 REDEFINE #M-NAME
  2 #M-NAME-17               (A17)
  2 #M-NAME-R                (A8)
1 REDEFINE #M-NAME
  2 #M-NAME-8                (A8)
  2 #M-NAME-B                (A17)
1 #TOTAL-LINES               (A9)
1 #PRINTED-LINES             (A9)
1 #BIN                       (L)
1 #ERC                       (N4)
1 #ERT                       (A250)
1 #RUN-NUMBER                (P11)
1 #BC-BUNDLE-RNB-SEQNO-E     (A33)
1 #BC-BUNDLE-RNB-SEQNO       (A33)
1 REDEFINE #BC-BUNDLE-RNB-SEQNO
  2 #BUNDLE                  (A25)
  2 #BUNDRNB                 (P11)
  2 #SEQNO                   (P3)
1 #AR-REPORT-RNB             (A31)
1 REDEFINE #AR-REPORT-RNB
  2 #AR-REPNAME              (A25)
  2 #AR-RNB                  (P11)
1 #TOTAL-SIZE                (I4)
1 #RECNUM                    (I4)
1 #A4                        (A4)
1 REDEFINE #A4
  2 #I4                      (I4)
1 #ALL-BIN                   (L)
1 #PO-MSG                    (A250)
1 #PRINTED-ALPHA             (A10)
1 #PRINTED                   (T)
1 #WRITESPOOL-TEXT           (A25)
1 #JOBNAME-TEXT              (A20)
1 #JOBNO-TEXT                (A20)
1 #DDNAME-TEXT               (A20)
1 #DDNAME                    (A8)
1 #WRITESPOOL-MSG-NR         (N4) INIT <0145>
1 #JOBNAME-MSG-NR            (N4) INIT <0146>
1 #JOBID-MSG-NR              (N4) INIT <0147>
1 #DDNAME-MSG-NR             (N4) INIT <0148>
1 #WRITESPOOL-TEXT-CV        (C)  INIT <(AD=NP CD=TU)>
1 #WRITESPOOL-VALUE-CV       (C)  INIT <(AD=NP CD=NE)>
1 #CALLING-PGM               (A8) INIT <*PROGRAM>
1 #POS                       (I4)
1 #A8                        (A8)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
* NKEW1 <
#JOB_ADD_FIELD := F#SETVAR(<#_JOBCARDS(1:2),#_ADDITIONALPARA(1:2)>)
* NKEW1 >
IF *DATA = 3
  INPUT (AD=MIT) G-C-FUNC G-C-PRINTER #PANEL
END-IF
*
CV-KEY := (AD=I)
RESET G-COMMIT G-LINECOM(*)
*
#FUNC := G-C-FUNC
EOMPOM-I-ID := G-C-PO-ID
FIND PO WITH PO-ID = G-C-PO-ID
END-FIND
CALLNAT 'N-SPOOL' #N-SPOOLA
EOM-USER-PROFILE := G-USER-PROFILE
EOM-USER         := G-USERID
EOM-USER-TYPE    := G-USER-TYPE
EOM-LANGUAGE     := *LANGUAGE
CALLNAT 'RGETLIB' EOM-LIBRARY
COMPRESS EOM-LIBRARY 'U' TO EOM-USER-LIBRARY LEAVING NO
IF #PANEL = 0
  #PANEL := PRINTOUT-GENERAL-ATTRIBUTES
END-IF
*
MAIN-LOOP. REPEAT
  EOMPOM-I-ATTRIBUTE-TYPE := #PANEL
  DECIDE ON FIRST #FUNC
    VALUE 'M'
      CV-KEY       := (AD=IP)
      EOM-FUNCTION := EOM-READHOLD
    VALUE 'D'
      CV-KEY := CV-MAP := CV-JOBPARMS := (AD=IP)
      EOM-FUNCTION    := EOM-READ
    NONE  G-NATRP-ERC := 9999
      INCLUDE C-ESCAPE
  END-DECIDE
  FIND-LOOP. REPEAT
    RESET EOMMSG-PARMS #DDNAME
    EOMPOM-I-DATE-FORMAT := G-DATE-FORMAT
    CALLNAT 'EOMPOM-N' EOM-PARMS EOMPOM-PARMS EOMMSG-PARMS
    IF EOMMSG-NR NE 0
      G-NATRP-ERC := EOMMSG-NR
      G-NATRP-ERT := EOMMSG-TOKEN (1)
      INCLUDE C-ESCAPE
    END-IF
    IF EOMPOM-PRINTER-TYPE = ##PHYS-VTAM
      CV-JOBPARMS :=(AD=IP)
    END-IF
    IF #PANEL = PRINTOUT-GENERAL-ATTRIBUTES
      IF EOMPOM-STATUS = 'X' AND EOMPOM-MSG = ' '
        EOMPOM-MSG := ##TXT-EXTERNAL-OK
      END-IF
      IF EOMPOM-MSG = MASK(NNNN) AND EOMPOM-MSG IS (N4)
        #PO-MSG := EOMPOM-MSG
        CALLNAT 'RSUBMSGN' #PO-MSG
        EOMPOM-MSG := #PO-MSG
      ELSE
        RESET #PO-MSG
      END-IF
      PERFORM CHECK-BINARY-FILES
      IF #BIN
        IF EOMPOM-TYPE = 'B'
          PERFORM GET-BINARY-SIZE
          COMPRESS #TOTAL-SIZE 'K' TO #TOTAL-LINES LEAVING NO
          IF #ALL-BIN AND EOMPOM-LAST-PRINTED-RECNO > 0
            COMPRESS EOMPOM-LAST-PRINTED-RECNO 'K' TO #PRINTED-LINES
              LEAVING NO
          END-IF
        ELSE                  /* binary reports
          IF #SPOOL-DI-SIZE NE #I4 AND #SPOOL-DI-SIZE NE 0
            #TOTAL-SIZE := #SPOOL-DI-SIZE / 1024 +1
            #TOTAL-SIZE := (#SPOOL-DI-SIZE / 1024 + 1) * 3 / 4
          ELSE
            PERFORM GET-BINARY-SIZE
          END-IF
          IF #TOTAL-SIZE > 0
            COMPRESS #TOTAL-SIZE 'K' TO #TOTAL-LINES LEAVING NO
          ELSE
            RESET #TOTAL-SIZE
          END-IF
          IF EOMPOM-LAST-PRINTED-RECNO > 0
            COMPRESS EOMPOM-LAST-PRINTED-RECNO 'K' TO #PRINTED-LINES
              LEAVING NO
          ELSE
            RESET #PRINTED-LINES
          END-IF
        END-IF
/* total and printed lines for not binary reports and bundles
      ELSE
        IF EOMPOM-TYPE = 'B'
          EOMPOL-BUNDLE := EOMPOM-NAME
        ELSE
          EOMPOL-REPORT := EOMPOM-NAME
        END-IF
        EOMPOL-RNB := EOMPOM-RUN-NUMBER
        EOMPOL-FROM-LINE := EOMPOM-FROM-LINE
        EOMPOL-TO-LINE   := EOMPOM-TO-LINE
        CALLNAT 'EOMPOL-N' EOMPOL-PARMS
        #TOTAL-LINES := EOMPOL-TOTAL-LINES
        IF EOMPOM-LAST-PRINTED-RECNO > 0
          #PRINTED-LINES := EOMPOM-LAST-PRINTED-RECNO
        ELSE
          RESET #PRINTED-LINES
        END-IF
      END-IF
    END-IF
    G-HOLD-TIME := *TIMX
*
    SCREEN-LOOP. REPEAT
      IF #LANGUAGE NE *LANGUAGE
        #LANGUAGE := *LANGUAGE
        PERFORM INIT-PFKEYS
        PERFORM SET-PFKEYS
      END-IF
      IF #FUNC NE 'D'
        INCLUDE C-HOLD
      END-IF
      PERFORM FLIP-DISPLAY
      SET CONTROL 'L'
      SET CONTROL 'WB'
      CALLNAT 'N-HEADER' L-HEADER G-DATE-FORMAT 'RDEFPOG&'
      RESET G-MAP-MODIFIED
      RESET INITIAL #WRITESPOOL-TEXT-CV #WRITESPOOL-VALUE-CV
      DECIDE ON FIRST #PANEL
        VALUE PRINTOUT-GENERAL-ATTRIBUTES
          #M-NAME := EOMPOM-NAME
          IF G-DISPLAY-LONG-NAMES
            IF EOMPOM-TYPE = 'B'
              #M-NAME-B := H'FA'
            ELSE
              #M-NAME-R := H'FA'
            END-IF
          END-IF
          IF EOMPOM-STATUS = 'E'
            RESET #PRINTED-ALPHA #PRINTED
          ELSE
            #PRINTED-ALPHA := EOMPOM-PRINTED-ALPHA
            #PRINTED       := EOMPOM-PRINTED
          END-IF
          INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
            MARK *G-DIRECT-COMMAND USING MAP 'RDEFPOG&'
        VALUE PRINTOUT-PRINTER-ATTRIBUTES
* get attributes to display for WRTSPOOL printouts
          IF EOMPOM-PRINTER-TYPE = 'WRTSPOOL'
            #DDNAME  := PO.PO-DDNAME
* get text for header
            #XX-ERROR-CODE      := #WRITESPOOL-MSG-NR
            CALLNAT 'XXGMSG-N' #XX-GMSG-PARMS
            #WRITESPOOL-TEXT    := #XX-SHORT-TEXT
* get text for job-name
            IF #POWR
              #XX-ERROR-CODE      := #JOBNAME-MSG-NR
              CALLNAT 'XXGMSG-N' #XX-GMSG-PARMS
              #JOBNAME-TEXT       := #XX-SHORT-TEXT
            ELSE
              RESET #JOBNAME-TEXT EOMPOM-JOBNAME
            END-IF
            IF #JES2 OR #JES3 /*get text for job-number
              #XX-ERROR-CODE      := #JOBID-MSG-NR
              CALLNAT 'XXGMSG-N' #XX-GMSG-PARMS
              #JOBNO-TEXT         := #XX-SHORT-TEXT
            END-IF
* get text for ddname
            #XX-ERROR-CODE      := #DDNAME-MSG-NR
            CALLNAT 'XXGMSG-N' #XX-GMSG-PARMS
            #DDNAME-TEXT        := #XX-SHORT-TEXT
            #WRITESPOOL-TEXT-CV := (AD=D CD=TU)
            #WRITESPOOL-VALUE-CV:= (AD=IP CD=NE)
          END-IF
          INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
            MARK *G-DIRECT-COMMAND USING MAP 'RDEFPOP&'
        VALUE PRINTOUT-SPECIAL-ATTRIBUTES
          PERFORM CHECK-TOP-BOTTOM-MORE-ALL
          PERFORM BUILD-SCREEN
          INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
            MARK *G-DIRECT-COMMAND USING MAP 'RDEFPOS&'
        NONE VALUE
          IGNORE
      END-DECIDE
      PERFORM CHECK-MODIFIED
      RESET G-NATRP-ERC G-NATRP-ERT
      INCLUDE RPFKVA-C
      INCLUDE C-DIRECT
      INCLUDE RPFKED-C
      RESET READ-RECORD
      IF G-MAP-MODIFIED AND #FUNC NE 'D'
        IF #PANEL = PRINTOUT-SPECIAL-ATTRIBUTES
          PERFORM GET-VALUES
        END-IF
        PERFORM CHECK-ACTIVE-HELP
        EOMPOM-I-ATTRIBUTE-TYPE := #PANEL
        EOM-FUNCTION := EOM-MODIFY
        RESET EOMMSG-PARMS
        CALLNAT 'EOMPOM-N' EOM-PARMS EOMPOM-PARMS EOMMSG-PARMS
        IF EOMMSG-NR = 0
          G-NATRP-ERC := 32
        ELSE
          PERFORM CHECK-ERROR-CODE
        END-IF
        INCLUDE C-COMMIT
      END-IF
      INCLUDE REXDO--C
      DECIDE ON FIRST VALUE OF G-PF-FUNC
        VALUE ##PFK-EXIT-SUBFUNC
          IF #PANEL NE PRINTOUT-GENERAL-ATTRIBUTES
            #PANEL := PRINTOUT-GENERAL-ATTRIBUTES
            RESET #LANGUAGE
            READ-RECORD := TRUE
          END-IF
        VALUE ##PFK-UP
          SUBTRACT #MAP-OCC FROM #MAP-IND
          IF #MAP-IND < 1
            #MAP-IND := 1
          END-IF
        VALUE ##PFK-DOWN
          #J := #MAP-IND + #MAP-OCC - 1
          #K := EOMPOM-ATTRIBUTES-OCC - #J
          IF #K < #MAP-OCC
            #MAP-IND := EOMPOM-ATTRIBUTES-OCC - #MAP-OCC + 1
          ELSE
            ADD #MAP-OCC TO #MAP-IND
          END-IF
          IF #MAP-IND > 18
            #MAP-IND := 18
          END-IF
        VALUE ##PFK-PRINTER-ATTRIBUTES
          #PANEL := PRINTOUT-PRINTER-ATTRIBUTES
          RESET #LANGUAGE         /* to re-init pf-keys
          READ-RECORD := TRUE
        VALUE ##PFK-SPECIAL-ATTRIBUTES
          #PANEL := PRINTOUT-SPECIAL-ATTRIBUTES
          RESET #LANGUAGE         /* to re-init pf-keys
          READ-RECORD := TRUE
        VALUE ##PFK-EDIT
          PERFORM EDIT-EXIT
        VALUE ##PFK-DISPLAY-LONG-NAMES
          IF G-DISPLAY-LONG-NAMES
            G-DISPLAY-LONG-NAMES := FALSE
          ELSE
            G-DISPLAY-LONG-NAMES := TRUE
          END-IF
          RESET #LANGUAGE
        NONE  IGNORE
      END-DECIDE
*
      IF READ-RECORD = TRUE
        ESCAPE BOTTOM (FIND-LOOP.)
      END-IF
*
    END-REPEAT
  END-REPEAT
END-REPEAT
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE GET-VALUES
************************************************************************
FOR #I 1 #MAP-OCC
  #IX := #MAP-IND + #I - 1
  IF #MAP-VALUE-FROM-COL (#I) NE 0
    #J := #MAP-VALUE-FROM-COL (#I)
    #K := #MAP-VALUE-TO-COL         (#I)
    #L := #K - #J + 1
    RESET  EOMPOM-ATTR-VALUE    (#IX)
    EOMPOM-ATTR-VALUE-A1 (#IX,1:#L) := #MAP-LINE-A1 (#I,#J:#K)
  END-IF
END-FOR
*
END-SUBROUTINE /* GET-VALUES
*
************************************************************************
DEFINE SUBROUTINE BUILD-SCREEN
************************************************************************
CALLNAT 'RDEFPR-N' #MAP-IND EOMPOM-ATTRIBUTES (*) #MAP-DYNAMIC (*)
*
END-SUBROUTINE
*
************************************************************************
DEFINE SUBROUTINE GET-BINARY-SIZE
************************************************************************
RESET #ERC #ERT #RECNUM #TOTAL-SIZE
#RUN-NUMBER := EOMPOM-RUN-NUMBER
CALLNAT 'RBINSZ-N' EOMPOM-NAME #RUN-NUMBER EOMPOM-TYPE #RECNUM
  #TOTAL-SIZE #ERC #ERT
IF #TOTAL-SIZE > 0 AND #ERC = 0
  #TOTAL-SIZE := #TOTAL-SIZE / 1024 + 1
END-IF
*
END-SUBROUTINE /* GET-BINARY-SIZE
*
************************************************************************
DEFINE SUBROUTINE CHECK-MODIFIED
************************************************************************
IF CV-MAP MODIFIED
  G-MAP-MODIFIED := TRUE
END-IF
*
END-SUBROUTINE /* CHECK-MODIFIED
*
************************************************************************
DEFINE SUBROUTINE CHECK-BINARY-FILES
************************************************************************
RESET #BIN #SPOOL-ATTRIBUTES  #ALL-BIN
IF EOMPOM-TYPE = 'R'
  #AR-REPNAME := EOMPOM-NAME
  #AR-RNB     := EOMPOM-RUN-NUMBER
  FIND ACTIVE-REPORTS WITH AR-REPORT-RNB = #AR-REPORT-RNB
    IF AR-CC-TYPE = BINARY
      #BIN := TRUE
      #SPOOL-ATTRIBUTES := AR-SPOOL-ATTRIBUTES
    END-IF
  END-FIND
ELSE
  #BUNDLE  := EOMPOM-NAME
  #BUNDRNB := EOMPOM-RUN-NUMBER
  #SEQNO   := 999
  #BC-BUNDLE-RNB-SEQNO-E := #BC-BUNDLE-RNB-SEQNO
  RESET #SEQNO
  #ALL-BIN := TRUE
  FNDBC. FIND BUNDLE-CONTENTS WITH BC-BUNDLE-RNB = #BC-BUNDLE-RNB-SEQNO
      THRU #BC-BUNDLE-RNB-SEQNO-E
    #AR-REPNAME := BC-REPNAME
    #AR-RNB     := BC-REPRNB
    FIND ACTIVE-REPORTS WITH AR-REPORT-RNB = #AR-REPORT-RNB
      IF AR-CC-TYPE NE BINARY     /* not binary report
        RESET #ALL-BIN
      ELSE
        #BIN := TRUE
      END-IF
    END-FIND
  END-FIND
END-IF
*
END-SUBROUTINE /* CHECK-BINARY-FILES
*
************************************************************************
DEFINE SUBROUTINE CHECK-ACTIVE-HELP
************************************************************************
IF EOMPOM-EXITMEM = SCAN '*'
  REINPUT USING HELP MARK *EOMPOM-EXITMEM
END-IF
*
END-SUBROUTINE /* CHECK-ACTIVE-HELP
*
************************************************************************
DEFINE SUBROUTINE CHECK-ERROR-CODE
************************************************************************
DECIDE ON FIRST EOMMSG-FIELD-NAME
  VALUE 'EOMPHM-I-ID'
    REINPUT *EOMMSG-NR, EOMMSG-TOKEN (1) MARK *EOMPOM-I-ID
  NONE
    REINPUT *EOMMSG-NR, EOMMSG-TOKEN (1)
END-DECIDE
*
END-SUBROUTINE /* CHECK-ERROR-CODE
*
************************************************************************
DEFINE CHECK-TOP-BOTTOM-MORE-ALL
************************************************************************
IF #MAP-IND < 1
  #MAP-IND := 1
END-IF
#J := EOMPOM-ATTRIBUTES-OCC
IF #MAP-IND + #MAP-OCC > #J AND G-C-FUNC = 'D'
  #MAP-IND := #J - #MAP-OCC + 1
END-IF
IF #MAP-IND > #J
  #MAP-IND := #J
END-IF
#I := #MAP-IND
#K := #J - #I
IF #J = 0
  #MAP-IND := 1
  RESET G-NATRP-ERC
ELSE
  DECIDE FOR EVERY CONDITION
    WHEN #K < #MAP-OCC
      RESET #CP                   /* indicate 'bottom of data'
      #END-OF-DATA := TRUE
    WHEN #K >= #MAP-OCC
      RESET #CP                   /* indicate 'more ...'
      RESET #END-OF-DATA
    WHEN #MAP-IND <= 1
      #MAP-IND := 1
      #CP := 1                    /* indicate 'top of data'
      RESET #END-OF-DATA
    WHEN #J <= #MAP-OCC AND #J NE #MAP-IND
      #CP := 1                    /* indicate 'all'
      #END-OF-DATA := TRUE
    WHEN NONE
      IGNORE
  END-DECIDE
  INCLUDE C-TOPBOT
END-IF
*
END-SUBROUTINE /* CHECK-ERROR-CODE
*
************************************************************************
DEFINE SUBROUTINE EDIT-EXIT
************************************************************************
IF EOMPOM-EXITMEM = ' '
  ESCAPE ROUTINE
END-IF
*
PERFORM S-SEPEDT #CALLING-PGM #POS #POS #A8 #POS #A8 2X
  EOMPOM-EXITMEM EOMPOM-EXITLIB 1X #FUNC #PRINTER #PANEL
*
END-SUBROUTINE /* EDIT-EXIT
*
************************************************************************
DEFINE SUBROUTINE INIT-PFKEYS
************************************************************************
RESET G-PF
*
INCLUDE RPFSTD-C
*
DECIDE ON FIRST #PANEL
  VALUE PRINTOUT-GENERAL-ATTRIBUTES
    INCLUDE RPFCOM-C
    INCLUDE RPFPAT-C
    INCLUDE RPFSAT-C
  VALUE PRINTOUT-PRINTER-ATTRIBUTES
    INCLUDE RPFESF-C
    INCLUDE RPFCOM-C
    INCLUDE RPFSAT-C
    INCLUDE RPFEXT-C
    G-PF-IDENT (11) := ##PFN-EDIT
    G-PF-CODE  (11) := ##PFK-EDIT
  VALUE PRINTOUT-SPECIAL-ATTRIBUTES
    INCLUDE RPFESF-C
    INCLUDE RPFCOM-C
    INCLUDE RPFPAT-C
    INCLUDE RPFBRW-C
  NONE  #PANEL := PRINTOUT-GENERAL-ATTRIBUTES
END-DECIDE
*
CALLNAT 'RPFINI-N' G-PF G-PFB
*
END-SUBROUTINE /* INIT-PFKEYS
*
INCLUDE RPFSET-C /*set-pfkeys
*
END
