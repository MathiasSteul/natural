* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* EOMUSM-N - Maintenance of EOM Object >>> User <<<
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* sju 95-10-04 s(999999) created
* gw  96-01-18 s(999999) internal identifier of folder #Inbasket := 1
* mrs 97-06-04 p(162804) validate new profile attribute printer
* xsethz   2000-05-18 s(CE4962)
*    READ-NEXT, READ-HOLD-NEXT, RENAME, COPY added
* xsethz  2000-07-27 (CE7461) Extend Report and Bundle Names
* xsisgg  2000-07-31 (CE7461) New user profile in VUSERS-L
* fhi     2000-08-24 QA03     Use NAT23006 for error values
* sju     2003-05-22 (P240729) restricted use printers
* fhi     2006-06-07 p(279849) Introduce new Revive profile 'M'
* fhi     2007-07-12 NOM3202   C-NATERR changed, NAD23006 is obsolete.
* xsetggr 2007-11-15 p(298112) add user types 'O' and 'P'
* xsetggr 2007-12-19 p(300375) restow due changes of EOMFOM-P
* xsetggr 2008-06-17 p(300323) use eom-library to get monitor defaults
* xsetggr 2009-09-01 P314431 allow only NATUNIX & DISKUNIX printers for
*                         Unix systems, but UNIXLP only for mainframe
* xsetggr 2010-11-15 NOMALL-865 restow due to changes in EOMPHTYE
* fhi     2011-05-02 NOMALL-901 Log any online delete operation
* xsetggr 2011-05-03 NOMALL-902 restow due changes in EOMFOM-P
* xsetggr 2011-09-12 NOMALL-1058 Log delete from NOM API online user
* xsetggr 2012-02-02 NOMALL-1100 do not extract msg text before
*                    writing to log
* xsetggr 2012-10-14 NOMALL-89 add grants if default folder added
* SU1     2013-01-31 unused      Deactivate unused data areas
* xsetggr 2013-04-25 ES-104  implement new user rofile value
* fhi     2014-07-10 NOMALL-1440 Change default for filter setting
* SU2     2014-11-17 NOMALL-1450 fill fields for Adabas Vista
* SU3     2015-10-16 NOMALL-1650 improve delete user
* SU4     2016-01-20 NOMALL-1802 do not update Adabas Vista fields
* fhi     2016-11-15 NOMALL-1961 Use new task IDs
* SU5     2020-11-10 NOMALL-2440 recat for VMONIT-L
* SU6     2021-04-22 NOMALL-2454 recat for VMONIT-L M-NATRPT-DBID/-FNR
* --------------------------------------------------------------------
DEFINE DATA
PARAMETER USING EOM----P
PARAMETER USING EOMUSM-P
PARAMETER USING EOMMSG-P
************************************************************************
LOCAL USING EOM----E
LOCAL USING EOMGRM-P
LOCAL USING EOMFOM-P
LOCAL USING RLOG-L
LOCAL USING VUSERS-L
LOCAL USING VMONIT-L
LOCAL USING EOMPHTYE
LOCAL USING VGRANT-L
*
LOCAL
1 PRINTERS VIEW OF NRM-PRINTERS
  2 P-DISP
  2 P-PHYSICAL-NAME
1 PHYSICAL VIEW OF NRM-PHYSICAL-PRINTERS
  2 PH-PRINTER-TYPE
1 LISTS VIEW OF NRM-DISTRIBUTION-LIST
  2 C*D-USER-LIST
  2 D-USER-LIST(191)
1 FOLDER VIEW OF NRM-FOLDER
  2 FO-ID
  2 FO-USER-ID
  2 FO-NAME
1 REPORTS VIEW OF NRM-REPORTS-NEW
  2 R-NATRPT-DIST (10)
  2 C*R-NATRPT-DIST
1 MAIL-REPORTS VIEW OF NRM-MAIL
  2 MA-USERID
* *****
1 #NOF                       (I2) CONST <4>
1 #FUNC                      (A1/1:#NOF) INIT <'O','P','M','D'>
1 #SECURITY-OPTION           (A3)
1 ALLOWED                    (L)
1 #I                         (I2)
1 #J                         (I2)
1 #CNT                       (I2)
1 #GRANTS                    (A1/1:6)
1 #USER-ID                   (A8)
1 OT                         (I2)
1 OJ                         (I2)
1 EXIST                      (L)
*
1 #SAVE-EOM-USER             (A8)
1 #FO-USER-FO-ID             (A10)
1 REDEFINE #FO-USER-FO-ID
  2 #FO-USER                 (A8)
  2 #FO-ID                   (B2)
1 NOG                        (I2)       CONST <5>
1 #GRANT-TYPE                (A1/1:NOG) INIT <'R','B','L','P','F'>
1 #GR-SUPER-START            (A34)
1 REDEFINE #GR-SUPER-START
  2 #GRS-TYPE                (A1)
  2 #GRS-USER-ID             (A8)
  2 #GRS-OBJECT-NAME         (A25)
1 #GR-SUPER-END              (A34)
1 REDEFINE #GR-SUPER-END
  2 #GRE-TYPE                (A1)
  2 #GRE-USER-ID             (A8)
  2 #GRE-OBJECT-NAME         (A25)
1 PRINTER-EXISTS             (L)
1 #OBJECT-NAME               (A25)
1 #SUPPORT-LONG-NAMES        (L)
1 #READ-PRINTER              (L)
1 #OBJ                       (A50)
1 #USER                      (A8)
1 #APPL                      (A8)
1 #FO-ID-N                   (N5)
1 REDEFINE #FO-ID-N
  2 #FO-ID-A                 (A5)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET EOMMSG-PARMS
*
PERFORM SECURITY-CHECK
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
PERFORM LOGGING-CHECK
IF EOM-FUNCTION NE EOM-SECURITY-CHECK
  EOMUSM-I-CHECK-FUNCTION := EOM-FUNCTION
  PERFORM FUNCTION-SECURITY
  IF EOMMSG-NR NE 0
    ESCAPE ROUTINE
  END-IF
END-IF
DECIDE ON FIRST EOM-FUNCTION
  VALUE EOM-SECURITY-CHECK  PERFORM FUNCTION-SECURITY
  VALUE EOM-ADD, EOM-MODIFY PERFORM MODIFY-USER-ATTRIBUTES
  VALUE EOM-DELETE          PERFORM DELETE-USER-DEFINITION
  VALUE EOM-COPY            PERFORM COPY-USER-DEFINITION
  VALUE EOM-RENAME          PERFORM RENAME-USER-DEFINITION
  VALUE EOM-READ, EOM-READHOLD, EOM-READ-NEXT, EOM-READHOLD-NEXT
    PERFORM READ-USER-ATTRIBUTES
  VALUE EOM-COMMIT
    RESET EOM-LOG-FUNCTION EOM-LOG-OBJECT-NAME
    END OF TRANSACTION
  VALUE EOM-BACKOUT
    RESET EOM-LOG-FUNCTION EOM-LOG-OBJECT-NAME
    BACKOUT TRANSACTION
  VALUE EOM-INIT
    IGNORE
  NONE VALUE
    EOMMSG-NR := 2600
END-DECIDE
*
IF EOM-LOG AND EOMMSG-NR = 0
  PERFORM WRITE-LOG-RECORD
END-IF
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE SECURITY-CHECK
************************************************************************
IF EOM-OBJTYP NE 'U'
  IF EOM-USER = ' ' AND EOM-USER-TYPE NE 'A'
    EOMMSG-NR := 48
    EOMMSG-FIELD-NAME := 'EOM-USER'
    ESCAPE ROUTINE
  END-IF
  IF EOM-USER-TYPE NE 'A'
    FIND USERS WITH USER-ID = EOM-USER
      IF NO RECORDS FOUND
        EOMMSG-NR := 2
        EOMMSG-TOKEN(1) := EOM-USER
        EOMMSG-FIELD-NAME := 'EOM-USER'
        ESCAPE ROUTINE
      END-NOREC
      EOM-USER-PROFILE := USER-PROFILE
      EOM-USER-TYPE := PROF-TYPE
    END-FIND
  END-IF
  IF EOM-USER-TYPE = 'A'
    EOM-OBJTYP-SECURITY (*) := 'Y'
  ELSE
    EOM-OBJTYP-SECURITY (*) := 'N'
    FOR #I = 2 TO 4
      COMPRESS #FUNC (#I) 'US' TO #SECURITY-OPTION LEAVING NO
      RESET ALLOWED
      CALLNAT 'NARPSEC' EOM-USER-PROFILE #SECURITY-OPTION ALLOWED
      IF ALLOWED
        EOM-OBJTYP-SECURITY (#I:6) := 'Y'
        ESCAPE BOTTOM
      END-IF
    END-FOR
  END-IF
  EOM-OBJTYP := 'U'
  RESET EOM-OBJECT-NAME EOM-OBJECT-SECURITY(*)
END-IF
*
IF NOT (EOM-OBJTYP-SECURITY (*) = 'Y')
  EOMMSG-NR := 0020
  ESCAPE ROUTINE
END-IF
*
IF EOM-FUNCTION = EOM-INIT OR = EOM-ADD
  EOM-OBJECT-NAME := EOMUSM-I-NAME
  EOM-OBJECT-SECURITY (*) := EOM-OBJTYP-SECURITY (*)
  IF EOM-OBJTYP-SECURITY (2) = 'Y' OR EOM-OBJTYP-SECURITY (3) = 'Y'
    EOM-OBJECT-SECURITY (1) := 'Y'
  ELSE
    EOM-OBJECT-SECURITY (1) := 'N'
  END-IF
END-IF
*
IF EOM-OBJECT-NAME NE EOMUSM-I-NAME OR EOMUSM-I-NAME = ' '
  EOM-OBJECT-NAME := EOMUSM-I-NAME
  IF EOM-USER-TYPE = 'A'
    EOM-OBJECT-SECURITY (*) := 'Y'
  ELSE
    EOM-OBJECT-SECURITY (*) := EOM-OBJTYP-SECURITY (*)
  END-IF
END-IF
*
IF NOT (EOM-OBJECT-SECURITY (*) = 'Y')
  EOMMSG-NR := 0020
END-IF
*
END-SUBROUTINE /* SECURITY-CHECK
*
************************************************************************
DEFINE SUBROUTINE FUNCTION-SECURITY
************************************************************************
EXAMINE EOM-OBJECT-SECURITY (*) FOR 'Y' GIVING INDEX IN OJ
EXAMINE EOM-OBJTYP-SECURITY (*) FOR 'Y' GIVING INDEX IN OT
*
DECIDE ON FIRST EOMUSM-I-CHECK-FUNCTION
  VALUE EOM-SECURITY-CHECK, EOM-COMMIT, EOM-BACKOUT
    IGNORE
  VALUE EOM-ADD, EOM-READHOLD, EOM-READHOLD-NEXT, EOM-MODIFY, EOM-INIT,
      EOM-COPY, EOM-RENAME
    IF OJ > 3 OR OT > 3
      EOMMSG-NR := 0020
    END-IF
  VALUE EOM-READ, EOM-READ-NEXT
    IF OJ > 4 OR OT > 4
      EOMMSG-NR := 0020
    END-IF
  VALUE EOM-DELETE
    IF OJ > 2 OR OT > 2
      EOMMSG-NR := 0020
    END-IF
  NONE VALUE
    EOMMSG-NR := 2600
END-DECIDE
*
END-SUBROUTINE /* FUNCTION-SECURITY
*
************************************************************************
DEFINE SUBROUTINE LOGGING-CHECK
************************************************************************
IF EOM-LOG-OBJTYP = 'U'
  ESCAPE ROUTINE
END-IF
RESET  EOM-LOGGING
EOM-LOG-OBJTYP := 'U'
IF EOM-LOG-TYPES (*) = 'U'
  EOM-LOG := TRUE
END-IF
*
END-SUBROUTINE /* LOGGING-CHECK
*
************************************************************************
DEFINE SUBROUTINE WRITE-LOG-RECORD
************************************************************************
IF EOM-LOG-FUNCTION = EOM-FUNCTION AND EOM-LOG-OBJECT-NAME=EOMUSM-I-NAME
  ESCAPE ROUTINE
END-IF
*
DECIDE ON FIRST EOM-FUNCTION
  VALUE EOM-ADD
    COMPRESS '0765' EOMUSM-I-NAME TO LG-MSG
    EOM-LOG-FUNCTION           := EOM-FUNCTION
    RESET  EOM-LOG-OBJECT-NAME
  VALUE EOM-MODIFY
    COMPRESS '0766' EOMUSM-I-NAME TO LG-MSG
    EOM-LOG-FUNCTION           := EOM-FUNCTION
    EOM-LOG-OBJECT-NAME := EOMUSM-I-NAME
  VALUE EOM-DELETE
    COMPRESS '0767' EOMUSM-I-NAME TO LG-MSG
    EOM-LOG-FUNCTION           := EOM-FUNCTION
    RESET  EOM-LOG-OBJECT-NAME
  VALUE EOM-RENAME
    COMPRESS '0768' EOMUSM-I-NAME EOMUSM-I-NEWNAME TO LG-MSG
    EOM-LOG-FUNCTION           := EOM-FUNCTION
    RESET  EOM-LOG-OBJECT-NAME
  VALUE EOM-COPY
    COMPRESS '0769' EOMUSM-I-NAME EOMUSM-I-NEWNAME TO LG-MSG
    EOM-LOG-FUNCTION           := EOM-FUNCTION
    RESET  EOM-LOG-OBJECT-NAME
  ANY VALUE
    LG-USERID      := EOM-USER
    LG-CODE        := 'UM'
    LG-OBJECT-NAME := EOMUSM-I-NAME
    CALLNAT 'RLOG' PL-PARMS
  NONE VALUE
    IGNORE
END-DECIDE
*
END-SUBROUTINE /* WRITE-LOG-RECORD
*
************************************************************************
DEFINE SUBROUTINE READ-USER-ATTRIBUTES
************************************************************************
PERFORM VALIDATE-KEY
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
PERFORM USER-ATTRIBUTE-INTERFACE
*
END-SUBROUTINE /* READ-USER-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE MODIFY-USER-ATTRIBUTES
************************************************************************
PERFORM VALIDATE-GENERAL-ATTRIBUTES
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
*
IF EOMUSM-PROFILE = ' '
  PERFORM FILL-DEFAULT-PROFILE
ELSE
  PERFORM GET-SYSTEM-DEFAULTS
  PERFORM VALIDATE-SPECIAL-ATTRIBUTES
  IF EOMMSG-NR NE 0
    ESCAPE ROUTINE
  END-IF
END-IF
*
IF EOM-FUNCTION = EOM-ADD
  CALLNAT 'RCHKDST' EOMUSM-I-NAME EXIST
  IF EXIST
    EOMMSG-NR := 0771
    EOMMSG-TOKEN (1) := EOMUSM-I-NAME
    EOMMSG-FIELD-NAME := 'EOMUSM-I-NAME'
    ESCAPE ROUTINE
  END-IF
END-IF
IF EOM-FUNCTION = EOM-RENAME OR = EOM-COPY
  IF EOMUSM-I-NEWNAME = ' '
    EOMMSG-NR := 48
    EOMMSG-FIELD-NAME := 'EOMUSM-I-NEWNAME'
    ESCAPE ROUTINE
  END-IF
  IF EOMUSM-I-NEWNAME NE MASK (A) AND EOMUSM-I-NEWNAME NE MASK (0-9)
    EOMMSG-NR := 0022
    EOMMSG-FIELD-NAME := 'EOMUSM-I-NEWNAME'
    ESCAPE ROUTINE
  END-IF
  CALLNAT 'RCHKDST' EOMUSM-I-NEWNAME EXIST
  IF EXIST
    EOMMSG-NR := 0771
    EOMMSG-TOKEN (1) := EOMUSM-I-NEWNAME
    EOMMSG-FIELD-NAME := 'EOMUSM-I-NEWNAME'
    ESCAPE ROUTINE
  END-IF
END-IF
PERFORM USER-ATTRIBUTE-INTERFACE
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
IF EOM-FUNCTION = EOM-ADD
  PERFORM ADD-DEFAULT-FOLDER
END-IF
*
END-SUBROUTINE /* MODIFY-USER-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-KEY
************************************************************************
IF NOT (EOM-FUNCTION = EOM-READ-NEXT OR = EOM-READHOLD-NEXT)
  IF EOMUSM-I-NAME = ' '
    EOMMSG-NR := 48
    EOMMSG-FIELD-NAME := 'EOMUSM-I-NAME'
    ESCAPE ROUTINE
  END-IF
*
  IF EOMUSM-I-NAME NE MASK (A) AND EOMUSM-I-NAME NE MASK (0-9)
    EOMMSG-NR := 0022
    EOMMSG-FIELD-NAME := 'EOMUSM-I-NAME'
    ESCAPE ROUTINE
  END-IF
END-IF
*
END-SUBROUTINE
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-NEW-NAME
************************************************************************
IF EOMUSM-I-NEWNAME = ' '
  EOMMSG-NR := 48
  EOMMSG-FIELD-NAME := 'EOMUSM-I-NEWNAME'
  ESCAPE ROUTINE
END-IF
IF EOMUSM-I-NEWNAME NE MASK (A) AND EOMUSM-I-NEWNAME NE MASK (0-9)
  EOMMSG-NR := 0022
  EOMMSG-FIELD-NAME := 'EOMUSM-I-NEWNAME'
  ESCAPE ROUTINE
END-IF
CALLNAT 'RCHKDST' EOMUSM-I-NEWNAME EXIST
IF EXIST
  EOMMSG-NR := 0771
  EOMMSG-TOKEN (1) := EOMUSM-I-NEWNAME
  EOMMSG-FIELD-NAME := 'EOMUSM-I-NEWNAME'
  ESCAPE ROUTINE
END-IF
*
END-SUBROUTINE /* VALIDATE-NEW-NAME
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-GENERAL-ATTRIBUTES
************************************************************************
PERFORM VALIDATE-KEY
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
*
IF EOMUSM-FIRST-NAME = ' '
  EOMMSG-NR := 0615
  EOMMSG-FIELD-NAME := 'EOMUSM-FIRST-NAME'
  ESCAPE ROUTINE
END-IF
*
IF EOMUSM-LAST-NAME = ' '
  EOMMSG-NR := 0616
  EOMMSG-FIELD-NAME := 'EOMUSM-LAST-NAME'
  ESCAPE ROUTINE
END-IF
*
IF EOMUSM-WORK-PHONE-COUNTRY NE MASK (NN)
  EOMUSM-WORK-PHONE-COUNTRY := 0
END-IF
IF EOMUSM-HOME-PHONE-COUNTRY NE MASK (NN)
  EOMUSM-HOME-PHONE-COUNTRY := 0
END-IF
*
END-SUBROUTINE /* VALIDATE-GENERAL-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-SPECIAL-ATTRIBUTES
************************************************************************
IF EOMUSM-PROF-LANGUAGE = ' '
  EOMUSM-PROF-LANGUAGE := *LANGUAGE
END-IF
DECIDE FOR FIRST CONDITION
  WHEN NOT(EOMUSM-PROF-CONFIRM = ' ' OR = 'Y' OR = 'N')
    EOMMSG-NR := 0618
    EOMMSG-FIELD-NAME := 'EOMUSM-PROF-CONFIRM'
  WHEN NOT(EOMUSM-PROF-LANGUAGE = '1' THRU '2')
    EOMMSG-NR := 0036
    EOMMSG-FIELD-NAME := 'EOMUSM-PROF-LANGUAGE'
  WHEN NOT(EOMUSM-PROF-TYPE = 'A' OR = 'G' OR = 'O' OR = 'P')
    EOMMSG-NR := 0620
    EOMMSG-FIELD-NAME := 'EOMUSM-PROF-TYPE'
  WHEN NOT(EOMUSM-PROF-REPORTS = 'D' OR = 'M' OR = 'P' OR = ' ')
    EOMMSG-NR := 0617
    EOMMSG-FIELD-NAME := 'EOMUSM-PROF-REPORTS'
  WHEN NOT(EOMUSM-PROF-CALENDARS = 'D' OR = 'M' OR = 'P' OR = ' ')
    EOMMSG-NR := 0617
    EOMMSG-FIELD-NAME := 'EOMUSM-PROF-CALENDARS'
  WHEN NOT(EOMUSM-PROF-BUNDLES = 'D' OR = 'M' OR = 'P' OR = ' ')
    EOMMSG-NR := 0617
    EOMMSG-FIELD-NAME := 'EOMUSM-PROF-BUNDLES'
  WHEN NOT(EOMUSM-PROF-LISTS = 'D' OR = 'M' OR = 'P' OR = ' ')
    EOMMSG-NR := 0617
    EOMMSG-FIELD-NAME := 'EOMUSM-PROF-LISTS'
  WHEN NOT(EOMUSM-PROF-FLUSH = 'Y' OR = 'N' OR = ' ')
    EOMMSG-NR := 0618
    EOMMSG-FIELD-NAME := 'EOMUSM-PROF-FLUSH'
  WHEN NOT(EOMUSM-PROF-USERS = 'D' OR = 'M' OR = 'P' OR = ' ')
    EOMMSG-NR := 0617
    EOMMSG-FIELD-NAME := 'EOMUSM-PROF-USERS'
  WHEN NOT(EOMUSM-PROF-AREPS = 'D' OR = 'M' OR = 'P' OR = ' ')
    EOMMSG-NR := 0617
    EOMMSG-FIELD-NAME := 'EOMUSM-PROF-AREPS'
  WHEN NOT(EOMUSM-PROF-PRINTERS = 'D' OR = 'M' OR = 'P' OR = ' ')
    EOMMSG-NR := 0617
    EOMMSG-FIELD-NAME := 'EOMUSM-PROF-PRINTERS'
  WHEN NOT(EOMUSM-PROF-PHYSICAL = 'D' OR = 'M' OR = 'P' OR = ' ')
    EOMMSG-NR := 0617
    EOMMSG-FIELD-NAME := 'EOMUSM-PROF-PHYSICAL'
  WHEN NOT(EOMUSM-PROF-DEST = 'D' OR = 'M' OR = 'P' OR = ' ')
    EOMMSG-NR := 0617
    EOMMSG-FIELD-NAME := 'EOMUSM-PROF-DEST'
  WHEN NOT(EOMUSM-PROF-LOCATION = 'D' OR = 'M' OR = 'P' OR = ' ')
    EOMMSG-NR := 0617
    EOMMSG-FIELD-NAME := 'EOMUSM-PROF-LOCATION'
  WHEN NOT(EOMUSM-PROF-ARCHIVE-ADMIN = 'Y' OR = 'N')
    EOMMSG-NR := 0618
    EOMMSG-FIELD-NAME := 'EOMUSM-PROF-ARCHIVE-ADMIN'
  WHEN NOT(EOMUSM-PROF-ARCHIVE = 'Y' OR = 'N' OR = ' ')
    EOMMSG-NR := 0618
    EOMMSG-FIELD-NAME := 'EOMUSM-PROF-ARCHIVE'
  WHEN NOT(EOMUSM-PROF-REVIVE = 'Y' OR = 'N' OR = 'M' OR = ' ')
    EOMMSG-NR := 0618
    EOMMSG-FIELD-NAME := 'EOMUSM-PROF-REVIVE'
  WHEN NOT(EOMUSM-PROF-STARTUP = 'Y' OR = 'N' OR = 'M' OR = ' ')
    EOMMSG-NR := 0618
    EOMMSG-FIELD-NAME := 'EOMUSM-PROF-STARTUP'
  WHEN NOT(EOMUSM-PROF-EDT-PREFIX = 'Y' OR = 'N' OR = ' ')
    EOMMSG-NR := 0618
    EOMMSG-FIELD-NAME := 'EOMUSM-PROF-EDT-PREFIX'
  WHEN NOT(EOMUSM-PROF-EDT-KEYS = 'Y' OR = 'N' OR = ' ')
    EOMMSG-NR := 0618
    EOMMSG-FIELD-NAME := 'EOMUSM-PROF-EDT-KEYS'
  WHEN NOT(EOMUSM-PROF-EXTERNAL = 'Y' OR = 'N' OR = ' ')
    EOMMSG-NR := 0618
    EOMMSG-FIELD-NAME := 'EOMUSM-PROF-EXTERNAL'
  WHEN NOT(EOMUSM-PROF-SHUTDOWN = 'Y' OR = 'N' OR = ' ')
    EOMMSG-NR := 0618
    EOMMSG-FIELD-NAME := 'EOMUSM-PROF-SHUTDOWN'
  WHEN NOT(EOMUSM-PROF-DEFAULTS = 'D' OR = 'M' OR = ' ')
    EOMMSG-NR := 0619
    EOMMSG-FIELD-NAME := 'EOMUSM-PROF-DEFAULTS'
  WHEN NOT(EOMUSM-PROF-NODES = 'D' OR = 'M' OR = 'P' OR = ' ')
    EOMMSG-NR := 0617
    EOMMSG-FIELD-NAME := 'EOMUSM-PROF-NODES'
  WHEN NOT(EOMUSM-PROF-ABUNDS = 'D' OR = 'M' OR = 'P' OR = ' ')
    EOMMSG-NR := 0617
    EOMMSG-FIELD-NAME := 'EOMUSM-PROF-ABUNDS'
  WHEN NOT(EOMUSM-PROF-PRINTOUTS = 'D' OR = 'M' OR = 'P' OR = ' ')
    EOMMSG-NR := 0617
    EOMMSG-FIELD-NAME := 'EOMUSM-PROF-PRINTOUTS'
  WHEN NOT(EOMUSM-PROF-AUTOCOMMIT = 'E' OR = 'I')
    EOMMSG-NR := 0625
    EOMMSG-FIELD-NAME := 'EOMUSM-PROF-AUTOCOMMIT'
  WHEN NOT(EOMUSM-PROF-RESTRICT-ABUN = 'Y' OR = 'N' OR = ' ')
    EOMMSG-NR := 0618
    EOMMSG-FIELD-NAME := 'EOMUSM-PROF-RESTRICT-ABUN'
  WHEN NOT(EOMUSM-PROF-ABUN-LIST-FORMAT = '1' OR = '2' OR = ' ')
    EOMMSG-NR := 0125
    EOMMSG-FIELD-NAME := 'EOMUSM-PROF-ABUN-LIST-FORMAT'
  WHEN NOT(EOMUSM-PROF-DISPLAY-MONITOR = 'Y' OR = 'N' OR = ' ')
    EOMMSG-NR := 0618
    EOMMSG-FIELD-NAME := 'EOMUSM-PROF-DISPLAY-MONITOR'
  WHEN NOT(EOMUSM-PROF-DISPLAY-LONG-NAMES ='Y' OR ='N' OR =' ')
    EOMMSG-NR := 0618
    EOMMSG-FIELD-NAME := 'EOMUSM-PROF-DISPLAY-LONG-NAMES'
  WHEN NOT #SUPPORT-LONG-NAMES AND EOMUSM-PROF-DISPLAY-LONG-NAMES='Y'
    EOMMSG-NR := 0637
    EOMMSG-FIELD-NAME := 'EOMUSM-PROF-DISPLAY-LONG-NAMES'
  WHEN NOT(EOMUSM-PROF-AR-FILTER-SUBSTR = 'Y' OR = 'N' OR = ' ')
    EOMUSM-PROF-AR-FILTER-SUBSTR := 'N'
  WHEN ANY
    ESCAPE ROUTINE
  WHEN NONE
    IGNORE
END-DECIDE
*
IF EOMUSM-PROF-PRINTER NE ' ' /* check if the currently modified user
  CALLNAT 'RCHKPRT' EOMUSM-PROF-PRINTER PRINTER-EXISTS
  IF NOT PRINTER-EXISTS
    EOMMSG-NR := 0770
    EOMMSG-TOKEN (1) := EOMUSM-PROF-PRINTER
    EOMMSG-FIELD-NAME := 'EOMUSM-PROF-PRINTER'
    ESCAPE ROUTINE
  END-IF
  IF EOMUSM-PROF-TYPE NE 'A'
    #USER-ID := EOMUSM-I-NAME
    #OBJECT-NAME := EOMUSM-PROF-PRINTER
    CALLNAT 'RGRANT-N' #USER-ID 'P' #OBJECT-NAME ALLOWED #GRANTS (*)
    IF ALLOWED AND NOT #GRANTS(*) = 'Y'
      FIND PRINTERS WITH P-ID = #OBJECT-NAME
        IF P-DISP = 'Y'
          RESET ALLOWED
          #READ-PRINTER := TRUE
        END-IF
      END-FIND
    END-IF
    IF NOT ALLOWED
      EOMMSG-NR := 1090
      EOMMSG-FIELD-NAME := 'EOMUSM-PROF-PRINTER'
      ESCAPE ROUTINE
    END-IF
    PERFORM CHECK-PRINTER-TYPE
  END-IF
END-IF
*
END-SUBROUTINE /* VALIDATE-SPECIAL-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE CHECK-PRINTER-TYPE
************************************************************************
IF NOT #READ-PRINTER
  FIND PRINTERS WITH P-ID = EOMUSM-PROF-PRINTER
  END-FIND
END-IF
FIND PHYSICAL WITH PH-VTAMID = PRINTERS.P-PHYSICAL-NAME
  IF *MACHINE-CLASS = 'MAINFRAME'
    IF PH-PRINTER-TYPE = ##PHYS-NATUNIX
      EOMMSG-NR := 0130
      EOMMSG-FIELD-NAME := 'EOMUSM-PROF-PRINTER'
      ESCAPE ROUTINE
    END-IF
  ELSE
    IF NOT(PH-PRINTER-TYPE = ##PHYS-DISKUNIX OR = ##PHYS-NATUNIX)
      EOMMSG-NR := 0131
      EOMMSG-FIELD-NAME := 'EOMUSM-PROF-PRINTER'
      ESCAPE ROUTINE
    END-IF
  END-IF
END-FIND
*
END-SUBROUTINE /* CHECK-PRINTER-TYPE
*
************************************************************************
DEFINE SUBROUTINE GET-SYSTEM-DEFAULTS
************************************************************************
M-MONITOR-ID := F#MONITOR-TASK-ID1 (<>)
FIND NRM-MONITOR WITH M-MONITOR-ID = M-MONITOR-ID
  IF M-SUPPORT-LONG-NAMES = 'Y'
    #SUPPORT-LONG-NAMES := TRUE
  ELSE
    RESET #SUPPORT-LONG-NAMES
  END-IF
END-FIND
*
END-SUBROUTINE /* GET-SYSTEM-DEFAULTS
*
************************************************************************
DEFINE SUBROUTINE DELETE-USER-DEFINITION
************************************************************************
* *****
* Delete from lists:
* *****
#USER := EOM-USER
#APPL := EOM-LIBRARY
FIND LISTS WITH D-USER-LIST = EOMUSM-I-NAME
  FOR #I 1 TO C*D-USER-LIST
    IF D-USER-LIST(#I) = EOMUSM-I-NAME
      RESET D-USER-LIST(#I)
    END-IF
  END-FOR
  UPDATE
  PERFORM ETS
END-FIND
* *****
* Delete folders:
* *****
#FO-USER := EOMUSM-I-NAME
#FO-ID := 1
DELFO. READ FOLDER BY FO-USER-FO-ID = #FO-USER-FO-ID
  IF FO-USER-ID NE EOMUSM-I-NAME
    ESCAPE BOTTOM
  END-IF
*
  DELETE
  COMPRESS FO-USER-ID '/' FO-NAME TO #OBJ LEAVING NO
  PERFORM RMLOGDEL #OBJ 'FOLDER' #USER #APPL
  PERFORM ETS
*
END-READ
* *****
* Delete grants:
* *****
EOMGRM-I-USER := EOMUSM-I-NAME
CALLNAT 'EOMGRM-N' EOM-DELETE-ALL EOMGRM-PARMS EOMMSG-PARMS
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
* *****
* Delete mail reports:
* *****
READ MAIL-REPORTS BY MA-USER-REP-TIME = EOMUSM-I-NAME
  IF MA-USERID > EOMUSM-I-NAME
    ESCAPE BOTTOM
  END-IF
  DELETE
  PERFORM RMLOGDEL #OBJ 'MAIL' #USER #APPL
  PERFORM ETS
END-READ
* *****
* Delete reports:
* *****
FIND REPORTS WITH R-NATRPT-DIST = EOMUSM-I-NAME
  #I := C*R-NATRPT-DIST
  EXAMINE FULL VALUE OF R-NATRPT-DIST (1:#I)
    FOR FULL VALUE OF EOMUSM-I-NAME GIVING INDEX IN #J
  IF #J > 0
    RESET R-NATRPT-DIST (#J)
    UPDATE
  END-IF
  PERFORM ETS
END-FIND
* *****
* Delete user itself at the very end
* *****
CALLNAT 'EOMUSMGN' EOM-PARMS EOMUSM-PARMS EOMMSG-PARMS
END TRANSACTION
*
END-SUBROUTINE /* DELETE-USER-DEFINITION
*
************************************************************************
DEFINE SUBROUTINE RENAME-USER-DEFINITION
************************************************************************
PERFORM VALIDATE-NEW-NAME
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
CALLNAT 'EOMUSMGN' EOM-PARMS EOMUSM-PARMS EOMMSG-PARMS
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
*
FIND LISTS WITH D-USER-LIST = EOMUSM-I-NAME
  FOR #I 1 TO C*D-USER-LIST
    IF D-USER-LIST(#I) = EOMUSM-I-NAME
      D-USER-LIST(#I) := EOMUSM-I-NEWNAME
    END-IF
  END-FOR
  UPDATE
END-FIND
*
#FO-USER := EOMUSM-I-NAME
#FO-ID := 1
READ FOLDER BY FO-USER-FO-ID = #FO-USER-FO-ID
  IF FO-USER-ID NE EOMUSM-I-NAME
    ESCAPE BOTTOM
  END-IF
  FO-USER-ID := EOMUSM-I-NEWNAME
  UPDATE
END-READ
*
#GRS-USER-ID := #GRE-USER-ID := EOMUSM-I-NAME
#GRS-OBJECT-NAME := H'00'
#GRE-OBJECT-NAME := H'FF'
FOR #I = 1 TO NOG
  #GRS-TYPE := #GRE-TYPE := #GRANT-TYPE (#I)
  FIND GRANTS WITH GR-SUPER = #GR-SUPER-START THRU #GR-SUPER-END
    GR-USERID := EOMUSM-I-NEWNAME
    UPDATE
    PERFORM ETS
  END-FIND
END-FOR
*
READ MAIL-REPORTS BY MA-USER-REP-TIME = EOMUSM-I-NAME
  IF MA-USERID > EOMUSM-I-NAME
    ESCAPE BOTTOM
  END-IF
  MA-USERID := EOMUSM-I-NEWNAME
  UPDATE
  PERFORM ETS
END-READ
*
FIND REPORTS WITH R-NATRPT-DIST = EOMUSM-I-NAME
  #I := C*R-NATRPT-DIST
  EXAMINE FULL VALUE OF R-NATRPT-DIST (1:#I)
    FOR FULL VALUE OF EOMUSM-I-NAME GIVING INDEX IN #J
  IF #J > 0
    R-NATRPT-DIST (#J) := EOMUSM-I-NEWNAME
    UPDATE
    PERFORM ETS
  END-IF
END-FIND
*
END-SUBROUTINE /* RENAME-USER-DEFINITION
*
************************************************************************
DEFINE SUBROUTINE COPY-USER-DEFINITION
************************************************************************
PERFORM VALIDATE-NEW-NAME
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
CALLNAT 'EOMUSMGN' EOM-PARMS EOMUSM-PARMS EOMMSG-PARMS
*
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
*
#SAVE-EOM-USER := EOMUSM-I-NAME
EOMUSM-I-NAME := EOMUSM-I-NEWNAME
PERFORM ADD-DEFAULT-FOLDER
EOMUSM-I-NAME := #SAVE-EOM-USER
*
#GRS-USER-ID := #GRE-USER-ID := EOMUSM-I-NAME
#GRS-OBJECT-NAME := H'00'
#GRE-OBJECT-NAME := H'FF'
FOR #I = 1 TO NOG
  #GRS-TYPE := #GRE-TYPE := #GRANT-TYPE (#I)
  FIND GRANTS WITH GR-SUPER = #GR-SUPER-START THRU #GR-SUPER-END
    GR-USERID := EOMUSM-I-NEWNAME
    STORE GRANTS
  END-FIND
END-FOR
*
END-SUBROUTINE /* COPY-USER-DEFINITION
*
************************************************************************
DEFINE SUBROUTINE USER-ATTRIBUTE-INTERFACE
************************************************************************
CALLNAT 'EOMUSMGN' EOM-PARMS EOMUSM-PARMS EOMMSG-PARMS
*
END-SUBROUTINE /* USER-ATTRIBUTE-INTERFACE
*
************************************************************************
DEFINE SUBROUTINE FILL-DEFAULT-PROFILE
************************************************************************
EOMUSM-PROF-REPORTS := 'P'
EOMUSM-PROF-BUNDLES := 'P'
EOMUSM-PROF-PRINTERS := 'D'
EOMUSM-PROF-AREPS := 'M'
EOMUSM-PROF-ABUNDS := 'M'
EOMUSM-PROF-ARCHIVE := 'Y'
EOMUSM-PROF-REVIVE := 'Y'
EOMUSM-PROF-FLUSH := 'N'
EOMUSM-PROF-LISTS := 'P'
EOMUSM-PROF-CALENDARS := 'D'
EOMUSM-PROF-PHYSICAL := 'D'
EOMUSM-PROF-PRINTOUTS := 'M'
EOMUSM-PROF-TYPE := 'G'
EOMUSM-PROF-ARCHIVE-ADMIN := 'N'
EOMUSM-PROF-DEFAULTS := 'D'
EOMUSM-PROF-STARTUP := 'N'
EOMUSM-PROF-SHUTDOWN := 'N'
EOMUSM-PROF-AUTOCOMMIT := 'E'
EOMUSM-PROF-LANGUAGE := *LANGUAGE
EOMUSM-PROF-CONFIRM := 'Y'
EOMUSM-PROF-EDT-PREFIX := 'Y'
EOMUSM-PROF-EDT-KEYS := 'Y'
EOMUSM-PROF-EXTERNAL := 'Y'
EOMUSM-PROF-AR-FILTER-SUBSTR := 'N'
*
END-SUBROUTINE /* FILL-DEFAULT-PROFILE
*
************************************************************************
DEFINE SUBROUTINE ADD-DEFAULT-FOLDER
************************************************************************
IF EOMUSM-PROF-LANGUAGE = '2'
  EOMFOM-I-NAME := '#Listeneingang'
ELSE
  EOMFOM-I-NAME := '#Inbasket'
END-IF
#FO-USER := EOMUSM-I-NAME
#FO-ID := 1
*
FNDFO. FIND FOLDER WITH FO-USER-FO-ID = #FO-USER-FO-ID
  IF NO RECORDS FOUND
    FO-USER-ID := EOMUSM-I-NAME
    FO-ID      := 1
    FO-NAME    := EOMFOM-I-NAME
    STORE FOLDER
  END-NOREC
END-FIND
EOMGRM-I-TYPE := 'F'
EOMGRM-I-USER := EOMUSM-I-NAME
EOMGRM-OPTION(*) := 'Y'
#FO-ID-N := 1
COMPRESS EOMUSM-I-NAME #FO-ID-A TO EOMGRM-I-NAME LEAVING NO
CALLNAT 'EOMGRM-N' EOM-ADD EOMGRM-PARMS EOMMSG-PARMS
*
END-SUBROUTINE /* ADD-DEFAULT-FOLDER
*
************************************************************************
DEFINE SUBROUTINE ETS
************************************************************************
ADD 1 TO #CNT
IF #CNT > 100
  END TRANSACTION
  RESET #CNT
END-IF
*
END-SUBROUTINE /* ETS
*
INCLUDE C-EOMERR /*ON ERROR
*
END
