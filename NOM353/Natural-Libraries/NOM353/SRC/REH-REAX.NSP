  2 AR-PRINTERS              (A12/1:20) /* N
  2 AR-HOLD-PRINT            (A1)      /* N
  2 AR-SEPMEM                (A16)     /* #K-SEPMEM
  2 AR-SEPNO                 (P3)      /* N
  2 AR-ACTIVE                (A1)      /* N
  2 AR-ARCHIVE               (A1)      /* N
  2 AR-ARCHIVE-RETENTION     (A5)      /* N
  2 AR-ARCHIVE-RECNO         (N8)      /* N
  2 AR-ARCHIVE-DATE          (T)       /* #I-ARCHIVE-DATE-T
  2 AR-ARCHIVE-DATA-SET      (A44)     /* #ARCHIVE-DSNAME
* 2 C*AR-ARCHIVE-VOLSER      (P3)
  2 AR-ARCHIVE-VOLSER        (A6/1:10) /* #VOLSERS
  2 AR-REVIVE                (A1)      /* N
  2 AR-REVIVE-EXPIRATION     (A8)      /* N
  2 AR-REVIVE-DATE           (T)       /* N
  2 AR-REVIVE-RETENTION-PERIOD (A12)   /* N
  2 AR-CHARS                 (A20)     /* #K-CHARS
* 2 AR-DATASET-IDENTIFIER    (A25)     /* repl. by AR-MASTER-REPNAME
  2 AR-DATASET-KEY           (N7)      /* N
  2 AR-DSNO                  (N3)      /* #DSNO
  2 AR-DSTYPE                (A2)      /* #DSTYPE
  2 AR-FCB                   (A4)      /* #K-FCB
  2 AR-FLASH                 (A4)      /* #K-FLASH
  2 AR-FORM                  (A8)      /* #K-FORM
  2 AR-FORMDEF               (A8)      /* N
  2 AR-GROUP-ID              (A20)     /* N
  2 AR-JOBNAME               (A10)     /* #JOBNAME
  2 AR-JOBNO                 (N7)      /* #JOBNO
  2 AR-PROCNAME              (A8)      /* N
  2 AR-DDNAME                (A8)      /* N
  2 AR-PAGEDEF               (A8)      /* N
  2 AR-RECFM                 (A3)      /* #K-RECFM
  2 AR-STEPNAME              (A8)      /* N
  2 AR-TRC                   (A3)      /* #K-TRC
  2 AR-COPIES                (N3)      /* N
  2 AR-ARCHIVE-TYPE          (N1)      /* N
  2 AR-STYLESHEET-URL        (A70)     /* N
  2 AR-REP-FORMAT            (A1)      /* N
  2 AR-SOURCE                (A16)     /* N
  2 AR-SENDER                (A16)     /* N
  2 AR-LAST-UPDATE           (T)       /* N
  2 AR-LAST-UPDATE-USER      (A16)     /* N
  2 AR-OBJECT-TYPE           (A10)     /* N
  2 AR-OBJECT-TIME           (T)       /* N
*
1 AD1 VIEW OF NRM-ARCHIVE-DATASET
  2 AD-ARCHIVE-DSNAME        (A44)
  2 AD-CREATED               (T)
  2 AD-CREATED-INV           (T)
  2 AD-EXPIRATION-DATE       (A8)
  2 AD-EXPIRATION-DATE-PHYS  (A8)
*   R-ASM-EXIT (A8) nrm-reports
*   AD-EXPIRATION-DATE-PHYS (A8)
  2 AD-CONDENSE-OUTPUT       (A1)
  2 AD-ORIGINAL-REPORT-COUNT (P7.0)
  2 AD-VOLSERS               (A6/1:20)
* 2 AD-MARK-ARCHIVE-DSNAME   (A45) /* SP
*   -------- SOURCE FIELD(S) -------
*   AD-ARCHIVE-DSNAME(1-44)
*   AD-MARK-FOR-CONDENSE(2-2)
  2 AD-MARK-FOR-CONDENSE     (A1)
  2 AD-ARCHIVE-TYPE          (N1.0)
  2 AD-OBJECT-TYPE           (A10)
  2 AD-OBJECT-TIME           (T)
*
*
1 DR1 VIEW OF NRM-DATASET-REPORT
  2 DR-ARCHIVE-DSNAME        (A44)
  2 DR-REPNAME               (A25)
  2 DR-REPRNB                (P11.0)
  2 DR-STATUS                (A1)
*   report status in bun
  2 DR-EXPIRATION-DATE       (A8)
  2 DR-EXPIRATION-DATE-ORIG  (A8)
* 2 DR-REPORT-RNB            (A31) /* SP
*   -------- SOURCE FIELD(S) -------
*   DR-REPNAME(1-25)
*   DR-REPRNB(1-6)
* 2 DR-DSNAME-REPORT-RNB     (A75) /* SP
*   -------- SOURCE FIELD(S) -------
*   DR-ARCHIVE-DSNAME(1-44)
*   DR-REPNAME(1-25)
*   DR-REPRNB(1-6)
  2 DR-OBJECT-TYPE           (A10)
  2 DR-OBJECT-TIME           (T)
*
*
1 MA1 VIEW OF NRM-MAIL
  2 MA-REP-RNB               (A31) /* SP
*   -------- SOURCE FIELD(S) -------
*   MA-REPNAME(1-25)
*   MA-REPRNB(1-6)
  2 MA-USERID                (A8)      /* When report is distr
  2 MA-FO-ID                 (B2)
  2 MA-REPNAME               (A25)     /* mailed report name
  2 MA-REPRNB                (P11)     /* mailed report intern
  2 MA-INV-TIME              (P13)     /* inverted report crea
  2 MA-STATUS                (A1)      /* mail status(not in u
  2 MA-LAYOUT
    3 MA-FROM                (P3/1:10)
    3 MA-TO                  (P3/1:10)
  2 MA-HEADLINES             (N3)
  2 MA-CURRENT-LOCATION      (A1)
  2 MA-PROCESS-TIME          (P13)
  2 MA-PROCESS-TIME-INV      (P13)
  2 MA-OBJECT-TYPE           (A10)
  2 MA-OBJECT-TIME           (T)
*
1 MAO
  2 MAO-USERID                (A8)      /* When report is distr
  2 MAO-FO-ID                 (B2)
  2 MAO-REPNAME               (A25)     /* mailed report name
  2 MAO-REPRNB                (P11)     /* mailed report intern
  2 MAO-INV-TIME              (P13)     /* inverted report crea
  2 MAO-STATUS                (A1)      /* mail status(not in u
* 2 MA-LAYOUT
  2 MAO-FROM                (P3/1:10)
  2 MAO-TO                  (P3/1:10)
  2 MAO-HEADLINES             (N3)
  2 MAO-CURRENT-LOCATION      (A1)
  2 MAO-PROCESS-TIME          (P13)
  2 MAO-PROCESS-TIME-INV      (P13)
  2 MAO-OBJECT-TYPE           (A10)
  2 MAO-OBJECT-TIME           (T)
*
*
1 FS1 VIEW OF NRM-FILED-SYSOUTS
  2 F-REPNAME                (A25)
  2 F-REPRNB                 (P11.0)
  2 F-SEQ                    (B4)
  2 F-TEXT                   (A251/1:66)
* 2 F-REPNAME-RNB-SEQ        (A35) /* SP
*   -------- SOURCE FIELD(S) -------
*   F-REPNAME(1-25)
*   F-REPRNB(1-6)
*   F-SEQ(1-4)
  2 F-OBJECT-TYPE            (A10)
  2 F-OBJECT-TIME            (T)
*
*
1 RC1 VIEW OF NRM-REPORT-CONTENTS
  2 AC-REP-RNB-SEQ           (A35) /* SP
*   -------- SOURCE FIELD(S) -------
*   AC-REPNAME(1-25)
*   AC-REPRNB(1-6)
*   AC-SEQNO(1-4)
*   -------- SOURCE FIELD(S) -------
*   AC-REPNAME(1-25)
*   AC-REPRNB(1-4)
*   AC-SEQNO(1-4)
  2 AC-REPNAME               (A25)
  2 AC-REPRNB                (P11.0)
  2 AC-SEQNO                 (B4)
  2 AC-INSERTED-LINE         (A253/1:10) /* MU-FIELD
  2 AC-CONTENTS
    3 AC-FROM-LINE           (P7.0/1:99) /* FIELD IN PE
    3 AC-TO-LINE             (P7.0/1:99) /* FIELD IN PE
  2 AC-CONTENTS-N9
    3 AC-FROM-LINE-N9        (P9.0/1:99) /* FIELD IN PE
    3 AC-TO-LINE-N9          (P9.0/1:99) /* FIELD IN PE
  2 AC-OBJECT-TYPE           (A10)
  2 AC-OBJECT-TIME           (T)
*
1 #DELETE                    (A1)
1 #PATH-FILE                 (A) DYNAMIC
1 #OS-CMD                    (A) DYNAMIC
1 #RC                        (I4)
1 #A250                      (A250)
1 REDEFINE #A250
  2 #A1-A                    (A1/1:250)
* NOM Check for Admin rights, enter a Log
LOCAL USING NOMFNC-E            /* NOM API's
LOCAL USING NOMUS--P
LOCAL USING NOMUS--E
LOCAL USING RLOG-L
LOCAL
01 #ACCESS-CODE          (A8)
1 #OUT-STRING                (A79)
END-DEFINE
*
*
***********************************************************************
DEFINE SUBROUTINE BACKOUT
***********************************************************************
NOMUS-FUNCTION := NOMUS-FCT-BACKOUT
CALLNAT NOM-USER-MAINTENANCE
  NOMUS-NOMVERS NOMUS-PARMS (*)
*
IF NOMUS-ERROR-CODE NE 0
  PRINT '=' NOMUS-ERROR-CODE
  PRINT '=' NOMUS-ERROR-TEXT
END-IF
END-SUBROUTINE
*
*
*
*
*
*
IF *MACHINE-CLASS = 'MAINFRAME'
  COMPRESS 'Machine-Class' *MACHINE-CLASS 'not supported.'
    INTO #OUT-STRING
  WRITE #OUT-STRING
  ESCAPE ROUTINE
END-IF
*
*
INPUT (AD=MIT'_' IP=OFF) 'Enter access code ..' #ACCESS-CODE
IF #ACCESS-CODE NE *PROGRAM
  WRITE 'Wrong access code. Stopping..'
  ESCAPE ROUTINE
END-IF
*
*
NOMUS-NOMVERS  := NOM-CURRENT-VERSION
NOMUS-USER     := *USER
NOMUS-LANGUAGE := *LANGUAGE
NOMUS-LOG-TYP  := 'U'
NOMUS-USER-ID  := *USER
RESET NOMUS-ERROR-CODE
  NOMUS-ERROR-TEXT
* read record from users file
RESET NOMUS-ATTR(*)
NOMUS-FUNCTION := NOMUS-FCT-READ
CALLNAT NOM-USER-MAINTENANCE
  NOMUS-NOMVERS NOMUS-PARMS (*)
IF NOMUS-ERROR-CODE NE 0
  PRINT '=' NOMUS-ERROR-CODE
  PRINT '=' NOMUS-ERROR-TEXT
  ESCAPE ROUTINE
END-IF
PERFORM BACKOUT
IF NOMUS-PROF-TYPE NE 'A'
  WRITE 'User' NOMUS-USER-ID 'is not an administrator. The type is'
    NOMUS-PROF-TYPE
    / 'Stopping ...'
  ESCAPE ROUTINE
END-IF
*
*
*
*
*
#DELETE := 'N'
INPUT (AD=M'_') #DELETE '<'
WRITE 'Delete:' #DELETE /
*
*
*
* Enter entry in Monitor log
*
PL-PARMS.LG-USERID := *USER
PL-PARMS.LG-CODE   :=  'MO'
COMPRESS 'Program' *PROGRAM 'started with DELETE=' #DELETE
  INTO PL-PARMS.LG-MSG
CALLNAT 'RLOG' PL-PARMS
END TRANSACTION
*
*
WRITE 'ARCHIVE-DATASET A'
READ AD1 BY AD-ARCHIVE-DSNAME
  WRITE AD-ARCHIVE-DSNAME (AL=20) AD-CREATED AD-ORIGINAL-REPORT-COUNT
    AD-ARCHIVE-TYPE
  IF #DELETE = 'Y'
    DELETE
    /*
    COMPRESS '$EOM_ARC/' AD-ARCHIVE-DSNAME INTO #PATH-FILE LEAVING NO
    COMPRESS 'rm' #PATH-FILE INTO #OS-CMD
    CALL 'SHCMD' #OS-CMD 'NOSCREENIO'
    #RC := RET('SHCMD')
    IF #RC = 0 THEN
      IGNORE
    ELSE
      WRITE '''rm archive'' error, RC=' #RC
    END-IF
  END-IF
END-READ
END TRANSACTION
*
*
* AR1.AR-REPNAME := 'XYZ'
* AR1.AR-REPRNB := 11
* STORE AR1
*
WRITE / 'ACTIVE-REPORTS R'
READ AR1 BY AR-REPORT-RNB
  WRITE AR1.AR-REPNAME AR1.AR-REPRNB AR-USERID
*   IF AR-SPOOL-ATTR-EXTENDED(1) NE ' '
*     WRITE 'AR-SPOOL-ATTR-EXTENDED(1) NE '' '''
*     #A250 := AR-SPOOL-ATTR-EXTENDED(1)
*     WRITE AR-SPOOL-ATTR-EXTENDED(1) (AL=36 EM=H(36))
*     FOR #RC = 1 TO 250
*       IF #A1-A(#RC) NE ' '
*         WRITE #RC #A1-A(#RC) #A1-A(#RC) (EM=HH)
*       END-IF
*     END-FOR
*   END-IF
*   IF AR-SPOOL-ATTR-EXTENDED(2) NE ' '
*     WRITE 'AR-SPOOL-ATTR-EXTENDED(2) NE '' '''
*     #A250 := AR-SPOOL-ATTR-EXTENDED(2)
*     WRITE AR-SPOOL-ATTR-EXTENDED(2) (AL=36 EM=H(36))
*   END-IF
*   IF AR-SPOOL-ATTR-EXTENDED(3) NE ' '
*     WRITE 'AR-SPOOL-ATTR-EXTENDED(3) NE '' '''
*     #A250 := AR-SPOOL-ATTR-EXTENDED(3)
*     WRITE AR-SPOOL-ATTR-EXTENDED(3) (AL=36 EM=H(36))
*   END-IF
  IF #DELETE = 'Y' DELETE END-IF
END-READ
END TRANSACTION
*
*
WRITE / 'DATASET-REPORT D'
READ DR1 BY DR-ARCHIVE-DSNAME
  WRITE DR-ARCHIVE-DSNAME (AL=20) DR-REPNAME DR-REPRNB
    DR-STATUS DR-EXPIRATION-DATE
  IF #DELETE = 'Y' DELETE END-IF
END-READ
END TRANSACTION
*
*
WRITE / 'MAIL M'
READ MA1 BY MA-REP-RNB
  WRITE MA-REPNAME MA-REPRNB '<>' MA-USERID '<>' MA-FO-ID '<>'
    MA-STATUS '<>' MA-CURRENT-LOCATION

*   IF MAO-REPRNB NE MA-REPRNB      /* (P11) mailed report intern
*     MAO-USERID := MA-USERID
*     MAO-FO-ID := MA-FO-ID
*     MAO-REPNAME := MA-REPNAME
*     MAO-REPRNB := MA-REPRNB
*     MAO-INV-TIME := MA-INV-TIME
*     MAO-STATUS := MA-STATUS
*     MAO-FROM(*) := MA-FROM(*)
*     MAO-TO(*) := MA-TO(*)
*     MAO-HEADLINES := MA-HEADLINES
*     MAO-CURRENT-LOCATION := MA-CURRENT-LOCATION
*     MAO-PROCESS-TIME := MA-PROCESS-TIME
*     MAO-PROCESS-TIME-INV := MA-PROCESS-TIME-INV
*     MAO-OBJECT-TYPE := MA-OBJECT-TYPE
*     MAO-OBJECT-TIME := MA-OBJECT-TIME
*   END-IF
*   IF MAO-USERID NE MA-USERID
*     WRITE ' ' '=' MA-USERID
*     MAO-USERID := MA-USERID
*   END-IF
*   IF MAO-FO-ID NE MA-FO-ID        /* (B2)
*     WRITE ' ' '=' MA-FO-ID
*     MAO-FO-ID := MA-FO-ID
*   END-IF
*   IF MAO-REPNAME NE MA-REPNAME    /* (A25) mailed report name
*     WRITE ' ' '=' MA-REPNAME
*     MAO-REPNAME := MA-REPNAME
*   END-IF
*   IF MAO-REPRNB NE MA-REPRNB      /* (P11) mailed report intern
*     WRITE ' ' '=' MA-REPRNB
*     MAO-REPRNB := MA-REPRNB
*   END-IF
*   IF MAO-INV-TIME NE MA-INV-TIME  /* (P13) inverted report crea
*     WRITE ' ' '=' MA-INV-TIME
*     MAO-INV-TIME := MA-INV-TIME
*   END-IF
*   IF MAO-STATUS NE MA-STATUS      /* (A1) mail status(not in u
*     WRITE ' ' '=' MA-STATUS
*     MAO-STATUS := MA-STATUS
*   END-IF
*   IF MAO-FROM(*) NE MA-FROM(*)    /* (P3/1:10)
*     WRITE ' ' '=' MA-FROM(*)
*     MAO-FROM(*) := MA-FROM(*)
*   END-IF
*   IF MAO-TO(*) NE MA-TO(*)        /* (P3/1:10)
*     WRITE ' ' '=' MA-TO(*)
*     MAO-TO(*) := MA-TO(*)
*   END-IF
*   IF MAO-HEADLINES NE MA-HEADLINES /* (N3)
*     WRITE ' ' '=' MA-HEADLINES
*     MAO-HEADLINES := MA-HEADLINES
*   END-IF
*   IF MAO-CURRENT-LOCATION NE MA-CURRENT-LOCATION /* (A1)
*     WRITE ' ' '=' MA-CURRENT-LOCATION
*     MAO-CURRENT-LOCATION := MA-CURRENT-LOCATION
*   END-IF
*   IF MAO-PROCESS-TIME NE MA-PROCESS-TIME /* (P13)
*     WRITE ' ' '=' MA-PROCESS-TIME
*     MAO-PROCESS-TIME := MA-PROCESS-TIME
*   END-IF
*   IF MAO-PROCESS-TIME-INV NE MA-PROCESS-TIME-INV /* (P13)
*     WRITE ' ' '=' MA-PROCESS-TIME-INV
*     MAO-PROCESS-TIME-INV := MA-PROCESS-TIME-INV
*   END-IF
*   IF MAO-OBJECT-TYPE NE MA-OBJECT-TYPE /* (A10)
*     WRITE ' ' '=' MA-OBJECT-TYPE
*     MAO-OBJECT-TYPE := MA-OBJECT-TYPE
*   END-IF
*   IF MAO-OBJECT-TIME NE MA-OBJECT-TIME  /* (T)
*     WRITE ' ' '=' MA-OBJECT-TIME
*     MAO-OBJECT-TIME := MA-OBJECT-TIME
*   END-IF

  IF #DELETE = 'Y' DELETE END-IF
END-READ
END TRANSACTION
*
*
WRITE / 'REPORT-CONTENS'
READ RC1 BY AC-REP-RNB-SEQ
  WRITE AC-REPNAME AC-REPRNB AC-SEQNO AC-INSERTED-LINE(1) (AL=35)
  IF #DELETE = 'Y' DELETE END-IF
END-READ
END TRANSACTION
*
*
WRITE / 'FILED-SYSOUTS'
READ FS1 BY FS1.F-REPNAME-RNB-SEQ
  WRITE F-REPNAME F-REPRNB F-SEQ F-TEXT(1) (AL=35)
  IF #DELETE = 'Y' DELETE END-IF
END-READ
END TRANSACTION
END
