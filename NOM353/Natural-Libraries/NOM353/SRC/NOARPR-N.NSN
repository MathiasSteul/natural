* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* NOARPR-N - NOM API Print Active Report or Active Bundle
*
* Maintenance:
* XSETGGR 2002-07-29   create
* XSETGGR 2002-11-09   send printout data when printing
* XSETGGR 2002-11-14   add new field ES-APP-SERVER-LIBRARY
* XSETGGR 2002-12-18   changes
* XSETGGR 2002-12-20   changes
* sju 03-01-31 p(231843) mail wrong if run number wraps round
* XSETGGR 2003-03-04   p(222810)-only open bundles can be updated
* sju 03-10-07 p(245720) NAT1305 if more than 99,999,999 lines in bundle
* HH      20040825   FORMATTING T CHANGED;                /* HH 040825
* fhi     2005-04-21 NOM3107  Support 7-byte job numbers
* xsetggr 2005-05-10 nom3107  change length of noporo field
* xsetggr 2005-05-17          change #noporo to #noporo1
* fhi     2005-12-14 P272732  cataloged, because VPRINT-L was changed.
* xsetggr 2007-05-03 NOM3201  support 11 bytes run numbers
* xsetggr 2007-05-09 P(294774) change date/time format in lists
* xsetggr 2007-06-27 NOM3201   support 5 byte node and P11 format run
*                              numbers, restow - changes in eompom-parms
* fhi     2007-07-12 NOM3202   C-NATERR changed, NAD23006 is obsolete.
* xsetggr 2007-09-20 p(296832) add 'Cretaed Date/Time' to printout list
* XSETHZ  2007-10-20 NEW INTERFACE FOR LISTS
* xsetggr 2007-10-25 NRT2185   default values for UNIXLP printers
* xsetggr 2007-11-30 NRT2771   Start/stop physical-printers
* xsetggr 2008-03-04 NRT2768   fill bytes of pda for actualisation
* xsetggr 2008-03-11 p(302778) change format of RBINSZ-N parms
* xsetggr 2008-05-05 p(304350) restow due to changes of RMSPL--L
* xsetggr 2008-07-09 p(292935) do not fidplay printed time if error
* XSETHZ  2008-07-23 p(307577) use full name of ES-APP-SERVER-LIBRARY
* fhi     2008-07-24 P307319   restow due to changes in DDM NRM-BUNDLE-CONTENTS
* xsetggr 2008-11-28 P311915   default printers DEFAULTA - DEFAULTZ
* fhi     2009-05-19 N3463     Extend metadata for OPO
* XSETHZ  2009-09-22 P320664   Missing field: Hold Printout, Copies
* fhi     2010-09-03 NOMALL-97 Extend message line
* fhi     2010-10-08 NOMALL-97 Use dynamic memory handling
* xsetggr 2010-11-15 NOMALL-865 restow due to changes in EOMPHTYE
* xsetggr 2012-01-12 NOMALL-1020 write language independant msgs to log
* xsetggr 2012-02-02 NOMALL-1096 restow due changes in NOMWK--P
* xsetggr 2012-03-11 NOMALL-1099 use interface to call RLOG from NGC
* SU1     2013-01-31 unused      Deactivate unused data areas
* SU2     2014-06-30 NOMALL-1279 fill fields for Adabas Vista
* SU3     2014-11-17 NOMALL-1450 fill fields for Adabas Vista
* fhi     2015-05-18 NOMALL-1552 Show real size, not base64 size
* SU4     2015-06-01 NOMALL-1552 Show size 1 (instead 0)
* SU5     2016-01-15 NOMALL-1802 do not update Adabas Vista fields
* fhi     2016-11-10 NOMALL-1917 use correct node number
* fhi     2016-11-15 NOMALL-1961 Use new task IDs
* fhi     2017-04-07 NOMALL-1961 Omit field PO-MONITOR
* SU6     2020-11-10 NOMALL-2440 split DDM -> NRM-MF-NODES
* ----------------------------------------------------------------------
DEFINE DATA
PARAMETER USING ESMCNT-A
PARAMETER USING ESMINP-A
************************************************************************
INDEPENDENT
1 +NOD-LOCAL-NODE      (N5)
* *****
LOCAL USING NADA2000
LOCAL USING NAD-MSG
LOCAL USING NAD-FLD
LOCAL USING VUSERS-L
LOCAL USING VABUND-L
LOCAL USING VMAILR-L
LOCAL USING VPRINT-L
LOCAL USING EOMPOM-P
LOCAL USING RMSPL--L
LOCAL USING RMSPLA-L
LOCAL USING NOMWK--P
LOCAL USING RMTASK-E
LOCAL USING NOPORO1A
LOCAL USING EOMPOL-P
LOCAL USING RTXT---L
LOCAL USING NOMODE-A
LOCAL USING RLOG-L
LOCAL USING ESMCONSL
LOCAL USING EOMPHTYE
*
LOCAL
1 AR VIEW NRM-ACTIVE-REPORTS
  2 AR-USERID
  2 AR-REPNAME
  2 AR-PRINTERS   (1:20)
  2 C*AR-PRINTERS
  2 AR-NUMBER-OF-LINES
  2 AR-SPOOL-ATTRIBUTES
  2 AR-SPOOL-ATTR-EXTENDED (3)
  2 AR-CC-TYPE
1 REPORTS VIEW OF NRM-REPORTS-NEW
  2 C*R-PRINTERS
  2 R-PRINTERS     (20)
  2 C*R-PRINT-JOBCARD
  2 R-PRINT-JOBCARD (3)
1 REPORT-DISTR VIEW OF NRM-REP-TARGET
  2 RD-TARGET-ID
  2 C*RD-LAYOUT
  2 RD-LAYOUT (1:10)
    3 RD-FROM
    3 RD-TO
  2 RD-HEADLINES
1 BUNDLES VIEW OF NRM-BUNDLES
  2 C*B-PRINT-JOBCARD
  2 B-PRINT-JOBCARD (3)
1 PHYS-PR VIEW OF NRM-PHYSICAL-PRINTERS
  2 PH-VTAMID
  2 PH-ESCAPE-CHAR
  2 PH-JCL-SKELETON
  2 PH-PRINT-PGM
  2 PH-PRINTER-TYPE
  2 PH-STATUS
1 DEFAULT-PRINTERS VIEW OF NRM-PRINTERS
  2 P-ID
  2 P-ATTRIBUTES(1:25)
1 MONITOR VIEW OF NRM-MONITOR
  2 M-USE-OWNER
1 PO VIEW OF NRM-PRINTOUTS
  2 PO-ID
  2 PO-NUMBER-OF-RETRIES
  2 PO-ID-INV
  2 PO-REPRNB
  2 REDEFINE PO-REPRNB
    3 PO-LAST-ID         (P11)
  2 PO-SCHEDULED
  2 PO-PRINTED
  2 PO-COPIES
  2 PO-NODE
  2 PO-CREATED
  2 PO-ESCAPE-CHAR
  2 PO-EXITLIB
  2 PO-EXITMEM
  2 PO-FROM-LINE
  2 PO-TO-LINE
  2 PO-STATUS
  2 PO-HOLD
  2 PO-JCL-SKELETON
  2 PO-LANGUAGE
  2 PO-LOGICAL
  2 PO-PHYSICAL-NAME
  2 PO-PRINT-PGM
  2 PO-PRINTER-TYPE
  2 PO-PRIORITY
  2 PO-USERID
  2 PO-BUNDLE
  2 PO-BUNDRNB
  2 PO-REPNAME
  2 PO-HEADLINES
  2 PO-LAYOUT          (1:10)
    3 PO-LAYOUT-FROM
    3 PO-LAYOUT-TO
  2 PO-JOBCARD         (1:3)
  2 PO-ESY-USERID
  2 PO-ATTRIBUTES      (1:25)
  2 REDEFINE PO-ATTRIBUTES
    3 PO-ATTR          (1:25)
      4 PO-ATTR-IDENT  (I1)
      4 PO-ATTR-LENGTH (N2)
      4 PO-ATTR-PROMPT (N4)
      4 PO-ATTR-VAR    (A16)
      4 PO-ATTR-VALUE  (A72)
  2 PO-OBJECT-TYPE
  2 PO-OBJECT-TIME
1 BC VIEW OF NRM-BUNDLE-CONTENTS
  2 BC-BUNDLE
  2 BC-REPNAME
  2 BC-REPRNB
  2 BC-BUNDRNB
1 #TT                  (T)
1 #DATE-A8             (A8)
1 #NOP                 (P2)
1 #ES-MSG-PREF         (A7) INIT <'NOM'>
1 REDEFINE #ES-MSG-PREF
  2 #ES-MSG-NOM        (A3)
  2 #ES-MSG-NR         (N4)
  2 REDEFINE #ES-MSG-NR
    3 #ES-MSG-NR-A     (A4)
1 #AR-REPORT-RNB       (A31)
1 REDEFINE #AR-REPORT-RNB
  2 #AR-REPNAME        (A25)
  2 #AR-REPRNB         (P11)
1 #AB-BUNDLE-RNB       (A31)
1 REDEFINE #AB-BUNDLE-RNB
  2 #AB-BUNDLE         (A25)
  2 #AB-RNB            (P11)
1  #MA-RNB-USER        (A14)
1 REDEFINE  #MA-RNB-USER
  2 #MA-RNB            (P11)
  2 #MA-USER           (A8)
1 #LOGICAL-PRINTER     (A8)
1 #HOLD                (A1)
1 #I                   (I2)
1 #K                   (P3)
1 #L                   (P3)
1 #HEADER-LINES        (N3)
1 #COPIES-A            (A3)
1 #COPIES              (N3)
1 #VAR                 (A16)
1 #VALUE               (A72)
1 #USER-IN             (L)
1 #LAYOUT-TAB          (A251)
1 REDEFINE #LAYOUT-TAB
  2 #LAYOUT-TAB-V      (A1/251)
1 #LAYOUT
  2 #LAYOUT-F          (P3/10)
  2 #LAYOUT-T          (P3/10)
  2 #LAYOUT-S          (P3/10)
  2 #LAYOUT-N          (P3)
  2 CV-LAYOUT          (C/10)
1 #CONTROL-KEY         (N7) CONST <9999999>
1 #MAX-KEY             (N7) CONST <9999998>
1 #MAX-POID            (N7)
1 #PO-ID               (N7)
1 #LIBRARY-ID          (A8)
1 #TO-COL              (P3)
1 #BUNDLE-RNB-SEQ      (A33)
1 REDEFINE #BUNDLE-RNB-SEQ
  2 #BUNDLE            (A25)
  2 #RNB               (P11)
  2 #SEQ               (P3)
1 #BUNDLE-RNB-SEQ-E    (A33)
1 #GR-USER             (A8)
1 #GRANTS              (A1/6)
1 #AB-CLOSE            (A1)
1 #DATE-IN             (D)
1 #DATE-OUT            (D)
1 #DATE                (D)
1 #MA-REP-RNB            (A31)
1 REDEFINE #MA-REP-RNB
  2 #MA-REP              (A25)
  2 #MA-REPRNB           (P11)
1 #P-ID-E                (A8)
1 #P-ID                  (A8) INIT <'DEFAULT'>
1 REDEFINE #P-ID
  2 #P-ID-1              (A7)
  2 #SUFFIX              (A1)
1 #BIN                   (L)
1 #ERC                   (N4)
1 #ERT                   (A250)
1 #BIN-SIZE              (I4)
1 #OBJECT-RNB            (P11)
1 #RECNUM                (I4)
1 #A4                    (A4)
1 REDEFINE #A4
  2 #I4                  (I4)
1 #USER-LIB              (A8)
1 #MONITOR-ID            (A20)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET #ES-MSG-NR #TT #DATE
#LIBRARY-ID := ES-APP-SERVER-LIBRARY
COMPRESS ES-APP-SERVER-LIBRARY 'U' TO #USER-LIB LEAVING NO
NOMOD-PARMS := ES-SELECT
RESET ES-SELECT
SEPARATE ES-KEY-PARM(ES-KEY-PARM-COUNT + 1)
  INTO #LOGICAL-PRINTER #AB-CLOSE #HOLD #COPIES-A IGNORE
  WITH DELIMITER C-PARM-DELIMITER
IF #COPIES-A IS (N3)
  #COPIES := VAL(#COPIES-A)
ELSE
  #COPIES := 0
END-IF
DECIDE ON FIRST VALUE ES-ORIG-OBJECT
  VALUE 'AR','BC'
    #AR-REPNAME := ES-KEY-PARM(ES-KEY-PARM-COUNT - 1)
    #AR-REPRNB  := VAL(ES-KEY-PARM(ES-KEY-PARM-COUNT))
    FNDAR. FIND AR WITH AR-REPORT-RNB = #AR-REPORT-RNB
      #SPOOL-ATTRIBUTES         := AR-SPOOL-ATTRIBUTES
      CALLNAT 'RMSPL7-N' #SPOOL-ATTRIBUTES #SPOOL-TYPE
      PERFORM XXMVAR-S-MOVE-ARRAY #SPOOL-ATTRIBUTES-EXT
        AR-SPOOL-ATTR-EXTENDED (1:3)
/* get layout
      FIND REPORT-DISTR WITH  RD-REPNAME = AR.AR-REPNAME
        IF RD-TARGET-ID = ES-USER
          FOR #K 1 TO REPORT-DISTR.C*RD-LAYOUT
            #TO-COL := REPORT-DISTR.RD-TO(#K)
            IF #TO-COL > 0
              #USER-IN := TRUE
              ESCAPE BOTTOM
            END-IF
          END-FOR
          ESCAPE BOTTOM
        END-IF
      END-FIND
      IF NOT #USER-IN
        RESET #LAYOUT
        #MA-RNB := #AR-REPRNB
        #MA-USER := ES-USER
        #MA-REP:= #AR-REPNAME
        #MA-REPRNB:= #AR-REPRNB
        FIND MAIL-REPORTS WITH MA-RNB-USER = #MA-RNB-USER
            AND  MA-REP-RNB  = #MA-REP-RNB WHERE C*MA-LAYOUT > 0
          #LAYOUT-N     := C*MA-LAYOUT
          #HEADER-LINES := MA-HEADLINES
          FOR #L 1 TO #LAYOUT-N
            #LAYOUT-F(#L) := MA-FROM(#L)
            #LAYOUT-T(#L) := MA-TO(#L)
            FOR #K MA-FROM(#L) TO MA-TO(#L)
              #LAYOUT-TAB-V(#K) := 'X'
            END-FOR
            #LAYOUT-S(#L) := #L
          END-FOR
          ESCAPE BOTTOM
        END-FIND
      ELSE
        MOVE (AD=P) TO CV-LAYOUT(*)
        #LAYOUT-N := REPORT-DISTR.C*RD-LAYOUT
        #HEADER-LINES := REPORT-DISTR.RD-HEADLINES
        FOR #L 1 TO #LAYOUT-N
          #LAYOUT-F(#L) := REPORT-DISTR.RD-FROM(#L)
          #LAYOUT-T(#L) := REPORT-DISTR.RD-TO(#L)
          #LAYOUT-S(#L) := #L
        END-FOR
      END-IF
    END-FIND
    FNDR. FIND REPORTS WITH R-REPNAME = #AR-REPNAME
      IF NO RECORDS FOUND
        #NOP := AR.C*AR-PRINTERS
        R-PRINTERS (1:20) := AR.AR-PRINTERS (1:20)
        ESCAPE BOTTOM (FNDR.)
      END-NOREC
      #NOP := C*R-PRINTERS
    END-FIND
    IF #LOGICAL-PRINTER = ' ' AND NOMOD-PRINTER NE ' '
      FNDPP. FIND NUMBER PRINTERS WITH P-ID = NOMOD-PRINTER
      IF *NUMBER(FNDPP.) NE 0
        #HOLD    := ' '
        #LOGICAL-PRINTER := NOMOD-PRINTER   /* PROF-PRINTER
      END-IF
    END-IF
    IF #COPIES = 0
      #VAR := 'COPIES'
      CALLNAT 'RPRTATTN' #SPOOL-ATTRIBUTES #SPOOL-ATTRIBUTES-EXT
        #VAR #VALUE AR-CC-TYPE
      IF #VALUE NE ' '
        #COPIES := VAL (#VALUE)
      END-IF
    END-IF
    IF #LOGICAL-PRINTER = ' '
      #ES-MSG-NR := 0428    /* report not queued for printing
      ES-RC := 1
      PERFORM GET-MSG-TXT
    ELSE
      PERFORM CREATE-PRINTOUT-RECORD
      IF PO.PO-SCHEDULED NE 0 AND PO.PO-SCHEDULED <= *TIMX
        PERFORM WAKE-MONITOR
      END-IF
      #ES-MSG-NR := 0427 /* report queued for printing successfully
      PERFORM GET-MSG-TXT
      ES-RC := 2
      ESCAPE ROUTINE
    END-IF
**-------------------------------------------------------------------
  VALUE 'AB'
    IF #LOGICAL-PRINTER = ' '
      #ES-MSG-NR := 29
      ES-RC := 1
      PERFORM GET-MSG-TXT
      ESCAPE ROUTINE
    END-IF
    #AB-BUNDLE := ES-KEY-PARM(ES-KEY-PARM-COUNT - 1)
    #AB-RNB  := VAL(ES-KEY-PARM(ES-KEY-PARM-COUNT))
    FNDAB. FIND ACTIVE-BUNDLES WITH AB-BUNDLE-RNB = #AB-BUNDLE-RNB
      IF AB-STATUS = 'O' AND #AB-CLOSE ='Y'
        GETCL. GET ACTIVE-BUNDLES *ISN(FNDAB.)
        RESET ACTIVE-BUNDLES.AB-EXPIRATION
        IF ACTIVE-BUNDLES.AB-RETENTION-PERIOD NE ' '
          #DATE-IN := *DATX
          CALLNAT 'RCOMED-N' #DATE-IN ACTIVE-BUNDLES.AB-RETENTION-PERIOD
            #DATE-OUT
          IF #DATE-OUT NE #DATE
            MOVE EDITED #DATE-OUT (EM=YYYYMMDD) TO #DATE-A8
            COMPRESS 'P' #DATE-A8 INTO
              ACTIVE-BUNDLES.AB-EXPIRATION LEAVING NO
          END-IF
        END-IF
        MOVE 'C' TO ACTIVE-BUNDLES.AB-STATUS
        MOVE *TIMX TO ACTIVE-BUNDLES.AB-FLUSH-TIME
        UPDATE(GETCL.)
        IF NOMOD-LOG-TYPES (*) = 'B'
          LG-USERID  := ES-USER
          LG-CODE    := 'AB'
          LG-BUNDLE  := #AB-BUNDLE
          LG-BUNDRNB := #AB-RNB
          COMPRESS #AB-BUNDLE '-' #AB-RNB INTO LG-OBJECT-NAME LEAVING NO
          COMPRESS '2108' LG-OBJECT-NAME TO LG-MSG
          CALLNAT 'NOLG---N' PL-PARMS #USER-LIB
        END-IF
        PERFORM SEND-AB
      END-IF
      #NOP := C*AB-PRINT-LIST
      FIND (1) BUNDLES WITH B-BUNDLE = AB-BUNDLE
      END-FIND
    END-FIND
    PERFORM CREATE-PRINTOUT-RECORD
    PERFORM WAKE-MONITOR
    END TRANSACTION
    #ES-MSG-NR := 0425   /* bundle queued for printing successfully
    PERFORM GET-MSG-TXT
    ES-RC := 2
  NONE VALUE IGNORE
END-DECIDE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE CREATE-PRINTOUT-RECORD
************************************************************************
RESET PO #BIN #OBJECT-RNB
FIND PRINTERS WITH P-ID = #LOGICAL-PRINTER
  FIND (1) PHYS-PR WITH PH-VTAMID = P-PHYSICAL-NAME
  END-FIND
  PERFORM GET-PO-ID
  PO.PO-ID := #PO-ID
  PO.PO-ID-INV  := 9999998 - PO.PO-ID
  IF #COPIES = 0
    PO-COPIES := 1
  ELSE
    PO-COPIES := #COPIES
  END-IF
  PO-CREATED           := *TIMX
  PO-ESCAPE-CHAR       := PH-ESCAPE-CHAR
  PO-EXITLIB           := P-EXITLIB
  PO-EXITMEM           := P-EXITMEM
  PO-FROM-LINE         := 1
  IF PHYS-PR.PH-STATUS = 'S'
    PO-STATUS := 'S'
  ELSE
    IF #HOLD = 'Y'
      PO-STATUS          := 'H'
    ELSE
      PO-STATUS          := 'R'
    END-IF
  END-IF
  PO-HOLD := #HOLD
  PO-JCL-SKELETON      := PH-JCL-SKELETON
  PO-LANGUAGE          := ES-LANGUAGE
  PO-LOGICAL           := P-ID
  PO-PHYSICAL-NAME     := P-PHYSICAL-NAME
  PO-PRINT-PGM         := PH-PRINT-PGM
  PO-PRINTER-TYPE      := PH-PRINTER-TYPE
  PO-PRIORITY          := P-PRIORITY
  IF PO-STATUS = 'R'
    EOMPOM-PHYSICAL-NAME := PO-PHYSICAL-NAME
    CALLNAT 'EOMPOTWN' EOMPOM-PARMS
    PO-SCHEDULED := EOMPOM-SCHEDULED
  END-IF
  PO-USERID           := ES-USER
  PERFORM ASSIGN-PO-ESY-USERID   /* assign po-node too
  DECIDE ON FIRST VALUE OF ES-ORIG-OBJECT
    VALUE 'AR','BC'
      RESET PO-BUNDLE PO-BUNDRNB
      PO-REPNAME   := #AR-REPNAME
      PO-REPRNB    := #AR-REPRNB
      PO-TO-LINE   := AR.AR-NUMBER-OF-LINES
      PO-HEADLINES := #HEADER-LINES
      RESET  PO-LAYOUT(*)
      FOR #I 1 TO #LAYOUT-N
        PO-LAYOUT-FROM (#I) := #LAYOUT-F (#I)
        PO-LAYOUT-TO   (#I) := #LAYOUT-T (#I)
      END-FOR
/* assign po-attributes
      FOR #I 1 25
        IF PRINTERS.P-ATTR-VALUE (#I) = ' '
          CALLNAT 'RPRTATTN' #SPOOL-ATTRIBUTES #SPOOL-ATTRIBUTES-EXT
            P-ATTR-VAR (#I) P-ATTR-VALUE (#I) AR.AR-CC-TYPE
        END-IF
        IF PH-PRINTER-TYPE = ##PHYS-UNIXLP AND P-ATTR-VALUE (#I) = ' '
          PERFORM DEFAULT-UNIXLP-VALUES
        ELSE
          PO-ATTR-IDENT (#I) := P-ATTR-IDENT(#I)
          PO-ATTR-LENGTH(#I) := P-ATTR-LENGTH(#I)
          PO-ATTR-PROMPT(#I) := P-ATTR-PROMPT(#I)
          PO-ATTR-VAR(#I)    := P-ATTR-VAR(#I)
          PO-ATTR-VALUE(#I)  := P-ATTR-VALUE(#I)
        END-IF
      END-FOR
/* assign po-jobcard
      IF REPORTS.C*R-PRINT-JOBCARD NE 0
        PO-JOBCARD(*) := REPORTS.R-PRINT-JOBCARD(*)
      ELSE
        PO-JOBCARD(*) := P-JOBCARD(*)
      END-IF
      #VAR := 'JOBNAME'
      CALLNAT 'RPRTATTN' #SPOOL-ATTRIBUTES #SPOOL-ATTRIBUTES-EXT
        #VAR #VALUE AR-CC-TYPE
      COMPRESS PH-ESCAPE-CHAR 'JOBNAME' TO #VAR LEAVING NO
      EXAMINE PO-JOBCARD (1) FOR #VAR REPLACE #VALUE
      #VAR := 'ACCOUNT-NUMBER'
      CALLNAT 'RPRTATTN' #SPOOL-ATTRIBUTES #SPOOL-ATTRIBUTES-EXT
        #VAR #VALUE AR-CC-TYPE
      COMPRESS PH-ESCAPE-CHAR 'ACCOUNT' TO #VAR LEAVING NO
      EXAMINE PO-JOBCARD (1) FOR #VAR REPLACE #VALUE
      #NOPORO1.#TYPE   := 'R'
      #NOPORO1.#OBJECT := PO-REPNAME
      EOMPOL-REPORT   := PO-REPNAME
      EOMPOL-RNB      := PO-REPRNB
      #OBJECT-RNB     := PO-REPRNB
    VALUE 'AB'
      RESET PO-REPNAME PO-REPRNB
      PO-BUNDLE   := #AB-BUNDLE
      PO-BUNDRNB  := #AB-RNB
      #OBJECT-RNB := PO-BUNDRNB
      IF ACTIVE-BUNDLES.AB-NUMBER-OF-LINES GT 99999999
        PO-TO-LINE:= 99999999
      ELSE
        PO-TO-LINE := ACTIVE-BUNDLES.AB-NUMBER-OF-LINES
      END-IF
      PO-ATTRIBUTES(*) := P-ATTRIBUTES(*)
      IF ACTIVE-BUNDLES.AB-PRINT-JOBCARD(*) NE ' '
        PO-JOBCARD(*) := ACTIVE-BUNDLES.AB-PRINT-JOBCARD(*)
      ELSE
        IF C*BUNDLES.B-PRINT-JOBCARD NE 0
          PO-JOBCARD(*) := BUNDLES.B-PRINT-JOBCARD(*)
        ELSE
          PO-JOBCARD(*) := P-JOBCARD(*)
        END-IF
      END-IF
      #NOPORO1.#TYPE := 'B'
      #NOPORO1.#OBJECT := PO-BUNDLE
      EOMPOL-REPORT   := PO-BUNDLE
      EOMPOL-RNB      := PO-BUNDRNB
    NONE VALUE IGNORE
  END-DECIDE
  PO-OBJECT-TYPE := 'PO'
  PO-OBJECT-TIME := *TIMX
  STORE PO
  END TRANSACTION
  #NOPORO1.#ID       := PO-ID
  #NOPORO1.#PRINTER  := PO-LOGICAL
  EOMPOL-FROM-LINE  := PO-FROM-LINE
  EOMPOL-TO-LINE   := PO-TO-LINE
  PERFORM CHECK-BINARY-FILES
  IF #BIN
    PERFORM GET-BINARY-SIZE
    #NOPORO1.#BYTES := #BIN-SIZE
    RESET #NOPORO1.#LINES
  ELSE
    RESET #NOPORO1.#BYTES
    CALLNAT 'EOMPOL-N' EOMPOL-PARMS
    #NOPORO1.#LINES := EOMPOL-TOTAL-LINES
  END-IF
  #NOPORO1.#USERID := PO-USERID
  IF PO-CREATED NE #TT
    MOVE EDITED PO-CREATED (EM=YYYYMMDDHHII) TO #NOPORO1.#CREATED-TIME
  END-IF
  IF PO-SCHEDULED NE #TT
    MOVE EDITED PO-SCHEDULED (EM=YYYYMMDDHHII) TO
      #NOPORO1.#SCHEDULED-TIME
  END-IF
  IF PO-PRINTED NE #TT
    IF PO-STATUS NE 'E'
      MOVE EDITED PO-PRINTED (EM=YYYYMMDDHHII) TO #NOPORO1.#PRINTED-TIME
    ELSE
      RESET #NOPORO1.#PRINTED-TIME
    END-IF
  END-IF
  IF PO-STATUS = 'H'
    #ES-MSG-NR := ##TXT-HOLD
    #NOPORO1.#OPTIONS(1) := 'HL'
  ELSE
    #ES-MSG-NR := ##TXT-READY-TO-PRINT
    #NOPORO1.#OPTIONS(1) := 'RL'
  END-IF
  PERFORM GET-MSG-TXT
  #NOPORO1.#STATUS  := ES-MSG-TXT
  RESET ES-RC ES-MSG-NR ES-MSG-TXT
  #NOPORO1.#OPTIONS(2) := 'RE'
  IF #NOPORO1.#TYPE = 'R'
    #NOPORO1.#OPTIONS(3) := 'LB'
  ELSE
    #NOPORO1.#OPTIONS(3) := 'BB'
  END-IF
  IF #BIN AND #BIN-SIZE = 0
    #NOPORO1.#OPTIONS(4) := 'BB'
  END-IF
  ES-SELECT := #NOPORO1
END-FIND
*
END-SUBROUTINE /* CREATE-PRINTOUT-RECORD
*
************************************************************************
DEFINE SUBROUTINE DEFAULT-UNIXLP-VALUES
************************************************************************
#SUFFIX := 'Z'
#P-ID-E := #P-ID
#SUFFIX := 'A'
FIND DEFAULT-PRINTERS WITH
    P-PHYSICAL-NAME = PH-VTAMID
    WHERE P-ID = #P-ID THRU #P-ID-E
  PO.PO-ATTRIBUTES(#I) := DEFAULT-PRINTERS.P-ATTRIBUTES(#I)
END-FIND
*
END-SUBROUTINE /* DEFAULT-UNIXLP-VALUES
*
************************************************************************
DEFINE SUBROUTINE GET-PO-ID
************************************************************************
FNDPO. FIND (1) PO WITH PO-ID = #CONTROL-KEY
  IF NO RECORDS FOUND
    READ (1) PO BY PO-ID-INV
      #MAX-POID := PO-ID
      IF PO-ID NE PO-ID
        UPDATE
      END-IF
    END-READ
    PO-ID := #CONTROL-KEY
    RESET  PO-ID-INV
    PO-LAST-ID := #MAX-POID
  END-NOREC
  ADD 1 TO PO-LAST-ID
  IF PO-LAST-ID GE #MAX-KEY
    PO-LAST-ID := 1
  END-IF
  #PO-ID := PO-LAST-ID
  IF *NUMBER (FNDPO.) = 0
    PO-OBJECT-TYPE := 'PO'
    PO-OBJECT-TIME := *TIMX
    STORE PO
  ELSE
    UPDATE
  END-IF
END-FIND
*
END-SUBROUTINE /* GET-PO-ID
*
************************************************************************
DEFINE SUBROUTINE ASSIGN-PO-ESY-USERID
************************************************************************
PO-NODE := +NOD-LOCAL-NODE /*SU6
IF USERS.PROF-EXTERNAL = 'Y'
  PO-ESY-USERID := ES-USER
  ESCAPE ROUTINE
END-IF
#MONITOR-ID := F#MONITOR-TASK-ID1 (<>)
FIND MONITOR WITH M-MONITOR-ID = #MONITOR-ID
  IF M-USE-OWNER = 'Y'
    DECIDE ON FIRST VALUE OF ES-ORIG-OBJECT
      VALUE 'AR','BC'
        PO-ESY-USERID := AR-USERID
      VALUE 'AB'
        PO-ESY-USERID := ACTIVE-BUNDLES.AB-COORDINATOR-ID
      NONE IGNORE
    END-DECIDE
  ELSE
    RESET  PO-ESY-USERID
  END-IF
END-FIND
/*SU6 RESET PO-NODE
/*SU6 FIND MF-NODE WITH MF-MONITOR-ID = +NOD-LOCAL-ID /*SU6
/*SU6  PO-NODE := MF-MONITOR-NODE
/*SU6 END-FIND
*
END-SUBROUTINE /* ASSIGN-PO-ESY-USERID
*
************************************************************************
DEFINE SUBROUTINE WAKE-MONITOR
************************************************************************
RESET NOMWK-PARMS(*)
NOMWK-TASK-TYPE:= EQU-MANAGE-PRINTOUTS
CALLNAT 'NOMWK01N' NOMWK-NOMVERS NOMWK-PARMS (*)
IF NOMWK-ERROR-CODE NE 0
  #ES-MSG-NR := NOMWK-ERROR-CODE
  PERFORM GET-MSG-TXT
  BACKOUT TRANSACTION
  ESCAPE ROUTINE
END-IF
*
END-SUBROUTINE /* WAKE-MONITOR
*
************************************************************************
DEFINE SUBROUTINE GET-BINARY-SIZE
************************************************************************
RESET #BIN-SIZE #ERC #ERT #RECNUM
IF #NOPORO1.#TYPE = 'B'
  CALLNAT 'RBINSZ-N' #NOPORO1.#OBJECT #OBJECT-RNB #NOPORO1.#TYPE #RECNUM
    #BIN-SIZE #ERC #ERT
  IF #ES-MSG-NR = 0 AND #BIN-SIZE NE 0
    #BIN-SIZE := #BIN-SIZE / 1024 + 1
  END-IF
ELSE
  IF #SPOOL-DI-SIZE NE #I4
    #BIN-SIZE := (#SPOOL-DI-SIZE / 1024) * 3 / 4 + 1
  END-IF
END-IF
*
END-SUBROUTINE /* GET-BINARY-SIZE
*
************************************************************************
DEFINE SUBROUTINE CHECK-BINARY-FILES
************************************************************************
RESET #AR-REPORT-RNB #BUNDLE-RNB-SEQ #SPOOL-ATTRIBUTES
IF PO-BUNDLE = ' '
  #AR-REPORT-RNB.#AR-REPNAME := PO-REPNAME
  #AR-REPORT-RNB.#AR-REPRNB  := PO-REPRNB
  FIND AR WITH AR-REPORT-RNB = #AR-REPORT-RNB
    IF AR-CC-TYPE = 0005                /* binary
      #BIN := TRUE
      #SPOOL-ATTRIBUTES := AR-SPOOL-ATTRIBUTES
    END-IF
  END-FIND
ELSE
  #BUNDLE-RNB-SEQ.#BUNDLE  := PO-BUNDLE
  #BUNDLE-RNB-SEQ.#RNB := PO-BUNDRNB
  #BUNDLE-RNB-SEQ.#SEQ := 0
  RDBC. READ BC WITH BC-BUNDLE-RNB = #BUNDLE-RNB-SEQ
    IF BC-BUNDLE NE #BUNDLE OR BC-BUNDRNB NE #RNB
      ESCAPE BOTTOM(RDBC.)
    END-IF
    #AR-REPORT-RNB.#AR-REPNAME := BC-REPNAME
    #AR-REPORT-RNB.#AR-REPRNB  := BC-REPRNB
    FIND AR WITH AR-REPORT-RNB = #AR-REPORT-RNB
      IF AR-CC-TYPE NE 0005     /* binary
        RESET #BIN
      ELSE
        #BIN := TRUE
        ESCAPE BOTTOM(RDBC.)
      END-IF
    END-FIND
  END-READ
END-IF
*
END-SUBROUTINE /* CHECK-BINARY-FILES
*
************************************************************************
DEFINE SUBROUTINE GET-MSG-TXT
************************************************************************
RESET SHORT-MSG LONG-MSG(*)
VERSION := 0
NADA2000.OBJECT-KIND    := 'U'
NADA2000.ERROR-NUMBER   := #ES-MSG-NR
NADA2000.OPT-INSERT-DYN := FALSE
NADA2000.OPT-LANGUAGE   := ES-LANGUAGE
NADA2000.LIBRARY        := #LIBRARY-ID
CALLNAT 'NATA2000' NADA2000 NATA2000.EXTENDED-PARMS NAD-MSG NAD-FLD
ES-MSG-NR    := #ES-MSG-NR
ES-MSG-TXT   := SHORT-MSG
EXAMINE ES-MSG-TXT FOR #ES-MSG-PREF DELETE
IF ES-MSG-NR NE 9101
  EXAMINE ES-MSG-TXT FOR ':1:' REPLACE ' '
END-IF
EXAMINE ES-MSG-TXT FOR ':2:' REPLACE ' '
ES-RC := 1
*
END-SUBROUTINE /* GET-MSG-TXT
*
************************************************************************
DEFINE SUBROUTINE SEND-AB
************************************************************************
#NOPORO1.#AB-STATUS := ACTIVE-BUNDLES.AB-STATUS
IF ACTIVE-BUNDLES.AB-FLUSH-TIME NE #TT
  MOVE EDITED ACTIVE-BUNDLES.AB-FLUSH-TIME (EM=YYYYMMDDHHII) TO
    #NOPORO1.#AB-CLOSE-TIME
ELSE
  RESET #NOPORO1.#AB-CLOSE-TIME
END-IF
#BUNDLE-RNB-SEQ.#BUNDLE := AB-BUNDLE
#BUNDLE-RNB-SEQ.#RNB  := AB-BUNDRNB
#BUNDLE-RNB-SEQ.#SEQ    := 999
#BUNDLE-RNB-SEQ-E := #BUNDLE-RNB-SEQ
RESET #SEQ
FBCN. FIND NUMBER BC WITH BC-BUNDLE-RNB = #BUNDLE-RNB-SEQ
  THRU #BUNDLE-RNB-SEQ-E
IF *NUMBER(FBCN.) = 0
  #NOPORO1.#AB-OPTIONS(1) := 'LB'
  #NOPORO1.#AB-OPTIONS(2) := 'SS'
END-IF
#NOPORO1.#AB-OPTIONS(3) := 'CL'
IF ES-USER-TYPE NE 'A'
  CALLNAT 'NOGROU-N' 'B' AB-BUNDLE ES-USER #GR-USER #GRANTS(*)
  IF #GRANTS(1) NE 'Y' AND #GRANTS(3) NE 'Y'
    #NOPORO1.#AB-OPTIONS(4) := 'DL'
  END-IF
END-IF
#NOPORO1.#AB-OPTIONS(5) := 'OP'
ES-SELECT := #NOPORO1
*
END-SUBROUTINE /* SEND-AB
*
END
