* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RBUNRP - List active reports in active bundle
*
* Maintenance
* MB  91-04-09 F(155)    get report in bundle contents list
* mrs 95-05-08 s(222663) avoid sending report to not existing or not
*                        opened bundle
* gw  95-11-01 s(235108) inherit various attributes to bundle contents
* gw  95-11-10 s(224059) report separators for adhoc bundled reports
* gw  96-03-07 s(240724) take bundle-report attributes
* gw  96-09-25 s(254853) correct sequence number for manual bundling
* sju 99-11-29 p(188153) restrict active bundles
* sju 00-05-24 p(191368) revive a report and bundle it
*                        (NOTE: reviving a report to a bundle doesn't
*                        require that the active bundle is already open)
* xsiszha 2000-08-07 (CE7461) Extend Report and Bundle Names
* sju     2005-03-16 NOM31     NAT AM=NOM
* fhi     2005-04-21 NOM3107  Support 7-byte job numbers
* xsetggr 2007-08-30 NOM3201  Chnage run number format to P11 (for maps)
* xsetggr 2008-05-05 p(304350) restow due to changes in RMSPL--L
* fhi     2008-07-24 P307319   restow due to changes in DDM NRM-BUNDLE-CONTENTS
* SU1     2014-11-05 NOMALL-1450 fill fields for Adabas Vista
* SU2     2024-03-07 ES-34613    NOM 3.6 Remove power
* ----------------------------------------------------------------------
DEFINE DATA GLOBAL USING  NRM-GL
LOCAL  USING  SUPER-L
LOCAL  USING  RMSPL--L
LOCAL  USING  RMSR---E
LOCAL  USING  PROF-LOC
LOCAL
1 ACTIVE-REPORTS VIEW OF NRM-ACTIVE-REPORTS
  2 AR-SEPMEM
  2 AR-SPOOL-ATTRIBUTES
1 BUNDLE-CONTENTS VIEW OF NRM-BUNDLE-CONTENTS
  2 BC-BUNDLE
  2 BC-BUNDRNB
  2 BC-REPNAME
  2 BC-REPRNB
  2 BC-SEQNO
  2 BC-GROUP
  2 BC-SEPMEM
  2 BC-FORM
  2 BC-FLASH
  2 BC-CHARS
  2 BC-FCB
  2 BC-REPNO
  2 BC-PAGEDEF
  2 BC-FORMDEF
  2 BC-PRINTER
  2 BC-SEPNO
  2 BC-OBJECT-TYPE /*SU1
  2 BC-OBJECT-TIME /*SU1
1 BUNDLES VIEW OF NRM-BUNDLES
  2 B-BUNDLE
  2 B-FLAG-REPSEP
1 ACTIVE-BUNDLES VIEW OF NRM-ACTIVE-BUNDLES
  2 AB-BUNDLE
  2 AB-BUNDRNB
  2 AB-STATUS
1 BUNDLE-REPORT VIEW OF NRM-BUNDLE-REPORT
  2 BR-GROUP
  2 BR-SEQNO
  2 BR-SEPNO
  2 BR-REPNO
  2 BR-PRINTER
  2 BR-PAGEDEF
  2 BR-FORMDEF
*
1 #BR-BUNDLE-REPORT        (A50)
1 REDEFINE #BR-BUNDLE-REPORT
  2 #BR-BUNDLE             (A25)
  2 #BR-REPORT             (A25)
1 #AB-BUNDLE-STATUS        (A27)
1 REDEFINE #AB-BUNDLE-STATUS
  2 #BUNDLE                (A25)
  2 #STATUS                (A2)
1 #GRANT-TYPE              (A1)
1 #GRANT-OBJECT            (A25)
1 #GRANT-USER              (A8)
1 #GRANTED                 (L)
1 #GRANT-OPTIONS           (A1/1:6)
1 #M-REPORT                (A25)
1 REDEFINE #M-REPORT
  2 #M-REPORT-17           (A17)
  2 #M-REPORT-R            (A8)
1 #M-BUNDLE                (A25)
1 REDEFINE #M-BUNDLE
  2 #M-BUNDLE-8            (A8)
  2 #M-BUNDLE-R            (A17)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE BUNDLE-REPORT
************************************************************************
#AR-REPNAME := G-C-REPORT
#AR-REPRNB := G-C-REPRNB
PROFILE-STRING:= G-USER-PROFILE
*
FIND ACTIVE-REPORTS WITH AR-REPORT-RNB = #AR-REPORT-RNB
  IF NO RECORDS FOUND
    ESCAPE ROUTINE
  END-NOREC
END-FIND
*
IF G-FATHER-PROG NE 'RREVAR'
  #M-REPORT := G-C-REPORT
  #M-BUNDLE := G-C-BUNDLE
  IF NOT G-DISPLAY-LONG-NAMES
    #M-REPORT-R := #M-BUNDLE-R := H'FA'
  END-IF
  SET CONTROL 'WC9L55B08/16F'
  SET CONTROL 'MT'
  INPUT USING MAP 'RBUNRPM&'
*
  IF *PF-KEY = 'PF3'
    SET CONTROL 'WB'
    SET CONTROL 'M21'
    ESCAPE ROUTINE
  END-IF
*
  IF G-DISPLAY-LONG-NAMES
    G-C-BUNDLE := #M-BUNDLE
  ELSE
    G-C-BUNDLE := #M-BUNDLE-8
  END-IF
*
  IF G-C-BUNDLE = ' '
    REINPUT *0405
  END-IF
END-IF
IF G-USER-TYPE NE 'A' AND PROF-RESTRICT-ABUN = 'Y'
  RESET #GRANT-OPTIONS(*) #GRANTED
  #GRANT-TYPE:= 'B'
  #GRANT-OBJECT:= G-C-BUNDLE
  #GRANT-USER:= G-USERID
  CALLNAT 'RGRANT-N' #GRANT-USER #GRANT-TYPE #GRANT-OBJECT #GRANTED
    #GRANT-OPTIONS(1:6)
  IF NOT #GRANTED
    REINPUT *0400
  END-IF
END-IF
*
#AB-BUNDLE := G-C-BUNDLE
RESET #AB-BUNDRNB
#BUNDLE := #AB-BUNDLE
#STATUS := 'O'
REAAB. FIND (1) ACTIVE-BUNDLES WITH AB-BUNDLE-STATUS = #AB-BUNDLE-STATUS
*
  IF NO RECORDS FOUND
    IF G-FATHER-PROG NE 'RREVAR'
      ESCAPE BOTTOM
    END-IF
  END-NOREC
  G-C-BUNDRNB := AB-BUNDRNB
*
  FIND BUNDLE-CONTENTS WITH BC-REPORT-RNB = #AR-REPORT-RNB
    IF BC-BUNDLE = G-C-BUNDLE AND BC-BUNDRNB = G-C-BUNDRNB
      G-NATRP-ERC := 0437
      IF G-FATHER-PROG NE 'RREVAR'
        SET CONTROL 'WB'
        SET CONTROL 'M21'
      END-IF
      ESCAPE ROUTINE
    END-IF
  END-FIND
**
  BUNDLE-CONTENTS.BC-REPNAME := G-C-REPORT
  BUNDLE-CONTENTS.BC-REPRNB := G-C-REPRNB
  BUNDLE-CONTENTS.BC-BUNDLE := G-C-BUNDLE
  #M-BUNDLE := G-C-BUNDLE
  BUNDLE-CONTENTS.BC-GROUP := #M-BUNDLE-8
  IF G-FATHER-PROG NE 'RREVAR'
    BUNDLE-CONTENTS.BC-BUNDRNB := G-C-BUNDRNB
  ELSE
    RESET BUNDLE-CONTENTS.BC-BUNDRNB
  END-IF
  BUNDLE-CONTENTS.BC-SEPMEM := ACTIVE-REPORTS.AR-SEPMEM
  BUNDLE-CONTENTS.BC-SEQNO := 999
  FIND (1) BUNDLES WITH B-BUNDLE = #AB-BUNDLE
    IF NO RECORDS FOUND
      G-NATRP-ERC:= 0408
      ESCAPE ROUTINE
    END-NOREC
    IF B-FLAG-REPSEP = 'Y'
      BC-SEPNO := 1
    END-IF
    #BR-BUNDLE := #AB-BUNDLE
    #BR-REPORT := G-C-REPORT
    FIND (1) BUNDLE-REPORT WITH BR-BUNDLE-REPORT = #BR-BUNDLE-REPORT
      BUNDLE-CONTENTS.BC-GROUP   := BR-GROUP
      IF BR-SEQNO NE 0
        BUNDLE-CONTENTS.BC-SEQNO := BR-SEQNO
      END-IF
      IF B-FLAG-REPSEP = 'Y' AND BR-SEPNO NE 0
        BUNDLE-CONTENTS.BC-SEPNO := BR-SEPNO
      END-IF
      BUNDLE-CONTENTS.BC-REPNO   := BR-REPNO
      BUNDLE-CONTENTS.BC-PRINTER := BR-PRINTER
      BUNDLE-CONTENTS.BC-PAGEDEF := BR-PAGEDEF
      BUNDLE-CONTENTS.BC-FORMDEF := BR-FORMDEF
    END-FIND
  END-FIND
  #SPOOL-ATTRIBUTES := ACTIVE-REPORTS.AR-SPOOL-ATTRIBUTES
  CALLNAT 'RMSPL7-N' #SPOOL-ATTRIBUTES #SPOOL-TYPE
  DECIDE ON FIRST #SPOOL-TYPE
    VALUE JES2, JES3
      BUNDLE-CONTENTS.BC-CHARS := #SPOOL-JES-CHARS
      BUNDLE-CONTENTS.BC-FCB   := #SPOOL-JES-FCB
      BUNDLE-CONTENTS.BC-FORM  := #SPOOL-JES-FORM
      BUNDLE-CONTENTS.BC-FLASH := #SPOOL-JES-FLASH
      IF #SPOOL-JES-PAGEDEF NE ' '
        BUNDLE-CONTENTS.BC-PAGEDEF := #SPOOL-JES-PAGEDEF
      END-IF
      IF #SPOOL-JES-FORMDEF NE ' '
        BUNDLE-CONTENTS.BC-FORMDEF := #SPOOL-JES-FORMDEF
      END-IF
      BUNDLE-CONTENTS.BC-REPNO := #SPOOL-JES-COPIES
/*SU2  VALUE POWER
    VALUE CMASPOOL
      BUNDLE-CONTENTS.BC-REPNO   := #SPOOL-CMA-COPYS
      BUNDLE-CONTENTS.BC-FORM    := #SPOOL-CMA-FORMS
      BUNDLE-CONTENTS.BC-FCB     := #SPOOL-CMA-FCB
      BUNDLE-CONTENTS.BC-PAGEDEF := #SPOOL-CMA-PAGED
      BUNDLE-CONTENTS.BC-FORMDEF := #SPOOL-CMA-FORMD
    VALUE NAF, NAT
      BUNDLE-CONTENTS.BC-REPNO   := #SPOOL-NAF-COPIES
      BUNDLE-CONTENTS.BC-FORM    := #SPOOL-NAF-FORM
    VALUE SEQUENTIAL-FILE-BS2
      BUNDLE-CONTENTS.BC-REPNO   := #SPOOL-BS2-COPIES
      BUNDLE-CONTENTS.BC-FORM    := #SPOOL-BS2-FORM
    NONE VALUE
      IGNORE
  END-DECIDE
  BC-OBJECT-TYPE := 'BC' /*SU1
  BC-OBJECT-TIME := *TIMX /*SU1
  STORE BUNDLE-CONTENTS
  IF G-FATHER-PROG NE 'RREVAR'
    END TRANSACTION
  END-IF
  G-NATRP-ERC := 0438
  SET CONTROL 'WB'
  ESCAPE ROUTINE
END-FIND
*
G-NATRP-ERC := 436
*
SET CONTROL 'WB'
SET CONTROL 'M21'
*
END-SUBROUTINE /* BUNDLE-REPORT
*
END
