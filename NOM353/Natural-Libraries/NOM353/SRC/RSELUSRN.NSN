* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RSELSPLN
* Function:  Select a NOM User-Spool Interface
*
* Maintenance
* gw  94-12-01  s(214320) created
* mrs 95-08-09  s(999999) parameter corrected
* jvd 98-09-10  p(164220) NOM141ÖNAT23
* xsetggr 03-03-17        add parameters (as in RDEFUSRL)
* SU1     2015-02-27 NOMALL-1569 USR0320N (SYSEXT) => NAT00064 (SYSLIBS)
* SU2     2016-10-18 NOM3.5
* SU3     2020-11-10 NOMALL-2440 split DDM -> NRM-MF-NODES
* SU4     2021-04-22 NOMALL-2454 recat for VMONIT-L M-NATRPT-DBID/-FNR
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 P-MONITOR
/*SU3 2 M-ERR-CLASS                    (A1)
  2 M-TIME-SCHEDULE                (A1)
  2 M-MONITOR-ID                   (A20) /*SU2 was A10
  2 REDEFINE    M-MONITOR-ID
    3 #PREFIX                      (A6)
    3 #INTERFACE                   (N3)
  2 M-WAIT-INCREMENT               (N3)
  2 M-VERSION                      (A60)
  2 M-NATRPT-DBID-N5               (N5)
  2 M-NATRPT-FNR-N5                (N5)
  2 M-CUSTOM-APPL                  (A250/1:5)
  2 REDEFINE    M-CUSTOM-APPL
    3 #NOMUSR-ATTR-DEF             (20)
      4 #NOMUSR-ATTR-GRP
        5 #NOMUSR-TYPE             (A1) /* 'P'PRIM, 'S'SEC, 'A'ATTR
        5 #NOMUSR-PROMPT           (A20)
        5 #NOMUSR-OFFSET           (N3)
        5 #NOMUSR-LENGTH           (N3)
        5 #NOMUSR-GENERIC          (A1)
        5 #NOMUSR-VAR              (A8)
        5 #NOMUSR-ORDER            (N2)
  2 M-MAX-RETRIES                  (N3)
  2 M-RETRY-INTERVAL               (N5)
************************************************************************
LOCAL
1 NRM-MONITOR VIEW OF NRM-MONITOR
  2 M-TIME-SCHEDULE                (A1)
  2 M-MONITOR-ID                   (A20)
  2 REDEFINE    M-MONITOR-ID
    3 #PREFIX                      (A6)
    3 #INTERFACE                   (N3)
  2 M-WAIT-INCREMENT               (N3)
  2 M-VERSION                      (A60)
/*SU4  2 M-NATRPT-DBID                  (N3)
/*SU4  2 M-NATRPT-FNR                   (N3)
  2 M-NATRPT-DBID-N5               (N5)
  2 M-NATRPT-FNR-N5                (N5)
  2 M-CUSTOM-APPL                  (A250/1:5)
  2 REDEFINE    M-CUSTOM-APPL
    3 #NOMUSR-ATTR-DEF             (20)
      4 #NOMUSR-ATTR-GRP
        5 #NOMUSR-TYPE             (A1) /* 'P' PRIM, 'S' SEC, 'A' ATTR
        5 #NOMUSR-PROMPT           (A20)
        5 #NOMUSR-OFFSET           (N3)
        5 #NOMUSR-LENGTH           (N3)
        5 #NOMUSR-GENERIC          (A1)
        5 #NOMUSR-VAR              (A8)
        5 #NOMUSR-ORDER            (N2)
1 #I                               (P2)
1 #J                               (P2)
1 #NOFLINES                        (I2) CONST <10>
1 #SCREEN                          (1:#NOFLINES)
  2 L-INTERFACE                    (N3)
  2 L-DESCRIPTION                  (A50)
1 CV-MARK                          (C/1:#NOFLINES)
1 L-MARK                           (A1/1:#NOFLINES)
1 END-OF-PROCESSING                (L)
1 END-OF-DISPLAY                   (L)
1 END-OF-DATA                      (L)
1 NEW-SEARCH                       (L)
*
1 #ERC                             (N4)
1 #PAGE                            (P3) INIT <1>
1 #NOFPAGES                        (I2) CONST <20>
1 #PID                             (A26/1:#NOFPAGES)
*
1 CV-LINE                          (C/1:#NOFLINES)
/*SU1 out ->
/*1 #USR0320-PARMS
/*2 #USR0320-APPLICATION           (A8) /* Application name for user    defined texts
/*2 #USR0320-ERROR-NUMBER          (N4) /* 01 THRU 9999
/*  REDEFINE    #USR0320-ERROR-NUMBER
/*2 3 #USR0320-ERROR-NUMBER-A      (A4)
/*2 #USR0320-LANGUAGE              (I1) /* similar to *LANGUAGE (1 th   ru 60)
/*2 #USR0320-RESPONSE              (N4) /* Error code
/*2 #USR0320-S-TEXT                (A65) /* Contains the short error m  essage
/*SU1 out <- in ->
1 #NAT00064
  2 ERROR-NUMBER             (N4)
  2 LIBRARY                  (A8)
  2 LANG-CODE                (I1)
  2 SHORT-TEXT                (A79)
  2 RESPONSE                 (N4)
/*1 CHECK-NSC (A1) 1 CP (A64) 1 CP-SUPPORT (A1)  /* OPTIONAL
/*SU1 <- in
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
PERFORM PF-KEYS
P-MONITOR.#PREFIX := 'NOMUSR'
#PID (1) := P-MONITOR.M-MONITOR-ID
IF P-MONITOR.#INTERFACE NE 0
  PERFORM SUBSTITUTE-PROMPT-TEXT
  ESCAPE ROUTINE
END-IF
*
MAIN. REPEAT
  UNTIL END-OF-PROCESSING
  RESET #I
  RESET INITIAL END-OF-DATA NEW-SEARCH
  REA. READ NRM-MONITOR BY M-MONITOR-ID = #PID (#PAGE)
    IF NRM-MONITOR.M-MONITOR-ID NE MASK ('NOMUSR')
      ESCAPE BOTTOM (REA.)
    END-IF
    IF #I = #NOFLINES
      PERFORM SCREEN-IO
      IF END-OF-PROCESSING OR NEW-SEARCH
        ESCAPE BOTTOM (REA.)
      END-IF
    END-IF
    ADD 1 TO #I
    PERFORM PRINTER-TO-SCREEN
  END-READ
  DECIDE FOR FIRST CONDITION
    WHEN #I > 0
      END-OF-DATA := TRUE
    WHEN #I = 0
      ESCAPE BOTTOM
    WHEN ANY
      PERFORM SCREEN-IO
    WHEN NONE
      IGNORE
  END-DECIDE
END-REPEAT
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE SCREEN-IO
************************************************************************
IF #I < #NOFLINES
  CV-MARK (#I+1:#NOFLINES) := (AD=DP)
  CV-LINE (#I+1:#NOFLINES) := (AD=D)
END-IF
RESET END-OF-DISPLAY
REPEAT
  DECIDE FOR FIRST CONDITION
    WHEN #ERC NE 0
      IGNORE
    WHEN END-OF-DATA AND #PAGE > 1
      #ERC := 12                   /* bottom of data
    WHEN END-OF-DATA AND #PAGE = 1
      #ERC := 14                   /* all
    WHEN NOT END-OF-DATA AND #PAGE = 1
      #ERC := 11                   /* top of data
    WHEN NONE
      #ERC := 13                   /* more
  END-DECIDE
  PERFORM FLIP-DISPLAY
  SET CONTROL 'M15'
  SET CONTROL 'WC19L65B1/07F'
  INPUT WITH TEXT *#ERC USING MAP 'RSELUSR&'
  SET CONTROL 'WMB'
  SET CONTROL 'M21'
  RESET #ERC
  PERFORM COMMAND-PF-KEY
  UNTIL END-OF-DISPLAY
END-REPEAT
RESET #I #SCREEN (*)
*
END-SUBROUTINE /* SCREEN-IO
*
************************************************************************
DEFINE SUBROUTINE PRINTER-TO-SCREEN
************************************************************************
L-INTERFACE   (#I) := NRM-MONITOR.#INTERFACE
L-DESCRIPTION (#I) := NRM-MONITOR.M-VERSION
CV-MARK (#I) := (AD=I)
CV-LINE (#I) := (AD=D)
*
END-SUBROUTINE /* PRINTER-TO-SCREEN
*
************************************************************************
DEFINE SUBROUTINE COMMAND-PF-KEY
************************************************************************
FOR #J = 1 TO #I
  IF L-MARK (#J) NE ' '
    P-MONITOR.#PREFIX    := 'NOMUSR'
    P-MONITOR.#INTERFACE := L-INTERFACE (#J)
    PERFORM SUBSTITUTE-PROMPT-TEXT
    END-OF-PROCESSING := END-OF-DISPLAY := TRUE
    ESCAPE ROUTINE
  END-IF
END-FOR
DECIDE ON FIRST *PF-KEY
  VALUE 'PF3' /* return to father-prog
    END-OF-PROCESSING := END-OF-DISPLAY := TRUE
  VALUE 'PF7'
    IF #PAGE > 1
      SUBTRACT 1 FROM #PAGE
      END-OF-DATA := FALSE
      END-OF-DISPLAY := NEW-SEARCH := TRUE
    END-IF
  VALUE 'PF8'    IF NOT END-OF-DATA
      ADD 1 TO #PAGE
      IF #PAGE > #NOFPAGES
        #PAGE := #NOFPAGES
        #PID (1:19) := #PID (2:20)
      END-IF
      #PID (#PAGE) := NRM-MONITOR.M-MONITOR-ID
      END-OF-DISPLAY := TRUE
    END-IF
  NONE           IGNORE
END-DECIDE
*
END-SUBROUTINE /* COMMAND-PF-KEY
*
************************************************************************
DEFINE SUBROUTINE SUBSTITUTE-PROMPT-TEXT
************************************************************************
FIND (1) NRM-MONITOR WITH M-MONITOR-ID = P-MONITOR.M-MONITOR-ID
  MOVE BY NAME NRM-MONITOR TO P-MONITOR
/*SU5 ->  DECIDE FOR FIRST CONDITION
/*    WHEN P-MONITOR.M-NATRPT-DBID-N5 = 0 AND
/*        NRM-MONITOR.M-NATRPT-DBID > 0
/*      P-MONITOR.M-NATRPT-DBID-N5 := NRM-MONITOR.M-NATRPT-DBID
/*      P-MONITOR.M-NATRPT-FNR-N5 := NRM-MONITOR.M-NATRPT-FNR
/*    WHEN NONE IGNORE
/*SU5 <-  END-DECIDE
*
  CALLNAT 'RGETLIB' LIBRARY
  MOVE EDITED LIBRARY (EM=XXXXXX) TO LIBRARY /*SU1
  COMPRESS LIBRARY 'U' TO LIBRARY LEAVING NO /*SU1
  LANG-CODE := *LANGUAGE /*SU1
  FOR #I 1 5
    IF P-MONITOR.#NOMUSR-PROMPT (#I) = MASK (NNNN' ')
      ERROR-NUMBER := VAL(P-MONITOR.#NOMUSR-PROMPT (#I)) /*SU1
      CALLNAT 'NAT00064' #NAT00064 /*CHECK-NSC CP CP-SUPPORT /*SU1
      COMPRESS SHORT-TEXT '....................' /*SU1
        TO P-MONITOR.#NOMUSR-PROMPT (#I)
    END-IF
  END-FOR
END-FIND
*
END-SUBROUTINE /* SUBSTITUTE-PROMPT-TEXT
*
************************************************************************
DEFINE SUBROUTINE PF-KEYS
************************************************************************
SET KEY PF1 = PGM PF2 = PGM PF3 = PGM PF4 = PGM PF5 = PGM PF6 = PGM
  PF7 = PGM PF8 = PGM PF9 = PGM PF10 = PGM PF11 = PGM PF12 = PGM
*
END-SUBROUTINE /* PF-KEYS
*
END
