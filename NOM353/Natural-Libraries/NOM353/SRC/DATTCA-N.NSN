* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* DATTCA-N
*   Timestamp (type T) century adaptation (sliding window)
*
* NOTE:
* - THE ROLLING TIME DIFFERENTIAL FOR THE CENTURY IS            Y2000A
*   50 YEARS.                                                   Y2000A
*
* MODIFICATIONS:
* 14.05.99 (181439) ALLOW 29.02.2000; CREATED               SN/SJU311Z2
* 04.11.04 E51107   avoid NAT1143                               SN511
* 28.01.05 E51124   -- USED-IN-OGC-511 --                       SN511
* ---------------------------------------------------------------------
DEFINE DATA PARAMETER
1 P-TIMESTAMP      (T)    /* MOD  TIMESTAMP
*
LOCAL
1 #TIME-A14           (A14)
1 REDEFINE #TIME-A14
  2 #TIME-A14-YYYY    (N04)     /* V Y2000A
1 #DATN               (A08)
1 REDEFINE #DATN
  2 #DATN-YYYY        (N04)     /* A Y2000A
1 #YD                 (I04)     /* YEAR DIFFERENCE      Y2000A
END-DEFINE
* ---------------------------------------------------------------------
IF P-TIMESTAMP = 0 ; ESCAPE ROUTINE ; END-IF        /* E51107
*
MOVE EDITED P-TIMESTAMP (EM=YYYYMMDDHHIISS) TO #TIME-A14
#DATN := *DATN
#YD := #TIME-A14-YYYY - #DATN-YYYY
*
* ITE *PROGRAM '(0037)' 'TS' P-TIMESTAMP (EM=YYYYMMDDHHIISS)
* '=' #YD
*
DECIDE FOR FIRST CONDITION
  WHEN #YD > 50
    SUBTRACT 100 FROM #TIME-A14-YYYY
    MOVE EDITED #TIME-A14 TO P-TIMESTAMP (EM=YYYYMMDDHHIISS)
  WHEN #YD < -50
    ADD 100 TO #TIME-A14-YYYY
    MOVE EDITED #TIME-A14 TO P-TIMESTAMP (EM=YYYYMMDDHHIISS)
  WHEN NONE ; IGNORE
END-DECIDE
*
* ITE *PROGRAM '(0050)' 'TS' P-TIMESTAMP (EM=YYYYMMDDHHIISS)
END
