* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    NOMGSTPP
* Version   3.2
* Function  Add all steplibs after deleting the existing steplibs
*
*
* Maintenance
* -----------
* uuuuuu yyyy-mm-dd P999999 Remark
* fhi    2007-06-11         Created to call RGETSTEP
* fhi    2008-03-19 P303113 RSTEPLIB still used if P297047 applied
* fhi    2009-02-27 P300323 Rename RGETSTEP to NOMGSTEP delivered in SYSTEM
* fhi    2009-03-27 P315387 Log only if error occurs
* fhi    2010-09-21 NOMALL-97 Use no more C-NATERR but C-NATERN instead
* ----------------------------------------------------------------------
DEFINE DATA
LOCAL USING RLOG-L /*SU 2018-10-30 RLOG-A
LOCAL
1 P-RC (N4) /* Return Code
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
FORMAT LS=133
*
CALLNAT  'NOMGSTEP' '*' P-RC
COMPRESS 'Steplibs concatenated with return code' P-RC TO LG-MSG
IF P-RC NE 0
  PERFORM WRITE-LOG
END-IF
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE WRITE-LOG
************************************************************************
PERFORM NOMCHCKP-CHECK-PROG 'RLOG' P-RC
IF P-RC = 0
  CALLNAT 'RLOG' PL-PARMS
END-IF
*
END-SUBROUTINE /* WRITE-LOG
*
END
