* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* ???
* SU1     2013-01-31 unused      Deactivate unused data areas
************************************************************************
DEFINE DATA GLOBAL USING NRM-GL
LOCAL USING VDISTS-L
LOCAL
1 USERS VIEW OF NRM-USERS
1 #ADD  (L)
1 #MEM  (A8)
1 I     (N3)
1 J     (N3)
1 #ML   (N3) INIT <1>
1 #ML1  (N3)
1 #LIST (A8)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET G-NATRP-ERC
INPUT #MEM #LIST
G-MEMBERS(1) := #LIST
*
REPEAT
  #ML1 := #ML
  RESET #ADD
  FOR I 1 TO #ML
    IF G-MEMBERS(I) = #MEM
      G-NATRP-ERC := 1
      ESCAPE ROUTINE END-IF
    IF G-MEMBER-SENT(I)
      ESCAPE TOP
    END-IF
    FU.   FIND NUMBER USERS WITH USER-ID = G-MEMBERS(I)
    IF *NUMBER(FU.) > 0
      G-MEMBER-SENT(I) := TRUE
      ESCAPE TOP
    END-IF
    FL. FIND DISTRIBUTION-LIST WITH D-LIST-NAME = G-MEMBERS(I)
      FOR J 1 C*D-USER-LIST
        ADD 1 TO #ML1
        #ADD := TRUE
        G-MEMBERS(#ML1) := D-USER-LIST(J)
      END-FOR
    END-FIND
    G-MEMBER-SENT(I) := TRUE
  END-FOR
  #ML := #ML1
  IF NOT #ADD
    ESCAPE BOTTOM
  END-IF
END-REPEAT
*
END
