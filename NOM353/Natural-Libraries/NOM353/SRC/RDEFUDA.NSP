*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* sju 02-03-11 NOM221    created
* xsetggr 05-02-16 NOM31 change err msg when require skeletons
* sju 05-04-06 NOM31     extra parameter for N-LISMEM
* xsetggr 2009-10-09 P320995 returns to default definition menu screen
*                            after editing exit in NOM/unix
* xsetggr 2010-03-12 P307403 side effect due changes in RPFKEX-C
* xsetggr 2010-03-16 P307403 backouted *DATA condition, tag deleted
* fhi     2010-09-03 NOMALL-97 Extend message line
* fhi     2011-05-02 NOMALL-901 Log any online delete operation
* xsetggr 2012-05-10 NOMALL-1136 prevent add of archive after NOM2126
* xsetggr 2012-06-20 NOMALL-1163 unify validation of retention
* raya    2013-08-15 NOMALL-1274 user defined archiv not defined
* SU1     2014-06-24 NOMALL-1281 show last update user+date
* SU2     2016-08-01 NOMALL-1518 NOM3.5 deactivate opt.Compiler+S-SEPEDT
* NKEW1   2024-07-24 EF-4541     Decide what to show on map with func
* ----------------------------------------------------------------------
DEFINE DATA GLOBAL USING NRM-GL
LOCAL  USING RPFK---L
LOCAL  USING VUSARC-L
LOCAL USING CONST-L /* NKEW1 changed
LOCAL
1 #FATHER-PROG        (A8) INIT <'RLISUDA'>
1 CV-MAP              (C) INIT < (AD=I CD=NE)>
1 CV-USERARC-NAME     (C) INIT < (AD=P CD=NE)>
1 #ISN                (P10)
1 L-HEADER            (A78)
1 #ALLOWED            (L)
1 #FUNC               (A1)
1 #LANGUAGE           (I1)
1 #PANEL              (I2)
1 #PANEL-IDENT        (I2) INIT <0001>
1 #PANEL-ATTR         (I2) INIT <0002>
1 #I                  (I4)
1 #J                  (I4)
1 #RETENTION-NUM      (N4)
1 #RETENTION-UNIT     (A1)
1 L                   (P2)
1 #ARCHIVE-RETENTION  (A5)
1 REDEFINE #ARCHIVE-RETENTION
  2 #ARET             (A1/1:5)
1 #LEN                (N2)
1 #RETENTION          (A4)
1 REDEFINE #RETENTION
  2 #RET-V            (A1/4)
1 #EDIT-MEMBER        (A8)
1 #EDIT-LIB           (A8)
1 #USERARC-NAMES      (A8/1:9)
1 #UI                 (I4)
1 #NEW-ISN            (P10)
1 #VARIABLES          (28)
  2 #VARIABLE-KEYWORD (A10)
  2 #VARIABLE-VALUE   (A65)
1 #VAR-I              (N7)
1 #END-OF-DATA        (L)
1 #CP                 (I4)
1 #MAP-OCC            (I4)           CONST <14>
1 #RESERVED-WORDS     (A20/1:50) INIT
  (01) <'JOBCARD01'>
  (02) <'JOBCARD02'>
  (03) <'JOBCARD03'>
  (04) <'NODE'>
  (05) <'DBID'>
  (06) <'FNR'>
  (07) <'DATE'>
  (08) <'DAT-YYYY'>
  (09) <'RETPD'>
  (10) <'EXPDATE'>
  (11) <'SYSNR'>
  (12) <'CRUN'>
  (13) <'PRUN'>
  (14) <'JOBNAME'>
  (15) <'ESYUSER'>
  (16) <'NATLOGON'>
  (17) <'STORCLAS'>
  (18) <'VOLSERS'>
  (19) <'SPACE'>
  (20) <'UNIT'>
  (21) <'TAPE-DSNAME'>
  (22) <'DSNAME'>
  (23) <'EXIT8'>
  (24) <'ARCTYPE'>
  (25) <'DSNAMEOUT'>
  (26) <'DSNAMEIN'>
  (27) <'EOMSTEP'>
  (28) <'DISP'>
  (29) <'OPEN'>
  (30) <'NATLOGON'>
  (31) <'$$$'>
  (32) <'VSEQ'>
  (33) <'LASTVOL'>
  (34) <'FIRSTVOL'>
  (35) <'FIRSTSEQ'>
  (36) <'VOLSER1'>
  (37) <'VOLSER2'>
  (38) <'VOLSER3'>
  (39) <'VOLSER4'>
  (40) <'VOLSER5'>
  (41) <'VOLSER6'>
  (42) <'VOLSER7'>
  (43) <'VOLSER8'>
  (44) <'VOLSER9'>
  (45) <'VOLSER10'>
  (46) <'VOLSER11'>
  (47) <'VOLSER12'>
  (48) <' '>
  (49) <' '>
  (50) <' '>
1 #MEMBER-TYPE        (A8)
1 #OLD-FUNC           (A1)
1 #LAST-MOD           (A40)
1 #PROG               (A8) INIT <*PROGRAM>
1 #A8                 (A8)
1 #POS                (I4)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET G-COMMIT G-LINECOM(*) G-NATRP-ERC
SET CONTROL 'L'
*
* NKEW1 <
#JOB_ADD_FIELD := F#SETVAR(<#_JOBCARDS(1:2),#_ADDITIONALPARA(1:2)>)
* NKEW1 >
#PANEL := #PANEL-IDENT
IF *DATA = 1
  INPUT NRM-USER-DEFINED-ARCHIVE.M-MONITOR-ID
ELSE
  IF *DATA = 12
    INPUT NRM-USER-DEFINED-ARCHIVE.M-MONITOR-ID #USERARC-NAMES(*)
      #FUNC #PANEL
  ELSE
    PERFORM ADD-INTERFACE
  END-IF
END-IF
IF G-NATRP-ERC NE 0
  ESCAPE ROUTINE
END-IF
*
#FUNC := G-C-FUNC
*
MAIN-LOOP. REPEAT
*
  FIND-LOOP. FIND NRM-USER-DEFINED-ARCHIVE
      WITH M-MONITOR-ID = NRM-USER-DEFINED-ARCHIVE.M-MONITOR-ID
    IF NO RECORDS FOUND
      ESCAPE BOTTOM (MAIN-LOOP.)
    END-NOREC
*
    #ISN := *ISN
    #VARIABLE-KEYWORD(*):= M-USERARC-SYMBOL-NAME(*)
    #VARIABLE-VALUE(*)  := M-USERARC-SYMBOL-VALUE(*)
    #VAR-I:= 1
*
    DECIDE ON FIRST VALUE OF #FUNC
      VALUE 'M' , ' ' , 'A'
        CALLNAT 'NARPSEC' G-USER-PROFILE 'MMO' #ALLOWED
        INCLUDE C-NALLOW
        GETREC. GET NRM-USER-DEFINED-ARCHIVE #ISN
      VALUE 'D'
        CALLNAT 'NARPSEC' G-USER-PROFILE 'DMO' #ALLOWED
        INCLUDE C-NALLOW
        CV-MAP := (AD=IP)
      NONE VALUE
        IGNORE
    END-DECIDE
*
    SCREEN-LOOP. REPEAT
*
      IF #LANGUAGE NE *LANGUAGE
        PERFORM INIT-PFKEYS
        PERFORM SET-PFKEYS
        #LANGUAGE := *LANGUAGE
      END-IF
*
      PERFORM FLIP-DISPLAY
      CALLNAT 'N-HEADER' L-HEADER G-DATE-FORMAT 'DUMMY   '
      CALLNAT 'N-HEAD2' M-LAST-UPDATE-USER M-LAST-UPDATE
        #LAST-MOD G-DATE-FORMAT
      PERFORM BEFORE-INPUT
*
      DECIDE ON FIRST VALUE #PANEL
        VALUE #PANEL-IDENT
          INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
            MARK *G-DIRECT-COMMAND USING MAP 'RDEFUDA&'
        VALUE #PANEL-ATTR
          PERFORM CHECK-TOP-BOTTOM-MORE-ALL
          INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
            MARK *G-DIRECT-COMMAND USING MAP 'RDEFUDB&'
        NONE IGNORE
      END-DECIDE
*
      PERFORM AFTER-INPUT
      RESET G-NATRP-ERC G-NATRP-ERT
*
      INCLUDE RPFKVA-C
      IF #FUNC = 'A' OR #OLD-FUNC = 'A'
        IF (G-PF-FUNC = 'EXIT' OR = 'MENU') OR
            (G-DIRECT-COMMAND = 'EXIT' OR = 'MENU')
          GETDEL. GET NRM-USER-DEFINED-ARCHIVE #NEW-ISN
          DELETE (GETDEL.)
          END TRANSACTION
        END-IF
        IF #FUNC = 'A'
          #OLD-FUNC := #FUNC
          #FUNC:= 'M'
        END-IF
      END-IF
      INCLUDE C-DIRECT
      INCLUDE RPFKED-C
*
      IF CV-MAP MODIFIED OR G-MAP-MODIFIED OR CV-USERARC-NAME MODIFIED
        IF #PANEL = #PANEL-IDENT
          PERFORM VALIDATE-INPUT
        ELSE
          #J:= #VAR-I + #MAP-OCC - 1
          FOR #I = #VAR-I TO #J
            IF #VARIABLE-KEYWORD(#I) NE ' '
              IF #RESERVED-WORDS(*) = #VARIABLE-KEYWORD(#I)
                REINPUT *0129, #VARIABLE-KEYWORD(#I)
                  MARK *#VARIABLE-KEYWORD(#I) ALARM
              END-IF
            END-IF
          END-FOR
          M-USERARC-SYMBOL-NAME(*) := #VARIABLE-KEYWORD(*)
          M-USERARC-SYMBOL-VALUE(*):= #VARIABLE-VALUE(*)
        END-IF
*
        M-LAST-UPDATE      := *TIMX
        M-LAST-UPDATE-USER := G-USERID
        UPDATE(GETREC.)
        G-NATRP-ERC := 0032
        #OLD-FUNC := 'M'
        INCLUDE C-COMMIT
      END-IF
      INCLUDE REXDO--C
*
      DECIDE ON FIRST VALUE G-PF-FUNC
        VALUE ##PFK-ATTRIBUTES
          #PANEL := #PANEL-ATTR
          RESET #LANGUAGE
        VALUE ##PFK-IDENT
          #PANEL := #PANEL-IDENT
          RESET #LANGUAGE
        VALUE ##PFK-EDIT
          PERFORM EDIT-SKELETON
        VALUE ##PFK-UP
          SUBTRACT #MAP-OCC FROM #VAR-I
          IF #VAR-I LT 1
            #VAR-I:= 1
          END-IF
        VALUE ##PFK-DOWN
          ADD #MAP-OCC TO #VAR-I
          IF #VAR-I GT #MAX-SYMBOLS
            #VAR-I := #MAX-SYMBOLS - #MAP-OCC + 1
          END-IF
        NONE IGNORE
      END-DECIDE
*
    END-REPEAT
  END-FIND
END-REPEAT
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE ADD-INTERFACE
************************************************************************
CV-USERARC-NAME := (AD=I CD=NE)
RESET NRM-USER-DEFINED-ARCHIVE #UI #J
*
READ NRM-USER-DEFINED-ARCHIVE BY M-MONITOR-ID = 'USERARC00'
  IF M-MONITOR-ID NE MASK ('USERARC'NN)
    ESCAPE BOTTOM
  END-IF
  ADD 1 TO #UI
  #USERARC-NAMES(#UI):= M-USERARC-NAME
  #I := M-USERARC-NUMBER - #J
  IF #I > 1
    M-USERARC-NUMBER := #J
    ESCAPE BOTTOM
  END-IF
  #J := M-USERARC-NUMBER
END-READ
*
ADD 1 TO #J
IF #J GT 9
  G-NATRP-ERC:= 0128
END-IF
*
RESET NRM-USER-DEFINED-ARCHIVE
NRM-USER-DEFINED-ARCHIVE.M-MONITOR-TYPE  := 'USERARC'
NRM-USER-DEFINED-ARCHIVE.M-USERARC-NUMBER:= #J
COMPRESS 'ARCTYP' #J TO
  NRM-USER-DEFINED-ARCHIVE.M-USERARC-NAME LEAVING NO
M-LAST-UPDATE      := *TIMX
M-LAST-UPDATE-USER := G-USERID
STORE-NEW. STORE NRM-USER-DEFINED-ARCHIVE
#NEW-ISN:= *ISN(STORE-NEW.)
END TRANSACTION
G-MAP-MODIFIED:= TRUE
*
END-SUBROUTINE /* ADD-INTERFACE
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-INPUT
************************************************************************
IF CV-USERARC-NAME MODIFIED
  IF NRM-USER-DEFINED-ARCHIVE.M-USERARC-NAME = #USERARC-NAMES(*)
    REINPUT *0033, NRM-USER-DEFINED-ARCHIVE.M-USERARC-NAME
      MARK *NRM-USER-DEFINED-ARCHIVE.M-USERARC-NAME ALARM
  END-IF
  CV-USERARC-NAME := (AD=P CD=NE)
END-IF
#RETENTION:= NRM-USER-DEFINED-ARCHIVE.M-USERARC-RETENTION
IF #RETENTION IS(N4) OR #RETENTION = ' '
  IGNORE
ELSE
  EXAMINE #RETENTION FOR 'X' GIVING LENGTH IN #LEN
  IF #LEN < 2 OR NOT (#RET-V(#LEN) = 'D' OR = 'W' OR = 'M' OR = 'Y')
    REINPUT *0634 MARK *#RETENTION-UNIT ALARM
  END-IF
  RESET #RET-V(#LEN)
  IF NOT #RETENTION IS (N4) OR #RETENTION-NUM = 0
    REINPUT *0415 MARK *#RETENTION-NUM ALARM
  END-IF
END-IF
IF NRM-USER-DEFINED-ARCHIVE.M-USERARC-ARCHIVE-SKEL = ' '
  REINPUT *2126 MARK *NRM-USER-DEFINED-ARCHIVE.M-USERARC-ARCHIVE-SKEL
    ALARM
END-IF
IF NRM-USER-DEFINED-ARCHIVE.M-USERARC-REVIVE-SKEL = ' '
  REINPUT *2126 MARK *NRM-USER-DEFINED-ARCHIVE.M-USERARC-REVIVE-SKEL
    ALARM
END-IF
IF NRM-USER-DEFINED-ARCHIVE.M-USERARC-CONDENSE-SKEL = ' '
  REINPUT *2126 MARK *NRM-USER-DEFINED-ARCHIVE.M-USERARC-CONDENSE-SKEL
    ALARM
END-IF
IF NRM-USER-DEFINED-ARCHIVE.M-USERARC-ARCHIVE-SKEL = SCAN '*'
  CALLNAT 'RGETLIB' #EDIT-LIB
  COMPRESS #EDIT-LIB 'U' TO #EDIT-LIB LEAVING NO
  #EDIT-MEMBER:= NRM-USER-DEFINED-ARCHIVE.M-USERARC-ARCHIVE-SKEL
  CALLNAT 'N-LISMEM' #EDIT-LIB #EDIT-MEMBER #MEMBER-TYPE
    G-NATRP-ERC G-NATRP-ERT
  NRM-USER-DEFINED-ARCHIVE.M-USERARC-ARCHIVE-SKEL:= #EDIT-MEMBER
END-IF
IF NRM-USER-DEFINED-ARCHIVE.M-USERARC-REVIVE-SKEL = SCAN '*'
  CALLNAT 'RGETLIB' #EDIT-LIB
  COMPRESS #EDIT-LIB 'U' TO #EDIT-LIB LEAVING NO
  #EDIT-MEMBER:= NRM-USER-DEFINED-ARCHIVE.M-USERARC-REVIVE-SKEL
  CALLNAT 'N-LISMEM' #EDIT-LIB #EDIT-MEMBER #MEMBER-TYPE
    G-NATRP-ERC G-NATRP-ERT
  NRM-USER-DEFINED-ARCHIVE.M-USERARC-REVIVE-SKEL:= #EDIT-MEMBER
END-IF
IF NRM-USER-DEFINED-ARCHIVE.M-USERARC-CONDENSE-SKEL = SCAN '*'
  CALLNAT 'RGETLIB' #EDIT-LIB
  COMPRESS #EDIT-LIB 'U' TO #EDIT-LIB LEAVING NO
  #EDIT-MEMBER:= NRM-USER-DEFINED-ARCHIVE.M-USERARC-CONDENSE-SKEL
  CALLNAT 'N-LISMEM' #EDIT-LIB #EDIT-MEMBER #MEMBER-TYPE
    G-NATRP-ERC G-NATRP-ERT
  NRM-USER-DEFINED-ARCHIVE.M-USERARC-CONDENSE-SKEL:= #EDIT-MEMBER
END-IF
IF NRM-USER-DEFINED-ARCHIVE.M-USERARC-EXITMEM NE ' '
  IF NRM-USER-DEFINED-ARCHIVE.M-USERARC-EXITLIB = ' '
    CALLNAT 'RGETLIB' NRM-USER-DEFINED-ARCHIVE.M-USERARC-EXITLIB
    COMPRESS NRM-USER-DEFINED-ARCHIVE.M-USERARC-EXITLIB 'U' TO
      NRM-USER-DEFINED-ARCHIVE.M-USERARC-EXITLIB LEAVING NO
  END-IF
  IF NRM-USER-DEFINED-ARCHIVE.M-USERARC-EXITMEM = SCAN '*'
    #EDIT-LIB:= NRM-USER-DEFINED-ARCHIVE.M-USERARC-EXITLIB
    #EDIT-MEMBER:= NRM-USER-DEFINED-ARCHIVE.M-USERARC-EXITMEM
    CALLNAT 'N-LISMEM' #EDIT-LIB #EDIT-MEMBER #MEMBER-TYPE
      G-NATRP-ERC G-NATRP-ERT
    NRM-USER-DEFINED-ARCHIVE.M-USERARC-EXITMEM:= #EDIT-MEMBER
  END-IF
ELSE
  RESET NRM-USER-DEFINED-ARCHIVE.M-USERARC-EXITLIB
END-IF
RESET G-MAP-MODIFIED
*
END-SUBROUTINE /* VALIDATE-INPUT
*
************************************************************************
DEFINE SUBROUTINE BEFORE-INPUT
************************************************************************
IF NRM-USER-DEFINED-ARCHIVE.M-USERARC-RETENTION = ' '
  RESET #RETENTION-NUM
    #RETENTION-UNIT
ELSE
  #ARCHIVE-RETENTION:= NRM-USER-DEFINED-ARCHIVE.M-USERARC-RETENTION
  IF #ARCHIVE-RETENTION IS (N4)
    #RETENTION-UNIT := 'D'
  ELSE
    EXAMINE #ARCHIVE-RETENTION FOR 'X' GIVING LENGTH IN L
    #RETENTION-UNIT := #ARET (L)
    RESET  #ARET (L)
  END-IF
  IF #ARCHIVE-RETENTION IS (N4)
    #RETENTION-NUM := VAL (#ARCHIVE-RETENTION)
  ELSE
    RESET  #RETENTION-NUM
  END-IF
END-IF
*
END-SUBROUTINE /* BEFORE-INPUT
*
************************************************************************
DEFINE SUBROUTINE AFTER-INPUT
************************************************************************
IF #RETENTION-UNIT = ' ' AND #RETENTION-NUM = 0
  RESET NRM-USER-DEFINED-ARCHIVE.M-USERARC-RETENTION
ELSE
  COMPRESS #RETENTION-NUM #RETENTION-UNIT
    TO NRM-USER-DEFINED-ARCHIVE.M-USERARC-RETENTION LEAVING NO
END-IF
*
END-SUBROUTINE /* AFTER-INPUT
*
************************************************************************
DEFINE SUBROUTINE EDIT-SKELETON
************************************************************************
CALLNAT 'RGETLIB' #EDIT-LIB
COMPRESS #EDIT-LIB 'U' TO #EDIT-LIB LEAVING NO
RESET #EDIT-MEMBER
*
DECIDE ON FIRST VALUE OF *CURS-LINE
  VALUE 8
    DECIDE ON FIRST *CURS-COL
      VALUE 25:32
        #EDIT-MEMBER:= NRM-USER-DEFINED-ARCHIVE.M-USERARC-ARCHIVE-SKEL
      VALUE 45:52
        #EDIT-MEMBER:= NRM-USER-DEFINED-ARCHIVE.M-USERARC-REVIVE-SKEL
      VALUE 67:74
        #EDIT-MEMBER:= NRM-USER-DEFINED-ARCHIVE.M-USERARC-CONDENSE-SKEL
      ANY VALUE
        IF #EDIT-MEMBER NE ' '
          PERFORM EDIT-MEMBER
        END-IF
      NONE VALUE
        REINPUT *1207 ALARM
    END-DECIDE
  VALUE 10, 11
    #EDIT-MEMBER:= NRM-USER-DEFINED-ARCHIVE.M-USERARC-EXITMEM
    IF NRM-USER-DEFINED-ARCHIVE.M-USERARC-EXITLIB NE ' '
      #EDIT-LIB:= NRM-USER-DEFINED-ARCHIVE.M-USERARC-EXITLIB
    END-IF
    IF #EDIT-MEMBER NE ' '
      PERFORM EDIT-MEMBER
    END-IF
  NONE VALUE
    REINPUT *1207 ALARM
END-DECIDE
*
END-SUBROUTINE /* EDIT-SKELETON
*
************************************************************************
DEFINE SUBROUTINE EDIT-MEMBER
************************************************************************
PERFORM S-SEPEDT #PROG #POS #POS #A8 #POS #A8 2X #EDIT-MEMBER
  #EDIT-LIB #USERARC-NAMES (1:9) #FUNC M-MONITOR-ID #PANEL
*
END-SUBROUTINE /* EDIT-MEMBER
*
************************************************************************
DEFINE SUBROUTINE INIT-PFKEYS
************************************************************************
RESET G-PF
*
INCLUDE RPFSTD-C
INCLUDE RPFCOM-C
DECIDE ON FIRST VALUE #PANEL
  VALUE #PANEL-IDENT
    INCLUDE RPFEDT-C
    INCLUDE RPFATT-C
  VALUE #PANEL-ATTR
    INCLUDE RPFIDN-C
    INCLUDE RPFBRW-C
  NONE  IGNORE
END-DECIDE
*
CALLNAT 'RPFINI-N' G-PF G-PFB
*
END-SUBROUTINE /* INIT-PFKEYS
*
************************************************************************
DEFINE SUBROUTINE CHECK-TOP-BOTTOM-MORE-ALL
************************************************************************
#J:= #MAX-SYMBOLS
*
IF #VAR-I + #MAP-OCC GT #J
  #END-OF-DATA:= TRUE
ELSE
  RESET #END-OF-DATA
END-IF
*
IF #VAR-I LT #MAP-OCC
  #CP:= 1
ELSE
  RESET #CP
END-IF
*
INCLUDE C-TOPBOT
*
END-SUBROUTINE /* CHECK-TOP-BOTTOM-MORE-ALL
************************************************************************
INCLUDE RPFSET-C /* set pfkeys
*
END
