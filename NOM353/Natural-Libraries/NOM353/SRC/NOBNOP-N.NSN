DEFINE DATA
PARAMETER USING ESMCNT-A
PARAMETER USING ESMINP-A
PARAMETER USING NOBNOP-A
PARAMETER
1 ES-ADD-INPUT (A253) OPTIONAL
************************************************************************
LOCAL USING VMBUN-L
LOCAL USING VMBRP-L
LOCAL USING NADA2000
LOCAL USING NAD-MSG
LOCAL USING NAD-FLD
LOCAL USING NOMODE-A
LOCAL USING RLOG-L
*
LOCAL
1 REPORTS VIEW OF NRM-REPORTS-NEW
1 #ES-CONTROL               (A250)
1 #ES-INPUT-AREA            (A253/1:3)
1 #ES-MSG-PREF              (A7) INIT <'NOM'>
1 REDEFINE #ES-MSG-PREF
  2 #ES-MSG-NOM             (A3)
  2 #ES-MSG-NR              (N4)
1 #ES-MSG-FIELD             (A32)
1  REDEFINE #ES-MSG-FIELD
  2 #ES-MSG-FIELD-NAME      (A28)
  2 #ES-MSG-FIELD-INDEX     (N4)
  2 REDEFINE #ES-MSG-FIELD-INDEX
    3 #ES-MSG-FIELD-INDEX1  (N2)
    3 #ES-MSG-FIELD-INDEX2  (N2)
1 #ES-MSG-TXT               (A250)
1 #I                        (I2)
1 #DEF-COPIES               (N3)  CONST <1>
1 #MAX-PRINTER              (N2)  CONST <20>
1 #APPLIB                   (A8)
1 #LAST-MODIFIED            (A15)
1 #RET-PERIOD               (A12)
1 REDEFINE #RET-PERIOD
  2 #RET-NUMBER             (N3)
  2 #RET-FACTOR             (A1)
  2 #RET-CALENDAR           (A8)
1 #TEMP-TIME                (A4)
1 REDEFINE #TEMP-TIME
  2 #TEMP-HH                (N2)
  2 #TEMP-II                (N2)
1 #DATN8                    (N8)
1 REDEFINE #DATN8
  2 #YEAR                   (A4)
1 #CALENDAR-ID              (A12)
1 REDEFINE #CALENDAR-ID
  2 #CA-ID                  (A8)
  2 #CA-YEAR                (A4)
1 #ADAY                     (A3)
1 #NDAY                     (N3)
1 #TIME                     (T)
1 #TIME-P                 (P13)
1 #BR-BUNDLE-REPORT         (A50)
1 REDEFINE #BR-BUNDLE-REPORT
  2 #BR-BUNDLE              (A25)
  2 #BR-REPORT              (A25)
1 #GRANTS                   (A1/6)
1 #GR-USER                  (A8)
1 #GR-OBJECT                (A25)
1 #PARM-1 (A253)
1 #USER-LIB                 (A8)
1 #F                        (I2)
1 #GRANTED                  (L)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET ES-RC
#ES-CONTROL := ES-CONTROL
#ES-INPUT-AREA(*) := ES-INPUT-AREA(*)
#DATN8 := *DATN
#CA-YEAR := #YEAR
NOMOD-PARMS := ES-SELECT
#APPLIB  := ES-APP-SERVER-LIBRARY
COMPRESS ES-APP-SERVER-LIBRARY 'U' TO #USER-LIB LEAVING NO
DECIDE ON FIRST VALUE OF ES-FUNCTION
  VALUE 'OP'
    DECIDE ON FIRST VALUE OF ES-EXTEND-FUNCTION
      VALUE ' '
        PERFORM READ-RECORD
      VALUE 'NEW'
        PERFORM NEW-RECORD
        IF ES-RC = 0
          PERFORM WRITE-LOG-RECORD
          END TRANSACTION
        ELSE
          BACKOUT TRANSACTION
        END-IF
      VALUE 'UPD'
        PERFORM UPDATE-RECORD
        IF ES-RC = 0
          PERFORM WRITE-LOG-RECORD
          END TRANSACTION
        ELSE
          BACKOUT TRANSACTION
        END-IF
      VALUE 'CHK'
        PERFORM CHECK
      NONE VALUE IGNORE
    END-DECIDE
  NONE VALUE IGNORE
END-DECIDE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE READ-RECORD
************************************************************************
RESET NOBN-PARMS
RESET #ES-MSG-FIELD #ES-MSG-NR
IF ES-ADD-INPUT SPECIFIED
  #PARM-1 := ES-ADD-INPUT
ELSE
  #PARM-1 := ES-KEY-PARM(1)
END-IF
FNDBU.
FIND BUNDLES WITH B-BUNDLE = #PARM-1
  IF NO RECORDS FOUND
    #ES-MSG-NR := 0408    /* bundle not defined
    #ES-MSG-FIELD-NAME := 'BUNDLE'
    ESCAPE BOTTOM (FNDBU.)
  END-NOREC
/* read general attributes
  NOBN-BUNDLE         := BUNDLES.B-BUNDLE
  NOBN-USERID         := BUNDLES.B-USERID
  NOBN-MASTER-REPNAME := BUNDLES.B-MASTER-REPNAME
  NOBN-DESC           := BUNDLES.B-DESC
  IF BUNDLES.B-BUNDLE-STATUS NE ' '
    NOBN-TYPE := BUNDLES.B-BUNDLE-STATUS
  ELSE
    NOBN-TYPE := 'M'
  END-IF
  NOBN-COORDINATOR-ID   := BUNDLES.B-COORDINATOR-ID
  MOVE EDITED BUNDLES.B-LAST-MODIFIED (EM=YYYYMMDDHHIISST)
    TO NOBN-LAST-MODIFIED
  NOBN-MODIFIED-BY      := BUNDLES.B-MODIFIED-BY
  NOBN-RETENTION-ACTION       := BUNDLES.B-RETENTION-ACTION
  IF BUNDLES.B-RETENTION-PERIOD = ' '
    RESET NOBN-RETENTION-NUMBER NOBN-RETENTION-FACTOR
      NOBN-RETENTION-CALENDAR
  ELSE
    #RET-PERIOD             := BUNDLES.B-RETENTION-PERIOD
    NOBN-RETENTION-NUMBER   := #RET-NUMBER
    NOBN-RETENTION-FACTOR   := #RET-FACTOR
    NOBN-RETENTION-CALENDAR := #RET-CALENDAR
  END-IF
  IF BUNDLES.B-RETENTION-PERIOD-PURGE = ' '
    RESET NOBN-RET-PURGE-NUMBER NOBN-RET-PURGE-FACTOR
      NOBN-RET-PURGE-CALENDAR
  ELSE
    #RET-PERIOD             := BUNDLES.B-RETENTION-PERIOD-PURGE
    NOBN-RET-PURGE-NUMBER   := #RET-NUMBER
    NOBN-RET-PURGE-FACTOR   := #RET-FACTOR
    NOBN-RET-PURGE-CALENDAR := #RET-CALENDAR
  END-IF
  #TIME                     := BUNDLES.B-FLUSH-TIME
  #TIME-P                   := BUNDLES.B-FLUSH-TIME
  NOBN-FLUSH-TIME-N         := #TIME-P
  NOBN-FLUSH-TIME-SCHEDULE  := BUNDLES.B-FLUSH-TIME-SCHEDULE
  NOBN-FLUSH-REPORTS (*)    := BUNDLES.B-FLUSH-REPORTS(*)
  NOBN-FLUSH-LINES          := BUNDLES.B-FLUSH-LINES
*
/* read schedule attributes
  IF BUNDLES.B-FLUSH-START = ' '
    NOBN-FLUSH-START := '0000'
  ELSE
    NOBN-FLUSH-START := BUNDLES.B-FLUSH-START
  END-IF
  IF BUNDLES.B-FLUSH-END = ' '
    NOBN-FLUSH-END := '0000'
  ELSE
    NOBN-FLUSH-END := BUNDLES.B-FLUSH-END
  END-IF
  IF BUNDLES.B-FLUSH-INT = ' '
    NOBN-FLUSH-INT := '0000'
  ELSE
    NOBN-FLUSH-INT := BUNDLES.B-FLUSH-INT
  END-IF
  NOBN-FLUSH-BEFORE-AFTER := B-FLUSH-BEFORE-AFTER
  NOBN-FLUSH-CALENDAR     := B-FLUSH-CALENDAR
  NOBN-FLUSH-DAYS(*)      := B-FLUSH-DAYS(*)
  NOBN-FLUSH-WEEK-DAYS(*) := B-FLUSH-WEEK-DAYS(*)
/* read printing attributes
  NOBN-HOLD-PRINT         := B-HOLD
  NOBN-PRINTER(*)         := B-PRINTER(*)
  NOBN-PRINT-COPIES(*)    := B-PRINTER-COPIES(*)
  NOBN-FLAG-REPSEP        := B-FLAG-REPSEP
  NOBN-SEP-START          := B-SEPSTART
  NOBN-SEP-END            := B-SEPEND
  CALLNAT 'N-NONE' NOBN-SEP-START NOBN-SEP-END /*SU3
  NOBN-SEPARATOR-COPIES   := B-SEPNO
  NOBN-CONTROL-EXITLIB    := B-CONTROL-EXITLIB
  NOBN-CONTROL-EXITMEM    := B-CONTROL-EXITMEM
  NOBN-PRINT-JOBCARD(1:3) := B-PRINT-JOBCARD(1:3)
  NOBN-LAST-UPDATE-USER   := B-LAST-UPDATE-USER /*SU1 ->
  IF B-LAST-UPDATE NE 0
    MOVE EDITED B-LAST-UPDATE (EM=YYYYMMDDHHIISST) TO NOBN-LAST-UPDATE
  END-IF /*SU1 <-

END-FIND
IF #ES-MSG-NR NE 0
  PERFORM GET-MSG-TXT
END-IF
*
END-SUBROUTINE /* READ-RECORD
*
************************************************************************
DEFINE SUBROUTINE NEW-RECORD
************************************************************************
FNNEW. FIND NUMBER BUNDLES WITH B-BUNDLE = NOBN-BUNDLE
IF *NUMBER(FNNEW.) NE 0
  #ES-MSG-NR := 0404                       /* budle already defined
  #ES-MSG-FIELD-NAME := 'BUNDLE'
  PERFORM GET-MSG-TXT
  ESCAPE ROUTINE
END-IF
PERFORM VALIDATION-S
IF #ES-MSG-NR NE 0
  PERFORM GET-MSG-TXT
  ESCAPE ROUTINE
END-IF
PERFORM ASSIGN-ATTRIBUTE-VALUES
STORE BUNDLES
/* Store grants record
#ES-CONTROL := ES-CONTROL
#ES-INPUT-AREA(*) := ES-INPUT-AREA(*)
ES-OBJECT        := 'GR'
ES-FUNCTION      := 'FF'
ES-ORIG-FUNCTION := 'NW'
ES-KEY-CODE(1)   := 'B'
ES-KEY-PARM(1)   := NOBN-BUNDLE
ES-KEY-PARM(2)   := ES-USER
ES-KEY-PARM(3)   := 'YYYYYY'
CALLNAT 'NOGRFF-N' ES-CONTROL ES-INPUT-AREA(*)
NOBN-OPTIONS (*) := ' '
RESET NOBN-REP-NUMBER
NOBN-OPTIONS (1) := 'LR'
NOBN-OPTIONS (2) := 'SS'
IF ES-USER-TYPE = 'A'
  NOBN-AUTH := 'ADMIN'
ELSE
  NOBN-AUTH := ES-USER
END-IF
ES-CONTROL := #ES-CONTROL
ES-INPUT-AREA(*) := #ES-INPUT-AREA(*)
*
END-SUBROUTINE /* NEW-RECORD
*
************************************************************************
DEFINE SUBROUTINE UPDATE-RECORD
************************************************************************
FNDMOD. FIND BUNDLES WITH B-BUNDLE = ES-KEY-PARM(1)
  IF NO RECORDS FOUND
    #ES-MSG-NR := 0408    /* bundle not defined
    #ES-MSG-FIELD-NAME := 'BUNDLE'
    ESCAPE BOTTOM (FNDMOD.)
  END-NOREC
  PERFORM VALIDATION-S
  IF #ES-MSG-NR NE 0
    ESCAPE BOTTOM(FNDMOD.)
  END-IF
  MOVE EDITED B-LAST-MODIFIED (EM=YYYYMMDDHHIISST) TO #LAST-MODIFIED
  IF #LAST-MODIFIED > NOBN-LAST-MODIFIED
    #ES-MSG-NR := 2104 /* bundle has been modified by another user
    #ES-MSG-FIELD-NAME := 'LAST-MODIFIED'
    ESCAPE BOTTOM (FNDMOD.)
  END-IF
  B-LAST-UPDATE      := *TIMX /*SU1
  B-LAST-UPDATE-USER := ES-USER /*SU1
  GETMOD. GET BUNDLES *ISN(FNDMOD.)
  PERFORM ASSIGN-ATTRIBUTE-VALUES
  PERFORM GET-OPTIONS
  UPDATE (GETMOD.)
END-FIND
IF #ES-MSG-NR NE 0
  PERFORM GET-MSG-TXT
END-IF
*
END-SUBROUTINE /* UPDATE-RECORD
*
************************************************************************
DEFINE SUBROUTINE CHECK
************************************************************************
FND. FIND NUMBER BUNDLES WITH B-BUNDLE = NOBN-BUNDLE
DECIDE FOR FIRST CONDITION
  WHEN *NUMBER(FND.) > 0 AND ES-ORIG-FUNCTION = 'NW'
    #ES-MSG-NR := 0404
    #ES-MSG-FIELD-NAME := 'BUNDLE'
  WHEN NONE
    PERFORM VALIDATION-S
END-DECIDE
IF #ES-MSG-NR NE 0
  PERFORM GET-MSG-TXT
END-IF
*
END-SUBROUTINE /* CHECK
*
************************************************************************
DEFINE SUBROUTINE ASSIGN-ATTRIBUTE-VALUES
************************************************************************
/* assign general attributes
BUNDLES.B-BUNDLE           := NOBN-BUNDLE
BUNDLES.B-USERID           := ES-USER
BUNDLES.B-DESC             := NOBN-DESC
BUNDLES.B-COORDINATOR-ID   := NOBN-COORDINATOR-ID
BUNDLES.B-BUNDLE-STATUS    := NOBN-TYPE
NOBN-TYPE-ACTIVE           := 'Y'
BUNDLES.B-LAST-MODIFIED    := *TIMX
MOVE EDITED B-LAST-MODIFIED (EM=YYYYMMDDHHIISST) TO NOBN-LAST-MODIFIED
BUNDLES.B-MODIFIED-BY      := ES-USER
BUNDLES.B-RETENTION-ACTION := NOBN-RETENTION-ACTION
BUNDLES.B-LAST-UPDATE      := *TIMX /*SU1
BUNDLES.B-LAST-UPDATE-USER := ES-USER /*SU1
RESET #RET-PERIOD
IF NOBN-RETENTION-NUMBER = 0 AND NOBN-RETENTION-FACTOR = ' ' AND
    NOBN-RETENTION-CALENDAR = ' '
  RESET BUNDLES.B-RETENTION-PERIOD
ELSE
  #RET-NUMBER := NOBN-RETENTION-NUMBER
  #RET-FACTOR := NOBN-RETENTION-FACTOR
  #RET-CALENDAR := NOBN-RETENTION-CALENDAR
  BUNDLES.B-RETENTION-PERIOD := #RET-PERIOD
END-IF
RESET #RET-PERIOD
IF NOBN-RET-PURGE-NUMBER = 0 AND NOBN-RET-PURGE-FACTOR = ' ' AND
    NOBN-RET-PURGE-CALENDAR = ' '
  RESET BUNDLES.B-RETENTION-PERIOD-PURGE
ELSE
  #RET-NUMBER := NOBN-RET-PURGE-NUMBER
  #RET-FACTOR := NOBN-RET-PURGE-FACTOR
  #RET-CALENDAR := NOBN-RET-PURGE-CALENDAR
  BUNDLES.B-RETENTION-PERIOD-PURGE := #RET-PERIOD
END-IF
#TIME-P                       := NOBN-FLUSH-TIME-N
BUNDLES.B-FLUSH-TIME          := #TIME
BUNDLES.B-FLUSH-TIME-SCHEDULE := NOBN-FLUSH-TIME-SCHEDULE
BUNDLES.B-FLUSH-REPORTS(*)    := NOBN-FLUSH-REPORTS(*)
*
BUNDLES.B-FLUSH-LINES         := NOBN-FLUSH-LINES
BUNDLES.B-FLUSH-START         := NOBN-FLUSH-START
BUNDLES.B-FLUSH-END           := NOBN-FLUSH-END
BUNDLES.B-FLUSH-INT           := NOBN-FLUSH-INT
BUNDLES.B-FLUSH-CALENDAR      := NOBN-FLUSH-CALENDAR
BUNDLES.B-FLUSH-BEFORE-AFTER  := NOBN-FLUSH-BEFORE-AFTER
BUNDLES.B-FLUSH-DAYS(1:31)    := NOBN-FLUSH-DAYS(1:31)
BUNDLES.B-FLUSH-WEEK-DAYS(1:7):= NOBN-FLUSH-WEEK-DAYS(1:7)
/* assign printing attributes
BUNDLES.B-HOLD                := NOBN-HOLD-PRINT
FOR #I=1 TO #MAX-PRINTER
  IF NOBN-PRINTER(#I)  = ' '
    RESET BUNDLES.B-PRINTER(#I) BUNDLES.B-PRINTER-COPIES(#I)
  ELSE
    BUNDLES.B-PRINTER(#I)         := NOBN-PRINTER(#I)
    IF NOBN-PRINT-COPIES(#I) = 0
      BUNDLES.B-PRINTER-COPIES(#I):= #DEF-COPIES
    ELSE
      BUNDLES.B-PRINTER-COPIES(#I):= NOBN-PRINT-COPIES(#I)
    END-IF
  END-IF
END-FOR
BUNDLES.B-FLAG-REPSEP := NOBN-FLAG-REPSEP
BUNDLES.B-SEPSTART := NOBN-SEP-START
BUNDLES.B-SEPEND   := NOBN-SEP-END
BUNDLES.B-SEPNO := NOBN-SEPARATOR-COPIES
BUNDLES.B-CONTROL-EXITLIB    := NOBN-CONTROL-EXITLIB
BUNDLES.B-CONTROL-EXITMEM    := NOBN-CONTROL-EXITMEM
BUNDLES.B-PRINT-JOBCARD(1:3) := NOBN-PRINT-JOBCARD(1:3)
*
END-SUBROUTINE /* ASSIGN-ATTRIBUTE-VALUES
*
************************************************************************
DEFINE SUBROUTINE VALIDATION-S
************************************************************************
PERFORM VALIDATION
ES-CONTROL := #ES-CONTROL
ES-INPUT-AREA(*) := #ES-INPUT-AREA(*)
*
END-SUBROUTINE /* VALIDATION-S
*
************************************************************************
DEFINE SUBROUTINE VALIDATION
************************************************************************
RESET #ES-MSG-NR #ES-MSG-FIELD
/* validation of general attributes
DECIDE FOR FIRST CONDITION
  WHEN NOBN-BUNDLE = ' '
    #ES-MSG-NR := 0042            /* bundle name is required
    #ES-MSG-FIELD-NAME := 'BUNDLE'
  WHEN NOBN-BUNDLE NE MASK (P........................)
    #ES-MSG-NR := 0019           /* name must start with letter
    #ES-MSG-FIELD-NAME := 'BUNDLE'
  WHEN ANY
    ESCAPE ROUTINE
  WHEN NONE IGNORE
END-DECIDE
IF NOT (NOBN-TYPE = 'S' OR = 'M')
  NOBN-TYPE := 'M'
END-IF
*
IF NOBN-RET-PURGE-NUMBER = 0
  IF (NOBN-RET-PURGE-FACTOR NE ' ' OR
      NOBN-RET-PURGE-CALENDAR NE ' ')
    #ES-MSG-NR := 0415          /* enter period
    #ES-MSG-FIELD-NAME := 'RET-PURGE-NUMBER'
    ESCAPE ROUTINE
  END-IF
ELSE
  IF NOT (NOBN-RET-PURGE-FACTOR = 'W' OR ='A' OR ='V' OR ='M')
    #ES-MSG-NR := 1087
    #ES-MSG-FIELD-NAME := 'RET-PURGE-FACTOR'
    ESCAPE ROUTINE
  END-IF
  IF NOBN-RET-PURGE-FACTOR = 'W' AND NOBN-RET-PURGE-CALENDAR = ' '
    #ES-MSG-NR := 2003
    #ES-MSG-FIELD-NAME := 'RET-PURGE-CALENDAR'
    ESCAPE ROUTINE
  END-IF
END-IF
/* check user existance
IF NOBN-COORDINATOR-ID > ' '
  IF NOT (NOMOD-USER-AUTODEF = 'P' OR = 'Y')
    ES-OBJECT := 'US'
    ES-FUNCTION := 'EX'
    ES-KEY-PARM(1) := NOBN-COORDINATOR-ID
    CALLNAT 'NOXXEX-N' ES-CONTROL ES-INPUT
    IF ES-RC NE 0
      #ES-MSG-NR := 0002
      #ES-MSG-FIELD-NAME := 'COORDINATOR-ID'
      ESCAPE ROUTINE
    END-IF
  END-IF
ELSE
  NOBN-COORDINATOR-ID := ES-USER
END-IF
/* check calendar existance
IF NOBN-RET-PURGE-CALENDAR NE ' '
  NOBN-RET-PURGE-FACTOR := 'W'
  ES-OBJECT   := 'CA'
  ES-FUNCTION := 'EX'
  #CA-ID := NOBN-RET-PURGE-CALENDAR
  ES-KEY-PARM(1) := #CALENDAR-ID
  CALLNAT 'NOXXEX-N' ES-CONTROL ES-INPUT
  IF ES-RC NE 0
    #ES-MSG-NR := 2004
    #ES-MSG-FIELD-NAME := 'RET-PURGE-CALENDAR'
    ESCAPE ROUTINE
  END-IF
END-IF
IF NOBN-RETENTION-NUMBER = 0
  IF NOBN-RETENTION-FACTOR NE ' ' OR NOBN-RETENTION-CALENDAR NE ' '
    #ES-MSG-NR := 0415
    #ES-MSG-FIELD-NAME := 'RETENTION-NUMBER'
    ESCAPE ROUTINE
  END-IF
ELSE
  IF NOT (NOBN-RETENTION-FACTOR='W' OR ='A' OR ='V' OR ='M')
    #ES-MSG-NR := 1087
    #ES-MSG-FIELD-NAME := 'RETENTION-FACTOR'
    ESCAPE ROUTINE
  END-IF
  IF NOBN-RETENTION-FACTOR = 'W' AND NOBN-RETENTION-NUMBER > 0 AND
      NOBN-RETENTION-CALENDAR = ' '
    #ES-MSG-NR := 2003
    #ES-MSG-FIELD-NAME := 'RETENTION-CALENDAR'
    ESCAPE ROUTINE
  END-IF
END-IF
/* check calendar existance
IF NOBN-RETENTION-CALENDAR NE ' '
  NOBN-RETENTION-FACTOR := 'W'
  ES-OBJECT   := 'CA'
  ES-FUNCTION := 'EX'
  #CA-ID := NOBN-RETENTION-CALENDAR
  ES-KEY-PARM(1) := #CALENDAR-ID
  CALLNAT 'NOXXEX-N' ES-CONTROL ES-INPUT
  IF ES-RC NE 0
    #ES-MSG-NR := 2004
    #ES-MSG-FIELD-NAME := 'RETENTION-CALENDAR'
    ESCAPE ROUTINE
  END-IF
END-IF
IF NOBN-FLUSH-REPORTS(*) NE ' '
  FOR #I = 1 TO 10
    IF NOBN-FLUSH-REPORTS(#I) NE ' '
      IF NOBN-ADD-FLUSH-REP(#I) NE 'Y'
        FNUM. FIND NUMBER REPORTS WITH R-REPNAME =NOBN-FLUSH-REPORTS(#I)
        IF *NUMBER(FNUM.) = 0
          #ES-MSG-NR := 0490
          #ES-MSG-FIELD-NAME := 'FLUSH-REPORTS'
          #ES-MSG-FIELD-INDEX := #I
          ESCAPE ROUTINE
        END-IF
      END-IF
      #BR-BUNDLE := NOBN-BUNDLE
      #BR-REPORT := NOBN-FLUSH-REPORTS(#I)
      FIND BUNDLE-REPORT WITH BR-BUNDLE-REPORT = #BR-BUNDLE-REPORT
        IF NO RECORDS FOUND
          BR-BUNDLE  := NOBN-BUNDLE
          BR-REPNAME := NOBN-FLUSH-REPORTS(#I)
          BR-SEQNO   := 1
          BR-GROUP   := SUBSTR(NOBN-BUNDLE,1,8)
          IF BUNDLES.B-FLAG-REPSEP = 'Y'
            BR-SEPNO := 1
          END-IF
          STORE BUNDLE-REPORT
        END-NOREC
      END-FIND
    END-IF
  END-FOR
END-IF
/* validate schedule
RESET #TEMP-TIME
DECIDE FOR EVERY CONDITION
  WHEN NOBN-FLUSH-END > ' '
    #TEMP-TIME := NOBN-FLUSH-END
    IF NOT(#TEMP-HH = MASK(00:23) AND #TEMP-II = MASK(00:59))
      #ES-MSG-NR := 0051
      #ES-MSG-FIELD-NAME := 'FLUSH-END'
      ESCAPE ROUTINE
    END-IF
  WHEN NOBN-FLUSH-START > ' '
    #TEMP-TIME := NOBN-FLUSH-START
    IF NOT(#TEMP-HH = MASK(00:23) AND #TEMP-II = MASK(00:59))
      #ES-MSG-NR := 0051
      #ES-MSG-FIELD-NAME := 'FLUSH-START'
      ESCAPE ROUTINE
    END-IF
  WHEN NOBN-FLUSH-INT > ' '
    #TEMP-TIME := NOBN-FLUSH-INT
    IF NOT(#TEMP-HH = MASK(00:23) AND #TEMP-II = MASK(00:59))
      #ES-MSG-NR := 0051
      #ES-MSG-FIELD-NAME := 'FLUSH-INT'
      ESCAPE ROUTINE
    END-IF
  WHEN NONE IGNORE
END-DECIDE
IF NOBN-FLUSH-END > ' ' AND NOBN-FLUSH-START > ' ' AND
    NOBN-FLUSH-START > NOBN-FLUSH-END
  #ES-MSG-NR := 0055 /* 'from time' should be less than 'to time'
  #ES-MSG-FIELD-NAME := 'FLUSH-START'
  ESCAPE ROUTINE
END-IF
IF NOBN-FLUSH-DAYS(*) NE ' ' AND NOBN-FLUSH-WEEK-DAYS(*) NE ' '
  #ES-MSG-NR := 0630   /* don't specify weekly and monthly type
  #ES-MSG-FIELD-NAME := 'FLUSH-DAYS'
  #ES-MSG-FIELD-INDEX := 1
  ESCAPE ROUTINE
END-IF
IF NOBN-FLUSH-CALENDAR > ' '
  ES-OBJECT   := 'CA'
  ES-FUNCTION := 'EX'
  #CA-ID := NOBN-FLUSH-CALENDAR
  ES-KEY-PARM(1) := #CALENDAR-ID
/* Check calendar existance
  CALLNAT 'NOXXEX-N' ES-CONTROL ES-INPUT
  IF ES-RC NE 0
    #ES-MSG-NR := 2004
    #ES-MSG-FIELD-NAME := 'FLUSH-CALENDAR'
    ESCAPE ROUTINE
  END-IF
END-IF
DECIDE FOR FIRST CONDITION
  WHEN NOBN-FLUSH-BEFORE-AFTER >  ' '
    IF NOBN-FLUSH-CALENDAR = ' '
      #ES-MSG-NR := 2010   /* please enter calendar
      #ES-MSG-FIELD-NAME := 'FLUSH-CALENDAR'
      ESCAPE ROUTINE
    END-IF
  WHEN NOBN-FLUSH-BEFORE-AFTER = ' ' AND NOBN-FLUSH-CALENDAR > ' '
    #ES-MSG-NR := 0061
    #ES-MSG-FIELD-NAME := 'FLUSH-BEFORE-AFTER'
    ESCAPE ROUTINE
  WHEN NOBN-FLUSH-WEEK-DAYS(*) NE ' '
    FOR #I = 1 TO 7
      IF NOBN-FLUSH-WEEK-DAYS(#I) > ' ' AND
          NOT (NOBN-FLUSH-WEEK-DAYS(#I)= 'SA' OR ='SU' OR ='MO'
          OR ='TU' OR ='WE' OR ='TH' OR ='FR')
        #ES-MSG-NR := 0057             /* invalid week days
        #ES-MSG-FIELD-NAME := 'FLUSH-WEEK-DAYS'
        #ES-MSG-FIELD-INDEX := #I
        ESCAPE ROUTINE
      END-IF
    END-FOR
  WHEN NOBN-FLUSH-DAYS(*) NE ' '
    FOR #I = 1 TO 31
      IF NOBN-FLUSH-DAYS(#I) = ' ' OR = 'ALL' OR = 'LD'
        ESCAPE TOP
      END-IF
      MOVE NOBN-FLUSH-DAYS(#I) TO #ADAY
      IF NOT(#ADAY IS (N2) )
        #ES-MSG-NR := 2102     /* enter valid monthly day
        #ES-MSG-FIELD-NAME := 'FLUSH-DAYS'
        #ES-MSG-FIELD-INDEX := #I
        ESCAPE ROUTINE
      END-IF
      #NDAY := VAL(#ADAY)
      IF NOT #NDAY = 1 THRU 31
        #ES-MSG-NR := 2102
        #ES-MSG-FIELD-NAME := 'FLUSH-DAYS'
        #ES-MSG-FIELD-INDEX := #I
        ESCAPE ROUTINE
      END-IF
    END-FOR
  WHEN NONE IGNORE
END-DECIDE
/* validate printing attributes
CALLNAT 'N-SEPME2' ES-CONTROL ES-INPUT NOBN-SEP-START 1X /*SU3
  NOBN-SEP-END 1X 'B' #ES-MSG-NR #ES-MSG-FIELD-NAME
IF #ES-MSG-NR NE 0
  ESCAPE ROUTINE
END-IF
IF NOBN-CONTROL-EXITMEM NE ' ' AND NOBN-CONTROL-EXITLIB = ' '
  #ES-MSG-NR := 1080      /* enter NATURAL library name
  #ES-MSG-FIELD-NAME := 'CONTROL-EXITLIB'
  ESCAPE ROUTINE
END-IF
IF NOBN-CONTROL-EXITMEM = ' ' AND NOBN-CONTROL-EXITLIB NE ' '
  #ES-MSG-NR := 4101  /* no exit member defined
  #ES-MSG-FIELD-NAME := 'CONTROL-EXITMEM'
  ESCAPE ROUTINE
END-IF
IF NOBN-CONTROL-EXITMEM NE ' ' AND NOBN-CONTROL-EXITLIB NE ' '
  ES-KEY-PARM(1) := NOBN-CONTROL-EXITLIB
  ES-KEY-PARM(2) := NOBN-CONTROL-EXITMEM
  CALLNAT 'NOSFEX-N' ES-CONTROL ES-INPUT
  IF ES-RC NE 0
    #ES-MSG-NR  := 1079      /*  Library or member not found
    #ES-MSG-FIELD-NAME := 'CONTROL-EXITLIB'
    #ES-MSG-TXT := NOBN-CONTROL-EXITMEM /* NOMALL-936 in
    ESCAPE ROUTINE
  END-IF
END-IF
FOR #I=1 TO #MAX-PRINTER
  IF NOBN-PRINTER(#I) = ' '
    RESET NOBN-PRINT-COPIES(#I)
  ELSE
    EXAMINE FULL NOBN-PRINTER(*) FOR FULL VALUE OF NOBN-PRINTER(#I)
      GIVING NUMBER IN #F
    IF #F > 1
      #ES-MSG-NR := 0104   /* printer already defined
      #ES-MSG-FIELD-NAME  := 'PRINT-LIST'
      #ES-MSG-FIELD-INDEX := #I
      ESCAPE ROUTINE
    END-IF
    ES-KEY-PARM(1) := NOBN-PRINTER (#I)
    ES-OBJECT := 'PR'
    ES-FUNCTION := 'EX'
/* check printer existance
    CALLNAT 'NOXXEX-N' ES-CONTROL ES-INPUT
    IF ES-RC NE 0
      #ES-MSG-NR := 0108   /* printer not defined
      #ES-MSG-FIELD-NAME  := 'PRINT-LIST'
      #ES-MSG-FIELD-INDEX := #I
      ESCAPE ROUTINE
    END-IF
    IF ES-USER-TYPE NE 'A'
      #GR-OBJECT := NOBN-PRINTER(#I)
      CALLNAT 'NOGRRU-N' 'P' #GR-OBJECT ES-USER #GR-USER #GRANTED
      IF NOT #GRANTED
        #ES-MSG-NR := 1090
        #ES-MSG-FIELD-NAME  := 'PRINT-LIST'
        #ES-MSG-FIELD-INDEX := #I
        ESCAPE ROUTINE
      END-IF
    END-IF
  END-IF
END-FOR
*
END-SUBROUTINE /* VALIDATION
*
************************************************************************
DEFINE SUBROUTINE GET-OPTIONS
************************************************************************
NOBN-OPTIONS (*) := ' '
FBR. FIND NUMBER BUNDLE-REPORT WITH BR-BUNDLE = BUNDLES.B-BUNDLE
IF *NUMBER(FBR.) > 0
  NOBN-REP-NUMBER  := *NUMBER(FBR.)
ELSE
  RESET NOBN-REP-NUMBER
  NOBN-OPTIONS (1) := 'LR'
  NOBN-OPTIONS (2) := 'SS'
END-IF
IF ES-USER-TYPE NE 'A'
  CALLNAT 'NOGROU-N' 'B' BUNDLES.B-BUNDLE ES-USER NOBN-AUTH #GRANTS(*)
  IF #GRANTS(1) NE 'Y' AND #GRANTS(3) NE 'Y'
    NOBN-OPTIONS(3) := 'DL'
  END-IF
ELSE
  NOBN-AUTH := 'ADMIN'
END-IF
*
END-SUBROUTINE /* GET-OPTIONS
*
************************************************************************
DEFINE SUBROUTINE GET-MSG-TXT
************************************************************************
RESET SHORT-MSG LONG-MSG(*)
VERSION := 0
NADA2000.OBJECT-KIND := 'U'
NADA2000.ERROR-NUMBER := #ES-MSG-NR
NADA2000.OPT-INSERT-DYN := FALSE
NADA2000.OPT-LANGUAGE := ES-LANGUAGE
NADA2000.LIBRARY := #APPLIB
CALLNAT 'NATA2000' NADA2000 NATA2000.EXTENDED-PARMS NAD-MSG NAD-FLD
ES-MSG-NR    := #ES-MSG-NR
ES-MSG-TXT   := SHORT-MSG
EXAMINE ES-MSG-TXT FOR #ES-MSG-PREF DELETE
EXAMINE ES-MSG-TXT FOR ':1:' REPLACE ' '
EXAMINE ES-MSG-TXT FOR ':2:' REPLACE ' '
ES-MSG-FIELD := #ES-MSG-FIELD
ES-RC := 1
*
END-SUBROUTINE /* GET-MSG-TXT
*
************************************************************************
DEFINE SUBROUTINE WRITE-LOG-RECORD
************************************************************************
IF NOMOD-LOG-TYPES (*) = 'B'
  DECIDE ON FIRST ES-EXTEND-FUNCTION
    VALUE 'NEW'
      COMPRESS '2505' NOBN-BUNDLE TO LG-MSG
    VALUE 'UPD'
      COMPRESS '2506' NOBN-BUNDLE TO LG-MSG
    ANY VALUE
      LG-USERID      := ES-USER
      LG-CODE        := 'BM'
      LG-BUNDLE      := NOBN-BUNDLE
      LG-OBJECT-NAME := NOBN-BUNDLE
      CALLNAT 'NOLG---N' PL-PARMS #USER-LIB
    NONE VALUE IGNORE
  END-DECIDE
END-IF
*
END-SUBROUTINE /* WRITE-LOG-RECORD
*
END
