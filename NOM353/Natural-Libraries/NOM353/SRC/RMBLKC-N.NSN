*
************************************************************************
* Main line
************************************************************************
*
PERFORM INIT-FUNCTION
*
IF P-ERROR-CODE = 0
  PERFORM BUILD-BLOCK-CHARACTER-LINE
END-IF
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE INIT-FUNCTION
************************************************************************
IF NOT (RMBLKC-IND = 1 THRU 12)
  P-ERROR-CODE := 0005
  P-ERROR-TEXT := 'Invalid Line Range'
  ESCAPE ROUTINE
END-IF
*
IF NOT (RMBLKC-IN-LENGTH = 1 THRU 17)
  RMBLKC-IN-LENGTH := 17
END-IF
*
IF NOT (RMBLKC-OUT-LENGTH = 1 THRU 251)
  RMBLKC-OUT-LENGTH := 251
END-IF
*
FOR I = 1 TO RMBLKC-IN-LENGTH
  IF RMBLKC-IN-S (I) NE ' '
    EXAMINE BLK-CHAR (*) FOR RMBLKC-IN-S (I) GIVING INDEX IN J
    IF J > 0
      #POS (I) := J
    END-IF
  END-IF
END-FOR
*
END-SUBROUTINE /* INIT-FUNCTION
*
************************************************************************
DEFINE SUBROUTINE BUILD-BLOCK-CHARACTER-LINE
************************************************************************
IF NOT(#POS (1:RMBLKC-IN-LENGTH) NE 0)
  ESCAPE ROUTINE
END-IF
*
J := 1
RESET  P-OUT-STRING
*
FOR. FOR I = 1 TO RMBLKC-IN-LENGTH
  IF #POS (I) NE 0
    PERFORM BLOCK-CHARACTER-TO-STRING
  ELSE
    J := J + 14
  END-IF
  IF J > RMBLKC-OUT-LENGTH
    ESCAPE BOTTOM (FOR.)
  END-IF
END-FOR
*
END-SUBROUTINE /* BUILD-BLOCK-CHARACTER-LINE
*
************************************************************************
DEFINE SUBROUTINE BLOCK-CHARACTER-TO-STRING
************************************************************************
PERFORM INDICATE-START-POSITION
*
FOR K = 1 TO 14
  J := J + 1
  IF J > RMBLKC-OUT-LENGTH
    ESCAPE BOTTOM
  END-IF
  IF K < 13
    MOVE BITS TO INT1
    INT1 := INT1 * 2
    MOVE INT1 TO BITS
    IF FIRST = 1
      P-OUT-S (J) := RMBLKC-IN-S (I)
    END-IF
    RESET FIRST
    T := T - 1
    IF T < 1 AND B < 18
      T := 8
      B := B + 1
      SECOND := BLK-BYTE (U, B)
    END-IF
  END-IF
END-FOR
*
END-SUBROUTINE /* BLOCK-CHARACTER-TO-STRING
*
************************************************************************
DEFINE SUBROUTINE INDICATE-START-POSITION
************************************************************************
S := ((RMBLKC-IND - 1) * 12) + 1
DIVIDE 8 INTO S GIVING B REMAINDER R
T := 8
U := #POS (I)
R := R - 1
B := B + 1
SECOND := BLK-BYTE (U, B)
REPEAT
  UNTIL R < 1
  MOVE BITS TO INT1
  INT1 := INT1 * 2
  MOVE INT1 TO BITS
  RESET FIRST
  T := T - 1
  R := R - 1
END-REPEAT
*
END-SUBROUTINE /* INDICATE-START-POSITION
*
END
