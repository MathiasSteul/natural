* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
************************************************************************
* Subprogram N-IDENT
* Version    3.5
* Function   Build ident tab for jobname for scan pgms
*   Example: for input Jobname=JOBNAME, output is:
*    'JOBNAME'
*    'JOBNAME*'
*    'JOBNAM* '
*    'JOBNA*  '
*    'JOBN*   '
*    'JOB*    '
*    'JO*     '
*    'J*      '
*    '*       '
*
* ----------------------------------------------------------------------
* Maintenance
* -----------
* user    yyyy-mm-dd iTrac       Remark
* SU      2018-08-08 NOMALL-2133 Created
************************************************************************
*
DEFINE DATA
PARAMETER
1 #JOBNAME           (A8) BY VALUE /*only IN because it is changed
1 REDEFINE #JOBNAME
  2 #JN              (A1/1:8)
1 #TJ                (I2)
1 #IDENT-TYPE-IN     (I2)
1 #IDENT-TYPE        (I2/1:12)
1 #IDENT-VALUE       (A8/1:12)
1 #TRACING           (L)
1 G-TRACE-MSG        (A250)
************************************************************************
LOCAL
1 #TL                (I2)
1 #I                 (I2)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
EXAMINE #JOBNAME FOR ' ' GIVING LENGTH IN #TL
IF #TL = 0
  ESCAPE ROUTINE
END-IF
IF #TL < 8
  ADD 1 TO #TL
END-IF
IF #TRACING
  COMPRESS G-TRACE-MSG 'ID type:' #IDENT-TYPE-IN
    TO G-TRACE-MSG LEAVING NO
END-IF
PERFORM ADD-ENTRY /*name without '*'
FOR #I = #TL TO 1 STEP -1
  #JN (#I) := '*'
  IF #I < 8
    RESET #JN (#I + 1)
  END-IF
  PERFORM ADD-ENTRY
END-FOR
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE ADD-ENTRY
************************************************************************
ADD 1 TO #TJ
#IDENT-VALUE (#TJ) := #JOBNAME
#IDENT-TYPE  (#TJ) := #IDENT-TYPE-IN
IF #TRACING
  COMPRESS G-TRACE-MSG '/' #IDENT-VALUE(#TJ) TO G-TRACE-MSG LEAVING NO
END-IF
*
END-SUBROUTINE /*ADD-ENTRY
*
END
