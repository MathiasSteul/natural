* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RMFLNF-N - Get attributes for flush via NAF
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* mrs 93-11-02 s(999999) created
* xsetggr 2004-11-23 p(258871) recat due to changes in rmfl---p
* xsetggr 2007-05-02 NOM3201   Support 5 byte node numbers
* fhi     2010-09-03 NOMALL-97 Extend message line
* xsetggr 2010-12-21 NOMALL-865 restow due to changes in RMFL---P
* ----------------------------------------------------------------------
DEFINE DATA
PARAMETER USING RMFL---P
PARAMETER
1 P-ERROR-CODE        (N4)
1 P-ERROR-TEXT        (A250)
************************************************************************
LOCAL
1 PRINTOUT  VIEW  OF  NRM-PRINTOUTS
  2 PO-ATTRIBUTES     (1:25)
  2 REDEFINE PO-ATTRIBUTES
    3 PO-ATTRIB       (1:25)
      4 PO-IDENT      (I1)
      4 PO-LENGTH     (N2)
      4 PO-PROMPT     (N4)
      4 PO-VAR        (A16)
      4 PO-VALUE      (A72)
  2 C*PO-ATTRIBUTES
1 F                   (I2)
1 NOE                 (I2)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET P-ERROR-CODE P-ERROR-TEXT
*
PERFORM READ-PRINTOUT-RECORD
IF P-ERROR-CODE = 0
  PERFORM NAF-INTERFACE
END-IF
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE READ-PRINTOUT-RECORD
************************************************************************
FNDPR. FIND PRINTOUT WITH PO-ID = FLUSH-POID
  IF NO RECORDS FOUND
    P-ERROR-CODE := 0005
    P-ERROR-TEXT := 'Printout Record not found'
    ESCAPE BOTTOM (FNDPR.)
  END-NOREC
END-FIND
*
END-SUBROUTINE /* READ-PRINTOUT-RECORD
*
************************************************************************
DEFINE SUBROUTINE NAF-INTERFACE
************************************************************************
RESET  NAF-ATTRIBUTES
NAF-COPIES := FLUSH-COPIES
*
IF PRINTOUT.C*PO-ATTRIBUTES > 25
  NOE := 25
ELSE
  NOE := PRINTOUT.C*PO-ATTRIBUTES
END-IF
*
FOR F = 1 TO NOE
  DECIDE ON FIRST PO-VAR (F)
    VALUE 'LPF'     NAF-LPF     := PO-VALUE (F)
    VALUE 'PROFILE' NAF-PROFILE := PO-VALUE (F)
    VALUE 'FORMS'   NAF-FORMS   := PO-VALUE (F)
    VALUE 'NAME'    NAF-NAME    := PO-VALUE (F)
    VALUE 'DISP'    NAF-DISP    := PO-VALUE (F)
    NONE IGNORE
  END-DECIDE
END-FOR
*
END-SUBROUTINE /* NAF-INTERFACE
*
END
