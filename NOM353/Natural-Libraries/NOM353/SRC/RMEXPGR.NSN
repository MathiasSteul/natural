************************************************************************
* RMEXPGR - export GRantings
*
* Maintenance
* User  yyyy-mm-dd Issue       Remark
* ----- ---------- ----------- -----------------------------------------
*       2019-02-22 generated   Created for RMEXPFOL from RMLD2XML
* SU1   2015-09-15 NOMALL-1693 NAT00059(A80)->NAT41002(A253)
* fhi   2019-02-19 NOMALL-2215 Export not complete
* BLI   2019-05-06 NOMALL-2261 Recataloged due to changes of XXUX---P
* SU2   2020-11-10 NOMALL-2440 split DDM -> NRM-MF-NODES
* SU3   2021-02-18 NOMALL-2443 restruct+MSG
* GGS01 2021-07-06 NOMALL-2474 RECAT since RMEXP-C changed
* SU4   2021-08-18 NOMALL-2467 RMEXPGRL
************************************************************************
DEFINE DATA
PARAMETER USING XXUX---P
PARAMETER USING RMEXP-A
PARAMETER
1 #TRACING               (L)
1 #ID                    (A250) BY VALUE OPTIONAL
/***********************************************************************
/*SU4 LOCAL USING RMEXPGRL
LOCAL USING RMBAS64P
LOCAL USING VUXDEF-L
/*SU2 LOCAL USING VMONITUL /* NOMALL-2215 fhi in
LOCAL USING N-41002L /*SU1
/***********************************************************************
LOCAL
1 GR VIEW OF NRM-GRANTS /*was RMEXPGR
  2 GR-SYSTEM-OBJECT-TYPE (A10)
  2 GR-SYSTEM-OBJECT-TIME (T)
  2 GR-TYPE-OBJ-USER      (A34)
  2 GR-OBJECT-TYPE        (A1)
  2 GR-USERID             (A8)
  2 GR-OBJECT-NAME        (A25)
  2 GR-OPTION             (A1/1:6)
1 WRITE-FILE VIEW OF WRITE-FILE
  2 ERROR-CODE
  2 ERROR-TEXT
*
1 #FIELD                 (A32)
1 #VALUE                 (A300)
1 #LEN                   (I4)
1 #WORK-LINE             (A250)
1 #FUNCTION              (A10)
1 #I                     (I4)
1 #J                     (I4)
1 #K                     (I4)
1 #L                     (I4)
1 #PROGRAM               (A8) INIT <*PROGRAM>
1 REDEFINE #PROGRAM
  2 FILLER               5X /*RMEXP
  2 #TYPE                (A2)
1 #KEY                   (A100)
1 #KEY-FROM              (A100)
1 #KEY-TO                (A100) INIT FULL LENGTH <H'FF'>
1 #KEY-MASK              (A25)
/*SU4 1 #KEY-LEN               (I2)
1 #KEY-LEN2              (I2) CONST <26> /*len1.+2. GR-TYPE-OBJ-USER SU4
  /*see RMLD2XC3:GR-OBJECT-TYPE(1-1)+GR-OBJECT-NAME(1-25)=26
1 #TRACE-MSG             (A250)
1 #POS                   (I4)
1 #DEP                   (A5)
1 #NODE                  (N5)
1 #MASK                  (A300) INIT FULL LENGTH <'P'>
1 #PRINTABLE             (A300)
1 #GR-SYSTEM-OBJECT-TIME (A21)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
PERFORM #START
READ GR BY GR-TYPE-OBJ-USER = #KEY-FROM THRU #KEY-TO
  #KEY := GR-TYPE-OBJ-USER
  PERFORM HANDLE-MASK
  COMPRESS '<GR depending="' #DEP '">' TO #WORK-LINE LEAVING NO
  PERFORM WRITE-XML
  IF #OD-LOG = 'Y'
    IF #ID SPECIFIED
      COMPRESS 'Exported: GR */' GR-TYPE-OBJ-USER TO #TRACE-MSG
    ELSE
      COMPRESS 'Exported: GR /' GR-TYPE-OBJ-USER TO #TRACE-MSG
    END-IF
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    END TRANSACTION
  END-IF
  MOVE EDITED GR.GR-SYSTEM-OBJECT-TIME (EM=YYYY'-'MM'-'DD'-'HH':'II':'SS'.'T)
    TO #GR-SYSTEM-OBJECT-TIME
  #FIELD := 'GR-SYSTEM-OBJECT-TYPE'
  #VALUE :=  GR.GR-SYSTEM-OBJECT-TYPE
  PERFORM CONVERT-XML
  #FIELD := 'GR-SYSTEM-OBJECT-TIME'
  #VALUE :=  #GR-SYSTEM-OBJECT-TIME
  PERFORM CONVERT-XML
  #FIELD := 'GR-TYPE-OBJ-USER'
  #VALUE :=  GR.GR-TYPE-OBJ-USER
  PERFORM CONVERT-XML
  #FIELD := 'GR-OBJECT-TYPE'
  #VALUE :=  GR.GR-OBJECT-TYPE
  PERFORM CONVERT-XML
  #FIELD := 'GR-USERID'
  #VALUE :=  GR.GR-USERID
  PERFORM CONVERT-XML
  #FIELD := 'GR-OBJECT-NAME'
  #VALUE :=  GR.GR-OBJECT-NAME
  PERFORM CONVERT-XML
  FOR #L := 6 TO 1 STEP -1
    IF GR.GR-OPTION (#L) NE ' '
      ESCAPE BOTTOM
    END-IF
  END-FOR
  FOR #I = 1 TO #L
    #FIELD := 'GR-OPTION'
    #VALUE :=  GR.GR-OPTION(#I)
    PERFORM CONVERT-XML1
  END-FOR
*
  PERFORM #END-OBJ
END-READ
PERFORM #END
*
INCLUDE RMEXP-C /*CALL-NPR, WRITE-XML, OPEN-XML, CLOSE-XML
*
END
