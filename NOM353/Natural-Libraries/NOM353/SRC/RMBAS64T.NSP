* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RMBAS64T - Convert binary string to array of alpha lines in base64
*            and vice versa
* Sample program how to use the RMBASE64 subprogram. Not used by NOM.
*
* FHI, 05/2007
* Converts 200 times of hex string '0123456789ABCDEF' into base64,
* stores it in 2 arrays and converts these arrays back to the binary one
**********************************************************************
DEFINE DATA
LOCAL
* Parameters for RMBASE64N:
1 B64-PARMS
  2 B64-FUNCTION                    (A2)
  2 B64-RC                          (I4)
  2 B64-ERRTXT                      (A72)
  2 B64-BRACKET                     (A1)
  2 B64-A                           (A)   DYNAMIC
  2 B64-B                           (B)   DYNAMIC
  2 B64-TEXT-ARRAY                  (A251/*)
  2 B64-WORK                        (A250)
* Local variables
1 #I                                (P5)
1 #J                                (P5)
1 #OCC                              (I4)
1 #NUMBER                           (I4)
1 #STR                              (A)   DYNAMIC
END-DEFINE
*
* Fill binary field with binary values
*
FOR #I = 1 TO 120
  COMPRESS B64-B  H'0123456789ABCDEF'
    INTO B64-B LEAVING NO
END-FOR
WRITE 'Source string:' /
FOR #I = 1 TO *LENGTH(B64-B) STEP 32
  #NUMBER := 32
  IF #I + #NUMBER > *LENGTH(B64-B)
    #NUMBER := *LENGTH(B64-B) - #I + 1
  END-IF
  #STR := SUBSTR(B64-B,#I,#NUMBER)
  WRITE #STR (EM=H(32))
END-FOR
*
* Convert from binary to BASE64-text
*
FOR #I = 1 TO 3
  DECIDE ON FIRST VALUE OF #I
    VALUE 1
      B64-BRACKET        := 'F'
    VALUE 2
      B64-BRACKET        := 'M'
    VALUE 3
      B64-BRACKET        := 'L'
    NONE
      IGNORE
  END-DECIDE
  B64-FUNCTION       := 'BA'                /* convert bin to base64
  CALLNAT 'RMBAS64N' B64-PARMS
END-FOR
NEWPAGE
#OCC := *OCC(B64-TEXT-ARRAY)
WRITE '=' B64-FUNCTION / '=' B64-RC '=' B64-ERRTXT / '=' #OCC
FOR #I = 1 TO #OCC
  PRINT B64-TEXT-ARRAY (#I)
END-FOR
WRITE /
*
* Convert from BASE64-text to binary and display it
*
RESET B64-RC B64-ERRTXT B64-BRACKET B64-A B64-B B64-WORK
*
B64-FUNCTION    := 'AB'
CALLNAT 'RMBAS64N'  B64-PARMS
NEWPAGE
WRITE '=' B64-FUNCTION / '=' B64-RC '=' B64-ERRTXT /'Converted back to:'
FOR #I = 1 TO *LENGTH(B64-B) STEP 32
  #NUMBER := 32
  IF #I + #NUMBER > *LENGTH(B64-B)
    #NUMBER := *LENGTH(B64-B) - #I + 1
  END-IF
  #STR := SUBSTR(B64-B,#I,#NUMBER)
  WRITE #STR (EM=H(32))
END-FOR
END
