* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    NOMEXC06
* Version   1.3
* Function  Printout statistic exit
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* gw  96-10-18 s(999999) created
* fhi      2012-11-09 NOMALL-1143 Add cpu time output
* --------------------------------------- call statistic exit ----------
*
RESET NOMEX006-PARMS
*
NOMEX006-PRINTOUT-ID      := PO-UPD.PO-ID
NOMEX006-JOB-NAME         := PO-UPD.PO-JOBNAME
*
IF PO-UPD.PO-JOBNO NE 0
  NOMEX006-JOB-NUMBER    := PO-UPD.PO-JOBNO-A7
ELSE
  NOMEX006-JOB-NUMBER    := PO-UPD.PO-JOBID
END-IF
NOMEX006-TOTAL-LINES      := PO-UPD.PO-LAST-PRINTED-RECNO
IF PO-UPD.PO-BUNDLE NE ' '
  NOMEX006-NAME          := PO-UPD.PO-BUNDLE
  NOMEX006-RUN-NUMBER    := PO-UPD.PO-BUNDRNB
  NOMEX006-TYPE          := 'B'
ELSE
  NOMEX006-NAME          := PO-UPD.PO-REPNAME
  NOMEX006-RUN-NUMBER    := PO-UPD.PO-REPRNB
  NOMEX006-TYPE          := 'R'
END-IF
NOMEX006-PHYSICAL-PRINTER := PO-UPD.PO-PHYSICAL-NAME
NOMEX006-PRINTER-TYPE     := PO-UPD.PO-PRINTER-TYPE
NOMEX006-JCL-SKELETON     := PO-UPD.PO-JCL-SKELETON
NOMEX006-JOBCARD (*)      := PO-UPD.PO-JOBCARD (*)
NOMEX006-EXIT-MEMBER      := PO-UPD.PO-EXITMEM
NOMEX006-EXIT-LIBRARY     := PO-UPD.PO-EXITLIB
NOMEX006-LOGICAL-PRINTER  := PO-UPD.PO-LOGICAL
NOMEX006-USERID           := PO-UPD.PO-USERID
NOMEX006-ESY-USERID       := PO-UPD.PO-ESY-USERID
NOMEX006-CREATED          := PO-UPD.PO-CREATED
NOMEX006-SCHEDULED        := PO-UPD.PO-SCHEDULED
NOMEX006-PRINTED          := PO-UPD.PO-PRINTED
NOMEX006-LANGUAGE         := PO-UPD.PO-LANGUAGE
NOMEX006-COPIES           := PO-UPD.PO-COPIES
*
* fhi      2012-11-09 NOMALL-1143 start insertion
IF G-TRACE > 1
  RMSETTIM.FUNCTION := 'S'
  PERFORM RMSETTIM-SETTIME RMSETTIM
END-IF
* fhi      2012-11-09 NOMALL-1143 end   insertion
CALLNAT 'NOMEX006'
  USING NOMEX006-PARMS
* fhi      2012-11-09 NOMALL-1143 start insertion
IF G-TRACE > 1
  RMSETTIM.FUNCTION := 'G'
  PERFORM RMSETTIM-SETTIME RMSETTIM
  PERFORM XXRLOG-WRITE-LOG 'T' RMSETTIM.MSG
END-IF
*
* fhi      2012-11-09 NOMALL-1143 end   insertion
*
* ----------------------------------------------------------------------
