DEFINE DATA LOCAL
/* >Natural Source Header 000000
/* :Mode S
/* :CP
/* <Natural Source Header
*   RMSR3--L - Source Attribute      Definition
*   Covers Node number to N5 Format.
*
*   Maintenance
*   uuu     yyyy-mm-dd s(999999) ...
*   XSETGGR 2009-08-19 P319306          CREATED
*   SU1     2024-03-07 ES-34613      NOM 3.6:  Remove power
*   ---------------------------------      -----------------------------------
1 #SOURCE-ATTR-3 (A250)
*  ----------------------------------------------------------------------
*   Seq. File BS2000
* -----------------------------------------------------------------------
1 REDEFINE #SOURCE-ATTR-3
  2 #FBS23-IDENT (A63)
  2 REDEFINE #FBS23-IDENT
    3 #FBS23-NODE (N3)
    3 #FBS23-DSNAME (A54)
  2 #FBS23-RECFM (A5)
  2 #FBS23-RECSIZE (N5)
  2 #FBS23-BLKSIZE (N5)
  2 #FBS23-FILE-TYPE (A8)
  2 #FBS23-REP-FORMAT (A1)
*   ---------------------------------------------------------------------
*   Seq. file MVS
*  ----------------------------------------------------------------------
1 REDEFINE #SOURCE-ATTR-3
  2 #FMVS3-IDENT (A63)
  2 REDEFINE #FMVS3-IDENT
    3 #FMVS3-NODE (N3)
    3 #FMVS3-DSNAME (A44)
  2 #FMVS3-RECFM (A3)
  2 #FMVS3-LRECL (N5)
  2 #FMVS3-BLKSIZE (N5)
  2 #FMVS3-VOLSER (A6)
  2 #FMVS3-REP-FORMAT (A1)
* **SU1 Seq. file VSE: #FVSE3-..
*   CMASPOOL ???
* **SU1 #POWER3-..                                                       -----
*   ---------------------------------      -----------------------------------
*   JES2/JES3 Spool Queue Entry
*   ---------------------------------      -----------------------------------
1 REDEFINE #SOURCE-ATTR-3
  2 #JES3-QUEUE-IDENT (A63)
  2 REDEFINE #JES3-QUEUE-IDENT
    3 #JES3-QUEUE-NODE (N3)
    3 #JES3-QUEUE-JOB-NAME (A8)
    3 #JES3-QUEUE-JOB-NUMBER (N7)
    3 REDEFINE #JES3-QUEUE-JOB-NUMBER
      4 #JES3-QUEUE-JOB-NUMBER-A (A7)
    3 #JES3-QUEUE-GROUP-ID (A20)
*   ---------------------------------      -----------------------------------
*   JES2/JES3 Spool File
*   ---------------------------------      -----------------------------------
1 REDEFINE #SOURCE-ATTR-3
  2 #JES3-IDENT (A63)
  2 REDEFINE #JES3-IDENT
    3 #JES3-NODE (N3)
    3 #JES3-JOB-NAME (A8)
    3 #JES3-JOB-NUMBER (N7)
    3 REDEFINE #JES3-JOB-NUMBER
      4 #JES3-JOB-NUMBER-A (A7)
    3 #JES3-TYPE (A2)
    3 #JES3-DATA-SET-KEY (N7)
  2 #JES3-PROCNAME (A8)
  2 #JES3-STEPNAME (A8)
  2 #JES3-DDNAME (A8)
  2 #JES3-DATA-SET (N5)
  2 #JES3-REP-FORMAT (A1)
* **End of LDA RMSR3-L **************************************************
END-DEFINE
