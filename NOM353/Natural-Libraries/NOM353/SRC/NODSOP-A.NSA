DEFINE DATA PARAMETER
/* >Natural Source Header 000000
/* :Mode S
/* :CP
/* <Natural Source Header
* *PARAMETER  NODSOP-A
* *VERSION    3.1.1
* *FUNCTION   NOM SYSTEM DEFAULTS
* *
* *MAINTENANCE:
* *XSEGGR  2004-06-04 CREATED
* SU1     2014-06-23 NOMALL-1281             show last update user+date
* CF1     2014-06-24 NOMALL-1284 Hold retention for printout
* CF2     2014-08-22 NOMALL-1474 Enable system defaults for NGC internal
* -----------------------------------------------------------------------
1 NODS-PARMS
  2 NODS-PARM-AREA (A253/1:20)
  2 REDEFINE NODS-PARM-AREA
    3 NODS-NOM-DATA-DBID (N5)
    3 NODS-NOM-DATA-FNR (N5)
    3 NODS-USE-OWNER (A1)
    3 NODS-DATE-FORMAT (A1)
    3 NODS-SUPPORT-LONG-NAMES (A1)
    3 NODS-USER-AUTODEF (A1)
    3 NODS-ACTIVE-DATA-DBID (N5)
    3 NODS-ACTIVE-DATA-FNR (N5)
    3 NODS-CLEANUP-ARCH-TIME (A5)
    3 NODS-CLEANUP-PLAN-SCHED-DATE (A15)
    3 REDEFINE NODS-CLEANUP-PLAN-SCHED-DATE
      4 NODS-CLEANUP-PLAN-SCHED-DAT (A10)
      4 NODS-CLEANUP-PLAN-SCHED-TIME (A5)
    3 NODS-LOG-TYPES (A1/1:10)
    3 NODS-LOG-RET-NUMBER (N4)
    3 NODS-LOG-RET-FACTOR (A1)
    3 NODS-PO-TYPES (A1/1:3)
    3 NODS-PO-RET-NUMBER (N4)
    3 NODS-PO-RET-FACTOR (A1)
    3 NODS-CUSTOM-APPL (A250/1:5)
    3 REDEFINE NODS-CUSTOM-APPL
      4 NODS-AP-TAB (1:5)
        5 NODS-AP-TITLE (A32)
        5 NODS-AP-LIBRARY (A8)
        5 NODS-AP-COMMAND (A8)
        5 NODS-AP-PARAM (A25)
        5 NODS-AP-FILLER (A177)
    3 NODS-HOLD-RET-NUMBER (N4) /*CF1
    3 NODS-HOLD-RET-FACTOR (A1) /*CF1
    3 NODS-LAST-UPDATE-USER (A16) /*SU1
    3 NODS-LAST-UPDATE (A15) /*SU1
    3 NODS-NGC-PARMS (A250) /*Parms box for NGC only  /* CF2
* **end of PDA NODSOP-A *************************************************
END-DEFINE
