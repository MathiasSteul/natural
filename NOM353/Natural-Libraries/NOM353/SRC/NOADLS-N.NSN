* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* NOADLS-N - NOM API List of Archive Datasets
*
* Maintenance:
* XSETGGR 2005-01-30 created
* XSETGGR 2005-05-10 no time redefinition to p13
* XSETGGR 2007-05-09 p(294774) change date/time format in lists
* XSETGGR 2008-01-06 NRT2488   new functions - rename dataset and modify
*                              volser
* XSETHZ  2008-07-23 p(307577) use full name of ES-APP-SERVER-LIBRARY
* XSETHZ  2009-10-13 P320778   ERROR 1316 1910
* XSETHZ  2009-10-13 P316054   GET-VOLSERS-FROM-CATALOG fails
* XSETHZ  2009-11-19 P316054   No catalog message for list
* fhi     2010-09-03 NOMALL-97 Extend message line
* SU1     2014-07-03 NOMALL-1279 fill fields for Adabas Vista
* BLI     2014-08-26 NOMALL-1422 Multivolume handling (comp. RLISAD)
* SU2     2014-11-05 NOMALL-1450 fill fields for Adabas Vista
* SU3     2016-01-15 NOMALL-1802 do not update Adabas Vista fields
* SU4     2016-08-05 NOM 3.5: remove unused code
* fhi     2016-11-10 NOMALL-1917 use correct node number
* SU5     2017-03-07 NOM 3.5: remove unused code
* SU6     2019-07-04 NOMALL-2292 check if archive is running(no UPDATE)
* BLI     2020-03-13 NOMALL-2285 AD-ORIGINAL-REPORT-COUNT wrong/in use
* SU7     2020-11-10 NOMALL-2440 split DDM -> NRM-MF-NODES
* HEB-1   2022-07-20 ES-31130    new filter criteria with vers. 3.5.2.6
* BLI1    2022-11-07 NOMALL-2582 Volser check in catalog
* --------------------------------------------------------------------
*
DEFINE DATA
PARAMETER USING ESMCNT-A
PARAMETER USING ESMINP-A
PARAMETER USING ESMWORKA
PARAMETER USING NOADLS-A
* *****
INDEPENDENT
1 +NOD-LOCAL-ID               (A20)
* *****
LOCAL USING NOADSL-A
LOCAL USING ESMCONSL
LOCAL USING NADA2000
LOCAL USING NAD-MSG
LOCAL USING NAD-FLD
LOCAL USING SATLF02P
LOCAL USING SATFNC3E
LOCAL
1 ARCHIVE-DATASET VIEW OF NRM-ARCHIVE-DATASET
  2 AD-ARCHIVE-DSNAME
  2 AD-CREATED
  2 AD-CREATED-INV
  2 AD-EXPIRATION-DATE
  2 AD-EXPIRATION-DATE-PHYS
  2 AD-CONDENSE-OUTPUT
  2 AD-ORIGINAL-REPORT-COUNT
  2 C*AD-VOLSERS
  2 AD-VOLSERS              (1:191)
  2 AD-MARK-FOR-CONDENSE
  2 AD-ARCHIVE-TYPE
1 DATASET-REPORT VIEW OF NRM-DATASET-REPORT
1 UDA VIEW OF NRM-USER-DEFINED-ARCHIVE
  2 M-MONITOR-ID
  2 REDEFINE M-MONITOR-ID
    3 M-MONITOR-TYPE   (A7)
    3 M-USERARC-NUMBER (N2)
  2 M-USERARC-NAME
  2 M-USERARC-EXITLIB
  2 M-USERARC-EXITMEM
1 MF-NODE VIEW OF NRM-MF-NODES /*SU7 was MONITOR VIEW OF NRM-MONITOR
  2 MF-MONITOR-NODE
  2 MF-SYSTEM-TYPE
1 CATALOG VIEW OF CATALOG
  2 ERROR-CODE
  2 VOLSER
  2 DSNAME
1 ARCHIVE-TASK VIEW OF NRM-ARCHIVE-TASK
  2 M-ARCHIVE-PREFIX
* *****
1 #I2              (I4)
1 #I-VOL           (I4)
1 #I-VOL-RESET     (N7)                           /* BLI NOMALL-1422
1 #I               (I4)
1 #IMAX            (I4)
1 #TIME-INV        (T)
1 #TIME-INV-P      (P13)
1 #TIME-A          (A13)
1 REDEFINE #TIME-A
  2 #TIME-N        (N13)
1 #DSNAME-S        (A44)
1 #DSNAME-E        (A44)
1 #OPTIONS         (A2/1:10)
1 #MSG-NR          (N4) CONST <6123>
1 #EXPIRED         (N6)
1 #NUMREP          (N6)
1 #TT              (T)
1 #USERARC-EXIT    (L/1:9)
1 #USERARC-NAME    (A8/1:9)
1 #USERARC-NUMBER  (N1/1:9)
1 #TEMP-STRING     (A60)
1 #HEADER          (A252)
1 REDEFINE #HEADER
  2 #HEADER-A      (A118/2)
1 #UPDATED         (L)
1 #RC              (N4)
1 G-NATRP-DBID     (N5)
1 G-NATRP-FNR      (N5)
/* HEB-1 >
1 #F-DATE-C          (T)
1 REDEFINE #F-DATE-C
  2 #F-DATE-C-P      (P13)
1 #T-DATE-C          (T)
1 REDEFINE #T-DATE-C
  2 #T-DATE-C-P      (P13)
1 #F-DATE-EXP        (A8)
1 #T-DATE-EXP        (A8)
1 #DATE-14           (A14)
1 P-ERC              (N4)
1 P-VERSION-A10      (A10)
/* HEB-1 <
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET ES-RC ES-NUMBER ES-STARTINDEX #TT
ES-SORTORDER := 1
ES-SORTKEY := 3
ES-EOF := 'X'
ES-OPTION-COUNT := 10
IF ES-EXPAND NE ' '
  #IMAX := 395
  ES-FIELD-COUNT := 1
  NOADEX-FIELD-LENGTH := 44
ELSE
  #IMAX := 214
  ES-FIELD-COUNT := 11
  NOADLS-FIELD-LENGTH(1) := 44
  NOADLS-FIELD-LENGTH(2) := 903
  NOADLS-FIELD-LENGTH(3) := 906
  NOADLS-FIELD-LENGTH(4) := 812
  NOADLS-FIELD-LENGTH(5) := 1
  NOADLS-FIELD-LENGTH(6) := 808
  NOADLS-FIELD-LENGTH(7) := 808
  NOADLS-FIELD-LENGTH(8) := 906
  NOADLS-FIELD-LENGTH(9) := 1
  NOADLS-FIELD-LENGTH(10) := 8
  NOADLS-FIELD-LENGTH(11) := 901
END-IF
/*
#NOADSL := ES-SELECT
EXAMINE #NOADSL.#DSNAME FOR '*' DELETE
#DSNAME-S := #NOADSL.#DSNAME
COMPRESS #NOADSL.#DSNAME H'FF' TO #DSNAME-E LEAVING NO
/* HEB-1 >
/* Client versions GE 3.5.2.6 support filter creation/expiration date
CALLNAT 'ESMAVC-N' 'N' P-VERSION-A10 P-ERC ES-CONTROL
/* Get client version from ES-CONTROL
* 1.1 - Creation date from
IF P-VERSION-A10 LT '0305020006'
    OR #C-DATE-FROM = ' '
    OR NOT (#C-DATE-FROM = MASK (YYYYMMDD))
  MOVE EDITED '19010101000000' TO #F-DATE-C(EM=YYYYMMDDHHIISS)
ELSE
  IF #C-TIME-FROM = ' '
      OR NOT (#C-TIME-FROM = MASK (NNNN))
    COMPRESS #C-DATE-FROM '000000' TO #DATE-14 LEAVING NO
  ELSE
    COMPRESS #C-DATE-FROM SUBSTRING(#C-TIME-FROM,1,4) '00'
      TO #DATE-14 LEAVING NO
  END-IF
  MOVE EDITED #DATE-14 TO #F-DATE-C(EM=YYYYMMDDHHIISS)
END-IF
* 1.2 - Creation date to
IF P-VERSION-A10 LT '0305020006'
    OR #C-DATE-TO = ' '
    OR NOT (#C-DATE-TO = MASK (YYYYMMDD))
  MOVE EDITED '20991231235959' TO #T-DATE-C(EM=YYYYMMDDHHIISS)
ELSE
  IF #C-TIME-TO = ' '
      OR NOT (#C-TIME-TO = MASK (NNNN))
    COMPRESS #C-DATE-TO '235959' TO #DATE-14 LEAVING NO
  ELSE
    COMPRESS #C-DATE-TO SUBSTRING(#C-TIME-TO,1,4) '59'
      TO #DATE-14 LEAVING NO
  END-IF
  MOVE EDITED #DATE-14 TO #T-DATE-C(EM=YYYYMMDDHHIISS)
END-IF
* 2.1 - Expiration date from
IF P-VERSION-A10 LT '0305020006'
    OR #EXP-DATE-FROM = ' '
    OR NOT (#EXP-DATE-FROM = MASK (YYYYMMDD))
  #F-DATE-EXP := '19010101'
ELSE
  #F-DATE-EXP := #EXP-DATE-FROM
END-IF
* 2.2 - Expiration date to
IF P-VERSION-A10 LT '0305020006'
    OR #EXP-DATE-TO = ' '
    OR NOT (#EXP-DATE-TO = MASK (YYYYMMDD))
  #T-DATE-EXP := '20991231'
ELSE
  #T-DATE-EXP := #EXP-DATE-TO
END-IF
/* HEB-1 <
/*
FIND MF-NODE WITH MF-MONITOR-ID = +NOD-LOCAL-ID /*SU7
END-FIND
IF ES-NEXT-KEY-PARM(1) > ' '
  #TIME-INV-P := VAL(ES-NEXT-KEY-PARM(1))
  #TIME-INV := #TIME-INV-P
ELSE
  RESET #TIME-INV
  IF ES-EXPAND NE 'E'
    ES-STARTINDEX := 3
    #I2 := 2
    RESET SHORT-MSG LONG-MSG(*) NOADLS-HEADER(*) #HEADER
    PERFORM GET-MSG-TXT
    RESET ES-RC
    #HEADER := LONG-MSG(1)
    FOR #I = 2 TO ES-FIELD-COUNT
      COMPRESS #HEADER C-HEADER-DELIMITER LONG-MSG(#I) TO
        #HEADER LEAVING NO
    END-FOR
    NOADLS-HEADER(1:2) := #HEADER-A(1:2)
  END-IF
END-IF
/* read userarc details
READ UDA BY M-MONITOR-ID = 'USERARC'
  IF M-MONITOR-ID NE MASK('USERARC')
    ESCAPE BOTTOM
  END-IF
  IF M-USERARC-EXITLIB NE ' ' AND M-USERARC-EXITMEM NE ' '
    #USERARC-EXIT(M-USERARC-NUMBER) := TRUE
  END-IF
  #USERARC-NAME(M-USERARC-NUMBER)  := M-USERARC-NAME
  #USERARC-NUMBER(M-USERARC-NUMBER):= M-USERARC-NUMBER
END-READ
/* read archive datasets
* PRINT *PROGRAM *LINE *TIMX (EM=YYYY-MM-DD_HH:II:SS:T)  /* HEB-1
*  / '=' #F-DATE-C (EM=YYYYMMDDHHIISS) '=' #T-DATE-C (EM=YYYYMMDDHHIISS)
*  / '=' #F-DATE-EXP  '=' #T-DATE-EXP
R. READ ARCHIVE-DATASET BY AD-CREATED-INV STARTING FROM #TIME-INV
  ACCEPT IF AD-ARCHIVE-DSNAME = #DSNAME-S THRU #DSNAME-E
  /* HEB-1 >
    AND AD-CREATED = #F-DATE-C THRU #T-DATE-C
    AND AD-EXPIRATION-DATE = #F-DATE-EXP THRU #T-DATE-EXP
  /* HEB-1 <
  ADD 1 TO #I2
  IF #I2 > #IMAX
    #TIME-N := AD-CREATED-INV
    ES-NEXT-KEY-PARM(1) := #TIME-A
    ES-NUMBER := #IMAX
    RESET ES-EOF
    ESCAPE BOTTOM
  END-IF
  RESET #OPTIONS(*) #EXPIRED #NUMREP
  FNDRP. FIND NUMBER DATASET-REPORT WITH
    DR-ARCHIVE-DSNAME = AD-ARCHIVE-DSNAME
  IF *NUMBER(FNDRP.) > 0
    #NUMREP := *NUMBER(FNDRP.)
    #OPTIONS(1) := 'DT'    /* delete archive dataset
  ELSE
    #OPTIONS(2) := 'LD'    /* list of reports
    IF ES-EXPAND NE 'E'
      NOADLS-MESSAGE(#I2) := 'D'    /* can be deleted
    END-IF
  END-IF
  PERFORM GET-VOLSERS-FROM-CATALOG
  IF C*AD-VOLSERS = 0
    #OPTIONS(3) := 'LV'
  END-IF
  FIND (1) ARCHIVE-TASK WITH M-MONITOR-ID = 'ARCHIVE'
    EXAMINE #TEMP-STRING FOR ARCHIVE-TASK.M-ARCHIVE-PREFIX DELETE
    IF #TEMP-STRING = MASK ('.G'NNNN'V'NN) AND *MACHINE-CLASS NE 'PC'
      FIND CATALOG WITH NODE = MF-MONITOR-NODE
      AND DSNAME = ARCHIVE-TASK.M-ARCHIVE-PREFIX                      /*
        IF DSNAME = ARCHIVE-DATASET.AD-ARCHIVE-DSNAME
          #OPTIONS(4) := 'OD'
          /*  Not allowed to condense the oldest data set in a GDG
        END-IF
        ESCAPE BOTTOM
      END-FIND
    END-IF
  END-FIND
  IF ES-EXPAND = 'E'
    NOADEX-NAME(#I2) := AD-ARCHIVE-DSNAME
    NOADEX-OPTIONS(#I2,1:10):= #OPTIONS(1:10)
  ELSE
    NOADLS-NAME(#I2):= AD-ARCHIVE-DSNAME
    IF C*AD-VOLSERS > 0
      NOADLS-VOL(#I2) := C*AD-VOLSERS
    END-IF
    IF #NUMREP > 0
      NOADLS-REP-NUMBER(#I2) := #NUMREP
      MOVE RIGHT JUSTIFIED NOADLS-REP-NUMBER(#I2)
        TO NOADLS-REP-NUMBER(#I2)
    ELSE
      RESET NOADLS-REP-NUMBER(#I2)
    END-IF
    IF AD-CREATED NE #TT
      MOVE EDITED AD-CREATED (EM=YYYYMMDDHHII) TO NOADLS-CREATED(#I2)
    ELSE
      RESET NOADLS-CREATED(#I2)
    END-IF
    IF AD-EXPIRATION-DATE > ' '
      NOADLS-LOG-EXPD(#I2) := AD-EXPIRATION-DATE
    ELSE
      RESET NOADLS-LOG-EXPD(#I2)
    END-IF
    IF AD-EXPIRATION-DATE-PHYS > ' '
      NOADLS-PHYS-EXPD(#I2) := AD-EXPIRATION-DATE-PHYS
    END-IF
* BLI NOMALL-2285 start
* zero/negative/errornous (too lowÜ) AD-ORIGINAL-REPORT-COUNT, e.g.
* especially after condense (n to 1) or 'limited' archive/condense
    #EXPIRED := AD-ORIGINAL-REPORT-COUNT - #NUMREP
    IF #EXPIRED LE 0
      RESET NOADLS-EXPIRED(#I2)
    ELSE
* BLI NOMALL-2285 end
      NOADLS-EXPIRED(#I2) := #EXPIRED
      MOVE RIGHT JUSTIFIED NOADLS-EXPIRED(#I2) TO NOADLS-EXPIRED(#I2)
    END-IF
    IF AD-CONDENSE-OUTPUT NE 'Y'
      NOADLS-COND(#I2) := 'N'
    ELSE
      NOADLS-COND(#I2) := 'Y'
    END-IF
    IF AD-ARCHIVE-TYPE GT 0
      NOADLS-USERARC-NAME(#I2):= #USERARC-NAME(AD-ARCHIVE-TYPE)
      NOADLS-USERARC-NUM(#I2) := #USERARC-NUMBER(AD-ARCHIVE-TYPE)
    ELSE
      NOADLS-USERARC-NAME(#I2)  := 'Standard'
      RESET NOADLS-USERARC-NUM(#I2)
    END-IF
    IF AD-MARK-FOR-CONDENSE = 'X'
      NOADLS-MESSAGE(#I2) := 'C'    /* condensed
    END-IF
    NOADLS-OPTIONS(#I2,*) := #OPTIONS(*)
  END-IF
  ES-NUMBER := #I2
END-READ
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE GET-VOLSERS-FROM-CATALOG
************************************************************************
IF NOT ((AD-ARCHIVE-TYPE = 0 OR NOT #USERARC-EXIT(AD-ARCHIVE-TYPE))
AND *MACHINE-CLASS = 'MAINFRAME')                                     /*
OR NOT(MF-SYSTEM-TYPE = SCAN 'MVS' OR = SCAN 'MSP')                   /*
  ESCAPE ROUTINE
END-IF
#UPDATED := FALSE
#I-VOL-RESET := C*AD-VOLSERS                   /* BLI NOMALL-1422
CAT. FIND CATALOG WITH DSNAME=AD-ARCHIVE-DSNAME AND NODE=MF-MONITOR-NODE
    AND PREFIX = 'NO' /* BLI1
  IF ERROR-CODE NE 0
    ESCAPE BOTTOM(CAT.)
  END-IF
  #UPDATED := TRUE
  #I-VOL := *COUNTER
* get rid of * in ARCHIVE-DATASET VOLSER         NOMALL-1422 BLI start
  IF VOLSER EQ '*' AND #I-VOL-RESET LT #I-VOL /* already reset
    RESET #I-VOL-RESET
    ESCAPE BOTTOM
  END-IF
  IF ARCHIVE-DATASET.AD-VOLSERS(#I-VOL) NE VOLSER OR VOLSER = '*'
    IF G-NATRP-DBID = 0 OR G-NATRP-FNR = 0
      PERFORM GET-NOM-LFILE
    END-IF
    CALLNAT 'GETHOLD' G-NATRP-DBID G-NATRP-FNR *ISN(R.) 'BS' #RC
    IF #RC = 145 /*record in hold - maybe Archive running
      BACKOUT TRANSACTION
      ESCAPE BOTTOM (CAT.)
    END-IF
    UPDARCDS. GET ARCHIVE-DATASET *ISN(R.)
    IF VOLSER = '*'
      RESET  ARCHIVE-DATASET.AD-VOLSERS(#I-VOL:#I-VOL-RESET)
      RESET #I-VOL-RESET
    ELSE
      ARCHIVE-DATASET.AD-VOLSERS(#I-VOL) := VOLSER
    END-IF
    UPDATE (UPDARCDS.)
    END TRANSACTION
    IF #I-VOL-RESET EQ 0
      ESCAPE BOTTOM
    END-IF                                   /* NOMALL-1422 BLI end
**      PERFORM UPDATE-REPORTS     /* BLI NOMALL-1422 (see NOMALL-930)
  END-IF
END-FIND
** IF NOT #UPDATED AND C*AD-VOLSERS > 0  BLI1 out, below in
IF #I-VOL-RESET GT #I-VOL /* more volsers (NE *) in AD than in CATALOG
  RESARCDS. GET ARCHIVE-DATASET *ISN(R.)
**  RESET VOLSER ARCHIVE-DATASET.AD-VOLSERS(*) BLI1 out, below in
  RESET ARCHIVE-DATASET.AD-VOLSERS(#I-VOL + 1:#I-VOL-RESET)
  UPDATE (RESARCDS.)
**    PERFORM UPDATE-REPORTS       /* BLI NOMALL-1422 (see NOMALL-930)
  END TRANSACTION
END-IF
GET ARCHIVE-DATASET *ISN(R.)
*
END-SUBROUTINE /* GET-VOLSERS-FROM-CATALOG
*
************************************************************************
DEFINE SUBROUTINE GET-MSG-TXT
************************************************************************
RESET SHORT-MSG LONG-MSG(*)
VERSION := 0
NADA2000.OBJECT-KIND := 'U'
NADA2000.ERROR-NUMBER := #MSG-NR
NADA2000.OPT-INSERT-DYN := FALSE
NADA2000.OPT-LANGUAGE := ES-LANGUAGE
NADA2000.LIBRARY := ES-APP-SERVER-LIBRARY
CALLNAT 'NATA2000' NADA2000 NATA2000.EXTENDED-PARMS NAD-MSG NAD-FLD
*
END-SUBROUTINE /* GET-MSG-TXT
*
************************************************************************
DEFINE SUBROUTINE GET-NOM-LFILE
************************************************************************
SATLF-FUNCTION := 'GET'
SATLF-LFILE    := 206
SATLF-SATVERS  := 21
CALLNAT SAT-GET-SET-LFILE SATLF-SATVERS SATLF-PARMS (*)
IF SATLF-ERROR-CODE NE 0
  ES-RC := 1
  COMPRESS *PROGRAM 'ERROR SAT:' SATLF-ERROR-CODE SATLF-ERROR-TEXT
    TO ES-MSG-TXT
  ESCAPE MODULE
ELSE
  G-NATRP-DBID := SATLF-DBID-N5
  G-NATRP-FNR  := SATLF-FNR-N5
END-IF
*
END-SUBROUTINE /* GET-NOM-LFILE
*
************************************************************************
ON ERROR
************************************************************************
  ES-RC := 1
  COMPRESS *PROGRAM 'ERROR' *ERROR-NR *ERROR-LINE TO ES-MSG-TXT
  ESCAPE ROUTINE
*
END-ERROR
*
END
