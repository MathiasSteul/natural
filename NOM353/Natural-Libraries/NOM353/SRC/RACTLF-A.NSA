DEFINE DATA PARAMETER
/* >Natural Source Header 000000
/* :Mode S
/* :CP
/* <Natural Source Header
*  RACTLF-A
*  Created 02-02-25 SJU
*  Interface for checking if a given lfile is set and, if not, setting
*  it to the value of another lfile
*
*  Amendment history
*  -----------------
*
1 RACTLF-PARMS
  2 RACTLF-VERSION (N2) /* Interface version
  2 RACTLF-PARAMETERS (A250/1:1) /* Parameters
  2 REDEFINE RACTLF-PARAMETERS /* REDEF. BEGIN : RACTLF-PARAMET
    3 RACTLF-ERROR-CODE (N4) /* Return code
    3 RACTLF-ERROR-TEXT (A72) /* Error text
    3 RACTLF-LOGGING (L) /* Whether to log
    3 RACTLF-ERROR-LOGGING (L) /* Whether to log errors
    3 RACTLF-LOG-CODE (A2) /* Log code to use
    3 RACTLF-LOG-USERID (A8) /* Log userid to use
    3 RACTLF-LFILE-1 (N5) /* lfile to be checked
    3 RACTLF-DBID-1 (N5) /* dbid of that lfile
    3 RACTLF-FNR-1 (N5) /* fnr of that lfile
    3 RACTLF-LFILE-2 (N5) /* lfile to be set from
    3 RACTLF-DBID-2 (N5) /* dbid of that lfile
    3 RACTLF-FNR-2 (N5) /* fnr of that lfile
END-DEFINE
