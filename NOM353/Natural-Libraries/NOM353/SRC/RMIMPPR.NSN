*
************************************************************************
* Main line
************************************************************************
*
IF *OCC(B64-TEXT-ARRAY) = 0
  EXPAND ARRAY B64-TEXT-ARRAY TO (1:5)
END-IF
IF NOT #SAVE
  IF #TAG-CURRENT = #TAG-OLD
    ADD 1 TO #IND
  ELSE
    #IND := 1
  END-IF
  IF #VALUE-CURRENT = ' '
    ESCAPE MODULE
  END-IF
  DECIDE ON FIRST VALUE OF #TAG-CURRENT
    VALUE 'P-OBJECT-TYPE'
      PR-FILL.P-OBJECT-TYPE := #VALUE-CURRENT
    VALUE 'P-OBJECT-TIME'
      MOVE EDITED #VALUE-CURRENT TO PR-FILL.P-OBJECT-TIME
        (EM=YYYY'-'MM'-'DD'-'HH':'II':'SS'.'T)
    VALUE 'P-ID'
      PR-FILL.P-ID := #VALUE-CURRENT
    VALUE 'P-NAME'
      PR-FILL.P-NAME := #VALUE-CURRENT
    VALUE 'P-PHYSICAL-NAME'
      PR-FILL.P-PHYSICAL-NAME := #VALUE-CURRENT
    VALUE 'P-LOCATION'
      PR-FILL.P-LOCATION := #VALUE-CURRENT
    VALUE 'P-EXITMEM'
      PR-FILL.P-EXITMEM := #VALUE-CURRENT
    VALUE 'P-EXITLIB'
      PR-FILL.P-EXITLIB := #VALUE-CURRENT
    VALUE 'P-COPIES'
      IF #VALUE-CURRENT IS (N3)
        PR-FILL.P-COPIES := VAL (#VALUE-CURRENT)
      ELSE
        #MSG := 'P-COPIES'
        PERFORM FIELD-IGNORED /*RMIMP-C1
      END-IF
    VALUE 'P-PRIORITY'
      IF #VALUE-CURRENT IS (N3)
        PR-FILL.P-PRIORITY := VAL (#VALUE-CURRENT)
      ELSE
        #MSG := 'P-PRIORITY'
        PERFORM FIELD-IGNORED /*RMIMP-C1
      END-IF
    VALUE 'P-JOBCARD'
      PR-FILL.P-JOBCARD (#IND) := #VALUE-CURRENT
    VALUE 'P-ATTR-IDENT'
      IF #VALUE-CURRENT IS (I1)
        PR-FILL.P-ATTR-IDENT (#IND) := VAL (#VALUE-CURRENT)
      ELSE
        #MSG := 'P-ATTR-IDENT'
        PERFORM FIELD-IGNORED /*RMIMP-C1
      END-IF
    VALUE 'P-ATTR-LENGTH'
      IF #VALUE-CURRENT IS (N2)
        PR-FILL.P-ATTR-LENGTH (#IND) := VAL (#VALUE-CURRENT)
      ELSE
        #MSG := 'P-ATTR-LENGTH'
        PERFORM FIELD-IGNORED /*RMIMP-C1
      END-IF
    VALUE 'P-ATTR-PROMPT'
      IF #VALUE-CURRENT IS (N4)
        PR-FILL.P-ATTR-PROMPT (#IND) := VAL (#VALUE-CURRENT)
      ELSE
        #MSG := 'P-ATTR-PROMPT'
        PERFORM FIELD-IGNORED /*RMIMP-C1
      END-IF
    VALUE 'P-ATTR-VAR'
      PR-FILL.P-ATTR-VAR (#IND) := #VALUE-CURRENT
    VALUE 'P-ATTR-VALUE'
      PR-FILL.P-ATTR-VALUE (#IND) := #VALUE-CURRENT
    VALUE 'P-NODE'
      IF #VALUE-CURRENT IS (N3)
        PR-FILL.P-NODE := VAL (#VALUE-CURRENT)
      ELSE
        #MSG := 'P-NODE'
        PERFORM FIELD-IGNORED /*RMIMP-C1
      END-IF
    VALUE 'P-CHARS'
      PR-FILL.P-CHARS := #VALUE-CURRENT
    VALUE 'P-CLASS'
      PR-FILL.P-CLASS := #VALUE-CURRENT
    VALUE 'P-FORM'
      PR-FILL.P-FORM := #VALUE-CURRENT
    VALUE 'P-WRITER'
      PR-FILL.P-WRITER := #VALUE-CURRENT
    VALUE 'P-DESTINATION'
      PR-FILL.P-DESTINATION := #VALUE-CURRENT
    VALUE 'P-FLASH'
      PR-FILL.P-FLASH := #VALUE-CURRENT
    VALUE 'P-FCB'
      PR-FILL.P-FCB := #VALUE-CURRENT
    VALUE 'P-PAGEDEF'
      PR-FILL.P-PAGEDEF := #VALUE-CURRENT
    VALUE 'P-FORMDEF'
      PR-FILL.P-FORMDEF := #VALUE-CURRENT
    VALUE 'P-DSNAME'
      PR-FILL.P-DSNAME := #VALUE-CURRENT
    VALUE 'P-MEMBER'
      PR-FILL.P-MEMBER := #VALUE-CURRENT
    VALUE 'P-VOLSER'
      PR-FILL.P-VOLSER := #VALUE-CURRENT
    VALUE 'P-DISP'
      PR-FILL.P-DISP := #VALUE-CURRENT
    VALUE 'P-TAPE-GENERIC'
      PR-FILL.P-TAPE-GENERIC := #VALUE-CURRENT
    VALUE 'P-JOBNAME'
      PR-FILL.P-JOBNAME := #VALUE-CURRENT
    VALUE 'P-LABEL'
      PR-FILL.P-LABEL (#IND) := #VALUE-CURRENT
    VALUE 'P-DCB'
      PR-FILL.P-DCB (#IND) := #VALUE-CURRENT
    VALUE 'P-LAST-UPDATE'
      MOVE EDITED #VALUE-CURRENT TO PR-FILL.P-LAST-UPDATE
        (EM=YYYY'-'MM'-'DD'-'HH':'II':'SS'.'T)
    VALUE 'P-LAST-UPDATE-USER'
      PR-FILL.P-LAST-UPDATE-USER := #VALUE-CURRENT
    NONE IGNORE
  END-DECIDE
ELSE
  COMPRESS PR-FILL.P-ID '/' PR-FILL.P-NAME TO #OBJ-NAME
  OBJ. FIND (1) PR WITH P-ID = PR-FILL.P-ID /*SU4 was #KEY
    IF NO RECORDS FOUND
      MOVE BY NAME PR-FILL TO PR
      STORE PR
      PERFORM ADD-LOADED
      ESCAPE BOTTOM (OBJ.)
    END-NOREC
    MOVE BY NAME PR-FILL TO PR
    IF #REPL = 'Y'
      UPDATE (OBJ.)
      PERFORM ADD-REPLACED
    ELSE
      COMPRESS PR-FILL.P-ID 'not replaced for PR' TO #MSG /*SU4 was #KEY
      PERFORM XXRLOG-WRITE-LOG 'W' #MSG
      PERFORM ADD-NOT-REPLACED
    END-IF
  END-FIND
  END TRANSACTION
END-IF
