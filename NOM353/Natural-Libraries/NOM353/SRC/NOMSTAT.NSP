* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* NOMSTAT
* Version   : NOM 1.3
* Function  : List contents of NOM DB
*
* Maintenance
* gw  98-06-26 s(999999) created
* sju 00-11-14 s(999999) SAT log server
* sju 03-03-04 NOM221    New lfile for active data
* sju 04-11-29 nom31     restow for changed NRM-ORDER
* xsetggr 2008-05-03 p(303852) use SATLGR2P/N
* fhi     2008-07-24 P307319   restow due to changes in DDM NRM-BUNDLE-CONTENTS
* raya    2013-06-19 NOMALL-1259 use SATLGR3P/N
* SU1     2015-01-26 NOMALL-1388 avoid S0C7/(SAT-288:SATLGR3P changed)
* fhi     2017-01-04 NOMALL-1913 Use microseconds for logging
* ----------------------------------------------------------------------
DEFINE DATA
* LOCAL  USING  SATLGR2P  /* raya 2013-06-19 nomall-1259 out
LOCAL USING SATLGR4P          /* NOMALL-1913 fhi was SATLGR3P
LOCAL USING SATLG01E
LOCAL USING RACTLF-A
LOCAL
1 ACTIVE-BUNDLES VIEW OF NRM-ACTIVE-BUNDLES
1 ACTIVE-REPORTS VIEW OF NRM-ACTIVE-REPORTS
1 ARCHIVE-DATASET VIEW OF NRM-ARCHIVE-DATASET
1 BUNDLE-CONTENTS VIEW OF NRM-BUNDLE-CONTENTS
1 BUNDLE-REPORT VIEW OF NRM-BUNDLE-REPORT
1 BUNDLES VIEW OF NRM-BUNDLES
1 CALENDARS VIEW OF NRM-CALENDARS
1 DATASET-REPORT VIEW OF NRM-DATASET-REPORT
1 DISTRIBUTION-LIST VIEW OF NRM-DISTRIBUTION-LIST
1 FILED-SYSOUTS VIEW OF NRM-FILED-SYSOUTS
1 FOLDER VIEW OF NRM-FOLDER
1 GRANTS VIEW OF NRM-GRANTS
1 MAIL VIEW OF NRM-MAIL
1 ORDER VIEW OF NRM-ORDER
1 PHYSICAL-PRINTERS VIEW OF NRM-PHYSICAL-PRINTERS
1 PRINTERS VIEW OF NRM-PRINTERS
1 PRINTOUTS VIEW OF NRM-PRINTOUTS
1 REPORT-CONTENTS VIEW OF NRM-REPORT-CONTENTS
1 REPORTS VIEW OF NRM-REPORTS-NEW
1 SOURCE VIEW OF NRM-SOURCE
1 SYSOUT-CONTROL VIEW OF NRM-SYSOUT-CONTROL
1 USERS VIEW OF NRM-USERS
1 L-HEADER (A78)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
FORMAT (0) LS=79
RESET RACTLF-LOGGING RACTLF-ERROR-LOGGING
RACTLF-LFILE-1:= 91
RACTLF-LFILE-2:= 206
CALLNAT 'RACTLF-N' RACTLF-PARMS
IF RACTLF-ERROR-CODE NE 0
  WRITE *PROGRAM *TIMX 'Error setting lfile 91' RACTLF-ERROR-CODE /
    RACTLF-ERROR-TEXT
  ESCAPE ROUTINE
END-IF
*
CALLNAT 'N-HEADER' L-HEADER 'G' 'NOMSTAT '
WRITE TITLE L-HEADER (DY=<D>) / 'Records in NOM DB' //
*
FIND NUMBER ACTIVE-BUNDLES WITH AB-BUNDLE-RNB NE ' '
WRITE *NUMBER (AD=I) 'active bundles'
*
FIND NUMBER ACTIVE-REPORTS WITH AR-REPORT-RNB NE ' '
WRITE *NUMBER (AD=I) 'active reports'
*
FIND NUMBER ARCHIVE-DATASET WITH AD-ARCHIVE-DSNAME NE ' '
WRITE *NUMBER (AD=I) 'archive datasets'
*
FIND NUMBER BUNDLE-CONTENTS WITH BC-BUNDLE NE ' '
WRITE *NUMBER (AD=I) 'bundle contents'
*
FIND NUMBER BUNDLE-REPORT WITH BR-BUNDLE NE ' '
WRITE *NUMBER (AD=I) 'report-in-bundle definitions'
*
FIND NUMBER BUNDLES WITH B-BUNDLE NE ' '
WRITE *NUMBER (AD=I) 'bundles'
*
FIND NUMBER CALENDARS WITH CA-CALENDAR-ID NE ' '
WRITE *NUMBER (AD=I) 'calendars'
*
FIND NUMBER DATASET-REPORT WITH DR-ARCHIVE-DSNAME NE ' '
WRITE *NUMBER (AD=I) 'dataset reports'
*
FIND NUMBER DISTRIBUTION-LIST WITH D-LIST-NAME NE ' '
WRITE *NUMBER (AD=I) 'distribution lists'
*
F-S.
FIND NUMBER FILED-SYSOUTS WITH F-REPNAME-RNB-SEQ NE ' '
WRITE *NUMBER (F-S.) (AD=I) 'filed sysouts'
*
FIND NUMBER FOLDER WITH FO-USER-FO-ID NE ' '
WRITE *NUMBER (AD=I) 'folder'
*
FIND NUMBER GRANTS WITH GR-SUPER NE ' '
WRITE *NUMBER (AD=I) 'grants'
*
SATLGR-PRODUCT     := 'NOM'
SATLGR-LANGUAGE    := *LANGUAGE
SATLGR-SEARCH-KEY  := SATLG-ENV-TIME
SATLGR-ACCESS-TYPE := SATLG-FIND-NUMBER
* CALLNAT 'SATLGR2N' SATLGR-PARMS /*raya nomall-1259 out
CALLNAT 'SATLGR4N' SATLGR-PARMS   /* NOMALL-1913 fhi was SATLGR3N
WRITE SATLGR-RECORDS-FOUND (AD=I) 'log records'
*
FIND NUMBER MAIL WITH MA-REP-RNB NE ' '
WRITE *NUMBER (AD=I) 'mail records'
*
FIND NUMBER ORDER WITH OD-ID NE 0
WRITE *NUMBER (AD=I) 'orders'
*
FIND NUMBER PHYSICAL-PRINTERS WITH PH-VTAMID NE ' '
WRITE *NUMBER (AD=I) 'physical printers'
*
FIND NUMBER PRINTERS WITH P-ID NE ' '
WRITE *NUMBER (AD=I) 'logical printers'
*
FIND NUMBER PRINTOUTS WITH PO-ID NE 0
WRITE *NUMBER (AD=I) 'printouts'
*
FIND NUMBER REPORT-CONTENTS WITH AC-REP-RNB-SEQ NE ' '
WRITE *NUMBER (AD=I) 'report contents'
*
FIND NUMBER REPORTS WITH R-REPNAME NE ' '
WRITE *NUMBER (AD=I) 'reports'
*
FIND NUMBER SOURCE WITH SR-ID NE 0
WRITE *NUMBER (AD=I) 'sources'
*
FIND NUMBER SYSOUT-CONTROL WITH SC-SUPER-SYSOUT NE ' '
WRITE *NUMBER (AD=I) 'sysout control'
*
FIND NUMBER USERS WITH USER-ID NE ' '
WRITE *NUMBER (AD=I) 'users'
*
END
