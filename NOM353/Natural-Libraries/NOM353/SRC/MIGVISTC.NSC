IF #NUMERIC AND NOT UT-KEY IS (N29) /*SU2 ->
  RESET UT-KEY_N29
END-IF /*SU2 <-
&1&-R. READ &1& BY &2& = &6& /*SU2 UT-KEY
/*WRITE *ISN &4&
  IF &3&OBJECT-TYPE (&1&-R.) = &4& /*SU2
      AND &3&OBJECT-TIME (&1&-R.) NE 0 /*SU2
    ADD 1 TO #COUNTER-OT-NOT
  ELSE
    IF &4& = 'AB' /*SU3 ->
      PERFORM HANDLE-AB-DATE/*in MIGVISTA
    END-IF /*SU3 <-
    &1&-UPD. GET &1&-UPDATE *ISN (&1&-R.)
    &3&OBJECT-TYPE (&1&-UPD.) := &4&
    &3&OBJECT-TIME (&1&-UPD.) := &5&
    IF &3&OBJECT-TIME (&1&-UPD.) = 0
      &3&OBJECT-TIME (&1&-UPD.) := #TIMX
    END-IF
    UPDATE (&1&-UPD.)
    ADD 1 TO #COUNTER-OT
    IF &4& = 'AR' /*SU3 ->
      PERFORM UPD-AR-REL /*in MIGVISTA
    END-IF
    IF &4& = 'AB'
      PERFORM UPD-AB-REL /*in MIGVISTA
    END-IF /*SU3 <-
  END-IF
  ADD 1 TO #COUNTER
  IF #COUNTER GE 50
    RESET #COUNTER
    FIND (1) UT WITH UT-UTILITY = #PROGRAM
      &6&  := &1&.&2& /*SU2 was UT-KEY
      UT-VIEW := &4&
      UPDATE
      END TRANSACTION
    END-FIND
    PERFORM CHECK-ELAPSED-TIME /*in MIGVISTA SU4
  END-IF
END-READ
COMPRESS '''' &4& ''' updated:' #COUNTER-OT
  ' already filled:' #COUNTER-OT-NOT TO #MSG LEAVING NO
PERFORM WRITE-MSG
RESET #COUNTER-OT #COUNTER-OT-NOT
FIND (1) UT WITH UT-UTILITY = #PROGRAM
  &6& := &1&.&2& /*SU2 was UT-KEY
  UT-VIEW := &4&
  UPDATE
END-FIND
END TRANSACTION
RESET UT-KEY /*for next object type (above: READ .. BY .. = UT-KEY) SU1
RESET #NUMERIC /*SU2
