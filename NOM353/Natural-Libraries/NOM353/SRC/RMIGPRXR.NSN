* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RCTPRPXR
* Function:  xref of related objects of a logical printer
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* mrs 93-10-11 s(999999) translate some texts
* xsiszha 2000-08-02 (CE7461) Extend Report and Bundle Names
* fhi 05-12-14 P272732   cataloged, because VPRINT-L was changed.
* SU1     2013-01-31 unused      Deactivate unused data areas
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 #P-MSG     (N4)
1 #PARMS
  2 #P-ID       (A8)    /* (A20) xsiszha (CE7461)
  2 #P-VTAMID   (A8)
  2 #P-PHYS-MSG (A4)
1 #LAN-TEXT       (A70/1:6)
LOCAL USING VPRINT-L
** LOCAL USING VTPHYS-L /*SU1 out
LOCAL
1 MIGRATE-PHYSICAL-PRINTERS VIEW /*SU1 in
OF NRM-MIGRATE-PHYSICAL-PRINTERS /*SU1 in
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET #P-MSG
FNDS. FIND PRINTERS WITH P-ID = #P-ID
  IF NO RECORDS FOUND
    #P-MSG := 4014
    ESCAPE BOTTOM (FNDS.)
  END-NOREC
  PERFORM CHECK-RELATED-OBJECTS
END-FIND
* ----------------------------------------- check-related-objects ------
DEFINE SUBROUTINE CHECK-RELATED-OBJECTS
#P-VTAMID := PRINTERS.P-PHYSICAL-NAME
FNDPH. FIND NUMBER MIGRATE-PHYSICAL-PRINTERS
  WITH PH-VTAMID = PRINTERS.P-PHYSICAL-NAME
IF *NUMBER (FNDPH.) = 0
  #P-PHYS-MSG := #LAN-TEXT (2)
ELSE
  #P-PHYS-MSG := #LAN-TEXT (1)
END-IF
END-SUBROUTINE
END
