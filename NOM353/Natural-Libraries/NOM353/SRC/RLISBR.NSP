* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RLISBR - List Reports in a Bundle
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* mrs 93-11-08 s(177710) old version saved, clean up, search on group
* mrs 94-03-14 s(196685) confirmation window
* gw  94-05-31 p(129063) follow doesn't work
* gw  96-10-15 s(231722) TOP doesn't go top
* gw  98-03-13 s(278970) save search values in independent variables
* wcd 00-04-01 CE 7267   New PFkey for additional printers in RPFK---L
* sju 00-05-31 p(179982) reset selection criteria
* xsisgg 00-08-14 CE7461 EXtend Report and Bundle names
* sju 02-03-08 p(221347) correct bundle names longer than 18 characters
* XSETHZ  2004-02-13 P(250183) Separator member 'NONE'/'KEIN'
* xsetggr 2005-10-26 p(270950) ISN fields must be P10, not P8
* fhi     2010-03-05 P307403 Don't use text and binary reports mixed
* fhi     2010-03-16 P307403 Side effects, use extra copy code RPFKEX1C
* fhi     2010-09-03 NOMALL-97 Extend message line
* fhi     2011-05-02 NOMALL-901 Log any online delete operation
* xsetggr 2012-02-01 NOMALL-1100 write language independant msgs in log
* xsetggr 2012-04-23 NOMALL-1136 corrections of using grants
* SU1     2013-07-17 remove empty copy code CSTARTLS
* SU2     2016-09-29 NOM3.5 use N-NONE
* BLI     2017-08-03 NOMALL-1986 check modify grants, profile
* ----------------------------------------------------------------------
DEFINE DATA GLOBAL USING  NRM-GL
INDEPENDENT
1  +G-RLISBR-SEL-REPNAME          (A25)
1  +G-RLISBR-SEL-GROUP            (A8)
* *****
LOCAL  USING  VMBRP-L
LOCAL  USING  RLC----L
LOCAL  USING  RPFK---L
LOCAL  USING  ROT----L
LOCAL  USING  RLOG-L
*
LOCAL
1 REPORTS VIEW OF NRM-REPORTS-NEW
  2 R-SEPMEM
  2 R-REP-FORMAT
*
1 BUNDLE VIEW OF NRM-BUNDLES
  2 B-FLUSH-REPORTS               (1:10)
* -----------------------------local Variables--------------------------
1 #NOFLINES                       (P2) CONST <15>
1 #NOFPAGES                       (P2) CONST <10>
1 #END-OF-DATA                    (L)
1 #BROWSE-FLAGS
  2 #NEWVAL                       (L)
  2 #TOP                          (L)
  2 #BOT                          (L)
  2 #FORWARD                      (L)
  2 #BACKWARD                     (L)
  2 GET-SCREEN                    (L)
  2 #SCROLL-AMOUNT                (N3)
1 #CP                             (P3)
1 #MAXP                           (P3)
1 #MAXAP                          (P3)
1 DISPLAY-IT                      (L)
1 #OLD-GROUP                      (A8)
1 #OLD-SEQNO                      (P3)
1 #NUMBER                         (P10)
1 #START-KEY                      (A35)
1 REDEFINE #START-KEY
  2  #SK-BUNDLE                   (A25)
  2  #SK-GROUP                    (A8)
  2  #SK-SEQNO                    (P3)
1 #START-NUMBER                   (P10)
1 #TOPKEY                         (A35)
1 REDEFINE #TOPKEY
  2 #TK-BUNDLE                    (A25)
  2 #TK-GROUP                     (A8)
  2 #TK-SEQNO                     (P3)
1 #TOPKEY-NUMBER                  (P10)
1 #LAST-KEY                       (A35)
1 REDEFINE #LAST-KEY
  2 #LK-BUNDLE                    (A25)
  2 #LK-GROUP                     (A8)
  2 #LK-SEQNO                     (P3)
1 #LAST-NUMBER                    (P10)
1 #PAGES-TAB (1:#NOFPAGES)
  2 #PAGES                        (A35)
  2 REDEFINE #PAGES
    3 #PK-BUNDLE                  (A25)
    3 #PK-GROUP                   (A8)
    3 #PK-SEQNO                   (P3)
  2 #PAGES-NUMBER                 (P10)
1 L-HEADER                        (A78)
1 #S-GROUP                        (A25) INIT <'*'>
1 #S-GROUP-F                      (A25)
1 #S-GROUP-T                      (A25)
1 #S-REPNAME                      (A25) INIT <'*'>
1 #S-REPNAME-F                    (A25)
1 #S-REPNAME-T                    (A25)
1 CV-SELECTION                    (C/2)
1 REDEFINE  CV-SELECTION
  2 CV-SREP                       (C)
  2 CV-SGROUP                     (C)
1 L-SCREEN                        (15)
  2 L-REPORT                      (A25)
  2 L-PRINTER                     (A50)
  2 L-GROUP                       (A8)
  2 L-SEQNO                       (P3)
  2 L-SEPMEM                      (A8)
  2 L-SEPNO                       (N3)
  2 L-REPNO                       (P3)
  2 L-ISN                         (N10)
1 L-LCMD                          (15)
  2 L-IDENT                       (I2)
  2 L-MARK                        (A2)
  2 CV-MARK                       (C)
1 I                               (N5)
1 #CONFIRMED                      (L)
1 #ALLOWED                        (L)
1 #UPDATE                         (L)
** 1 #DELETE                            (L)  BLI 2017-08-03 NOMALL-1986
1 #FATHER-PROG                    (A8) INIT <'RLISBU'>
1 #LEN                            (N3)
1 CV-LINES                        (C)
1 #ADD-PROGRAM                    (A8) INIT <'RDEFBR'>
1 #ACT-MAST                       (A8)
1 F                               (P2)
1 #LANGUAGE                       (I1)
1 #OBJECT-NAME                    (A32)
1 LOWER-CASE                      (L)
1 #OBJECT-TYPE                    (A1)
1 #BINARY-REPORTS                 (L) /*Bin.reports present? P307403 in
1 #OBJ                            (A50)
1 #MODIFY-BUNDLE                  (L)
1 #USERID                         (A8)
1 #GRANTS                         (A1/6)
1 #GRANTED                        (L)
1 #BUNDLE                         (A25)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#ADD-PROGRAM:='RDEFBR'
RESET G-COMMIT
*
* BLI 2017-08-03 NOMALL-1986 use DBU, MBU. Function delete only modifies
* the membership of the report in the bundle.
** CALLNAT 'NARPSEC' G-USER-PROFILE 'DRP' #ALLOWED
CALLNAT 'NARPSEC' G-USER-PROFILE 'DBU' #ALLOWED
INCLUDE C-NALLOW
** CALLNAT 'NARPSEC' G-USER-PROFILE 'MRP' #UPDATE
** CALLNAT 'NARPSEC' G-USER-PROFILE 'PRP' #DELETE
CALLNAT 'NARPSEC' G-USER-PROFILE 'MBU' #UPDATE
*
INCLUDE CVIDEO
*
#SK-BUNDLE := G-C-BUNDLE
*
BUN. FIND (1) BUNDLE WITH B-BUNDLE = G-C-BUNDLE
END-FIND
IF *NUMBER (BUN.) = 0
  G-NATRP-ERC := 408
  INCLUDE C-ESCAPE
END-IF
*
RESET #SK-GROUP #SK-SEQNO
G-C-OBJTYPE:='REPORTS'
#NEWVAL := TRUE
#S-REPNAME := +G-RLISBR-SEL-REPNAME
#S-GROUP   := +G-RLISBR-SEL-GROUP
*
MAIN-LOOP. REPEAT
*
  G-C-FUNC := 'L'
*
  PERFORM GET-SCREEN
  RESET GET-SCREEN
*
  IF #LANGUAGE NE *LANGUAGE
    CALLNAT 'ROTINI-N' ##EQO-REPORT-IN-BUNDLE G-OBJ-TYPE G-OTB
    PERFORM INIT-PFKEYS
    PERFORM INIT-LINECOM
    #LANGUAGE := *LANGUAGE
  END-IF
  CALLNAT 'RFLIPG-N' G-LC G-LINECOM (*)
  PERFORM SET-PFKEYS
  INCLUDE RMVHLP-C
*
  INCLUDE C-TOPBOT
*
  CALLNAT 'N-HEADER' L-HEADER G-DATE-FORMAT 'RLISBRM&'
*
  PERFORM FLIP-DISPLAY
  SET CONTROL 'WB'
  IF G-DISPLAY-LONG-NAMES
    INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT MARK *G-DIRECT-COMMAND
      USING MAP 'RLISBR1&'
  ELSE
    INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT MARK *G-DIRECT-COMMAND
      USING MAP 'RLISBRM&'
  END-IF
*
  INCLUDE RPFKVA-C
*
  RESET G-NATRP-ERC G-NATRP-ERT #BROWSE-FLAGS
*
  INCLUDE C-DIRECT
  INCLUDE C-LOCCMD
  INCLUDE RPFKEX1C
*
  IF G-PF-FUNC = 'EXT'
    DECIDE FOR FIRST CONDITION
      WHEN G-SUPPORT-LONG-NAMES AND NOT G-DISPLAY-LONG-NAMES
        G-DISPLAY-LONG-NAMES := TRUE
      WHEN G-SUPPORT-LONG-NAMES AND G-DISPLAY-LONG-NAMES
        RESET G-DISPLAY-LONG-NAMES
      WHEN NONE IGNORE
    END-DECIDE
  END-IF
  PERFORM LINE-COMMANDS
*
  IF CV-SELECTION (*) MODIFIED
    #NEWVAL := TRUE
    +G-RLISBR-SEL-REPNAME := #S-REPNAME
    +G-RLISBR-SEL-GROUP   := #S-GROUP
  END-IF
*
END-REPEAT
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE LINE-COMMANDS
************************************************************************
IF L-MARK (*) = '.'
  INCLUDE C-ESCAPE
END-IF
*
INCLUDE RLCMTI-C
*
PERFORM READ-BUNDLE-GRANTS
*
FOR I 1 TO #NOFLINES
  DECIDE ON FIRST VALUE OF L-IDENT (I)
    VALUE ##EQU-DELETE
* BLI 2017-08-03 NOMALL-1986 check #GRANTS(2) and #UPDATE as w
**    IF NOT #DELETE
      IF NOT #UPDATE OR NOT #MODIFY-BUNDLE
        REINPUT *0020 MARK *L-MARK(I) ALARM
      END-IF
      IF B-FLUSH-REPORTS (*) = L-REPORT (I)
        REINPUT *0049 MARK *L-MARK(I) ALARM
      END-IF
    NONE VALUE
      IGNORE
  END-DECIDE
END-FOR
*
FOR I 1 TO #NOFLINES
  IF L-IDENT (I) =  ##EQU-DELETE
    G-NATRP-ERC := 0017
    IF G-CONFIRM
      #OBJECT-NAME := L-REPORT(I)
      #OBJECT-TYPE := 'R'
      CALLNAT 'N-CNFRM' #OBJECT-NAME
        #OBJECT-TYPE G-DISPLAY-LONG-NAMES
        #CONFIRMED G-NATRP-ERT LOWER-CASE
    END-IF
    IF #CONFIRMED OR NOT G-CONFIRM
      DGU. GET BUNDLE-REPORT L-ISN(I)
      DELETE RECORD(DGU.)
      #OBJ := BR-REPNAME
      PERFORM RMLOGDEL #OBJ 'BUNDLE-REPORT'
      INCLUDE L-COMMIT
      G-NATRP-ERC := 0018
      LG-USERID := G-USERID
      LG-CODE := 'BM'
      COMPRESS '2106' L-REPORT(I) G-C-BUNDLE TO LG-MSG
      LG-REPNAME := LG-OBJECT-NAME := G-C-BUNDLE
      CALLNAT 'RLOG' PL-PARMS
      GET-SCREEN := TRUE
      INCLUDE L-COMMIT
    END-IF
  END-IF
END-FOR
*
FOR I 1 TO #NOFLINES
  DECIDE ON FIRST VALUE OF L-IDENT (I)
    VALUE ##EQU-MODIFY
* BLI 2017-08-03 NOMALL-1986
      IF NOT #UPDATE OR NOT #MODIFY-BUNDLE
        G-C-FUNC := 'D'
      ELSE
        G-C-FUNC := 'M'
      END-IF
      PERFORM COMMIT-WORK
      G-C-REPORT := L-REPORT(I)
      FETCH RETURN 'RDEFBR' #BINARY-REPORTS
      GET-SCREEN := TRUE
    NONE VALUE
      IGNORE
  END-DECIDE
END-FOR
*
END-SUBROUTINE /* LINE-COMMANDS
*
************************************************************************
DEFINE SUBROUTINE READ-BUNDLE-GRANTS
************************************************************************
RESET #GRANTED #GRANTS(*) #MODIFY-BUNDLE
IF G-USER-TYPE = 'A'
  #MODIFY-BUNDLE := TRUE
  ESCAPE ROUTINE
END-IF
*
#USERID := G-USERID
#BUNDLE := G-C-BUNDLE
CALLNAT 'RGRANT-N' #USERID 'B' #BUNDLE #GRANTED #GRANTS(*)
* BLI 2017-08-03 NOMALL-1986 check #GRANTS(2) as well
** IF #GRANTED AND (#GRANTS(1) = 'Y' OR #GRANTS(3) = 'Y')
IF #GRANTED AND (#GRANTS(1) = 'Y' OR #GRANTS(2) ='Y' OR #GRANTS(3) ='Y')
  #MODIFY-BUNDLE := TRUE
END-IF
*
END-SUBROUTINE /*READ-BUNDLE-GRANTS
*
************************************************************************
DEFINE SUBROUTINE GET-SCREEN
************************************************************************
IF G-DIRECT-COMMAND = 'TOP'
  #TOP := TRUE
END-IF
RESET L-MARK(*)
*
DECIDE FOR EVERY  CONDITION
  WHEN #NEWVAL OR #TOP
    RESET #PAGES(*) #MAXP #MAXAP
    PERFORM INIT-SELECTION-KEYS
    #PAGES (1) := #START-KEY
    #PAGES-NUMBER (1) := 1
    #CP := 1
    #MAXAP := 1
  WHEN #BOT
    #CP := #MAXAP
  WHEN #FORWARD
    IF #END-OF-DATA
      ESCAPE ROUTINE
    END-IF
    IF #CP = #NOFPAGES
      #PAGES (1:#NOFPAGES - 1) := #PAGES (2:#NOFPAGES)
        #PAGES-NUMBER (1:#NOFPAGES - 1)
        := #PAGES-NUMBER (2:#NOFPAGES)
      #PAGES (#CP) := #LAST-KEY
      #PAGES-NUMBER (#CP) := #LAST-NUMBER
    ELSE
      IF #SCROLL-AMOUNT < 1
        #SCROLL-AMOUNT := 1
      END-IF
      IF #CP + #SCROLL-AMOUNT <= #MAXAP
        #CP := #CP + #SCROLL-AMOUNT
      ELSE
        IF #SCROLL-AMOUNT > 1
          #CP := #MAXAP
        ELSE
          ADD 1 TO #CP
        END-IF
      END-IF
      IF #CP > #MAXAP
        #PAGES (#CP) := #LAST-KEY
        #PAGES-NUMBER (#CP) := #LAST-NUMBER
      END-IF
    END-IF
  WHEN #BACKWARD
    IF #CP GE 2
      IF #SCROLL-AMOUNT < 1
        #SCROLL-AMOUNT := 1
      END-IF
      #CP := #CP - #SCROLL-AMOUNT
      IF #CP < 1
        #CP := 1
      END-IF
    END-IF
  WHEN GET-SCREEN
    IGNORE
  WHEN NONE
    ESCAPE ROUTINE
END-DECIDE
*
RESET I L-SCREEN (*) #END-OF-DATA
CV-MARK(*) := (AD=P)
*
RESET #OLD-GROUP #OLD-SEQNO #NUMBER
*
IF #CP > #MAXAP
  #MAXAP := #CP
END-IF
*
#START-KEY    := #PAGES (#CP)
#START-NUMBER := #PAGES-NUMBER (#CP)
*
READ-LOOP. READ BUNDLE-REPORT BY BR-BUNDLE-GROUP-SEQNO = #START-KEY
*
  IF BR-BUNDLE NE G-C-BUNDLE OR BR-GROUP > #S-GROUP-T
    ESCAPE BOTTOM
  END-IF
*
  IF #OLD-GROUP NE BR-GROUP OR #OLD-SEQNO NE BR-SEQNO
    RESET #NUMBER
    #OLD-GROUP := BR-GROUP
    #OLD-SEQNO := BR-SEQNO
  END-IF
*
  ADD 1 TO #NUMBER
*
  IF BR-GROUP = #SK-GROUP AND BR-SEQNO = #SK-SEQNO
      AND #NUMBER  < #START-NUMBER
    ESCAPE TOP
  END-IF
*
  #TK-BUNDLE            := G-C-BUNDLE
  #TK-GROUP             := BR-GROUP
  #TK-SEQNO             := BR-SEQNO
  #TOPKEY-NUMBER := #NUMBER
*
  DISPLAY-IT := TRUE
*
  IF NOT (BR-REPNAME = #S-REPNAME-F THRU #S-REPNAME-T)
    DISPLAY-IT := FALSE
  END-IF
*
  REJECT IF NOT DISPLAY-IT
*
  ADD 1 TO I
  IF I = 1
    #PAGES (#CP) := #TOPKEY
    #PAGES-NUMBER (#CP) := #TOPKEY-NUMBER
  END-IF
*
  #LK-BUNDLE := BR-BUNDLE
  #LK-GROUP  := BR-GROUP
  #LK-SEQNO  := BR-SEQNO
*
  IF I > #NOFLINES
    #LK-BUNDLE   := G-C-BUNDLE
    #LK-GROUP    := BR-GROUP
    #LK-SEQNO    := BR-SEQNO
    #LAST-NUMBER := #NUMBER
    ESCAPE ROUTINE
  END-IF
*
  RESET CV-MARK (I)
  L-GROUP  (I) := BR-GROUP
  L-REPORT (I) := BR-REPNAME
  L-SEQNO  (I) := BR-SEQNO
  L-SEPNO  (I) := BR-SEPNO
*
  FINDREP. FIND REPORTS WITH R-REPNAME = L-REPORT(I)
    L-SEPMEM (I) := R-SEPMEM
    IF R-REP-FORMAT = 'B'
      #BINARY-REPORTS := TRUE
    END-IF
  END-FIND
*
  IF L-SEPMEM(I) = ' ' AND L-SEPNO(I)  > 0
    L-SEPMEM(I) := 'DEFAULT'
  END-IF
  CALLNAT 'N-NONE' L-SEPMEM(I)
*
  L-REPNO(I) := BR-REPNO
  L-ISN(I) := *ISN (READ-LOOP.)
  RESET CV-MARK (I)
*
END-READ
*
#END-OF-DATA := TRUE
#MAXP := #CP
*
END-SUBROUTINE /* GET-SCREEN
*
************************************************************************
DEFINE SUBROUTINE INIT-SELECTION-KEYS
************************************************************************
#LEN := 25
CALLNAT 'SELALPHA' #S-REPNAME #S-REPNAME-F #S-REPNAME-T #LEN
*
CALLNAT 'SELALPHA' #S-GROUP #S-GROUP-F #S-GROUP-T #LEN
*
#SK-BUNDLE := G-C-BUNDLE
#SK-GROUP  := #S-GROUP-F
#SK-SEQNO  := 0
*
END-SUBROUTINE /* INIT-SELECTION-KEYS
*
************************************************************************
DEFINE SUBROUTINE INIT-LINECOM
************************************************************************
G-LC-IDENT (01) := ##EQU-MODIFY
G-LC-IDENT (02) := ##EQU-DELETE
G-LC-NUM        := 2
CALLNAT 'RLCINI-N' G-OBJ-TYPE G-LC G-LCB
*
END-SUBROUTINE /* INIT-LINECOM
*
************************************************************************
DEFINE SUBROUTINE INIT-PFKEYS
************************************************************************
INCLUDE RPFSTD-C
INCLUDE RPFADD-C
INCLUDE RPFBRW-C
INCLUDE RPFEXT-C
CALLNAT 'RPFINI-N' G-PF G-PFB
*
END-SUBROUTINE /* INIT-PFKEYS
* --------------------------------------- set pfkeys -------------------
INCLUDE RPFSET-C
*
END
