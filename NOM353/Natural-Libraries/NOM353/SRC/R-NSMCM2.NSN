* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* R-NSMCM2 - CALL the Compression Utility NSMCMP
*
* Maintenance:
* uuuuuuuu yyyy-mm-dd P999999 ....
* fhi      2009-09-15 P320367 Created. Template R-NSMCMP
* fhi      2011-10-19 NOMALL-73 Honour new nomcompr field types
* SPLILDAV 2012-06-27 NOMALL-1078 SUPPORT COMPRESSION 16K BYTE RECORDS
* RAYA     2013-06-23 NOMALL-1268 Trace
* fhi      2013-12-18 NOMALL-1078 Correct different handling for Unix
* SU1      2013-12-19 NOMALL-1078 Correct different handling for Unix
* fhi      2014-03-24 NOMALL-1326 If NOMCOMPR not linked, issue error
* fhi      2016-04-13 NOMALL-1858 Handle empty lines in buffer
* SU2      2016-09-06 NOMALL-1912 unix:show NOM33 report from container
* ----------------------------------------------------------------------
DEFINE DATA
PARAMETER
1 #NSMCOMP-PARMS
  2 #NSMCOMP-CB                     (B40)
  2 REDEFINE #NSMCOMP-CB
    3 #NSMCOMP-CB_B4                (B4)
  2 REDEFINE #NSMCOMP-CB
    3 #COMP-COMMAND                 (A1)
    3 #COMP-CODE                    (B1)
    3 #COMP-INLENGTH-OLD            (B1)
    3 #COMP-OUTLENGTH-OLD           (B1)
    3 #COMP-INLENGTH                (I2)
    3 #COMP-OUTLENGTH               (I2)
  2 #NSMCOMP-LINE                   (A251)
  2 #NSMCOMP-BUFFER-LENGTH          (B4)
  2 #NSMCOMP-BUFFER                 (A251/9)
  2 REDEFINE #NSMCOMP-BUFFER
    3 FILLER                        251X
    3 #NSMCOMP-BUFFER_A2008         (A2008) /*251*8=2008
  2 #NSMCOMP-RC                     (B2)
  2 #NSMCOMP-WORK                   (B4)
* *****
LOCAL
1 #TRACE (L) /*INIT <TRUE>
1 #MSG   (A250)
1 #I4    (I4)
1 #NSMCOMP-BUFFER_A16381            (A16381)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
FORMAT AD=L
IF #TRACE
  PRINT *PROGRAM 'in : cmd:' #COMP-COMMAND 'code:' #COMP-CODE
    'inlen_old:' #COMP-INLENGTH-OLD 'outlen_old:' #COMP-OUTLENGTH-OLD
    'inlen:' #COMP-INLENGTH 'outlen:' #COMP-OUTLENGTH
    'buf_len:' #NSMCOMP-BUFFER-LENGTH 'work:' #NSMCOMP-WORK
    / 'line:' #NSMCOMP-LINE (AL=20) #NSMCOMP-LINE (EM=H(5))
    / 'buffer:' #NSMCOMP-BUFFER (2)(AL=20) #NSMCOMP-BUFFER (2)(EM=H(10))
END-IF
IF *MACHINE-CLASS = 'MAINFRAME'
  IF #COMP-CODE NE 'N'
    WRITE *PROGRAM 'OLD COMPRESSION CODE' #COMP-CODE
  END-IF
  CALL 'NSMCMP' #NSMCOMP-CB #NSMCOMP-LINE #NSMCOMP-BUFFER-LENGTH
    #NSMCOMP-BUFFER (2) #NSMCOMP-RC #NSMCOMP-WORK
ELSE
  IF #COMP-COMMAND = 'D' AND SUBSTR (#NSMCOMP-BUFFER(2),1,1) NE 'V'
    IF #TRACE
      PRINT 'old version'
    END-IF
    #NSMCOMP-BUFFER_A16381 := #NSMCOMP-BUFFER_A2008
    CALLNAT 'R-NSMCM3' #NSMCOMP-CB #NSMCOMP-LINE #NSMCOMP-BUFFER-LENGTH
      #NSMCOMP-BUFFER_A16381 #NSMCOMP-RC #NSMCOMP-WORK
    #NSMCOMP-BUFFER_A2008 := #NSMCOMP-BUFFER_A16381
  ELSE
    IF #COMP-COMMAND = 'C'
      IF #COMP-INLENGTH = 0
        RESET #NSMCOMP-LINE /* empty line,
        #COMP-INLENGTH := 1 /* but pass over one blank
      END-IF
    END-IF
    CALL 'NSMCMP2' #NSMCOMP-CB #NSMCOMP-LINE #NSMCOMP-BUFFER-LENGTH
      #NSMCOMP-BUFFER (2) #NSMCOMP-RC #NSMCOMP-WORK
    IF RET('NSMCMP2') NE 0
      #NSMCOMP-RC := RET('NSMCMP2')
    END-IF
  END-IF
  IF #NSMCOMP-RC = 4 AND #COMP-INLENGTH = 2 /* empty line in buffer
      AND #COMP-COMMAND = 'D'
    #I4 := #NSMCOMP-WORK
    ADD 2 TO #I4                    /* proceed to next line in buffer
    IF #I4 < #NSMCOMP-BUFFER-LENGTH
      #NSMCOMP-WORK := #I4
      RESET #NSMCOMP-LINE #NSMCOMP-RC
    END-IF
  END-IF
END-IF
IF #TRACE
  PRINT *PROGRAM 'out: cmd:' #COMP-COMMAND 'code:' #COMP-CODE
    'inlen_old:' #COMP-INLENGTH-OLD 'outlen_old:' #COMP-OUTLENGTH-OLD
    'inlen:' #COMP-INLENGTH 'outlen:' #COMP-OUTLENGTH
    'buf_len:' #NSMCOMP-BUFFER-LENGTH 'work:' #NSMCOMP-WORK
    / 'line:' #NSMCOMP-LINE (AL=20) #NSMCOMP-LINE (EM=H(10))
    / 'buffer:' #NSMCOMP-BUFFER (2)(AL=20) #NSMCOMP-BUFFER (2)(EM=H(10))
    / 'error:'#NSMCOMP-RC
END-IF
*
************************************************************************
ON ERROR
************************************************************************
  IF *ERROR-NR = 920
    #MSG := '134' /* NOM0134 NOMCOMPR missing.
    PERFORM XXRLOG-WRITE-LOG 'W' #MSG
    END TRANSACTION
    ESCAPE ROUTINE
  ELSE
    CALLNAT 'C-NATERN' #MSG
  END-IF
END-ERROR
*
END
