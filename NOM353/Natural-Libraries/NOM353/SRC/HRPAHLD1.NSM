* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* MAP2: PROTOTYPE VERSION 820 --- CREATED BY NAT 0802030000 ---
* INPUT USING MAP 'XXXXXXXX'
*     #CODE
DEFINE DATA PARAMETER
1 #CODE (A001)
END-DEFINE
FORMAT PS=012 LS=041 ZP=OFF SG=OFF KD=OFF IP=OFF
* MAP2: MAP PROFILES *****************************        410***********
* .TTAAAMMOO   TU6ID I N D I D I        ?_)^&:+(                       *
* 012040        N0 NUCN             X        01 SYSPROF NLH          1 *
************************************************************************
INPUT          (     IP=OFF                                           /*
                                                                       )
 010T '- Hold Before Print -'(YEI)
/
/
 004T 'H'(YEI)
 007T 'Report'(TU)
 014T 'held'(YEI)
 019T 'in printout queue'(TU)
/
 007T 'until released manually'(TU)
/
/
 004T 'C'(YEI)
 007T 'Report held in printout queue'(TU)
/
 007T 'until all users in distribution'(TU)
/
 007T 'list'(TU)
 012T 'confirm'(YEI)
 020T 'printing'(TU)
/
/
 004T 'R'(YEI)
 007T 'Release'(YEI)
 015T 'for print immediately'(TU)
/
/
 015T 'Select'(YEI)
 022T '=>'(TU)
 025T #CODE  (AD=MIT CD=RE ) /*.99U001 A001 .
* MAP2: VALIDATION *****************************************************
RULEVAR F00#CODE
INCDIC                                 ;
IF NOT(& = ' ' OR = 'R' OR = 'H' OR = 'C')
  REINPUT *0007 ALARM
END-IF
SET CONTROL 'Q'
* MAP2: END OF MAP *****************************************************
END
