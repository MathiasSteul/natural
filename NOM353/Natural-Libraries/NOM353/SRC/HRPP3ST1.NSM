INPUT          (     IP=OFF                                           /*
                                                                       )
 015T '- Standard Separation 3 Search String -'(YEI)
/
/
 001T 'Enter the string to be searched for. If this string appears on a'(TU)
/
 001T 'page the lines are analyzed. Otherwise the whole page is rejected.'(TU)
/
/
 001T 'You must specify'(TU)
 018T 'Search Line.'(YEI)
/
/
 001T 'You can specify a search pattern containing'(TU)
 045T '*'(YEI)
 047T 'and/or'(TU)
 054T '%,'(YEI)
 057T 'where'(TU)
 063T '*'(YEI)
/
 001T 'stands for any string and'(TU)
