*
************************************************************************
* Main line
************************************************************************
*
FORMAT LS=100
*
IF P-TRACE GE *LEVEL
  #TRACING := TRUE
END-IF
RMSETTIM.FUNCTION := 'S'
PERFORM RMSETTIM-SETTIME RMSETTIM
#NSMCOMP-BUFFER-LENGTH := 16381 - 7
#NSMCOMP-CODE         := 'N'  /* 'N' - NEW PARM LIST
#NSMCOMP-COMMAND      := 'C'
CONTAINER.ST-TEXT-LOB := H'000000'
CONTAINER.ST-ID       := P-ID
* PERFORM XXTIMSTP-GET-TIMESTAMP #TIMESTAMP 'H' /* NOMALL-1748 out
*
RESET P-RECORD-LENGTH P-NUMBER-OF-LINES P-RECORDS-STORED P-STAT
P-STAT-STIME := *TIMX
*
IF +TRACE-ORDER = ' ' /* not yet determined from jobcards
  PERFORM RMGTRACE-GET-SETTINGS
END-IF
* Reset output fields, #P-FILE-NAME is needed for load-ok, time msg BLI5
RESET P-ERROR-CODE P-ERROR-TEXT P-ERROR-OBJECT #P-FILE-NAME
*
#P-SOURCE-TYPE := P-SOURCE-TYPE
DECIDE ON FIRST P-SOURCE-TYPE
  VALUE JES2, JES3            PERFORM COPY-JES
/*SU13 VALUE SEQUENTIAL-FILE-VSE   PERFORM COPY-FVSE
  VALUE SEQUENTIAL-FILE-MVS   PERFORM COPY-FMVS
  VALUE SEQUENTIAL-FILE-BS2   PERFORM COPY-FBS2
/*SU13 VALUE POWER                 PERFORM COPY-POWER
  VALUE CMASPOOL              PERFORM COPY-CMASPOOL
  VALUE SEQUENTIAL-FILE-UNIX  PERFORM COPY-UNIX
  NONE
    P-ERROR-CODE := 0005
    COMPRESS *PROGRAM 'Invalid Source Type'
      #P-SOURCE-TYPE TO P-ERROR-TEXT
END-DECIDE
*
IF P-ERROR-CODE NE 0         /* AND P-ERROR-CODE NE 4 EOF NOMALL-2088
AND P-ERROR-CODE NE 9997 /* NOMALL-2294 BLI wait-retry/skip           /*
  IF #TRACING
    #TRACE-MSG := 'Backout Copy initiated.'
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
  END-IF
  PERFORM BACKOUT-COPY
END-IF
P-STAT-INREC := P-NUMBER-OF-LINES
RMSETTIM.FUNCTION := 'G'
PERFORM RMSETTIM-SETTIME RMSETTIM
P-STAT-ETIME := RMSETTIM.TIME
IF #TRACING
  PERFORM XXRLOG-WRITE-LOG 'T' RMSETTIM.MSG
  END TRANSACTION
  IF P-SOURCE-TYPE = SEQUENTIAL-FILE-UNIX
    #TIME-SEC-F     := RMSETTIM.TIME / 10
    #TIME-CPU-SEC-F := RMSETTIM.CPUTIME / 100
    MOVE EDITED #TIME-SEC-F (EM=ZZZZZZZ9.9) TO #TIME-SEC
    MOVE EDITED #TIME-CPU-SEC-F (EM=ZZZZZZ9.99) TO #TIME-CPU-SEC
    MOVE LEFT   #TIME-SEC     TO #TIME-SEC
    MOVE LEFT   #TIME-CPU-SEC TO #TIME-CPU-SEC
    COMPRESS '4209' #TIME-SEC #TIME-CPU-SEC #P-FILE-NAME TO #TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG /* BLI 2019-11-13
    END TRANSACTION
  END-IF
END-IF                                      /* BLI 2019-11-13
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE COPY-UNIX
************************************************************************
#SOURCE-ATTRIBUTES := P-SOURCE-ATTRIBUTES
#SPOOL-ATTRIBUTES  := P-SPOOL-ATTRIBUTES
CALLNAT 'RMSPL7-N' #SPOOL-ATTRIBUTES #SPOOL-TYPE /*conv.Jobnr+node nr
RESET P-ERROR-CODE P-ERROR-TEXT
* NOMALL-2294 BLI start
P-NODE-NAME         := #SPOOL-UNIX-NODE-NAME
P-USERID            := #SPOOL-UNIX-USERID
P-CIPHER-PASSWORD   := #SPOOL-UNIX-CIPHER-PASSWORD
P-GROUP             := #SPOOL-UNIX-GROUP
IF P-NODE-SUSPEND = ' '
  RESET #UX-ISN
  FDUX. FIND (1) UX-NODES WITH UX-NODE-NAME = #SPOOL-UNIX-NODE-NAME
    ACCEPT IF NOT(UX-NODE-SUSPEND ='D' OR='E' OR ='S')
    P-NODE-SUSPEND    := UX-NODE-SUSPEND
    P-NODE-NAME       := UX-NODE-NAME
    P-USERID          := UX-NODE-USERID
    P-CIPHER-PASSWORD := UX-NODE-PASSWORD
    P-GROUP           := UX-NODE-GROUP
    #UX-ISN           := *ISN(FDUX.)
  END-FIND
  IF #UX-ISN EQ 0
    P-ERROR-CODE := 0005
    COMPRESS *PROGRAM 'Node not active' #SPOOL-UNIX-NODE-NAME
      TO P-ERROR-TEXT
    COMPRESS '2038' UX-NODE-NAME TO #TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'W' #TRACE-MSG
    END TRANSACTION
*
    RESET P-RETRY-POSSIBLE
    ESCAPE ROUTINE
  END-IF
END-IF
#SUSP-REMEMBER := P-NODE-SUSPEND
* NOMALL-2294 BLI end
DECIDE ON EVERY VALUE OF P-ERROR-CODE
  VALUE 0
    PERFORM WAIT-LOCKED
  VALUE 0
    PERFORM READ-UNIX-RECORDS
  VALUE 0
    IF IN-BUFFER
      PERFORM STORE-RECORD
    END-IF
  VALUE 0                              /* NOMALL-2294 BLI start
    END TRANSACTION
    P-RECORDS-STORED := TRUE
  ANY
    IF P-ERROR-CODE NE 0 AND P-ERROR-CODE NE 9997  /* wait/skip
      P-ERROR-OBJECT:= #UNIX-FILE-SPEC
      BACKOUT TRANSACTION
      RESET P-RETRY-POSSIBLE
* deactivate node, stop copying                NOMALL-2294 BLI
      PERFORM SET-SUSPEND
    END-IF
  NONE IGNORE
END-DECIDE
*
* BLI8 No Delete hereÜ
*
END-SUBROUTINE /* COPY-UNIX
*
************************************************************************
DEFINE SUBROUTINE COPY-CMASPOOL
************************************************************************
#SOURCE-ATTRIBUTES := P-SOURCE-ATTRIBUTES
PERFORM OPEN-CMASPOOL-PRINTER
IF ERROR-OCCURED
  IF NOT P-RETRY-ALLOWED AND NOT P-RETRY-POSSIBLE
    COMPRESS #CMASPOOL-OWNNM '/' #CMASPOOL-DEST
      TO P-ERROR-OBJECT LEAVING NO
  END-IF
  ESCAPE ROUTINE
END-IF
PERFORM READ-CMASPOOL-RECORDS
PERFORM CLOSE-CMASPOOL-PRINTER
*
IF P-ERROR-CODE = 0
  IF IN-BUFFER
    PERFORM STORE-RECORD
  END-IF
  END TRANSACTION
  P-RECORDS-STORED := TRUE
ELSE
  COMPRESS #CMASPOOL-OWNNM '/' #CMASPOOL-DEST
    TO P-ERROR-OBJECT LEAVING NO
  BACKOUT TRANSACTION
END-IF
*
END-SUBROUTINE /* COPY-CMASPOOL
*
************************************************************************
DEFINE SUBROUTINE COPY-JES
************************************************************************
#SOURCE-ATTRIBUTES := P-SOURCE-ATTRIBUTES
#P-SOURCE-TYPE-BIN := P-SOURCE-TYPE
CALLNAT 'RMSR7--N' #SOURCE-ATTRIBUTES #P-SOURCE-TYPE-BIN
FNDJES. FIND READ-SPOOL WITH NODE = #JES-NODE
AND JOB-NAME = #JES-JOB-NAME AND JOB-NUMBER   = #JES-JOB-NUMBER       /*
AND TYPE     = #JES-TYPE     AND DATA-SET-KEY = #JES-DATA-SET-KEY     /*
  AT START OF DATA
    CONTAINER.ST-LINE-START := RECORD-NUMBER
  END-START
  IF ERROR-CODE NE 0
    P-ERROR-CODE := 0005
    COMPRESS ERROR-TEXT '/' +NOD-CURRENT-NAME '/' *PROGRAM '/' *LINE
      TO P-ERROR-TEXT
    ESCAPE BOTTOM (FNDJES.)
  END-IF
  #NSMCOMP-LINE := F#CONVERT-RECORD-HEX
    (<READ-SPOOL.RECORD-HEX1,READ-SPOOL.RECORD-HEX2,
    READ-SPOOL.RECORD-HEX3,#TRACING,P-REMOTE-CODEPAGE>)
  #RECORD-NUMBER := RECORD-NUMBER
  ADD RECORD-LENGTH TO P-STAT-INBYTE
  IF RECORD-LENGTH > 251
    #NSMCOMP-INLENGTH := 251
  ELSE
    IF #NSMCOMP-LINE = H'01' AND RECORD-LENGTH LT 3
      #NSMCOMP-INLENGTH := 3
    ELSE
      #NSMCOMP-INLENGTH := RECORD-LENGTH
    END-IF
  END-IF
  PERFORM #COMPR
  IF P-ERROR-CODE NE 0
    ESCAPE BOTTOM (FNDJES.)
  END-IF
END-FIND /*(FNDJES.)
P-NUMBER-OF-LINES := *COUNTER (FNDJES.)
IF P-ERROR-CODE = 0
  COMPRESS #JES-JOB-NAME '/' #JES-JOB-NUMBER
    '/' #JES-TYPE '/' #JES-DATA-SET TO #P-FILE-NAME LEAVING NO /* BLI5
  IF IN-BUFFER
    PERFORM STORE-RECORD
  END-IF
  END TRANSACTION
  P-RECORDS-STORED := TRUE
ELSE
  COMPRESS #JES-JOB-NAME '/' #JES-JOB-NUMBER
    '/' #JES-TYPE '/' #JES-DATA-SET TO P-ERROR-OBJECT LEAVING NO
  BACKOUT TRANSACTION
END-IF
*
END-SUBROUTINE /* COPY-JES
*
************************************************************************
DEFINE SUBROUTINE COPY-FMVS
************************************************************************
#SOURCE-ATTRIBUTES := P-SOURCE-ATTRIBUTES
#P-SOURCE-TYPE-BIN := P-SOURCE-TYPE
CALLNAT 'RMSR7--N' #SOURCE-ATTRIBUTES #P-SOURCE-TYPE-BIN
FNDFMVS. FIND READ-FILE WITH NODE = #FMVS-NODE AND DSNAME = #FMVS-DSNAME
AND LRECL   = #FMVS-LRECL AND RECFM   = #FMVS-RECFM                   /*
AND BLKSIZE = #FMVS-BLKSIZE AND SEGMENT-LENGTH = 251                  /*
  AT START OF DATA
    CONTAINER.ST-LINE-START := RECORD-NUMBER
  END-START
  IF ERROR-CODE NE 0
    P-ERROR-CODE := 0005
    COMPRESS ERROR-TEXT '/' +NOD-CURRENT-NAME '/' *PROGRAM '/' *LINE
      TO P-ERROR-TEXT
    ESCAPE BOTTOM (FNDFMVS.)
  END-IF
  #NSMCOMP-LINE := F#CONVERT-RECORD-HEX
    (<READ-FILE.RECORD-HEX1,READ-FILE.RECORD-HEX2,
    READ-SPOOL.RECORD-HEX3,#TRACING,P-REMOTE-CODEPAGE>)
  IF SEGMENT-NUMBER > 1 AND SEGMENT-LENGTH < 251
    COMPRESS '§' #NSMCOMP-LINE
      TO #NSMCOMP-LINE LEAVING NO /* first byte is cc-character
    EXAMINE SUBSTRING (#NSMCOMP-LINE,1,1) FOR '§' REPLACE WITH ' '
    ADD 1 TO SEGMENT-LENGTH
  END-IF
  #RECORD-NUMBER := RECORD-NUMBER
  ADD SEGMENT-LENGTH TO P-STAT-INBYTE
  #NSMCOMP-INLENGTH := SEGMENT-LENGTH
  PERFORM #COMPR
  IF P-ERROR-CODE NE 0
    ESCAPE BOTTOM (FNDFMVS.)
  END-IF
END-FIND /*(FNDFMVS.)
P-NUMBER-OF-LINES := *COUNTER (FNDFMVS.)
IF P-ERROR-CODE = 0
  #P-FILE-NAME := #FMVS-DSNAME  /* BLI5
  IF IN-BUFFER
    PERFORM STORE-RECORD
  END-IF
  END TRANSACTION
  P-RECORDS-STORED := TRUE
ELSE
  P-ERROR-OBJECT:= #FMVS-DSNAME
  BACKOUT TRANSACTION
END-IF
*
END-SUBROUTINE /* COPY-FMVS
*
************************************************************************
DEFINE SUBROUTINE COPY-FBS2
************************************************************************
#SPOOL-ATTRIBUTES  := P-SPOOL-ATTRIBUTES /* BLI2
#SOURCE-ATTRIBUTES := P-SOURCE-ATTRIBUTES
#P-SOURCE-TYPE-BIN := P-SOURCE-TYPE
CALLNAT 'RMSR7--N' #SOURCE-ATTRIBUTES #P-SOURCE-TYPE-BIN
IF *MACHINE-CLASS NE 'MAINFRAME' /*SU11
  IF F#ESA (<#FBS2-NODE>) /*must be separate IF ÜÜ
    CALLNAT 'NOMESA' #FBS2-NODE (AD=O) +NOD-CURRENT-NAME(AD=O) 1X
      #USE-ESA
  END-IF
END-IF
*
* NOMALL-2294 BLI use 1-digit of task number for copying
#RECEIPT-STAMP := #P-TASK-NUMBER-STMP
#RECEIPT-NODE  := #FBS2-NODE-A
#RECEIPT-FILE  := #FBS2-DSNAME
CALLNAT 'RMRCSTMP' #RECEIPT-STAMP SEQUENTIAL-FILE-BS2
  #RECEIPT-NODE #RECEIPT-FILE #TRACING #SPOOL-BS2-JOB-ID /* BLI2
IF #RECEIPT-STAMP NE #P-TASK-NUMBER-STMP /* cannot done by this task
  P-ERROR-CODE := 9997                   /* skip
  ESCAPE ROUTINE
END-IF
END TRANSACTION                          /* BLI1
*
#TD. SET TIME /*SU11
IF #TRACING
  PRINT NOTITLE NOHDR (AD=L) *PROGRAM *DAT4I *TIME(AL=8)
    'start:' #FBS2-NODE '/' #FBS2-DSNAME
END-IF
IF #USE-ESA /*ESA SU11
  #ESA. FIND READ-FILE-ESA WITH NODE =#FBS2-NODE AND DSNAME=#FBS2-DSNAME
  AND SEGMENT-LENGTH = 251                                            /*
    AT START OF DATA
      CONTAINER.ST-LINE-START := RECORD-NUMBER
    END-START
    MOVE BY NAME READ-FILE-ESA TO READ-FILE
    PERFORM COPY-FBS2_ALL
    IF #ESC
      ESCAPE BOTTOM
    END-IF
  END-FIND
  P-NUMBER-OF-LINES := *COUNTER (#ESA.)
ELSE /*NPR
  FNDFBS2. FIND READ-FILE WITH NODE = #FBS2-NODE AND DSNAME=#FBS2-DSNAME
  AND SEGMENT-LENGTH = 251                                            /*
    AT START OF DATA
      CONTAINER.ST-LINE-START := RECORD-NUMBER
    END-START
    PERFORM COPY-FBS2_ALL
    IF #ESC
      ESCAPE BOTTOM
    END-IF
  END-FIND /*(FNDFBS2.)
  P-NUMBER-OF-LINES := *COUNTER (FNDFBS2.)
END-IF
IF #TRACING
  PRINT NOTITLE NOHDR (AD=L) *PROGRAM *DAT4I *TIME(AL=8)
    'elapsed time:' *TIMD (#TD.)(EM=99':'99':'99'.'9) '(HH:MM:SS.T)'
END-IF
IF P-ERROR-CODE = 0
  #P-FILE-NAME := #FBS2-DSNAME /* BLI5
  IF IN-BUFFER
    PERFORM STORE-RECORD
  END-IF
  END TRANSACTION
  P-RECORDS-STORED := TRUE
ELSE
  P-ERROR-OBJECT:= #FBS2-DSNAME
  BACKOUT TRANSACTION
END-IF
*
#RECEIPT-STAMP := 'Q' /* query receipt stamp     /* BLI1 start
CALLNAT 'RMRCSTMP' #RECEIPT-STAMP SEQUENTIAL-FILE-BS2 #RECEIPT-NODE
  #RECEIPT-FILE #TRACING #SPOOL-BS2-JOB-ID       /* BLI2
IF #RECEIPT-STAMP EQ #P-TASK-NUMBER-STMP /* same task
  #RECEIPT-STAMP := 'U' /* unlock file for further processing
  CALLNAT 'RMRCSTMP' #RECEIPT-STAMP SEQUENTIAL-FILE-BS2 #RECEIPT-NODE
    #RECEIPT-FILE #TRACING #SPOOL-BS2-JOB-ID     /* BLI2
  END TRANSACTION
END-IF                                           /* BLI1 end
*
END-SUBROUTINE /* COPY-FBS2
*
************************************************************************
DEFINE SUBROUTINE COPY-FBS2_ALL /*SU11
************************************************************************
RESET #ESC
IF READ-FILE.ERROR-CODE NE 0
  IF READ-FILE.ERROR-CODE = 700
   /* NPR ERROR 700 + FILE-SIZE = 0 => FILE EMPTY, JUST DELETE IT
    FILEATT. FIND FILE-ATTRIBUTES WITH NODE = #FBS2-NODE
    AND DSNAME  = #FBS2-DSNAME                                        /*
      IF ERROR-CODE(FILEATT.) NE 0 /*SU8
        P-ERROR-CODE := 0005
        COMPRESS ERROR-TEXT (FILEATT.) '/' +NOD-CURRENT-NAME
          '/' *PROGRAM '/' *LINE TO P-ERROR-TEXT
        #ESC := TRUE
        ESCAPE ROUTINE
      END-IF
      IF ERROR-CODE(FILEATT.) = 0 AND FILE-SIZE(FILEATT.) = 0
        VTOCUPD. FIND VTOC-UPDATE WITH NODE    = #FBS2-NODE
          AND DSNAME  = #FBS2-DSNAME AND FUNCTION = 'PURGE'           /*
          WRITE NOTITLE NOHDR / *PROGRAM
            *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II) 'Empty file'
            #FBS2-DSNAME 'was deleted.' ERROR-TEXT(VTOCUPD.)
          IF ERROR-CODE NE 0 /*SU8
            PRINT ERROR-CODE ERROR-TEXT
          END-IF
        END-FIND /*(VTOCUPD.)
        #ESC := TRUE
        ESCAPE ROUTINE
      END-IF
    END-FIND /*(FILEATT.)
  END-IF
  P-ERROR-CODE := 0005
  COMPRESS READ-FILE.ERROR-TEXT '/' +NOD-CURRENT-NAME
    '/' *PROGRAM '/' *LINE TO P-ERROR-TEXT
  #ESC := TRUE
  ESCAPE ROUTINE
END-IF
IF #USE-ESA
  #NSMCOMP-LINE := READ-FILE.RECORD
ELSE
  #NSMCOMP-LINE := F#CONVERT-RECORD-HEX (<READ-FILE.RECORD-HEX1,
    READ-FILE.RECORD-HEX2,READ-FILE.RECORD-HEX3,
    #TRACING,P-REMOTE-CODEPAGE>)
END-IF
IF READ-FILE.SEGMENT-NUMBER > 1 AND READ-FILE.SEGMENT-LENGTH < 251
  COMPRESS '§' #NSMCOMP-LINE
    TO #NSMCOMP-LINE LEAVING NO /* first byte is cc-character
  EXAMINE SUBSTRING (#NSMCOMP-LINE,1,1) FOR '§' REPLACE WITH ' '
  ADD 1 TO READ-FILE.SEGMENT-LENGTH
END-IF
#RECORD-NUMBER := READ-FILE.RECORD-NUMBER
ADD READ-FILE.SEGMENT-LENGTH TO P-STAT-INBYTE
#NSMCOMP-INLENGTH := READ-FILE.SEGMENT-LENGTH
  PERFORM #COMPR
IF P-ERROR-CODE NE 0
  #ESC := TRUE
END-IF
*
END-SUBROUTINE /* COPY-FBS2_ALL
*
************************************************************************
DEFINE SUBROUTINE COMPRESS-INTO-BUFFER
************************************************************************
REPEAT
  IF *MACHINE-CLASS NE 'MAINFRAME' /*SU10
  AND P-SOURCE-TYPE = SEQUENTIAL-FILE-BS2                             /*
  AND SUBSTR(#NSMCOMP-LINE,1,1) = H'00'                               /*
    MOVE ' ' TO SUBSTR(#NSMCOMP-LINE,1,1)
  END-IF
  INCLUDE C-NSMCMP 'CONTAINER.ST-TEXT-LOB'
  DECIDE ON FIRST #NSMCOMP-RC
    VALUE 0
      IF P-SOURCE-TYPE = SEQUENTIAL-FILE-UNIX AND NOT IN-BUFFER
        CONTAINER.ST-LINE-START := #RECORD-NUMBER
      END-IF
      CONTAINER.ST-LINE-END := #RECORD-NUMBER
      IN-BUFFER := TRUE
      ESCAPE BOTTOM
    VALUE 4
      PERFORM STORE-RECORD
      CONTAINER.ST-LINE-START := #RECORD-NUMBER
      RESET   CONTAINER.ST-LINE-END
      CONTAINER.ST-TEXT-LOB := H'000000'
      IN-BUFFER := FALSE
    NONE
      P-ERROR-CODE := 0005
      COMPRESS 'Error' #NSMCOMP-RC 'occured' TO P-ERROR-TEXT
      ESCAPE BOTTOM
  END-DECIDE
END-REPEAT
*
END-SUBROUTINE /* COMPRESS-INTO-BUFFER
*
************************************************************************
DEFINE SUBROUTINE STORE-RECORD
************************************************************************
*** Erase 'tail end' of buffer
IF CONTAINER.ST-BUFFER-LENGTH-X < #NSMCOMP-BUFFER-LENGTH
  #FROM := CONTAINER.ST-BUFFER-LENGTH-X
  #FROM := #FROM + 1 + 3         /* Include 'v34' prefix
  #TO   := #NSMCOMP-BUFFER-LENGTH
  IF #FROM LE #TO
    RESET CONTAINER.ST-B-LOB (#FROM : #TO)
  END-IF
END-IF
*
ADD 1 TO P-STAT-OUTREC
P-STAT-OUTBYTE := P-STAT-OUTBYTE + #FROM
*
STORE CONTAINER
*
ADD 1 TO #COUNTER
IF #COUNTER > #COUNT
  END TRANSACTION
  P-RECORDS-STORED := TRUE
  RESET #COUNTER
END-IF
*
END-SUBROUTINE /* STORE-RECORD
*
************************************************************************
DEFINE SUBROUTINE OPEN-CMASPOOL-PRINTER
************************************************************************
RESET #ESFO
#ESFO-UID := 'NOMMON' /*was deactivated with version from 20201202 SU13
#ESFO-STA := '11'
#ESFO-LNG := 288
#ESFO-TYP := '2'
#ESFO-FNO := #CMASPOOL-SEQNO
#ESFO-OWN := #CMASPOOL-OWNNM
#ESFO-FNAM := #CMASPOOL-OWNNM
#ESFO-DES := #CMASPOOL-DEST
#ESFO-SID := #CMASPOOL-SID
#ESFO-DAM := 'N'
* react; deactivated with version from 20201202 Ü? SU13 ->
CALL 'ESFOPEN' #ESF-OPEN-PARMS (*)
#ESF-RC := RET ('ESFOPEN') /*SU13 <-
#CBA := #ESFO-CBA
#FNO := #ESFO-FNO
*
IF #ESF-RC > H'0000' OR #ESFO-STA NE ' '
  COMPRESS 'Error during Open CA Spool RC=' #ESF-RC-I
    TO P-ERROR-TEXT LEAVING NO
  COMPRESS P-ERROR-TEXT 'STA=' TO P-ERROR-TEXT
  COMPRESS P-ERROR-TEXT #ESFO-STA TO P-ERROR-TEXT LEAVING NO
  P-ERROR-CODE := 0005
  ERROR-OCCURED := TRUE
  IF #ESF-RC = H'0000'
    IF #ESFO-STA = 'NS'     /* No storage was available
        OR = '01'     /* File queue was full
        OR = '02'     /* No more spool space available
        OR = '03'     /* No storage available for control blocks
        OR = '06'     /* Destination name does not match
        OR = '07'     /* File not permanently closed
        OR = '12'     /* File not temporarily closed
        OR = '13'     /* Not temporarily closed for output processing
        OR = '14'     /* Not temporarily closed for input procesing
      P-RETRY-POSSIBLE := TRUE
    END-IF
  END-IF
  IF NOT P-RETRY-POSSIBLE OR NOT P-RETRY-ALLOWED OR #TRACING
    COMPRESS 'Unable to process CA Spool Dest:' #CMASPOOL-DEST 'Ownnm:'
      #CMASPOOL-OWNNM TO #TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
  END-IF
  ESCAPE ROUTINE
END-IF
*
END-SUBROUTINE /* OPEN-CMASPOOL-PRINTER
*
************************************************************************
DEFINE SUBROUTINE READ-UNIX-RECORDS
************************************************************************
CONTAINER.ST-LINE-START := 1
RESET #RECORD
XXHASH-PARMS.P-SHORT-NAME := #SPOOL-UNIX-FILE-NAME
PERFORM GET-LONG-NAME
COMPRESS #SPOOL-UNIX-PATH P-FILE-NAME TO P-FILE-NAME LEAVING NO
#RECEIPT-FILE  := P-FILE-NAME
#RECEIPT-NODE  := #SPOOL-UNIX-NODE-NAME
* NOMALL-2294 BLI use 1-digit of task number for copying
#RECEIPT-STAMP := #P-TASK-NUMBER-STMP
CALLNAT 'RMRCSTMP' #RECEIPT-STAMP SEQUENTIAL-FILE-UNIX #RECEIPT-NODE
  #RECEIPT-FILE #TRACING 1X
IF #RECEIPT-STAMP NE #P-TASK-NUMBER-STMP /* cannot done by this task
  P-ERROR-CODE := 9997 /* skip
  ESCAPE ROUTINE
END-IF
END TRANSACTION                          /* BLI1
#P-FILE-NAME := P-FILE-NAME
READUX. REPEAT
  IF P-REP-FORMAT = 'B'
    P-BINARY := 'Y'
  ELSE
    P-BINARY := 'N'
  END-IF
  P-FILE-NAME  := #P-FILE-NAME
  #UX-FUNCTION := 'READ'
  PERFORM UNIX-FUNCTION
*
  IF P-ERROR-CODE NE 0 OR #EOF
    ESCAPE BOTTOM (READUX.)
  END-IF
  IF #TRACING
    COMPRESS 'got binary flag' P-BINARY 'and rep-format'
      P-REP-FORMAT TO #TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
  END-IF
  IF P-BINARY NE 'Y' AND P-REP-FORMAT NE 'A'                                             /*
    #RECORD-2      := P-RECORD
    IF #INSERT-FORMFEED > 0
      #RECORD-CC   := '1'
    ELSE
      RESET #RECORD-CC
    END-IF
  ELSE
    #RECORD := P-RECORD
  END-IF
  EXAMINE #RECORD FOR FULL VALUE OF ' ' GIVING LENGTH #RECORD-LENGTH
  IF #RECORD-LENGTH < 1
    #RECORD-LENGTH := 1 /* handle blank line
  END-IF
*
  #NSMCOMP-LINE := #RECORD
  IF P-CC = '1' AND P-BINARY NE 'Y'
    ADD 1 TO #INSERT-FORMFEED
    IF #FIRST-RECORD AND #RECORD-2 = ' '
      RESET #FIRST-RECORD
      ESCAPE TOP /* no processing of this line, only formfeed.
    END-IF
  END-IF
  RESET #FIRST-RECORD
  ADD 1 TO #RECORD-NUMBER
  IF #RECORD-LENGTH > 251
    #NSMCOMP-INLENGTH := 251
    ADD 251 TO P-STAT-INBYTE
  ELSE
    #NSMCOMP-INLENGTH := #RECORD-LENGTH
    ADD #RECORD-LENGTH TO P-STAT-INBYTE
  END-IF
  IF #RECORD-CC = '1'
    SUBTRACT 1 FROM #INSERT-FORMFEED
    IF #INSERT-FORMFEED < 0
      RESET #INSERT-FORMFEED
    END-IF
  END-IF
  PERFORM #COMPR
  IF P-ERROR-CODE NE 0
    ESCAPE BOTTOM (READUX.)
  END-IF
END-REPEAT
IF P-ERROR-CODE EQ 0
  P-NUMBER-OF-LINES := #RECORD-NUMBER
  #UX-FUNCTION      := 'CLOSE'
  P-FILE-NAME       := #P-FILE-NAME
  PERFORM UNIX-FUNCTION
END-IF
#RECEIPT-STAMP := 'Q' /* query receipt stamp /* BLI1 start
CALLNAT 'RMRCSTMP' #RECEIPT-STAMP SEQUENTIAL-FILE-UNIX #RECEIPT-NODE
  #RECEIPT-FILE #TRACING 1X
IF #RECEIPT-STAMP EQ #P-TASK-NUMBER-STMP /* same task
  #RECEIPT-STAMP := 'U' /* unlock file for further processing
  CALLNAT 'RMRCSTMP' #RECEIPT-STAMP SEQUENTIAL-FILE-UNIX #RECEIPT-NODE
    #RECEIPT-FILE #TRACING 1X
  END TRANSACTION
END-IF                                       /* BLI1 end
*
END-SUBROUTINE /* READ-UNIX-RECORDS
*
************************************************************************
DEFINE SUBROUTINE READ-CMASPOOL-RECORDS
************************************************************************
CONTAINER.ST-LINE-START := 1
READLOOP. REPEAT
  RESET  #ESFR
  #ESFR-CBA := #CBA
  #ESFR-FNO := #FNO
  CALL 'ESFREAD' #ESF-READ-PARMS (*)
  #ESF-RC := RET ('ESFREAD')
  DECIDE FOR FIRST CONDITION
    WHEN #ESF-RC = H'0000' AND #ESFR-STA ='07' OR='09'
      IGNORE
    WHEN #ESF-RC > H'0000' OR #ESFR-STA NE '  '
      COMPRESS 'CASPOOL' '/' #CMASPOOL-DEST '/' #CMASPOOL-OWNNM
        TO P-ERROR-TEXT LEAVING NO
      PRINT NOTITLE NOHDR
        *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
        'Unable to process CA Spool' P-ERROR-TEXT /*SU8 (AL=70)
      COMPRESS 'Error during Read CA Spool RC=' #ESF-RC-I
        TO P-ERROR-TEXT LEAVING NO
      COMPRESS P-ERROR-TEXT 'STA=' TO P-ERROR-TEXT
      COMPRESS P-ERROR-TEXT #ESFR-STA TO P-ERROR-TEXT LEAVING NO
      P-ERROR-CODE := 0005
    WHEN ANY
      ESCAPE BOTTOM (READLOOP.)
    WHEN NONE
      IGNORE
  END-DECIDE
*
  #NSMCOMP-LINE := #ESFR-D90
  ADD 1 TO #RECORD-NUMBER
*
  ADD #ESFR-RCL TO P-STAT-INBYTE
  IF #ESFR-RCL > 251
    #NSMCOMP-INLENGTH := 251
  ELSE
    #NSMCOMP-INLENGTH := #ESFR-RCL
  END-IF
  PERFORM #COMPR
  IF P-ERROR-CODE NE 0
    ESCAPE BOTTOM (READLOOP.)
  END-IF
END-REPEAT
P-NUMBER-OF-LINES := #RECORD-NUMBER
*
END-SUBROUTINE /* READ-CMASPOOL-RECORDS
*
************************************************************************
DEFINE SUBROUTINE CLOSE-CMASPOOL-PRINTER
************************************************************************
RESET #ESFC
#ESFC-CBA := #CBA
#ESFC-FNO := #FNO
#ESFC-TYP := '4'                         /* permanent close
CALL 'ESFCLOS' #ESF-CLOSE-PARMS
#ESF-RC := RET ('ESFCLOS')
IF #ESF-RC > H'0000'
  COMPRESS 'CASPOOL' '/' #CMASPOOL-DEST '/' #CMASPOOL-OWNNM
    TO P-ERROR-TEXT LEAVING NO
  PRINT NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
    'Unable to process CA Spool' P-ERROR-TEXT /*SU8 (AL=70)
  COMPRESS 'Error during Close CA Spool RC=' #ESF-RC-I
    TO P-ERROR-TEXT LEAVING NO
  COMPRESS P-ERROR-TEXT 'STA=' TO P-ERROR-TEXT
  COMPRESS P-ERROR-TEXT #ESFR-STA TO P-ERROR-TEXT LEAVING NO
  P-ERROR-CODE := 0005
  ESCAPE ROUTINE
END-IF
*
END-SUBROUTINE /* CLOSE-CMASPOOL-PRINTER
*
************************************************************************
DEFINE SUBROUTINE WAIT-LOCKED
************************************************************************
XXHASH-PARMS.P-SHORT-NAME := #SPOOL-UNIX-FILE-NAME
PERFORM GET-LONG-NAME
COMPRESS #SPOOL-UNIX-PATH P-FILE-NAME
  TO P-FILE-NAME LEAVING NO
P-NODE-NAME := #SPOOL-UNIX-NODE-NAME
IF #TRACING
  COMPRESS 'WAIT-LOCKED for:' P-FILE-NAME '- from node:' P-NODE-NAME
    '- from short name:' #SPOOL-UNIX-FILE-NAME TO #TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
END-IF
IF P-TRACE > 0 AND P-ERC = 0
  CALLNAT 'XXLOCKED' XXUX---P P-TRACE
ELSE
  CALLNAT 'XXLOCKED' XXUX---P
END-IF
P-ERROR-CODE := P-ERC
P-ERROR-TEXT := P-ERT
IF #TRACING
  COMPRESS 'XXLOCKED shows result:' P-ERC P-ERT 'for' P-FILE-NAME
    TO #TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
END-IF
IF P-ERROR-CODE NE 0
  ESCAPE ROUTINE
END-IF
*
#GETATTR := P-RECORD
IF #TRACING
  COMPRESS 'FILE-LOCKED flag is' #FILE-LOCKED TO #TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
END-IF
IF #FILE-LOCKED = 'Y'
  #LOCK-FCT    := 'F' /* find the filename in table
  #LOCK-FN (1) := P-FILE-NAME
  INCLUDE XXTABLE2 '#LOCK-FCT'   '+LOCK-TBLE'
    '#LOCK-FN'     '+LOCK-IX'    '+LOCK-LASTIX'
    '+LOCK-TEMP1'  '+LOCK-TEMP2' '#LOCK-COLS'   '+LOCK-ERC'
  IF +LOCK-IX NE 0
    #LOCK-TRIES := VAL(#LOCK-FN(2))
  ELSE
    RESET #LOCK-TRIES
  END-IF
  ADD 1 TO #LOCK-TRIES
  IF #LOCK-TRIES < 15 /* try it 15 cycles with this file
    #LOCK-FN (2) := #LOCK-TRIES
    #LOCK-FCT    := 'A' /* Add / update the filename
    INCLUDE XXTABLE2 '#LOCK-FCT'   '+LOCK-TBLE'
      '#LOCK-FN'     '+LOCK-IX'    '+LOCK-LASTIX'
      '+LOCK-TEMP1'  '+LOCK-TEMP2' '#LOCK-COLS'   '+LOCK-ERC'
    P-ERROR-CODE := 9997 /* wait/postpone
  ELSE
    #LOCK-FCT    := 'D' /* Delete this filename
    INCLUDE XXTABLE2 '#LOCK-FCT'   '+LOCK-TBLE'
      '#LOCK-FN'     '+LOCK-IX'    '+LOCK-LASTIX'
      '+LOCK-TEMP1'  '+LOCK-TEMP2' '#LOCK-COLS'   '+LOCK-ERC'
    P-ERROR-CODE := 2068 /* file is in use
    P-ERROR-TEXT := P-FILE-NAME
  END-IF
ELSE
  #LOCK-FCT    := 'D' /* Delete this filename, can be processed.
  INCLUDE XXTABLE2 '#LOCK-FCT'   '+LOCK-TBLE'
    '#LOCK-FN'     '+LOCK-IX'    '+LOCK-LASTIX'
    '+LOCK-TEMP1'  '+LOCK-TEMP2' '#LOCK-COLS'   '+LOCK-ERC'
  RESET P-ERROR-CODE P-ERROR-TEXT
END-IF
*
END-SUBROUTINE /*WAIT-LOCKED
*
************************************************************************
DEFINE SUBROUTINE UNIX-FUNCTION
************************************************************************
XXUX---P.P-FUNCTION := #UX-FUNCTION
IF #UX-FUNCTION = 'DELXML'
  COMPRESS P-FILE-NAME '.nomxml' TO P-FILE-NAME LEAVING NO
  XXUX---P.P-FUNCTION := #UX-FUNCTION := 'DELETE'
END-IF
IF +TRACE-ORDER = 'Y' /* TRACE-ORDER found in jobcards
  IF #UX-FUNCTION = 'DELETE'
    COMPRESS *PROGRAM 'Going to delete' P-FILE-NAME TO #TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
  END-IF
END-IF
IF #TRACING
  COMPRESS 'Executing Unix fct' #UX-FUNCTION 'with user' P-USERID
    '- node' P-NODE-NAME '- file' P-FILE-NAME TO #TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
END-IF
CALLNAT 'XXUX---N' XXUX---P P-TRACE
IF +TRACE-ORDER = 'Y' /* TRACE-ORDER found in jobcards
  IF #UX-FUNCTION = 'DELETE'
    COMPRESS *PROGRAM 'DELETE returns:' P-ERC P-ERT TO #TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
  END-IF
END-IF
IF #TRACING
  COMPRESS ' Unix fct' #UX-FUNCTION 'returned rc' P-ERC
    'with text' P-ERT TO #TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
  END TRANSACTION
END-IF
P-ERROR-CODE := P-ERC
P-ERROR-TEXT := P-ERT
*
END-SUBROUTINE /* UNIX-FUNCTION
*
************************************************************************
DEFINE SUBROUTINE SET-SUSPEND
************************************************************************
IF #UX-ISN EQ 0
  FDUX2. FIND (1) UX-NODES WITH UX-NODE-NAME = #SPOOL-UNIX-NODE-NAME
    ACCEPT IF NOT(UX-NODE-SUSPEND ='D' OR='E' OR ='S')
    #SUSP-REMEMBER := UX-NODE-SUSPEND
    #UX-ISN         := *ISN(FDUX2.)
  END-FIND
END-IF
IF #SUSP-REMEMBER ='M' OR='L'
  ESCAPE ROUTINE
END-IF
IF #UX-ISN NE 0
  GETUX1. GET UX-NODES #UX-ISN
* user or pwd invalid
  RESET #TRACE-MSG                      /* BLI3 start
  IF P-ERROR-TEXT = SCAN('NPR3416')  OR=SCAN('NPR0009')
      OR P-ERROR-CODE = 1581
* pwd invalid / wrong NPR version
    UX-NODE-SUSPEND := 'E'
    IF UX-NODE-TIME-STORED NE 'E'
      UX-NODE-TIME-STORED := 'E'
      UX-NODE-SUSPENDED := *TIMX        /* set time
      RESET UX-NODE-SUSP-MAX-MSG
      COMPRESS '2069' UX-NODE-NAME TO #TRACE-MSG
    END-IF
  ELSE
    UX-NODE-SUSPEND := 'S'
    IF UX-NODE-TIME-STORED NE 'S'
      UX-NODE-TIME-STORED := 'S'
      UX-NODE-SUSPENDED := *TIMX        /* set time
      RESET UX-NODE-SUSP-MAX-MSG
      COMPRESS '2026' UX-NODE-NAME TO #TRACE-MSG
    ELSE
      IF UX-NODE-SUSP-MAX-MSG = ' ' AND
          UX-NODE-SUSP-TIME-INT > 0 AND                          /* BLI4
          *TIMX - UX-NODE-SUSPENDED > UX-NODE-SUSP-TIME-INT * 600 /*BLI6
        UX-NODE-SUSP-MAX-MSG := 'X'
        COMPRESS '2071' UX-NODE-NAME TO #TRACE-MSG
      END-IF
    END-IF
  END-IF
  UPDATE (GETUX1.)
  P-NODE-SUSPEND    := UX-NODE-SUSPEND
  IF #TRACE-MSG NE ' '
    PERFORM XXRLOG-WRITE-LOG 'W' #TRACE-MSG
  END-IF                                /* BLI3 end
  END TRANSACTION
END-IF
*
END-SUBROUTINE /* SET-SUSPEND
*
************************************************************************
DEFINE SUBROUTINE BACKOUT-COPY
************************************************************************
RESET P-RECORDS-STORED P-STAT-OUTREC P-STAT-OUTBYTE
  #COUNTER #ST-LINE-END
*
#ST-ID := P-ID
RDBACKOUT. READ CONTAINER BY ST-ID-LINE FROM #ST-ID-LINE
  IF ST-ID NE P-ID
    ESCAPE BOTTOM (RDBACKOUT.)
  END-IF
  DELETE
  ADD 1 TO #COUNTER
  IF #COUNTER > #COUNT
    END TRANSACTION
    RESET #COUNTER
  END-IF
END-READ
#SPOOL-ATTRIBUTES := P-SPOOL-ATTRIBUTES
IF #SPOOL-TYPE = SEQUENTIAL-FILE-UNIX           /* BLI1, BLI2 start
  #RECEIPT-STAMP := 'Q' /* query receipt stamp
  CALLNAT 'RMRCSTMP' #RECEIPT-STAMP #SPOOL-TYPE #RECEIPT-NODE
    #RECEIPT-FILE #TRACING 1X
  IF #RECEIPT-STAMP EQ #P-TASK-NUMBER-STMP /* same task
    #RECEIPT-STAMP := 'U'        /* reset receipt stamp to ' ' (Unlock)
    CALLNAT 'RMRCSTMP' #RECEIPT-STAMP #SPOOL-TYPE #RECEIPT-NODE
      #RECEIPT-FILE #TRACING 1X
  END-IF
END-IF
IF #SPOOL-TYPE = SEQUENTIAL-FILE-BS2
  #RECEIPT-STAMP := 'Q' /* query receipt stamp
  CALLNAT 'RMRCSTMP' #RECEIPT-STAMP #SPOOL-TYPE #RECEIPT-NODE
    #RECEIPT-FILE #TRACING #SPOOL-BS2-JOB-ID
  IF #RECEIPT-STAMP EQ #P-TASK-NUMBER-STMP /* same task
    #RECEIPT-STAMP := 'U'        /* reset receipt stamp to ' ' (Unlock)
    CALLNAT 'RMRCSTMP' #RECEIPT-STAMP #SPOOL-TYPE #RECEIPT-NODE
      #RECEIPT-FILE #TRACING #SPOOL-BS2-JOB-ID
  END-IF                                       /* BLI1, BLI2 end
END-IF
END TRANSACTION
*
END-SUBROUTINE /* BACKOUT-COPY
*
************************************************************************
DEFINE SUBROUTINE GET-LONG-NAME
************************************************************************
XXHASH-PARMS.P-FUNCTION := 'L' /*short -> long
PERFORM XXHASH XXHASH-PARMS
P-FILE-NAME := XXHASH-PARMS.P-LONG-NAME
*
END-SUBROUTINE /* GET-LONG-NAME
*
************************************************************************
DEFINE SUBROUTINE #COMPR
************************************************************************
  #NSMCOMP-INLENGTH-OLD := #NSMCOMP-INLENGTH  /*For compat
  IF #NSMCOMP-INLENGTH > P-RECORD-LENGTH
    P-RECORD-LENGTH := #NSMCOMP-INLENGTH
  END-IF
  PERFORM COMPRESS-INTO-BUFFER
*
END-SUBROUTINE /* #COMPR
************************************************************************
ON ERROR
************************************************************************
  PRINT (AD=L) *PROGRAM *DAT4I *TIME(AL=8) 'error:' *ERROR /*SU12
    '(' *ERROR-LINE ')' /*BLI8
  IF P-FILE-NAME = ' ' /*BLI8
    COMPRESS #P-FILE-NAME '(#)' TO P-FILE-NAME
  END-IF
  PRINT (AD=L) 'file:' P-FILE-NAME /*SU12
  BACKOUT TRANSACTION
  P-ERROR-CODE := 21
  CALLNAT 'C-NATERN' P-ERROR-TEXT 'W'
END-ERROR
*
END
