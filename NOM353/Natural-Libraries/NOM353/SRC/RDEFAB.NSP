* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RDEFAB - Modify active bundle definitions
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* mrs 93-06-30           cleanup
* jvd 97-10-09 p(163166) Replace Callnat 'OUTDATE' with 'IODATE-N'
*                        Y2C and use only one date routine for NOM
* jwo 97-10-14 p(163166) creation-date in long format
* wcd 00-04-01 CE 7267   New PFkey for additional printers in RPFK---L
*                        & VABUND-L changes
* fhi 00-08-14           QA01 var #BUNDLE/#FLUSH-REPORTS missing,
*                        could not be cataloged.
* xsisgg 00-08-21 CE7461 Extend Report and Bundle names
* sju 01-03-09 p(204915) suppress bundle printing
* xsetoba 02-08-13 (CE7553) Default Profile non-defined users
* xsetggr 02-10-08 (CE7553) save default user when non-defined user
*                           specified as coordinator-id
* xsetggr 03-07-28 p(240465) correct CE7553
* xsetggr 03-08-14 p(204583) change hard coded text to msg nr in log msg
* XSETHZ  2004-02-13 P(250183) Separator member 'NONE'/'KEIN'
* XSETHZ  2004-02-13 P(249974) Separator Pages Maintenance
* HH 040825 FORMATTING T CHANGED;                /* HH 040825
* xsetggr 2005-10-26 P(270950) ISN fields must be P10, not P8
* xsetggr 2009-09-01 P314431   allow only DISKUNIX&NATUNIX printers for
*                       Unix systems, UNIXLP printers only for mainframe
* fhi     2010-09-03 NOMALL-97 Extend message line
* xsetggr 2010-11-03 NOMALL-865 restow due to changes in EOMPHTYE
* fhi     2011-01-11 NOMALL-936 Member name into message 1079
* xsetggr 2012-05-17 NOMALL-1136 improve validation of printers
* xsetggr 2012-09-21 NOMALL-89 implement external security check subrout
* SU1     2014-07-01 NOMALL-1281 show last update user+date
* SU2     2014-07-01 NOMALL-1279 fill fields for Adabas Vista
* fhi     2015-06-30 NOMALL-1655 Leave copies field as entered
* fhi     2015-07-06 NOMALL-1655 Backout for online (this program)
* fhi     2015-07-07 NOMALL-1655 Leave copies field as entered
* SU3     2016-01-18 NOMALL-1802 do not update Adabas Vista fields
* SU4     2016-09-16 NOMALL-1915(NOM3.5) sep.member act. help->N-SEPMEM
* fhi     2016-11-15 NOMALL-1961 Use new task IDs
* NKEW1   2024-07-24 EF-4541     Decide what to show on map with func
* ----------------------------------------------------------------------
DEFINE DATA GLOBAL USING  NRM-GL
LOCAL USING RPFK---L
LOCAL USING MAXITIML
LOCAL USING VABUND-L
LOCAL USING SUPER-L
LOCAL USING RLOG-L
LOCAL USING EOMPHTYE
LOCAL USING CONST-L /* NKEW1 changed
LOCAL
1 PRINTERS VIEW OF NRM-PRINTERS
  2 P-PHYSICAL-NAME
1 PHYSICAL VIEW OF NRM-PHYSICAL-PRINTERS
  2 PH-PRINTER-TYPE
*
1 #FATHER-PROG             (A8) INIT <'RLISAB'>
1 CV-BUND                  (C)
1 CV-MAP                   (C) INIT < (AD=I CD=NE)>
1 CV-COPIES                (C) INIT < (AD=I CD=NE)> /* NOMALL-1655 in
1 L-HEADER                 (A78)
1 L-BUNDISN                (N10)
1 #BUNDLE                  (A25)
1 REDEFINE #BUNDLE
  2 #BUNDLE-8              (A8)
  2 #BUNDLE-R              (A17)
1 #REPORT                  (A25)
1 REDEFINE #REPORT
  2 #REPORT-17             (A17)
  2 #REPORT-R              (A8)
1 #FLUSH-REPORTS           (A25/10)
1 #DEFINED                 (L)
1 I                        (N3)
1 #PRINTER                 (A8)
1 #ALLOWED                 (L)
1 #EXIST                   (L)
1 #FUNC                    (A1)
1 #CREATED-TIME            (A5)
1 #CREATED-DATE            (A8)
1 #OPENT                   (T)
1 #OPENP                   (P12)
1 #FLUSH-UNTIL             (N4)
1 REDEFINE    #FLUSH-UNTIL
  2 #HH                    (N2)
  2 #II                    (N2)
1 #LANGUAGE                (I1)
1 #PANEL                   (I2)
1 #FORMATED-DATE           (A10)
1 REDEFINE #FORMATED-DATE
  2 #S-FORMATED-DATE       (A8)
1 #ERROR-CODE              (N4)
1 #ERROR-TEXT              (A250)
1 N                        (N2)
1 #CONFIRM                 (A1)
1 #MAP-NAME                (A8)
1 #REPORT-SCREEN           (A25)
1 #YES                     (L)
1 #AUTODEF                 (A1)
1 #DEF-USER                (L)
1 #ERROR                   (L)
1 #COORD-ID                (A8)
1 #CHK-USER                (L)
1 #B-SEPSTART              (A8)
1 #B-SEPEND                (A8)
1 #B-CONTROL-EXITMEM       (A8)
1 #B-CONTROL-EXITLIB       (A8)
1 #MEMBER-TYPE             (A8)
1 J                        (I2)
1 #PROG                    (A8)
1 #LAST-MOD                (A40)
1 #ACTIVE-HELP             (L)
1 #LIBRARY-ID              (A8)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
* NKEW1 <
#JOB_ADD_FIELD := F#SETVAR(<#_JOBCARDS(1:2),#_ADDITIONALPARA(1:2)>)
* NKEW1 >
RESET G-COMMIT G-LINECOM(*)
DEFINE WINDOW REP-NOT-EXIST SIZE 10*38 BASE 06/25 CONTROL SCREEN
* security check
#PROG := *PROGRAM
PERFORM XXSECURITY-CHECK #PROG G-C-BUNDLE #ALLOWED
INCLUDE C-NALLOW
*
#AUTODEF := F#MONITOR-USER-AUTODEF (<>)
#FUNC := G-C-FUNC
#AB-BUNDLE := G-C-BUNDLE
#AB-BUNDRNB := G-C-BUNDRNB
#BUNDLE := G-C-BUNDLE
*
MAIN-LOOP. REPEAT
  FIND-LOOP. FIND ACTIVE-BUNDLES WITH AB-BUNDLE-RNB  = #AB-BUNDLE-RNB
*
    IF NO RECORDS FOUND
      IF #FUNC = 'M' OR = 'D' OR = 'P'
        G-NATRP-ERC := 0408
        INCLUDE C-ESCAPE
      END-IF
    END-NOREC
*
    CALLNAT 'N-NONE' AB-SEPSTART AB-SEPEND /*SU4
    L-BUNDISN := *ISN
    #BUNDLE := AB-BUNDLE
    #FLUSH-REPORTS(*) := AB-FLUSH-REPORTS(*)
    IF ACTIVE-BUNDLES.AB-COORDINATOR-ID = ' '
      ACTIVE-BUNDLES.AB-COORDINATOR-ID := G-USERID
    END-IF
    #COORD-ID := ACTIVE-BUNDLES.AB-COORDINATOR-ID
    DECIDE ON EVERY VALUE OF #FUNC
      VALUE 'M'
        CALLNAT 'NARPSEC' G-USER-PROFILE 'MAB' #ALLOWED
        INCLUDE C-NALLOW
        GETREC. GET ACTIVE-BUNDLES L-BUNDISN
        CALLNAT 'N-NONE' AB-SEPSTART AB-SEPEND /*SU4
      VALUE 'M','D'
        #OPENT := AB-OPEN-TIME
        #OPENP := #OPENT
        #OPENP := -(#OPENP - #MAX-INV-TIME)
        #OPENT := #OPENP
        MOVE EDITED #OPENT (EM=HH':'II)  TO #CREATED-TIME
        MOVE EDITED #OPENT(EM=YYYYMMDD)  TO #CREATED-DATE
        CALLNAT 'IODATE-N' 'M' 'L' #CREATED-DATE #FORMATED-DATE
          G-DATE-FORMAT #ERROR-CODE #ERROR-TEXT
        CV-BUND := (AD=IP)
      VALUE 'D'
        CV-MAP := (AD=IP)
        CV-COPIES := (AD=IP)
      NONE VALUE
        IGNORE
    END-DECIDE
*
    G-C-OBJTYPE := 'BUNDLE'
*
    SCREEN-LOOP. REPEAT
*
      #BUNDLE := AB-BUNDLE
      IF NOT G-DISPLAY-LONG-NAMES
        #BUNDLE-R := H'FA'
      END-IF
      IF NOT (#PANEL = 2 OR = 3)
        IF G-DISPLAY-LONG-NAMES
          #PANEL := 4
          #MAP-NAME := 'RDEFABL&'
        ELSE #PANEL := 1
          #MAP-NAME := 'RDEFABM&'
        END-IF
      END-IF
      IF #LANGUAGE NE *LANGUAGE
        PERFORM INIT-PFKEYS
        #LANGUAGE := *LANGUAGE
        PERFORM SET-PFKEYS
      END-IF
*
      PERFORM FLIP-DISPLAY
      CALLNAT 'N-HEADER' L-HEADER G-DATE-FORMAT #MAP-NAME
      CALLNAT 'N-HEAD2' AB-LAST-UPDATE-USER AB-LAST-UPDATE
        #LAST-MOD G-DATE-FORMAT
      RESET G-MAP-MODIFIED
      DECIDE ON FIRST #PANEL
        VALUE 2
          IF #ACTIVE-HELP AND ACTIVE-BUNDLES.AB-SEPNO = 0
              AND NOT CV-COPIES MODIFIED
            ACTIVE-BUNDLES.AB-SEPNO := 1
          END-IF
          INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
            MARK *G-DIRECT-COMMAND USING MAP 'RDEFAB2&'
        VALUE 3
          INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
            MARK *G-DIRECT-COMMAND USING MAP 'RDEFAB3&'
        VALUE 1
          INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
            MARK *G-DIRECT-COMMAND USING MAP 'RDEFABM&'
        VALUE 4
          INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
            MARK *G-DIRECT-COMMAND USING MAP 'RDEFABL&'
        NONE VALUE IGNORE
      END-DECIDE
      RESET G-NATRP-ERC G-NATRP-ERT
*
      INCLUDE RPFKVA-C
      INCLUDE C-DIRECT
      INCLUDE RPFKED-C
*
      IF CV-MAP MODIFIED OR G-MAP-MODIFIED OR #DEF-USER OR #ERROR
          OR CV-COPIES MODIFIED
        RESET #ERROR
        IF #CHK-USER
          RESET #DEF-USER
        END-IF
        PERFORM VALIDATE-INPUT
        IF #DEF-USER
          G-NATRP-ERC := 0509
          ESCAPE TOP
        END-IF
        IF G-NATRP-ERC NE 0
          ESCAPE TOP
        END-IF
        IF G-DISPLAY-LONG-NAMES
          ACTIVE-BUNDLES.AB-FLUSH-REPORTS(*) := #FLUSH-REPORTS(*)
        ELSE
          FOR N=1 TO 10
            #REPORT := #FLUSH-REPORTS(N)
            RESET #REPORT-R
            ACTIVE-BUNDLES.AB-FLUSH-REPORTS(N) := #REPORT
            RESET #REPORT
          END-FOR
        END-IF
        ACTIVE-BUNDLES.AB-LAST-UPDATE-USER := G-USERID
        ACTIVE-BUNDLES.AB-LAST-UPDATE      := *TIMX
        UPDATE (GETREC.)
        G-NATRP-ERC := 32
        #COORD-ID := ACTIVE-BUNDLES.AB-COORDINATOR-ID
        LG-USERID := G-USERID
        LG-CODE := 'AB'
        COMPRESS G-C-BUNDLE '-' G-C-BUNDRNB TO LG-OBJECT-NAME LEAVING NO
        LG-BUNDLE := G-C-BUNDLE
        LG-BUNDRNB := G-C-BUNDRNB
        COMPRESS '2105' LG-OBJECT-NAME TO LG-MSG
        CALLNAT 'RLOG' PL-PARMS
        INCLUDE C-COMMIT
      END-IF
*
      INCLUDE REXDO--C
*
      DECIDE ON FIRST G-PF-FUNC
        VALUE ##PFK-BUNDLE-PRINT
          #PANEL := 2
          RESET  #LANGUAGE
        VALUE ##PFK-EXIT-SUBFUNC
          IF #PANEL = 3
            #PANEL := 2
          ELSE
            IF G-DISPLAY-LONG-NAMES
              #PANEL := 4
            ELSE
              #PANEL := 1
            END-IF
          END-IF
          RESET  #LANGUAGE
        VALUE ##PFK-ADDNAL-PRINTERS
          #PANEL := 3
          RESET  #LANGUAGE
        VALUE ##PFK-DISPLAY-LONG-NAMES
          IF G-DISPLAY-LONG-NAMES
            RESET G-DISPLAY-LONG-NAMES
          ELSE
            G-DISPLAY-LONG-NAMES := TRUE
          END-IF
          RESET  #LANGUAGE
        NONE VALUE
          IGNORE
      END-DECIDE
    END-REPEAT
  END-FIND
END-REPEAT
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE INIT-PFKEYS
************************************************************************
RESET G-PF
*
INCLUDE RPFSTD-C
INCLUDE RPFCOM-C
DECIDE ON FIRST #PANEL
  VALUE 1,4
    INCLUDE RPFBUP-C
  VALUE 2
    INCLUDE RPFEXT-C
    INCLUDE RPFESF-C
    INCLUDE RPFAPR-C
  VALUE 3
    INCLUDE RPFEXT-C
    INCLUDE RPFESF-C
  NONE VALUE
    IGNORE
END-DECIDE
CALLNAT 'RPFINI-N' G-PF G-PFB
*
END-SUBROUTINE /* INIT-PFKEYS
*
************************************************************************
DEFINE SUBROUTINE  VALIDATE-INPUT
************************************************************************
DECIDE ON FIRST #PANEL
  VALUE 1,4
    PERFORM VALIDATE-GENERAL-ATTRIBUTES
  VALUE 2
    PERFORM VALIDATE-PRINTERS
    PERFORM VALIDATE-PRINTING-ATTRIBUTES
  VALUE 3
    PERFORM VALIDATE-PRINTERS
  NONE VALUE
    IGNORE
END-DECIDE
*
END-SUBROUTINE /* VALIDATE-INPUT
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-PRINTING-ATTRIBUTES
************************************************************************
IF NOT (ACTIVE-BUNDLES.AB-PRINTER(*)  NE ' ')
  REINPUT *0421 MARK *ACTIVE-BUNDLES.AB-PRINTER(1)
END-IF
IF NOT (ACTIVE-BUNDLES.AB-HOLD = 'Y' OR = 'N' OR = ' ')
  REINPUT USING HELP MARK *ACTIVE-BUNDLES.AB-HOLD ALARM
END-IF
IF ACTIVE-BUNDLES.AB-HOLD = ' '
  ACTIVE-BUNDLES.AB-HOLD := 'N'
END-IF
IF ACTIVE-BUNDLES.AB-CONTROL-EXITMEM NE ' '
    AND ACTIVE-BUNDLES.AB-CONTROL-EXITLIB = ' '
  REINPUT *1080 MARK *ACTIVE-BUNDLES.AB-CONTROL-EXITLIB ALARM
END-IF
IF ACTIVE-BUNDLES.AB-CONTROL-EXITLIB NE ' '
    AND ACTIVE-BUNDLES.AB-CONTROL-EXITMEM = ' '
  RESET ACTIVE-BUNDLES.AB-CONTROL-EXITLIB
END-IF
CALLNAT 'N-SEPMEM' AB-SEPSTART #B-SEPSTART 'S' 'R' 1X #ACTIVE-HELP
  G-NATRP-ERC G-NATRP-ERT
IF G-NATRP-ERC NE 0
  ESCAPE ROUTINE
END-IF
CALLNAT 'N-SEPMEM' AB-SEPEND #B-SEPEND 'E' 'R' 1X #ACTIVE-HELP
  G-NATRP-ERC G-NATRP-ERT
IF G-NATRP-ERC NE 0
  ESCAPE ROUTINE
END-IF
IF AB-CONTROL-EXITMEM NE ' '
  IF AB-CONTROL-EXITMEM = SCAN '*' AND AB-CONTROL-EXITLIB = SCAN '*'
    CALLNAT 'RGETLIB' #LIBRARY-ID
    COMPRESS #LIBRARY-ID 'U' TO AB-CONTROL-EXITLIB LEAVING NO
  END-IF
  IF AB-CONTROL-EXITMEM NE #B-CONTROL-EXITMEM
      OR AB-CONTROL-EXITLIB NE #B-CONTROL-EXITLIB
    #MEMBER-TYPE:= 'BUNPRTCO'
    CALLNAT 'N-LISMEM' AB-CONTROL-EXITLIB AB-CONTROL-EXITMEM
      #MEMBER-TYPE G-NATRP-ERC G-NATRP-ERT
    #B-CONTROL-EXITLIB  := AB-CONTROL-EXITLIB
    #B-CONTROL-EXITMEM  := AB-CONTROL-EXITMEM
    IF G-NATRP-ERC = 1052
      G-NATRP-ERC := 1079
      G-NATRP-ERT := AB-CONTROL-EXITMEM /* NOMALL-936
      G-NATRP-ERT := AB-SEPSTART /* NOMALL-936
      ESCAPE ROUTINE
    END-IF
  END-IF
END-IF
*
END-SUBROUTINE /* VALIDATE-PRINTING-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-PRINTERS
************************************************************************
FOR I 1 TO 20
  IF NOT (ACTIVE-BUNDLES.AB-PRINTER(I) = ' ' OR = 'DUMMY')
    EXAMINE FULL ACTIVE-BUNDLES.AB-PRINTER(*) FOR FULL VALUE OF
      ACTIVE-BUNDLES.AB-PRINTER(I) GIVING NUMBER IN J
    IF J > 1
      REINPUT *0104 MARK *AB-PRINTER(I)
    END-IF
    #PRINTER := ACTIVE-BUNDLES.AB-PRINTER(I)
    CALLNAT 'RCHKPRT' ACTIVE-BUNDLES.AB-PRINTER(I) #DEFINED
    IF NOT #DEFINED
      REINPUT USING HELP MARK *ACTIVE-BUNDLES.AB-PRINTER(I) ALARM
    END-IF
* check printer type
    FIND PRINTERS WITH P-ID = ACTIVE-BUNDLES.AB-PRINTER(I)
      FIND PHYSICAL WITH PH-VTAMID = P-PHYSICAL-NAME
        IF *MACHINE-CLASS = 'MAINFRAME'
          IF PH-PRINTER-TYPE = ##PHYS-NATUNIX
            REINPUT *0130 MARK *AB-PRINTER(I)
          END-IF
        ELSE
          IF NOT(PH-PRINTER-TYPE = ##PHYS-DISKUNIX OR = ##PHYS-NATUNIX)
            REINPUT *0131 MARK *AB-PRINTER(I)
          END-IF
        END-IF
      END-FIND
    END-FIND
*
    IF ACTIVE-BUNDLES.AB-PRINTER-COPIES(I) = 0
      ACTIVE-BUNDLES.AB-PRINTER-COPIES(I) := 1
    END-IF
  END-IF
*
  IF ACTIVE-BUNDLES.AB-PRINTER-COPIES(I) > 0 AND
      ACTIVE-BUNDLES.AB-PRINTER(I) = ' '
    REINPUT *422 MARK *ACTIVE-BUNDLES.AB-PRINTER-COPIES(I) ALARM
  END-IF
END-FOR
*
END-SUBROUTINE /* VALIDATE-PRINTERS
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-GENERAL-ATTRIBUTES
************************************************************************
IF NOT #DEF-USER
  IF #COORD-ID NE ACTIVE-BUNDLES.AB-COORDINATOR-ID
    CALLNAT 'RCHKUS' ACTIVE-BUNDLES.AB-COORDINATOR-ID #EXIST
    IF NOT #EXIST
      IF #AUTODEF = 'P'
        #DEF-USER := TRUE
        RESET #YES
        CALLNAT 'Y-OR-N' ACTIVE-BUNDLES.AB-COORDINATOR-ID #YES
      END-IF
      IF #AUTODEF = 'Y' OR (#AUTODEF = 'P' AND #YES)
        RESET #CHK-USER
        #COORD-ID := ACTIVE-BUNDLES.AB-COORDINATOR-ID
        IF #AUTODEF = 'P' ESCAPE ROUTINE END-IF
        ESCAPE ROUTINE
      END-IF
      IF #AUTODEF = 'P' AND #YES = FALSE
        #CHK-USER := TRUE
        ESCAPE ROUTINE
      END-IF
      REINPUT *0002, ACTIVE-BUNDLES.AB-COORDINATOR-ID
        MARK *ACTIVE-BUNDLES.AB-COORDINATOR-ID ALARM
    END-IF
  END-IF
ELSE
  RESET #DEF-USER
END-IF
*
#FLUSH-UNTIL := ACTIVE-BUNDLES.AB-FLUSH-UNTIL
IF NOT(#HH = 0 THRU 48)
  REINPUT 'MUST BE 1 THRU 48' MARK *ACTIVE-BUNDLES.AB-FLUSH-UNTIL ALARM
END-IF
*
IF NOT (#II = 0 THRU 59)
  REINPUT 'MINUTES MUST BE 1 THRU 59'
    MARK *ACTIVE-BUNDLES.AB-FLUSH-UNTIL ALARM
END-IF
*
RESET N #REPORT
FOR N 1 TO 10
  IF #FLUSH-REPORTS(N) = ' '
    ESCAPE TOP
  END-IF
  IF G-DISPLAY-LONG-NAMES
    CALLNAT 'RCHKRP' #FLUSH-REPORTS(N) #EXIST
  ELSE
    #REPORT := #FLUSH-REPORTS(N)
    RESET #REPORT-R
    CALLNAT 'RCHKRP' #REPORT #EXIST
  END-IF
*
  IF NOT #EXIST
    IF G-DISPLAY-LONG-NAMES
      #REPORT-SCREEN := #FLUSH-REPORTS(N)
    ELSE
      MOVE ALL H'FA' TO #REPORT-R
      #REPORT-SCREEN := #REPORT
    END-IF
    RESET #CONFIRM
    INPUT WINDOW = 'REP-NOT-EXIST' USING MAP 'RDEFBUA&'
    IF NOT #CONFIRM = 'Y' OR = 'N'
      REINPUT *1099
    END-IF
    IF NOT #CONFIRM = 'Y'
      RESET #FLUSH-REPORTS(N)
    END-IF
  END-IF
*
END-FOR
*
END-SUBROUTINE /* VALIDATE-GENERAL-ATTRIBUTES
* set pfkeys
INCLUDE RPFSET-C
*
END
