* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* --------------------------------------------------------------------
* Subprogram  NONSCHK-N
* Version     3.5.0
*
*             Copy of NSCCHK-N of EOR
*
* Function    Check for 'NSC active'
*
*
* ---------------------------------------------------------------------
* Modifications:
* CF     2017-03-20  NOMALL-2089  Created (basing on NSCCHK-N of EOR)
*
* ---------------------------------------------------------------------
*
DEFINE DATA
PARAMETER
1 P-NSC-ACTIVE      (L)     /* out
*
LOCAL
* -- for 'NAT00040'
1 #P00040           (A32)
1 REDEFINE #P00040
  2 #P00-NSC        (B01)
  2 #P00-F1         (A07)
  2 #P00-NAT-SM     (A04)
1 #CMUB-P00         (B01) CONST <00>
1 #RC4              (N04)
END-DEFINE
* --------------------------------------------------------------------
RESET P-NSC-ACTIVE             /* assume NSC not active
CALLNAT 'NAT00040' #CMUB-P00 #P00040 #RC4
IF NOT (#P00-NSC = H'00' OR = H'40')
  P-NSC-ACTIVE := TRUE
END-IF
*
* ================================================ end main ==========
*
END
