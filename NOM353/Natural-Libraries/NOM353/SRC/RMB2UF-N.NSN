* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RMB2UF-N - Unlock file with MOD-PRINT-JOB-ATTR command
*
* Maintenance
* uuu     yyyy-mm-dd s(999999) ...
* gw      1996-01-08 s(999999) created
* xsetggr 2007-05-02 NOM3201   support 5 byte node numbers
* fhi     2010-09-03 NOMALL-97 Extend message line
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 RMB2UF-NODE                (N5)
1 RMB2UF-JOB-ID              (A5)
1 RMB2UF-ERC                 (N4)
1 RMB2UF-ERT                 (A250)
************************************************************************
LOCAL
1 SYSTEM-COMMAND VIEW OF SYSTEM-COMMAND
  2 ERROR-CODE
  2 ERROR-TEXT
  2 REDEFINE ERROR-TEXT
    3 ERROR-PREFIX       (A7)
    3 ERROR-FIL          (A1)
    3 ERROR-TXT          (A49)
  2 SYSTEM-MESSAGE-CODE
1 #COMMAND                   (A80)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET RMB2UF-ERC RMB2UF-ERT
*
COMPRESS '/MOD-PRINT-JOB-ATTR JOB-IDENT=*TSN(' RMB2UF-JOB-ID
  '),LOCK-FILE=*NO' TO #COMMAND LEAVING NO
*
CAN. FIND (1) SYSTEM-COMMAND WITH NODE =RMB2UF-NODE AND COMMAND=#COMMAND
  IF ERROR-CODE NE 0
    RMB2UF-ERC := 1553
    IF SYSTEM-MESSAGE-CODE = ' '
      RMB2UF-ERT := SYSTEM-COMMAND.ERROR-PREFIX
    ELSE
      COMPRESS SYSTEM-COMMAND.ERROR-PREFIX '/'
        SYSTEM-COMMAND.SYSTEM-MESSAGE-CODE TO RMB2UF-ERT LEAVING NO
    END-IF
    ESCAPE BOTTOM (CAN.)
  END-IF
END-FIND
*
END
