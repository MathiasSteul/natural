* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    NOMUSL1N
* Function  User List API
* Version   3.2.1
*
* Maintenance:
* uuu     yyyy-mm-dd s(999999) ....
* xsetggr 2008-08-07 p(300323) created
* xsetggr 2008-12-05 P(300323) change adding of steplibs
* xsetggr 2009-02-10 P300323   delete steplib handling
* fhi     2009-02-27 P300323 Rename RGETSTEP to NOMGSTEP delivered in SYSTEM
* fhi     2010-09-21 NOMALL-97 Use no more C-NATERR but C-NATERN instead
* 2012-01-19 NOMALL-1096 NOMUSL-P (ERROR-TEXT(A250) STOW ONLY
* SU1     2014-11-12 NOMALL-1527 getting rid of coding for old versions-
*                                only restruct
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER USING NOMUSL-P
*
LOCAL USING SATFNC3E
LOCAL USING SATLF02P
LOCAL USING VUSER--L
*
LOCAL
1 #VALUE-F           (A25)
1 #USER-S            (A25)
1 #VALUE-T           (A25)
1 #USER-F            (A8)
1 #USER-T            (A8)
1 #LFILE-CHANGED     (L)
1 #NOM-DBID          (N5)
1 #NOM-FNR           (N5)
1 #MAX-ENTRIES       (N2) CONST <15>
1 #LEN               (N3)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET NOMUSL-ERROR-CODE NOMUSL-ERROR-TEXT NOMUSL-NUM-ENTRIES
*
DECIDE FOR EVERY CONDITION
  WHEN NOMUSL-NOM-FNR NE 0 AND NOMUSL-NOM-DBID NE 0
    PERFORM GET-NOM-LFILE
    PERFORM SET-NOM-LFILE
    #LFILE-CHANGED := TRUE
  WHEN NOMUSL-ERROR-CODE = 0
    PERFORM SELECT-USER
  WHEN #LFILE-CHANGED
    PERFORM SET-OLD-NOM-LFILE
  WHEN NONE IGNORE
END-DECIDE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE GET-NOM-LFILE
************************************************************************
SATLF-LFILE    := 206
SATLF-FUNCTION := 'GET'
CALLNAT SAT-GET-SET-LFILE SATLF-SATVERS SATLF-PARMS (*)
#NOM-DBID := SATLF-DBID-N5
#NOM-FNR  := SATLF-FNR-N5
*
END-SUBROUTINE /* GET-NOM-LFILE
*
************************************************************************
DEFINE SUBROUTINE SET-LFILE
************************************************************************
SATLF-LFILE    := 206
SATLF-FUNCTION := 'SET'
CALLNAT SAT-GET-SET-LFILE SATLF-SATVERS SATLF-PARMS (*)
*
END-SUBROUTINE /* SET-LFILE
*
************************************************************************
DEFINE SUBROUTINE SET-NOM-LFILE
************************************************************************
SATLF-DBID-N5 := NOMUSL-NOM-DBID
SATLF-FNR-N5  := NOMUSL-NOM-FNR
PERFORM SET-LFILE
*
END-SUBROUTINE /* SET-NOM-LFILE
*
************************************************************************
DEFINE SUBROUTINE SET-OLD-NOM-LFILE
************************************************************************
SATLF-DBID-N5 := #NOM-DBID
SATLF-FNR-N5  := #NOM-FNR
PERFORM SET-LFILE
*
END-SUBROUTINE /* SET-OLD-NOM-LFILE
*
************************************************************************
DEFINE SUBROUTINE SELECT-USER
************************************************************************
PERFORM INIT-SELECTION-KEYS
RESET NOMUSL-NUM-ENTRIES NOMUSL-USER-TAB (*)
  NOMUSL-USERID-NEXT
*
REA. READ USERS BY USER-ID = #USER-F  ENDING AT #USER-T
  NOMUSL-NUM-ENTRIES := NOMUSL-NUM-ENTRIES + 1
  IF NOMUSL-NUM-ENTRIES > #MAX-ENTRIES
    NOMUSL-USERID-NEXT   := USER-ID
    NOMUSL-NUM-ENTRIES := #MAX-ENTRIES
    ESCAPE BOTTOM (REA.)
  END-IF
*
  NOMUSL-USERID (NOMUSL-NUM-ENTRIES)    := USER-ID
  NOMUSL-USER-TYPE  (NOMUSL-NUM-ENTRIES):= PROF-TYPE
  COMPRESS FIRST-NAME ',' LAST-NAME TO
    NOMUSL-USER-NAME (NOMUSL-NUM-ENTRIES) LEAVING NO
*
END-READ
*
END-SUBROUTINE /* SELECT-USER
*
************************************************************************
DEFINE SUBROUTINE INIT-SELECTION-KEYS
************************************************************************
IF NOMUSL-USER-SELECTION = SCAN '*'
  #USER-S := NOMUSL-USER-SELECTION
ELSE
  COMPRESS NOMUSL-USER-SELECTION '*' TO #USER-S LEAVING NO
END-IF
#LEN := 8
CALLNAT 'SELALPHA' #USER-S #VALUE-F #VALUE-T #LEN
#USER-F := SUBSTR (#VALUE-F,1,8)
#USER-T := SUBSTR (#VALUE-T,1,8)
*
IF NOMUSL-USERID-NEXT NE ' '
  #USER-F := NOMUSL-USERID-NEXT
END-IF
*
END-SUBROUTINE /* INIT-SELECTION-KEYS
*
************************************************************************
ON ERROR
************************************************************************
  IF #LFILE-CHANGED
    PERFORM SET-OLD-NOM-LFILE
  END-IF
  IF *ERROR-NR = 82
    WRITE *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II':'SS'.'T)
      'Missing NOM steplibs' //
      'Please call NOM steplib routine NOMGSTEP before call of NOM API.'
  END-IF
  NOMUSL-ERROR-CODE := 21
  CALLNAT 'C-NATERN' NOMUSL-ERROR-TEXT
  ESCAPE ROUTINE
END-ERROR
*
END
