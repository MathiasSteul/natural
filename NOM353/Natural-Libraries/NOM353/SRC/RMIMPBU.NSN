    VALUE 'B-PRINT-JOBCARD'
      BU-FILL.B-PRINT-JOBCARD (#IND) := #VALUE-CURRENT
    VALUE 'B-FLUSH-TIME'
      MOVE EDITED #VALUE-CURRENT TO BU-FILL.B-FLUSH-TIME
        (EM=YYYY'-'MM'-'DD'-'HH':'II':'SS'.'T)
    VALUE 'B-FLUSH-REPORTS'
      BU-FILL.B-FLUSH-REPORTS (#IND) := #VALUE-CURRENT
    VALUE 'B-LAST-MODIFIED'
