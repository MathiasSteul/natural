    NONE IGNORE
  END-DECIDE
ELSE
  #OBJ-NAME := BU-FILL.B-BUNDLE
  OBJ. FIND (1) BU WITH B-BUNDLE = BU-FILL.B-BUNDLE /*SU4 was #KEY
    IF NO RECORDS FOUND
      MOVE BY NAME BU-FILL TO BU
      STORE BU
      PERFORM ADD-LOADED
      ESCAPE BOTTOM (OBJ.)
    END-NOREC
    MOVE BY NAME BU-FILL TO BU
    IF #REPL = 'Y'
      PERFORM ADD-REPLACED
      UPDATE (OBJ.)
    ELSE
      COMPRESS BU-FILL.B-BUNDLE 'not replaced for BU' TO #MSG /*SU4:#KEY
      PERFORM XXRLOG-WRITE-LOG 'W' #MSG
      PERFORM ADD-NOT-REPLACED
    END-IF
  END-FIND
  END TRANSACTION
