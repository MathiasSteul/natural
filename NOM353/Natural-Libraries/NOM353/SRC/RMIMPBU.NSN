IF *OCC(B64-TEXT-ARRAY) = 0
  EXPAND ARRAY B64-TEXT-ARRAY TO (1:5)
END-IF
IF NOT #SAVE
  IF #TAG-CURRENT = #TAG-OLD
    ADD 1 TO #IND
  ELSE
    #IND := 1
  END-IF
  IF #VALUE-CURRENT = ' '
    ESCAPE MODULE
  END-IF
  DECIDE ON FIRST VALUE OF #TAG-CURRENT
    VALUE 'B-OBJECT-TYPE'
      BU-FILL.B-OBJECT-TYPE := #VALUE-CURRENT
    VALUE 'B-OBJECT-TIME'
      MOVE EDITED #VALUE-CURRENT TO BU-FILL.B-OBJECT-TIME
        (EM=YYYY'-'MM'-'DD'-'HH':'II':'SS'.'T)
    VALUE 'B-BUNDLE'
      BU-FILL.B-BUNDLE := #VALUE-CURRENT
    VALUE 'B-MASTER-REPNAME'
      BU-FILL.B-MASTER-REPNAME := #VALUE-CURRENT
    VALUE 'B-BUNDRNB'
      IF #VALUE-CURRENT IS (P11)
        BU-FILL.B-BUNDRNB := VAL (#VALUE-CURRENT)
      ELSE
        #MSG := 'B-BUNDRNB'
        PERFORM FIELD-IGNORED /*RMIMP-C1
      END-IF
    VALUE 'B-USERID'
      BU-FILL.B-USERID := #VALUE-CURRENT
    VALUE 'B-DESC'
      BU-FILL.B-DESC := #VALUE-CURRENT
    VALUE 'B-COORDINATOR-ID'
