DEFINE SUBROUTINE BUILD-RETAIN-KEYWORDS /*SU7 changed
************************************************************************
IF RETAIN-KEYWORDS
  ESCAPE ROUTINE
END-IF
RELEASE SET 'TSERRP03'
#FIRST := TRUE
FOR #I2=1 TO 4
  IF #S-KEYWORDS (#I2) =' ' OR='*'
    ESCAPE TOP
  END-IF
  IF #FIRST
    RESET #FIRST
    KW0. FIND NUMBER RP WITH R-KEYWORDS =#F-KY(#I2) THRU #T-KY(#I2)
      RETAIN AS 'TSERRP03'
    #N-KEYWORDS := *NUMBER (KW0.)
    ESCAPE TOP
  END-IF
  IF #S-AND
    KWA. FIND NUMBER RP WITH 'TSERRP03' AND R-KEYWORDS =#F-KY(#I2)
    THRU #T-KY(#I2) RETAIN AS 'TSERRP03'                              /*
    #N-KEYWORDS := *NUMBER (KWA.)
  ELSE /* OR
    KWO. FIND NUMBER RP WITH 'TSERRP03' OR  R-KEYWORDS =#F-KY(#I2)
    THRU #T-KY(#I2) RETAIN AS 'TSERRP03'                              /*
    #N-KEYWORDS := *NUMBER (KWO.)
  END-IF
END-FOR
RETAIN-KEYWORDS := TRUE
*
END-SUBROUTINE /* BUILD-RETAIN-KEYWORDS
*
************************************************************************
DEFINE SUBROUTINE RELEASE-RETAIN-KEYWORDS
************************************************************************
IF RETAIN-KEYWORDS
  RELEASE SET 'TSERRP03'
  RESET #N-KEYWORDS RETAIN-KEYWORDS
END-IF
*
END-SUBROUTINE /* RELEASE-RETAIN-KEYWORDS
*
************************************************************************
