DEFINE SUBROUTINE BUILD-RETAIN-UNIX-FILE
************************************************************************
IF RETAIN-UNIX-FILE
  ESCAPE ROUTINE
END-IF
RETAIN-UNIX-FILE := TRUE /*SU3 moved outside FIND
* No index is build for unix Files ->
* find all unix nodes (node must be specified) and check files:
EXAMINE #S-UNIX-FILE FOR ' ' GIVING LENGTH #I-LEN
#F-IDENT-LONG-TYPE := #T-IDENT-LONG-TYPE := REPORT-IDENT-UNIX-NODENAME
RESET #F-IDENT-LONG-VALUE #N-UNIX-FILE
MOVE ALL H'FF' TO #T-IDENT-LONG-VALUE
FNDUXFI. FIND REPORT1 WITH R-IDENT = #F-IDENT-LONG THRU #T-IDENT-LONG
  FOR #I1 = 1 TO C*R-IDENT-FILES
    IF #S-SUBSTR
      IF R-IDENT-FILES (#I1) NE SCAN #S-UNIX-FILE /*SU5 _A26
        ESCAPE TOP
      END-IF
    ELSE /*prefix
      IF SUBSTR(R-IDENT-FILES(#I1),1,#I-LEN)
      NE SUBSTR(#S-UNIX-FILE,1,#I-LEN)                                /*
        ESCAPE TOP
      END-IF
**DISPLAY R-REPNAME #FIELD(AL=40)
    END-IF
    IF #N-UNIX-FILE = 0
      FNDUXFI1. FIND NUMBER RP WITH R-REPNAME = R-REPNAME(FNDUXFI.)
      RETAIN AS 'TSERRP18'                                            /*
      #N-UNIX-FILE := *NUMBER (FNDUXFI1.)
    ELSE
      FNDUXFI2. FIND NUMBER RP WITH 'TSERRP18'
      OR R-REPNAME = R-REPNAME(FNDUXFI.) RETAIN AS 'TSERRP18'         /*
      #N-UNIX-FILE := *NUMBER (FNDUXFI2.)
    END-IF
    ESCAPE BOTTOM
  END-FOR
END-FIND
*
END-SUBROUTINE /* BUILD-RETAIN-UNIX-FILE
*
************************************************************************
DEFINE SUBROUTINE RELEASE-RETAIN-UNIX-FILE
************************************************************************
IF RETAIN-UNIX-FILE
  RELEASE SET 'TSERRP18'
  RESET #N-UNIX-FILE RETAIN-UNIX-FILE
END-IF
*
END-SUBROUTINE /* RELEASE-RETAIN-UNIX-FILE
*
************************************************************************
DEFINE SUBROUTINE PF-KEYS
************************************************************************
SET KEY PF2 = PGM PF3 = PGM PF4 = PGM PF5 = PGM PF6 = PGM
  PF7 = PGM PF8 = PGM PF9 = PGM PF10 = PGM PF11 = PGM PF12 = PGM
SET KEY PF01=HELP /*SU7
SET KEY PF13=HELP /*SU7
*
END-SUBROUTINE /* PF-KEYS
*
************************************************************************
DEFINE SUBROUTINE CHECK-ACTIVE-HELP /*SU7
************************************************************************
IF #S-UNIX-NODE = MASK('*')
  CALLNAT 'HRSELUXN' 'U' #S-UNIX-NODE_A16
END-IF
FOR #I = 1 *OCC(#S-KEYWORDS)
  IF #S-KEYWORDS (#I) = MASK('*')
    REINPUT FULL USING HELP MARK *#S-KEYWORDS (#I)
  END-IF
END-FOR
*
END-SUBROUTINE /* CHECK-ACTIVE-HELP
*
END
