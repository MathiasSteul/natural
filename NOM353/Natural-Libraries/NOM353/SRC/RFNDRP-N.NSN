*
************************************************************************
* Main line
************************************************************************
*
RESET #P-NUMBER #P-ERC #P-ERT
IF +NOM-RFNDRP-N = ' ' /*init
  RESET #S-SUBSTR #S-AND /*OR SU7
END-IF
*
IF #LANG NE 2
  #LANG := 1
END-IF
DEFINE WINDOW #FIND SIZE 24*79 BASE 1/1 TITLE #TITLE (#LANG) FRAMED ON
PERFORM PF-KEYS
*
#REP. REPEAT
  IF #DISPLAY-LONG-NAMES
    #D-REPNAME-25 := #S-REPNAME
    #D-REPNAME-A2 := H'FA'
    #D-REPNAME-T2 := '(*)'
    #D-MASTER-25 := #S-MASTER
    #D-MASTER-A2 := H'FA'
    #D-MASTER-T2 := '(*)'
  ELSE
    #D-REPNAME-17 := #S-REPNAME
    #D-REPNAME-A1 := H'FA'
    #D-REPNAME-T1 := '(*)'
    MOVE ALL H'FB' TO #D-REPNAME-T11
    #D-MASTER-17 := #S-MASTER
    #D-MASTER-A1 := H'FA'
    #D-MASTER-T1 := '(*)'
    MOVE ALL H'FB' TO #D-MASTER-T11
  END-IF
  SET CONTROL 'MT'
  INPUT WINDOW='#FIND' WITH TEXT *#P-ERC,#P-ERT USING MAP 'RFNDRP-&'
  RESET #P-ERC #P-ERT
  IF #DISPLAY-LONG-NAMES
    #S-REPNAME := #D-REPNAME-25
    #S-MASTER  := #D-MASTER-25
  ELSE
    #S-REPNAME := #D-REPNAME-17
    #S-MASTER  := #D-MASTER-17
  END-IF
  DECIDE ON FIRST VALUE OF *PF-KEY
    VALUE 'PF3'
      RELEASE SET #P-SET-NAME
      PERFORM RELEASE-RETAIN-SETS
      ESCAPE BOTTOM
    VALUE 'ENTR'
      PERFORM CHECK-ACTIVE-HELP
      PERFORM SEARCH-CRITERIA
      IF MODIFIED
        PERFORM SEARCH-REPORT
      ELSE
        IF #N-TOTAL > 0 AND #N-TOTAL LE #P-MAX-FIND
          #P-NUMBER := #N-TOTAL
          PERFORM RELEASE-RETAIN-SETS
          ESCAPE BOTTOM
        END-IF
      END-IF
      IF #N-TOTAL > #P-MAX-FIND
        #P-ERC := 5
        COMPRESS 'Number of Records >' #P-MAX-FIND TO #P-ERT
      END-IF
    NONE IGNORE
  END-DECIDE
END-REPEAT /*(#REP.)
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE RELEASE-RETAIN-SETS
************************************************************************
PERFORM RELEASE-RETAIN-REPNAME
PERFORM RELEASE-RETAIN-MASTER
PERFORM RELEASE-RETAIN-KEYWORDS
PERFORM RELEASE-RETAIN-JES-JOB-NAME
PERFORM RELEASE-RETAIN-JES-WRITER
PERFORM RELEASE-RETAIN-DIST
PERFORM RELEASE-RETAIN-PRINTER
PERFORM RELEASE-RETAIN-JES-DESTINATION
PERFORM RELEASE-RETAIN-JES-FORM
/*SU8 PERFORM RELEASE-RETAIN-PWR-DESTINATION
/*SU8 PERFORM RELEASE-RETAIN-PWR-JOB-NAME
/*SU8 PERFORM RELEASE-RETAIN-PWR-FORM
PERFORM RELEASE-RETAIN-BS2-JOB-NAME
PERFORM RELEASE-RETAIN-BS2-USER-ID
PERFORM RELEASE-RETAIN-BS2-FORM
PERFORM RELEASE-RETAIN-UNIX-NODE
PERFORM RELEASE-RETAIN-UNIX-PATH
*
END-SUBROUTINE /* RELEASE-RETAIN-SETS
*
************************************************************************
DEFINE SUBROUTINE SEARCH-CRITERIA
************************************************************************
DECIDE FOR EVERY CONDITION
  WHEN #S-REPNAME NE #O-REPNAME
    #O-REPNAME := #S-REPNAME
    IF #S-REPNAME = ' ' OR = '*'
      SEARCH-REPNAME := FALSE
    ELSE
      SEARCH-REPNAME := TRUE
      RETAIN-REPNAME := FALSE
    END-IF
    IF #DISPLAY-LONG-NAMES
      #LENGTH := 25
    ELSE
      #LENGTH := 17
    END-IF
    CALLNAT 'SELALPHA' #S-REPNAME #F-REPNAME #T-REPNAME #LENGTH
  WHEN #S-MASTER  NE #O-MASTER
    #O-MASTER := #S-MASTER
    IF #S-MASTER = ' ' OR = '*'
      SEARCH-MASTER := FALSE
    ELSE
      SEARCH-MASTER := TRUE
      RETAIN-MASTER := FALSE
    END-IF
    IF #DISPLAY-LONG-NAMES
      #LENGTH := 25
    ELSE
      #LENGTH := 17
    END-IF
    CALLNAT 'SELALPHA' #S-MASTER #F-MASTER #T-MASTER #LENGTH
  WHEN #S-KEYWORDS (1) NE #O-KEYWORDS (1) OR #S-AND NE #O-AND
  OR   #S-KEYWORDS (2) NE #O-KEYWORDS (2)                             /*
  OR   #S-KEYWORDS (3) NE #O-KEYWORDS (3)                             /*
  OR   #S-KEYWORDS (4) NE #O-KEYWORDS (4)                             /*
    #O-KEYWORDS (*) := #S-KEYWORDS (*)
    #O-AND          := #S-AND
    IF (#S-KEYWORDS (*) NE ' ')
      SEARCH-KEYWORDS := TRUE
      RETAIN-KEYWORDS := FALSE
    ELSE
      SEARCH-KEYWORDS := FALSE
    END-IF
    FOR #I2=1 TO 4
      CALLNAT 'SELALPHA' #S-KEYWORDS (#I2) #F-KY (#I2) #T-KY (#I2) /*SU7
        #L-15
    END-FOR
  WHEN #S-JES-JOB-NAME NE #O-JES-JOB-NAME
    #O-JES-JOB-NAME := #S-JES-JOB-NAME
    IF #S-JES-JOB-NAME = ' ' OR = '*'
      SEARCH-JES-JOB-NAME := FALSE
    ELSE
      SEARCH-JES-JOB-NAME := TRUE
      RETAIN-JES-JOB-NAME := FALSE
    END-IF
    CALLNAT 'SELALPHA' #S-JES-JOB-NAME #F-JES-JOB-NAME #T-JES-JOB-NAME
      #LENGTH
  WHEN #S-JES-WRITER  NE #O-JES-WRITER
    #O-JES-WRITER := #S-JES-WRITER
    IF #S-JES-WRITER = ' ' OR = '*'
      SEARCH-JES-WRITER := FALSE
    ELSE
      SEARCH-JES-WRITER := TRUE
      RETAIN-JES-WRITER := FALSE
    END-IF
    CALLNAT 'SELALPHA' #S-JES-WRITER #F-JES-WRITER #T-JES-WRITER #LENGTH
  WHEN #S-JES-DESTINATION NE #O-JES-DESTINATION
    #O-JES-DESTINATION := #S-JES-DESTINATION
    IF #S-JES-DESTINATION = ' ' OR = '*'
      SEARCH-JES-DESTINATION := FALSE
    ELSE
      SEARCH-JES-DESTINATION := TRUE
      RETAIN-JES-DESTINATION := FALSE
    END-IF
    CALLNAT 'SELALPHA' #S-JES-DESTINATION #F-JES-DESTINATION
      #T-JES-DESTINATION #LENGTH
  WHEN #S-JES-FORM NE #O-JES-FORM
    #O-JES-FORM := #S-JES-FORM
    IF #S-JES-FORM = ' ' OR = '*'
      SEARCH-JES-FORM := FALSE
    ELSE
      SEARCH-JES-FORM := TRUE
      RETAIN-JES-FORM := FALSE
    END-IF
    CALLNAT 'SELALPHA' #S-JES-FORM #F-JES-FORM #T-JES-FORM #LENGTH
  WHEN #S-DIST  NE #O-DIST
    #O-DIST         := #S-DIST
    IF #S-DIST = ' ' OR = '*'
      SEARCH-DIST := FALSE
    ELSE
      SEARCH-DIST := TRUE
      RETAIN-DIST := FALSE
    END-IF
    CALLNAT 'SELALPHA' #S-DIST #F-DIST #T-DIST #LENGTH
  WHEN #S-PRINTER NE #O-PRINTER
    #O-PRINTER := #S-PRINTER
    IF #S-PRINTER = ' ' OR = '*'
      SEARCH-PRINTER := FALSE
    ELSE
      SEARCH-PRINTER := TRUE
      RETAIN-PRINTER := FALSE
    END-IF
    CALLNAT 'SELALPHA' #S-PRINTER #F-PRINTER #T-PRINTER #LENGTH
    #F-COPIES := ' '
    #T-COPIES := '999'
/*SU8  WHEN #S-PWR-DESTINATION NE #O-PWR-DESTINATION
/*SU8  WHEN #S-PWR-JOB-NAME NE #O-PWR-JOB-NAME
/*SU8  WHEN #S-PWR-FORM NE #O-PWR-FORM
  WHEN #S-BS2-JOB-NAME NE #O-BS2-JOB-NAME
    #O-BS2-JOB-NAME := #S-BS2-JOB-NAME
    IF #S-BS2-JOB-NAME = ' ' OR = '*'
      SEARCH-BS2-JOB-NAME := FALSE
    ELSE
      SEARCH-BS2-JOB-NAME := TRUE
      RETAIN-BS2-JOB-NAME := FALSE
    END-IF
    CALLNAT 'SELALPHA' #S-BS2-JOB-NAME #F-BS2-JOB-NAME #T-BS2-JOB-NAME
      #LENGTH
  WHEN #S-BS2-USER-ID NE #O-BS2-USER-ID
    #O-BS2-USER-ID := #S-BS2-USER-ID
    IF #S-BS2-USER-ID = ' ' OR = '*'
      SEARCH-BS2-USER-ID := FALSE
    ELSE
      SEARCH-BS2-USER-ID := TRUE
      RETAIN-BS2-USER-ID := FALSE
    END-IF
    CALLNAT 'SELALPHA' #S-BS2-USER-ID #F-BS2-USER-ID #T-BS2-USER-ID
      #LENGTH
  WHEN #S-BS2-FORM NE #O-BS2-FORM
    #O-BS2-FORM := #S-BS2-FORM
    IF #S-BS2-FORM = ' ' OR = '*'
      SEARCH-BS2-FORM := FALSE
    ELSE
      SEARCH-BS2-FORM := TRUE
      RETAIN-BS2-FORM := FALSE
    END-IF
    CALLNAT 'SELALPHA' #S-BS2-FORM #F-BS2-FORM #T-BS2-FORM #LENGTH
  WHEN #S-UNIX-PATH NE #O-UNIX-PATH
    #O-UNIX-PATH := #S-UNIX-PATH
    IF #S-UNIX-PATH = ' ' OR = '*'
      SEARCH-UNIX-PATH := FALSE
    ELSE
      SEARCH-UNIX-PATH := TRUE
      RETAIN-UNIX-PATH := FALSE
    END-IF
    CALLNAT 'SELALPHA' #S-UNIX-PATH #F-UNIX-PATH #T-UNIX-PATH #LENGTH
  WHEN #S-UNIX-NODE NE #O-UNIX-NODE
    #O-UNIX-NODE := #S-UNIX-NODE
    IF #S-UNIX-NODE = ' ' OR = '*'
      SEARCH-UNIX-NODE := FALSE
    ELSE
      SEARCH-UNIX-NODE := TRUE
      RETAIN-UNIX-NODE := FALSE
    END-IF
    CALLNAT 'SELALPHA' #S-UNIX-NODE #F-UNIX-NODE #T-UNIX-NODE #LENGTH
  WHEN #S-UNIX-FILE NE #O-UNIX-FILE OR #S-SUBSTR NE #O-SUBSTR
    #O-UNIX-FILE := #S-UNIX-FILE
    #O-SUBSTR := #S-SUBSTR
    IF #S-UNIX-FILE = ' ' /*SU3 OR = '*' substr or prefix - no '*'
      SEARCH-UNIX-FILE := FALSE
    ELSE
      SEARCH-UNIX-FILE := TRUE
      RETAIN-UNIX-FILE := FALSE
    END-IF
    CALLNAT 'SELALPHA' #S-UNIX-FILE #F-UNIX-FILE #T-UNIX-FILE #LENGTH
  WHEN CV-KEY MODIFIED
    IGNORE
  WHEN ANY
    MODIFIED := TRUE
  WHEN NONE
    MODIFIED := FALSE
END-DECIDE
*
END-SUBROUTINE /* SEARCH-CRITERIA
*
************************************************************************
DEFINE SUBROUTINE SEARCH-REPORT
************************************************************************
DECIDE FOR EVERY CONDITION
  WHEN SEARCH-REPNAME             PERFORM BUILD-RETAIN-REPNAME
  WHEN NOT SEARCH-REPNAME         PERFORM RELEASE-RETAIN-REPNAME
  WHEN SEARCH-MASTER              PERFORM BUILD-RETAIN-MASTER
  WHEN NOT SEARCH-MASTER          PERFORM RELEASE-RETAIN-MASTER
  WHEN SEARCH-KEYWORDS            PERFORM BUILD-RETAIN-KEYWORDS
  WHEN NOT SEARCH-KEYWORDS        PERFORM RELEASE-RETAIN-KEYWORDS
  WHEN SEARCH-JES-JOB-NAME        PERFORM BUILD-RETAIN-JES-JOB-NAME
  WHEN NOT SEARCH-JES-JOB-NAME    PERFORM RELEASE-RETAIN-JES-JOB-NAME
  WHEN SEARCH-JES-WRITER          PERFORM BUILD-RETAIN-JES-WRITER
  WHEN NOT SEARCH-JES-WRITER      PERFORM RELEASE-RETAIN-JES-WRITER
  WHEN SEARCH-DIST                PERFORM BUILD-RETAIN-DIST
  WHEN NOT SEARCH-DIST            PERFORM RELEASE-RETAIN-DIST
  WHEN SEARCH-PRINTER             PERFORM BUILD-RETAIN-PRINTER
  WHEN NOT SEARCH-PRINTER         PERFORM RELEASE-RETAIN-PRINTER
  WHEN SEARCH-JES-DESTINATION     PERFORM BUILD-RETAIN-JES-DESTINATION
  WHEN NOT SEARCH-JES-DESTINATION PERFORM RELEASE-RETAIN-JES-DESTINATION
  WHEN SEARCH-JES-FORM            PERFORM BUILD-RETAIN-JES-FORM
  WHEN NOT SEARCH-JES-FORM        PERFORM RELEASE-RETAIN-JES-FORM
/*SU8 WHEN SEARCH-PWR-DESTINATION PERFORM BUILD-RETAIN-PWR-DESTINATION
/*SU8 WHEN NOT SEARCH-PWR-DESTINATION PERFORM RELEASE-RETAIN-PWR-DESTINATION
/*SU8 WHEN SEARCH-PWR-DESTINATION     PERFORM BUILD-RETAIN-PWR-DESTINATION
/*SU8 WHEN NOT SEARCH-PWR-DESTINATION PERFORM RELEASE-RETAIN-PWR-DESTINATION
/*SU8 WHEN SEARCH-PWR-JOB-NAME        PERFORM BUILD-RETAIN-PWR-JOB-NAME
/*SU8 WHEN NOT SEARCH-PWR-JOB-NAME    PERFORM RELEASE-RETAIN-PWR-JOB-NAME
/*SU8 WHEN SEARCH-PWR-FORM            PERFORM BUILD-RETAIN-PWR-FORM
/*SU8 WHEN NOT SEARCH-PWR-FORM        PERFORM RELEASE-RETAIN-PWR-FORM
  WHEN SEARCH-BS2-JOB-NAME        PERFORM BUILD-RETAIN-BS2-JOB-NAME
  WHEN NOT SEARCH-BS2-JOB-NAME    PERFORM RELEASE-RETAIN-BS2-JOB-NAME
  WHEN SEARCH-BS2-USER-ID         PERFORM BUILD-RETAIN-BS2-USER-ID
  WHEN NOT SEARCH-BS2-USER-ID     PERFORM RELEASE-RETAIN-BS2-USER-ID
  WHEN SEARCH-BS2-FORM            PERFORM BUILD-RETAIN-BS2-FORM
  WHEN NOT SEARCH-BS2-FORM        PERFORM RELEASE-RETAIN-BS2-FORM
  WHEN SEARCH-UNIX-NODE           PERFORM BUILD-RETAIN-UNIX-NODE
  WHEN NOT SEARCH-UNIX-NODE       PERFORM RELEASE-RETAIN-UNIX-NODE
  WHEN SEARCH-UNIX-PATH           PERFORM BUILD-RETAIN-UNIX-PATH
  WHEN NOT SEARCH-UNIX-PATH       PERFORM RELEASE-RETAIN-UNIX-PATH
  WHEN SEARCH-UNIX-FILE           PERFORM BUILD-RETAIN-UNIX-FILE
  WHEN NOT SEARCH-UNIX-FILE       PERFORM RELEASE-RETAIN-UNIX-FILE
  WHEN NONE IGNORE
END-DECIDE
#N-TOTAL := 0
*
IF RETAIN-REPNAME         AND #N-REPNAME         = 0
OR RETAIN-MASTER          AND #N-MASTER          = 0                  /*
OR RETAIN-KEYWORDS        AND #N-KEYWORDS        = 0                  /*
OR RETAIN-JES-JOB-NAME    AND #N-JES-JOB-NAME    = 0                  /*
OR RETAIN-JES-WRITER      AND #N-JES-WRITER      = 0                  /*
OR RETAIN-JES-DESTINATION AND #N-JES-DESTINATION = 0                  /*
OR RETAIN-JES-FORM        AND #N-JES-FORM        = 0                  /*
OR RETAIN-DIST            AND #N-DIST            = 0                  /*
OR RETAIN-PRINTER         AND #N-PRINTER         = 0                  /*
/*SU8 OR RETAIN-PWR-DESTINATION AND #N-PWR-DESTINATION = 0
/*SU8 OR RETAIN-PWR-JOB-NAME    AND #N-PWR-JOB-NAME    = 0
/*SU8 OR RETAIN-PWR-FORM        AND #N-PWR-FORM        = 0
OR RETAIN-BS2-JOB-NAME    AND #N-BS2-JOB-NAME    = 0                  /*
OR RETAIN-BS2-USER-ID     AND #N-BS2-USER-ID     = 0                  /*
OR RETAIN-BS2-FORM        AND #N-BS2-FORM        = 0                  /*
OR RETAIN-UNIX-NODE       AND #N-UNIX-NODE       = 0                  /*
OR RETAIN-UNIX-PATH       AND #N-UNIX-PATH       = 0                  /*
OR RETAIN-UNIX-FILE       AND #N-UNIX-FILE       = 0                  /*
  ESCAPE ROUTINE
END-IF
*
IF #N-REPNAME > 0
  FND1. FIND NUMBER RP WITH 'TSERRP01' RETAIN AS #P-SET-NAME
  #N-TOTAL := *NUMBER (FND1.)
END-IF
*
DECIDE FOR EVERY CONDITION
  WHEN #N-MASTER > 0
    IF #N-TOTAL = 0
      FND2.  FIND NUMBER RP WITH 'TSERRP02' RETAIN AS #P-SET-NAME
      #N-TOTAL := *NUMBER (FND2.)
    ELSE
      FND21. FIND NUMBER RP WITH 'TSERRP02' AND #P-SET-NAME
        RETAIN AS #P-SET-NAME
      #N-TOTAL := *NUMBER (FND21.)
      IF #N-TOTAL = 0
        ESCAPE ROUTINE
      END-IF
    END-IF
  WHEN #N-KEYWORDS > 0
    IF #N-TOTAL = 0
      FND3.  FIND NUMBER RP WITH 'TSERRP03' RETAIN AS #P-SET-NAME
      #N-TOTAL := *NUMBER (FND3.)
    ELSE
      FND31. FIND NUMBER RP WITH 'TSERRP03' AND #P-SET-NAME
        RETAIN AS #P-SET-NAME
      #N-TOTAL := *NUMBER (FND31.)
      IF #N-TOTAL = 0
        ESCAPE ROUTINE
      END-IF
    END-IF
  WHEN #N-JES-JOB-NAME > 0
    IF #N-TOTAL = 0
      FND4.  FIND NUMBER RP WITH 'TSERRP04' RETAIN AS #P-SET-NAME
      #N-TOTAL := *NUMBER (FND4.)
    ELSE
      FND41. FIND NUMBER RP WITH 'TSERRP04' AND #P-SET-NAME
        RETAIN AS #P-SET-NAME
      #N-TOTAL := *NUMBER (FND41.)
      IF #N-TOTAL = 0
        ESCAPE ROUTINE
      END-IF
    END-IF
  WHEN #N-JES-WRITER > 0
    IF #N-TOTAL = 0
      FND5.  FIND NUMBER RP WITH 'TSERRP05' RETAIN AS #P-SET-NAME
      #N-TOTAL := *NUMBER (FND5.)
    ELSE
      FND51. FIND NUMBER RP WITH 'TSERRP05' AND #P-SET-NAME
        RETAIN AS #P-SET-NAME
      #N-TOTAL := *NUMBER (FND51.)
      IF #N-TOTAL = 0
        ESCAPE ROUTINE
      END-IF
    END-IF
  WHEN #N-DIST > 0
    IF #N-TOTAL = 0
      FND6.  FIND NUMBER RP WITH 'TSERRP06' RETAIN AS #P-SET-NAME
      #N-TOTAL := *NUMBER (FND6.)
    ELSE
      FND61. FIND NUMBER RP WITH 'TSERRP06' AND #P-SET-NAME
        RETAIN AS #P-SET-NAME
      #N-TOTAL := *NUMBER (FND61.)
      IF #N-TOTAL = 0
        ESCAPE ROUTINE
      END-IF
    END-IF
  WHEN #N-PRINTER > 0
    IF #N-TOTAL = 0
      FND7.  FIND NUMBER RP WITH 'TSERRP07' RETAIN AS #P-SET-NAME
      #N-TOTAL := *NUMBER (FND7.)
    ELSE
      FND71. FIND NUMBER RP WITH 'TSERRP07' AND #P-SET-NAME
        RETAIN AS #P-SET-NAME
      #N-TOTAL := *NUMBER (FND71.)
      IF #N-TOTAL = 0
        ESCAPE ROUTINE
      END-IF
    END-IF
  WHEN #N-JES-DESTINATION > 0
    IF #N-TOTAL = 0
      FND8.  FIND NUMBER RP WITH 'TSERRP08' RETAIN AS #P-SET-NAME
      #N-TOTAL := *NUMBER (FND8.)
    ELSE
      FND81. FIND NUMBER RP WITH 'TSERRP08' AND #P-SET-NAME
        RETAIN AS #P-SET-NAME
      #N-TOTAL := *NUMBER (FND81.)
      IF #N-TOTAL = 0
        ESCAPE ROUTINE
      END-IF
    END-IF
  WHEN #N-JES-FORM > 0
    IF #N-TOTAL = 0
      FND9.  FIND NUMBER RP WITH 'TSERRP09' RETAIN AS #P-SET-NAME
      #N-TOTAL := *NUMBER (FND9.)
    ELSE
      FND91. FIND NUMBER RP WITH 'TSERRP09' AND #P-SET-NAME
        RETAIN AS #P-SET-NAME
      #N-TOTAL := *NUMBER (FND91.)
      IF #N-TOTAL = 0
        ESCAPE ROUTINE
      END-IF
    END-IF
/*SU8  WHEN #N-PWR-DESTINATION > 0
/*SU8  WHEN #N-PWR-JOB-NAME > 0
/*SU8  WHEN #N-PWR-FORM > 0
  WHEN #N-BS2-JOB-NAME > 0
    IF #N-TOTAL = 0
      FND13. FIND NUMBER RP WITH 'TSERRP13' RETAIN AS #P-SET-NAME
      #N-TOTAL := *NUMBER (FND13.)
    ELSE
      FND131. FIND NUMBER RP WITH 'TSERRP13' AND #P-SET-NAME
        RETAIN AS #P-SET-NAME
      #N-TOTAL := *NUMBER (FND131.)
      IF #N-TOTAL = 0
        ESCAPE ROUTINE
      END-IF
    END-IF
  WHEN #N-BS2-USER-ID > 0
    IF #N-TOTAL = 0
      FND14. FIND NUMBER RP WITH 'TSERRP14' RETAIN AS #P-SET-NAME
      #N-TOTAL := *NUMBER (FND14.)
    ELSE
      FND141. FIND NUMBER RP WITH 'TSERRP14' AND #P-SET-NAME
        RETAIN AS #P-SET-NAME
      #N-TOTAL := *NUMBER (FND141.)
      IF #N-TOTAL = 0
        ESCAPE ROUTINE
      END-IF
    END-IF
  WHEN #N-BS2-FORM > 0
    IF #N-TOTAL = 0
      FND15. FIND NUMBER RP WITH 'TSERRP15' RETAIN AS #P-SET-NAME
      #N-TOTAL := *NUMBER (FND15.)
    ELSE
      FND151. FIND NUMBER RP WITH 'TSERRP15' AND #P-SET-NAME
        RETAIN AS #P-SET-NAME
      #N-TOTAL := *NUMBER (FND151.)
      IF #N-TOTAL = 0
        ESCAPE ROUTINE
      END-IF
    END-IF
  WHEN #N-UNIX-PATH > 0
    IF #N-TOTAL = 0
      FND17. FIND NUMBER RP WITH 'TSERRP17' RETAIN AS #P-SET-NAME
      #N-TOTAL := *NUMBER (FND17.)
    ELSE
      FND171. FIND NUMBER RP WITH 'TSERRP17' AND #P-SET-NAME
        RETAIN AS #P-SET-NAME
      #N-TOTAL := *NUMBER (FND171.)
      IF #N-TOTAL = 0
        ESCAPE ROUTINE
      END-IF
    END-IF
  WHEN #N-UNIX-NODE > 0
    IF #N-TOTAL = 0
      FND16. FIND NUMBER RP WITH 'TSERRP16' RETAIN AS #P-SET-NAME
      #N-TOTAL := *NUMBER (FND16.)
    ELSE
      FND161. FIND NUMBER RP WITH 'TSERRP16' AND #P-SET-NAME
        RETAIN AS #P-SET-NAME
      #N-TOTAL := *NUMBER (FND161.)
      IF #N-TOTAL = 0
        ESCAPE ROUTINE
      END-IF
    END-IF
  WHEN #N-UNIX-FILE > 0
    IF #N-TOTAL = 0
      FND18. FIND NUMBER RP WITH 'TSERRP18' RETAIN AS #P-SET-NAME
      #N-TOTAL := *NUMBER (FND18.)
    ELSE
      FND181. FIND NUMBER RP WITH 'TSERRP18' AND #P-SET-NAME
        RETAIN AS #P-SET-NAME
      #N-TOTAL := *NUMBER (FND181.)
      IF #N-TOTAL = 0
        ESCAPE ROUTINE
      END-IF
    END-IF
  WHEN NONE IGNORE
END-DECIDE
*
END-SUBROUTINE /* SEARCH-REPORT
*
************************************************************************
