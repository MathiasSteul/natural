* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    RMPRGOS
* Version   3.5
* Function  Purge Order Source of a given order number
*
* ---------------------------------------------------------------------
* Maintenance
* uuuuuuuu yyyy-mm-dd iTrac       Description
* ---------------------------------------------------------------------
* fhi      2018-07-17 NOMALL-2008 Created.
* ---------------------------------------------------------------------
DEFINE DATA
*
PARAMETER
1 #OD-ID           (P10) BY VALUE
*
INDEPENDENT
1 +CMRDC (A1)        /* NOMALL-2009 fhi in
*
LOCAL
*
1 ORDER-SOURCE VIEW OF NRM-ORDER-SOURCE
  2 OS-OD-ID
  2 OS-RUNNUMBER
*
1 #OS-ID           (B12)
1 REDEFINE #OS-ID
  2 #OS-OD-ID        (P10)
  2 #OS-RUNNUMBER    (P11)
*
1 #TRACING                         (L)
END-DEFINE
* --------------------------------------- main -------------------------
*
PERFORM RMGTRACE-GET-SETTINGS #TRACING
INCLUDE CMRDC
*
#OS-OD-ID     := #OD-ID
#OS-RUNNUMBER := 1
READSRC.
READ ORDER-SOURCE BY OS-ID STARTING FROM #OS-ID
  IF OS-OD-ID NE #OS-OD-ID
    ESCAPE BOTTOM (READSRC.)
  END-IF
  DELETE (READSRC.)
END-READ
* -------------------------------------- End main ----------------------
END
