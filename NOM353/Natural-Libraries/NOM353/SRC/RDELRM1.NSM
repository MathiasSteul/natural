* >Natural Source Header 000000
* :Mode R
* :CP
* :LineIncrement 10
* <Natural Source Header
* MAP2: PROTOTYPE VERSION 820 --- CREATED BY NAT 0802030000 ---
* INPUT USING MAP 'XXXXXXXX'
*     #ANS-COMMIT #MASS-DEL-FOUND #MASS-RPNAME
DEFINE DATA PARAMETER
1 #ANS-COMMIT (A001)
1 #MASS-DEL-FOUND (N07.0)
1 #MASS-RPNAME (A025)
END-DEFINE
FORMAT PS=005 LS=052 ZP=OFF SG=OFF KD=OFF IP=OFF
* MAP2: MAP PROFILES *****************************        410***********
* .TTAAAMMOO   TU6ID I N D I D I        ?_)^&:+(                       *
* 005051        N0NNUCN             X        01 SYSPROF NL           1 *
************************************************************************
INPUT          (     IP=OFF                                           /*
                                                                       )
 001T 'Your Mass deletion Selection'(TU)
/
 002T #MASS-RPNAME  (AD=OD ) /*.01U025 A025 .
/
 001T 'has found'(TU)
 012T #MASS-DEL-FOUND  (AD=OD ) /*.01U007 N07.0.
 020T 'reports for deletion'(TU)
/
/
 001T 'Enter'(TU)
 007T 'Y'(YEI)
 009T 'to COMMIT'(TU)
 019T 'N'(YEI)
 021T 'to BACKOUT Mass Deletion ==>'(TU)
 051T #ANS-COMMIT  (AD=AILT'_' ) /*.99U001 A001 .
* MAP2: VALIDATION *****************************************************
RULEVAR F00#ANS-COMMIT
INCDIC                                 ;
IF NOT(& = 'Y' OR = 'N') AND *PF-KEY NE 'PF3'
  REINPUT 'Enter Y OR N' ALARM
* MAP2: END OF MAP *****************************************************
END
