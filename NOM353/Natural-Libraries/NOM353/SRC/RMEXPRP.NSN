  PERFORM CONVERT-XML
  FOR #L := 6 TO 1 STEP -1
    IF RP.R-KEYWORDS (#L) NE ' '
      ESCAPE BOTTOM
    END-IF
  END-FOR
  FOR #I = 1 TO #L
    #FIELD := 'R-KEYWORDS'
