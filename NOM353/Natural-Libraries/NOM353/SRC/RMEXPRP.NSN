  PERFORM CONVERT-XML
  #FIELD := 'R-NOMUSR-INTERFACE'
  #VALUE :=  RP.R-NOMUSR-INTERFACE
  PERFORM CONVERT-XML
* Group: IDENT-TYPE + IDENT-VALUE:
  FOR #L := C*R-IDENT TO 1 STEP -1 /*SU3 was 14
    IF RP.R-IDENT-TYPE (#L) NE 0
      ESCAPE BOTTOM
    END-IF
  END-FOR
  FOR #I = 1 TO #L
    #FIELD := 'R-IDENT-TYPE'
    #VALUE :=  RP.R-IDENT-TYPE(#I)
    PERFORM CONVERT-XML1
  END-FOR
/*SU3  FOR #L := 14 TO 1 STEP -1 IF RP.R-IDENT-VALUE (#L) NE ' '
/*SU3 ESCAPE BOTTOM END-IF END-FOR
  FOR #I = 1 TO #L
    #FIELD := 'R-IDENT-VALUE'
    #VALUE :=  RP.R-IDENT-VALUE(#I)
    PERFORM CONVERT-XML1
  END-FOR
  FOR #L := 10 TO 1 STEP -1
    IF RP.R-IDENT-FILES (#L) NE ' '
      ESCAPE BOTTOM
    END-IF
  END-FOR
  FOR #I = 1 TO #L
    #FIELD := 'R-IDENT-FILES'
    #VALUE :=  RP.R-IDENT-FILES(#I)
    PERFORM CONVERT-XML1
