PERFORM #START
READ RP BY R-REPNAME = #KEY-FROM ENDING AT #KEY-TO
  #KEY := R-REPNAME
  PERFORM HANDLE-MASK
* Get depending objects:
/*SU3 in next line it should be R-PRINTER instead R-PRINTERS Ü?
  INCLUDE RMLD2XC2 '20' 'R-PRINTERS' '''RMEXPPR'''
  INCLUDE RMLD2XC2 '10' 'R-NATRPT-DIST' '''RMEXPUS'''
  INCLUDE RMLD2XC2 '10' 'R-NATRPT-DIST' '''RMEXPDL'''
  INCLUDE RMLD2XC3 'R-REPNAME' '''R''' /*RMEXPGR
  INCLUDE RMLD2XC4 'R-INTERNAL-NODE-ID' '''RMEXPNO'''
  COMPRESS '<RP depending="' #DEP '">' TO #WORK-LINE LEAVING NO
  PERFORM WRITE-XML
  IF #OD-LOG = 'Y'
    IF #ID SPECIFIED
      COMPRESS 'Exported: RP */' R-REPNAME TO #TRACE-MSG
    ELSE
      COMPRESS 'Exported: RP /' R-REPNAME TO #TRACE-MSG
    END-IF
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    END TRANSACTION
  END-IF
*
  MOVE EDITED RP.R-OBJECT-TIME (EM=YYYY'-'MM'-'DD'-'HH':'II':'SS'.'T)
    TO #R-OBJECT-TIME
  MOVE EDITED RP.R-LAST-MODIFIED (EM=YYYY'-'MM'-'DD'-'HH':'II':'SS'.'T)
    TO #R-LAST-MODIFIED
  MOVE EDITED RP.R-LAST-UPDATE (EM=YYYY'-'MM'-'DD'-'HH':'II':'SS'.'T)
    TO #R-LAST-UPDATE
*
  #FIELD := 'R-REPNAME' /*ÜÜmust be first one ÜÜ /*SU3 moved here
  #VALUE :=  RP.R-REPNAME
  PERFORM CONVERT-XML
  #FIELD := 'R-OBJECT-TYPE'
  #VALUE :=  RP.R-OBJECT-TYPE
  PERFORM CONVERT-XML
  #FIELD := 'R-OBJECT-TIME'
  #VALUE :=  #R-OBJECT-TIME
  PERFORM CONVERT-XML
  #FIELD := 'R-INTERNAL-NODE-ID'
  #VALUE :=  RP.R-INTERNAL-NODE-ID
  PERFORM CONVERT-XML
  #FIELD := 'R-REMOTE-CODEPAGE'
  #VALUE :=  RP.R-REMOTE-CODEPAGE
  PERFORM CONVERT-XML
  #FIELD := 'R-NODE-UX'
  #VALUE :=  RP.R-NODE-UX
  PERFORM CONVERT-XML
  #FIELD := 'R-MASTER-REPNAME'
