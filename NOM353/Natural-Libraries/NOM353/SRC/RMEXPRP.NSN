  PERFORM CONVERT-XML
* Group with 3 fields:
  FOR #L := 20 TO 1 STEP -1
    IF RP.R-PRINTER (#L) NE ' '
      ESCAPE BOTTOM
    END-IF
  END-FOR
  FOR #I = 1 TO #L
    #FIELD := 'R-PRINTER'
