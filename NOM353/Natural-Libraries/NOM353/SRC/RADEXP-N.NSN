* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RADEXP-N  Get expiration date of archive data set.
*           Dataset-reports are checked for highest expiration date.
*
* MAINTENANCE:
* xy  91-00-00  ...
* ----------------------------------------------------------------------
DEFINE DATA
PARAMETER
1 #P-ARCDSNAME   (A44)
1 #P-ARC-EXPDATE (A8)
************************************************************************
LOCAL USING VDSNRP-L
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET #P-ARC-EXPDATE
*
FIND DATASET-REPORT WITH DR-ARCHIVE-DSNAME = #P-ARCDSNAME
  IF DR-EXPIRATION-DATE > #P-ARC-EXPDATE
    #P-ARC-EXPDATE := DR-EXPIRATION-DATE
  END-IF
END-FIND
*
END
