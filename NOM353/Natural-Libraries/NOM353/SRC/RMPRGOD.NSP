* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    RMPRGOD
* Version   1.3
* Function  Purge orders
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* mrs 93-08-12           created
* mrs 93-09-22 s(999999) delete failed orders
* sju 04-11-29 nom31     restow for changed NRM-ORDER
* SU1 2014-02-10 NOMALL-1344 unix - daily cleanup does not delete orders
* fhi     2017-01-11 NOMALL-1961 Change descriptor of NRM-ORDER
* fhi     2018-07-18 NOMALL-2008 Delete order sources
* ----------------------------------------------------------------------
DEFINE DATA GLOBAL USING MONIT-GL
LOCAL
1 ORDER VIEW OF NRM-ORDER
  2 OD-ID                   /* NOMALL-2008 fhi in
  2 OD-MONITOR-ID
  2 OD-TYPE
*
* fhi     2017-01-11 NOMALL-1961 start commenting
*  1 #S-MONITOR-ID-TYPE-TIME (A17)
*  1 REDEFINE #S-MONITOR-ID-TYPE-TIME
*    2 #S-MONITOR-ID         (A8)
*    2 #S-TYPE               (B2) /*SU1 2014-02-10 NOMALL-1344 was I2
*    2 #S-TIME               (P13)
* fhi     2017-01-11 NOMALL-1961 end commenting, start insertion
1 #S-TYPE-TIME (A9)
1 REDEFINE #S-TYPE-TIME
  2 #S-TYPE               (B2)
  2 #S-TIME               (P13)
* fhi     2017-01-11 NOMALL-1961 end insertion
1 #T-TYPE                 (I2) CONST <7999>
1 #COUNTER                (P10)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
WRITE NOTITLE NOHDR
  *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
  'Start Order Clean up'
*
* #S-MONITOR-ID := G-MONITOR-ID  /* NOMALL-1961 fhi out
#S-TYPE       := 5000
RESET #S-TIME
* *****
* Delete orders with states ok and failed:
* *****
* fhi     2017-01-11 NOMALL-1961 start commenting
* REAOD. READ ORDER BY OD-MONITOR-ID-TYPE-TIME = #S-MONITOR-ID-TYPE-TIME
*
* IF OD-MONITOR-ID NE #S-MONITOR-ID OR OD-TYPE > #T-TYPE
* fhi     2017-01-11 NOMALL-1961 end commenting, start insertion
REAOD. READ ORDER BY OD-TYPE-TIME = #S-TYPE-TIME
  IF OD-TYPE > #T-TYPE
* fhi     2017-01-11 NOMALL-1961 end insertion
    ESCAPE BOTTOM (REAOD.)
  END-IF
*
  ADD 1 TO #COUNTER
  DELETE
  CALLNAT 'RMPRGOS' OD-ID /* NOMALL-2008 fhi in
  IF *COUNTER > 50
    RESET *COUNTER
    END OF TRANSACTION
  END-IF
*
END-READ
END OF TRANSACTION
*
WRITE NOTITLE NOHDR
  *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
  'Number of deleted Orders' #COUNTER
*
WRITE NOTITLE NOHDR
  *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
  'End Order Clean up'
*
END
