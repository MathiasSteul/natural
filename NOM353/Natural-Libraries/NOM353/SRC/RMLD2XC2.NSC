* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RMLD2XC2 - Copy code for RMLD2XML
*                                                                       ********
* Maintenance
* User ID   yyyy-mm-dd Issue       Remark
* --------------------------------------------------------------------- --------
* fhi       2013-08-16 NOMALL-86   Created.
* SU1     2021-02-17 NOMALL-2443 use of PDA RMEXP-A
************************************** data ************************************
FOR #I = 1 TO &1&
  IF &2& (#I) = ' '
    ESCAPE BOTTOM
  END-IF
  #EXPORT-PROG := &3&
  COMPRESS SUBSTR(#EXPORT-PROG,6,2) &2& (#I)
    TO #ID-MEMBER LEAVING NO
  EXAMINE +ID (*) FOR #ID-MEMBER GIVING INDEX #IND
  IF #IND = 0
    CALLNAT &3& XXUX---P #EXPORT #TRACING &2& (#I) /*SU1 was ORDER
    IF #OD-ERROR-CODE NE 0
      ESCAPE MODULE
    END-IF
    IF +ID-INDEX GE *OCC(+ID)
      #IND := +ID-INDEX + 10
      EXPAND ARRAY +ID TO (1:#IND)
    END-IF
    ADD 1 TO +ID-INDEX
    +ID (+ID-INDEX) := #ID-MEMBER
  END-IF
END-FOR
** End of Copycode RMLD2XC2 ********************************************
