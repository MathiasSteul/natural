* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* EOMRPMVN - DB Interface EOM Object Report (delete, copy, rename)
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* mrs 93-06-10 s(999999) created
* mrs 94-03-14 s(196685) delete report from bundle and reset trigger
* jvd 97-07-08 p(163579) separator page length truncation
* jvd 98-01-05 p(168861) array occurs change to 1:10
* wcd 00-04-01 CE 7267   re-cat as changes made to EOMRPM-P
* xsethz   2000-05-30 s(CE7760) re-cat as changes made to EOMRPM-P
* xsisgg   2000-06-14 p(195949) can not delete report in use
* SJU      2000-08-21 p(......) can't delete report if purge bp order exists
* fhi      2000-08-24 QA03      Use NAT23006 for error values
* sju      2002-10-08 nom221    Some fields missed on copy
* sju      2002-11-08 nom221    Long record indicator
* xsetggr  2002-12-03 nom221    number of printers too small
* sju      2004-11-29 nom31     restow for changed NRM-ORDER
* sju      2005-10-13 p(270567) only disallow deletion if there are
*                               orders for this report
* fhi      2005-11-21 FHI123    NAT3041 at delete report function
* fhi     2007-07-12 NOM3202   C-NATERR changed, NAD23006 is obsolete.
* xsetggr 2009-03-30 P312000   include r-rep-format in report attributes
* fhi     2011-05-02 NOMALL-901 Log any online delete operation
* xsetggr 2011-09-12 NOMALL-1058 Log delete from NOM API
* raya    2012-08-16 NOMALL-78  disable long records
* fhi     2013-08-29 FHI285    Enhance error message 406
* SU1     2013-11-22 NOMALL-1288 correct FHI285 for msg 406
* SU2 2014-02-10 NOMALL-1344 unix - daily cleanup does not delete orders
* SU3     2014-06-02 NOMALL-1281 show last update user+date
* fhi     2014-08-26 NOMALL-1475 Recat for new field 'FORMATTER'
* fhi     2016-11-15 NOMALL-1961 Use new task IDs
* fhi     2017-01-11 NOMALL-1961 Change descriptor of NRM-ORDER
* SU4     2018-02-01 NOMALL-1823 NOM 3.5: remove CONNECT
* SU5     2018-02-02 ES-23787    NOM 3.5: copy new attr. node and CP
* BLI     2020-03-04 NOMALL-2379 Unix files A26 -> A50, cat only
* SU6     2020-04-16 NOMALL-2403 use different DDM for NOMALL-2379
* ----------------------------------------------------------------------
DEFINE DATA
PARAMETER USING EOM----P
PARAMETER USING EOMRPM-P
PARAMETER USING EOMMSG-P
************************************************************************
LOCAL USING EOM----E
LOCAL USING RMODTY-E
LOCAL
1 BUNDLE-REPORT VIEW OF NRM-BUNDLE-REPORT
  2 BR-REPNAME
  2 BR-BUNDLE
1 REPORT-LAYOUT VIEW OF NRM-REP-TARGET
  2 RD-REPNAME
  2 RD-TARGET-ID
  2 RD-LAYOUT
    3 RD-FROM            (1:10)
    3 RD-TO              (1:10)
  2 RD-HEADLINES
1 BUNDLES VIEW OF NRM-BUNDLES
  2 B-FLUSH-REPORTS      (8)
1 REPORT VIEW OF NRM-REPORTS-NEW
  2 R-REPNAME
1 CREATED-REPORT VIEW OF NRM-REPORTS-NEW
  2 R-MASTER-REPNAME
1 REPORT-ATTRIBUTES VIEW OF NRM-REPORTS-NEW /*SU6
  2 R-REPNAME
  2 R-MASTER-REPNAME
  2 R-NOMUSR-INTERFACE
  2 R-IDENT              (1:10)
  2 R-IDENT-JOB-NAME
  2 R-JOB-FROM
  2 R-JOB-TO
  2 R-IDENT-FILES        (A50/1:10) /*SU6
  2 R-IDENT-WRITER
  2 R-TYPE
  2 R-DESC
  2 R-KEYWORDS           (1:3)
  2 R-USERID
  2 R-STORE-NATRPT
  2 R-ARCHIVE
  2 R-LAST-MODIFIED
  2 R-MODIFIED-BY
  2 R-RETENTION-ACTION
  2 R-RETENTION-PERIOD
  2 R-ARCHIVE-RETENTION
  2 R-REVIVE-RETENTION
  2 R-HOLD-PRINT
  2 R-SEPMEM
  2 R-SEPNO
  2 R-SEPLENG
  2 R-PRINTERS           (1:20)
  2 R-PRINT-JOBCARD      (1:3)
  2 R-NATRPT-DIST        (1:10)
  2 R-CREATE-DEFINITION
  2 R-EXITLIB
  2 R-EXITMEM
  2 R-ASM-EXIT
  2 R-E-IDENT-LINE
  2 R-E-IDENT-STRING
  2 R-E-BREAK-STRING
  2 R-E-BREAK-LINE
  2 R-E-BREAK-START
  2 R-E-BREAK-END
  2 R-E-REP-PREFIX
  2 R-BUNDLE             (1:6)
  2 R-E-PARAMS           (1:4)
  2 R-UPARMS             (1:5)
  2 R-E-EXIT-TYPE
  2 R-LASTRNB
  2 R-IDENTIFIED-BY
  2 R-PRINT-JOBNAME
  2 R-HOLD
  2 R-TOP-PAGE
  2 R-BOT-PAGE
  2 R-E-BUN-PREFIX
  2 R-E-ADR-USERID-START
  2 R-E-ADR-USERID-END
  2 R-ARCHIVE-TYPE
  2 R-STYLESHEET-URL
  2 R-REP-FORMAT
  2 R-INTERNAL-NODE-ID   (P11)
  2 R-REMOTE-CODEPAGE    (A64)
1 ORDER VIEW OF NRM-ORDER
  2 OD-MONITOR-ID
  2 OD-TYPE
  2 OD-TIME-SCHEDULED
  2 OD-TIME-CREATED
  2 OD-TIME-PROCESSED
  2 OD-SOURCE-ID
  2 OD-PARAMETER         (1:1)
  2 REDEFINE OD-PARAMETER
    3 OD-MASTER          (A25)
*
1 #TYPE-ENTRIES         (N2) INIT <8>
1 #TYPE-TIME (A9)
1 REDEFINE #TYPE-TIME
  2 #TYPE               (B2)
  2 #TIME               (T)
1 #OBJ                  (A50)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
DECIDE ON FIRST EOM-FUNCTION
  VALUE EOM-DELETE  PERFORM DELETE-REPORT
  VALUE EOM-RENAME  PERFORM RENAME-REPORT
  VALUE EOM-COPY    PERFORM COPY-REPORT
  NONE              IGNORE
END-DECIDE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE DELETE-REPORT
************************************************************************
#TYPE := OD-CREATE-AR
RESET #TIME
RDORD. READ ORDER BY OD-TYPE-TIME = #TYPE-TIME
  IF OD-TIME-SCHEDULED > *TIMX
  OR OD-TYPE > OD-JES3-RETRY-SPOOL-IN-PROCESS                         /*
    ESCAPE BOTTOM
  END-IF
  IF OD-TYPE LE OD-JES3-RETRY-SPOOL-IN-PROCESS
  AND OD-TIME-SCHEDULED < *TIMX                                       /*
    IF (OD-TYPE = OD-CREATE-AR OR = OD-CREATE-AR-IN-PROCESS)
    AND OD-MASTER = EOMRPM-I-NAME                                     /*
      EOMMSG-NR := 0417
      ESCAPE ROUTINE
    END-IF
    FIND ORDER WITH OD-SOURCE-ID = OD-SOURCE-ID
      IF (OD-TYPE = OD-CREATE-AR OR = OD-CREATE-AR-IN-PROCESS)
      AND OD-MASTER = EOMRPM-I-NAME                                   /*
        EOMMSG-NR := 0417
        ESCAPE ROUTINE
      END-IF
    END-FIND
  END-IF
*
END-READ
*
DELRP. FIND REPORT WITH R-REPNAME = EOMRPM-I-NAME
  IF NO RECORDS FOUND
    EOMMSG-NR := 0406
    COMPRESS EOMRPM-I-NAME ' (' *PROGRAM ',' *LINE ')'
      TO EOMMSG-TOKEN(1) LEAVING NO
    ESCAPE BOTTOM (DELRP.)
  END-NOREC
  DELETE
  #OBJ := EOMRPM-I-NAME
  PERFORM RMLOGDEL #OBJ 'REPORT' EOM-USER EOM-LIBRARY
  DELRL. FIND REPORT-LAYOUT WITH RD-REPNAME = EOMRPM-I-NAME
    DELETE
    #OBJ := EOMRPM-I-NAME
    PERFORM RMLOGDEL #OBJ 'REPORT-LAYOUT' EOM-USER EOM-LIBRARY
  END-FIND
*
  DELBC. FIND BUNDLE-REPORT WITH BR-REPNAME = EOMRPM-I-NAME
    DELETE
    #OBJ := EOMRPM-I-NAME
    PERFORM RMLOGDEL #OBJ 'BUNDLE-REPORT' EOM-USER EOM-LIBRARY
    FIND BUNDLES WITH B-BUNDLE = BR-BUNDLE
      EXAMINE FULL VALUE OF B-FLUSH-REPORTS (*)
        FOR FULL VALUE EOMRPM-I-NAME REPLACE ' '
      UPDATE
    END-FIND
  END-FIND
*
END-FIND
*
END-SUBROUTINE /* DELETE-REPORT
*
************************************************************************
DEFINE SUBROUTINE RENAME-REPORT
************************************************************************
FNDNRP. FIND NUMBER REPORT WITH R-REPNAME = EOMRPM-I-NEWNAME
IF *NUMBER (FNDNRP.) > 0
  EOMMSG-NR := 0033
  EOMMSG-TOKEN (1) := EOMRPM-I-NEWNAME
  EOMMSG-FIELD-NAME := 'EOMRPM-I-NEWNAME'
  ESCAPE ROUTINE
END-IF
*
RENRP. FIND REPORT WITH R-REPNAME = EOMRPM-I-NAME
  IF NO RECORDS FOUND
    EOMMSG-NR := 0406
    COMPRESS EOMRPM-I-NAME ' (' *PROGRAM ',' *LINE ')'
      TO EOMMSG-TOKEN(1) LEAVING NO
    ESCAPE BOTTOM (RENRP.)
  END-NOREC
  R-REPNAME := EOMRPM-I-NEWNAME
  EOMRPM-LAST-UPDATE      := R-LAST-MODIFIED := *TIMX
  EOMRPM-LAST-UPDATE-USER := R-MODIFIED-BY   := EOM-USER
  UPDATE (RENRP.)
  FNDRL. FIND REPORT-LAYOUT WITH RD-REPNAME = EOMRPM-I-NAME
    RD-REPNAME := EOMRPM-I-NEWNAME
    UPDATE
  END-FIND
  BR. FIND BUNDLE-REPORT WITH BR-REPNAME = EOMRPM-I-NAME
    BR-REPNAME := EOMRPM-I-NEWNAME
    UPDATE
    FIND BUNDLES WITH B-BUNDLE = BR-BUNDLE
      EXAMINE FULL VALUE OF B-FLUSH-REPORTS (*)
        FOR FULL VALUE EOMRPM-I-NAME REPLACE EOMRPM-I-NEWNAME
      UPDATE
    END-FIND
  END-FIND
  FIND CREATED-REPORT WITH R-MASTER-REPNAME = EOMRPM-I-NAME
    R-MASTER-REPNAME := EOMRPM-I-NEWNAME
    UPDATE
  END-FIND
END-FIND
*
END-SUBROUTINE /* RENAME-REPORT
*
************************************************************************
DEFINE SUBROUTINE COPY-REPORT
************************************************************************
FNDNRPC. FIND NUMBER REPORT WITH R-REPNAME = EOMRPM-I-NEWNAME
IF *NUMBER (FNDNRPC.) > 0
  EOMMSG-NR := 0033
  EOMMSG-TOKEN (1) := EOMRPM-I-NEWNAME
  EOMMSG-FIELD-NAME := 'EOMRPM-I-NEWNAME'
  ESCAPE ROUTINE
END-IF
*
COPYRP. FIND REPORT-ATTRIBUTES WITH R-REPNAME = EOMRPM-I-NAME
  IF NO RECORDS FOUND
    EOMMSG-NR := 0406
    COMPRESS EOMRPM-I-NAME ' (' *PROGRAM ',' *LINE ')'
      TO EOMMSG-TOKEN(1) LEAVING NO
    ESCAPE BOTTOM (COPYRP.)
  END-NOREC
  R-REPNAME := EOMRPM-I-NEWNAME
  EOMRPM-LAST-UPDATE      := R-LAST-MODIFIED := *TIMX
  EOMRPM-LAST-UPDATE-USER := R-MODIFIED-BY   := EOM-USER
  STORE REPORT-ATTRIBUTES
  CPYRL. FIND REPORT-LAYOUT WITH RD-REPNAME = EOMRPM-I-NAME
    RD-REPNAME := EOMRPM-I-NEWNAME
    STORE REPORT-LAYOUT
  END-FIND
END-FIND
*
END-SUBROUTINE /* COPY-REPORT
*
INCLUDE C-EOMERR /*ON ERROR
*
END
