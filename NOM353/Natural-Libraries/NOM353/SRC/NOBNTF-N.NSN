* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* ----------------------------------------------------------------
* Subprogram  NOBNTF-N
* Version     3.1
* Function    NOM API TRansfer bundles to target environment
* Input keys: ES-KEY-PARM(1) - transfer parms (redef NOXXTF-L)
*
* Maintenance:
* XSETGGR 2005-01-26   created
* sju 06-06-28 p(280697) Correct bundle retention number - restow
* fhi     2007-07-12 NOM3202   C-NATERR changed, NAD23006 is obsolete.
* XSETHZ  2008-07-23 (307577) use full name of ES-APP-SERVER-LIBRARY
* xsetggr 2008-10-30 p(309496) err msg if target env not initialized
* xsetggr 2012-08-16 NOMALL-1145 correct header
* SU1     2013-01-31 unused      Deactivate unused data areas
* CF1     2014-11-12 NOMALL-1528 Improve error stability
* SU2     2021-06-08 NOMALL-2454 remove short DBID/FNR/NODE vars
* ------------------------------------------------------------------
DEFINE DATA
PARAMETER USING ESMCNT-A
PARAMETER USING ESMINP-A
PARAMETER USING ESMWORKA
PARAMETER USING NOXXTF-A
************************************************************************
LOCAL USING NOXXTF-L
LOCAL USING NOBNSL-A
LOCAL USING VMBUN-L      /* nrm-bundles
LOCAL USING VTBUND-L     /* nrm-migrate-bundles
LOCAL USING NADA2000
LOCAL USING NAD-MSG
LOCAL USING NAD-FLD
LOCAL                                                      /* CF1 +
1 NAT23008-PARA
  2 LFILE-NR           (B1)
  2 FUNCTION           (A1)     /* 'S'=Set, 'R'=Reset
  2 DBID               (B2)
  2 FNR                (B2)
  2 PASSWORD           (A8)
  2 CIPHER             (A8)
  2 VSAM-NAME          (A8)
  2 DB-TYPE            (A1)
  2 LFILE-IS-SET       (L)
  2 RET_CODE           (I4)                               /* CF1 -
1 MIGRATE-USERS VIEW OF NRM-MIGRATE-USERS /*SU1 in
1 MIGRATE-PRINTERS VIEW OF NRM-MIGRATE-PRINTERS /*SU1 in
1 MIGRATE-REPORTS VIEW OF NRM-MIGRATE-REPORTS
1 MIGRATE-LISTS VIEW OF NRM-MIGRATE-DISTRIBUTION-LIST
1 MONITOR VIEW OF NRM-MONITOR
1 BUNDLE-REPORT VIEW OF NRM-BUNDLE-REPORT
  2 BR-BUNDLE
  2 BR-REPNAME
  2 BR-PRINTER
  2 BR-GROUP
  2 BR-SEQNO
  2 BR-SEPNO
  2 BR-REPNO
  2 BR-PAGEDEF
  2 BR-FORMDEF
1 MIGRATE-BUNDLE-REPORT VIEW OF NRM-MIGRATE-BUNDLE-REPORT
  2 BR-BUNDLE
  2 BR-REPNAME
  2 BR-PRINTER
  2 BR-GROUP
  2 BR-SEQNO
  2 BR-SEPNO
  2 BR-REPNO
  2 BR-PAGEDEF
  2 BR-FORMDEF
1 GRANTS VIEW OF NRM-GRANTS
  2 GR-USERID
  2 GR-OBJECT-TYPE
  2 GR-OBJECT-NAME
  2 C*GR-OPTION
  2 GR-OPTION               (6)
1 MIGRATE-GRANTS VIEW OF NRM-MIGRATE-GRANTS
  2 GR-USERID
  2 GR-OBJECT-TYPE
  2 GR-OBJECT-NAME
  2 C*GR-OPTION
  2 GR-OPTION               (6)
1 #LFILE-FIELDS
  2 LFILE                   (L)
  2 #LFILE-OLDDBID          (N5)             /*  old DBID
  2 #LFILE-OLDFILE          (N5)             /*  old File-Number
  2 #LFILE-NEWDBID          (N5)             /*  new DBID
  2 #LFILE-NEWFILE          (N5)             /*  new File-Number
1 #GR-SUPER                 (A34)
1 REDEFINE #GR-SUPER
  2 #GR-TYPE                (A1)
  2 #GR-USERID              (A8)
  2 #GR-OBJECT              (A25)
1 #GR-TYPE-NAME             (A26) INIT <'B'>
1 REDEFINE #GR-TYPE-NAME
  2 #GRANT-TYPE             (A1)
  2 #GRANT-NAME             (A25)
1 #I2                       (I4)
1 #I                        (I4)
1 #IMAX                     (I4)
1 #BUNDLE-S                 (A25)
1 #BUNDLE-E                 (A25)
1 #REPORT-S                 (A25)
1 #REPORT-E                 (A25)
1 #MASTER-S                 (A25)
1 #MASTER-E                 (A25)
1 #GRANT-USERID             (A8)
1 #GRANTS                   (A1/6)
1 #ES-MSG-PREF              (A7) INIT <'NOM'>
1 REDEFINE #ES-MSG-PREF
  2 #ES-MSG-NOM             (A3)
  2 #ES-MSG-NR              (N4)
1 #ES-MSG-FIELD             (A32)
1 REDEFINE #ES-MSG-FIELD
  2 #ES-MSG-FIELD-NAME      (A28)
  2 #ES-MSG-FIELD-INDEX     (N4)
1 #ES-MSG-TXT               (A58)
1 #ET-COUNT                 (I2)
1 #PRINTER                  (A8)
1 #SELECT                   (L)
1 #EXIST                    (L)
1 #MESSAGE                  (A250)                         /* CF1 +
1 #MSG-TEXT                 (A79)
1 #ERRORNUMBER              (N4)
1 #LANGCODE                 (I1)
1 #RESPCODE                 (N1)
1 #FUNC                     (A1)
1 #LFILE                    (N5) INIT<158>                 /* CF1 -
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
************************************************************************
ON ERROR
************************************************************************
  ES-RC := 1
  #ERRORNUMBER := *ERROR-NR
  CALLNAT 'NAT00020' #ERRORNUMBER #LANGCODE #MSG-TEXT #RESPCODE
  IF #RESPCODE NE 0
    COMPRESS *PROGRAM 'ERROR' *ERROR-NR *ERROR-LINE TO ES-MSG-TXT
  ELSE
    COMPRESS #ERRORNUMBER #MSG-TEXT TO ES-MSG-TXT
  END-IF
  ESCAPE ROUTINE
*
END-ERROR
************************************************************************
RESET ES-RC
#NOBNSL := ES-SELECT
NOTF-PARM-1 := ES-KEY-PARM(1)
/*
/* Verify input parameters and switch LFILE 158 to target values
PERFORM SET-LOGICAL-FILE
/*
IF #ES-MSG-NR NE 0
  PERFORM GET-MSG-TXT
  ES-RC := 1
  ES-MSG-FIELD := #ES-MSG-FIELD
  COMPRESS '<#ERRORNUMBER' #ERRORNUMBER ':' #MESSAGE '>' TO ES-WORK
ELSE
/* Check appropriate objects and perform copy
  PERFORM LIST
  RESET #ES-MSG-NR
  /*
  /* Switch LFILE 158 back to former values
  PERFORM SWITCH-BACK-LFILE
  IF #ES-MSG-NR NE 0
    PERFORM GET-MSG-TXT
    ES-RC := 2
  END-IF
END-IF                                                     /* CF1 -
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE LIST
************************************************************************
RESET ES-NUMBER ES-OPTION-COUNT ES-STARTINDEX ES-SORTKEY ES-SORTORDER
  ES-EXPAND NOTF2-LIST(*)
ES-EOF := 'X'
#IMAX := 265
ES-FIELD-COUNT := 2
EXAMINE #NOBNSL.#NAME FOR '*' DELETE
COMPRESS #NOBNSL.#NAME H'FF' TO #BUNDLE-E LEAVING NO
EXAMINE #NOBNSL.#AUTH FOR '*' DELETE
EXAMINE #NOBNSL.#REPORT FOR '*' DELETE
EXAMINE #NOBNSL.#MASTER FOR '*' DELETE
EXAMINE #NOBNSL.#COORD FOR '*' DELETE
#MASTER-S := #NOBNSL.#MASTER
COMPRESS #NOBNSL.#MASTER H'FF' TO #MASTER-E LEAVING NO
#REPORT-S := #NOBNSL.#REPORT
COMPRESS #NOBNSL.#REPORT H'FF' TO #REPORT-E LEAVING NO
IF ES-NEXT-KEY-PARM(1) > #NOBNSL.#NAME
  #BUNDLE-S := ES-NEXT-KEY-PARM(1)
ELSE
  #BUNDLE-S := #NOBNSL.#NAME
  ES-STARTINDEX := 1
  #ES-MSG-NR := 6107
  PERFORM GET-MSG-TXT
  NOTF3-HEADER(1) := LONG-MSG(1)   /* bundle
  #ES-MSG-NR := 6102
  PERFORM GET-MSG-TXT
  NOTF3-HEADER(2) := LONG-MSG(13)
END-IF
R. READ BUNDLES WITH B-BUNDLE = #BUNDLE-S ENDING AT #BUNDLE-E
  IF B-BUNDLE > #BUNDLE-E
    ESCAPE BOTTOM(R.)
  END-IF
  PERFORM SELECT-RECORD
  RESET #GRANTS (*)
  IF NOT (#NOBNSL.#AUTH = ' ' OR = '*' OR = 'ADMIN')
    CALLNAT 'NOGROU-N'
      'B' BUNDLES.B-BUNDLE #NOBNSL.#AUTH #GRANT-USERID #GRANTS(*)
  ELSE
    #GRANTS(*) := 'Y'
  END-IF
  ACCEPT IF #SELECT  AND #GRANTS(1:4) = 'Y'
  PERFORM CHECK-RELATED-OBJECTS
  DECIDE FOR EVERY CONDITION
    WHEN #ES-MSG-NR NE 0
      PERFORM DATA-TO-LIST
    WHEN #EXIST AND NOTF-OWERWR NE 'Y'
      #ES-MSG-NR := 8855
      PERFORM DATA-TO-LIST
    WHEN #ES-MSG-NR = 0
      PERFORM COPY-BUNDLE
      PERFORM COPY-BUNDLE-REPORTS
    WHEN NONE IGNORE
  END-DECIDE
END-READ
*
END-SUBROUTINE /* LIST
*
************************************************************************
DEFINE SUBROUTINE SELECT-RECORD
************************************************************************
#SELECT := TRUE
DECIDE FOR EVERY CONDITION
  WHEN NOT(#NOBNSL.#REPORT = ' ' OR = '*')
    FNDNUM. FIND NUMBER BUNDLE-REPORT WITH BR-BUNDLE = BUNDLES.B-BUNDLE
    AND BR-REPNAME = #REPORT-S THRU #REPORT-E                         /*
    IF *NUMBER(FNDNUM.) = 0
      #SELECT := FALSE
    END-IF
  WHEN NOT (BUNDLES.B-MASTER-REPNAME = #MASTER-S THRU #MASTER-E)
    #SELECT := FALSE
  WHEN #NOBNSL.#COORD NE ' '
    IF BUNDLES.B-COORDINATOR-ID NE #NOBNSL.#COORD
      #SELECT := FALSE
    END-IF
  WHEN NONE IGNORE
END-DECIDE
*
END-SUBROUTINE /* SELECT-RECORD
*
************************************************************************
DEFINE SUBROUTINE DATA-TO-LIST
************************************************************************
ADD 1 TO #I2
IF #I2 > #IMAX
  ES-NEXT-KEY-PARM(1) := BUNDLES.B-BUNDLE
  ES-NUMBER := #IMAX
  RESET ES-EOF
  ESCAPE BOTTOM
END-IF
PERFORM GET-MSG-TXT
NOTF2-MSG(#I2) := ES-MSG-TXT
NOTF2-OBJECT(#I2) := BUNDLES.B-BUNDLE
ES-NUMBER := #I2
*
END-SUBROUTINE /* DATA-TO-LIST
*
************************************************************************
DEFINE SUBROUTINE SET-LOGICAL-FILE                         /* CF1 +
************************************************************************
DECIDE FOR FIRST CONDITION
  WHEN NOTF-DBID-TO < 1
    #ES-MSG-NR := 0635                      /* Invalid DBID
    #ES-MSG-FIELD-NAME := 'DBID-TO'
  WHEN NOTF-FNR-TO < 1
    #ES-MSG-NR :=0636                       /* Invalid FNR
    #ES-MSG-FIELD-NAME := 'FNR-TO'
  WHEN NOTF-FNR-TO  = NOTF-FNR-FROM AND NOTF-DBID-TO = NOTF-DBID-FROM
    #ES-MSG-NR := 4004   /* Source and Target env must be different
    #ES-MSG-FIELD-NAME := 'DBID-TO'
  WHEN NONE
    /*
    /* Verify if NOM DBID/FNR are valid
    #FUNC := 'S'
    #LFILE-NEWDBID := NOTF-DBID-TO
    #LFILE-NEWFILE := NOTF-FNR-TO
    CALLNAT 'XXVNOM-N' #FUNC #LFILE #LFILE-NEWDBID #LFILE-NEWFILE
      #LFILE-OLDDBID #LFILE-OLDFILE
      #MESSAGE #ERRORNUMBER
    IF #ERRORNUMBER NE 0
      #ES-MSG-NR := 4005        /* Specified File is not a NOM-File
      #ES-MSG-FIELD-NAME := 'DBID-TO'
      IF #ERRORNUMBER = 3 OR= 4  /* LFILE was switched
        PERFORM SWITCH-BACK-LFILE
      END-IF
    ELSE
      CALLNAT 'RMIGCHKU' ES-USER #ES-MSG-NR
      IF #ES-MSG-NR NE 0
        #ES-MSG-TXT := ES-USER
        PERFORM SWITCH-BACK-LFILE
      END-IF
    END-IF
END-DECIDE
*
END-SUBROUTINE /* SET-LOGICAL-FILE
*
************************************************************************
DEFINE SUBROUTINE SWITCH-BACK-LFILE
************************************************************************
IF *MACHINE-CLASS NE 'PC'
  /*
  /* Set LFILE to former values (OLD...)
  IF #LFILE-OLDDBID = 0 AND #LFILE-OLDFILE = 0
    NAT23008-PARA.FUNCTION := 'R'    /* Reset LFILE
  ELSE
    NAT23008-PARA.FUNCTION := 'S'    /* Set back to former values
  END-IF
  /*
  NAT23008-PARA.LFILE-NR := 158
  NAT23008-PARA.DBID     := #LFILE-OLDDBID
  NAT23008-PARA.FNR      := #LFILE-OLDFILE
  CALLNAT 'NAT23008' NAT23008-PARA
  /*
  IF NAT23008-PARA.RET_CODE NE 0
    COMPRESS 'NAT23008 response code:' NAT23008-PARA.RET_CODE
      INTO #MESSAGE
    #ES-MSG-NR := 4008       /* Refresh LFile error occured
    #ES-MSG-TXT := NAT23008-PARA.RET_CODE
  END-IF
END-IF
*
END-SUBROUTINE /* SWITCH-BACK-LFILE
*
************************************************************************
DEFINE SUBROUTINE COPY-BUNDLE
************************************************************************
FT. FIND MIGRATE-BUNDLES WITH B-BUNDLE = BUNDLES.B-BUNDLE
  IF NO RECORDS FOUND
    ENTER
  END-NOREC
  MOVE BY NAME BUNDLES TO MIGRATE-BUNDLES
  IF *NUMBER (FT.) = 0
    STORE MIGRATE-BUNDLES
  ELSE
    IF NOTF-OWERWR = 'Y'
      UPDATE (FT.)
    ELSE
      BACKOUT TRANSACTION
      ESCAPE BOTTOM(FT.)
    END-IF
  END-IF
/* add grants to migrated bundle
  #GR-TYPE   := 'B'
  #GR-USERID := ES-USER
  #GR-OBJECT := BUNDLES.B-BUNDLE
  FNDG. FIND MIGRATE-GRANTS WITH GR-SUPER = #GR-SUPER
    IF NO RECORDS FOUND
      MIGRATE-GRANTS.GR-USERID := ES-USER
      MIGRATE-GRANTS.GR-OBJECT-TYPE := 'B'
      MIGRATE-GRANTS.GR-OBJECT-NAME := BUNDLES.B-BUNDLE
    END-NOREC
    MIGRATE-GRANTS.GR-OPTION(*) := 'Y'
    IF *NUMBER(FNDG.) = 0
      STORE MIGRATE-GRANTS
    ELSE
      UPDATE
    END-IF
    ADD 1 TO #ET-COUNT
    IF #ET-COUNT GE 50
      RESET #ET-COUNT
      END TRANSACTION
    END-IF
  END-FIND
/* copy aythorization if confirm
  IF NOTF-AUTH = 'Y'
    #GRANT-NAME:= BUNDLES.B-BUNDLE
    COPG. FIND GRANTS WITH GR-TYPE-NAME = #GR-TYPE-NAME
      #GR-USERID := GRANTS.GR-USERID
      COPM. FIND MIGRATE-GRANTS WITH GR-SUPER = #GR-SUPER
        IF NO RECORDS FOUND
          ENTER
        END-NOREC
        MOVE BY NAME GRANTS TO MIGRATE-GRANTS
        IF *NUMBER (COPM.) = 0
          STORE MIGRATE-GRANTS
        ELSE
          UPDATE
        END-IF
        ADD 1 TO #ET-COUNT
        IF #ET-COUNT GE 50
          RESET #ET-COUNT
          END TRANSACTION
        END-IF
      END-FIND
    END-FIND
  END-IF
END-FIND
END TRANSACTION
*
END-SUBROUTINE /* COPY-BUNDLE
*
************************************************************************
DEFINE SUBROUTINE CHECK-RELATED-OBJECTS
************************************************************************
RESET #ES-MSG-NR
DECIDE FOR EVERY CONDITION
  WHEN #ES-MSG-NR = 0
    RESET #ES-MSG-TXT
    FNDU. FIND NUMBER MIGRATE-USERS
      WITH USER-ID = BUNDLES.B-COORDINATOR-ID
    IF *NUMBER (FNDU.) = 0
      #ES-MSG-NR := 2129 /* Coordinator-ID :1: not exsit in Target DB
      #ES-MSG-TXT := BUNDLES.B-COORDINATOR-ID
    END-IF
  WHEN #ES-MSG-NR = 0
    RESET #ES-MSG-TXT
    IF BUNDLES.C*B-PRINT-LIST > 0
      FORP. FOR #I = 1 TO BUNDLES.C*B-PRINT-LIST
        #PRINTER := BUNDLES.B-PRINT-LIST (#I)
        IF NOT(#PRINTER = ' ' OR = 'DUMMY')
          FNDP. FIND NUMBER MIGRATE-PRINTERS WITH P-ID = #PRINTER
          IF *NUMBER (FNDP.) = 0
            #ES-MSG-NR := 2130 /* Printer :1: not defined in target DB
            #ES-MSG-TXT := #PRINTER
            ESCAPE BOTTOM (FORP.)
          END-IF
        END-IF
      END-FOR
    END-IF
  WHEN #ES-MSG-NR = 0 AND NOTF-AUTH = 'Y'
    RESET #ES-MSG-TXT
    #GRANT-NAME := BUNDLES.B-BUNDLE
    CHKG.
    FIND GRANTS WITH GR-TYPE-NAME = #GR-TYPE-NAME
      IF GR-USERID(CHKG.) = 'PUBLIC'
        ESCAPE TOP
      END-IF
      FNRU.
      FIND NUMBER MIGRATE-USERS WITH USER-ID = GR-USERID(CHKG.)
      IF *NUMBER(FNRU.) = 0
        FNRD.
        FIND NUMBER MIGRATE-LISTS WITH D-LIST-NAME = GR-USERID(CHKG.)
        IF *NUMBER(FNRD.) = 0
          #ES-MSG-NR := 2131  /* Auth user :1: not def in target DB
          #ES-MSG-TXT := GRANTS.GR-USERID
          ESCAPE BOTTOM
        END-IF
      END-IF
    END-FIND
  WHEN NONE IGNORE
END-DECIDE
/* find bundle in target environment
FNDT. FIND NUMBER MIGRATE-BUNDLES WITH B-BUNDLE = BUNDLES.B-BUNDLE
IF *NUMBER(FNDT.) NE 0
  #EXIST := TRUE
ELSE
  RESET #EXIST
END-IF
*
END-SUBROUTINE /* CHECK-RELATED-OBJECTS
*
************************************************************************
DEFINE SUBROUTINE COPY-BUNDLE-REPORTS
************************************************************************
/* delete related reports in target env for all bundle
FIND MIGRATE-BUNDLE-REPORT WITH BR-BUNDLE = BUNDLES.B-BUNDLE
  DELETE
  ADD 1 TO #ET-COUNT
  IF #ET-COUNT >= 50
    END TRANSACTION
  END-IF
END-FIND
/*
FBR. FIND BUNDLE-REPORT WITH BR-BUNDLE = BUNDLES.B-BUNDLE
  ACCEPT IF BR-REPNAME = #REPORT-S THRU #REPORT-E
  MOVE BY NAME BUNDLE-REPORT TO MIGRATE-BUNDLE-REPORT
  STORE MIGRATE-BUNDLE-REPORT
END-FIND
END TRANSACTION
*
END-SUBROUTINE /* COPY-BUNDLE-REPORTS
*
************************************************************************
DEFINE SUBROUTINE GET-MSG-TXT
************************************************************************
RESET SHORT-MSG LONG-MSG(*)
VERSION := 0
NADA2000.OBJECT-KIND := 'U'
NADA2000.ERROR-NUMBER := #ES-MSG-NR
NADA2000.OPT-INSERT-DYN := FALSE
NADA2000.OPT-LANGUAGE := ES-LANGUAGE
/*NADA2000.LIBRARY := SUBSTR(ES-APP-SERVER-LIBRARY,1,6)
NADA2000.LIBRARY := ES-APP-SERVER-LIBRARY
CALLNAT 'NATA2000' NADA2000 NATA2000.EXTENDED-PARMS NAD-MSG NAD-FLD
ES-MSG-NR  := #ES-MSG-NR
ES-MSG-TXT := SHORT-MSG
EXAMINE ES-MSG-TXT FOR #ES-MSG-PREF DELETE
EXAMINE ES-MSG-TXT FOR ':1:' REPLACE #ES-MSG-TXT
*
END-SUBROUTINE /* GET-MSG-TXT
*
END
