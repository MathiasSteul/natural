* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* MAP2: PROTOTYPE VERSION 820 --- CREATED BY NAT 0802030000 ---
* INPUT USING MAP 'XXXXXXXX'
*     #CODE
DEFINE DATA PARAMETER
1 #CODE (A001)
END-DEFINE
FORMAT PS=020 LS=044 ZP=OFF SG=OFF KD=OFF IP=OFF
* MAP2: MAP PROFILES *****************************        410***********
* .TTAAAMMOO   TU6ID I N D I D I        ?_)^&:+(   00000               *
* 020043        N0NNUCN             X        01 SYSPROF NLH          1 *
************************************************************************
INPUT          (     IP=OFF                                           /*
                                                                       )
 011T 'User Type'(YEI)
/
/
 002T 'A user may be defined as an'(TU)
 030T 'Administrator,'(YEI)
/
 002T 'who can perform everything in the system,'(TU)
/
 002T 'as a'(TU)
 007T 'General user,'(YEI)
 021T 'who will only see the'(TU)
/
 002T 'printouts he/she has explicit access to,'(TU)
/
 002T 'as an'(TU)
 008T 'Operator,'(YEI)
 018T 'who has the same rights as'(TU)
/
 002T 'a general user with additional rights to'(TU)
/
 002T 'maintain objects in the printout queue,'(TU)
/
 002T 'or as an'(TU)
 011T 'Printer-associated user,'(YEI)
 036T 'who is'(TU)
/
 002T 'allowed only to show and maintain'(TU)
/
 002T 'printouts associated with printers the'(TU)
/
 002T 'user has access to.'(TU)
/
/
 011T 'A'(YEI)
 013T 'Administrator'(TU)
/
 011T 'G'(YEI)
 013T 'General user'(TU)
/
 011T 'O'(YEI)
 013T 'Operator'(TU)
/
 011T 'P'(YEI)
 013T 'Printer associated user'(TU)
/
/
 011T 'Select =>'(TU)
 021T #CODE  (AD=MILT'_' ) /*.99U001 A001 .
* MAP2: VALIDATION *****************************************************
RULEVAR F00#CODE
INCDIC                                 ;
IF NOT (& = ' ' OR = 'G' OR = 'A' OR = 'O' OR = 'P')
  REINPUT *0007 ALARM
END-IF
SET CONTROL 'Q'
* MAP2: END OF MAP *****************************************************
END
