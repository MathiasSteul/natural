DEFINE SUBROUTINE DELETE-SOURCES
************************************************************************
PERFORM READ-CLEANUP-DEFAULTS
IF CLEANUP-IDENTIFIER = 'CLEAN' AND CLEANUP-ACTIVE-NOW
  ESCAPE ROUTINE
END-IF
CALLNAT 'RMNPRUSR' G-MONITOR-NODE G-NPR-USERID
  G-NATRP-ERC G-NATRP-ERT #TRACING
G-NPR-CURRENT-USERID := G-NPR-USERID
CALLNAT 'RMSETSTN' #EQU-DELETE-SOURCES +NOD-LOCAL-NODE G-NATRP-DBID
  G-NATRP-FNR G-SHUTDOWN G-TASK-NUMBER
*
END TRANSACTION
IF G-SHUTDOWN
  ESCAPE ROUTINE
END-IF
FETCH RETURN 'RMSRDL' /* Process cleanup orders
*
IF NOT G-SHUTDOWN
  #LINE := *LINE
  CALLNAT 'RMSETSTN' #EQU-MONITOR +NOD-LOCAL-NODE G-NATRP-DBID
    G-NATRP-FNR G-SHUTDOWN G-TASK-NUMBER 1X #LINE
END-IF
END TRANSACTION
*
END-SUBROUTINE /* DELETE-SOURCES
*
************************************************************************
DEFINE SUBROUTINE READ-CLEANUP-DEFAULTS
************************************************************************
FIND CLEANUP-TASK WITH M-MONITOR-ID = 'SYNCHCLN'
END-FIND
*
END-SUBROUTINE /* READ-CLEANUP-DEFAULTS
*
************************************************************************
DEFINE SUBROUTINE UPDATE-CLEANUP-DEFAULTS
************************************************************************
FIND CLEANUP-TASK WITH M-MONITOR-ID = 'SYNCHCLN'
  CLEANUP-IDENTIFIER    := 'CLEAN'
  REPORT-PROCESSING-NOW := #REPORT-PROCESSING-NOW
  UPDATE
  END TRANSACTION
END-FIND
*
END-SUBROUTINE /* UPDATE-CLEANUP-DEFAULTS
*
************************************************************************
DEFINE SUBROUTINE POST-CLEANUP-TASK
************************************************************************
#EVENT-PREFIX := 'NCLN'
#EVENT-DBID   := G-NATRP-DBID
#EVENT-FNR    := G-NATRP-FNR
CALLNAT 'RMEVNT-N' +NOD-LOCAL-NODE #EVENT-NAME 'POST    '
  G-WAIT-FACTOR G-NATRP-ERC G-NATRP-ERT #EVENT-MESSAGE
END TRANSACTION
*
END-SUBROUTINE /* POST-CLEANUP-TASK
*
************************************************************************
DEFINE SUBROUTINE WAIT-FOR-NEXT-CYCLE
************************************************************************
CALLNAT 'RMSETSTN' #EQU-IDLE +NOD-LOCAL-NODE G-NATRP-DBID
  G-NATRP-FNR G-SHUTDOWN G-TASK-NUMBER
END TRANSACTION
IF G-SHUTDOWN
  ESCAPE ROUTINE
END-IF
*
RMSETTIM.FUNCTION := 'S'
PERFORM RMSETTIM-SETTIME RMSETTIM
IF NOT #MF   /* NOMALL-1019 in
  IF G-CYCLE-WAS-IDLE
    IF +NOWAIT > 10
      ADD G-WAIT-INCREMENT TO G-WAIT-FACTOR
      IF G-WAIT-FACTOR > G-WAIT-MAXIMUM
        G-WAIT-FACTOR := G-WAIT-MAXIMUM
      END-IF
    ELSE
      ADD 1 TO +NOWAIT
    END-IF
  ELSE
    G-WAIT-FACTOR := G-WAIT-MINIMUM
    RESET +NOWAIT
  END-IF
  IF G-WAIT-FACTOR = 0
    G-WAIT-FACTOR := 30
  END-IF
  IF NOT G-CYCLE-WAS-IDLE OR +NOWAIT < 11
    G-CYCLE-WAS-IDLE := TRUE
    IF #TRACING
      COMPRESS '**********************************' TO G-TRACE-MSG
      PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
      COMPRESS 'Monitor continues without waiting.' TO G-TRACE-MSG
      PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
      COMPRESS '**********************************' TO G-TRACE-MSG
      PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
    END-IF
    END TRANSACTION
    ESCAPE ROUTINE
  END-IF
ELSE
  IF G-CYCLE-WAS-IDLE
    ADD G-WAIT-INCREMENT TO G-WAIT-FACTOR
    IF G-WAIT-FACTOR > G-WAIT-MAXIMUM
      G-WAIT-FACTOR := G-WAIT-MAXIMUM
    END-IF
  ELSE
    G-WAIT-FACTOR := G-WAIT-MINIMUM
  END-IF
  IF G-WAIT-FACTOR = 0
    G-WAIT-FACTOR := 30
  END-IF
  G-CYCLE-WAS-IDLE := TRUE
END-IF
RMTASK-P.FUNCTION       := 'E'
RMTASK-P.SUBTASK-NUMBER := G-TASK-NUMBER
#LINE                   := *LINE
CALLNAT 'RMTASKID' RMTASK-P #TRACING #LINE
#EVENT-NAME   := RMTASK-P.TASK-ID
*
RESET #EVENT-MESSAGE
IF #TRACING
  COMPRESS '***********************'  TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  COMPRESS 'Monitor waiting' G-WAIT-FACTOR 'sec.' TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  COMPRESS '***********************'  TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
CALLNAT 'RMSETSTN' #EQU-IDLE +NOD-LOCAL-NODE G-NATRP-DBID
  G-NATRP-FNR G-SHUTDOWN G-TASK-NUMBER
*
END TRANSACTION
CALLNAT 'RMEVNT-N' +NOD-LOCAL-NODE #EVENT-NAME 'WAIT    '
  G-WAIT-FACTOR G-NATRP-ERC G-NATRP-ERT #EVENT-MESSAGE
END TRANSACTION
RMSETTIM.FUNCTION := 'G'
PERFORM RMSETTIM-SETTIME RMSETTIM
IF RMSETTIM.TIME / 10 < G-WAIT-FACTOR /* wake monitor occurred
  G-WAIT-FACTOR := G-WAIT-MINIMUM
END-IF
*
IF G-NATRP-ERC = 999
  PRINT NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY-MM-DD' 'HH:II:SS:T)
    G-NATRP-ERT /*SU6 (AL=79)
  PRINT NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY-MM-DD' 'HH:II:SS:T)
    'Monitor goes down'
  IF #MF
    FETCH RETURN 'RMRDCDSP'  /* Display RDC statistics in batch
    FETCH RETURN 'RDCDISIO'
  END-IF
  STACK TOP COMMAND 'FIN'
  STACK TOP COMMAND 'LASTMSG'
  STOP
END-IF
IF #EVENT-MESSAGE = 'TRACEON'
  PERFORM RMGTRACE-GET-SETTINGS #TRACING
  IF G-TRACE = 0
    G-TRACE     := 100
    #TRACING    := TRUE
    G-TRACE-SET := 'SCAN COPY CREATE PRINT'
  END-IF
  G-TRACE-MSG := '1539'
  PERFORM XXRLOG-WRITE-LOG 'W' G-TRACE-MSG
ELSE
  IF #EVENT-MESSAGE = 'TRACEOFF'
    RESET G-TRACE G-TRACE-SET #TRACING
    G-TRACE-MSG := '1540'
    PERFORM XXRLOG-WRITE-LOG 'W' G-TRACE-MSG
  END-IF
END-IF
*
END-SUBROUTINE /* WAIT-FOR-NEXT-CYCLE
*
************************************************************************
DEFINE SUBROUTINE WRITE-STATISTICS /*SU9 UNUSED ÜÜ
************************************************************************
RMSETTIM.FUNCTION := 'G'
PERFORM RMSETTIM-SETTIME RMSETTIM
/*SU9 IF NOT +O4I OR #STATISTICS-ERROR ESCAPE ROUTINE END-IF
REDUCE ARRAY SS-VALUE TO 0
EXPAND ARRAY SS-VALUE TO (1:100)
REDUCE ARRAY SS-TITLE TO 0
EXPAND ARRAY SS-TITLE TO (1:100)
RESET NOMSTCSP
NOMSTCSP.FUNCTION        := 'A' /* cumulate it (add function)
NOMSTCSP.SS-ITEM         := 'MON-TIME'
SS-VALUE (G-TASK-NUMBER) := RMSETTIM.TIME
COMPRESS '4351' G-TASK-NUMBER TO #TXT
CALLNAT 'RSUBMSGN' #TXT
SS-TITLE (G-TASK-NUMBER) := #TXT
PERFORM CALL-STATISTICS
IF #STATISTICS-ERROR
  ESCAPE ROUTINE
END-IF
FNDORD. FIND NUMBER ORDERS WITH OD-TYPE-TIME GE #OD-FROM
AND  OD-TYPE-TIME LT #OD-TO                                           /*
RESET NOMSTCSP SS-VALUE (*) SS-TITLE (*)
NOMSTCSP.FUNCTION := 'W' /* update it
NOMSTCSP.SS-ITEM  := 'MON-ORDERS'
SS-VALUE (1)      := *NUMBER(FNDORD.)
#TXT              := '4352'
CALLNAT 'RSUBMSGN' #TXT
SS-TITLE (1)  := #TXT
PERFORM CALL-STATISTICS
IF #STATISTICS-ERROR
  ESCAPE ROUTINE
END-IF
IF G-TASK-NUMBER = 1
  RMTASK-P.TASK-ID := F#MONITOR-TASK-ID1 (<>)
  FIND MONITOR WITH M-MONITOR-ID = RMTASK-P.TASK-ID
    REDUCE ARRAY SS-VALUE TO 0
    EXPAND ARRAY SS-VALUE TO (1:100)
    REDUCE ARRAY SS-TITLE TO 0
    EXPAND ARRAY SS-TITLE TO (1:100)
    NOMSTCSP.FUNCTION := 'W'
    NOMSTCSP.SS-ITEM  := 'MON-WAITTIME'
    SS-VALUE (1)      := M-WAIT-CURRENT
    #TXT              := '4353'
    CALLNAT 'RSUBMSGN' #TXT
    SS-TITLE (1)  := #TXT
    PERFORM CALL-STATISTICS
    IF #STATISTICS-ERROR
      ESCAPE ROUTINE
    END-IF
    RESET NOMSTCSP SS-VALUE (*) SS-TITLE (*)
    NOMSTCSP.FUNCTION := 'W'
    NOMSTCSP.SS-ITEM  := 'MON-PROFILE'
    SS-VALUE (1)      := 'Monitor'
    FOR #I = 1 TO 5
      COMPRESS  '4354' #I TO #TXT
      CALLNAT 'RSUBMSGN' #TXT
      SS-TITLE (#I)  := #TXT
      IF M-SPOOL-QUEUE = #I
        #TXT := 4384               /* scan spool queue
        PERFORM ADD-TEXT
      END-IF
      IF M-COPY-SOURCE = #I
        #TXT := 4381               /* copy source
        PERFORM ADD-TEXT
      END-IF
      IF M-CREATE-REPORTS = #I
        #TXT := 4382               /* create reports
        PERFORM ADD-TEXT
      END-IF
      IF M-MANAGE-PRINTOUTS = #I
        #TXT := 4383               /* manage printouts
        PERFORM ADD-TEXT
      END-IF
      IF *LENGTH(SS-VALUE (#I)) NE 0 AND SUBSTR(SS-VALUE (#I),1,2)='; '
        EXAMINE SS-VALUE (#I) FOR '; ' AND DELETE FIRST
      END-IF
      IF *LENGTH(SS-VALUE (#I)) NE 0 AND SUBSTR (SS-VALUE (#I),1,1)=' '
        EXAMINE SS-VALUE (#I) FOR ' ' AND DELETE FIRST
      END-IF
      IF *LENGTH(SS-VALUE (#I)) NE 0 AND SUBSTR (SS-VALUE (#I),1,1)=';'
        EXAMINE SS-VALUE (#I) FOR ';' AND DELETE FIRST
      END-IF
      EXAMINE SS-VALUE (#I) FOR ' ; ' REPLACE WITH '; '
    END-FOR
    PERFORM CALL-STATISTICS
    IF #STATISTICS-ERROR
      ESCAPE ROUTINE
    END-IF
  END-FIND
ELSE
  MOVE G-TASK-NUMBER TO SUBSTR (#MON-ID,5)
  FIND MONITOR WITH M-MONITOR-ID = #MON-ID
    RESET NOMSTCSP SS-VALUE (*) SS-TITLE (*)
    NOMSTCSP.FUNCTION        := 'W'
    NOMSTCSP.SS-ITEM         := 'MON-WAITTIME'
    SS-VALUE (G-TASK-NUMBER) := M-WAIT-CURRENT
    #TXT := '4353'
    CALLNAT 'RSUBMSGN' #TXT
    SS-TITLE (1)  := #TXT
    PERFORM CALL-STATISTICS
    IF #STATISTICS-ERROR
      ESCAPE ROUTINE
    END-IF
  END-FIND
END-IF
*
END TRANSACTION
*
END-SUBROUTINE /* WRITE-STATISTICS
*
************************************************************************
DEFINE SUBROUTINE ADD-TEXT
************************************************************************
CALLNAT 'RSUBMSGN' #TXT
COMPRESS SS-VALUE (#I) '; ' #TXT TO SS-VALUE (#I) LEAVING NO
*
END-SUBROUTINE /* ADD-TEXT
*
************************************************************************
DEFINE SUBROUTINE CALL-STATISTICS
************************************************************************
IF NOT #STATISTICS-ERROR
  CALLNAT 'NOMSTCS' NOMSTCSP
  IF NOMSTCSP.ERC NE 0
    COMPRESS '4390' SS-ITEM NOMSTCSP.ERC TO LG-MSG
    PERFORM XXRLOG-WRITE-LOG 'W' LG-MSG
    RESET LG-FUNCTION /* restore old fashioned way.
    #STATISTICS-ERROR := TRUE
  END-IF
END-IF
*
END-SUBROUTINE /* CALL-STATISTICS
*
************************************************************************
DEFINE SUBROUTINE CLEANUP-STEPLIBS
************************************************************************
NAT00009-FUNCTION := 20 /* how many steplibs active?
CALLNAT 'RGETLIB'  NAT00009-LIBRARY
CALLNAT 'NAT00009' NAT00009-PARMS
IF NAT00009-NUMBER-ACTIVE > 1
  FOR #S = NAT00009-NUMBER-ACTIVE TO 2 STEP -1 /*scan from end of table
    NAT00009-FUNCTION      := 12
    NAT00009-CURRENT-INDEX := #S
    CALLNAT 'NAT00009' NAT00009-PARMS
    NAT00009-FUNCTION := 20
    CALLNAT 'NAT00009' NAT00009-PARMS     /* duplicate?
    IF NAT00009-CURRENT-INDEX LT #S AND NAT00009-CURRENT-INDEX > 0
      NAT00009-CURRENT-INDEX := #S
      NAT00009-FUNCTION      := 16   /* delete it from table
      CALLNAT 'NAT00009' NAT00009-PARMS
    END-IF
  END-FOR
END-IF
*
END-SUBROUTINE /* CLEANUP-STEPLIBS
*
************************************************************************
DEFINE SUBROUTINE CHECK-LICENCE /*SU6
************************************************************************
IF #TRACING
  COMPRESS 'Check licence for ''' PROD-NAME ''' version='
    PROD-VERSION 'limit=' EXP-LIMIT ' days' TO G-TRACE-MSG LEAVING NO
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END TRANSACTION
END-IF
* 1. call without SHOW-MESSAGE to get RC:
CALLNAT 'NAT51002' #NAT51002
IF (NOT (LC-ERC =0 OR=-2)) /*OR (LC-ERC =0 AND EXP-LIMIT GE EXP-DAYS)
  /* -2 Call is not implemented for this platform
  SHOW-MESSAGE := TRUE /*something wrong -> show msg
  CALLNAT 'NAT51002' #NAT51002
  COMPRESS NUMERIC 'The product license is invalid:' LC-ERT '(RC:'
    LC-ERC ')' TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'W' G-TRACE-MSG
  END TRANSACTION
/*PRINT NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
/*  G-TRACE-MSG
  CALLNAT 'XXCONTRM' 'E' G-TASK-NUMBER 5 G-TRACE-MSG #TRACING /*Email
  G-SHUTDOWN := TRUE
  FETCH 'RMCHKDWN'
  /*Terminate with MSG 5 (:1:)
END-IF
IF #TRACING OR (EXP-DAYS =0 THRU EXP-LIMIT) /* < 30 days(-1=unlimited)
  COMPRESS NUMERIC 'The product license will expire in' EXP-DAYS 'days.'
    TO G-TRACE-MSG
  IF EXP-LIMIT GE EXP-DAYS /*send email
    COMPRESS '>>>' G-TRACE-MSG '<<<' TO G-TRACE-MSG
    CALLNAT 'XXCONTRM' 'E' G-TASK-NUMBER 5 G-TRACE-MSG #TRACING /*Email
  END-IF
  PRINT NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY-MM-DD' 'HH:II:SS:T)
    G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'W' G-TRACE-MSG
  END TRANSACTION
END-IF
*
END-SUBROUTINE /* CHECK-LICENCE
*
*
************************************************************************
DEFINE SUBROUTINE CHECK-LICENCE-MF /*NKEW1
************************************************************************
*
RESET #MSG-LONG
IF #TRACING
  COMPRESS 'Check licence for ''' PROD-NAME ''' version='
    PROD-VERSION TO G-TRACE-MSG LEAVING NO
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END TRANSACTION
END-IF
*
IF  ( *NATVERS LE '09.02.00')
  COMPRESS '0040 Current Natural version is:' *NATVERS
    'No Licence Check will be performed due to lower version then'
    '09.02.03' TO G-TRACE-MSG
  PRINT G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'W' G-TRACE-MSG
  END TRANSACTION
* Variables for ZAP need to be known
* PERFORM TEST-IF-ZAP-APPLIED ZAP-NAME ZAP-IS-APPLIED
* NAT82003(SYSLIBS)
* ONLY ESCAPE IF ZAP-IS-APPLIED EQ FALSE
  ESCAPE ROUTINE
END-IF
* See NATURAL.V93.TEST.SRCE(NATMPP) for docu
CALL 'CMMPP' 'LICS' 'NOM  ' PRODUCT-VERSION
  '1       '
  MSGS(*)
LC-ERC  := RET('CMMPP')
IF ( LC-ERC EQ 0 )
  #M-STARTED := TRUE
  COMPRESS '0135' TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'W' G-TRACE-MSG
  ESCAPE ROUTINE
END-IF
*   0      License check was successful.                              *
*   4/8    Warning message has been issued. Product can continue.     *
*   12     License check failed, Error message has been issued.       *
*          Product must stop and cannot be used.                      *
*   16     Severe error occurred (during development only).           *
*                                                                     *
*   -1     Function LICS is not implemented in NATMPP.                *
*   -2     License module not found for specified product code.       *
IF LC-ERC NE 0
  MSGS. FOR ##REC-COUNT = 1 TO 10
    IF MSGS(##REC-COUNT) = ' '
      ESCAPE BOTTOM (MSGS.)
    END-IF
    COMPRESS 'NOM0040'
      MSGS(##REC-COUNT) TO G-TRACE-MSG
    PRINT G-TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'W' G-TRACE-MSG
    END TRANSACTION
*   Write a long message when multiple msgs are returned by cmmpp
*   If more then 4 just add look at trace for details
    COMPRESS ##REC-COUNT ':' TO #MSG-PREFIX LEAVING NO
    IF ##REC-COUNT EQ 4
      COMPRESS #MSG-LONG '!View trace' TO #MSG-LONG
    END-IF
    IF ##REC-COUNT LT 4
      COMPRESS #MSG-LONG 'MSG' #MSG-PREFIX G-TRACE-MSG TO #MSG-LONG
    END-IF
  END-FOR
  IF LC-ERC NE 12 AND LC-ERC GT 0
    #M-STARTED := TRUE
    CALLNAT 'XXCONTRM' 'E' G-TASK-NUMBER 136 #MSG-LONG #TRACING
    COMPRESS '0136' TO G-TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'W' G-TRACE-MSG
    ESCAPE ROUTINE
  END-IF
  IF LC-ERC = -2
    COMPRESS NUMERIC '0040 License module not found for specified'
      'product code: NOM' TO G-TRACE-MSG
    PRINT G-TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'W' G-TRACE-MSG
    END TRANSACTION
    LC-ERC := LC-ERC * -1
    COMPRESS 'NOM0040 License module not found for specified'
      'product code: NOM RC minus' LC-ERC   TO G-TRACE-MSG
    CALLNAT 'XXCONTRM' 'E' G-TASK-NUMBER 137 G-TRACE-MSG #TRACING
  ELSE
    CALLNAT 'XXCONTRM' 'E' G-TASK-NUMBER 137 #MSG-LONG #TRACING
  END-IF
  COMPRESS NUMERIC '0137' TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'W' G-TRACE-MSG
  IF NOT #M-STARTED /* If monitor is already running don't shutdown
    G-SHUTDOWN := TRUE
  END-IF
END-IF
*
END-SUBROUTINE /* CHECK-LICENCE-MF
************************************************************************
END
