DEFINE SUBROUTINE CREATE-REPORTS-BUNDLES
* creation of active reports and processing of open bundles is handled
* as a unit. Shutdown is not allowed within this unit
************************************************************************
CALLNAT 'RMNPRUSR' G-MONITOR-NODE G-NPR-USERID
  G-NATRP-ERC G-NATRP-ERT #TRACING
G-NPR-CURRENT-USERID := G-NPR-USERID
CALLNAT 'RMSETSTN' #EQU-CREATE-AR +NOD-LOCAL-NODE G-NATRP-DBID
  G-NATRP-FNR G-SHUTDOWN G-TASK-NUMBER
END TRANSACTION
IF G-SHUTDOWN
  ESCAPE ROUTINE
END-IF
*
FETCH RETURN 'RMPROCRP'  /*   Process Source and create active Reports
*
IF NOT G-SHUTDOWN
  #LINE := *LINE
  CALLNAT 'RMSETSTN' #EQU-MONITOR +NOD-LOCAL-NODE G-NATRP-DBID
    G-NATRP-FNR G-SHUTDOWN G-TASK-NUMBER 1X #LINE
END-IF
CALLNAT 'RMNPRUSR' G-MONITOR-NODE G-NPR-USERID
  G-NATRP-ERC G-NATRP-ERT #TRACING
G-NPR-CURRENT-USERID := G-NPR-USERID
END TRANSACTION
*
CALLNAT 'RMSETSTN' #EQU-PROCBUN +NOD-LOCAL-NODE G-NATRP-DBID
  G-NATRP-FNR G-SHUTDOWN G-TASK-NUMBER
END TRANSACTION
FETCH RETURN 'RMPROCBU'
*
IF NOT G-SHUTDOWN
  #LINE := *LINE
  CALLNAT 'RMSETSTN' #EQU-MONITOR +NOD-LOCAL-NODE G-NATRP-DBID
    G-NATRP-FNR G-SHUTDOWN G-TASK-NUMBER 1X #LINE
END-IF
END TRANSACTION
*
END-SUBROUTINE /* CREATE-REPORTS-BUNDLES
*
