* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* -----------------------------------------------------------------
* Subprogram    NOUSXU-N
* Version       2.2.1
* Function      NOM API  XREF of Users
* Input Keys:   ES-KEY-PARM(1) - Userid
*
*
* Maintenance:
* XSETGGR  2002-09-10   created
* --------------------------------------------------------------------
DEFINE DATA
  PARAMETER USING ESMCNT-A
  PARAMETER USING ESMINP-A
  PARAMETER USING ESMWORKA
  PARAMETER USING NOUSXU-A
  LOCAL
    1 GR VIEW OF NRM-GRANTS
      2 GR-OBJECT-TYPE
      2 GR-USERID
      2 GR-OBJECT-NAME
    1 RP VIEW OF NRM-REPORTS-NEW
      2 R-REPNAME
      2 R-DESC
    1 DL VIEW OF NRM-DISTRIBUTION-LIST
      2 D-LIST-NAME
      2 D-LIST-DESC
    1 BN VIEW OF NRM-BUNDLES
      2 B-BUNDLE
      2 B-DESC
    1 #IMAX           (I4) CONST <336>
    1 #I              (I4)
    1 #GR-SUPER       (A34)
    1 REDEFINE #GR-SUPER
      2 #TYPE         (A1)
      2 #USERID       (A8)
      2 #OBJ-NAME     (A25)
    1 #J              (I4)
    1 #J1             (I4)
    1 #ISN            (N10)
    1 REDEFINE #ISN
      2 #ISN-A        (A10)
    1 #GR-TYPES       (A1/4) INIT <'R','B','P','L'>
END-DEFINE
* --------------------------------------------------------------------
RESET ES-RC NOXU-NUMBER(*)
ES-EOF := 'X'
#USERID := ES-KEY-PARM(1)
*
IF ES-NEXT-KEY-PARM(1) NE ' '
  #J1 := VAL(ES-NEXT-KEY-PARM(1))
  DECIDE ON FIRST VALUE OF #J1
    VALUE 1 : 4
      #GR-SUPER.#TYPE := #GR-TYPES(#J1)
      #GR-SUPER.#USERID := #USERID
      #GR-SUPER.#OBJ-NAME := ES-NEXT-KEY-PARM(2)
    VALUE 5 : 7
      #ISN-A := ES-NEXT-KEY-PARM(2)
    NONE VALUE IGNORE
   END-DECIDE
ELSE
  #J1 := 1
  #GR-SUPER.#TYPE := 'R'
  #GR-SUPER.#USERID := #USERID
  #GR-SUPER.#OBJ-NAME := H'00'
END-IF
FOR #J = #J1 TO 7
  DECIDE ON FIRST VALUE OF #J
    VALUE 1 : 4
      RGR. READ GR WITH GR-SUPER = #GR-SUPER
        IF GR-OBJECT-TYPE NE #GR-SUPER.#TYPE OR
           GR-USERID NE #GR-SUPER.#USERID
          ESCAPE BOTTOM (RGR.)
        END-IF
        #I := #I + 1
        IF #I > #IMAX
          ES-EOF := ' '
          ES-NEXT-KEY-PARM(1) := #J
          ES-NEXT-KEY-PARM(2) := GR-OBJECT-NAME
          ESCAPE ROUTINE
        ELSE
          NOXU-NAME(#I)   := GR-OBJECT-NAME
          NOXU-NUMBER(#J) := NOXU-NUMBER(#J) + 1
        END-IF
      END-READ
      IF #J < 4
        #GR-SUPER.#TYPE := #GR-TYPES(#J+1)
        #GR-SUPER.#OBJ-NAME := H'00'
      END-IF
    VALUE 5
      FRP. FIND RP WITH R-NATRPT-DIST = #USERID
        ACCEPT IF #ISN = 0 OR #ISN = *ISN(FRP.)
        RESET #ISN
        #I := #I + 1
        PERFORM ADD-TO-LIST
      END-FIND
    VALUE 6
     FBN. FIND BN WITH B-COORDINATOR-ID = #USERID
        ACCEPT IF #ISN = 0 OR #ISN = *ISN(FBN.)
        RESET #ISN
        #I := #I + 1
        PERFORM ADD-TO-LIST
      END-FIND
    VALUE 7
      FDL. FIND DL WITH D-USER-LIST = #USERID
        ACCEPT IF #ISN = 0 OR #ISN = *ISN(FDL.)
        RESET #ISN
        #I := #I + 1
        PERFORM ADD-TO-LIST
      END-FIND
    NONE VALUE IGNORE
  END-DECIDE
END-FOR
* -----------------------------------------------------------------
DEFINE SUBROUTINE ADD-TO-LIST
IF #I > #IMAX
  ES-EOF := ' '
  ES-NEXT-KEY-PARM(1) := #J
  DECIDE ON FIRST VALUE OF #J
     VALUE 5
      #ISN := *ISN(FRP.)
    VALUE 6
      #ISN := *ISN(FBN.)
    VALUE 7
      #ISN := *ISN(FDL.)
    NONE VALUE IGNORE
  END-DECIDE
  ES-NEXT-KEY-PARM(2) := #ISN-A
  ESCAPE ROUTINE
ELSE
  DECIDE ON FIRST VALUE OF #J
    VALUE 5
      NOXU-OBJ-NAME(#I) := RP.R-REPNAME
      NOXU-OBJ-DESC(#I) := RP.R-DESC
    VALUE 6
      NOXU-OBJ-NAME(#I) := BN.B-BUNDLE
      NOXU-OBJ-DESC(#I) := BN.B-DESC
    VALUE 7
      NOXU-OBJ-NAME(#I) := DL.D-LIST-NAME
      NOXU-OBJ-DESC(#I) := DL.D-LIST-DESC
    NONE VALUE IGNORE
  END-DECIDE
  NOXU-NUMBER(#J) := NOXU-NUMBER(#J) + 1
END-IF
END-SUBROUTINE
* --------------------------------------------------------------------
END
