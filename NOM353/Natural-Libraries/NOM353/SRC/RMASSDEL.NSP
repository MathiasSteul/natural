* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    RMASSDEL
* Version   2.1
* Function  Mass deletion of reports/bundles/active reports/active
*           bundles
*
* Note: Since NOMALL-2491 RMASSDEL and related modules are replaced by
* adapted RNMASSDE (and more)Ü The old modules will be kept for QE with
* *USER NATQA5 (compare NRMCPR). Especailly maps MUST NOT be changed for
* compatibility with a lot of test recordingsÜ
*
* Maintenance
* uuu yy-mm-dd s(999999)        ...
* sju 00-08-21 CE 7465          created
* XSETHZ 2003-04-10 s(202763)   confirm deletion of archived reports
* fhi    2003-06-25 s(202763a)  check for field already in first INPUT
*                               QE complained about 2nd input step.
* fhi    2016-06-09 NOMALL-1884 Aline program with documentation
* SU1    2016-08-01 NOMALL-1518 NOM3.5 deactivate opt.Compiler
* BLI1   2024-02-05 NOMALL-2661 Info about usage of MASSDEL modules
* ----------------------------------------------------------------------
DEFINE DATA GLOBAL USING  NRM-GL
* -----------------------------LDA's------------------------------------
LOCAL USING RPFK---L
LOCAL USING RLOG-L
LOCAL USING XXGMSG-A
* -----------------------------local Variables--------------------------
LOCAL
1 CV-MAP                             (C) INIT < (AD=I CD=NE)>
1 L-HEADER                           (A78)
1 L-OBJECT-TYPE                      (A2)
1 L-OBJECT-PREFIX                    (A25)
1 L-OBJECT-MASK                      (A25)
1 L-WILDCARD                         (A1) INIT <'*'>
1 L-MASK-CHAR                        (A1) INIT <'?'>
1 L-ET-COUNT                         (N5) INIT <50>
1 L-REFRESH-COUNT                    (N5) INIT <1000>
1 L-LOG-DELETIONS                    (A1) INIT <'N'>
1 L-DEL-ARCHIVED                     (A1) INIT <'N'>
* Parms for RMASSDEN
1 #RMASSDEN-INPARAM                  (A54)
1 REDEFINE #RMASSDEN-INPARAM
  2 #RMASSDEN-WILDCARD               (A1)
  2 #RMASSDEN-MASK-CHAR              (A1)
  2 #RMASSDEN-OBJECT-TYPE            (A2)
  2 #RMASSDEN-OBJECT-PREFIX          (A25)
  2 #RMASSDEN-OBJECT-MASK            (A25)
1 #RMASSDEN-ET-COUNT                 (I2)
1 #RMASSDEN-SCREEN-COUNT             (I2)
1 #RMASSDEN-LOG-DELETIONS            (A1)
1 #RMASSDEN-USERID                   (A8)
1 #RMASSDEN-DELETE-COUNT             (N9)
1 #RMASSDEN-OBJECT                   (A32)
1 #RMASSDEN-DEL-ARCHIVED             (A1)
1 #RMASSDEN-RC                       (N4)
1 #RMASSDEN-USER-TYPE                (A1)  /* NOMALL-1884 fhi in
1 #FATHER-PROG                       (A8) INIT <'RMENU'>
1 #LANGUAGE                          (I1)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
/*SU1 OPTIONS MCG=OFF
*
RESET G-COMMIT
CALLNAT 'RGETLIB' #XX-ERROR-APPL
*
#RMASSDEN-USERID    := G-USERID
#RMASSDEN-USER-TYPE := SUBSTR(G-USER-PROFILE,1,1) /* NOMALL-1884 fhi in
* fhi    2016-06-09 NOMALL-1884 start insertion
DECIDE ON FIRST VALUE OF *DATA
  VALUE 2
    INPUT L-OBJECT-TYPE L-OBJECT-PREFIX
  VALUE 1
    INPUT L-OBJECT-TYPE
  NONE IGNORE
END-DECIDE
* fhi    2016-06-09 NOMALL-1884 end   insertion
MAIN-LOOP. REPEAT
  RESET G-NATRP-ERC G-NATRP-ERT
  SCREEN-LOOP. REPEAT
    IF #LANGUAGE NE *LANGUAGE
      #LANGUAGE := *LANGUAGE
      PERFORM INIT-PFKEYS
      PERFORM SET-PFKEYS
    END-IF
*
    PERFORM FLIP-DISPLAY
    SET CONTROL 'L'
    SET CONTROL 'WB'
    CALLNAT 'N-HEADER' L-HEADER G-DATE-FORMAT 'RMASSDM&'
    RESET G-MAP-MODIFIED
*
    INPUT WITH TEXT G-NATRP-ERT MARK *G-DIRECT-COMMAND
      USING MAP 'RMASSDM&'
    RESET G-NATRP-ERC G-NATRP-ERT
    INCLUDE RPFKVA-C
    INCLUDE C-DIRECT
    DECIDE ON FIRST VALUE OF G-PF-FUNC
      VALUE 'HELP'     REINPUT USING HELP
      VALUE 'EXIT'     ESCAPE BOTTOM(MAIN-LOOP.)
      VALUE 'FLIP'     PERFORM FLIP-HANDLE
      VALUE 'DO'       PERFORM VALIDATE-INPUT
        PERFORM DO-THE-DELETE
      VALUE 'MENU'     ESCAPE BOTTOM(MAIN-LOOP.)
      ANY     RESET G-DIRECT-COMMAND
      NONE    IGNORE
    END-DECIDE
    IF (CV-MAP MODIFIED OR G-MAP-MODIFIED)
      PERFORM VALIDATE-INPUT
    END-IF
*
  END-REPEAT
*
END-REPEAT
IF G-PF-FUNC = 'MENU'
  FETCH #FATHER-PROG
END-IF
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-INPUT
************************************************************************
DECIDE ON FIRST VALUE OF L-OBJECT-TYPE
  VALUES 'BU','RP','AB','AR'
    IGNORE
  NONE VALUE
    REINPUT *6004 MARK *L-OBJECT-TYPE
END-DECIDE
*
IF L-WILDCARD = ' '
  L-WILDCARD:= '*'
END-IF
IF L-MASK-CHAR = ' '
  L-MASK-CHAR:= '?'
END-IF
IF L-WILDCARD = L-MASK-CHAR        /* must be different
  REINPUT *0071 MARK *L-WILDCARD
END-IF
IF L-OBJECT-PREFIX = ' '           /* must not be empty
  REINPUT *0070 MARK *L-OBJECT-PREFIX
END-IF
IF L-ET-COUNT = 0
  L-ET-COUNT:= 50
END-IF
IF L-REFRESH-COUNT = 0
  L-REFRESH-COUNT:= 1000
END-IF
IF L-LOG-DELETIONS NE 'Y' AND L-LOG-DELETIONS NE 'N'
  REINPUT *1099 MARK *L-LOG-DELETIONS
END-IF
IF NOT(L-DEL-ARCHIVED = 'Y' OR = 'N')
  REINPUT *1099 MARK *L-DEL-ARCHIVED
END-IF
*
END-SUBROUTINE /* VALIDATE-INPUT
*
************************************************************************
DEFINE SUBROUTINE DO-THE-DELETE
************************************************************************
* Set parms for RMASSDEN
#RMASSDEN-WILDCARD      := L-WILDCARD
#RMASSDEN-MASK-CHAR     := L-MASK-CHAR
#RMASSDEN-OBJECT-TYPE   := L-OBJECT-TYPE
#RMASSDEN-OBJECT-MASK   := L-OBJECT-MASK
IF #RMASSDEN-OBJECT-MASK NE ' '
  #RMASSDEN-OBJECT-PREFIX := L-OBJECT-PREFIX
ELSE
  COMPRESS L-OBJECT-PREFIX L-WILDCARD
    TO #RMASSDEN-OBJECT-PREFIX LEAVING NO
END-IF
#RMASSDEN-ET-COUNT      := L-ET-COUNT
#RMASSDEN-SCREEN-COUNT  := L-REFRESH-COUNT
#RMASSDEN-LOG-DELETIONS := L-LOG-DELETIONS
#RMASSDEN-DEL-ARCHIVED  := L-DEL-ARCHIVED
RESET INITIAL L-DEL-ARCHIVED
RESET #RMASSDEN-DELETE-COUNT #RMASSDEN-OBJECT #RMASSDEN-RC
COMPRESS '0072' L-OBJECT-TYPE TO LG-MSG
PERFORM WRITE-LOG
CALLNAT 'RMASSDEN' #RMASSDEN-INPARAM G-DISPLAY-LONG-NAMES
  #RMASSDEN-ET-COUNT #RMASSDEN-SCREEN-COUNT #RMASSDEN-LOG-DELETIONS
  #RMASSDEN-USERID #RMASSDEN-DELETE-COUNT #RMASSDEN-OBJECT
  #RMASSDEN-DEL-ARCHIVED #RMASSDEN-RC
  #RMASSDEN-USER-TYPE  /* NOMALL-1884 fhi in
DECIDE ON FIRST VALUE OF #RMASSDEN-RC
  VALUE 0
    COMPRESS '0073' L-OBJECT-TYPE #RMASSDEN-DELETE-COUNT TO LG-MSG
    PERFORM WRITE-LOG
    #XX-ERROR-CODE:= 0073
    #XX-MSG-DYNA(1):= L-OBJECT-TYPE
    #XX-MSG-DYNA(2):= #RMASSDEN-DELETE-COUNT
    INCLUDE XXGMSG-C
    G-NATRP-ERT:= #XX-SHORT-TEXT
  NONE VALUE
    COMPRESS '0074' #RMASSDEN-RC #RMASSDEN-OBJECT #RMASSDEN-DELETE-COUNT
      TO LG-MSG
    PERFORM WRITE-LOG
    #XX-ERROR-CODE:= 0074
    #XX-MSG-DYNA(1):= #RMASSDEN-RC
    #XX-MSG-DYNA(2):= #RMASSDEN-OBJECT
    #XX-MSG-DYNA(3):= #RMASSDEN-DELETE-COUNT
    INCLUDE XXGMSG-C
    G-NATRP-ERT:= #XX-SHORT-TEXT
END-DECIDE
*
END-SUBROUTINE /* DO-THE-DELETE
*
************************************************************************
DEFINE SUBROUTINE WRITE-LOG
************************************************************************
LG-USERID:= G-USERID
LG-CODE:= 'MO'
CALLNAT 'RLOG' PL-PARMS
END TRANSACTION
*
END-SUBROUTINE
*
************************************************************************
DEFINE SUBROUTINE INIT-PFKEYS
************************************************************************
INCLUDE RPFSTD-C
G-PF-IDENT (05) := ##PFN-COMMIT
G-PF-CODE  (05) := ##PFK-COMMIT
G-PF-IDENT (17) := ##PFN-COMMIT
G-PF-CODE  (17) := ##PFK-COMMIT
CALLNAT 'RPFINI-N' G-PF G-PFB
*
END-SUBROUTINE
* --------------------------------------- set pfkeys -------------------
INCLUDE RPFSET-C
*
END
