* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    RMJBST-N
* Version   1.3
* Function  Substitute Variables in a Job skeleton
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* mrs 93-06-18           created
* gw  96-06-03 s(999999) account for more than one substitution in line
* gw  96-07-25 s(251461) correct null substitution
* SU1     2022-07-07 NOMALL-2559 restruct (itrac for uqac only)
* ----------------------------------------------------------------------
DEFINE DATA
PARAMETER USING RMJBST-P
PARAMETER
1 RMJBST-CARD       (A72)
************************************************************************
LOCAL
1 I                 (P2)
1 #STRING           (A253)
1 REDEFINE #STRING
  2 #FILLER         (A71)
  2 #CONTINUATION   (A1)
1 #CHAR             (A1)
1 #NUM              (I2)
1 #FIRST-FOUND      (L) INIT <TRUE>
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#STRING := RMJBST-CARD
#CHAR   := #CONTINUATION
RESET #CONTINUATION RMJBST-NULL-SUBSTITUTION
*
FOR I = 1 TO RMJBST-ENTRIES
  IF RMJBST-VAR (I) = ' '
    ESCAPE TOP
  END-IF
  EXAMINE #STRING FOR RMJBST-VAR (I) GIVING NUMBER #NUM
  IF #NUM NE 0
    IF #FIRST-FOUND
      RMJBST-NULL-SUBSTITUTION := TRUE
      RESET #FIRST-FOUND
    END-IF
    IF RMJBST-TEXT (I) NE ' '
      EXAMINE #STRING FOR RMJBST-VAR (I) REPLACE WITH RMJBST-TEXT (I)
      RMJBST-NULL-SUBSTITUTION := FALSE
    ELSE
      EXAMINE #STRING FOR RMJBST-VAR (I) DELETE
    END-IF
  END-IF
END-FOR
*
IF #CHAR NE ' '
  #CONTINUATION := #CHAR
END-IF
RMJBST-CARD := #STRING
*
END
