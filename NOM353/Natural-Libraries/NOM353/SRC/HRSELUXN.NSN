* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* HRSELUXN
* Function: Select a node
* splildav  2009-02-18    new  p(311477) and p(311479)
* SU1     2017-07-18             NOM 3.5: MF nodes added
* SU2     2018-02-02 ES-23787    allow input value
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 #TYPE                (A1)  /*U=Unix/otherwise=all
1 NODE-NAME-IN         (A16)
************************************************************************
LOCAL
1 #T                   (A1)
1 #TAB                 (*)
  2 #NODE-NAME         (A16)
  2 #NODE-NO           (N5)
  2 #NODE-DESC         (A50)
  2 #NODE-SYSTEM       (A9)
  2 #NODE-PRODUCT-NAME (A16)
  2 #NODE-STATUS       (A8) /*status
  2 #NODE-IS-MF        (L) /*true=MF/false=unix
  2 #NODE-MSG          (A100)
  2 #NODE-TYPE         (A1)
  2 L-ISN              (P10) /*for delete
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
IF #TYPE = 'U' /*help for unix nodes (no MF nodes Ü)
  #T := 'U'
ELSE           /*all nodes
  #T := '?'
END-IF
CALLNAT 'N-NODES' #T #TAB (*) NODE-NAME-IN /*SU2 last parm added
IF *OCC(#NODE-NAME) > 0
  NODE-NAME-IN := #NODE-NAME (1)
END-IF
*
END
