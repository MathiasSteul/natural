* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* NOMTP01N - Trigger NOM processing
* ----------------------------------------------------------------------
* Please be careful if you want to change the parameters of this
* program and double check the dependencies. This interface program
* is used by NOP and by external (user-) feed of the trigger queue.
* ----------------------------------------------------------------------
* Maintenance
* uuu     yyyy-mm-dd s(999999) ...
* gw      1994-05-03 s(999999) created
* gw      1995-01-24 s(217624) correct bs2 trigger
* jvd     1998-09-10 p(164220) NAT23ÖNOM141
* fhi     2000-08-24 QA03      Use NAT23006 for error values
* sju     2003-10-07 p(245410) Correct VSE spool trigger
* xsetggr 2007-05-14 NOM3201   convert job&node numbers in source attrib
* fhi     2007-07-02 p(292584) Allow generic filenames (*-notation)
* fhi     2007-07-12 NOM3202   C-NATERR changed, NAD23006 is obsolete.
* xsetggr 2008-05-05 p(304350) restow due to changes in RMSPL--L
* xsetggr 2009-10-20 P320826   prevent node = ' ' to convert spool attr.
*                              properly in RMSPL7-N
* fhi     2009-11-03 P314788   Add trace for error investigation
* fhi     2010-04-30 P325497   Add trace for error investigation
* fhi     2010-05-06 P325497   Add trace for error investigation
* fhi     2010-05-07 P325497   Add trace for error investigation
* fhi     2010-09-21 NOMALL-97 Use no more C-NATERR but C-NATERN instead
* raya    2012-01-29 NOMALL-1096 error-text a250 in NOMTP--P stow only
* fhi     2012-03-27 NOMALL-1120 Backouted NOMALL-1096 in NOMTP--P
* fhi     2016-03-07 NOMALL-1837 Introduce spool type 'AL'
* fhi     2016-05-18 NOMALL-1837 Correct parameter DDNAME
* fhi     2016-11-15 NOMALL-1961 Use new task IDs
* fhi     2018-07-19 NOMALL-2121 Use node number and esyuser
* fhi     2018-10-23 NOMALL-2121 Check given node number for existence
* SU1     2020-04-30 NOMALL-2349 remove unused
* SU2     2020-11-10 NOMALL-2440 split DDM -> NRM-MF-NODES
* SU3     2021-04-22 NOMALL-2454 recat for VMONIT-L M-NATRPT-DBID/-FNR
* SU4     2022-08-11 NOMALL-2573 no binary data in log/NOTE: no LOGON
*                    here->must be done before (example:see RMNPRUSR)Ü
* SU5     2024-03-07 ES-34613    NOM 3.6 Remove power
************************************************************************
DEFINE DATA PARAMETER USING NOMTP--P
************************************************************************
LOCAL USING NOMSR--L
LOCAL USING RMSPL--L
LOCAL USING SATLF02P
LOCAL USING SATFNC3E
LOCAL USING RMSR---L
LOCAL
1 API-DEFAULTS VIEW OF NRM-MONITOR
  2 M-TIME-SCHEDULE
/*SU3  2 M-NATRPT-DBID
/*SU3  2 M-NATRPT-FNR
  2 M-NATRPT-DBID-N5
  2 M-NATRPT-FNR-N5
1 MF-NODE VIEW OF NRM-MF-NODES /*SU2 was NRM-MONITOR
1 TRIGGER-ENTRY VIEW OF NRM-NOMPUT-QUEUE
1 TRIGGER VIEW OF NRM-NOMPUT-QUEUE
  2 NP-STATUS
  2 NP-TYPE
  2 NP-ATTRIBUTES-IDENT
  2 NP-SPOOL-ATTRIBUTES
  2 NP-CC-TYPE
  2 NP-NODE
  2 NP-ESYUSER
1 FILE-ATTRIBUTES VIEW OF FILE-ATTRIBUTES
  2 ERROR-CODE
  2 ERROR-TEXT
  2 REDEFINE ERROR-TEXT
    3 ERROR-PREF      (A7)
  2 VOLSER
  2 LRECL
  2 BLKSIZE
  2 RECFM
1 CATALOG VIEW OF CATALOG
  2 ERROR-CODE
  2 ERROR-TEXT
  2 DSNAME
/*SU1  2 NODE 2 NODE-NAME 2 SYSTEM-MESSAGE-CODE 2 VOLSER 2 TYPE 2 CLASS
1 SPOOL-FILES VIEW OF SPOOL-FILES
  2 ERROR-CODE
  2 ERROR-TEXT
  2 REDEFINE ERROR-TEXT
    3 ERROR-PREF      (A7)
  2 NODE
  2 JOB-NAME
  2 JOB-NUMBER
  2 TYPE
  2 DATA-SET
  2 DATA-SET-KEY
  2 PROCNAME
  2 STEPNAME
  2 DDNAME
/*SU1 2 GROUP-ID 2 RECFM 2 CHARS 2 FCB 2 FLASH 2 FORM 2 TRC 2 COPIES
/*SU1 2 UCS 2 BURST 2 COMPACT 2 LINECT 2 DESTINATION
/*SU5 -> 1 SPOOL-QUEUE VIEW OF SPOOL-QUEUE 2 ERROR-CODE 2 ERROR-TEXT
/*  2 REDEFINE ERROR-TEXT 3 ERROR-PREF (A7) 2 JOB-NAME 2 JOB-NUMBER
/*SU5 <- 2 QUEUE 2 NODE
/*SU1 2 CLASS 2 DESTINATION 2 FORM 2 COPIES 2 REAL-RECORD-COUNT 2 DISP
*
1 #NP-QUEUE           (A67) /*SU 2018-03-26 was (A75)
1 REDEFINE #NP-QUEUE
  2 #NP-STATUS        (I2)
  2 #NP-TYPE          (I2)
  2 #NP-IDENT         (A63)
1 #EOM-SYS2
  2 #EOM-SYS2-DBID    (N5)
  2 #EOM-SYS2-FNR     (N5)
1 #SOURCE-TYPE        (B2)
1 #DSNAME             (A54)
1 #DSNAME-LENGTH      (P3)
1 #TRACE              (L)
1 #TRACE-TEXT         (A131)
1 #A4                 (A4)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#TRACE := FALSE
* #TRACE := TRUE /* ÜÜÜ TEST ONLY ÜÜÜ
*
FORMAT LS=250
RESET NOMTP-ERROR-CODE NOMTP-ERROR-TEXT
*
IF #TRACE
  COMPRESS *PROGRAM 'got following input:' TO #TRACE-TEXT
  WRITE #TRACE-TEXT
  FETCH RETURN 'LGW1---P' #TRACE-TEXT /* Access NOP-Log
  END TRANSACTION
  COMPRESS 'CC-TYPE:'     NOMTP-CC-TYPE
    'Source-Type:' NOMTP-SOURCE-TYPE TO #TRACE-TEXT
  WRITE #TRACE-TEXT
  FETCH RETURN 'LGW1---P' #TRACE-TEXT /* Access NOP-Log
  END TRANSACTION
  COMPRESS 'Identification:' NOMTP-IDENT (*) TO #TRACE-TEXT
  WRITE #TRACE-TEXT
  FETCH RETURN 'LGW1---P' #TRACE-TEXT /* Access NOP-Log
  END TRANSACTION
END-IF
#SOURCE-ATTRIBUTES := NOMTP-SOURCE-ATTRIBUTES
#SOURCE-TYPE := NOMTP-SOURCE-TYPE
CALLNAT 'RMSR7--N' #SOURCE-ATTRIBUTES #SOURCE-TYPE
NOMTP-SOURCE-ATTRIBUTES := #SOURCE-ATTRIBUTES
*
PERFORM GET-EOM-SYS2-LFILE
IF NOMTP-ERROR-CODE NE 0
  PERFORM WRITE-TRACE
  ESCAPE ROUTINE
END-IF
*
PERFORM READ-API-DEFAULTS
IF NOMTP-ERROR-CODE NE 0
  PERFORM WRITE-TRACE
  ESCAPE ROUTINE
END-IF
*
PERFORM SET-LFILE
*
DECIDE ON FIRST NOMTP-SOURCE-TYPE
  VALUE NOMSR-JES2, NOMSR-JES3
    PERFORM WRITE-JES-TRIGGER
/*SU5 VALUE NOMSR-POWER PERFORM WRITE-POWER-TRIGGER
/*SU5 VALUE NOMSR-SEQUENTIAL-FILE-VSE PERFORM WRITE-SEQ-FILE-VSE-TRIGGER
  VALUE NOMSR-SEQUENTIAL-FILE-MVS
    PERFORM WRITE-SEQ-FILE-MVS-TRIGGER
  VALUE NOMSR-SEQUENTIAL-FILE-BS2
    IF #TRACE
      EXAMINE NOMSR-FBS2-DSNAME FOR ' '
        GIVING LENGTH IN #DSNAME-LENGTH
      COMPRESS *PROGRAM 'DSNAME:' NOMSR-FBS2-DSNAME TO #TRACE-TEXT
      WRITE #TRACE-TEXT
      FETCH RETURN 'LGW1---P' #TRACE-TEXT /* Access NOP-Log
      END TRANSACTION
      COMPRESS *PROGRAM *LINE  'LEN:' #DSNAME-LENGTH TO #TRACE-TEXT
      WRITE #TRACE-TEXT
      FETCH RETURN 'LGW1---P' #TRACE-TEXT /* Access NOP-Log
      END TRANSACTION
    END-IF
    PERFORM WRITE-SEQ-FILE-BS2-TRIGGER
  NONE VALUE
    NOMTP-ERROR-CODE := 9151
END-DECIDE
*
PERFORM WRITE-TRACE
SATLF-DBID-N5 := #EOM-SYS2-DBID
SATLF-FNR-N5  := #EOM-SYS2-FNR
PERFORM SET-LFILE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE READ-API-DEFAULTS
************************************************************************
FIND API-DEFAULTS WITH M-MONITOR-ID = 'API-DEFS'
  IF NO
    NOMTP-ERROR-CODE := 9153
    ESCAPE ROUTINE
  END-NOREC
*
  IF M-TIME-SCHEDULE = 'Y'
    DECIDE FOR FIRST CONDITION
      WHEN M-NATRPT-DBID-N5 > 0
        SATLF-DBID-N5 := M-NATRPT-DBID-N5
        SATLF-FNR-N5  := M-NATRPT-FNR-N5
/*SU3 WHEN M-NATRPT-DBID > 0
/*SU3   SATLF-DBID-N5 := M-NATRPT-DBID
/*SU3   SATLF-FNR-N5  := M-NATRPT-FNR
      WHEN NONE IGNORE
    END-DECIDE
  ELSE
    NOMTP-ERROR-CODE := 9154
  END-IF
*
END-FIND
*
END-SUBROUTINE /* READ-API-DEFAULTS
*
************************************************************************
DEFINE SUBROUTINE GET-EOM-SYS2-LFILE
************************************************************************
SATLF-FUNCTION := 'GET'
SATLF-LFILE    := 158
SATLF-SATVERS  := 21
CALLNAT SAT-GET-SET-LFILE SATLF-SATVERS SATLF-PARMS (*)
IF SATLF-ERROR-CODE NE 0
  NOMTP-ERROR-CODE := SATLF-ERROR-CODE
  NOMTP-ERROR-TEXT := SATLF-ERROR-TEXT
END-IF
#EOM-SYS2-DBID := SATLF-DBID-N5
#EOM-SYS2-FNR  := SATLF-FNR-N5
*
END-SUBROUTINE /* GET-EOM-SYS2-LFILE
*
************************************************************************
DEFINE SUBROUTINE SET-LFILE
************************************************************************
SATLF-FUNCTION := 'SET'
SATLF-LFILE    := 158
SATLF-SATVERS  := 21
CALLNAT SAT-GET-SET-LFILE SATLF-SATVERS SATLF-PARMS (*)
IF SATLF-ERROR-CODE NE 0
  NOMTP-ERROR-CODE := SATLF-ERROR-CODE
  NOMTP-ERROR-TEXT := SATLF-ERROR-TEXT
END-IF
*
END-SUBROUTINE /* SET-LFILE
*
************************************************************************
DEFINE SUBROUTINE STORE-TRIGGER-RECORD
************************************************************************
TRIGGER.NP-STATUS           := 2  /* 'closed'
TRIGGER.NP-TYPE             := NOMTP-SOURCE-TYPE
TRIGGER.NP-ATTRIBUTES-IDENT := NOMSR-SOURCE-ATTRIBUTES
TRIGGER.NP-SPOOL-ATTRIBUTES := #SPOOL-ATTRIBUTES
TRIGGER.NP-CC-TYPE          := NOMTP-CC-TYPE
DECIDE FOR EVERY CONDITION
  WHEN NOMTP-NODE SPECIFIED
    NODES. FIND NUMBER MF-NODE WITH MF-MONITOR-NODE = NOMTP-NODE/*SU2
    IF *NUMBER(NODES.)  = 0
      NOMTP-ERROR-CODE := 9156
      COMPRESS NOMTP-ERROR-CODE NOMTP-NODE TO NOMTP-ERROR-TEXT
      PERFORM XXRLOG-WRITE-LOG 'M' NOMTP-ERROR-TEXT /* Resolve text only
      ESCAPE ROUTINE
    END-IF
    TRIGGER.NP-NODE := NOMTP-NODE
  WHEN NOMTP-ESYUSER SPECIFIED
    TRIGGER.NP-ESYUSER := NOMTP-ESYUSER
  WHEN NONE
    IGNORE
END-DECIDE
#NP-STATUS := TRIGGER.NP-STATUS
#NP-TYPE   := TRIGGER.NP-TYPE
#NP-IDENT  := TRIGGER.NP-ATTRIBUTES-IDENT
*
FNDQ. FIND NUMBER TRIGGER-ENTRY WITH NP-QUEUE = #NP-QUEUE
IF *NUMBER (FNDQ.) > 0
  ESCAPE ROUTINE
END-IF
IF #TRACE
  MOVE EDITED NP-STATUS (EM=HH) TO #TRACE-TEXT /*SU4 ..
  MOVE EDITED NP-TYPE   (EM=HH) TO #A4
  COMPRESS *PROGRAM 'write trigger queue: Status:' #TRACE-TEXT
    'Type:' #A4 TO #TRACE-TEXT
  WRITE #TRACE-TEXT
  FETCH RETURN 'LGW1---P' #TRACE-TEXT /* Access NOP-Log
  END TRANSACTION
  COMPRESS 'Ident:' NP-ATTRIBUTES-IDENT TO #TRACE-TEXT /*SU1 binary ?
  WRITE #TRACE-TEXT
  FETCH RETURN 'LGW1---P' #TRACE-TEXT /* Access NOP-Log
  END TRANSACTION
END-IF
*
STORE TRIGGER
END TRANSACTION
*
END-SUBROUTINE /* STORE-TRIGGER-RECORD
*
************************************************************************
DEFINE SUBROUTINE WRITE-JES-TRIGGER
************************************************************************
NOMSR-SOURCE-ATTRIBUTES := NOMTP-SOURCE-ATTRIBUTES
PERFORM VALIDATE-JES-PARAMETER
IF NOMTP-ERROR-CODE NE 0
  ESCAPE ROUTINE
END-IF
*
PERFORM CREATE-JES-TRIGGER-ENTRY
*
END-SUBROUTINE /* WRITE-JES-TRIGGER
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-JES-PARAMETER
************************************************************************
RESET NOMTP-ERROR-TEXT
DECIDE FOR FIRST CONDITION
  WHEN NOMSR-JES-NODE = 0
    NOMTP-ERROR-TEXT := 'JES-NODE'
  WHEN NOMSR-JES-JOB-NAME = ' '
    NOMTP-ERROR-TEXT := 'JES-JOB-NAME'
  WHEN NOMSR-JES-JOB-NUMBER = 0
    NOMTP-ERROR-TEXT := 'JES-JOB-NUMBER'
  WHEN NOMSR-JES-TYPE NE ' '
    IF NOMSR-JES-DATA-SET = 0
      NOMTP-ERROR-TEXT := 'JES-DATA-SET'
    END-IF
  WHEN NOMSR-JES-DDNAME = ' '
    NOMTP-ERROR-TEXT := 'NOMSR-JES-DDNAME'
  WHEN NOMSR-JES-STEPNAME = ' '
    NOMTP-ERROR-TEXT := 'NOMSR-JES-STEPNAME'
  WHEN NOMSR-JES-PROCNAME = ' '
    NOMTP-ERROR-TEXT := 'NOMSR-JES-PROCNAME'
  WHEN ANY
    IF NOMTP-ERROR-TEXT NE ' '
      NOMTP-ERROR-CODE := 9151
    END-IF
  WHEN NONE IGNORE
END-DECIDE
*
END-SUBROUTINE /* VALIDATE-JES-PARAMETER
*
************************************************************************
DEFINE SUBROUTINE CREATE-JES-TRIGGER-ENTRY
************************************************************************
DECIDE FOR FIRST CONDITION
  WHEN NOMSR-JES-TYPE = ' '
    FNDJESDD. FIND SPOOL-FILES WITH NODE = NOMSR-JES-NODE
    AND JOB-NAME =NOMSR-JES-JOB-NAME AND JOB-NUMBER=NOMSR-JES-JOB-NUMBER
    AND PROCNAME = NOMSR-JES-PROCNAME AND STEPNAME =  NOMSR-JES-STEPNAME
    AND DDNAME = NOMSR-JES-DDNAME                                     /*
      IF SPOOL-FILES.ERROR-CODE NE 0
        NOMTP-ERROR-CODE := 9152
        NOMTP-ERROR-TEXT := SPOOL-FILES.ERROR-PREF
        PRINT (AD=L) *PROGRAM *LINE ERROR-CODE ERROR-TEXT
          'node=' NOMSR-JES-NODE 'job-name=' NOMSR-JES-JOB-NAME
          'job-number=' NOMSR-JES-JOB-NUMBER
          'procname=' NOMSR-JES-PROCNAME 'stepname=' NOMSR-JES-STEPNAME
          'ddname=' NOMSR-JES-DDNAME
        ESCAPE ROUTINE
      END-IF
      PERFORM PROCESS-JES-SPOOL-FILE
    END-FIND
  WHEN NOMSR-JES-TYPE = 'AL'
    FNDJESAL. FIND (1) SPOOL-FILES WITH NODE = NOMSR-JES-NODE
    AND JOB-NAME =NOMSR-JES-JOB-NAME AND JOB-NUMBER=NOMSR-JES-JOB-NUMBER
      IF SPOOL-FILES.ERROR-CODE NE 0
        NOMTP-ERROR-CODE := 9152
        NOMTP-ERROR-TEXT := SPOOL-FILES.ERROR-PREF
        PRINT (AD=L) *PROGRAM *LINE ERROR-CODE ERROR-TEXT
          'node=' NOMSR-JES-NODE 'job-name=' NOMSR-JES-JOB-NAME
          'job-number=' NOMSR-JES-JOB-NUMBER
        ESCAPE ROUTINE
      END-IF
      PERFORM PROCESS-JES-SPOOL-FILE
    END-FIND
  WHEN NONE
    FNDJESDS. FIND SPOOL-FILES WITH NODE = NOMSR-JES-NODE
    AND JOB-NAME =NOMSR-JES-JOB-NAME AND JOB-NUMBER=NOMSR-JES-JOB-NUMBER
    AND TYPE = NOMSR-JES-TYPE AND DATA-SET   = NOMSR-JES-DATA-SET     /*
      IF SPOOL-FILES.ERROR-CODE NE 0
        NOMTP-ERROR-CODE := 9152
        NOMTP-ERROR-TEXT := SPOOL-FILES.ERROR-PREF
        PRINT (AD=L) *PROGRAM *LINE ERROR-CODE ERROR-TEXT
          'node=' NOMSR-JES-NODE 'job-name=' NOMSR-JES-JOB-NAME
          'job-number=' NOMSR-JES-JOB-NUMBER
          'type=' NOMSR-JES-TYPE 'data-set=' NOMSR-JES-DATA-SET
        ESCAPE ROUTINE
      END-IF
      PERFORM PROCESS-JES-SPOOL-FILE
    END-FIND
END-DECIDE
*
END-SUBROUTINE /* CREATE-JES-TRIGGER-ENTRY
*
************************************************************************
DEFINE SUBROUTINE PROCESS-JES-SPOOL-FILE
************************************************************************
NOMSR-JES-NODE       := ABS(SPOOL-FILES.NODE)
NOMSR-JES-JOB-NAME   := SPOOL-FILES.JOB-NAME
NOMSR-JES-JOB-NUMBER := ABS(SPOOL-FILES.JOB-NUMBER)
IF NOMSR-JES-TYPE NE 'AL'
  NOMSR-JES-TYPE := SPOOL-FILES.TYPE
END-IF
NOMSR-JES-DATA-SET     := ABS(SPOOL-FILES.DATA-SET)
NOMSR-JES-DATA-SET-KEY := ABS(SPOOL-FILES.DATA-SET-KEY)
NOMSR-JES-PROCNAME     := SPOOL-FILES.PROCNAME
NOMSR-JES-STEPNAME     := SPOOL-FILES.STEPNAME
IF NOMSR-JES-TYPE NE 'AL'
  NOMSR-JES-DDNAME := SPOOL-FILES.DDNAME
ELSE
  NOMSR-JES-DDNAME := 'JESMSGLG'
END-IF
*
PERFORM STORE-TRIGGER-RECORD
*
END-SUBROUTINE /* PROCESS-JES-SPOOL-FILE
*
************************************************************************
DEFINE SUBROUTINE WRITE-SEQ-FILE-MVS-TRIGGER
************************************************************************
NOMSR-SOURCE-ATTRIBUTES := NOMTP-SOURCE-ATTRIBUTES
PERFORM VALIDATE-SEQ-FILE-MVS-PARMS
IF NOMTP-ERROR-CODE NE 0
  ESCAPE ROUTINE
END-IF
*
IF NOMSR-FMVS-DSNAME = SCAN ('*')
  #DSNAME := NOMSR-FMVS-DSNAME
  FIND CATALOG WITH NODE   = NOMSR-FMVS-NODE AND DSNAME = #DSNAME
  AND VOLSER = NOMSR-FMVS-VOLSER                                      /*
    IF ERROR-CODE NE 0
      NOMTP-ERROR-CODE := 9152
      COMPRESS ERROR-CODE ERROR-TEXT TO NOMTP-ERROR-TEXT
      ESCAPE BOTTOM
    END-IF
    NOMSR-FMVS-DSNAME := DSNAME
    PERFORM CREATE-SEQ-FILE-MVS-TRIGGER-ENTRY
  END-FIND
ELSE
  PERFORM CREATE-SEQ-FILE-MVS-TRIGGER-ENTRY
END-IF
*
END-SUBROUTINE /* WRITE-SEQ-FILE-MVS-TRIGGER
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-SEQ-FILE-MVS-PARMS
************************************************************************
DECIDE FOR FIRST CONDITION
  WHEN NOMSR-FMVS-NODE = 0
    NOMTP-ERROR-CODE := 9151
    NOMTP-ERROR-TEXT := 'FMVS-NODE'
  WHEN NOMSR-FMVS-DSNAME = ' '
    NOMTP-ERROR-CODE := 9151
    NOMTP-ERROR-TEXT := 'FMVS-DSNNAME'
  WHEN NONE
    IGNORE
END-DECIDE
*
END-SUBROUTINE /* VALIDATE-SEQ-FILE-MVS-PARMS
*
************************************************************************
DEFINE SUBROUTINE CREATE-SEQ-FILE-MVS-TRIGGER-ENTRY
************************************************************************
FNDFMVS. FIND FILE-ATTRIBUTES WITH NODE   = NOMSR-FMVS-NODE
AND DSNAME = NOMSR-FMVS-DSNAME AND VOLSER = NOMSR-FMVS-VOLSER         /*
  IF ERROR-CODE (FNDFMVS.) NE 0
    NOMTP-ERROR-CODE := 9152
    NOMTP-ERROR-TEXT := ERROR-PREF (FNDFMVS.)
    PRINT (AD=L) *PROGRAM *LINE ERROR-CODE ERROR-TEXT
      'node=' NOMSR-FMVS-NODE
      'dsname=' NOMSR-FMVS-DSNAME 'volser=' NOMSR-FMVS-VOLSER
    ESCAPE BOTTOM (FNDFMVS.)
  END-IF
  RESET #SPOOL-JES-NODE #SPOOL-JES-JOB-NUMBER
  #SPOOL-JES-JOB-NAME    := NOMTP-IDENT (1)
  #SPOOL-JES-DESTINATION := NOMTP-IDENT (2)
  NOMSR-FMVS-VOLSER      := FNDFMVS.VOLSER
  NOMSR-FMVS-RECFM       := FNDFMVS.RECFM
  NOMSR-FMVS-LRECL       := ABS(FNDFMVS.LRECL)
  NOMSR-FMVS-BLKSIZE     := ABS(FNDFMVS.BLKSIZE)
  PERFORM STORE-TRIGGER-RECORD
END-FIND
*
END-SUBROUTINE /* CREATE-SEQ-FILE-MVS-TRIGGER-ENTRY
*
************************************************************************
DEFINE SUBROUTINE WRITE-SEQ-FILE-BS2-TRIGGER
************************************************************************
NOMSR-SOURCE-ATTRIBUTES := NOMTP-SOURCE-ATTRIBUTES
PERFORM VALIDATE-SEQ-FILE-BS2-PARMS
IF NOMTP-ERROR-CODE NE 0
  ESCAPE ROUTINE
END-IF
IF NOMSR-FBS2-DSNAME = SCAN ('*')
  #DSNAME := NOMSR-FBS2-DSNAME
  FIND CATALOG WITH NODE   = NOMSR-FBS2-NODE AND DSNAME = #DSNAME
    IF ERROR-CODE NE 0
      NOMTP-ERROR-CODE := 9152
      COMPRESS ERROR-CODE ERROR-TEXT TO NOMTP-ERROR-TEXT
      ESCAPE BOTTOM
    END-IF
    NOMSR-FBS2-DSNAME := DSNAME
    PERFORM CREATE-SEQ-FILE-BS2-TRIGGER-ENTRY
  END-FIND
ELSE
  PERFORM CREATE-SEQ-FILE-BS2-TRIGGER-ENTRY
END-IF
*
END-SUBROUTINE /* WRITE-SEQ-FILE-BS2-TRIGGER
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-SEQ-FILE-BS2-PARMS
************************************************************************
DECIDE FOR EVERY CONDITION
  WHEN NOMSR-FBS2-NODE   = 0   NOMTP-ERROR-TEXT := 'FBS2-NODE'
  WHEN NOMSR-FBS2-DSNAME = ' ' NOMTP-ERROR-TEXT := 'FBS2-DSNNAME'
  WHEN ANY
    NOMTP-ERROR-CODE := 9151
    ESCAPE ROUTINE
  WHEN NONE IGNORE
END-DECIDE
*
END-SUBROUTINE /* VALIDATE-SEQ-FILE-BS2-PARMS
*
************************************************************************
DEFINE SUBROUTINE CREATE-SEQ-FILE-BS2-TRIGGER-ENTRY
************************************************************************
FNDFBS2. FIND FILE-ATTRIBUTES WITH NODE = NOMSR-FBS2-NODE
AND DSNAME = NOMSR-FBS2-DSNAME                                        /*
  IF ERROR-CODE (FNDFBS2.) NE 0
    NOMTP-ERROR-CODE := 9152
    NOMTP-ERROR-TEXT := ERROR-PREF (FNDFBS2.)
    PRINT (AD=L) *PROGRAM *LINE ERROR-CODE ERROR-TEXT
      'node=' NOMSR-FBS2-NODE 'dsname=' NOMSR-FBS2-DSNAME
    ESCAPE BOTTOM (FNDFBS2.)
  END-IF
  #SPOOL-BS2-JOB-NAME := NOMTP-IDENT (1)
  #SPOOL-BS2-USER-ID  := NOMTP-IDENT (2)
  #SPOOL-BS2-FORM     := NOMTP-IDENT (3)
  IF #TRACE
    COMPRESS 'Line:' *LINE 'Job-Name:' #SPOOL-BS2-JOB-NAME
      'User:' #SPOOL-BS2-USER-ID 'Form:' #SPOOL-BS2-FORM TO #TRACE-TEXT
    WRITE #TRACE-TEXT
    FETCH RETURN 'LGW1---P' #TRACE-TEXT /* Access NOP-Log
    END TRANSACTION
    COMPRESS 'Line:' *LINE 'Dest.:'  #SPOOL-BS2-DESTINATION
      'Device:' #SPOOL-BS2-DEVICE 'Rot.:'   #SPOOL-BS2-ROTATION
      'Dia.:'   #SPOOL-BS2-DIA TO #TRACE-TEXT
    WRITE #TRACE-TEXT
    FETCH RETURN 'LGW1---P' #TRACE-TEXT /* ACCESS NOP-LOG
    END TRANSACTION
  END-IF
  RESET #SPOOL-BS2-NODE
  PERFORM STORE-TRIGGER-RECORD
END-FIND
*
END-SUBROUTINE /* CREATE-SEQ-FILE-BS2-TRIGGER-ENTRY
*
************************************************************************
DEFINE SUBROUTINE WRITE-TRACE
************************************************************************
IF #TRACE AND NOMTP-ERROR-CODE NE 0 /* second condition: P325497
  COMPRESS *PROGRAM *LINE 'reports the following error:'
    NOMTP-ERROR-CODE TO #TRACE-TEXT
  WRITE #TRACE-TEXT
  FETCH RETURN 'LGW1---P' #TRACE-TEXT /* Access NOP-Log
  END TRANSACTION
  #TRACE-TEXT := NOMTP-ERROR-TEXT
  WRITE #TRACE-TEXT
  FETCH RETURN 'LGW1---P' #TRACE-TEXT /* Access NOP-Log
  END TRANSACTION
END-IF
*
END-SUBROUTINE /* WRITE-TRACE
*
************************************************************************
ON ERROR
************************************************************************
  BACKOUT TRANSACTION
  CALLNAT 'C-NATERN' NOMTP-ERROR-TEXT
  NOMTP-ERROR-CODE := 9155
  COMPRESS *PROGRAM *LINE 'REPORTS THE FOLLOWING ERROR:'
    NOMTP-ERROR-CODE TO #TRACE-TEXT
  WRITE #TRACE-TEXT
  FETCH RETURN 'LGW1---P' #TRACE-TEXT /* ACCESS NOP-LOG
  END TRANSACTION
  #TRACE-TEXT := NOMTP-ERROR-TEXT
  WRITE #TRACE-TEXT
  FETCH RETURN 'LGW1---P' #TRACE-TEXT /* ACCESS NOP-LOG
  END TRANSACTION
  ESCAPE ROUTINE
*
END-ERROR
*
END
