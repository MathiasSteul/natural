* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RCHKUS    CHECK IF A USERID EXIST
*
* MAINTENANCE:
*
* xsetggr 2003-08-20 p(240465) not allowed userid 'DEFAULT'
* fhi     2003-08-29 p(240465) set initial condition
* ----------------------------------------------------------------------
DEFINE DATA
PARAMETER
1 #USERID(A08)
1 #EXIST(L)
LOCAL USING VUSERS-L
END-DEFINE
RESET #EXIST /* fhi 2003-08-29 p(240465) if find loop not executed
FIND-NUM.
* FIND NUMBER USERS WITH USER-ID = #USERID
* IF *NUMBER(FIND-NUM.) > 0 MOVE TRUE TO #EXIST
* xsetggr 2003-08-20 p(240465) 2 line above out next 3 lines in
FIND (1) USERS WITH USER-ID = #USERID WHERE USER-ID NE 'DEFAULT'
  IF *NUMBER (FIND-NUM.) > 0
    MOVE TRUE TO #EXIST
  ELSE
    MOVE FALSE TO #EXIST
  END-IF
END-FIND                       /* xsetggr 2003-08-20 p(240465) in
END
