* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* HRSELPRN - Function:  Select a logical Printer
*
* mrs 91-08-27  completly new (sorted and with read instead of find)
* mrs 92-05-22  s(150306) restrict printer selection
* gw  93-05-27  p(120080) NAT0936 in bundle defaults printer selection
* mrs 92-05-22  s(190391) use RGRANT-N instaed of find
* jwo 97-06-26  p(162804) start value for printer selection
* xsethz  2000-08-07 (CE7461) Extend Report and Bundle Names
* sju 03-05-22 p(240729) Restrict usage
* xsetggr 2008-02-11 p(302045) don'tn use DEFAULTx printers in selection
* xsetggr 2009-09-04 P314431 restirict use of NATUNIX and UNIXLP printer
*       UNIXLP printers allowed only on mainframe systems, on unix only
*       NATUNIX and DISKUNIX are allowed.
* xsetggr 2010-11-03 NOMALL-865 restow due to changes in EOMPHTYE
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 #PRINTER             (A8)
1 #USER-ID             (A8)
1 #USER-TYPE           (A1)
************************************************************************
LOCAL USING VGRANT-L
LOCAL USING EOMPHTYE
LOCAL
1 PRINTERS VIEW OF NRM-PRINTERS
  2 P-ID
  2 P-NAME
  2 P-DISP
  2 P-PHYSICAL-NAME
1 PH VIEW OF NRM-PHYSICAL-PRINTERS
  2 PH-PRINTER-TYPE
*
1 #I                   (P2)
1 #J                   (P2)
1 #NOFLINES            (I2)   CONST <10>
1 #SCREEN              (1:#NOFLINES)
  2 L-NAME             (A20)
  2 L-ID               (A8)
1 CV-MARK              (C/1:#NOFLINES)
1 CV-LINE              (C/1:#NOFLINES)
1 GRANTED              (L)
1 #OBJECT-NAME         (A25)
1 L-MARK               (A1/1:#NOFLINES)
1 END-OF-PROCESSING    (L)
1 END-OF-DISPLAY       (L)
1 END-OF-DATA          (L)
1 NEW-SEARCH           (L)
1 #ERC                 (N4)
1 #PAGE                (P3)  INIT <1>
1 #NOFPAGES            (I2)  CONST <20>
1 #PID                 (A26/1:#NOFPAGES)
1 #DISPLAY-IT          (L)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
PERFORM PF-KEYS
#PID(1) := #PRINTER
EXAMINE #PID(1) FOR '*' REPLACE H'00'
EXAMINE #PID(1) FOR '?' REPLACE H'00'
*
MAIN. REPEAT UNTIL END-OF-PROCESSING
  RESET #I
  RESET INITIAL END-OF-DATA NEW-SEARCH
  REA. READ PRINTERS BY P-ID STARTING FROM #PID (#PAGE)
    RESET GRANTED
    IF #USER-TYPE = 'A'
      GRANTED := TRUE
    ELSE
      GRANTS.GR-USERID := #USER-ID
      #OBJECT-NAME            := P-ID
      CALLNAT 'RGRANT-N' GRANTS.GR-USERID 'P' #OBJECT-NAME
        GRANTED GRANTS.GR-OPTION(*)
      IF GRANTED AND P-DISP = 'Y'          /* restricted usage
          AND NOT GRANTS.GR-OPTION(*) = 'Y'
        RESET GRANTED
      END-IF
    END-IF
    IF NOT GRANTED OR SUBSTR(P-ID,1,7) = 'DEFAULT'
      ESCAPE TOP
    END-IF
    PERFORM CHECK-PRINTER-TYPE
    IF NOT #DISPLAY-IT
      ESCAPE TOP
    END-IF
    IF #I = #NOFLINES
      PERFORM SCREEN-IO
      IF END-OF-PROCESSING OR NEW-SEARCH
        ESCAPE BOTTOM (REA.)
      END-IF
    END-IF
    ADD 1 TO #I
    PERFORM PRINTER-TO-SCREEN
  END-READ
  DECIDE FOR FIRST CONDITION
    WHEN #I > 0
      END-OF-DATA := TRUE
    WHEN *COUNTER (REA.) = 0
      ESCAPE BOTTOM (MAIN.)
    WHEN ANY
      PERFORM SCREEN-IO
    WHEN NONE
      IGNORE
  END-DECIDE
END-REPEAT
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE SCREEN-IO
************************************************************************
IF #I < #NOFLINES
  CV-MARK (#I+1:#NOFLINES) := (AD=DP)
END-IF
RESET END-OF-DISPLAY
REPEAT
  DECIDE FOR FIRST CONDITION
    WHEN #ERC NE 0                    IGNORE
    WHEN END-OF-DATA AND #PAGE > 1    #ERC := 12 /* bottom of data
    WHEN END-OF-DATA AND #PAGE =1     #ERC := 14 /* all
    WHEN NOT END-OF-DATA AND #PAGE=1  #ERC := 11 /* top of data
    WHEN NONE                         #ERC := 13 /* more
  END-DECIDE
  PERFORM FLIP-DISPLAY
  SET CONTROL 'WC20L45B2/35F'
  SET CONTROL 'M15'
  SET CONTROL 'Y41'
  INPUT WITH TEXT *#ERC USING MAP 'HSELPR1&'
  SET CONTROL 'WB'
  SET CONTROL 'M21'
  SET CONTROL 'YB'
  RESET #ERC
  PERFORM COMMAND-PF-KEY
  UNTIL END-OF-DISPLAY
END-REPEAT
RESET #I #SCREEN (*)
*
END-SUBROUTINE /* SCREEN-IO
*
************************************************************************
DEFINE SUBROUTINE CHECK-PRINTER-TYPE
************************************************************************
#DISPLAY-IT := TRUE
FIND PH WITH PH-VTAMID = P-PHYSICAL-NAME
  IF *MACHINE-CLASS = 'MAINFRAME'
    IF  PH-PRINTER-TYPE = ##PHYS-NATUNIX
      RESET #DISPLAY-IT
    END-IF
  ELSE
    IF NOT(PH-PRINTER-TYPE = ##PHYS-DISKUNIX OR = ##PHYS-NATUNIX)
      RESET #DISPLAY-IT
    END-IF
  END-IF
END-FIND
*
END-SUBROUTINE /* CHECK-PRINTER-TYPE
*
************************************************************************
DEFINE SUBROUTINE PRINTER-TO-SCREEN
************************************************************************
L-NAME  (#I) := PRINTERS.P-NAME
L-ID    (#I) := PRINTERS.P-ID
CV-MARK (#I) := (AD=I)
*
END-SUBROUTINE /* PRINTER-TO-SCREEN
*
************************************************************************
DEFINE SUBROUTINE COMMAND-PF-KEY
************************************************************************
FOR #J = 1 TO #I
  IF L-MARK (#J) NE ' '
    #PRINTER := L-ID (#J)
    END-OF-PROCESSING := END-OF-DISPLAY := TRUE
    ESCAPE ROUTINE
  END-IF
END-FOR
DECIDE ON FIRST *PF-KEY
  VALUE 'PF3' /* return to father-prog
    END-OF-PROCESSING := END-OF-DISPLAY := TRUE
  VALUE 'PF7'    IF #PAGE > 1
      #PAGE := #PAGE - 1
      END-OF-DATA := FALSE
      END-OF-DISPLAY := NEW-SEARCH := TRUE
    END-IF
  VALUE 'PF8'
    IF NOT END-OF-DATA
      ADD 1 TO #PAGE
      IF #PAGE > #NOFPAGES
        #PAGE := #NOFPAGES
        #PID (1:19) := #PID (2:20)
      END-IF
      #PID (#PAGE) := PRINTERS.P-ID
      END-OF-DISPLAY := TRUE
    END-IF
  NONE  IGNORE
END-DECIDE
*
END-SUBROUTINE /* COMMAND-PF-KEY
*
************************************************************************
DEFINE SUBROUTINE PF-KEYS
************************************************************************
SET KEY PF1 = PGM PF2 = PGM PF3 = PGM PF4 = PGM PF5 = PGM PF6 = PGM
  PF7 = PGM PF8 = PGM PF9 = PGM PF10 = PGM PF11 = PGM PF12 = PGM
*
END-SUBROUTINE /* PF-KEYS
*
END
