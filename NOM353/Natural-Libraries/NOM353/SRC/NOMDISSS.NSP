* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
DEFINE DATA LOCAL
1 SS VIEW OF NRM-STATISTICS
  2 SS-ITEM
  2 SS-TITLE (100)
  2 SS-VALUE (100)
1 #LINE      (A132)
1 #I         (I2)
1 #DISPLAYED (L)
END-DEFINE
FORMAT LS=133
READ SS BY SS-ITEM
  RESET #DISPLAYED #LINE
  FOR #I = 1 TO 100
    COMPRESS SS-ITEM #I '-->' TO #LINE
    IF SS-VALUE (#I) NE ' '
        AND SS-VALUE (#I) NE '*null*'
        AND SS-VALUE (#I) NE '0'
      IF SS-TITLE (#I) NE ' '
          AND SS-TITLE (#I) NE '*null*'
        COMPRESS SS-ITEM #I '-->' SS-TITLE (#I) 'is' TO #LINE
      END-IF
      COMPRESS #LINE SS-VALUE (#I) TO #LINE
      IF #LINE NE ' '
        MOVE TRUE TO #DISPLAYED
        WRITE #LINE
      END-IF
    END-IF
  END-FOR
  IF #DISPLAYED
    MOVE ALL '-' TO #LINE
    WRITE / #LINE /
  END-IF
END-READ
END
