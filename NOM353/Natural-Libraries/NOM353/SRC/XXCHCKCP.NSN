1 REDEFINE #CP-ENTRIES
  2 #CP-GR                   (1:#CPMAX)
    3 #CODEPAGE-NUMBERS      (A5)
    3 #CODEPAGE-NAMES        (A18)
    3 #CODEPAGE-DESCRIPTIONS (A78)
* *****
1 #INDEX                 (I2)
1 #I                     (I2)
1 #J                     (I2)
1 #L                     (I2)
1 #POS                   (I2)
1 #POS-TOP               (I2)
/*SU4 1 END-OF-PROCESSING      (L)
1 END-OF-DATA            (L)
1 #CODEPAGE              (A8) CONST <'CODEPAGE'>
1 #CP-MAX                (I2) CONST <15>
1 #CODEPAGE-TAB          (A250/1:2)
1 REDEFINE #CODEPAGE-TAB
  2 #CODEPAGES           (A25/1:#CP-MAX)
1 #PAGE                  (P3)  INIT <1>
1 #ERC                   (N4)
1 #ERT                   (A250)
1 #CP-MEMBER             (A8)
/*SU4 1 #N                     (N5.3)
1 #MAP                   (1:15)
  2 CV-MARK              (C) INIT ALL <(AD=DP)>
  2 CV-LINE              (C)
  2 L-MARK               (A1)
  2 L-NO                 (A5)
  2 L-NAME               (A25) /*only 20 chars used
  2 L-DESC               (A78)
1 #TIT                   (A50/1:2) CONST <
  '- Codepage Selection List -',
  ' '>
* fhi      2018-11-23   NOMALL-1918 start insertion
1 #CHCK-MOVE-U           (U1) INIT <UH'0041'> /* Capital 'A'
1 #CHCK-MOVE-A           (A4)
1 #ENC-ERC               (I4)
* fhi      2018-11-23   NOMALL-1918 end   insertion
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
IF *LANGUAGE = 2
  #L := 2
ELSE
  #L := 1
END-IF
DEFINE WINDOW SELCP SIZE 22*80 BASE 3/1 /*TOP LEFT
  TITLE #TIT (#L) CONTROL WINDOW
*
RESET ERC
DECIDE ON FIRST VALUE OF FUNCTION
  VALUE 'D' /*help for default list
    PERFORM #HELP-DEFAULT
    ESCAPE ROUTINE IMMEDIATE
  VALUE '?' /*help for complete list
    PERFORM #HELP
    ESCAPE ROUTINE IMMEDIATE
  VALUE '-'
    PERFORM #UNIQUE
    ESCAPE ROUTINE IMMEDIATE
  VALUE '#'
    RESET CP-NUMBER CP-DESCRIPTION
    IF CP-NAME = ' '
      RESET CP-NUMBER CP-DESCRIPTION
      ERC := 5
      ESCAPE ROUTINE IMMEDIATE
    END-IF
    EXAMINE CP-NAME TRANSLATE INTO UPPER
    EXAMINE CP-NAME FOR '_' REPLACE WITH '-'
* fhi     2016-11-23 NOMALL-1962 start insertion
    EXAMINE CP-NAME FOR ' ' REPLACE WITH '-'
    DECIDE FOR FIRST CONDITION
      WHEN CP-NAME = MASK('ISO'NNNN)
        COMPRESS SUBSTR(CP-NAME,1,3) '-' SUBSTR(CP-NAME,4)
          TO CP-NAME LEAVING NO
      WHEN NONE
        IGNORE
    END-DECIDE
* fhi     2016-11-23 NOMALL-1962 end   insertion
    SEPARATE CP-NAME INTO CP-NAME IGNORE WITH DELIMITER ':'
    EXAMINE #CODEPAGE-NAMES(*)   FOR CP-NAME   GIVING INDEX IN #INDEX
  VALUE 'N'
    RESET CP-NAME CP-DESCRIPTION
    EXAMINE #CODEPAGE-NUMBERS(*) FOR CP-NUMBER GIVING INDEX IN #INDEX
  ANY
    IF #INDEX NE 0
      CP-NUMBER      := #CODEPAGE-NUMBERS(#INDEX)
      CP-NAME        := #CODEPAGE-NAMES(#INDEX)
      CP-DESCRIPTION := #CODEPAGE-DESCRIPTIONS(#INDEX)
    END-IF
    EXAMINE CP-NAME FOR ' ' GIVING LENGTH #I /*SU2
    IF #I LE 8 /*SU3 > 8
/*SU3 ERC := 2 ESCAPE MODULE END-IF
      IF CP-NAME = ' '
        ERC := 5
        ESCAPE ROUTINE
      END-IF
      #CP-MEMBER := CP-NAME
      CALLNAT 'XXTR2U16' 'T' #CP-MEMBER 2X ERC #ERT /*Test user codepage
      IF ERC = 0
        ERC := 4              /* Codepage found as user defined table
        ESCAPE MODULE /*SU3
      END-IF /*SU3
    END-IF
    MOVE ENCODED #CHCK-MOVE-U TO #CHCK-MOVE-A IN CODEPAGE CP-NAME
      GIVING #ENC-ERC
    IF (#ENC-ERC NE 0 AND #ENC-ERC NE 3413) OR *CODEPAGE = ' '
      ERC := 1
    ELSE
      ERC := 0
    END-IF
  NONE
    ERC := 2
END-DECIDE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE #HELP-DEFAULT /*RDEFCP
************************************************************************
FIND-LOOP. FIND NRM-MONITOR WITH M-MONITOR-ID = #CODEPAGE
  PERFORM PF-KEYS
  #CODEPAGE-TAB (*) := M-EMAIL-RECIPIENTS (*)
  FOR #POS=1 TO #CP-MAX
    IF #CODEPAGES (#POS) = ' '
      ESCAPE TOP
    END-IF
    ADD 1 TO #J
    L-NAME  (#J) := #CODEPAGES (#POS)
    FOR #I=1 TO #CPMAX
      IF #CODEPAGE-NAMES (#I) = #CODEPAGES (#POS)
        L-NO    (#J) := #CODEPAGE-NUMBERS      (#I)
        L-DESC  (#J) := #CODEPAGE-DESCRIPTIONS (#I)
        CV-MARK (#J) := (AD=I)
      END-IF
    END-FOR
    END-OF-DATA := TRUE
  END-FOR
  PERFORM SCREEN-IO
END-FIND /*(FIND-LOOP.)
**IF *NUMBER(FIND-LOOP.)=0
**    ..
**END-IF
*
END-SUBROUTINE /* #HELP-DEFAULT
*
************************************************************************
DEFINE SUBROUTINE #HELP
************************************************************************
PERFORM PF-KEYS
RESET INITIAL #MAP (*) #I
FOR #POS=1 TO #CPMAX
  IF #I=0
    #POS-TOP := #POS
  END-IF
  ADD 1 TO #I
  L-NAME  (#I) := #CODEPAGE-NAMES        (#POS)
  L-NO    (#I) := #CODEPAGE-NUMBERS      (#POS)
  L-DESC  (#I) := #CODEPAGE-DESCRIPTIONS (#POS)
  CV-MARK (#I) := (AD=I)
  IF #I = *OCC(CV-MARK) OR #POS=#CPMAX
    IF #POS=#CPMAX
      END-OF-DATA := TRUE
    END-IF
    PERFORM SCREEN-IO
  END-IF
END-FOR
*
END-SUBROUTINE /* #HELP
*
************************************************************************
DEFINE SUBROUTINE #UNIQUE
************************************************************************
WRITE '-- duplicate numbers --'
FOR #POS=1 TO #CPMAX
  EXAMINE FULL #CODEPAGE-NUMBERS (*) FOR FULL #CODEPAGE-NUMBERS (#POS)
    GIVING NUMBER #J INDEX #I
  IF #J > 1 /*AND #I = #POS
    PERFORM #DISP
  END-IF
END-FOR
WRITE '-- duplicate names --'
FOR #POS=1 TO #CPMAX
  EXAMINE FULL #CODEPAGE-NAMES (*) FOR FULL #CODEPAGE-NAMES (#POS)
    GIVING NUMBER #J INDEX #I
  IF #J > 1 /*AND #I = #POS
    PERFORM #DISP
  END-IF
END-FOR
*
END-SUBROUTINE /* #UNIQUE
*
************************************************************************
DEFINE SUBROUTINE #DISP
************************************************************************
DISPLAY ' ' #POS (NL=3) 'Name' #CODEPAGE-NAMES (#POS)
  'Number' #CODEPAGE-NUMBERS (#POS)(NL=9)
  'Description' #CODEPAGE-DESCRIPTIONS (#POS)(AL=30)
  'num' #J(NL=3) 'ind' #I(NL=3)
*
END-SUBROUTINE /* #DISP
*
************************************************************************
DEFINE SUBROUTINE SCREEN-IO
************************************************************************
#REP. REPEAT
  DECIDE FOR FIRST CONDITION
    WHEN #ERC NE 0                    IGNORE
    WHEN END-OF-DATA AND #PAGE > 1    #ERC := 12 /* bottom of data
    WHEN END-OF-DATA AND #PAGE =1     #ERC := 14 /* all
    WHEN NOT END-OF-DATA AND #PAGE=1  #ERC := 11 /* top of data
    WHEN NONE                         #ERC := 13 /* more
  END-DECIDE
  PERFORM FLIP-DISPLAY
  INPUT WINDOW='SELCP' WITH TEXT *#ERC USING MAP 'HSELCP&'
* SET CONTROL 'WB'
* SET CONTROL 'M21'
* SET CONTROL 'YB'
  RESET #ERC
  PERFORM COMMAND-PF-KEY
END-REPEAT /*(#REP.)
RESET INITIAL #I #MAP (*) L-MARK (*)
*
END-SUBROUTINE /* SCREEN-IO
*
************************************************************************
DEFINE SUBROUTINE COMMAND-PF-KEY
************************************************************************
DECIDE ON FIRST *PF-KEY
  VALUE 'PF3' /* return to father-prog
    ESCAPE MODULE IMMEDIATE /*XXCHCKCP
  VALUE 'PF7' /*up
    IF #PAGE > 1
      #POS := #POS-TOP - *OCC(CV-MARK) - 1
      SUBTRACT 1 FROM #PAGE
      END-OF-DATA := FALSE
      ESCAPE BOTTOM /*(#REP.)
    END-IF
  VALUE 'PF8' /*down
    IF NOT END-OF-DATA
      ADD 1 TO #PAGE
    END-IF
    ESCAPE BOTTOM /*(#REP.)
  NONE  IGNORE
END-DECIDE
FOR #J=1 TO *OCC(L-MARK)
  IF L-MARK (#J) NE ' '
    CP-NUMBER      := L-NO   (#J)
    CP-NAME        := L-NAME (#J)
    CP-DESCRIPTION := L-DESC (#J)
    ESCAPE MODULE IMMEDIATE /*XXCHCKCP
  END-IF
END-FOR
*
END-SUBROUTINE /* COMMAND-PF-KEY
*
************************************************************************
DEFINE SUBROUTINE PF-KEYS
************************************************************************
SET KEY PF1 = PGM PF2 = PGM PF3 = PGM PF4 = PGM PF5 = PGM PF6 = PGM
  PF7 = PGM PF8 = PGM PF9 = PGM PF10 = PGM PF11 = PGM PF12 = PGM
*
END-SUBROUTINE /* PF-KEYS
*
END
