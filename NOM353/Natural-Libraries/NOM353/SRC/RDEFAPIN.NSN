DEFINE DATA PARAMETER
1 #FIELD-NAME      (A65)
************************************************************************
LOCAL
1 F                (P2)
1 #FIELD           (A65)
1 REDEFINE #FIELD
  2 #F             (A1/1:65)
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
ASSIGN #FIELD = #FIELD-NAME
EXAMINE #FIELD FOR '.' GIVING POSITION IN F
IF F > 0
  RESET #F (1:F)
  MOVE LEFT #FIELD TO #FIELD
END-IF
*
DECIDE ON FIRST #FIELD
  VALUE 'M-TIME-SCHEDULE'   INPUT USING MAP 'HAPPACT&'
  VALUE 'M-NATRPT-DBID-N5'  INPUT USING MAP 'HAPPDB-&'
  VALUE 'M-NATRPT-FNR-N5'   INPUT USING MAP 'HAPPFNR&'
  NONE                      IGNORE
END-DECIDE
*
END
