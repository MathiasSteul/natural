* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* NOMNODE - Change NOM Node - Copy code
* Parameters:
*         &1& - Destination field
*         &2& - Object Type description ('Source Id', ...)
*         &3& - Object Contents (the source id found)
*
* Maintenance:
* uuu     yyyy-mm-dd s(999999) ....
* fhi     2014-10-27 NOMALL-1514 Created
* ----------------------------------------------------------------------
IF &1& NE #NODE
  DECIDE FOR FIRST CONDITION
    WHEN #DISPLAY
      WRITE *PROGRAM *TIMX (EM=DD'.'MM'.'YYYY' 'HH':'II':'SS)
        'Found' &2& &3& 'with node' &1& '- not changed.'
    WHEN &1& = 0 AND &2& NE 'Source Id' /* Node 0 on Source Attrib
*                                       /* has to be changed anyway
      WRITE *PROGRAM *TIMX (EM=DD'.'MM'.'YYYY' 'HH':'II':'SS)
        'Found' &2& &3& 'with node' &1& '- not changed, node not set.'
    WHEN ANY
      ESCAPE TOP
    WHEN NONE
      IF #UPD = FALSE /* avoid msg duplicates
        WRITE *PROGRAM *TIMX (EM=DD'.'MM'.'YYYY' 'HH':'II':'SS)
          'Found' &2& &3& 'with node' &1& '- updated.'
      END-IF
      #UPD := TRUE
      &1& := #NODE
  END-DECIDE
END-IF
* End of copycode NOMNODEC *********************************************
