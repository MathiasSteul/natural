* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
************************************************************************
* Version   3.5
* Function  During scan process: report node = current node ?
*           Invoke via: F#NODEMATCH <R-INTERNAL-NODE-ID>
* ----------------------------------------------------------------------
* Maintenance
* -----------
* uuuuuu  yyyy-mm-dd iTrac       Remark
* SU      2018-08-02             Created
************************************************************************
*
DEFINE FUNCTION F#NODEMATCH RETURNS #OK (L)
  DEFINE DATA PARAMETER
  1 R-INT-NODE-ID (P11) BY VALUE
************************************************************************
  INDEPENDENT
  1 +NOD-LOCAL-INTERNAL-ID   (P11)
  1 +NOD-CURRENT-INTERNAL-ID (P11)
* *****
  END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
IF (R-INT-NODE-ID =0
AND +NOD-LOCAL-INTERNAL-ID NE +NOD-CURRENT-INTERNAL-ID)               /*
OR (R-INT-NODE-ID NE 0 AND R-INT-NODE-ID NE +NOD-CURRENT-INTERNAL-ID) /*
  RESET #OK
ELSE
  #OK := TRUE
END-IF
*
END-FUNCTION /*F#NODEMATCH
*
END
