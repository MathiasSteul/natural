* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    N-NONE
* Function  Check/correct NONE/KEIN language dependent (separation mem.)
*
* Version   3.4
*
* Maintenance:
* uuu     yyyy-mm-dd itrac ....
* SU      2016-09-28 NOMALL-1906 created
* ----------------------------------------------------------------------
*
DEFINE DATA
PARAMETER
1 #MEM1             (A8)
1 #MEM2             (A8) OPTIONAL
* *****
LOCAL
1 #LANG             (I2) INIT <*LANGUAGE>
1 #TAB              (A8/1:2) CONST (V) <'NONE','KEIN'>
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
IF NOT (#LANG =1 OR=2)
  #LANG := 1
END-IF
IF #MEM1 = #TAB (*)
  #MEM1 := #TAB (#LANG)
END-IF
IF #MEM2 SPECIFIED AND #MEM2 = #TAB (*)
  #MEM2 := #TAB (#LANG)
END-IF
*
END
