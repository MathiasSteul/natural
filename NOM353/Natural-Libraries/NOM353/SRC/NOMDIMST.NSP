* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
***                            NOMDIMST                                       ***
***   Display monitor status                                                  ***
***                                                                           ***
***   fhi/SAG 09/2012                                                         ***
***                                                                           ***
*********************************************************************************
*  MONITOR STATUS CODES:
*  NOTACTIVE                   A          1 INIT<H'01'>
*  INIT                        A          1 INIT<H'02'>
*  PROCBUN                     A          1 INIT<H'03'>
*  SCANPRT                     A          1 INIT<H'04'>
*  SCANJES                     A          1 INIT<H'05'>
*  IDLE                        A          1 INIT<H'06'>
*  SHUTDOWN                    A          1 INIT<H'07'>
*  CLOSED                      A          1 INIT<H'08'>
*  ABENDED                     A          1 INIT<H'09'>
*  PURGE-EXPIRED-REP           A          1 INIT<H'10'>
*  PURGE-EXPIRED-BUN           A          1 INIT<H'11'>
*  PURGE-EXPIRED-LOG           A          1 INIT<H'12'>
*  PURGE-EXPIRED-ARC           A          1 INIT<H'13'>
*  PURGE-EXPIRED-PO            A          1 INIT<H'14'>
*  CREATE-AR                   A          1 INIT<H'15'>
*  LOAD-SOURCE                 A          1 INIT<H'16'>
*  ANALYSE-SOURCES             A          1 INIT<H'17'>
*  DELETE-SOURCES              A          1 INIT<H'18'>
*  ERROR-RECOVERY              A          1 INIT<H'19'>
*  START-ARCHIVER              A          1 INIT<H'20'>
*  START-REVIVER               A          1 INIT<H'21'>
*  START-CONDENSE              A          1 INIT<H'22'>
*  INACTIVE                    A          1 INIT<'D'>
*  ENDED                       A          1 INIT<'C'>
*********************************************************************************
* Maintenance:
* Userid   Date       iTrac       Remark
* ----------------------------------------------------------------------
* fhi      2016-11-11 NOMALL-1961 Duplicate monitor copy task, rewritten
*
*********************************************************************************
DEFINE DATA
LOCAL USING VSUBT-L                      /* fhi P300286 NRT1560 in
LOCAL USING RMSETSTE
LOCAL
1 #I                    (I4)
1 #ST-SUBTASK-ID        (A16)
1 REDEFINE #ST-SUBTASK-ID
  2 #ST-SUBTASK-PROD      (A3)
  2 #ST-SUBTASK-NUMBER    (N2)
  2 REDEFINE #ST-SUBTASK-NUMBER
    3 #ST-SUBTASK-NUMBER-A (A2)
1 #ST-LAST-ACTIVE       (A17)
1 #NATRP-DBID           (N5)
1 REDEFINE #NATRP-DBID                 /* fhi 2010-05-28 NOMALL-93 in
  2 #NATRP-DBID-A       (A5)       /* fhi 2010-05-28 NOMALL-93 in
1 #NATRP-FNR            (N5)
1 REDEFINE #NATRP-FNR                  /* fhi 2010-05-28 NOMALL-93 in
  2 #NATRP-FNR-A        (A5)       /* fhi 2010-05-28 NOMALL-93 in
1 #MESSAGE              (A78)
1 #TASK-NO              (A2)
END-DEFINE
NRM-SUBT.
READ NRM-SUBTASK-INFO BY ST-SUBTASK-ID
    STARTING FROM 'NOM0000000000-00'
    ENDING AT     'NOM9999999999-99'
  ACCEPT IF ST-SUBTASK-ID = MASK('NOM'NNNNNNNNNN'-'NN)
  MOVE EDITED ST-LAST-ACTIVE (EM=YY-MM-DD' 'HH':'II':'SS) TO #ST-LAST-ACTIVE
  EXAMINE #EQU-STATUS-V (*) FOR ST-STATUS GIVING INDEX #I
  IF #I NE 0
    ST-MESSAGE   := #EQN-STATUS-V (#I)
    ST-STATUS    := ST-STATUS
  ELSE
    ST-MESSAGE   := 'NONE'
  END-IF
  #ST-SUBTASK-ID := ST-SUBTASK-ID
  IF #ST-SUBTASK-NUMBER-A IS (N2)
    #TASK-NO   := #ST-SUBTASK-NUMBER
  ELSE
    #TASK-NO   := '--'
  END-IF
  COMPRESS
    '- ID:'          ST-SUBTASK-ID
    '- No:'          #TASK-NO
    '- Last-Active:' #ST-LAST-ACTIVE  ','
    '- Status:'      ST-MESSAGE
    TO #MESSAGE
  WRITE #MESSAGE
END-READ   /* NRM-SUBT.
*
END
