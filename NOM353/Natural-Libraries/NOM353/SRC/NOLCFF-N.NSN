* SU3     2019-05-23 NOMALL-2278 remove NOMVI (version check)
* HEB1    2023-10-04 ES-34375    active help for keyword + and/or
* ----------------------------------------------------------------------
DEFINE DATA
PARAMETER USING ESMCNT-A
PARAMETER USING ESMINP-A
************************************************************************
LOCAL USING NADA2000
LOCAL USING NAD-MSG
LOCAL USING NAD-FLD
LOCAL USING NOARSL-A
LOCAL USING CONST-L
LOCAL
1 FO VIEW OF NRM-FOLDER
  2 FO-ID
  2 FO-NAME
  2 FO-LINKED-FO-ID
  2 FO-USER-ID
1 LINKED-FO VIEW OF NRM-FOLDER
  2 FO-ID
  2 FO-USER-ID
  2 FO-NAME
  2 FO-LINKED-FO-ID
  2 REDEFINE FO-LINKED-FO-ID
    3 FO-LINKED-USER-ID  (A8)
    3 FO-LINKED-ID       (B2)
1 MA VIEW OF NRM-MAIL
  2 MA-REPNAME
  2 MA-REPRNB
  2 MA-USERID
  2 MA-FO-ID
  2 MA-PROCESS-TIME-INV
  2 MA-CURRENT-LOCATION
1 AR VIEW OF NRM-ACTIVE-REPORTS
  2 AR-CURRENT-LOCATION
  2 AR-REPNAME
  2 AR-REPRNB
  2 AR-SENDER
  2 AR-KEYWORDS (6)
  2 AR-PROCESS-TIME
  2 AR-EXPIRATION
  2 AR-ARCHIVE
  2 AR-REVIVE
1 #FO-USER-NAME      (A24)
1 REDEFINE #FO-USER-NAME
  2 #FO-USERID       (A8)
  2 #FO-NAME         (A16)
1 #MA-LOC-USER-FOLDER-PROCESS-TIME (A18)
1 REDEFINE #MA-LOC-USER-FOLDER-PROCESS-TIME
  2 #MA-CURRENT-LOC  (A1)
  2 #MA-USERID       (A8)
  2 #MA-FO-ID        (B2)
  2 #MA-PROCESS-TIME-INV (P13)
1 #AR-REP-RNB        (A31)
1 REDEFINE #AR-REP-RNB
  2 #AR-REPNAME      (A25)
  2 #AR-REPRNB       (P11)
1 #ES-MSG-PREF       (A7) INIT <'NOM'>
1 REDEFINE #ES-MSG-PREF
  2 #ES-MSG-NOM      (A3)
  2 #ES-MSG-NR       (N4)
*   1 #MA-FOLDER-TIME-E  (A17)
1 #MAILED            (L)
1 #S-USER-FO-ID      (A10)
1 REDEFINE #S-USER-FO-ID
  2 #S-USER          (A8)
  2 #S-FO-ID         (B2)
1 #MA-L-FOLDER-REP   (A36)
1 REDEFINE #MA-L-FOLDER-REP
  2 #MA-CURRENT-LOC-R(A1)
  2 #MA-USERID-R     (A8)
  2 #MA-FO-ID-R      (B2)
  2 #MA-REPNAME      (A25)
1 #MA-REPNAME-E      (A25)
1 #LOC-CODE-2        (A2)  INIT <'AB'>
1 REDEFINE #LOC-CODE-2
  2 #LOC-CODE        (A1/2)
1 #ILOC              (I4)
1 #IOUT              (I4)
1 #F-DATE-C          (T)
1 REDEFINE #F-DATE-C
  2 #F-DATE-C-P      (P13)
1 #T-DATE-C          (T)
1 REDEFINE #T-DATE-C
  2 #T-DATE-C-P      (P13)
1 #DATE-14           (A14)
1 #SELECTED          (L)
1 #SOURCE-F          (A17)
1 #SOURCE-T          (A17)
1 #SENDER-F          (A17)
1 #SENDER-T          (A17)
1 #TIMEOUT           (T)
1 #K                 (I4)
1 #NEXT-FO-ID        (A5)
1 REDEFINE #NEXT-FO-ID
  2 #NEXT-FO-ID-N    (N5)
1 #ISN-N10           (N10)
1 REDEFINE #ISN-N10
  2 #ISN-A10         (A10)
1 #ISTART-N          (N1)
1 REDEFINE #ISTART-N
  2 #ISTART          (A1)
1 #NEXT-TIME         (A13)
1 REDEFINE #NEXT-TIME
  2 #NEXT-TIME-N     (N13)
1 #KY-SEL            (A15/1:4)                    /* HEB1 >
1 #NUM               (I2)
1 #L1                (I2)
1 #L2                (I2)
1 #L3                (I2)
1 #L4                (I2)                         /* HEB1 <
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#NOARSL := ES-SELECT
* PRINT *PROGRAM *LINE 'HEB-KY' 'Start' / '=' #NOARSL  /* HEB-TEMP
/* HEB1 >
#KY-SEL (1)   := #NOARSL.#KEYWORD
#KY-SEL (2:4) := #NOARSL.#KEYWORD-2-4 (1:3)
IF #KY-SEL (*) = '*' AND #KEYWORD-AND-OR NE 'A'
  RESET #KY-SEL (*)
END-IF
EXAMINE #KY-SEL (1) FOR '*' REPLACE WITH ' '
  GIVING NUMBER #NUM LENGTH #L1
IF #L1 < 1
    OR #NUM = 0 /* Deactivate this line => Keyword prefix search
  #L1 := 15
END-IF
EXAMINE #KY-SEL (2) FOR '*' REPLACE WITH ' '
  GIVING NUMBER #NUM LENGTH #L2
IF #L2 < 1
    OR #NUM = 0 /* Deactivate this line => Keyword prefix search
  #L2 := 15
END-IF
EXAMINE #KY-SEL (3) FOR '*' REPLACE WITH ' '
  GIVING NUMBER #NUM LENGTH #L3
IF #L3 < 1
    OR #NUM = 0 /* Deactivate this line => Keyword prefix search
  #L3 := 15
END-IF
EXAMINE #KY-SEL (4) FOR '*' REPLACE WITH ' '
  GIVING NUMBER #NUM LENGTH #L4
IF #L4 < 1
    OR #NUM = 0 /* Deactivate this line => Keyword prefix search
  #L4 := 15
END-IF
/* HEB1 <
ES-EOF := 'X'
IF ES-CLIENT-TIMEOUT > 10
  #TIMEOUT := *TIMX + (ES-CLIENT-TIMEOUT - 10) * 10
END-IF
IF ES-KEY-PARM(2) NE ' '
  /* PRINT *PROGRAM *LINE 'HEB-KY' 'mail' /* HEB-TEMP
  #S-USER := ES-KEY-PARM(1)
  #NEXT-FO-ID := ES-KEY-PARM(2)
  #S-FO-ID := #NEXT-FO-ID-N
  #ISN-A10 := ES-KEY-PARM(4)
  FIND FO WITH FO-USER-FO-ID = #S-USER-FO-ID
    LINKED-FO.FO-ID           := FO.FO-ID
    LINKED-FO.FO-USER-ID      := FO.FO-USER-ID
    LINKED-FO.FO-LINKED-FO-ID := FO.FO-LINKED-FO-ID
  END-FIND
  PERFORM CHECK-MAIL
ELSE
  /* PRINT *PROGRAM *LINE 'HEB-KY' 'not mail' /* HEB-TEMP
  #ISN-N10 := 0
  #FO-USERID := ES-USER
  #FO-NAME   := ES-KEY-PARM(1)
  IF #FO-NAME = '#Inbasket' OR = '#Listeneingang'
    #S-USER := #FO-USERID
    #S-FO-ID := 1
    FIND FO WITH FO-USER-FO-ID = #S-USER-FO-ID
      #FO-NAME := FO.FO-NAME
    END-FIND
  END-IF
  FIND FO WITH FO-USER-NAME = #FO-USER-NAME
    IF NO RECORDS FOUND
      #SETNAME := 'SETNAME'
      #AR-EXIST(*) := '1'
      ES-SELECT := #NOARSL
      ES-MSG-NR := 0352           /* folder not defined
      PERFORM GET-MSG-TXT
      ESCAPE ROUTINE
    END-NOREC
    LINKED-FO.FO-ID           := FO.FO-ID
    LINKED-FO.FO-USER-ID      := FO.FO-USER-ID
    LINKED-FO.FO-LINKED-FO-ID := FO.FO-LINKED-FO-ID
    IF LINKED-FO.FO-LINKED-FO-ID = ' '
      PERFORM CHECK-MAIL
    END-IF
    R. REPEAT WHILE LINKED-FO.FO-LINKED-FO-ID NE ' '
      #S-USER  := LINKED-FO.FO-LINKED-USER-ID
      #S-FO-ID := LINKED-FO.FO-LINKED-ID
      FIND LINKED-FO WITH FO-USER-FO-ID = #S-USER-FO-ID
        IF NO RECORDS FOUND
          ESCAPE BOTTOM (R.)
        END-NOREC
        IF LINKED-FO.FO-LINKED-FO-ID = ' '
          PERFORM CHECK-MAIL
        END-IF
      END-FIND
    END-REPEAT
  END-FIND
END-IF
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE CHECK-MAIL
************************************************************************
RESET #MAILED
IF #CREAT-DATE-FROM = ' '
  #T-DATE-C-P := #CONST-INV-TIME
ELSE
  IF #CREAT-TIME-FROM = ' '
    COMPRESS #CREAT-DATE-FROM '000000' TO #DATE-14 LEAVING NO
  ELSE
    COMPRESS #CREAT-DATE-FROM SUBSTR(#CREAT-TIME-FROM,1,4) '00'
      TO #DATE-14 LEAVING NO
  END-IF
  MOVE EDITED #DATE-14 TO #T-DATE-C(EM=YYYYMMDDHHIISS)
  #T-DATE-C-P := #CONST-INV-TIME - #T-DATE-C-P
END-IF
IF #CREAT-DATE-TO = ' '
  #F-DATE-C-P := 0
ELSE
  IF #CREAT-TIME-TO = ' '
    COMPRESS #CREAT-DATE-TO '000000' TO #DATE-14 LEAVING NO
  ELSE
    COMPRESS #CREAT-DATE-TO SUBSTR(#CREAT-TIME-TO,1,4) '59'
      TO #DATE-14 LEAVING NO
  END-IF
  MOVE EDITED #DATE-14 TO #F-DATE-C(EM=YYYYMMDDHHIISS)
  #F-DATE-C-P := #CONST-INV-TIME - #F-DATE-C-P
END-IF
EXAMINE #NOARSL.#REPNAME FOR '*' DELETE
IF #NOARSL.#POSTFIX NE 'Y'
  COMPRESS #NOARSL.#REPNAME H'FF' TO #MA-REPNAME-E LEAVING NO
  #MA-REPNAME := #NOARSL.#REPNAME
ELSE
  #MA-REPNAME-E := H'FF'
  #MA-REPNAME := ' '
END-IF
IF #CREAT-DATE-FROM = ' '
  MOVE EDITED '19000101000000' TO #F-DATE-C(EM=YYYYMMDDHHIISS)
ELSE
  IF #CREAT-TIME-FROM = ' '
    COMPRESS #CREAT-DATE-FROM '000000' TO #DATE-14 LEAVING NO
  ELSE
    COMPRESS #CREAT-DATE-FROM SUBSTR(#CREAT-TIME-FROM,1,4) '00'
      TO #DATE-14 LEAVING NO
  END-IF
  MOVE EDITED #DATE-14 TO #F-DATE-C(EM=YYYYMMDDHHIISS)
END-IF
IF #CREAT-DATE-TO = ' '
  MOVE EDITED '20991231235959' TO #T-DATE-C(EM=YYYYMMDDHHIISS)
ELSE
  IF #CREAT-TIME-TO = ' '
    COMPRESS #CREAT-DATE-TO '235959' TO #DATE-14 LEAVING NO
  ELSE
    COMPRESS #CREAT-DATE-TO SUBSTR(#CREAT-TIME-TO,1,4) '59'
      TO #DATE-14 LEAVING NO
  END-IF
  MOVE EDITED #DATE-14 TO #T-DATE-C(EM=YYYYMMDDHHIISS)
END-IF
EXAMINE #NOARSL.#KEYWORD FOR '*' DELETE
EXAMINE #NOARSL.#SOURCE FOR '*' DELETE
EXAMINE #NOARSL.#SENDER FOR '*' DELETE
COMPRESS #NOARSL.#SOURCE H'00' TO #SOURCE-F LEAVING NO
COMPRESS #NOARSL.#SOURCE H'FF' TO #SOURCE-T LEAVING NO
COMPRESS #NOARSL.#SENDER H'00' TO #SENDER-F LEAVING NO
COMPRESS #NOARSL.#SENDER H'FF' TO #SENDER-T LEAVING NO
IF #NOARSL.#REPNAME NE ' ' AND #NOARSL.#POSTFIX NE 'Y'
OR (#NOARSL.#REPNAME =  ' ' OR #NOARSL.#POSTFIX = 'Y')                /*
AND #CREAT-DATE-FROM = ' ' AND #CREAT-DATE-TO = ' '                   /*
  #MA-USERID-R := LINKED-FO.FO-USER-ID
  #MA-FO-ID-R  := LINKED-FO.FO-ID
  #ISTART-N := 1
  IF ES-KEY-PARM(2) NE ' '
    #MA-REPNAME := ES-KEY-PARM(3)
    #ISTART := ES-KEY-PARM(5)
    IF #ISTART NE MASK (N) OR NOT(#ISTART-N=1 THRU *OCC(#LOC-CODE))/*SU1
      #ISTART-N := 1 /*SU1
    END-IF /*SU1
  END-IF
  FA. FOR #ILOC = #ISTART-N TO 2
    IF #ILOC = 1
      IF #NOARSL.#ARCHIVE ='A' OR (#NOARSL.#LOCATION ='S' OR='D')
/*SU2 OR='C')
        ESCAPE TOP
      END-IF
    ELSE
      IF #NOARSL.#LOCATION = 'A' OR #NOARSL.#ARCHIVE = '*'
        ESCAPE TOP
      END-IF
    END-IF
    #IOUT  := #ILOC + 1
    #MA-CURRENT-LOC-R := #LOC-CODE(#ILOC)
    RMR. READ MA BY MA-LOC-USER-FOLDER-REP-RNB = #MA-L-FOLDER-REP
    STARTING WITH ISN = #ISN-N10                                      /*
      IF MA-CURRENT-LOCATION NE #LOC-CODE(#ILOC)
      OR MA-USERID NE #MA-USERID-R OR MA-FO-ID NE #MA-FO-ID-R         /*
      OR NOT (MA-REPNAME = #MA-REPNAME THRU #MA-REPNAME-E)            /*
        ESCAPE BOTTOM
      END-IF
      #AR-REPNAME := MA-REPNAME
      #AR-REPRNB  := MA-REPRNB
      FIND AR WITH AR-REPORT-RNB = #AR-REP-RNB
        PERFORM SELECT-RECORD
        IF #SELECTED
          #AR-EXIST(#IOUT) := '0'
          #AR-EXIST(1) := '0'
          ESCAPE BOTTOM (RMR.)
        END-IF
      END-FIND
      IF *TIMX > #TIMEOUT
        ES-KEY-PARM(1) := MA.MA-USERID
        #NEXT-FO-ID-N := MA.MA-FO-ID
        ES-KEY-PARM(2) := #NEXT-FO-ID
        ES-KEY-PARM(3) := MA-REPNAME
        #ISN-N10 := *ISN(RMR.)
        ES-KEY-PARM(4) := #ISN-A10
        #ISTART-N := #ILOC
        ES-KEY-PARM(5) := #ISTART
        ES-EOF     := ' '
        ES-SELECT := #NOARSL
        ESCAPE BOTTOM (FA.)
      END-IF
    END-READ
    IF #NOARSL.#POSTFIX NE 'Y'
      #MA-REPNAME := #NOARSL.#REPNAME
    ELSE
      #MA-REPNAME := ' '
    END-IF
    RESET ES-KEY-PARM(2:5)
  END-FOR
ELSE
  #MA-USERID := LINKED-FO.FO-USER-ID
  #MA-FO-ID  := LINKED-FO.FO-ID
  #MA-PROCESS-TIME-INV := #F-DATE-C-P
  #ISTART-N := 1
  IF ES-KEY-PARM(2) NE ' '
    #NEXT-TIME := ES-KEY-PARM(3)
    #MA-PROCESS-TIME-INV := #NEXT-TIME-N
    #ISTART := ES-KEY-PARM(5)
  END-IF
  FT. FOR #ILOC = #ISTART-N TO 2
    IF #ILOC = 1
      IF #NOARSL.#ARCHIVE ='A' OR (#NOARSL.#LOCATION ='S' OR='D')
/*SU2 OR='C')
        ESCAPE TOP
      END-IF
    ELSE
      IF #NOARSL.#LOCATION = 'A' OR #NOARSL.#ARCHIVE = '*'
        ESCAPE TOP
      END-IF
    END-IF
    #IOUT  := #ILOC + 1
    #MA-CURRENT-LOC := #LOC-CODE(#ILOC)
    RMT. READ MA BY MA-LOC-USER-FOLDER-PROCESS-TIME
    = #MA-LOC-USER-FOLDER-PROCESS-TIME STARTING WITH ISN = #ISN-N10   /*
      IF MA-CURRENT-LOCATION NE #LOC-CODE(#ILOC)
      OR  MA-USERID NE #MA-USERID OR MA-FO-ID NE #MA-FO-ID            /*
      OR  NOT (MA-PROCESS-TIME-INV = #F-DATE-C-P THRU #T-DATE-C-P)    /*
        ESCAPE BOTTOM
      END-IF
      #AR-REPNAME := MA-REPNAME
      #AR-REPRNB  := MA-REPRNB
      FIND AR WITH AR-REPORT-RNB = #AR-REP-RNB
        PERFORM SELECT-RECORD
        IF #SELECTED
          #AR-EXIST(#IOUT) := '0'
          #AR-EXIST(1) := '0'
          ESCAPE BOTTOM (RMT.)
        END-IF
      END-FIND
      IF *TIMX > #TIMEOUT
        ES-KEY-PARM(1) := MA.MA-USERID
        #NEXT-FO-ID-N := MA.MA-FO-ID
        ES-KEY-PARM(2) := #NEXT-FO-ID
        #NEXT-TIME-N := MA-PROCESS-TIME-INV
        ES-KEY-PARM(3) := #NEXT-TIME
        #ISN-N10 := *ISN(RMT.)
        ES-KEY-PARM(4) := #ISN-A10
        #ISTART-N := #ILOC
        ES-KEY-PARM(5) := #ISTART
        ES-EOF     := ' '
        ES-SELECT := #NOARSL
        ESCAPE BOTTOM (FT.)
      END-IF
    END-READ
    #MA-PROCESS-TIME-INV := #F-DATE-C-P
    RESET ES-KEY-PARM(2:5)
  END-FOR
END-IF
/*
#SETNAME := 'SETNAME'
ES-SELECT := #NOARSL
IF ES-EOF = 'X'
  RESET ES-KEY-PARM(2:5)
END-IF
*
END-SUBROUTINE /* CHECK-MAIL
*
************************************************************************
DEFINE SUBROUTINE SELECT-RECORD
************************************************************************
#SELECTED := TRUE
DECIDE FOR EVERY CONDITION
  WHEN #NOARSL.#SENDER NE ' '
  AND NOT (AR.AR-SENDER = #SENDER-F THRU #SENDER-T)                   /*
    #SELECTED := FALSE
    ESCAPE ROUTINE
* WHEN #NOARSL.#KEYWORD NE ' '                           /* HEB1 > -
*   #SELECTED := FALSE
*   EXAMINE #NOARSL.#KEYWORD FOR H'00' GIVING LENGTH #L
*   FOR #K = 1 TO 6
*     IF SUBSTR(AR.AR-KEYWORDS(#K),1,#L) = #NOARSL.#KEYWORD
*       #SELECTED := TRUE
*       ESCAPE BOTTOM
*     END-IF
*   END-FOR
*   IF NOT #SELECTED
*     ESCAPE ROUTINE
*   END-IF                                               /* HEB1 <
  WHEN #KY-SEL (*) NE ' '                                /* HEB1 > ++
    IF #KEYWORD-AND-OR NE 'A' /* OR
      FOR #K = 1 TO 6
        IF AR-KEYWORDS(#K) NE ' '
            AND (    SUBSTR(AR-KEYWORDS(#K),1,#L1) = #KY-SEL (1)
            OR SUBSTR(AR-KEYWORDS(#K),1,#L2) = #KY-SEL (2)
            OR SUBSTR(AR-KEYWORDS(#K),1,#L3) = #KY-SEL (3)
            OR SUBSTR(AR-KEYWORDS(#K),1,#L4) = #KY-SEL (4) )
          ESCAPE BOTTOM
        END-IF
      END-FOR
      IF #K > 6
        #SELECTED := FALSE
        ESCAPE ROUTINE
      END-IF
    ELSE                      /* AND
      IF  ( #KY-SEL (1) = ' '
          OR SUBSTR(AR-KEYWORDS(*),1,#L1) = #KY-SEL (1) )
          AND ( #KY-SEL (2) = ' '
          OR SUBSTR(AR-KEYWORDS(*),1,#L2) = #KY-SEL (2) )
          AND ( #KY-SEL (3) = ' '
          OR SUBSTR(AR-KEYWORDS(*),1,#L3) = #KY-SEL (3) )
          AND ( #KY-SEL (4) = ' '
          OR SUBSTR(AR-KEYWORDS(*),1,#L4) = #KY-SEL (4) )
        IGNORE
      ELSE
        #SELECTED := FALSE
        ESCAPE ROUTINE
      END-IF
    END-IF                                               /* HEB1 <
  WHEN NOT (AR.AR-PROCESS-TIME = #F-DATE-C THRU #T-DATE-C)
    #SELECTED := FALSE
    ESCAPE ROUTINE
  WHEN #NOARSL.#POSTFIX = 'Y' AND #NOARSL.#REPNAME NE ' ' AND
      AR.AR-REPNAME NE SCAN #NOARSL.#REPNAME
    #SELECTED := FALSE
    ESCAPE ROUTINE
  WHEN #NOARSL.#EXPIR-DATE NE ' ' AND
      AR.AR-EXPIRATION NE #NOARSL.#EXPIR-DATE
    #SELECTED := FALSE
    ESCAPE ROUTINE
  WHEN #NOARSL.#ARCHIVE NE ' ' AND
      #NOARSL.#ARCHIVE NE AR.AR-ARCHIVE
    #SELECTED := FALSE
    ESCAPE ROUTINE
  WHEN #NOARSL.#REVIVE NE ' ' AND #NOARSL.#REVIVE NE AR.AR-REVIVE
    #SELECTED := FALSE
    ESCAPE ROUTINE
  WHEN #NOARSL.#LOCATION NE ' ' AND
      #NOARSL.#LOCATION NE AR.AR-CURRENT-LOCATION
    #SELECTED := FALSE
  WHEN NONE IGNORE
END-DECIDE
*
END-SUBROUTINE /* SELECT-RECORD
*
************************************************************************
DEFINE SUBROUTINE GET-MSG-TXT
************************************************************************
RESET SHORT-MSG LONG-MSG(*)
VERSION := 0
NADA2000.OBJECT-KIND    := 'U'
NADA2000.ERROR-NUMBER   := ES-MSG-NR
NADA2000.OPT-INSERT-DYN := FALSE
NADA2000.OPT-LANGUAGE   := ES-LANGUAGE
NADA2000.LIBRARY        := ES-APP-SERVER-LIBRARY
CALLNAT 'NATA2000' NADA2000 NATA2000.EXTENDED-PARMS NAD-MSG NAD-FLD
ES-MSG-TXT   := SHORT-MSG
EXAMINE ES-MSG-TXT FOR #ES-MSG-PREF DELETE
ES-RC := 1
*
END-SUBROUTINE /* GET-MSG-TXT
*
END
