* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RCOPSC    COPY NATURAL SECURITY USERS
*
* MAINTENANCE:
* MB  91-02-20  F(106) PF12 'MENU' ADDED
* mrs 92-02-17  s(143553) several changes
* mrs 92-02-21  s(141159) support languages other than english
* mrs 92-06-10            use a callnat instead of reading security-file
* mrs 93-09-17            create folder
* gw  93-10-29  s(999999) message when natsec not installed
* gw  94-07-01  s(999999) SECQ bug - #SECQ-RLINES always 0 at end data
* gw  95-10-10  s(233472) attributes missing when copying
* gw  95-10-25  s(233472) default for system defaults is ' '
* jvd 97-09-30  p(164220) for NOM141 and NAT23 callnat to SECQ replace
*                         with callnat to NSCXR as this works with
*                         NAT22 and NAT23
* gw  98-07-22  s(999999) check existance of distribution list
* gw  98-08-10  p(164220) won't compile with secq-userid, take new field
* wcd 00-04-01 CE 7267   New PFkey for additional printers in RPFK---L
* xsiszha 2000-08-15 (CE7461) Extend Report and Bundle Names
* xsetggr 2007-11-15 p(298112) add user types 'O' and 'P'
* fhi     2010-09-03 NOMALL-97 Extend message line
* xsetggr 2012-11-15 NOMALL-89 add folder grants for default folder
* SU1     2013-01-31 unused      Deactivate unused data areas
* SU2     2013-09-16 NOMALL-1281 last update user+date
* SU3     2016-07-29 NOMALL-1518 NOM3.5 deactivate opt.Compiler
* SU4     2018-12-03 NOMALL-2182 Reject reserved names 'ADMIN'+'PUBLIC'
* ----------------------------------------------------------------------
DEFINE DATA
GLOBAL USING  NRM-GL
LOCAL  USING  PROF-LOC
LOCAL  USING  VUSERS-L
LOCAL  USING  RPFK---L
LOCAL  USING  XXGMSG-A
LOCAL  USING  RTXT---L
LOCAL  USING  VGRANT-L            /* xsetggr 2012-11-15 NOMALL-89 in
*
LOCAL
1 DISTRIBUTION-LIST VIEW OF NRM-DISTRIBUTION-LIST /*SU1 in
1 FOLDER    VIEW  OF  NRM-FOLDER
  2 FO-ID
  2 FO-USER-ID
  2 FO-NAME
*
1 #SCREEN
  2 #LINES                       (13)
    3 L-ID                       (A8)
    3 L-MSG                      (A7)
    3 L-NAME                     (A32)
    3 L-TYPE                     (A1)
    3 L-PROF
      4 L-REP                    (A1)
      4 L-BUN                    (A1)
      4 L-PRT                    (A1)
      4 L-USR                    (A1)
      4 L-ARP                    (A1)
      4 L-ABU                    (A1)
      4 L-ARC                    (A1)
      4 L-REV                    (A1)
      4 L-FLS                    (A1)
      4 L-MON                    (A1)
      4 L-POT                    (A1)
      4 L-DIS                    (A1)
      4 L-CAL                    (A1)
      4 L-PHY                    (A1)
      4 L-LAN                    (A1)
      4 L-CON                    (A1)
      4 L-EPR                    (A1)
      4 L-EKY                    (A1)
      4 L-EXT                    (A1)
    3 L-MARK                     (A2)
    3 CV-MARK                    (C)
  2 L-HEADER                     (A78)
  2 #BOTLINE                     (A15)
**
1 #DEFPRF                        (A8)
1 CV-DEFPRF                      (C)
1 SW-DEFPRF                      (L)
**
1 I                              (N3)
1 #NOFLINES                      (P2) INIT <013 >
1 #NOFPAGES                      (P2) INIT <010 >
1 #END-OF-DATA                   (L)
1 #DEFAULT-PROFILE               (A100)
***
1 #CP                            (P3)
1 #MAXP                          (P3)
1 #MAXAP                         (P3)
1 #NEWVAL                        (L)
1 #BACKWARD                      (L)
1 #FORWARD                       (L)
1 #TOP                           (L)
1 #BOT                           (L)
1 #START-VALUE                   (A32)
1 #RSTART                        (A32)
1 #LAST-KEY                      (A32)
1 #PAGES                         (A32/10)
1 CV-START                       (C)
1 #PF-KEY                        (A4)
1 #ALLOWED                       (L)
1 #FATHER-PROG                   (A8) INIT <'RADMIN'>
1 #TOK                           (A50/10)
1 #S-USERID                      (A25)
1 #S-USERID-F                    (A25)
1 #S-USERID-T                    (A25)
1 #LEN                           (N3)
1 #END-VALUE                     (A32)
1 GET-SCREEN                     (L)
1 #LANGUAGE                      (I1)
1 #SCROLL-AMOUNT                 (N3)
*
1 #NOL                           (P2)
1 NATSEC-ACTIVE                  (L)
1 END-OF-PROCESSING              (L)
1 #FOLDER-NAME                   (A70)
1 #FO-USER-FO-ID                 (A10)
1 REDEFINE    #FO-USER-FO-ID
  2 #FO-USER                     (A8)
  2 #FO-ID                       (B2)
1 #I                             (I4)
1 #NSCXR-PARMS
  2 #POBJ-TYPE                (A2) INIT <'US'>
  2 #POBJ-ID                  (A54)
  2 #PLINKID                  (A8)
  2 #PRC                      (N4) /* CONTAINS THE RETURN CODE.
  2 #SUBTYPE                  (A2) INIT <'*'>
  2 #PPARM                    (A20)
  2 REDEFINE #PPARM
    3 #PNOMAP                 (L)
    3 #PSLINES                (B1)
    3 #PRCOUNT                (B3)
    3 #PPFKEY                 (N2/1:4) /* PF-KEY MENTS.
  2 #PPARM2                   (A80/1:21)
  2 REDEFINE #PPARM2 /* IF POBJ-TYPE = 'US' PARAM. IS REDEF. AS
    3 #OBJECT                 (1:21)
      4 #OBJ-TYPE             (A4)
      4 #OBJ-ID               (A32)
      4 REDEFINE #OBJ-ID
        5 #OBJ-ID-USER        (A8) /* User-ID
      4 #OBJ-FILLER1          (A10)
      4 #OBJ-NAME             (A32) /* User Name.
      4 #OBJ-FILLER2          (A02)
*
1 #DISPLAY-OUTPUT             (A1) INIT<'N'>
1 #START-USER                 (A32)
1 #FO-ID-N                    (N5) /* xsetggr 2012-11-15 NOMALL-89 start
1 REDEFINE #FO-ID-N
  2 #FO-ID-A                  (A5) /* xsetggr 2012-11-15 NOMALL-89 end
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
/*SU3 OPTIONS MCG=OFF
*
CALLNAT 'NSC-ACT' NATSEC-ACTIVE
IF NOT NATSEC-ACTIVE
  G-NATRP-ERC := 23
  INCLUDE C-ESCAPE
END-IF
*
CALLNAT 'NARPSEC' G-USER-PROFILE 'MUS' #ALLOWED
INCLUDE C-NALLOW
RESET G-LINECOM (*)
*
* --- main logic
#NEWVAL := TRUE
#RSTART := 'U'
REPEAT
  IF #LANGUAGE NE *LANGUAGE
    #LANGUAGE := *LANGUAGE
    PERFORM INIT-PFKEYS
  END-IF
  PERFORM SET-PFKEYS
  PERFORM GET-SCREEN
  IF END-OF-PROCESSING
    INCLUDE C-ESCAPE
  END-IF
*
  IF G-NATRP-ERC = 0
    DECIDE FOR EVERY CONDITION
      WHEN #END-OF-DATA
        G-NATRP-ERC := 12
      WHEN #CP = 1  AND NOT #END-OF-DATA
        G-NATRP-ERC := 11
      WHEN #CP = 1  AND  #END-OF-DATA
        G-NATRP-ERC := 14
      WHEN NONE
        G-NATRP-ERC := 13
    END-DECIDE
  END-IF
*
  SET CONTROL 'WB'
  FORMAT KD=ON
  CALLNAT 'N-HEADER' L-HEADER G-DATE-FORMAT 'RCOPSCM&'
  PERFORM FLIP-DISPLAY
  INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT MARK *G-DIRECT-COMMAND
    USING MAP 'RCOPSCM&'
*
  RESET #FORWARD #BACKWARD #NEWVAL G-NATRP-ERT G-NATRP-ERC
  RESET #TOP #BOT #SCROLL-AMOUNT
  INCLUDE C-DIRECT
  INCLUDE C-LOCCMD
  #PF-KEY := *PF-KEY
*
* --- PF KEYS
  #PF-KEY := *PF-KEY
  DECIDE ON FIRST #PF-KEY
    VALUE 'PF1' REINPUT USING HELP
    VALUE 'PF4' PERFORM FLIP-HANDLE
    VALUE 'PF3'
      INCLUDE C-ESCAPE
    VALUE 'PF5'
      IF G-COMMIT
        END TRANSACTION
        RESET G-COMMIT
        G-NATRP-ERC := 15
      END-IF
    VALUE 'PF6'
      IF G-COMMIT
        BACKOUT TRANSACTION
        G-NATRP-ERC := 16
        GET-SCREEN := TRUE
        RESET G-COMMIT
      END-IF
    VALUE 'PF7' #BACKWARD := TRUE
    VALUE 'PF8' #FORWARD := TRUE
    VALUE 'PF12' FETCH 'RMENU' /* F(106)
    NONE VALUE IGNORE
  END-DECIDE
*
  IF CV-START MODIFIED
    #NEWVAL := TRUE
  END-IF
*
  IF CV-DEFPRF MODIFIED OR SW-DEFPRF
    RESET SW-DEFPRF
    IF #DEFPRF = ' '
      RESET #DEFAULT-PROFILE
    ELSE
      FINDPRF. FIND (1) USERS WITH USER-ID = #DEFPRF
        IF NO RECORDS FOUND
          REINPUT *0002, #DEFPRF MARK *#DEFPRF ALARM
        END-NOREC
        #DEFAULT-PROFILE := USER-PROFILE
      END-FIND
    END-IF
    GET-SCREEN := TRUE
    ESCAPE TOP
  END-IF
*
  PERFORM LINE-COMMANDS
**
END-REPEAT
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE GET-SCREEN
************************************************************************
RESET G-NATRP-ERT
DECIDE FOR EVERY  CONDITION
  WHEN GET-SCREEN
    IGNORE
  WHEN #NEWVAL
    PERFORM INIT-SELECTION-KEYS
    RESET #PAGES(*) #MAXP #MAXAP
    #PAGES (1) := #START-VALUE
    #CP := 1
    #MAXAP := 1
  WHEN #BOT
    #CP := #MAXAP
  WHEN #TOP
    #CP := 1
  WHEN #FORWARD
    IF #END-OF-DATA
      ESCAPE ROUTINE
    END-IF
    IF #CP = #NOFPAGES
      #PAGES(1 : #NOFPAGES - 1) := #PAGES(2 : #NOFPAGES)
      RESET #PAGES(#CP)
      #PAGES(#CP) := #LAST-KEY
    ELSE
      IF #SCROLL-AMOUNT < 1
        #SCROLL-AMOUNT := 1
      END-IF
      IF #CP + #SCROLL-AMOUNT <= #MAXAP
        ADD #SCROLL-AMOUNT TO #CP
      ELSE
        IF #SCROLL-AMOUNT > 1
          #CP := #MAXAP
        ELSE
          ADD 1 TO #CP
        END-IF
      END-IF
      IF #CP > #MAXAP
        #PAGES(#CP) := #LAST-KEY
      END-IF
    END-IF
  WHEN #BACKWARD
    IF #CP < 2
      IGNORE
    ELSE
      IF #SCROLL-AMOUNT < 1
        #SCROLL-AMOUNT := 1
      END-IF
      SUBTRACT #SCROLL-AMOUNT FROM #CP
      IF #CP < 1
        #CP := 1
      END-IF
    END-IF
  WHEN NONE ESCAPE ROUTINE
END-DECIDE
*
IF #CP >= #MAXAP
  #MAXAP := #CP
END-IF
*
#RSTART := #PAGES(#CP)
*
RESET I #SCREEN #END-OF-DATA
CV-MARK(*) := (AD=P)
*
*
#OBJ-ID-USER (21) := #PAGES (#CP)
#PSLINES := #NOFLINES
#DISPLAY-OUTPUT := 'Y'
#START-USER :=  #OBJ-ID-USER(21)
CALLNAT 'NSCXR' #NSCXR-PARMS
*
* SECQ bug - at end of data #SECQ-RLINES is always 0
IF #PRCOUNT  = 0
  FOR #I  1 #NOFLINES
    IF #OBJ-ID-USER (#I) = ' '
      #PRCOUNT := #I - 1
      ESCAPE BOTTOM
    END-IF
  END-FOR
END-IF
*
IF #PRC NE 0
  PERFORM SECQ-ERROR-HANDLING
  END-OF-PROCESSING := TRUE
  ESCAPE ROUTINE
END-IF
*
IF #PRCOUNT < #NOFLINES OR #OBJ-ID-USER (21) = ' '
  #END-OF-DATA := TRUE
  #MAXP := #CP
  #NOL := #PRCOUNT
ELSE
  #LAST-KEY := #OBJ-ID-USER (21)
  #NOL := #NOFLINES
END-IF
*
FOR I = 1 TO #NOL
  IF #OBJ-ID-USER (I) = ' '
    ESCAPE TOP
  END-IF
*
  IF #OBJ-ID-USER (I) > #S-USERID-T
    #END-OF-DATA := TRUE
    #MAXP := #CP
    ESCAPE BOTTOM
  END-IF
*
  L-ID(I) := #OBJ-ID-USER   (I)
  L-NAME(I) := #OBJ-NAME (I)
  LIST. FIND NUMBER DISTRIBUTION-LIST WITH D-LIST-NAME = #OBJ-ID-USER(I)
  IF *NUMBER (LIST.) NE 0
    CV-MARK(I) := (AD=P)
    L-MSG(I) := 'DistrLst'
    ESCAPE TOP
  END-IF
  FINDNUM. FIND NUMBER USERS WITH USER-ID = #OBJ-ID-USER (I)
  IF *NUMBER(FINDNUM.) > 0
    CV-MARK(I) := (AD=P)
    L-MSG(I) := 'Defined'
  ELSE
    RESET CV-MARK(I) L-MSG(I) L-PROF(I)
    IF #DEFAULT-PROFILE EQ ' '
      L-REP(I) := L-BUN(I) := 'P'
      L-PRT(I) := 'D'
      L-USR(I) := ' '
      L-MON(I) := L-FLS(I) := 'N'
      L-ARC(I) := L-REV(I) := 'Y'
      L-ARP(I) := L-ABU(I) := 'M'
      L-TYPE (I) := 'G'
      L-DIS (I) := 'P'
      L-CAL (I) := 'D'
      L-PHY (I) := 'D'
      L-POT (I) := 'M'
      L-LAN (I) := *LANGUAGE
      L-CON (I) := 'Y'
      L-EPR (I) := 'Y'
      L-EKY (I) := 'Y'
      L-EXT (I) := 'Y'
    ELSE
      PROFILE-STRING := #DEFAULT-PROFILE
      L-REP (I) := PROFILE-STRING.PROF-REPORTS
      L-BUN (I) := PROFILE-STRING.PROF-BUNDLES
      L-PRT (I) := PROFILE-STRING.PROF-PRINTERS
      L-USR (I) := PROFILE-STRING.PROF-USERS
      L-ARP (I) := PROFILE-STRING.PROF-AREPS
      L-ABU (I) := PROFILE-STRING.PROF-ABUNDS
      L-ARC (I) := PROFILE-STRING.PROF-ARCHIVE
      L-REV (I) := PROFILE-STRING.PROF-REVIVE
      L-FLS (I) := PROFILE-STRING.PROF-FLUSH
      L-DIS (I) := PROFILE-STRING.PROF-LISTS
      L-CAL (I) := PROFILE-STRING.PROF-CALENDARS
      L-PHY (I) := PROFILE-STRING.PROF-PHYSICAL
      L-POT (I) := PROFILE-STRING.PROF-PRINTOUTS
      L-TYPE (I) := PROFILE-STRING.PROF-TYPE
      L-LAN (I) := PROFILE-STRING.PROF-LANGUAGE
      L-CON (I) := PROFILE-STRING.PROF-CONFIRM
      L-EPR (I) := PROFILE-STRING.PROF-EDT-PREFIX
      L-EKY (I) := PROFILE-STRING.PROF-EDT-KEYS
      L-EXT (I) := PROFILE-STRING.PROF-EXTERNAL
    END-IF
  END-IF
*
END-FOR
*
END-SUBROUTINE /* GET-SCREEN
*
************************************************************************
DEFINE SUBROUTINE LINE-COMMANDS
************************************************************************
FOR I 1 TO #NOFLINES
  IF CV-MARK(I) MODIFIED
    USERS.USER-ID := L-ID(I)
    SEPARATE L-NAME(I) LEFT INTO USERS.FIRST-NAME USERS.LAST-NAME
      #TOK(1:10) WITH DELIMITER ','
    RESET L-MARK (I)
    DECIDE FOR FIRST CONDITION
      WHEN USERS.USER-ID = 'ADMIN' /*SU4 ->
        REINPUT *0517 MARK *L-ID(I) ALARM
      WHEN USERS.USER-ID = 'PUBLIC'
        REINPUT *0518 MARK *L-ID(I) ALARM
      WHEN NOT(USERS.USER-ID = MASK (A) OR= MASK (0-9))
        REINPUT *0022 MARK *L-ID(I) ALARM /*SU4 <-
      WHEN NOT(L-TYPE (I) = 'A' OR = 'G' OR = 'O' OR = 'P')
        REINPUT *0620 MARK *L-TYPE (I) ALARM
      WHEN NOT(L-REP (I)  = 'D' OR = 'M' OR = 'P' OR = ' ')
        REINPUT *0617 MARK *L-REP (I) ALARM
      WHEN NOT(L-CAL (I)  = 'D' OR = 'M' OR = 'P' OR = ' ')
        REINPUT *0617 MARK *L-CAL (I) ALARM
      WHEN NOT(L-BUN (I)  = 'D' OR = 'M' OR = 'P' OR = ' ')
        REINPUT *0617 MARK *L-BUN (I) ALARM
      WHEN NOT(L-FLS (I)  = 'Y' OR = 'N'  OR = ' ')
        REINPUT *0618 MARK *L-FLS (I) ALARM
      WHEN NOT(L-USR (I)  = 'D' OR = 'M' OR = 'P' OR = ' ')
        REINPUT *0617 MARK *L-USR (I) ALARM
      WHEN NOT(L-ARP (I)  = 'D' OR = 'M' OR = 'P' OR = ' ')
        REINPUT *0617 MARK *L-ARP (I) ALARM
      WHEN NOT(L-PRT (I)  = 'D' OR = 'M' OR = 'P' OR = ' ')
        REINPUT *0617 MARK *L-PRT (I) ALARM
      WHEN NOT(L-PHY (I)   = 'D' OR = 'M' OR = 'P' OR = ' ')
        REINPUT *0617 MARK *L-PHY (I) ALARM
      WHEN NOT(L-ARC (I)   = 'Y' OR = 'N' OR = ' ')
        REINPUT *0618 MARK *L-ARC (I) ALARM
      WHEN NOT(L-REV (I)   = 'Y' OR = 'N' OR = ' ')
        REINPUT *0618 MARK *L-REV (I) ALARM
      WHEN NOT(L-ABU (I)   = 'D' OR = 'M' OR = 'P' OR = ' ')
        REINPUT *0617 MARK *L-ABU (I)  ALARM
      WHEN NOT(L-POT (I)   = 'D' OR = 'M' OR = 'P' OR = ' ')
        REINPUT *0617 MARK *L-POT (I) ALARM
      WHEN NOT(L-DIS (I)   = 'D' OR = 'M' OR = 'P' OR = ' ')
        REINPUT *0617 MARK *L-DIS (I) ALARM
      WHEN NONE
        IGNORE
    END-DECIDE
    RESET PROFILE-STRING
    PROFILE-STRING.PROF-REPORTS   := L-REP (I)
    PROFILE-STRING.PROF-BUNDLES   := L-BUN (I)
    PROFILE-STRING.PROF-PRINTERS  := L-PRT (I)
    PROFILE-STRING.PROF-USERS     := L-USR (I)
    PROFILE-STRING.PROF-AREPS     := L-ARP (I)
    PROFILE-STRING.PROF-ABUNDS    := L-ABU (I)
    PROFILE-STRING.PROF-ARCHIVE   := L-ARC (I)
    PROFILE-STRING.PROF-REVIVE    := L-REV (I)
    PROFILE-STRING.PROF-FLUSH     := L-FLS (I)
    PROFILE-STRING.PROF-LISTS     := L-DIS (I)
    PROFILE-STRING.PROF-CALENDARS := L-CAL (I)
    PROFILE-STRING.PROF-PHYSICAL  := L-PHY (I)
    PROFILE-STRING.PROF-PRINTOUTS := L-POT (I)
    PROFILE-STRING.PROF-TYPE      := L-TYPE (I)
    IF L-TYPE (I) = 'G'
      PROFILE-STRING.PROF-ARCHIVE-ADMIN := 'N'
      PROFILE-STRING.PROF-DEFAULTS := ' '
      PROFILE-STRING.PROF-STARTUP  := 'N'
      PROFILE-STRING.PROF-SHUTDOWN := 'N'
    ELSE
      PROFILE-STRING.PROF-ARCHIVE-ADMIN := 'Y'
      PROFILE-STRING.PROF-DEFAULTS := 'M'
      PROFILE-STRING.PROF-STARTUP  := 'Y'
      PROFILE-STRING.PROF-SHUTDOWN := 'Y'
    END-IF
    PROFILE-STRING.PROF-AUTOCOMMIT := 'E'
    PROFILE-STRING.PROF-LANGUAGE   := L-LAN (I)
    PROFILE-STRING.PROF-CONFIRM    := L-CON (I)
    PROFILE-STRING.PROF-EDT-PREFIX := L-EPR (I)
    PROFILE-STRING.PROF-EDT-KEYS   := L-EKY (I)
    PROFILE-STRING.PROF-EXTERNAL   := L-EXT (I)
    USERS.USER-PROFILE := PROFILE-STRING
    US-LAST-UPDATE      := *TIMX /*SU2 in
    US-LAST-UPDATE-USER := G-USERID /*SU2 in
    PERFORM ADD-FOLDER
    STORE USERS
    IF G-AUTOCOMMIT = 'I'
      END TRANSACTION
    ELSE
      G-COMMIT := TRUE
    END-IF
    L-MSG(I) := 'Defined'
    CV-MARK(I) := (AD=P)
  END-IF
END-FOR
*
END-SUBROUTINE /* LINE-COMMANDS
*
************************************************************************
DEFINE SUBROUTINE INIT-SELECTION-KEYS
************************************************************************
#LEN := 8
CALLNAT 'SELALPHA' #S-USERID #S-USERID-F #S-USERID-T #LEN
#START-VALUE := #S-USERID-F
COMPRESS 'U' #S-USERID-T TO #END-VALUE LEAVING NO
*
END-SUBROUTINE /* INIT-SELECTION-KEYS
*
************************************************************************
DEFINE SUBROUTINE INIT-PFKEYS
************************************************************************
INCLUDE RPFSTD-C
INCLUDE RPFBRW-C
INCLUDE RPFCOM-C
CALLNAT 'RPFINI-N' G-PF G-PFB
END-SUBROUTINE
INCLUDE RPFSET-C
DEFINE SUBROUTINE SECQ-ERROR-HANDLING
IF #PRC < 0
  #XX-ERROR-TYPE := 'N'
  #XX-ERROR-CODE := #PRC * (-1)
  RESET   #XX-ERROR-APPL
ELSE
  #XX-ERROR-APPL := 'SYSSEC'
  #XX-ERROR-CODE := #PRC
END-IF
CALLNAT 'XXGMSG-N' #XX-GMSG-PARMS
G-NATRP-ERT := #XX-SHORT-TEXT
G-NATRP-ERC := 5
*
END-SUBROUTINE /* SECQ-ERROR-HANDLING
*
************************************************************************
DEFINE SUBROUTINE ADD-FOLDER
************************************************************************
CALLNAT 'RLTINI-N' ##TXT-INBASKET #FOLDER-NAME G-TXB
*
#FO-USER := USERS.USER-ID
#FO-ID   := 1
*
FNDFO. FIND FOLDER WITH FO-USER-FO-ID = #FO-USER-FO-ID
*
  IF NO RECORDS FOUND
    FO-USER-ID := USERS.USER-ID
    FO-ID      := 1
    FO-NAME    := #FOLDER-NAME
    STORE FOLDER
* xsetggr 2012-11-15 NOMALL-89 start
    #FO-ID-N := FO-ID
    COMPRESS FO-USER-ID #FO-ID-A TO GR-OBJECT-NAME LEAVING NO
    GR-OBJECT-TYPE := 'F'
    GR-USERID      := FO-USER-ID
    GR-OPTION(*)   := 'Y'
    STORE GRANTS                /* xsetggr 2012-11-15 NOMALL-89 end
  END-NOREC
*
END-FIND
*
END-SUBROUTINE /* ADD-FOLDER
*
END
