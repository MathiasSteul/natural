* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RMIGFOXR - list linked folders of the folder
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* xsisggr 2011-01-31 NOMALL-851 created from RMIGRPXR
* SU1     2024-04-29 NOM 36      remove unused
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 #P-MSG             (N4)
1 #PARMS
  2 #P-USER-NAME     (A24)
  2 #P-LINKED
    3 #P-LINKED-USER (A8)
    3 #P-LINKED-NAME (A16)
    3 #P-LINKED-MSG  (A4)
1 #LAN-TEXT          (A70/1:5)
************************************************************************
LOCAL
1 FOLDER VIEW OF NRM-FOLDER
/*SU1 2 FO-NAME 2 FO-USER-FO-ID
  2 FO-LINKED-FO-ID   (A10)
  2 REDEFINE FO-LINKED-FO-ID
    3 FO-LINKED-USER  (A8)
    3 FO-LINKED-ID    (B2)
1 LINKED-FO VIEW OF NRM-FOLDER
/*SU1 2 FO-ID
  2 FO-NAME
1 MIGRATE-FOLDER VIEW OF NRM-MIGRATE-FOLDER
*
1 #I                  (I2)
/*SU1 1 #J (I2) 1 #FO-USER-NAME-E (A24) 1 #FO-USER-ID (A10)
1 #FO-USER-NAME       (A24)
1 REDEFINE #FO-USER-NAME
  2 #FO-USER          (A8)
  2 #FO-NAME          (A16)
/*SU1 1 #SUPER (A34) 1 REDEFINE #SUPER 2 #SP-OBJECT-TYPE   (A1)
/*SU1 2 #SP-USERID (A8) 2 #SP-OBJECT-NAME   (A25)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET #P-MSG
FNDS. FIND FOLDER WITH FO-USER-NAME = #P-USER-NAME
  IF NO RECORDS FOUND
    #P-MSG := 4034     /* folder not found in source DB
    ESCAPE BOTTOM (FNDS.)
  END-NOREC
  PERFORM CHECK-LINKED-FOLDERS
END-FIND
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE CHECK-LINKED-FOLDERS
************************************************************************
RESET #P-LINKED #I
*
IF FOLDER.FO-LINKED-FO-ID > ' '
  #P-LINKED-USER := FOLDER.FO-LINKED-USER
  FIND LINKED-FO WITH FO-USER-FO-ID = FOLDER.FO-LINKED-FO-ID
    #P-LINKED-NAME    := LINKED-FO.FO-NAME
    #FO-NAME          := LINKED-FO.FO-NAME
    #FO-USER          := FOLDER.FO-LINKED-USER
    FNDFL.
    FIND NUMBER MIGRATE-FOLDER WITH FO-USER-NAME = #FO-USER-NAME
    IF *NUMBER (FNDFL.) = 0
      #P-LINKED-MSG  := #LAN-TEXT (2)
    ELSE
      #P-LINKED-MSG  := #LAN-TEXT (1)
    END-IF
  END-FIND
END-IF
*
END-SUBROUTINE /* CHECK-LINKED-FOLDERS
*
END
