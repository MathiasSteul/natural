* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
************************************************************************
* Version   3.5
* Function  Get enhanced printable IDENT field from IDENT and FILLER1
*           Invoke via: F#GETIDENT <IDENT,FILLER1>
* ----------------------------------------------------------------------
* Maintenance
* -----------
* uuuuuu  yyyy-mm-dd iTrac       Remark
* fhi     2019-06-14 NOMALL-2267 Created
* fhi     2019-06-14 NOMALL-2267 Still minor errors
************************************************************************
*
DEFINE FUNCTION F#GETIDENT RETURNS #IDENT-TEXT (A50)
  DEFINE DATA PARAMETER
  1 IDENT   (A8)  BY VALUE /* NOM identification in key
  1 FILLER1 (A17) BY VALUE
  LOCAL
  1 #PRINTABLE (A25)
  1 #MASK      (A25)
  1 #L         (I4)
  END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
MOVE ALL 'P' TO #MASK
COMPRESS IDENT FILLER1 TO #IDENT-TEXT LEAVING NO
EXAMINE #IDENT-TEXT FOR ' ' GIVING LENGTH IN #L
#PRINTABLE := SUBSTR(#MASK,1,#L)
IF #IDENT-TEXT NE MASK #PRINTABLE
  MOVE EDITED #IDENT-TEXT (EM=H(25)) TO #IDENT-TEXT
END-IF
*
END-FUNCTION /*F#GETIDENT
*
END
