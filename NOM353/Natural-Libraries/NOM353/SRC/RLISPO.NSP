************************************************************************
* Main line
************************************************************************
*
DEFINE WINDOW WARNING
*
#G-USERID := G-USERID
IF G-USER-TYPE ='A' OR='P' OR +G-USER-TYPE = 'O'
  CV-USERID := (AD=I CD=NE)
  #G-USERID := '*'
ELSE
  CV-USERID := (AD=P CD=TU)
END-IF
*
INCLUDE CVIDEO
/*SU2 INCLUDE CSTARTLS
*
RESET G-COMMIT
*
CALLNAT 'NARPSEC' G-USER-PROFILE 'DPO' #ALLOWED
INCLUDE C-NALLOW
*
CALLNAT 'NARPSEC' G-USER-PROFILE 'MPO' #UPDATE
CALLNAT 'NARPSEC' G-USER-PROFILE 'PPO' #DELETE
*
G-C-OBJTYPE := 'PRINTOU'
IF *DATA > 0
  INPUT #S-REPNAME #S-PID
END-IF
IF #S-PID = ' ' AND #S-REPNAME = ' '
  #S-REPNAME := +G-RLISPO-SEL-REPNAME
  #S-PID     := +G-RLISPO-SEL-PID
ELSE
  +G-RLISPO-SEL-REPNAME := #S-REPNAME
  +G-RLISPO-SEL-PID       := #S-PID
END-IF
#NEWVAL := TRUE
RESET #LIST-PROCESSED
*
MAIN-LOOP. REPEAT
  IF #LANGUAGE NE *LANGUAGE
    CALLNAT 'ROTINI-N' ##EQO-PRINTOUT G-OBJ-TYPE G-OTB
    PERFORM INIT-PFKEYS
    PERFORM INIT-LINECOM
    #LANGUAGE := *LANGUAGE
    RESET #LIST-PROCESSED
  END-IF
*
  PERFORM SET-PFKEYS
*
  INCLUDE RMVHLP-C
  PERFORM GET-SCREEN
*
  RESET GET-SCREEN
  INCLUDE C-TOPBOT
  CALLNAT 'RFLIPG-N' G-LC G-LINECOM (*)
  CALLNAT 'N-HEADER' L-HEADER G-DATE-FORMAT 'RLISPOM&'
  PERFORM FLIP-DISPLAY
  SET CONTROL 'WB'
  RESET #WARNING
  DECIDE ON FIRST #PANNEL-NO
    VALUE 2
      IF G-DISPLAY-LONG-NAMES
        INPUT WITH TEXT *G-NATRP-ERC, G-NATRP-ERT MARK *G-DIRECT-COMMAND
          USING MAP 'RLISPO4&'
      ELSE
        INPUT WITH TEXT *G-NATRP-ERC, G-NATRP-ERT MARK *G-DIRECT-COMMAND
          USING MAP 'RLISPO7&'
      END-IF
    VALUE 3
      IF G-DISPLAY-LONG-NAMES
        INPUT WITH TEXT *G-NATRP-ERC, G-NATRP-ERT MARK *G-DIRECT-COMMAND
          USING MAP 'RLISPO8&'
      ELSE
        INPUT WITH TEXT *G-NATRP-ERC, G-NATRP-ERT MARK *G-DIRECT-COMMAND
          USING MAP 'RLISPO2&'
      END-IF
    VALUE 4
      INPUT WITH TEXT *G-NATRP-ERC, G-NATRP-ERT MARK *G-DIRECT-COMMAND
        USING MAP 'RLISPO6&'
    NONE VALUE
      IF G-DISPLAY-LONG-NAMES
        INPUT WITH TEXT *G-NATRP-ERC, G-NATRP-ERT MARK *G-DIRECT-COMMAND
          USING MAP 'RLISPOL&'
      ELSE
        INPUT WITH TEXT *G-NATRP-ERC, G-NATRP-ERT MARK *G-DIRECT-COMMAND
          USING MAP 'RLISPOM&'
      END-IF
  END-DECIDE
  RESET G-NATRP-ERC G-NATRP-ERT
  #LIST-PROCESSED := TRUE
*
  INCLUDE RPFKVA-C
*
  PERFORM LOCAL-DIRECT-COMMAND
  INCLUDE C-DIRECT
  RESET #FORWARD #BACKWARD #TOP #BOT #NEWVAL G-NATRP-ERC G-NATRP-ERT
    #SCROLL-AMOUNT
  INCLUDE C-LOCCMD
  INCLUDE RPFKEX-C
*
  DECIDE ON FIRST VALUE OF G-PF-FUNC
    VALUE 'RIGHT'
      IF #PANNEL-NO < 4
        ADD 1 TO #PANNEL-NO
        IF NOT G-DISPLAY-LONG-NAMES AND #PANNEL-NO = 4
          #PANNEL-NO := 3
        END-IF
      END-IF
    VALUE 'LEFT'
      IF #PANNEL-NO > 1
        SUBTRACT 1 FROM #PANNEL-NO
      END-IF
    VALUE 'EXT'
      IF G-DISPLAY-LONG-NAMES
        G-DISPLAY-LONG-NAMES := FALSE
        IF #PANNEL-NO = 4
          #PANNEL-NO := 3
        END-IF
      ELSE
        G-DISPLAY-LONG-NAMES := TRUE
      END-IF
      RESET #LANGUAGE
/*SU7  VALUE 'BULK' PERFORM MODIFY-BULK ESCAPE TOP
    VALUE 'ENTR'
      IF #CP = 1
        #NEWVAL := TRUE
      ELSE
        GET-SCREEN := TRUE
      END-IF
    NONE VALUE
      IGNORE
  END-DECIDE
*
  PERFORM LINE-COMMANDS
  IF CV-SELECTION (*) MODIFIED
    +G-RLISPO-SEL-REPNAME := #S-REPNAME
    +G-RLISPO-SEL-PID       := #S-PID
    #NEWVAL := TRUE
  END-IF
*
END-REPEAT
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE GET-SCREEN
************************************************************************
IF (G-USER-TYPE ='A' OR='P' OR +G-USER-TYPE = 'O') AND #G-USERID = '*'
  PERFORM GET-SCREEN-ALL
  ESCAPE ROUTINE
END-IF
*
RESET L-MARK (*) L-IDENT (*)
*
DECIDE FOR EVERY  CONDITION
  WHEN #NEWVAL
    PERFORM INIT-SELECTION-KEYS
    #LS-USERID := #USERID-F
    RESET #LS-POID #PAGES(*) #MAXP #MAXAP
    #PAGES(1) := #LS-SUPER
    #CP := 1
    #MAXAP := 1
  WHEN #BOT
    RESET #I
    READ PRINTOUTS BY PO-USERID-POIDINV = #PAGES(#CP)
      IF (PRINTOUTS.PO-STATUS NE #S-STAT AND NOT(#S-STAT ='*' OR=' '))
      OR (NOT(PRINTOUTS.PO-REPNAME EQ #S-REPNAME-F THRU #S-REPNAME-T) /*
        AND PRINTOUTS.PO-REPNAME NE ' ')                              /*
      OR (NOT(PRINTOUTS.PO-BUNDLE  EQ #S-REPNAME-F THRU #S-REPNAME-T) /*
        AND PRINTOUTS.PO-REPNAME = ' ')                               /*
      OR (PRINTOUTS.PO-HOLD NE #S-HOLD AND NOT(#S-HOLD=' ' OR = '*')) /*
      OR (PRINTOUTS.PO-CLASS NE #S-CLASS AND NOT(#S-CLASS=' ' OR = '*'))
      OR (NOT(PRINTOUTS.PO-LOGICAL EQ #S-PID-F THRU #S-PID-T))        /*
      OR (NOT(PRINTOUTS.PO-FORM EQ #S-FORM-F THRU #S-FORM-T))         /*
      OR (NOT(PRINTOUTS.PO-DESTINATION EQ #S-DEST-F THRU #S-DEST-T))  /*
        ESCAPE TOP
      END-IF
      ADD 1 TO #I
      IF #I = 16
        IF #CP = #NOFPAGES
          #PAGES (2:#NOFPAGES - 1) := #PAGES (3:#NOFPAGES)
          #LK-USERID := PO-USERID
          #LK-POID           := PO-ID-INV
          RESET #PAGES(#CP)
          #PAGES (#CP) := #LAST-KEY
        ELSE
          IF #SCROLL-AMOUNT < 1
            #SCROLL-AMOUNT := 1
          END-IF
          IF #CP + #SCROLL-AMOUNT <= #MAXAP
            ADD #SCROLL-AMOUNT TO #CP
          ELSE
            IF #SCROLL-AMOUNT > 1
              #CP := #MAXAP
            ELSE
              ADD 1 TO #CP
            END-IF
          END-IF
          IF #CP > #MAXAP
            #LK-USERID  := PO-USERID
            #LK-POID    := PO-ID-INV
            #PAGES(#CP) := #LAST-KEY
          END-IF
        END-IF
        #I := 1
      END-IF
    END-READ
    #MAXAP := #CP
    #CP := 1
    #CP := #MAXAP
  WHEN #TOP
    #CP := 1
  WHEN #FORWARD
    IF #END-OF-DATA
      ESCAPE ROUTINE
    END-IF
    IF #CP = #NOFPAGES
      #PAGES(1 : #NOFPAGES - 1) := #PAGES(2 : #NOFPAGES)
      RESET #PAGES(#CP)
      #PAGES(#CP) := #LAST-KEY
    ELSE
      IF #SCROLL-AMOUNT < 1
        #SCROLL-AMOUNT := 1
      END-IF
      IF #CP + #SCROLL-AMOUNT <= #MAXAP
        ADD #SCROLL-AMOUNT TO #CP
      ELSE
        IF #SCROLL-AMOUNT > 1
          #CP := #MAXAP
        ELSE
          ADD 1 TO #CP
        END-IF
      END-IF
      IF #CP > #MAXAP
        #PAGES(#CP) := #LAST-KEY
      END-IF
    END-IF
  WHEN #BACKWARD
    IF #CP GE 2
      IF #SCROLL-AMOUNT < 1
        #SCROLL-AMOUNT := 1
      END-IF
      SUBTRACT #SCROLL-AMOUNT FROM #CP
      IF #CP < 1
        #CP := 1
      END-IF
    END-IF
  WHEN GET-SCREEN
    IGNORE
  WHEN NONE
    ESCAPE ROUTINE
END-DECIDE
*
IF #CP >= #MAXAP
  #MAXAP := #CP
END-IF
*
#RSTART := #PAGES(#CP)
*
RESET I L-SCREEN (*) #END-OF-DATA
CV-MARK (*) := (AD=P)
*
READ-LOOP. READ PRINTOUTS BY PO-USERID-POIDINV = #RSTART
  AT START OF DATA
    #TK-USERID := PO-USERID
    #TK-POID := PO-ID-INV
  END-START
  IF (G-USER-TYPE NE 'A' AND PO-USERID NE #G-USERID
  AND +G-USER-TYPE NE 'O' AND G-USER-TYPE NE 'P')                     /*
  OR ((G-USER-TYPE ='A' OR='P' OR +G-USER-TYPE = 'O')                 /*
  AND NOT(PO-USERID = #USERID-F THRU #USERID-T))                      /*
    ESCAPE BOTTOM
  END-IF
*
  PERFORM FILTER-RECORD
  REJECT IF NOT DISPLAY-IT
*
  ADD 1 TO I
  IF I > #NOFLINES
    #LK-USERID := PO-USERID
    #LK-POID := PO-ID-INV
    ESCAPE ROUTINE
  END-IF
*
  IF I = 1
    #PK-USERID(#CP) := PO-USERID
    #PK-POID(#CP) := PO-ID-INV
  END-IF
*
  #TK-USERID := PO-USERID
  #TK-POID := PO-ID-INV
  L-USERID(I) := PO-USERID
  PERFORM PROCESS-RECORD
  L-ISN(I) := *ISN(READ-LOOP.)
*
END-READ
#END-OF-DATA := TRUE
#MAXP := #CP
*
END-SUBROUTINE /* GET-SCREEN
*
************************************************************************
DEFINE SUBROUTINE GET-SCREEN-ALL
************************************************************************
RESET L-MARK(*)
DECIDE FOR EVERY  CONDITION
  WHEN #NEWVAL
    PERFORM INIT-SELECTION-KEYS
    RESET #LSA-SUPER #PAGESA(*) #MAXP #MAXAP
    #PAGESA(1) := #LSA-SUPER
    #CP := 1
    #MAXAP := 1
  WHEN #BOT
    #I := 0
    READ PRINTOUTS BY PO-ID-INV = #PAGESA(#CP)
      IF (PRINTOUTS.PO-STATUS NE #S-STAT AND NOT(#S-STAT = '*' OR=' '))
      OR (NOT(PRINTOUTS.PO-REPNAME EQ #S-REPNAME-F THRU #S-REPNAME-T) /*
        AND PRINTOUTS.PO-REPNAME NE ' ')                              /*
      OR (NOT(PRINTOUTS.PO-BUNDLE = #S-REPNAME-F THRU #S-REPNAME-T)   /*
        AND PRINTOUTS.PO-REPNAME = ' ')                               /*
      OR (PRINTOUTS.PO-HOLD NE #S-HOLD AND NOT(#S-HOLD=' ' OR='*'))   /*
      OR (PRINTOUTS.PO-CLASS NE #S-CLASS AND NOT(#S-CLASS=' ' OR='*'))/*
      OR (NOT(PRINTOUTS.PO-LOGICAL EQ #S-PID-F THRU #S-PID-T))        /*
        OR (NOT(PRINTOUTS.PO-FORM EQ #S-FORM-F THRU #S-FORM-T))       /*
      OR (NOT(PRINTOUTS.PO-DESTINATION EQ #S-DEST-F THRU #S-DEST-T))  /*
        ESCAPE TOP
      END-IF
      ADD 1 TO #I
      IF #I = 16
        IF #CP = #NOFPAGES
          #PAGESA (2:#NOFPAGES - 1) := #PAGESA (3:#NOFPAGES)
          #LKA := PO-ID-INV
          RESET #PAGESA(#CP)
          #PAGESA(#CP) := #LKA
        ELSE
          IF #SCROLL-AMOUNT < 1
            #SCROLL-AMOUNT := 1
          END-IF
          IF #CP + #SCROLL-AMOUNT <= #MAXAP
            ADD #SCROLL-AMOUNT TO #CP
          ELSE
            IF #SCROLL-AMOUNT > 1
              #CP := #MAXAP
            ELSE
              ADD 1 TO #CP
            END-IF
          END-IF
          IF #CP > #MAXAP
            #LKA := PO-ID-INV
            #PAGESA(#CP) := #LKA
          END-IF
        END-IF
        #I := 1
      END-IF
    END-READ
    #MAXAP := #CP
    #CP := 1
    #CP := #MAXAP
  WHEN #TOP
    #CP := 1
  WHEN #FORWARD
    IF #END-OF-DATA
      ESCAPE ROUTINE
    END-IF
    IF #CP = #NOFPAGES
      #PAGESA(1 : #NOFPAGES - 1) := #PAGESA(2 : #NOFPAGES)
      RESET #PAGESA(#CP)
      #PAGESA(#CP) := #LKA
    ELSE
      IF #SCROLL-AMOUNT < 1
        #SCROLL-AMOUNT := 1
      END-IF
      IF #CP + #SCROLL-AMOUNT <= #MAXAP
        ADD #SCROLL-AMOUNT TO #CP
      ELSE
        IF #SCROLL-AMOUNT > 1
          #CP := #MAXAP
        ELSE
          ADD 1 TO #CP
        END-IF
      END-IF
      IF #CP > #MAXAP
        #PAGESA(#CP) := #LKA
      END-IF
    END-IF
  WHEN #BACKWARD
    IF #CP GE 2
      IF #SCROLL-AMOUNT < 1
        #SCROLL-AMOUNT := 1
      END-IF
      SUBTRACT #SCROLL-AMOUNT FROM #CP
      IF #CP < 1
        #CP := 1
      END-IF
    END-IF
  WHEN GET-SCREEN
    IGNORE
  WHEN NONE
    ESCAPE ROUTINE
END-DECIDE
IF #CP >= #MAXAP
  #MAXAP := #CP
END-IF
#RSTARTA := #PAGESA(#CP)
RESET I L-SCREEN(*) #END-OF-DATA
CV-MARK (*) := (AD=P)
READ-LOOP-ALL. READ PRINTOUTS BY PO-ID-INV = #RSTARTA
  AT START OF DATA
    #TKA := PO-ID-INV
  END-START
  PERFORM FILTER-RECORD
  REJECT IF NOT DISPLAY-IT
  ADD 1 TO I
  IF I > #NOFLINES
    #LKA := PO-ID-INV
    ESCAPE ROUTINE
  END-IF
  IF I = 1
    #PAGESA(#CP) := PO-ID-INV
  END-IF
  #TKA := PO-ID-INV
  L-USERID(I) := PO-USERID
  PERFORM PROCESS-RECORD
  L-ISN(I) := *ISN(READ-LOOP-ALL.)
END-READ
#END-OF-DATA := TRUE
#MAXP := #CP
*
END-SUBROUTINE /* GET-SCREEN-ALL
*
************************************************************************
DEFINE SUBROUTINE LINE-COMMANDS
************************************************************************
IF L-MARK(*) = '.'
  INCLUDE CESCAPE
END-IF
*
INCLUDE RLCMTI-C
*
FOR I 1 TO #NOFLINES
  IF L-IDENT(I) = ##EQU-BROWSE
    PERFORM CHECK-SOURCE
  END-IF
  DECIDE ON FIRST VALUE OF L-IDENT (I)
    VALUE ##EQU-DISPLAY
      IGNORE
    VALUE ##EQU-DELETE
      IF NOT #DELETE
        REINPUT *0020 MARK *L-MARK(I) ALARM
      END-IF
    VALUE ##EQU-HOLD
      IF L-SIDENT(I) = ##TXT-HOLD
        REINPUT *702
      END-IF
      IF L-SIDENT(I) = ##TXT-CONFIRMATION-REQUIRED
        REINPUT *0020 MARK *L-MARK(I) ALARM
      END-IF
      IF NOT #UPDATE
        REINPUT *0020 MARK *L-MARK(I) ALARM
      END-IF
    VALUE ##EQU-RELEASE
      IF L-SIDENT(I) NE ##TXT-HOLD
        REINPUT *703
      END-IF
      IF NOT #UPDATE
        REINPUT *0020 MARK *L-MARK(I) ALARM
      END-IF
      PERFORM READ-ACTIVE-REP
      GETREL. GET PRINTOUTS L-ISN(I)
      IF *MACHINE-CLASS = 'MAINFRAME'
        IF PO-PRINTER-TYPE = ##PHYS-NATUNIX
          REINPUT *0130 MARK *L-MARK(I) ALARM
        END-IF
      ELSE
        IF NOT(PO-PRINTER-TYPE = ##PHYS-DISKUNIX OR = ##PHYS-NATUNIX)
          REINPUT *0131 MARK *L-MARK(I) ALARM
        END-IF
      END-IF
    VALUE ##EQU-MODIFY
      GETMOD. GET PRINTOUTS L-ISN(I)
      IF NOT (PO-STATUS = 'R' OR = 'H')
        REINPUT *705 MARK *L-MARK(I) ALARM
      END-IF
    VALUE ##EQU-BROWSE
      IF NOT L-TYPE(I) = 'R'     /* not a report
        REINPUT *713 MARK *L-MARK(I) ALARM
      ELSE
        PERFORM READ-ACTIVE-REP
        IF #BIN
          REINPUT *725 MARK *L-MARK(I) ALARM
        END-IF
        IF G-USER-TYPE NE 'A'
          PERFORM CHECK-FOLDER
          IF NOT #BROWSE
            REINPUT *0728 MARK *L-MARK(I) ALARM
          END-IF
        END-IF
      END-IF
    VALUE ##EQU-LIST-REPORTS
      IF NOT L-TYPE(I) = 'B'  /* NOT A BUNDLE
        REINPUT *714 MARK *L-MARK(I) ALARM
      END-IF
    VALUE ##EQU-RESTART
      IF NOT #UPDATE
        REINPUT *0020 MARK *L-MARK(I) ALARM
      END-IF
      IF L-TYPE(I) NE 'R'
        REINPUT *0723 MARK *L-MARK(I) ALARM
      END-IF
      GETRST. GET PRINTOUTS L-ISN(I)
      IF *MACHINE-CLASS = 'MAINFRAME'
        IF PO-PRINTER-TYPE = ##PHYS-NATUNIX
          REINPUT *0130 MARK *L-MARK(I) ALARM
        END-IF
      ELSE
        IF NOT(PO-PRINTER-TYPE = ##PHYS-DISKUNIX OR = ##PHYS-NATUNIX)
          REINPUT *0131 MARK *L-MARK(I) ALARM
        END-IF
      END-IF
    VALUE ##EQU-MOVE /*SU8
      IF NOT #UPDATE
        REINPUT *0020 MARK *L-MARK(I) ALARM
      END-IF
    NONE VALUE
      IGNORE
  END-DECIDE
END-FOR
*
FOR I 1 TO #NOFLINES
  DECIDE ON FIRST VALUE OF L-IDENT (I)
    VALUE ##EQU-DELETE
      PERFORM READ-ACTIVE-REP
      G-NATRP-ERC := 0017
      #OBJECT-NAME := L-REPNAME(I)
      EXAMINE #OBJECT-NAME FOR '(BUNDLE)' WITH DELETE
      IF G-CONFIRM
        RESET #CONFIRM-STRING
        IF NOT G-DISPLAY-LONG-NAMES
          IF L-TYPE(I) = 'B'
            #OBJECT-NAME-B := H'FA'
            #CONFIRM-STRING-B := H'FA'
          ELSE
            #OBJECT-NAME-R := H'FA'
            #CONFIRM-STRING-R := H'FA'
          END-IF
        END-IF
        IF L-TYPE (I) = 'R'
          #OBJECT := 'REPORT'
        ELSE
          #OBJECT := 'BUNDLE'
        END-IF
        SET CONTROL 'MT'
        SET CONTROL 'WC8L60B10/10F'
        INPUT USING MAP 'RCFDPOM&'
        SET CONTROL 'WB'
        IF *PF-KEY = 'PF3'
          ESCAPE TOP
        END-IF
      END-IF
      #OBJECT-NAME := L-REPNAME(I)
      EXAMINE #OBJECT-NAME FOR '(BUNDLE)' WITH DELETE
      IF NOT G-CONFIRM
      OR G-DISPLAY-LONG-NAMES AND #CONFIRM-STRING = #OBJECT-NAME      /*
      OR NOT G-DISPLAY-LONG-NAMES                                     /*
      AND (L-TYPE(I) = 'B' AND #CONFIRM-STRING-8 = #OBJECT-NAME       /*
      OR L-TYPE(I) NE 'B' AND #CONFIRM-STRING-17 = #OBJECT-NAME)      /*
        DPO. GET PRINTOUTS L-ISN(I)
        DELETE RECORD(DPO.)
        IF L-TYPE(I) = 'B'
          COMPRESS PO-BUNDLE '/' PO-BUNDRNB TO #OBJ LEAVING NO
        ELSE
          COMPRESS PO-REPNAME '/' PO-REPRNB TO #OBJ LEAVING NO
        END-IF
        COMPRESS #OBJ '/' PO-LOGICAL '/' PO-ID TO #OBJ LEAVING NO
        PERFORM RMLOGDEL #OBJ 'PRINTOUT'
        G-NATRP-ERC := 0018
        GET-SCREEN := TRUE
        END TRANSACTION
        RESET G-COMMIT
      END-IF
    VALUE ##EQU-HOLD
      HPO. GET PRINTOUTS L-ISN(I)
      PRINTOUTS.PO-STATUS := 'H'
      RESET PO-NUMBER-OF-RETRIES PO-LAST-PRINTED-RECNO PO-DESTINATION
      UPDATE (HPO.)
      END TRANSACTION
      GET-SCREEN := TRUE
      RESET G-COMMIT
    VALUE ##EQU-RELEASE
      RPO. GET PRINTOUTS L-ISN(I)
      PRINTOUTS.PO-STATUS := 'R'
      PERFORM SET-SCHEDULED
      RESET  PRINTOUTS.PO-NUMBER-OF-RETRIES L-PRINTED-LINES (I)
      RESET  PRINTOUTS.PO-PRINTED PRINTOUTS.PO-LAST-PRINTED-RECNO
      RESET  PRINTOUTS.PO-MSG PRINTOUTS.PO-JOBNAME
      RESET  PRINTOUTS.PO-JOBNO PRINTOUTS.PO-JOBID
      UPDATE (RPO.)
      END TRANSACTION
      GET-SCREEN := TRUE
      RESET G-COMMIT
      NOMWK-TASK-TYPE:= EQU-MANAGE-PRINTOUTS
      CALLNAT NOM-WAKE-MONITOR NOMWK-NOMVERS NOMWK-PARMS (*)
    VALUE ##EQU-BROWSE
      RESET L-MARK (I) L-IDENT (I)
      G-C-REPORT := L-REPNAME (I)
      G-C-REPRNB := L-RNB(I)
      G-FATHER-PROG := 'RLISPO'
      FETCH RETURN 'RDISRP' G-C-REPORT G-C-REPRNB
      RESET #NEWVAL
    VALUE ##EQU-LIST-REPORTS
      SEPARATE L-REPNAME (I) INTO #BUNNAME (*) WITH DELIMITER ' '
      G-C-BUNDLE := #BUNNAME (1)
      G-C-BUNDRNB := L-RNB    (I)
      G-FATHER-PROG := 'RLISPO'
      FETCH RETURN 'RLISBC'
      RESET #NEWVAL
    VALUE ##EQU-RESTART
      RESTART. GET PRINTOUTS L-ISN(I)
      IF PO-STATUS(RESTART.) NE 'E'
        REINPUT *0724 MARK *L-MARK(I) ALARM
      END-IF
      PRINTOUTS.PO-STATUS := 'R'
      PERFORM SET-SCHEDULED
      RESET  PRINTOUTS.PO-PRINTED PRINTOUTS.PO-MSG  PRINTOUTS.PO-JOBNAME
      RESET  PRINTOUTS.PO-JOBNO PRINTOUTS.PO-JOBID
      RESET  PRINTOUTS.PO-NUMBER-OF-RETRIES
      UPDATE (RESTART.)
      END TRANSACTION
      GET-SCREEN := TRUE
      RESET G-COMMIT
      NOMWK-TASK-TYPE:= EQU-MANAGE-PRINTOUTS
      CALLNAT NOM-WAKE-MONITOR NOMWK-NOMVERS NOMWK-PARMS (*)
    VALUE ##EQU-MOVE /*SU8
      #TYPE := L-PT-TYPE (I)
      PERFORM #GET_UPD-PO
      CALLNAT 'RSELPR-N' #PRINTER #CLASS #FORM #DEST #COPIES
        G-P-PHYSICAL-NAME #PRTY #HOLD G-USERID G-USER-TYPE
        #PRINTERS(*) #NOP L-LOGICAL (I) #TYPE #NUM-MOVE
      IF #PRINTER NE ' '
        PERFORM #MOVE-IT
      END-IF
    NONE VALUE
      IGNORE
  END-DECIDE
END-FOR
*
FOR I 1 TO #NOFLINES
  DECIDE ON FIRST VALUE OF L-IDENT (I)
    VALUE ##EQU-DISPLAY
      G-C-PO-ID := L-ID (I)
      G-C-FUNC  := 'D'
      FETCH RETURN 'RDEFPO'
      RESET #NEWVAL
    VALUE ##EQU-MODIFY
      IF NOT #UPDATE
        G-C-FUNC := 'D'
      ELSE
        G-C-FUNC := 'M'
      END-IF
      G-C-PO-ID := L-ID(I)
      FETCH RETURN 'RDEFPO'
      GET-SCREEN := TRUE
    NONE VALUE
      IGNORE
  END-DECIDE
END-FOR
*
END-SUBROUTINE /* LINE-COMMANDS
*
************************************************************************
DEFINE SUBROUTINE READ-ACTIVE-REP
************************************************************************
RESET #REP-SIZE #BIN #ALL-BIN
#REPNAME    := L-REPNAME(I)
#RNB        := L-RNB(I)
#BC-BUNDLE  := L-REPNAME (I)
#BC-BUNDRNB := L-RNB(I)
RESET #BC-SEQNO
*
IF L-TYPE(I) = 'R'
  FNDAR1. FIND ACT-REP WITH AR-REPORT-RNB = #REPORT-RNB
    IF AR-USERID = G-USERID
      #REPORT-OWNER := TRUE
    END-IF
    IF AR-CC-TYPE = BINARY
      #BIN := TRUE
      PERFORM GET-BINARY-SIZE
    END-IF
  END-FIND
ELSE /* bundles
  #ALL-BIN      := TRUE
  FNDBC. READ BUNDLE-CONTENTS WITH BC-BUNDLE-RNB = #BC-BUNDLE-RNB
    IF BC-BUNDLE NE #BC-BUNDLE OR BC-BUNDRNB NE #BC-BUNDRNB
      ESCAPE BOTTOM (FNDBC.)
    END-IF
    FNDAR. FIND (1) ACT-REP WITH
        AR-REPORT-RNB = BUNDLE-CONTENTS.BC-REPORT-RNB
      IF AR-CC-TYPE NE BINARY
        #ALL-BIN := FALSE
      ELSE
        #BIN := TRUE
        PERFORM GET-BINARY-SIZE
        #BIN-SIZE := #BIN-SIZE + #REP-SIZE
      END-IF
    END-FIND
  END-READ
  IF *COUNTER (FNDBC.) = 1
    RESET #ALL-BIN
  END-IF
END-IF
*
END-SUBROUTINE /* READ-ACTIVE-REP
*
************************************************************************
DEFINE SUBROUTINE GET-BINARY-SIZE
************************************************************************
#SPOOL-ATTRIBUTES := ACT-REP.AR-SPOOL-ATTRIBUTES
IF #SPOOL-DI-SIZE NE #I4
  #REP-SIZE := #SPOOL-DI-SIZE
ELSE
  RESET #REP-SIZE
END-IF
*
END-SUBROUTINE /* GET-BINARY-SIZE
*
************************************************************************
DEFINE SUBROUTINE INIT-SELECTION-KEYS
************************************************************************
IF NOT(#S-STAT ='R' OR='H' OR='P' OR='C' OR='D' OR='E' OR='F' OR='T'
OR=' ' OR='*' OR='O' OR='S' OR='U' OR='X') AND #LIST-PROCESSED        /*
  REINPUT USING HELP MARK *#S-STAT ALARM
END-IF
IF G-DISPLAY-LONG-NAMES
  #LEN := 25
ELSE
  #LEN := 8
END-IF
CALLNAT 'SELALPHA' #S-BUNDLE #S-BUNDLE-F #S-BUNDLE-T #LEN
*
IF G-DISPLAY-LONG-NAMES
  #LEN := 25
ELSE
  #LEN := 17
END-IF
CALLNAT 'SELALPHA' #S-REPNAME #S-REPNAME-F #S-REPNAME-T #LEN
*
#LEN := 8
CALLNAT 'SELALPHA' #S-DEST #S-DEST-F #S-DEST-T #LEN
*
#LEN := 8
CALLNAT 'SELALPHA' #S-PID #S-PID-F #S-PID-T #LEN
*
#LEN := 4
CALLNAT 'SELALPHA' #S-FORM #S-FORM-F #S-FORM-T #LEN
*
#S-USERID := #G-USERID
#LEN := 8
CALLNAT 'SELALPHA' #S-USERID  #USERID-F #USERID-T  #LEN
*
END-SUBROUTINE /* INIT-SELECTION-KEYS
*
************************************************************************
/*SU7 DEFINE SUBROUTINE MODIFY-BULK
*
************************************************************************
DEFINE SUBROUTINE LOCAL-DIRECT-COMMAND
************************************************************************
MOVE LEFT G-DIRECT-COMMAND TO G-DIRECT-COMMAND
IF G-DIRECT-COMMAND = 'DLOG'
  G-DIRECT-COMMAND := 'DLOG PRINTOUTS'
END-IF
*
END-SUBROUTINE /* LOCAL-DIRECT-COMMAND
*
************************************************************************
DEFINE SUBROUTINE FILTER-RECORD
************************************************************************
DISPLAY-IT := TRUE
*
IF (PRINTOUTS.PO-STATUS NE #S-STAT AND NOT(#S-STAT = '*' OR = ' ')
AND #S-STAT NE 'U') OR (#S-STAT = 'U' AND                             /*
NOT (PRINTOUTS.PO-STATUS ='E' OR='F' OR='T' OR='O' OR='S' OR = 'X'))  /*
OR (NOT(PRINTOUTS.PO-REPNAME EQ #S-REPNAME-F THRU #S-REPNAME-T)       /*
AND PRINTOUTS.PO-REPNAME NE ' ')                                      /*
OR (NOT(PRINTOUTS.PO-BUNDLE  EQ #S-REPNAME-F THRU #S-REPNAME-T)       /*
AND PRINTOUTS.PO-REPNAME = ' ')                                       /*
OR (PRINTOUTS.PO-HOLD NE #S-HOLD AND NOT(#S-HOLD=' ' OR = '*'))       /*
OR (PRINTOUTS.PO-CLASS NE #S-CLASS AND NOT(#S-CLASS=' ' OR = '*'))    /*
OR (NOT(PRINTOUTS.PO-LOGICAL EQ #S-PID-F THRU #S-PID-T))              /*
OR (NOT(PRINTOUTS.PO-FORM EQ #S-FORM-F THRU #S-FORM-T))               /*
OR (NOT(PRINTOUTS.PO-DESTINATION EQ #S-DEST-F THRU #S-DEST-T))        /*
  DISPLAY-IT := FALSE
END-IF
IF DISPLAY-IT AND G-USER-TYPE = 'P'
  P-USERID := G-USERID
  P-TYPE   := 'P'
  P-NAME   := PRINTOUTS.PO-LOGICAL
  CALLNAT 'RGRANT-N' P-USERID P-TYPE P-NAME DISPLAY-IT P-OPTIONS (*)
END-IF
*
END-SUBROUTINE /* FILTER-RECORD
*
************************************************************************
DEFINE SUBROUTINE #GET_UPD-PO /*SU8
************************************************************************
RESET #NUM-MOVE
READ1. READ PRINTOUTS BY PO-USERID-POIDINV = #RSTART
  IF (G-USER-TYPE NE 'A' AND PO-USERID NE #G-USERID
  AND +G-USER-TYPE NE 'O' AND G-USER-TYPE NE 'P')                     /*
  OR ((G-USER-TYPE ='A' OR='P' OR +G-USER-TYPE = 'O')                 /*
  AND NOT(PO-USERID = #USERID-F THRU #USERID-T))                      /*
    ESCAPE BOTTOM
  END-IF
  PERFORM FILTER-RECORD /*check all parms
  IF DISPLAY-IT AND L-LOGICAL (I) = PRINTOUTS.PO-LOGICAL
    IF #UPD
      UPD-PO. GET PRINTOUTS *ISN (READ1.)
      PRINTOUTS.PO-LOGICAL := #PRINTER
      UPDATE (UPD-PO.)
    ELSE
      ADD 1 TO #NUM-MOVE
    END-IF
  END-IF
END-READ
IF #UPD
  END TRANSACTION
END-IF
*
END-SUBROUTINE /* #GET_UPD-PO
*
************************************************************************
DEFINE SUBROUTINE #MOVE-IT /*SU8
************************************************************************
IF #NUM-MOVE = -1 /*move all SU2 <-
  #UPD := TRUE
  PERFORM #GET_UPD-PO
  RESET #UPD
  ESCAPE ROUTINE
END-IF
UPD-PO1. GET PRINTOUTS L-ISN (I)
PRINTOUTS.PO-LOGICAL := #PRINTER
UPDATE (UPD-PO1.)
END TRANSACTION
*
END-SUBROUTINE /* #MOVE-IT
*
************************************************************************
DEFINE SUBROUTINE PROCESS-RECORD
************************************************************************
RESET #BIN-SIZE #BIN
#TK-POID := PRINTOUTS.PO-ID-INV
L-ID      (I) := PRINTOUTS.PO-ID
L-LOGICAL (I) := PRINTOUTS.PO-LOGICAL
L-PT-TYPE (I) := PRINTOUTS.PO-PRINTER-TYPE
*
IF PRINTOUTS.PO-REPNAME =' '
  L-TYPE    (I) := 'B'
  L-REPNAME (I) := PRINTOUTS.PO-BUNDLE
  L-RNB     (I) := PRINTOUTS.PO-BUNDRNB
ELSE
  L-TYPE    (I) := 'R'
  L-REPNAME (I) := PRINTOUTS.PO-REPNAME
  L-RNB     (I) := PRINTOUTS.PO-REPRNB
END-IF
*
PERFORM READ-ACTIVE-REP
IF L-TYPE (I) = 'B'
  IF #ALL-BIN                       /* all binary reports in bundle
    IF PRINTOUTS.PO-LAST-PRINTED-RECNO > 0
      #BIN-SIZE := PRINTOUTS.PO-LAST-PRINTED-RECNO
      COMPRESS #BIN-SIZE 'K' TO L-PRINTED-LINES(I) LEAVING NO
    ELSE
      IF #BIN-SIZE = 0 /* size of binary reps not found in spool attrib
        RESET L-PRINTED-LINES(I)
      ELSE
/*SU4   #BIN-SIZE := (#BIN-SIZE / 1024 + 1) * 3 / 4
        #BIN-SIZE := (#BIN-SIZE / 1024) * 3 / 4 + 1 /*SU4
        COMPRESS #BIN-SIZE 'K' TO L-PRINTED-LINES(I) LEAVING NO
      END-IF
    END-IF
  ELSE
    IF #BIN      /* not all, but at least one report in bundle is binary
      RESET L-PRINTED-LINES(I)
    ELSE
      PERFORM GET-LINES-NOT-BINARY
    END-IF
  END-IF
ELSE                              /* binary reports
  IF #BIN
    IF PRINTOUTS.PO-LAST-PRINTED-RECNO > 0
      #BIN-SIZE := PRINTOUTS.PO-LAST-PRINTED-RECNO
      COMPRESS #BIN-SIZE 'K' TO L-PRINTED-LINES(I) LEAVING NO
    ELSE
      IF #REP-SIZE > 0
        #BIN-SIZE := #REP-SIZE / 1024 + 1
        COMPRESS #BIN-SIZE 'K' TO L-PRINTED-LINES(I) LEAVING NO
      ELSE
        RESET L-PRINTED-LINES(I)
      END-IF
    END-IF
  ELSE                           /* not binary
    PERFORM GET-LINES-NOT-BINARY
  END-IF
END-IF
*
IF PRINTOUTS.PO-JOBNO NE 0
  L-JOB-NAME (I) := PRINTOUTS.PO-JOBNAME
  L-JOB-NUMBER (I) := PRINTOUTS.PO-JOBNO
END-IF
IF PRINTOUTS.PO-JOBID NE ' '
  L-JOB-NAME (I) := PRINTOUTS.PO-JOBNAME
  MOVE RIGHT JUSTIFIED PRINTOUTS.PO-JOBID TO L-JOB-NUMBER (I)
END-IF
*
L-STAT (I) := PRINTOUTS.PO-STATUS
MOVE EDITED PRINTOUTS.PO-CREATED (EM=YYYYMMDD) TO #DATE8
IF #DATE8 NE '00000102'
  MOVE EDITED PRINTOUTS.PO-CREATED (EM=HH':'II)
    TO L-TIME-CREATED (I)
  CALLNAT 'IODATE-N' 'M' 'S' #DATE8 #DATE10 G-DATE-FORMAT #ERC #ERT
  L-DATE-CREATED (I) := #DATE10
END-IF
*
MOVE EDITED PRINTOUTS.PO-SCHEDULED (EM=YYYYMMDD) TO #DATE8
IF #DATE8 NE '00000102'
  MOVE EDITED PRINTOUTS.PO-SCHEDULED (EM=HH':'II)
    TO L-TIME-SCHEDULED (I)
  CALLNAT 'IODATE-N' 'M' 'S' #DATE8 #DATE10 G-DATE-FORMAT #ERC #ERT
  L-DATE-SCHEDULED (I) := #DATE10
END-IF
*
IF PRINTOUTS.PO-STATUS NE 'E'
  MOVE EDITED PRINTOUTS.PO-PRINTED (EM=YYYYMMDD) TO #DATE8
  IF #DATE8 NE '00000102'
    MOVE EDITED PRINTOUTS.PO-PRINTED (EM=HH':'II)
      TO L-TIME-PRINTED (I)
    CALLNAT 'IODATE-N' 'M' 'S' #DATE8 #DATE10 G-DATE-FORMAT #ERC #ERT
    L-DATE-PRINTED (I) := #DATE10
  ELSE
    RESET L-TIME-PRINTED(I)
  END-IF
END-IF
*
RESET #IDENT L-SIDENT (I)
DECIDE ON FIRST VALUE OF PRINTOUTS.PO-STATUS
  VALUE 'R'
    #IDENT := ##TXT-READY-TO-PRINT
  VALUE 'X'
    IF PRINTOUTS.PO-MSG NE ' '
      L-STATUS(I) := PRINTOUTS.PO-MSG
      EXAMINE L-STATUS(I) FOR FULL '  ' REPLACE WITH ' ' /* NOMALL-1454
    ELSE
      #IDENT := ##TXT-EXTERNAL-OK
    END-IF
  VALUE 'T'
    IF PRINTOUTS.PO-MSG = MASK(NNNN) AND PRINTOUTS.PO-MSG IS (N4)
      #IDENT := VAL (PRINTOUTS.PO-MSG)
    ELSE
      #IDENT := ##TXT-PRINTER-IS-BUSY
    END-IF
  VALUES 'A','O'
    #PO-MSG:= PRINTOUTS.PO-MSG
    IF PRINTOUTS.PO-MSG = MASK(NNNN)
      CALLNAT 'RSUBMSGN' #PO-MSG
    END-IF
    L-STATUS(I) := #PO-MSG
  VALUE 'P'
    IF PRINTOUTS.PO-MSG = MASK(NNNN) AND PRINTOUTS.PO-MSG IS (N4)
      #IDENT := VAL (PRINTOUTS.PO-MSG)
    ELSE
      #IDENT := ##TXT-SENT-TO-PRINTER
    END-IF
  VALUE 'H'
    #IDENT := ##TXT-HOLD
  VALUE 'C'
    #IDENT := ##TXT-CONFIRMATION-REQUIRED
  VALUE 'D'
    IF PO-MSG NE ' '   /* leave msgs from bundle print exit
      RESET #IDENT
      L-STATUS(I) := PRINTOUTS.PO-MSG
    ELSE
      #IDENT := ##TXT-PRINTED-SUCCESSFULLY
    END-IF
  VALUE 'F'
    #PO-MSG:= PRINTOUTS.PO-MSG
    IF PRINTOUTS.PO-MSG = MASK(NNNN) AND PRINTOUTS.PO-MSG IS (N4)
      CALLNAT 'RSUBMSGN' #PO-MSG
    END-IF
    L-STATUS(I) := #PO-MSG
  VALUE 'E'
    #PO-MSG:= PRINTOUTS.PO-MSG
    IF PRINTOUTS.PO-MSG = MASK(NNNN) AND PRINTOUTS.PO-MSG IS (N4)
      CALLNAT 'RSUBMSGN' #PO-MSG
    END-IF
    L-STATUS(I) := #PO-MSG
  VALUE 'S'
    #IDENT := ##TXT-PRINTER-STOPPED
  ANY VALUE
    IF #IDENT NE 0
      CALLNAT 'RLTINI-N' #IDENT #IDENT-TEXT G-TXB
      L-STATUS (I) := #IDENT-TEXT
      L-SIDENT (I) := #IDENT
    END-IF
  NONE VALUE
    IGNORE
END-DECIDE
*
RESET CV-MARK(I)
*
END-SUBROUTINE /* PROCESS-RECORD
*
************************************************************************
DEFINE SUBROUTINE GET-LINES-NOT-BINARY
************************************************************************
IF PRINTOUTS.PO-LAST-PRINTED-RECNO NE 0
  L-PRINTED-LINES(I) := PO-LAST-PRINTED-RECNO
ELSE
  RESET EOMPOL-PARMS
  IF PO-BUNDLE NE ' '
    EOMPOL-BUNDLE := PRINTOUTS.PO-BUNDLE
    EOMPOL-RNB    := PRINTOUTS.PO-BUNDRNB
  ELSE
    EOMPOL-REPORT := PRINTOUTS.PO-REPNAME
    EOMPOL-RNB    := PRINTOUTS.PO-REPRNB
  END-IF
  EOMPOL-FROM-LINE := PRINTOUTS.PO-FROM-LINE
  EOMPOL-TO-LINE   := PRINTOUTS.PO-TO-LINE
  CALLNAT 'EOMPOL-N' EOMPOL-PARMS
  L-PRINTED-LINES (I) := EOMPOL-TOTAL-LINES
END-IF
*
END-SUBROUTINE /* GET-LINES-NOT-BINARY
*
************************************************************************
DEFINE SUBROUTINE CHECK-SOURCE
************************************************************************
#AR-REP-RNB.#AR-REPNAME := L-REPNAME(I)
#AR-REP-RNB.#AR-RNB     := L-RNB(I)
FIND ACT-REP WITH AR-REPORT-RNB = #AR-REP-RNB
END-FIND
IF AR-CURRENT-LOCATION = 'A'
* REINPUT *0426 MARK *L-MARK(I) ALARM                /* BLI NOMALL-1829
  REINPUT *0441 MARK *L-MARK(I) ALARM                /* BLI NOMALL-1829
END-IF
IF AR-SOURCE-ID = 0
  ESCAPE ROUTINE
END-IF
IF AR-REVIVE = '*' AND AR-CURRENT-LOCATION = 'D'
  ESCAPE ROUTINE
END-IF
*
IF G-USE-OWNER AND AR-USERID NE G-NPR-USERID-CURRENT
  FIND SOURCE WITH SR-ID = AR-SOURCE-ID
  END-FIND
  IF SOURCE.SR-TYPE NE NOM-DATA-BASE
    #SAVE-NPR-USERID := G-NPR-USERID
    G-NPR-USERID := AR-USERID
    PERFORM LOGON-TO-ESY
    IF G-NATRP-ERC NE 0
      G-NPR-USERID := #SAVE-NPR-USERID
      ESCAPE ROUTINE
    END-IF
    RESET G-NATRP-ERC G-NATRP-ERT
    G-NPR-USERID := #SAVE-NPR-USERID
  END-IF
END-IF
RESET #ERROR-CODE #ERROR-TEXT SOURCE-EXIST
CALLNAT 'RMSRCK-N' #ERROR-CODE #ERROR-TEXT AR-SOURCE-ID SOURCE-EXIST
IF #ERROR-CODE NE 0
  REINPUT *#ERROR-CODE, #ERROR-TEXT MARK *L-MARK(I) ALARM
END-IF
IF NOT SOURCE-EXIST
  REINPUT *0426 MARK *L-MARK(I) ALARM
END-IF
*
END-SUBROUTINE /* CHECK-SOURCE
*
************************************************************************
DEFINE SUBROUTINE INIT-LINECOM
************************************************************************
G-LC-IDENT (01) := ##EQU-DISPLAY
G-LC-IDENT (02) := ##EQU-MODIFY
G-LC-IDENT (03) := ##EQU-DELETE
G-LC-IDENT (04) := ##EQU-HOLD
G-LC-IDENT (05) := ##EQU-RELEASE
G-LC-IDENT (06) := ##EQU-LIST-REPORTS
G-LC-IDENT (07) := ##EQU-BROWSE
G-LC-IDENT (08) := ##EQU-RESTART
G-LC-IDENT (09) := ##EQU-MOVE /*8041 SU8
G-LC-NUM := 9
CALLNAT 'RLCINI-N' G-OBJ-TYPE G-LC G-LCB
*
END-SUBROUTINE /* INIT-LINECOM
*
************************************************************************
DEFINE SUBROUTINE INIT-PFKEYS
************************************************************************
INCLUDE RPFSTD-C
INCLUDE RPFBRW-C
INCLUDE RPFLR--C
INCLUDE RPFEXT-C
CALLNAT 'RPFINI-N' G-PF G-PFB
*
END-SUBROUTINE /* INIT-PFKEYS
*
************************************************************************
DEFINE SUBROUTINE SET-SCHEDULED
************************************************************************
CALLNAT 'RDEFPO-N' PRINTOUTS.PO-PHYSICAL-NAME PRINTOUTS.PO-SCHEDULED
*
END-SUBROUTINE /* SET-SCHEDULED
* --------------------------------------------------------------------
* allow to browse reports contained in own folder or contained in
* linked folder
*
************************************************************************
DEFINE SUBROUTINE CHECK-FOLDER
************************************************************************
RESET #BROWSE
MA. FIND MAIL WITH MA-REP-RNB = #AR-REP-RNB
  RESET #GRANTED #OPTIONS(*) #FO-ID-N
  #GR-USERID := G-USERID
  DECIDE FOR FIRST CONDITION
/* mailed to g-userid own folder
    WHEN MA-USERID = G-USERID AND MA-FO-ID = 0001
        OR #REPORT-OWNER
      #BROWSE := TRUE
/* mailed to g-userid, to linked folder
    WHEN MA-USERID = G-USERID AND MA-FO-ID NE 0001
      #FO-ID   := MA-FO-ID
      #FO-USER := MA-USERID
      FFO. FIND FOLDER WITH FO-USER-FO-ID = #FO-USER-ID
        #FO-ID-N := FO-LINKED-ID
        COMPRESS FO-LINKED-USERID #FO-ID-A TO #FO-NAME LEAVING NO
        CALLNAT 'RGRANT-N' #GR-USERID 'F' #FO-NAME #GRANTED #OPTIONS(*)
        IF #GRANTED
* BLI 2017-08-18 NOMALL-1984 correct next line
**        IF #OPTIONS(1) = 'Y' OR #OPTIONS(4) = 'Y'
          IF #OPTIONS(1:4) = 'Y'
            #BROWSE := TRUE
            ESCAPE BOTTOM (FFO.)
          END-IF
        END-IF
      END-FIND
/* mailed not to g-userid, but contains in linked folder
    WHEN MA-USERID NE G-USERID AND MA-FO-ID = 0001
      #FO-ID-N := MA-FO-ID
      COMPRESS MA-USERID #FO-ID-A TO #FO-NAME LEAVING NO
      CALLNAT 'RGRANT-N' #GR-USERID 'F' #FO-NAME #GRANTED #OPTIONS(*)
      IF #GRANTED
* BLI 2017-08-18 NOMALL-1984 correct next line
**        IF #OPTIONS(1) = 'Y' OR #OPTIONS(4) = 'Y'
        IF #OPTIONS(1:4) = 'Y'
          #BROWSE := TRUE
        END-IF
      END-IF
    WHEN NONE IGNORE
  END-DECIDE
  IF #BROWSE
    ESCAPE BOTTOM(MA.)
  END-IF
END-FIND
*
END-SUBROUTINE /* CHECK-FOLDER
*
INCLUDE RPFSET-C /* set pfkeys
*
END
