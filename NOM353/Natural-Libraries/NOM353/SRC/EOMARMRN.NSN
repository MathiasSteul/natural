* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    EOMARMRN
* Version   1.3
* Function  DB Interface EOM Object Active Report (revive attributes)
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* mrs 93-06-28           created
* mrs 97-05-27 p(162705) recompiled (changes in eomarm-p)
* mrs 97-05-27 p(162737) recompiled (changes in eomarm-p)
* xsethz  2000-07-27 (CE7461)  Extend Report and Bundle Names
* fhi     2000-08-24 QA03      Use NAT23006 for error values
* xsetggr 2007-05-03 NOM3201   support P11 format run numbers
* xsetggr 2007-06-06 p(294775) add functions read-next, readhold-next
* fhi     2007-07-12 NOM3202   C-NATERR changed, NAD23006 is obsolete.
* xsetggr 2008-05-05 p(304350) restow due changes in EOMARM-P
* fhi     2009-05-20 N3463     Extend metadata
* fhi     2013-08-29 FHI285    Enhance error message 406
* SU1     2013-11-22 NOMALL-1288 correct FHI285 for msg 406
* SU2     2014-07-02 NOMALL-1279 fill fields for Adabas Vista
* SU3     2016-01-15 NOMALL-1802 do not update Adabas Vista fields
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER USING EOM----P
PARAMETER USING EOMARM-P
PARAMETER USING EOMMSG-P
************************************************************************
LOCAL     USING EOM----E
LOCAL
1 ACTIVE-REPORT VIEW OF NRM-ACTIVE-REPORTS
  2 AR-REVIVE
  2 AR-REVIVE-RETENTION-PERIOD
  2 REDEFINE AR-REVIVE-RETENTION-PERIOD
    3 AR-REV-NUMBER      (N3)
    3 AR-REV-FACTOR      (A1)
    3 AR-REV-CALENDAR    (A8)
  2 AR-REVIVE-DATE
  2 AR-REVIVE-EXPIRATION
* -----------------------------local variables--------------------------
1 #AR-REPORT-RNB         (A31)
1 REDEFINE #AR-REPORT-RNB
  2 #AR-REPORT           (A25)
  2 #AR-REPRNB           (P11)
1 #DATE                  (A8)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#AR-REPORT := EOMARM-I-NAME
#AR-REPRNB := EOMARM-I-RNB
*
DECIDE ON FIRST EOM-FUNCTION
  VALUE EOM-READ, EOM-READ-NEXT
    PERFORM READ-REVIVE-ATTRIBUTES
  VALUE EOM-READHOLD, EOM-READHOLD-NEXT
    PERFORM READ-REVIVE-ATTRIBUTES
  VALUE EOM-MODIFY
    PERFORM MODIFY-REVIVE-ATTRIBUTES
  NONE  IGNORE
END-DECIDE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE READ-REVIVE-ATTRIBUTES
************************************************************************
RESET EOMARM-REVIVE-ATTRIBUTES
FNDAR. FIND ACTIVE-REPORT WITH AR-REPORT-RNB = #AR-REPORT-RNB
  IF NO RECORDS FOUND
    EOMMSG-NR := 0406
    COMPRESS #AR-REPORT ' (' *PROGRAM ',' *LINE ')'
      TO EOMMSG-TOKEN(1) LEAVING NO
    ESCAPE BOTTOM (FNDAR.)
  END-NOREC
*
  EOMARM-REVIVE         := AR-REVIVE
  EOMARM-REV-NUMBER     := AR-REV-NUMBER
  EOMARM-REV-FACTOR     := AR-REV-FACTOR
  EOMARM-REV-CALENDAR   := AR-REV-CALENDAR
*
  MOVE EDITED AR-REVIVE-DATE (EM=YYYYMMDD) TO #DATE
  IF #DATE NE '00000102'
    CALLNAT 'IODATE-N' 'M' 'L' #DATE EOMARM-REV-DATE EOM-DATE-FORMAT
      EOMMSG-NR EOMMSG-TEXT
    MOVE EDITED AR-REVIVE-DATE (EM=HH':'II':'SS) TO EOMARM-REV-TIME
  END-IF
*
  IF AR-REVIVE-EXPIRATION NE ' '
    CALLNAT 'IODATE-N' 'M' 'L' AR-REVIVE-EXPIRATION
      EOMARM-REV-EXPIRATION EOM-DATE-FORMAT EOMMSG-NR EOMMSG-TEXT
  END-IF
*
  IF EOM-FUNCTION = EOM-READHOLD OR = EOM-READHOLD-NEXT
    UPD. GET ACTIVE-REPORT *ISN (FNDAR.)
    IF AR-REVIVE NE AR-REVIVE
      UPDATE (UPD.)
    END-IF
  END-IF
*
END-FIND
*
END-SUBROUTINE /* READ-REVIVE-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE MODIFY-REVIVE-ATTRIBUTES
************************************************************************
FNDMOD. FIND ACTIVE-REPORT WITH AR-REPORT-RNB = #AR-REPORT-RNB
  IF NO RECORDS FOUND
    EOMMSG-NR := 0406
    COMPRESS #AR-REPORT ' (' *PROGRAM ',' *LINE ')' TO EOMMSG-TOKEN(1)
    ESCAPE BOTTOM (FNDMOD.)
  END-NOREC
*
  IF AR-REVIVE = '*' AND AR-REVIVE NE EOMARM-REVIVE
    EOMMSG-NR := 0440
    ESCAPE BOTTOM (FNDMOD.)
  END-IF
*
  AR-REVIVE       := EOMARM-REVIVE
  AR-REV-NUMBER   := EOMARM-REV-NUMBER
  AR-REV-FACTOR   := EOMARM-REV-FACTOR
  AR-REV-CALENDAR := EOMARM-REV-CALENDAR
*
  IF EOMARM-REV-EXPIRATION = ' '
    RESET AR-REVIVE-EXPIRATION
  ELSE
    CALLNAT 'IODATE-N' 'V' 'L' AR-REVIVE-EXPIRATION EOMARM-REV-EXPIRATION
      EOM-DATE-FORMAT EOMMSG-NR EOMMSG-TEXT
  END-IF
*
  IF EOMMSG-NR = 0
    UPDATE
  ELSE
    EOMMSG-TOKEN (1) := EOMMSG-TEXT
    EOMMSG-FIELD-NAME := 'EOMARM-REV-EXPIRATON'
    RESET  EOMMSG-TEXT
  END-IF
*
END-FIND
*
END-SUBROUTINE /* MODIFY-REVIVE-ATTRIBUTES
* --------------------------------------- on error ---------------------
INCLUDE C-EOMERR
*
END
