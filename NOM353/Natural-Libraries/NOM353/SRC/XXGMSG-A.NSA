1 #XX-GMSG-PARMS
  2 #XX-ERROR-TYPE (A1) /* N=NATURAL,U=User(Default)
  2 #XX-ERROR-APPL (A8) /* Default is *APPLIC-ID
  2 #XX-ERROR-CODE (N4) /* 1 Thru 9999
