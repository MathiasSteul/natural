* ----------------------------- Parameter ------------------------------
DEFINE DATA
PARAMETER USING XXUX---P
PARAMETER    /*fhi 2019-07-05 NOMALL-2287
1 UX-TEMPDIR      (A) DYNAMIC BY VALUE RESULT OPTIONAL
************************************************************************
LOCAL USING VUXDEF-L
*                                                                       *
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
IF XXUX---P.P-USERID = ' '
    OR UX-TEMPDIR SPECIFIED /* return always if variable exists
  FIND-UX. FIND UX-NODES WITH UX-NODE-NAME = P-NODE-NAME
    IF NO RECORDS FOUND
      P-ERC := P-ERT := 2028
      PERFORM XXRLOG-WRITE-LOG 'W' P-ERT
      ESCAPE BOTTOM (FIND-UX.)
    END-NOREC
    XXUX---P.P-NODE-NAME       := UX-NODE-NAME
    XXUX---P.P-USERID          := UX-NODE-USERID
    XXUX---P.P-CIPHER-PASSWORD := UX-NODE-PASSWORD
    XXUX---P.P-GROUP           := UX-NODE-GROUP
    XXUX---P.P-NODE-SUSPEND    := UX-NODE-SUSPEND
* fhi      2019-07-05 NOMALL-2287 start insertion
    IF UX-TEMPDIR SPECIFIED
      UX-TEMPDIR := UX-NODE-TEMPDIR
    END-IF
* fhi      2019-07-05 NOMALL-2287 end   insertion
  END-FIND
END-IF
*
END
