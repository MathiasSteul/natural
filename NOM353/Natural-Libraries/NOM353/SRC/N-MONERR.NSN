************************************************************************
* Subprogram N-MONERR
* Version    3.5
* Function   Return 2 attributes from monitor defaults-error handling:
*
* Maintenance
* -----------
* uuuuuu  yyyy-mm-dd iTrac       Remark
* SU      2018-08-08             Created
************************************************************************
*
DEFINE DATA
PARAMETER
1 MAX-RETRIES      (N3)
1 RETRY-INTERVAL   (N5)
LOCAL
1 MONITOR VIEW OF NRM-MONITOR
  2 M-MAX-RETRIES    (N3)
  2 M-RETRY-INTERVAL (N5)
1 #MONIT-ID          (A16)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#MONIT-ID := F#MONITOR-TASK-ID1 (<>)
FIND MONITOR WITH M-MONITOR-ID = #MONIT-ID
  MAX-RETRIES    := M-MAX-RETRIES
  RETRY-INTERVAL := M-RETRY-INTERVAL
END-FIND
*
END
