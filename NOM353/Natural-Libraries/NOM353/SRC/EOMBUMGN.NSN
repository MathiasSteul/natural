* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    EOMBUMGN
* Version   2.1.1
* Function  DB Interface EOM Object Bundle (General attributes)
*
* Maintenance
* uuu    yyyy-mm-dd s(999999) ...
* xsisgg  2000-03-30 created
* xsethz  2000-07-27 (CE7461)  extend Report and Bundle Names
* fhi     2000-08-24 QA03      Use NAT23006 for error values
* XSETHZ  2004-01-29 P(249557) Separator Page not printed
* xsetggr 2006-10-17 p(283614) change work of functions READ-NEXT and
*                   READHOLD-NEXT, add use of parameter EOMBUM-REP-INDEX
* fhi     2007-07-12 NOM3202   C-NATERR changed, NAD23006 is obsolete.
* xsetggr 2007-07-12 NOM3201   restow due changes in eombum-p
* xsetggr 2010-04-12 N3246     Implement Suspend bundles
* SU1     2014-03-05 NOMALL-1281 show last update user+date
* BLI     2014-10-21 NOMALL-1510 NAT954 IN NOMBU01N
* SU2     2018-02-01 NOMALL-1823 NOM 3.5: remove CONNECT
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 EOM-FUNCTION               (I2)
1 EOM-USER                   (A8)
PARAMETER USING EOMBUM-P
PARAMETER USING EOMMSG-P
* -----------------------------LDAs-------------------------------------
LOCAL USING EOM----E
LOCAL USING VDEFBU-L
LOCAL
1 BUNDLE VIEW OF NRM-BUNDLES
  2 B-BUNDLE
  2 B-BUNDRNB
  2 B-DESC
  2 B-USERID
  2 B-COORDINATOR-ID
  2 B-MASTER-REPNAME
  2 B-BUNDLE-STATUS
  2 B-LAST-MODIFIED
  2 B-MODIFIED-BY
  2 B-RETENTION-ACTION
  2 B-RETENTION-PERIOD
  2 REDEFINE B-RETENTION-PERIOD
    3 B-RET-NUMBER             (N3)
    3 B-RET-FACTOR             (A1)
    3 B-RET-CALENDAR           (A8)
  2 B-RETENTION-PERIOD-PURGE
  2 REDEFINE B-RETENTION-PERIOD-PURGE
    3 B-RET-PURGE-NUMBER       (N3)
    3 B-RET-PURGE-FACTOR       (A1)
    3 B-RET-PURGE-CALENDAR     (A8)
  2 B-FLUSH-TIME
  2 B-FLUSH-EVENTS             (1:8)
    3 B-FLUSH-REPORTS
  2 B-FLUSH-UNTIL
  2 B-FLUSH-INTERVAL
  2 B-FLUSH-LINES
  2 B-FLUSH-TIME-SCHEDULE
  2 B-FLUSH-DAYS               (1:30)
  2 B-FLUSH-WEEK-DAYS          (1:7)
  2 B-FLUSH-CALENDAR
  2 B-FLUSH-BEFORE-AFTER
  2 B-FLUSH-START
  2 B-FLUSH-END
  2 B-FLUSH-INT
  2 B-LAST-UPDATE      /*SU1
  2 B-LAST-UPDATE-USER /*SU1
*
1 BUNDLE-REPORT VIEW OF NRM-BUNDLE-REPORT
  2 BR-BUNDLE
  2 BR-REPNAME
  2 BR-BUNDLE-REPORT
  2 BR-GROUP
  2 BR-SEQNO
  2 BR-REPNO
  2 BR-SEPNO
  2 BR-PRINTER
1 #I                           (P2)
1 #NOE                         (P2) CONST <15>
1 #TIME                        (T)
1 #NAME-START                  (A50)
1 REDEFINE #NAME-START
  2 #BUNDLE-NAME               (A25)
  2 #REP-NAME                  (A25)
  2 REDEFINE #REP-NAME
    3 #REP-NAME-A1             (A1/1:25)
1 #NAME-END                    (A50)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
DECIDE ON FIRST EOM-FUNCTION
  VALUE EOM-INIT
    PERFORM INIT-GENERAL-ATTRIBUTES
  VALUE EOM-ADD
    PERFORM MODIFY-GENERAL-ATTRIBUTES
  VALUE EOM-READ,EOM-READHOLD, EOM-READ-NEXT, EOM-READHOLD-NEXT
    PERFORM READ-GENERAL-ATTRIBUTES
  VALUE EOM-MODIFY
    PERFORM MODIFY-GENERAL-ATTRIBUTES
  NONE  IGNORE
END-DECIDE
*
************************************************************************
DEFINE SUBROUTINE INIT-GENERAL-ATTRIBUTES
************************************************************************
RESET EOMBUM-GENERAL-ATTR (*)
*
PERFORM READ-BUNDLE-DEFAULTS
EOMBUM-RET-NUMBER   := BUNDLE-DEFAULTS.B-RETENTION-NUM
EOMBUM-RET-FACTOR   := BUNDLE-DEFAULTS.B-RETENTION-UNIT
EOMBUM-RET-CALENDAR := BUNDLE-DEFAULTS.B-RETENTION-CALENDAR
EOMBUM-RET-ACTION   := BUNDLE-DEFAULTS.B-RETENTION-ACTION
*
END-SUBROUTINE /* INIT-GENERAL-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE READ-BUNDLE-DEFAULTS
************************************************************************
M-MONITOR-ID := F#MONITOR-TASK-ID1 (<>)
FNDDEF. FIND BUNDLE-DEFAULTS WITH M-MONITOR-ID = M-MONITOR-ID
END-FIND
*
END-SUBROUTINE /* READ-BUNDLE-DEFAULTS
*
************************************************************************
DEFINE SUBROUTINE READ-GENERAL-ATTRIBUTES
************************************************************************
FNDBU. FIND BUNDLE WITH B-BUNDLE = EOMBUM-I-NAME
  IF NO RECORDS FOUND
    EOMMSG-NR         := 0408
    EOMMSG-FIELD-NAME := 'EOMBUM-I-NAME'
    ESCAPE BOTTOM (FNDBU.)
  END-NOREC
  PERFORM READ-ATTR-VALUES
  IF  EOM-FUNCTION = EOM-READHOLD OR = EOM-READHOLD-NEXT
    UPD. GET BUNDLE *ISN (FNDBU.)
    IF B-BUNDLE NE B-BUNDLE
      UPDATE(UPD.)
    END-IF
  END-IF
END-FIND
PERFORM LIST-BUNDLED-REPORTS
*
END-SUBROUTINE /* READ-GENERAL-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE READ-ATTR-VALUES
************************************************************************
IF BUNDLE.B-BUNDLE-STATUS NE ' '
  EOMBUM-BUNDLE-STATUS := BUNDLE.B-BUNDLE-STATUS
ELSE
  EOMBUM-BUNDLE-STATUS := 'M'
END-IF
EOMBUM-BUNDLE              := BUNDLE.B-BUNDLE
EOMBUM-USERID              := BUNDLE.B-USERID
EOMBUM-BUNDRNB             := BUNDLE.B-BUNDRNB
EOMBUM-DESC                := BUNDLE.B-DESC
EOMBUM-COORDINATOR-ID      := BUNDLE.B-COORDINATOR-ID
EOMBUM-MASTER-REPNAME      := BUNDLE.B-MASTER-REPNAME
EOMBUM-RET-ACTION          := BUNDLE.B-RETENTION-ACTION
EOMBUM-RET-NUMBER          := BUNDLE.B-RET-NUMBER
EOMBUM-RET-FACTOR          := BUNDLE.B-RET-FACTOR
EOMBUM-RET-CALENDAR        := BUNDLE.B-RET-CALENDAR
EOMBUM-RET-PURGE-NUMBER    := BUNDLE.B-RET-PURGE-NUMBER
EOMBUM-RET-PURGE-FACTOR    := BUNDLE.B-RET-PURGE-FACTOR
EOMBUM-RET-PURGE-CALENDAR  := BUNDLE.B-RET-PURGE-CALENDAR
EOMBUM-FLUSH-TIME          := BUNDLE.B-FLUSH-TIME
EOMBUM-FLUSH-TIME-SCHEDULE := BUNDLE.B-FLUSH-TIME-SCHEDULE
EOMBUM-FLUSH-LINES         := BUNDLE.B-FLUSH-LINES
EOMBUM-FLUSH-START         := BUNDLE.B-FLUSH-START
EOMBUM-FLUSH-END           := BUNDLE.B-FLUSH-END
EOMBUM-FLUSH-INT           := BUNDLE.B-FLUSH-INT
EOMBUM-FLUSH-BEFORE-AFTER  := BUNDLE.B-FLUSH-BEFORE-AFTER
EOMBUM-FLUSH-DAYS(*)       := BUNDLE.B-FLUSH-DAYS(*)
EOMBUM-FLUSH-WEEK-DAYS(*)  := BUNDLE.B-FLUSH-WEEK-DAYS(*)
EOMBUM-FLUSH-REPORTS(*)    := BUNDLE.B-FLUSH-REPORTS(*)
EOMBUM-LAST-MODIFIED       := BUNDLE.B-LAST-MODIFIED
EOMBUM-MODIFIED-BY         := BUNDLE.B-MODIFIED-BY
*
END-SUBROUTINE /* READ-ATTR-VALUES
*
************************************************************************
DEFINE SUBROUTINE MODIFY-GENERAL-ATTRIBUTES
************************************************************************
FNDMOD. FIND BUNDLE WITH B-BUNDLE = EOMBUM-I-NAME
  IF NO RECORDS FOUND
    ENTER
  END-NOREC
*
  DECIDE FOR FIRST CONDITION
    WHEN EOM-FUNCTION = EOM-ADD AND *NUMBER(FNDMOD.) = 0
      B-BUNDLE := EOMBUM-I-NAME
    WHEN EOM-FUNCTION = EOM-ADD AND *NUMBER(FNDMOD.) > 0
      EOMMSG-NR := 0404
      EOMMSG-FIELD-NAME:= 'EOMBUM-I-NAME'
      ESCAPE BOTTOM (FNDMOD.)
    WHEN EOM-FUNCTION = EOM-MODIFY AND *NUMBER(FNDMOD.) = 0
      EOMMSG-NR := 0408
      ESCAPE BOTTOM(FNDMOD.)
    WHEN NONE
      IGNORE
  END-DECIDE
*
  IF *NUMBER > 0
    GETMOD. GET BUNDLE *ISN (FNDMOD.)
  END-IF
*
  #TIME := *TIMX
  IF EOMBUM-BUNDLE-STATUS NE ' '
    B-BUNDLE-STATUS := EOMBUM-BUNDLE-STATUS
  ELSE
    B-BUNDLE-STATUS := 'M'
  END-IF
*
  IF EOMBUM-RET-NUMBER NE MASK(NNN)
    RESET EOMBUM-RET-NUMBER
  END-IF
  IF EOMBUM-FLUSH-UNTIL NE MASK(NNNN)
    RESET EOMBUM-FLUSH-UNTIL
  END-IF
  IF EOMBUM-FLUSH-INTERVAL NE MASK(NNN)
    RESET EOMBUM-FLUSH-INTERVAL
  END-IF
  IF EOMBUM-RET-PURGE-NUMBER NE MASK(NNN)
    RESET EOMBUM-RET-PURGE-NUMBER
  END-IF
  IF EOMBUM-FLUSH-LINES NE MASK (NNNNNNNNN)
    RESET EOMBUM-FLUSH-LINES
  END-IF
*
  B-COORDINATOR-ID      := EOMBUM-COORDINATOR-ID
  B-DESC                := EOMBUM-DESC
  B-LAST-MODIFIED       := #TIME
  B-USERID              := EOM-USER
  B-MODIFIED-BY         := EOM-USER
  B-RETENTION-ACTION    := EOMBUM-RET-ACTION
  B-RET-NUMBER          := EOMBUM-RET-NUMBER
  B-RET-FACTOR          := EOMBUM-RET-FACTOR
  B-RET-CALENDAR        := EOMBUM-RET-CALENDAR
  B-FLUSH-UNTIL         := EOMBUM-FLUSH-UNTIL
  B-FLUSH-INTERVAL      := EOMBUM-FLUSH-INTERVAL
  B-RET-PURGE-NUMBER    := EOMBUM-RET-PURGE-NUMBER
  B-RET-PURGE-FACTOR    := EOMBUM-RET-PURGE-FACTOR
  B-RET-PURGE-CALENDAR  := EOMBUM-RET-PURGE-CALENDAR
  B-FLUSH-TIME-SCHEDULE := EOMBUM-FLUSH-TIME-SCHEDULE
  B-FLUSH-REPORTS(*)    := EOMBUM-FLUSH-REPORTS(*)
  B-FLUSH-LINES         := EOMBUM-FLUSH-LINES
  B-FLUSH-START         := EOMBUM-FLUSH-START
  B-FLUSH-END           := EOMBUM-FLUSH-END
  B-FLUSH-INT           := EOMBUM-FLUSH-INT
  B-FLUSH-BEFORE-AFTER  := EOMBUM-FLUSH-BEFORE-AFTER
  B-FLUSH-DAYS(*)       := EOMBUM-FLUSH-DAYS(*)
  B-FLUSH-WEEK-DAYS(*)  := EOMBUM-FLUSH-WEEK-DAYS(*)
  B-LAST-UPDATE         := *TIMX /*SU1
  B-LAST-UPDATE-USER    := EOM-USER
*
  IF *NUMBER (FNDMOD.) = 0
    STOBU. STORE BUNDLE
  ELSE
    UPDATE (GETMOD.)
  END-IF
*
END-FIND
*
END-SUBROUTINE /* MODIFY-GENERAL-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE LIST-BUNDLED-REPORTS
************************************************************************
RESET #I
#BUNDLE-NAME        := EOMBUM-BUNDLE
#REP-NAME-A1 (1:25) := H'FF'
#NAME-END           := #NAME-START
#REP-NAME-A1 (1:25) := H'00'
*
RDBR. READ BUNDLE-REPORT BY BR-BUNDLE-REPORT =#NAME-START THRU #NAME-END
  ADD 1 TO #I
  IF #I > #NOE                              /* BLI NOMALL-1510 in
    ESCAPE BOTTOM                           /* BLI NOMALL-1510 in
  END-IF                                    /* BLI NOMALL-1510 in
  EOMBUM-REP-GROUP(#I)   := BUNDLE-REPORT.BR-GROUP
  EOMBUM-REP-SEQNO(#I)   := BUNDLE-REPORT.BR-SEQNO
  EOMBUM-REP-REPNAME(#I) := BUNDLE-REPORT.BR-REPNAME
  EOMBUM-REP-REPNO (#I)  := BUNDLE-REPORT.BR-REPNO
  EOMBUM-REP-SEPNO(#I)   := BUNDLE-REPORT.BR-SEPNO
  EOMBUM-REP-PRINTER(#I) := BUNDLE-REPORT.BR-PRINTER
END-READ
*
IF #I < #NOE
  RESET EOMBUM-REP-LIST (#I+1:#NOE)
END-IF
EOMBUM-REP-INDEX := #I
*
END-SUBROUTINE /* LIST-BUNDLED-REPORTS
* --------------------------------------- on error ---------------------
INCLUDE C-EOMERR
*
END
