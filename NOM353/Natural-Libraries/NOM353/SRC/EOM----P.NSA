DEFINE DATA PARAMETER
/* >Natural Source Header 000000
/* :Mode S
/* :CP
/* <Natural Source Header
*   ---------------------------------      -----------------------------------
*   Program    EOM----P
*   Version    1.3
*   Function   EOM API
*
*   Maintenance:
*   uuu yy-mm-dd s(999999) ...
*   mrs 93-05-19           created
*   XSETHZ  2000-07-26 (CE7461)                EXTEND REPORT AND BUNDLE NAMES
*   XSETGGR 2003-07-25 P(240465)               MARK NON-DEFINED USERID
*   xsetggr 2007-09-04 NOM3201       Support P11 format run numbers
*   --------------------------------------------------------------------------
1 EOM-PARMS
  2 EOM-FUNCTION (I2)
  2 EOM-WORK-AREA (A250/1:4)
  2 REDEFINE EOM-WORK-AREA /* REDEF. BEGIN : EOM-WORK-AREA
    3 EOM-USER (A8)
    3 EOM-USER-TYPE (A1)
    3 EOM-LANGUAGE (N2)
    3 EOM-DATE-FORMAT (A1)
    3 EOM-VERSION (I2)
    3 EOM-LIBRARY (A8)
    3 EOM-USER-LIBRARY (A8)
    3 EOM-LOG-TYPES (A1/1:10)
*
    3 EOM-LOGGING
      4 EOM-LOG-OBJECT-NAME (A25) /* (A17) XSETHZ  (CE7461)
      4 EOM-LOG-OBJTYP (A1)
      4 EOM-LOG-FUNCTION (I2)
      4 EOM-LOG (L)
*
    3 EOM-USER-PROFILE (A250)
    3 EOM-USER-LISTS (A8/1:20)
*
    3 EOM-SECURITY
      4 EOM-OBJTYP (A1)
      4 EOM-OBJTYP-SECURITY (A1/1:6)
      4 EOM-OBJECT-NAME (A25) /* (A17) XSETHZ  (CE7461)
      4 EOM-OBJECT-RUN-NUMBER (P11) /* (P7) xsetggr NOM3201
      4 EOM-OBJECT-SECURITY (A1/1:6)
    3 EOM-DEF-USER (A1) /* XSETGGR 2003-07-24 P(240465)
END-DEFINE
