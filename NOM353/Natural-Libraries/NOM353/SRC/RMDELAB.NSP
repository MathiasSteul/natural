* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RDELAB
* FUNCTION  : DELETE ACTIVE BUNDLE
*  IT WILL DELETE THE ACTIVE BUNDLE CONTROL RECORD
*             AND THE BUNDLE-CONTENTS RECORDS
*             AND MODIFY THE ACTIVE-REPORT NEED-COUNT IF REPORT ISNOT ON
*             DATABASE.
* XSISZHA 2000-08-15 (CE7461) EXTEND REPORT AND BUNDLE NAMES
* ----------------------------------------------------
DEFINE DATA
GLOBAL USING MONIT-GL
LOCAL USING VBURP-L    /* BUNDLE-CONTENTS
LOCAL USING SUPER-L    /* SUPER DESCRIPTORS
LOCAL
1 #BC-BUND-RNB  (A31)
1 REDEFINE #BC-BUND-RNB
  2 #BC-BUNDLE  (A25)
  2 #BC-BUNDRNB (P7)
  2 #BC-SEQNO   (P3)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#AB-BUNDLE := #BC-BUNDLE := G-C-BUNDLE
#AB-BUNDRNB := #BC-BUNDRNB := G-C-BUNDRNB
FIND-AB. FIND ACTIVE-BUNDLES WITH AB-BUNDLE-RNB = #AB-BUNDLE-RNB
  RESET #BC-SEQNO
  FIND-BC.
  READ BUNDLE-CONTENTS BY BC-BUNDLE-RNB STARTING FROM  #BC-BUND-RNB
    IF BC-BUNDLE NE G-C-BUNDLE OR BC-BUNDRNB NE G-C-BUNDRNB
      ESCAPE BOTTOM
    END-IF
    #AR-REPNAME := BC-REPNAME
    #AR-REPRNB := BC-REPRNB
    DELETE RECORD (FIND-BC.)
  END-READ
  DELETE RECORD (FIND-AB.)
END-FIND
*
END
