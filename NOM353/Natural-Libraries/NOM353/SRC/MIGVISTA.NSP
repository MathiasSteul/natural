DEFINE SUBROUTINE DO-IT
*
DECIDE ON EVERY VALUE OF UT-VIEW /* to rerun the job if necessary
  VALUE ' ' /*start from beginning
    RESET UT-KEY /*SU1
    UT-VIEW := 'AR' /*SU4 was AB
  VALUE 'AR' /*must be first to upd related objects /*SU4 moved
    INCLUDE MIGVISTC 'AR' 'AR-REPORT-RNB' 'AR-' '''AR'''
      'AR-PROCESS-TIME' 'UT-KEY'
    COMPRESS '  related objects (AC,FS,MA,DR and PO)' TO #MSG
    PERFORM WRITE-MSG
    COMPRESS '  updated:' ##COUNTER-OT
      ' already filled:' ##COUNTER-OT-NOT TO #MSG LEAVING NO
    PERFORM WRITE-MSG
    IF NOT #TIME-STOP /*SU5
      UT-VIEW := 'AB' /*SU4 was AD
    END-IF /*SU5
  VALUE 'AB' /*must be second to upd related objects
    RESET ##COUNTER-OT ##COUNTER-OT-NOT /*SU4
    INCLUDE MIGVISTC 'AB' 'AB-BUNDLE-RNB' 'AB-' '''AB''' 'AB-FLUSH-TIME'
      'UT-KEY'
    COMPRESS '  related objects (BC and PO)' TO #MSG
    PERFORM WRITE-MSG
    COMPRESS '  updated:' ##COUNTER-OT
      ' already filled:' ##COUNTER-OT-NOT TO #MSG LEAVING NO
    PERFORM WRITE-MSG
    IF NOT #TIME-STOP /*SU5
      UT-VIEW := 'AC'
    END-IF /*SU5
  VALUE 'AC'
