DEFINE SUBROUTINE WRITE-MSG
************************************************************************
IF *DEVICE NE 'BATCH'
  PRINT #MSG
END-IF
PERFORM XXRLOG-WRITE-LOG 'W' #MSG
*
END-SUBROUTINE /* WRITE-MSG
*
************************************************************************
DEFINE SUBROUTINE UPD-AR-REL /*invoked from MIGVISTC SU4
************************************************************************
CALLNAT 'MIGVIST2' AR.AR-REPORT-RNB AR.AR-PROCESS-TIME
  ##COUNTER-OT ##COUNTER-OT-NOT
*
