DEFINE SUBROUTINE HANDLE-AB-DATE /*invoked from MIGVISTC SU4
************************************************************************
IF AB.AB-FLUSH-TIME = T'00:00:00' /*Close date
  #OPENP := AB.AB-OPEN-TIME
  #OPENP := - (#OPENP - #MAX-INV-TIME)
  AB.AB-FLUSH-TIME := #OPENP
END-IF
*
END-SUBROUTINE /* HANDLE-AB-DATE
*
************************************************************************
DEFINE SUBROUTINE CHECK-ELAPSED-TIME /*invoked from MIGVISTC SU5
************************************************************************
IF #HOURS NE 0
  #TIMD := *TIMD (ST.)
  IF #TIMD_HH GE #HOURS
    COMPRESS #TIMD_HH ':' #TIMD_MM TO #MSG LEAVING NO
    COMPRESS #PROGRAM 'stopped after' #HOURS 'hours. Elapsed time:'
      #MSG '(HH:II)' TO #MSG
    PERFORM WRITE-MSG
    #TIME-STOP := TRUE
    ESCAPE BOTTOM /* END-READ in MIGVISTC
  END-IF
END-IF
*
END-SUBROUTINE /* CHECK-ELAPSED-TIME
*
