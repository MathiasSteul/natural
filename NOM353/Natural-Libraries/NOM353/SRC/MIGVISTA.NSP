  VALUE 'AD'
   INCLUDE MIGVISTC 'AD' 'AD-ARCHIVE-DSNAME' 'AD-' '''AD''' 'AD-CREATED'
      'UT-KEY'
    IF NOT #TIME-STOP /*SU5
      UT-VIEW := 'BC'
    END-IF /*SU5
  VALUE 'BC'
    INCLUDE MIGVISTC 'BC' 'BC-BUNDLE-RNB' 'BC-' '''BC''' '#TIMX'
      'UT-KEY'
    IF NOT #TIME-STOP /*SU5
      UT-VIEW := 'DR'
    END-IF /*SU5
  VALUE 'DR'
    INCLUDE MIGVISTC 'DR' 'DR-REPORT-RNB' 'DR-' '''DR''' '#TIMX'
      'UT-KEY'
    IF NOT #TIME-STOP /*SU5
      UT-VIEW := 'FN'
    END-IF /*SU5
  VALUE 'FN'
    INCLUDE MIGVISTC 'FN' 'HA-SHORT-FILENAME' ' ' '''FN''' '#TIMX'
      'UT-KEY'
* NOMALL-79 2014-10-23 fhi: Line above was SHORT-FILENAME
    IF NOT #TIME-STOP /*SU5
      UT-VIEW := 'FS'
    END-IF /*SU5
  VALUE 'FS'
    INCLUDE MIGVISTC 'FS' 'F-REPNAME-RNB-SEQ' 'F-' '''FS''' '#TIMX'
      'UT-KEY'
    IF NOT #TIME-STOP /*SU5
      UT-VIEW := 'MA'
    END-IF /*SU5
  VALUE 'MA'
    INCLUDE MIGVISTC 'MA' 'MA-REP-RNB' 'MA-' '''MA''' '#TIMX'
      'UT-KEY'
    IF NOT #TIME-STOP /*SU5
      UT-VIEW := 'PO'
    END-IF /*SU5
  VALUE 'PO'
    #NUMERIC := TRUE /*SU2
    INCLUDE MIGVISTC 'PO' 'PO-ID' 'PO-' '''PO''' '#TIMX'
      'UT-KEY_N29' /*SU2 PO-REPORT-RNB -> PO-ID
    IF NOT #TIME-STOP /*SU5
      UT-VIEW := 'SE'
    END-IF /*SU5
  VALUE 'SE'
    INCLUDE MIGVISTC 'SE' 'SESSION-USER' 'SE-' '''SE''' '#TIMX'
      'UT-KEY'
    IF NOT #TIME-STOP /*SU5
      UT-VIEW := 'SR'
    END-IF /*SU5
  VALUE 'SR'
    #NUMERIC := TRUE /*SU2
    INCLUDE MIGVISTC 'SR' 'SR-ID' 'SR-' '''SR''' '#TIMX'
      'UT-KEY_N29' /*SU2 SR-CONTROL -> SR-RELATED-ID SU3 -> SR-ID
    IF NOT #TIME-STOP /*SU5
      UT-VIEW := 'SS'
    END-IF /*SU5
  VALUE 'SS'
    INCLUDE MIGVISTC 'SS' 'SS-ITEM' 'SS-' '''SS''' '#TIMX'
      'UT-KEY'
    IF NOT #TIME-STOP /*SU5
      UT-VIEW := 'SI'
