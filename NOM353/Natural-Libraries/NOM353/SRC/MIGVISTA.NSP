/*
/* Initialization
/*
/*SU6 OPTIONS MCG=(OVFLW=ON,INDX=ON,ZD=OFF)
#PROGRAM  := *PROGRAM
#TIMX     := *TIMX
UTIL. FIND UT WITH UT-UTILITY = #PROGRAM
  IF NO RECORDS FOUND
    UT-UTILITY := #PROGRAM
    STORE UT
    COMPRESS #PROGRAM 'started.' TO #MSG
    PERFORM WRITE-MSG
* fhi     2014-03-03 NOMALL-1363 start insertion
    PERFORM XXCATAL-GET-CATDATE #CATDATE
    COMPRESS #PROGRAM 'cataloged at'  #CATDATE TO #MSG
    PERFORM WRITE-MSG
* fhi     2014-03-03 NOMALL-1363 end   insertion
    ESCAPE BOTTOM (UTIL.)
  END-NOREC
  DECIDE FOR EVERY CONDITION
    WHEN UT-VIEW = ' '
      RESET UT-KEY
      COMPRESS #PROGRAM 'started.' TO #MSG
      PERFORM WRITE-MSG
      ESCAPE BOTTOM (UTIL.)
    WHEN *DATA > 0
      INPUT '=' #FUNCTION (AD=MILT)
      IF #FUNCTION IS (N2) /*SU5 ->
        #HOURS := VAL (#FUNCTION)
        RESET #FUNCTION
      END-IF /*SU5 <-
    WHEN #FUNCTION = 'DELETE'
      ESCAPE BOTTOM (UTIL.)
    WHEN #FUNCTION = 'NEW'
      #MSG := 'Job start forced from beginning.'
      PERFORM WRITE-MSG
      RESET UT-VIEW UT-KEY
    WHEN NONE
      COMPRESS 'Job will restart with view' UT-VIEW 'at key' UT-KEY
        TO #MSG
      PERFORM WRITE-MSG
  END-DECIDE
END-FIND
END TRANSACTION
/*
* INCLUDE MIGVISTC '&1&' '&2&' '&3&' '''BR''' '#TIMX'
* &1& - view name 2 or 3 chars
* &2& - descriptor name
* &3& - prefix name for fields
* &4& - object type: 2 bytes ÜÜ
* &5& - time field from DDM or #TIMX
* &6& - start value for &2& (numeric or alpha) SU2
ST. SETTIME /*SU5 ->
IF *DATA > 0
  INPUT 'Maximum elapsed time in hours:' #HOURS
END-IF /*SU5 <-
IF #FUNCTION NE 'DELETE' /* DELETE: Only deletion of UT record
  PERFORM DO-IT
END-IF
FIND (1) UT WITH UT-UTILITY = #PROGRAM
  DELETE
END-FIND
COMPRESS #PROGRAM 'finished.' TO #MSG
PERFORM WRITE-MSG
END TRANSACTION
*
