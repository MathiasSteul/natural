* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RDEFSY - System Defaults
*
* Maintenance
* uuu yy-mm-dd s(999999) Description
* mrs 93-06-17           created
* gw  94-05-13           new field M-USE-OWNER
* jwo 97-07-07 p(163545) don't user M-TIME-SCHEDULE for task, which has
*                        to be done daily anyway.
* jvd 98-09-10 p(164220) NOM141ÖNAT23
* jvd 99-06-26 p(183302) NOM142 changes
* fhi 00-01-26 p(191368) Module taken from NOM142 and restowed.
* wcd 00-04-01 CE 7267   New PFkey for additional printers in RPFK---L
* xsisgg 00-07-28 CE7461 new field in NRM-MONITOR to support long
*                        report and bundle names
* sju 02-02-22 NOM221    Display active data dbid/fnr
* xsetoba 02-04-08 CE7553 Default Profile non-defined users
* sju 02-04-16 NOM221    Allow display mode
* xsetoba 02-08-08 CE7553 Default Profile non-defined users
*                        DEFAULT user adding and deleting
* fhi     03-04-04 CE7553 correcting xsetoba 02-08-08
* xsetggr 2003-08-11 p(240465) correct CE7553 solution
* fhi     2003-12-17 p(248647) NAT0954 (0c7) in NOMOO-P
* xsetggr 2005-06-30 p(248647) correct solution
* xsetggr 2005-10-26 p(270950) ISN fields must be P10, not P8
* fhi     2009-11-16 P304569  Modify only if PF10 pressed
* fhi     2010-02-01 P304569  Show additionally record kind
* fhi     2010-04-14 P325064  Show lfile 206 if system file fields empty
* fhi     2010-09-03 NOMALL-97 Extend message line
* xsetggr 2011-05-11 NOMALL-986 fill EOM-LIBRARY, EOM-USER-LIBRARY
*                    before calling EOMUSM-N
* fhi     2012-08-08 NOMALL-1143 Use zip compression on Unix
*                    For future use. Has been diabled in maps.
* SU1     2013-01-31 unused      Deactivate unused data areas
* raya    2013-03-07 NOMALL-1236 change msg 1543,update when msg 1565
* fhi     2013-11-15 NOMALL-1304 wrong Y/N validation
* SU2     2014-01-14 NOMALL-1304 check 'support long names'(correct fhi)
* SU3     2014-03-05 NOMALL-1281 show last update user+date
* fhi     2014-06-18 NOMALL-1284 Allow Hold retention of printouts
* fhi     2014-07-09 NOMALL-1284 same, add help / validation
* fhi     2015-11-03 NOMALL-1702 Handle $EOM_WORK on Unix (log type 'W')
* fhi     2016-11-15 NOMALL-1961 Use new task IDs
* fhi     2018-12-13 NOMALL-1718 Adapt to NGC behavior
* ----------------------------------------------------------------------
DEFINE DATA
GLOBAL USING NRM-GL
LOCAL USING RPFK---L
LOCAL USING SATFNC3E
LOCAL USING SATLF02P
LOCAL USING EOM----P
LOCAL USING EOM----E
LOCAL USING EOMUSM-P
LOCAL USING EOMMSG-P
LOCAL USING EOMUSM-E
LOCAL USING RLOG-L
* *****
LOCAL
1 USERS VIEW OF NRM-USERS
1 NRM-MONITOR VIEW OF NRM-MONITOR
  2 M-USE-OWNER
  2 M-MONITOR-ID
  2 M-NATRPT-DBID-N5
  2 M-NATRPT-FNR-N5
  2 M-DATE-FORMAT
  2 M-LOG-RETENTION
  2 M-LOG-TYPES (1:10)
  2 M-PO-RETENTION
  2 M-HOLD-RETENTION
  2 M-PO-TYPES (1:3)
  2 M-CUSTOM-APPL (1:5)
  2 REDEFINE M-CUSTOM-APPL
    3 M-AP-TAB (1:5)
      4 M-AP-TITLE     (A32)
      4 M-AP-LIBRARY   (A8)
      4 M-AP-COMMAND   (A8)
      4 M-AP-PARAM     (A25)
      4 M-AP-FILLER    (A177)
  2 M-SUPPORT-LONG-NAMES
  2 M-USER-AUTODEF
  2 M-BUNDLE-DEFAULTS
  2 M-LAST-ACTIVE (T)     /* Last time the monito
  2 REDEFINE M-LAST-ACTIVE
    3 M-LAST-ACTIVE-CK (A7)  /* CHECK IF FIELD IS FORMAT 'T'
  2 M-ARCHIVE-TIME (T)  /* Time in a day to sta
  2 REDEFINE M-ARCHIVE-TIME
    3 M-ARCHIVE-TIME-CK (A7)  /* CHECK IF FORMAT IS 'T'
  2 M-USE-ZIP-COMPR           /* NOMALL-1143 in
  2 M-LAST-UPDATE /*SU3
  2 M-LAST-UPDATE-USER /*SU3
1 DAILY-CLEANUP-TASK VIEW OF NRM-ARCHIVE-TASK
  2 M-MONITOR-ID
  2 M-PLAN-ARC-TIME
  2 M-ARCHIVE-CALENDAR
  2 M-ARCHIVE-BEFORE-AFTER
  2 M-ARCHIVE-TIME
  2 M-ARCHIVE-TIME-END
  2 M-ARCHIVE-TIME-INT
  2 M-ARCHIVE-DAYS (1:31)
  2 M-ARCHIVE-WEEK-DAYS (1:7)
1 #BUNDLE-DEFAULTS          (A250)
1 REDEFINE #BUNDLE-DEFAULTS
  2 #BUNDDEF
    3 B-CHAR-FIELDS1        (A40)
    3 B-FLUSH-TIME          (T)
    3 REDEFINE B-FLUSH-TIME
      4 B-FLUSH-TIME-A      (A7)
    3 B-CHAR-FIELDS2        (A197)
* ----------------------------------------------------------------------
1 #FATHER-PROG                 (A8) INIT <'RDFMEN'>
1 CV-MAP                       (C) INIT <(AD=I)>
1 #ISN                         (N10)
1 L-HEADER                     (A78)
1 #ALLOWED                     (L)
1 #LEN                         (N2)
1 #RETENTION                   (A4)
1 REDEFINE #RETENTION
  2 #RET-V                     (A1/4)
1 I                            (P3)
1 #FUNC                        (A1)
1 #LANGUAGE                    (I1)
1 #PANEL                       (I2) INIT <1>
1 #START-TIME                  (A4)
1 #CURRENT-TIME                (T)
1 #DATE                        (A8)
1 #PLAN-SCHED-TIME             (A5)
1 #PLAN-SCHED-DATE             (A10)
1 #ERC                         (N4)
1 #ERT                         (A250)
1 #LONG-NAMES                  (A1)
1 #AUTODEF                     (A1)
1 #LFILE-ACTIVE                (N5)       CONST <91>
1 #LFILE-DATA                  (N5)       CONST <206>
1 #DBID-ACTIVE                 (N5)
1 #DBID-DATA                   (N5)
1 #FNR-ACTIVE                  (N5)
1 #FNR-DATA                    (N5)
1 #USERID                      (A8)
1 #PROF-STRING                 (A100)
1 #PROGRAM                     (A8)
1 #LOG-FLAG                    (L)
1 #LAST-MOD                    (A40) /*SU3
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET G-COMMIT
#PROGRAM := *PROGRAM
*
IF G-C-FUNC = 'X' /* recursivly called
  G-C-FUNC := #FUNC := 'M'
ELSE
  #FUNC    := 'D'
END-IF
SATLF-SATVERS  := 21
SATLF-FUNCTION := 'GET'
SATLF-LFILE    := #LFILE-ACTIVE
CALLNAT SAT-GET-SET-LFILE SATLF-SATVERS SATLF-PARMS (*)
IF SATLF-ERROR-CODE = 0 AND SATLF-DBID-N5 NE 0 AND SATLF-FNR-N5 NE 0
  #DBID-ACTIVE := SATLF-DBID-N5
  #FNR-ACTIVE  := SATLF-FNR-N5
END-IF
SATLF-SATVERS  := 21
SATLF-FUNCTION := 'GET'
SATLF-LFILE    := #LFILE-DATA
CALLNAT SAT-GET-SET-LFILE SATLF-SATVERS SATLF-PARMS (*)
IF SATLF-ERROR-CODE = 0 AND SATLF-DBID-N5 NE 0 AND SATLF-FNR-N5 NE 0
  #DBID-DATA := SATLF-DBID-N5
  #FNR-DATA  := SATLF-FNR-N5
END-IF
*
MAIN-LOOP. REPEAT
  NRM-MONITOR.M-MONITOR-ID := F#MONITOR-TASK-ID1 (<>)
  FIND-LOOP. FIND NRM-MONITOR WITH M-MONITOR-ID =
      NRM-MONITOR.M-MONITOR-ID
    IF NO RECORDS FOUND
      *ERROR-NR := 999 /*internal error
/*SU 2018-05-22 RM-MONITOR.M-MONITOR-ID := RMTASK-P.TASK-ID
/*    RESET M-LAST-ACTIVE M-ARCHIVE-TIME B-FLUSH-TIME
/*    M-BUNDLE-DEFAULTS := #BUNDLE-DEFAULTS
/*    M-LAST-UPDATE      := *TIMX /*SU3
/*    M-LAST-UPDATE-USER := G-USERID /*SU3
/*    STOR. STORE NRM-MONITOR END TRANSACTION ESCAPE BOTTOM
    END-NOREC
    IF M-LAST-ACTIVE-CK = ' '
      RESET M-LAST-ACTIVE
    END-IF
    IF M-ARCHIVE-TIME-CK = ' '
      RESET M-ARCHIVE-TIME
    END-IF
    #BUNDLE-DEFAULTS := M-BUNDLE-DEFAULTS
    IF B-FLUSH-TIME-A = ' '
      RESET B-FLUSH-TIME
      M-BUNDLE-DEFAULTS := #BUNDLE-DEFAULTS
    END-IF
    CALLNAT 'N-HEAD2' M-LAST-UPDATE-USER M-LAST-UPDATE /*SU3
      #LAST-MOD G-DATE-FORMAT /*SU3
*
    #ISN := *ISN
    G-HOLD-TIME := *TIMX
    #LONG-NAMES := M-SUPPORT-LONG-NAMES
    #AUTODEF := M-USER-AUTODEF
    IF #AUTODEF = ' '
      #AUTODEF := 'N' /* default value 'no auto definition'
    END-IF
    DECIDE ON FIRST VALUE OF #FUNC
      VALUE 'M'
        CALLNAT 'NARPSEC' G-USER-PROFILE 'MMO' #ALLOWED
        INCLUDE C-NALLOW
        IF NOT #LOG-FLAG
          LG-USERID := G-USERID
          LG-CODE := 'MO'
          IF G-LANGUAGE = 2
            G-NATRP-ERT := '''System-Standards'''
          ELSE
            G-NATRP-ERT := '''System-Defaults'''
          END-IF
          COMPRESS '1543' G-NATRP-ERT TO LG-MSG
          G-NATRP-ERC :=      1543
          CALLNAT 'RLOG' PL-PARMS
          END TRANSACTION
          #LOG-FLAG := TRUE
        END-IF
        GETREC.     GET NRM-MONITOR #ISN
        GETTSK.     GET DAILY-CLEANUP-TASK #ISN
      VALUE 'D'
        CALLNAT 'NARPSEC' G-USER-PROFILE 'DMO' #ALLOWED
        INCLUDE C-NALLOW
        CV-MAP := (AD=IP)
        DAILY-CLEANUP-TASK.M-MONITOR-ID := F#MONITOR-TASK-ID1 (<>)
        FIND DAILY-CLEANUP-TASK WITH M-MONITOR-ID =
            DAILY-CLEANUP-TASK.M-MONITOR-ID
        END-FIND
        PERFORM GET-NEXT-PLAN-TIME
      NONE VALUE IGNORE
    END-DECIDE
*
    SCREEN-LOOP. REPEAT
      IF #LANGUAGE NE *LANGUAGE
        PERFORM INIT-PFKEYS
        #LANGUAGE := *LANGUAGE
      END-IF
      PERFORM SET-PFKEYS
      PERFORM FLIP-DISPLAY
      INCLUDE C-HOLD
      PERFORM BEFORE-INPUT
      CALLNAT 'N-HEADER' L-HEADER G-DATE-FORMAT 'RDEFMOM1'
      RESET G-MAP-MODIFIED
      DECIDE ON FIRST #PANEL
        VALUE 2
          INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
            MARK *G-DIRECT-COMMAND USING MAP 'RDEFSY2&'
        NONE VALUE
          INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
            MARK *G-DIRECT-COMMAND USING MAP 'RDEFSYM&'
      END-DECIDE
      RESET G-NATRP-ERC G-NATRP-ERT
      INCLUDE RPFKVA-C
      INCLUDE C-DIRECT
      INCLUDE RPFKED-C
      IF G-PF-FUNC = ##PFK-MODIFY
          AND G-C-FUNC = 'M' /* modify allowed in user profile
        G-C-FUNC := 'X'
        FETCH RETURN #PROGRAM
        ESCAPE BOTTOM (MAIN-LOOP.)
      END-IF
      IF (CV-MAP MODIFIED OR G-MAP-MODIFIED) AND #FUNC NE 'D'
        PERFORM VALIDATE-INPUT
        M-SUPPORT-LONG-NAMES := #LONG-NAMES
        IF #LONG-NAMES = 'Y'
          G-SUPPORT-LONG-NAMES := TRUE
        ELSE
          RESET G-SUPPORT-LONG-NAMES G-DISPLAY-LONG-NAMES
        END-IF
        M-USER-AUTODEF := #AUTODEF
        PERFORM GET-NEXT-PLAN-TIME
        M-LAST-UPDATE      := *TIMX /*SU3
        M-LAST-UPDATE-USER := G-USERID /*SU3
        UPDATE(GETREC.)
        UPDATE(GETTSK.)
        RESET  EOM-LOGGING EOM-LOG-TYPES (*)
        EOMUSM-I-NAME := 'DEFAULT'
        EOM-USER := 'DEFAULT'
        EOM-USER-TYPE := 'A'
        EOM-LANGUAGE := *LANGUAGE
        CALLNAT 'RGETLIB' EOM-LIBRARY
        COMPRESS EOM-LIBRARY 'U' TO EOM-USER-LIBRARY LEAVING NO
        EOMUSM-I-ATTRIBUTE-TYPE := USER-GENERAL-ATTRIBUTES
        DECIDE ON FIRST #AUTODEF
          VALUE 'N'
            FIND1. FIND NUMBER USERS WITH USER-ID = EOM-USER
            IF *NUMBER(FIND1.) > 0
              EOM-FUNCTION := EOM-SECURITY-CHECK
              EOMUSM-I-CHECK-FUNCTION := EOM-DELETE
              EOMUSM-I-ATTRIBUTE-TYPE := USER-GENERAL-ATTRIBUTES
              CALLNAT 'EOMUSM-N' EOM-PARMS EOMUSM-PARMS EOMMSG-PARMS
              IF EOMMSG-NR NE 0
                DISPLAY EOMMSG-NR EOMMSG-FIELD-NAME
                ESCAPE BOTTOM (MAIN-LOOP.)
              END-IF
              EOM-FUNCTION := EOM-DELETE
              CALLNAT 'EOMUSM-N' EOM-PARMS EOMUSM-PARMS EOMMSG-PARMS
              IF EOMMSG-NR NE 0
                BACKOUT TRANSACTION
              ELSE
                END TRANSACTION
              END-IF
            END-IF
          VALUE 'Y' , 'P'
            CALLNAT 'RDEFUS-N' #USERID #LANGUAGE #PROF-STRING G-USERID
          NONE VALUE
            IGNORE
        END-DECIDE
        G-NATRP-ERC := 0032
        INCLUDE C-COMMIT
      END-IF
      INCLUDE REXDO--C
      DECIDE ON FIRST VALUE OF G-PF-FUNC
        VALUE ##PFK-CUSTOM-APPL
          #PANEL := 2
          RESET #LANGUAGE
        VALUE ##PFK-EXIT-SUBFUNC
          #PANEL := 1
          RESET #LANGUAGE
        NONE VALUE
          IGNORE
      END-DECIDE
*
    END-REPEAT
  END-FIND
END-REPEAT
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE BEFORE-INPUT
************************************************************************
IF DAILY-CLEANUP-TASK.M-PLAN-ARC-TIME = 0
  RESET #PLAN-SCHED-DATE #PLAN-SCHED-TIME
ELSE
  MOVE EDITED DAILY-CLEANUP-TASK.M-PLAN-ARC-TIME (EM=HH':'II)
    TO #PLAN-SCHED-TIME
  MOVE EDITED DAILY-CLEANUP-TASK.M-PLAN-ARC-TIME (EM=YYYYMMDD) TO #DATE
  CALLNAT 'IODATE-N' 'M' 'L' #DATE #PLAN-SCHED-DATE G-DATE-FORMAT
    #ERC #ERT
  IF #ERC NE 0
    G-NATRP-ERC := #ERC
    G-NATRP-ERT := #ERT
  END-IF
END-IF
DECIDE FOR FIRST CONDITION
  WHEN #DBID-DATA < 1 OR #FNR-DATA < 1
    IGNORE
  WHEN  M-NATRPT-DBID-N5 NE #DBID-DATA OR M-NATRPT-FNR-N5 NE #FNR-DATA
    UPDSYS. GET NRM-MONITOR #ISN
    M-NATRPT-DBID-N5 := #DBID-DATA
    M-NATRPT-FNR-N5  := #FNR-DATA
    UPDATE (UPDSYS.)
    END TRANSACTION
    G-NATRP-ERC := 1565 /* DBID/FNR taken from lfile 206
  WHEN NONE
    IGNORE
END-DECIDE
*
END-SUBROUTINE /* BEFORE-INPUT
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-INPUT
************************************************************************
RESET NRM-MONITOR.M-AP-FILLER (*)
*
G-DATE-FORMAT := NRM-MONITOR.M-DATE-FORMAT
*
DECIDE FOR EVERY CONDITION
  WHEN NOT (NRM-MONITOR.M-USE-OWNER = 'Y' OR = 'N')
    REINPUT *1099 MARK *NRM-MONITOR.M-USE-OWNER ALARM
  WHEN NOT (NRM-MONITOR.M-DATE-FORMAT =
      'G' OR ='I' OR = 'A' OR ='E' OR = 'H' OR ='J' OR = 'B' OR ='F')
    REINPUT *0633 MARK *NRM-MONITOR.M-DATE-FORMAT ALARM
  WHEN NOT (#LONG-NAMES = 'Y' OR = 'N' )
    REINPUT *1099 MARK *#LONG-NAMES ALARM
  WHEN NOT (#AUTODEF = 'Y' OR = 'N' OR = 'P')
    REINPUT *1110 MARK *#AUTODEF
  WHEN NOT (NRM-MONITOR.M-PO-RETENTION IS (N4) OR
      NRM-MONITOR.M-PO-RETENTION = ' ')
    #RETENTION := NRM-MONITOR.M-PO-RETENTION
    EXAMINE #RETENTION FOR 'X' GIVING LENGTH IN #LEN
    IF #LEN < 2 OR NOT(#RET-V(#LEN) = 'D' OR = 'W' OR = 'M')
      REINPUT *0634 MARK *NRM-MONITOR.M-PO-RETENTION ALARM
    END-IF
    RESET #RET-V(#LEN)
    IF NOT #RETENTION IS (N4)
      REINPUT *0634 MARK *NRM-MONITOR.M-PO-RETENTION ALARM
    END-IF
  WHEN NRM-MONITOR.M-PO-RETENTION = MASK('0') OR = MASK('00')
      OR = ' '
    REINPUT *0634 MARK *NRM-MONITOR.M-PO-RETENTION ALARM
  WHEN NOT (NRM-MONITOR.M-HOLD-RETENTION IS (N4) OR
      NRM-MONITOR.M-HOLD-RETENTION = ' ')
    #RETENTION := NRM-MONITOR.M-HOLD-RETENTION
    EXAMINE #RETENTION FOR 'X' GIVING LENGTH IN #LEN
    IF #LEN < 2 OR NOT(#RET-V(#LEN) = 'D' OR = 'W' OR = 'M')
      REINPUT *0634 MARK *NRM-MONITOR.M-HOLD-RETENTION ALARM
    END-IF
    RESET #RET-V(#LEN)
    IF NOT #RETENTION IS (N4)
      REINPUT *0634 MARK *NRM-MONITOR.M-HOLD-RETENTION ALARM
    END-IF
  WHEN NRM-MONITOR.M-HOLD-RETENTION = MASK('0') OR = MASK('00')
      OR = ' '
    REINPUT *0415 MARK *NRM-MONITOR.M-HOLD-RETENTION ALARM
  WHEN NOT (NRM-MONITOR.M-LOG-RETENTION IS (N4) OR
      NRM-MONITOR.M-LOG-RETENTION = ' ')
    #RETENTION := NRM-MONITOR.M-LOG-RETENTION
    EXAMINE #RETENTION FOR 'X' GIVING LENGTH IN #LEN
    IF #LEN < 2 OR NOT (#RET-V(#LEN) = 'D' OR = 'W' OR = 'M')
      REINPUT *0634 MARK *NRM-MONITOR.M-LOG-RETENTION ALARM
    END-IF
    RESET #RET-V(#LEN)
    IF NOT #RETENTION IS (N4)
      REINPUT *0634 MARK *NRM-MONITOR.M-LOG-RETENTION ALARM
    END-IF
  WHEN NRM-MONITOR.M-LOG-RETENTION = ' '
    NRM-MONITOR.M-LOG-RETENTION := '10D'
  WHEN NRM-MONITOR.M-LOG-RETENTION = MASK('0') OR=MASK('00')
    REINPUT *0415 MARK *NRM-MONITOR.M-LOG-RETENTION ALARM
  WHEN NONE
    IGNORE
END-DECIDE
*
FOR I 1 TO 10
  IF NOT (NRM-MONITOR.M-LOG-TYPES (I) = 'R' OR='B'
      OR='P' OR='D' OR='L' OR=' ' OR='W')
    REINPUT USING HELP MARK *NRM-MONITOR.M-LOG-TYPES(I) ALARM
  END-IF
END-FOR
*
FOR I 1 TO 3
  IF NOT (NRM-MONITOR.M-PO-TYPES(I) = ' ' OR='D' OR='E' OR='F')
    REINPUT USING HELP MARK *NRM-MONITOR.M-PO-TYPES(I) ALARM
  END-IF
END-FOR
*
END-SUBROUTINE /* VALIDATE-INPUT
*
************************************************************************
DEFINE SUBROUTINE INIT-PFKEYS
************************************************************************
RESET G-PF
INCLUDE RPFSTD-C
INCLUDE RPFCOM-C
IF #PANEL = 1
  INCLUDE RPFAPL-C
ELSE
  INCLUDE RPFESF-C
END-IF
IF G-C-FUNC = 'M' /* modify allowed in user profile
  G-PF-IDENT (10) := ##PFN-MODIFY
  G-PF-CODE  (10) := ##PFK-MODIFY
  G-PF-IDENT (22) := ##PFN-MODIFY
  G-PF-CODE  (22) := ##PFK-MODIFY
END-IF
CALLNAT 'RPFINI-N' G-PF G-PFB
*
END-SUBROUTINE /* INIT-PFKEYS
*
************************************************************************
DEFINE SUBROUTINE GET-NEXT-PLAN-TIME
************************************************************************
#CURRENT-TIME := *TIMX
MOVE EDITED DAILY-CLEANUP-TASK.M-ARCHIVE-TIME (EM=HHII) TO #START-TIME
IF #START-TIME = '0000'
  #START-TIME := '0001'
END-IF
*
DAILY-CLEANUP-TASK.M-ARCHIVE-TIME-INT := 0001
DAILY-CLEANUP-TASK.M-ARCHIVE-TIME-END := #START-TIME
*
CALLNAT 'RSCHED-N' #CURRENT-TIME #START-TIME
  DAILY-CLEANUP-TASK.M-ARCHIVE-TIME-INT
  DAILY-CLEANUP-TASK.M-ARCHIVE-TIME-END
  DAILY-CLEANUP-TASK.M-ARCHIVE-WEEK-DAYS (1:7)
  DAILY-CLEANUP-TASK.M-ARCHIVE-DAYS (1:30)
  DAILY-CLEANUP-TASK.M-ARCHIVE-CALENDAR
  DAILY-CLEANUP-TASK.M-ARCHIVE-BEFORE-AFTER
  DAILY-CLEANUP-TASK.M-PLAN-ARC-TIME
*
IF DAILY-CLEANUP-TASK.M-ARCHIVE-TIME = 0
  DAILY-CLEANUP-TASK.M-ARCHIVE-TIME := T'00:01:00'
END-IF
*
END-SUBROUTINE /* GET-NEXT-PLAN-TIME
* ---------------------------------------- set pfkeys ------------------
*
INCLUDE RPFSET-C
*
END
