* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    RMSRID-N
* Function  Issue unique Source ID
* Version   1.3
*
* Maintenance
* uuu     yyyy-mm-dd s(999999) ...
* mrs     1993-01-26           created
* fhi     2000-08-24 QA03     Use NAT23006 for error values
* fhi     2007-07-12 NOM3202   C-NATERR changed, NAD23006 is obsolete.
* fhi     2010-09-03 NOMALL-97 Extend message line
* fhi     2010-09-21 NOMALL-97 Use no more C-NATERR but C-NATERN instead
* SU1     2014-11-17 NOMALL-1450 fill fields for Adabas Vista
* SU2     2016-01-20 NOMALL-1802 do not update Adabas Vista fields
* ---------------------------------------------------------------------
DEFINE DATA PARAMETER
1 P-ID   (P10) /* out
1 P-ERC  (N4) /* out
1 P-ERT  (A250)
* ---------------------------------------------------------------------
LOCAL
1 SOURCE VIEW OF NRM-SOURCE
  2 SR-ID
  2 SR-NUMBER-OF-LINES
  2 SR-OBJECT-TYPE /*SU1
  2 SR-OBJECT-TIME /*SU1
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET P-ERC P-ERT
FNDSRC. FIND SOURCE WITH SR-ID = 9999999999
  IF NO RECORDS FOUND
    SR-ID := 9999999999
  END-NOREC
  ADD 1 TO SR-NUMBER-OF-LINES
  P-ID := SR-NUMBER-OF-LINES
  IF *NUMBER (FNDSRC.) = 0
    SR-OBJECT-TYPE := 'SR' /*SU1 SU2 moved to STORE
    SR-OBJECT-TIME := *TIMX /*SU1 SU2 moved to STORE
    STORE SOURCE
  ELSE
    UPDATE
  END-IF
*
END-FIND
END OF TRANSACTION
*
************************************************************************
ON ERROR
************************************************************************
  IF *ERROR-NR = 3145
    P-ERC := *ERROR-NR
  ELSE
    P-ERC := 0021
    CALLNAT 'C-NATERN' P-ERT
  END-IF
  ESCAPE ROUTINE
END-ERROR
*
END
