* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* NOMWK01N - Wake up monitor
*
* Maintenance:
* uuu yy-mm-dd s(999999) ....
* gw  94-07-04 s(999999) created
* mrs 94-10-27 s(999999) rc not filled
* jvd 98-09-14 p(164220) NOM141ÖNAT23
* gw  98-10-22 p(164220) wake up monitor doesn't work
* sju 00-04-25 p(191368) monitor multitasking
* sju 00-05-17 p(191368) NAT-USER first 5 chars unique, for BS2000
* uuu     yyyy-mm-dd s(999999) ....
* fhi     2000-08-24 QA03      Use NAT23006 for error values
* sju 00-09-21 p(191368) NATURAL-SUB-TASK doesn't work for BATCH monitor
* sju 00-11-20 s(999999) ESY5888 after printer subtask terminated
* sju 04-07-15 NOM31     Extra parm for RMEVNT-N
* fhi 05-06-23 p(266530) Monitor must be NPR Mainframe independent
* fhi 05-11-15 P272724   End Transaction for Unix Eventing necessary
* xsetggr 2007-05-18 p(289847) restore NOM lfile when error occurs
* fhi     2007-07-12 NOM3202   C-NATERR changed, NAD23006 is obsolete.
* xsetggr 2008-08-11 p(300323) add steplibs
* xsetggr 2008-12-05 p(300323) change adding of steplibs
* xsetggr 2009-01-21 P313531   change steplib handling
* xsetggr 2009-02-10 P300323   delete steplib handling, get NOM library
*                              by RGETLIB
* fhi     2009-02-27 P300323 Rename RGETSTEP to NOMGSTEP delivered in SYSTEM
* fhi     2010-09-03 NOMALL-97 Extend message line
* fhi     2010-09-21 NOMALL-97 Use no more C-NATERR but C-NATERN instead
* fhi     2011-03-28 NOMALL-922 Do not use MF NPR on Unix, old comm. del
* raya    2012-01-31 NOMALL-1096 error-text a250 in NOMWK--P stow only
* fhi     2016-09-15 NOMALL-1621 Use +NOD-LOCAL-NODE as monitor node
* fhi     2016-11-10 NOMALL-1917 use correct node number
* fhi     2016-11-15 NOMALL-1961 Use new task IDs
* fhi     2017-01-26 NOMALL-1961 Wake next free (idle) task, tags deletd
* SU1     2017-03-06 NOMALL-1961 Use new task IDs
* fhi     2017-03-07 NOMALL-1961 Correct event name handling
* fhi     2017-05-03 NOMALL-1961 same
* bli     2019-06-24 NOMALL-2284 Correct event name handling for unix
* SU2     2019-11-14 NOMALL-2349 show full message
* SU3     2020-11-10 NOMALL-2440 split DDM -> NRM-MF-NODES
* SU4     2021-04-16 NOMALL-2454 recat RMTASK-P to avoid NAT1305
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER USING NOMWK--P
************************************************************************
INDEPENDENT
1 +NOD-LOCAL-NODE             (N5)
1 +NOD-LOCAL-ID               (A20)
* *****
LOCAL USING SATFNC3E
LOCAL USING SATLF02P
/*SU3 LOCAL USING VMONITUL            /* NOMALL-1917
LOCAL USING VSUBT-L
LOCAL USING RMSETSTE
LOCAL USING RMTASK-P   /* NOMALL-1961 fhi in
LOCAL
1 EVENTING  VIEW  OF  EVENTING
  2 ERROR-CODE
  2 ERROR-TEXT
  2 EVENT-NAME
1 #EVENT-NAME                 (A8)
1 MONITOR  VIEW  OF  NRM-MONITOR
/*SU3  2 M-MONITOR-ID
/*SU3  2 M-MONITOR-NODE
  2 M-MONITOR-TASKS
  2 REDEFINE M-MONITOR-TASKS
    3 M-TASK-NUMBER           (N3/1:12)
1 MF-NODE VIEW OF NRM-MF-NODES /*SU3
  2 MF-MONITOR-NODE           (N5)
*
1 XEVENT                      (A512)
1 REDEFINE XEVENT
  2 XEVENTING
    3 ERROR-CODE              (N3)
    3 ERROR-TEXT              (A58)
    3 NODE                    (N5)
    3 SYSTEM-MESSAGE-CODE     (A10)
    3 FUNCTION                (A8)
    3 EVENT-NAME              (A8)
    3 MAX-TIME                (B4)
    3 REDEFINE MAX-TIME
      4 MAX-TIME-A            (A4)
    3 NUMBER-OF-WAITERS       (N5)
    3 NUMBER-OF-MESSAGES      (N5)
    3 MESSAGE-ARRAY           (A250)
1 #TASK-COUNT                 (I2)
1 #TASK-NO                    (I2)
1 #MAX-TASKS                  (I2) CONST <59> /* NOMALL-1961 was <5>
1 #NOM-DBID                   (N5)
1 #NOM-FNR                    (N5)
1 #WAIT-CURRENT               (N4)
1 #ERC                        (N4)
1 #ERT                        (A250)
1 I                           (N3)
1 J                           (N3)
1 #EVENT-MESSAGE              (A250)
1 #LFILE-CHANGED              (L)
1 #TRACING                    (L)
1 #TRACE-MSG                  (A250)
1 #EVENT-NAME-HEX             (A16)
1 #LINE                       (I4)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET NOMWK-ERROR-CODE NOMWK-ERROR-TEXT
*
#NOM-DBID := NOMWK-NOM-DBID
#NOM-FNR  := NOMWK-NOM-FNR
*
IF +NOD-LOCAL-ID = ' ' /* started outside monitor
  CALLNAT 'RMSWNODE' 'L' 1 0 0 #TRACING
END-IF
RESET #TRACING /* because otherwise traces are sent to online screen
DECIDE FOR EVERY CONDITION
  WHEN NOMWK-ERROR-CODE = 0
    PERFORM GET-NOM-LFILE
    PERFORM VALIDATION
  WHEN NOMWK-ERROR-CODE=0 AND NOMWK-NOM-FNR NE 0 AND NOMWK-NOM-DBID NE 0
    PERFORM SET-NOM-LFILE
  WHEN NOMWK-ERROR-CODE = 0
    PERFORM READ-MONITOR-DEFAULTS
  WHEN NOMWK-ERROR-CODE = 0
    PERFORM WAKE-UP-MONITOR
  WHEN #LFILE-CHANGED
    PERFORM SET-OLD-NOM-LFILE
  WHEN NOMWK-ERROR-CODE NE 0
    PERFORM GET-ERROR-TEXT
  WHEN NONE IGNORE
END-DECIDE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE GET-NOM-LFILE
************************************************************************
SATLF-LFILE    := 206
SATLF-FUNCTION := 'GET'
CALLNAT SAT-GET-SET-LFILE SATLF-SATVERS SATLF-PARMS (*)
#NOM-DBID := SATLF-DBID-N5
#NOM-FNR  := SATLF-FNR-N5
*
END-SUBROUTINE /* GET-NOM-LFILE
*
************************************************************************
DEFINE SUBROUTINE SET-LFILE
************************************************************************
SATLF-LFILE    := 206
SATLF-FUNCTION := 'SET'
CALLNAT SAT-GET-SET-LFILE SATLF-SATVERS SATLF-PARMS (*)
*
END-SUBROUTINE /* SET-LFILE
*
************************************************************************
DEFINE SUBROUTINE SET-NOM-LFILE
************************************************************************
SATLF-DBID-N5 := NOMWK-NOM-DBID
SATLF-FNR-N5  := NOMWK-NOM-FNR
PERFORM SET-LFILE
#LFILE-CHANGED := TRUE
*
END-SUBROUTINE /* SET-NOM-LFILE
*
************************************************************************
DEFINE SUBROUTINE SET-OLD-NOM-LFILE
************************************************************************
SATLF-DBID-N5 := #NOM-DBID
SATLF-FNR-N5  := #NOM-FNR
PERFORM SET-LFILE
*
END-SUBROUTINE /* SET-OLD-NOM-LFILE
*
************************************************************************
DEFINE SUBROUTINE GET-ERROR-TEXT
************************************************************************
IF NOMWK-ERROR-TEXT = ' '
  NOMWK-ERROR-TEXT := F#GETMSG (<NOMWK-ERROR-CODE, ' '>) /*SU 2018-04
END-IF
*
END-SUBROUTINE /* GET-ERROR-TEXT
*
************************************************************************
DEFINE SUBROUTINE WAKE-UP-MONITOR
************************************************************************
DECIDE ON FIRST VALUE OF NOMWK-TASK-TYPE
  VALUE '*'                            /* wake all tasks
    IF MF-MONITOR-NODE NE 0
      FIND EVENTING WITH NODE = +NOD-LOCAL-NODE AND FUNCTION = 'LIST'
          AND EVENT-NAME = 'NOM*'
        IF EVENTING.ERROR-CODE NE 0
          ESCAPE BOTTOM
        END-IF
        #EVENT-NAME:= EVENTING.EVENT-NAME
        RMTASK-P.TASK-ID  := EVENTING.EVENT-NAME
        RMTASK-P.FUNCTION := 'G'
        #LINE             := *LINE
        CALLNAT 'RMTASKID' RMTASK-P #TRACING #LINE
        IF RMTASK-P.NOM-DBID = #NOM-DBID AND RMTASK-P.NOM-FNR = #NOM-FNR
          IF #TRACING
            MOVE EDITED #EVENT-NAME (EM=HHHHHHHH) TO #EVENT-NAME-HEX
            COMPRESS 'Post monitor event in line ' *LINE
              'Node:' MF-MONITOR-NODE 'Event:' #EVENT-NAME
              'Hex:' #EVENT-NAME-HEX TO #TRACE-MSG
            PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
          END-IF
          PERFORM POST-MONITOR-EVENT
        END-IF
      END-FIND
    ELSE
      RMTASK-P.FUNCTION       := 'E'
      RMTASK-P.SUBTASK-NUMBER := 1
      #LINE                   := *LINE
      CALLNAT 'RMTASKID' RMTASK-P #TRACING #LINE
      #EVENT-NAME       := RMTASK-P.TASK-ID /* BLI NOMALL-2284
      XEVENT.EVENT-NAME := RMTASK-P.TASK-ID
      XEVENT.FUNCTION   := 'RECEIVE'
      CALLNAT 'RMEVNTXN' XEVENT
      END TRANSACTION
      IF XEVENT.ERROR-CODE = 0
        #TASK-COUNT := 1
        IF #TRACING
          MOVE EDITED #EVENT-NAME (EM=HHHHHHHH) TO #EVENT-NAME-HEX
          COMPRESS 'Post monitor event in line ' *LINE
            'Node:' MF-MONITOR-NODE 'Event:' #EVENT-NAME
            'Hex:' #EVENT-NAME-HEX TO #TRACE-MSG
          PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
        END-IF
        PERFORM POST-MONITOR-EVENT
        END TRANSACTION                     /* BLI NOMALL-2284
      END-IF
      FOR #TASK-NO = 21 TO #MAX-TASKS  /* NOMALL-1961 was '2'
        RMTASK-P.SUBTASK-NUMBER :=  #TASK-NO
        RMTASK-P.FUNCTION       := 'E'
        #LINE                   := *LINE
        CALLNAT 'RMTASKID' RMTASK-P #TRACING #LINE
        #EVENT-NAME             := RMTASK-P.TASK-ID /* BLI NOMALL-2284
        XEVENT.EVENT-NAME       := RMTASK-P.TASK-ID
        XEVENT.FUNCTION         := 'RECEIVE'
        CALLNAT 'RMEVNTXN' XEVENT
        END TRANSACTION
        IF XEVENT.ERROR-CODE = 0
          ADD 1 TO #TASK-COUNT
          IF #TRACING
            MOVE EDITED #EVENT-NAME (EM=HHHHHHHH) TO #EVENT-NAME-HEX
            COMPRESS 'Post monitor event in line ' *LINE
              'Node:' MF-MONITOR-NODE 'Event:' #EVENT-NAME
              'Hex:' #EVENT-NAME-HEX TO #TRACE-MSG
            PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
          END-IF
          PERFORM POST-MONITOR-EVENT
          END TRANSACTION                     /* BLI NOMALL-2284
        END-IF
      END-FOR
    END-IF
  VALUES '1','2','11','12'              /* an individual function
    I := VAL(NOMWK-TASK-TYPE)
    DECIDE FOR EVERY CONDITION
      WHEN I = 2
        FORJ. FOR J = 2 TO 10
          RMTASK-P.FUNCTION       := 'S'
          RMTASK-P.SUBTASK-NUMBER := M-TASK-NUMBER(J)
          #LINE                   := *LINE
          CALLNAT 'RMTASKID' RMTASK-P #TRACING #LINE
          FIND NRM-SUBTASK-INFO WITH ST-SUBTASK-ID = RMTASK-P.TASK-ID
            IF ST-STATUS = #EQU-IDLE
              ESCAPE BOTTOM (FORJ.)
            END-IF
          END-FIND
        END-FOR
        IF J < 11
          I := J
        ELSE
          I := 2 /* try the first copy task and forget it
        END-IF
      WHEN MF-MONITOR-NODE NE 0
        RMTASK-P.FUNCTION       := 'E'
        RMTASK-P.SUBTASK-NUMBER := M-TASK-NUMBER(I)
        #LINE                   := *LINE
        CALLNAT 'RMTASKID' RMTASK-P #TRACING #LINE
        #EVENT-NAME := RMTASK-P.TASK-ID
        FIND EVENTING WITH NODE = +NOD-LOCAL-NODE AND FUNCTION = 'LIST'
            AND EVENT-NAME = #EVENT-NAME
          IF NO RECORDS FOUND
            RMTASK-P.FUNCTION       := 'E'
            RMTASK-P.SUBTASK-NUMBER := 1
            #LINE                   := *LINE
            CALLNAT 'RMTASKID' RMTASK-P #TRACING #LINE
          END-NOREC
          IF EVENTING.ERROR-CODE NE 0
            RMTASK-P.FUNCTION       := 'E'
            RMTASK-P.SUBTASK-NUMBER := 1
            #LINE                   := *LINE
            CALLNAT 'RMTASKID' RMTASK-P #TRACING #LINE
          END-IF
        END-FIND
      WHEN MF-MONITOR-NODE = 0
        RMTASK-P.FUNCTION       := 'E' /* TASK ID for EVENTING
        RMTASK-P.SUBTASK-NUMBER := M-TASK-NUMBER(I)
        #LINE                   := *LINE
        CALLNAT 'RMTASKID' RMTASK-P #TRACING #LINE
        #EVENT-NAME       := RMTASK-P.TASK-ID /* BLI NOMALL-2284
        XEVENT.EVENT-NAME := RMTASK-P.TASK-ID
        XEVENT.FUNCTION   := 'LIST'
        CALLNAT 'RMEVNTXN' XEVENT
        END TRANSACTION
      WHEN NONE
        IGNORE
    END-DECIDE
    IF #TRACING
      MOVE EDITED #EVENT-NAME (EM=HHHHHHHH) TO #EVENT-NAME-HEX
      COMPRESS 'Post monitor event in line ' *LINE
        'Node:' MF-MONITOR-NODE 'Event:' #EVENT-NAME
        'Hex:' #EVENT-NAME-HEX TO #TRACE-MSG
      PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    END-IF
    PERFORM POST-MONITOR-EVENT
    END TRANSACTION                    /* BLI NOMALL-2284
  NONE VALUE                           /* first or only task
    RMTASK-P.FUNCTION       := 'E' /* TASK ID for EVENTING
    RMTASK-P.SUBTASK-NUMBER := 1
    #LINE                   := *LINE
    CALLNAT 'RMTASKID' RMTASK-P #TRACING #LINE
    #EVENT-NAME := RMTASK-P.TASK-ID
    IF #TRACING
      MOVE EDITED #EVENT-NAME (EM=HHHHHHHH) TO #EVENT-NAME-HEX
      COMPRESS 'Post monitor event in line ' *LINE
        'Node:' MF-MONITOR-NODE 'Event:' #EVENT-NAME
        'Hex:' #EVENT-NAME-HEX TO #TRACE-MSG
      PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    END-IF
    PERFORM POST-MONITOR-EVENT
    END TRANSACTION                     /* BLI NOMALL-2284
END-DECIDE
*
END-SUBROUTINE /* WAKE-UP-MONITOR
*
************************************************************************
DEFINE SUBROUTINE POST-MONITOR-EVENT
************************************************************************
CALLNAT 'RMEVNT-N' MF-MONITOR-NODE #EVENT-NAME 'POST    '
  #WAIT-CURRENT #ERC #ERT #EVENT-MESSAGE
END TRANSACTION
*
END-SUBROUTINE /* POST-MONITOR-EVENT
*
************************************************************************
DEFINE SUBROUTINE VALIDATION
************************************************************************
DECIDE FOR FIRST CONDITION
  WHEN #NOM-DBID = 0
    NOMWK-ERROR-CODE := 9102
  WHEN #NOM-FNR = 0
    NOMWK-ERROR-CODE := 9103
  WHEN NONE IGNORE
END-DECIDE
*
END-SUBROUTINE /* VALIDATION
*
************************************************************************
DEFINE SUBROUTINE READ-MONITOR-DEFAULTS
************************************************************************
RMTASK-P.FUNCTION       := 'S'
RMTASK-P.SUBTASK-NUMBER := 1
#LINE                   := *LINE
CALLNAT 'RMTASKID' RMTASK-P #TRACING #LINE
FIND (1) MONITOR WITH M-MONITOR-ID = RMTASK-P.TASK-ID
  IF NO RECORDS FOUND
    NOMWK-ERROR-CODE := 9105
  END-NOREC
END-FIND
FIND MF-NODE WITH MF-MONITOR-ID = +NOD-LOCAL-ID /*SU3
/*SU3 MOVE BY NAME NODE-SPOOL-DATA TO MONITOR
END-FIND
*
END-SUBROUTINE /* READ-MONITOR-DEFAULTS
*
************************************************************************
ON ERROR
************************************************************************
  IF #LFILE-CHANGED
    PERFORM SET-OLD-NOM-LFILE
  END-IF
  IF *ERROR-NR = 82
    WRITE *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II':'SS'.'T)
      'Missing NOM steplibs' //
      'Please call NOM steplib routine NOMGSTEP before call of NOM API.'
  END-IF
  NOMWK-ERROR-CODE := 9101
  CALLNAT 'C-NATERN' NOMWK-ERROR-TEXT 'W' /*write to log too SU2
  PRINT NOMWK-ERROR-TEXT /*SU2 (AL=78)
  ESCAPE ROUTINE
*
END-ERROR
*
END
