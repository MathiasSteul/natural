* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* XXUXST-N - Stack Parameters for XXUX---N into independent vars
*
*   Function 'PUSH' pushes data into stack
*            'POP'  retrieves the data.
*
* MODIFICATIONS
* User Id yyyy-mm-dd Mark      Comment
* fhi     2000-10-07 s(196560) Created
* fhi     2002-10-30 fhi101    switch on optimizer compiler
* fhi     2007-03-07 P264366   rewritten
* fhi     2008-02-26 P300605   Binary files not read
* fhi     2008-03-06 P302823   Error in EOF handling
* fhi     2010-09-24 NOMALL-800 Improve memory handling, rewritten
* fhi     2010-11-01 NOMALL-97  Added new fields of XXUX---P
* fhi     2012-04-03 NOMALL-1119 Add field MIME-TYPE
* fhi     2013-12-04 NOMALL-1004 Change to asynchronous COMMAND call
* fhi     2014-02-20 NOMALL-1338 Ad cmd part 2 in XXUX---P
* fhi     2014-08-21 NOMALL-1454 Add P-CODEPAGE
* fhi     2015-03-17 NOMALL-1580 Backported this version to NOM 3.3
*                                Consider to backport future changes
*                                also into NOM331(XXUX*34*)
* fhi     2016-08-12 NOMALL-1903 Adapted to new buffer length 99000
*                                No tags (partly rewritten)
* bli     2019-04-29 NOMALL-2261 NPR command-3
* 2022-02-18 SU1   NOMALL-2534 NATOS-8741 XXUXST-N 1630:
*   NAT1222 memory required: PRINTs added / 2022-05-16 only 1 print
* ---------------------------------------------------------------------
DEFINE DATA
PARAMETER
1 #FUNCTION     (A10) /* PUSH or POP
1 #RC           (N1)  /* 0 = sucess, 1 = not possible
PARAMETER USING XXUX---P
************************************************************************
INDEPENDENT
1 +XXUXD--P     (N10) /* stack depth, NOMALL-800 was N2
1 +XXUX---P     (A/*,*) DYNAMIC
* *****
LOCAL
1 #I            (I4)
1 #COL          (I1)
1 #COL-MAX      (I1) CONST <33>
1 #NUM          (I4)
1 #LOG          (L)
1 #ALPHA        (A)   DYNAMIC
1 #FORMAT       (A1)
1 #LEN          (P20) /*SU1 ->
1 #J1           (I4)
1 #J2           (I4)
1 #A            (A3) INIT <'-1:'> /*SU1 <-
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
/*SU1 PERFORM PRINT-OCC /*at start
#RC := 0
DECIDE ON FIRST VALUE OF #FUNCTION
  VALUE 'PUSH'
    IF +XXUXD--P GE *OCC (+XXUX---P)
      #I := *OCC (+XXUX---P) + 5
      EXPAND ARRAY +XXUX---P TO (1:#I,1:#COL-MAX)
    END-IF
    ADD 1 TO +XXUXD--P
    RESET #COL
    INCLUDE XXUXST1C 'P-FUNCTION'
    INCLUDE XXUXST1C 'P-NODE-NAME'
    INCLUDE XXUXST1C 'P-USERID'
    INCLUDE XXUXST1C 'P-PASSWORD'
    INCLUDE XXUXST1C 'P-CIPHER-PASSWORD'
    INCLUDE XXUXST1C 'P-GROUP'
    INCLUDE XXUXST1C 'P-OPSYS'
    INCLUDE XXUXST1C 'P-NPR-VERSION'
    INCLUDE XXUXST1C 'P-FILE-NAME'
    INCLUDE XXUXST1C 'P-FILE-HANDLE'
    INCLUDE XXUXST1C 'P-STATUS'
    INCLUDE XXUXST1C 'P-RECORD'
    INCLUDE XXUXST1C 'P-CC'
    INCLUDE XXUXST1C 'P-ERC'
    INCLUDE XXUXST1C 'P-ERT'
    INCLUDE XXUXST1C 'P-ETB-ERC'
    INCLUDE XXUXST1C 'P-PROCESS-ID'
    INCLUDE XXUXST1C 'P-BINARY'
    INCLUDE XXUXST1C 'P-EXIT-CODE'
    INCLUDE XXUXST1C 'P-LOG-FUNCTION'
    INCLUDE XXUXST1C '#MR-P-POSITION'
    INCLUDE XXUXST1C '#MR-P-BUFFER'
    INCLUDE XXUXST1C '#MR-P-FILE-NAME'
    INCLUDE XXUXST1C '#XS-FIRW-CONTROL-CHAR'
    INCLUDE XXUXST1C '#XS-FIRW-LINE-NUMBER'
    INCLUDE XXUXST1C '#EOF'
    INCLUDE XXUXST1C 'P-NODE-SUSPEND'
    INCLUDE XXUXST1C 'P-MIME-TYPE'
    INCLUDE XXUXST1C 'P-OUTPUT-MODE'
    INCLUDE XXUXST1C 'P-WAIT-TERM'
    INCLUDE XXUXST1C 'P-COMMAND-PART-2-3'   /* NOMALL-2261
    INCLUDE XXUXST1C 'P-CODEPAGE'
  VALUE 'POP'
    IF +XXUXD--P > 0
      RESET #COL
      INCLUDE XXUXST2C 'P-FUNCTION'              '''A'''
      P-FUNCTION        := #ALPHA
      INCLUDE XXUXST2C 'P-NODE-NAME'             '''A'''
      P-NODE-NAME       := #ALPHA
      INCLUDE XXUXST2C 'P-USERID'                '''A'''
      P-USERID          := #ALPHA
      INCLUDE XXUXST2C 'P-PASSWORD'              '''A'''
      P-PASSWORD        := #ALPHA
      INCLUDE XXUXST2C 'P-CIPHER-PASSWORD'       '''A'''
      P-CIPHER-PASSWORD := #ALPHA
      INCLUDE XXUXST2C 'P-GROUP'                 '''A'''
      P-GROUP           := #ALPHA
      INCLUDE XXUXST2C 'P-OPSYS'                 '''A'''
      P-OPSYS           := #ALPHA
      INCLUDE XXUXST2C 'P-NPR-VERSION'           '''A'''
      P-NPR-VERSION     := #ALPHA
      INCLUDE XXUXST2C 'P-FILE-NAME'             '''A'''
      P-FILE-NAME       := #ALPHA
      INCLUDE XXUXST2C 'P-FILE-HANDLE'           '''N'''
      P-FILE-HANDLE     := #NUM
      INCLUDE XXUXST2C 'P-STATUS'                '''N'''
      P-STATUS          := #NUM
      INCLUDE XXUXST2C 'P-RECORD'                '''A'''
      P-RECORD          := #ALPHA
      INCLUDE XXUXST2C 'P-CC'                    '''A'''
      P-CC              := #ALPHA
      INCLUDE XXUXST2C 'P-ERC'                   '''N'''
      P-ERC             := #NUM
      INCLUDE XXUXST2C 'P-ERT'                   '''A'''
      P-ERT             := #ALPHA
      INCLUDE XXUXST2C 'P-ETB-ERC'               '''A'''
      P-ETB-ERC         := #ALPHA
      INCLUDE XXUXST2C 'P-PROCESS-ID'            '''N'''
      P-PROCESS-ID      := #NUM
      INCLUDE XXUXST2C 'P-BINARY'                '''A'''
      P-BINARY          := #ALPHA
      INCLUDE XXUXST2C 'P-EXIT-CODE'             '''N'''
      P-EXIT-CODE       := #NUM
      INCLUDE XXUXST2C 'P-LOG-FUNCTION'          '''A'''
      P-LOG-FUNCTION    := #ALPHA
      INCLUDE XXUXST2C '#MR-P-POSITION'          '''N'''
      #MR-P-POSITION    := #NUM
      INCLUDE XXUXST2C '#MR-P-BUFFER'            '''A'''
      #MR-P-BUFFER      := #ALPHA
      INCLUDE XXUXST2C '#MR-P-FILE-NAME'         '''A'''
      #MR-P-FILE-NAME   := #ALPHA
      INCLUDE XXUXST2C '#XS-FIRW-CONTROL-CHAR'   '''A'''
      #XS-FIRW-CONTROL-CHAR := #ALPHA
      INCLUDE XXUXST2C '#XS-FIRW-LINE-NUMBER'    '''N'''
      #XS-FIRW-LINE-NUMBER := #NUM
      INCLUDE XXUXST2C '#EOF'                    '''L'''
      #EOF              := #LOG
      INCLUDE XXUXST2C 'P-NODE-SUSPEND'          '''A'''
      P-NODE-SUSPEND    := #ALPHA
      INCLUDE XXUXST2C 'P-MIME-TYPE'             '''A'''
      P-MIME-TYPE       := #ALPHA
      INCLUDE XXUXST2C 'P-OUTPUT-MODE'           '''A'''
      P-OUTPUT-MODE     := #ALPHA
      INCLUDE XXUXST2C 'P-WAIT-TERM'             '''A'''
      P-WAIT-TERM       := #ALPHA
* NOMALL-2261 next two lines changed
      INCLUDE XXUXST2C 'P-COMMAND-PART-2-3'      '''A'''
      P-COMMAND-PART-2-3:= #ALPHA
      INCLUDE XXUXST2C 'P-CODEPAGE'              '''A'''
      P-CODEPAGE        := #ALPHA
      REDUCE DYNAMIC +XXUX---P (+XXUXD--P,*) TO 0
      SUBTRACT 1 FROM +XXUXD--P
      #I := *OCC (+XXUX---P) - 5
      IF +XXUXD--P LE #I AND #I > 0
        REDUCE ARRAY +XXUX---P TO (1:#I,*)
      END-IF
    ELSE
      #RC := 1 /* More POPs than PUSHs
    END-IF
  NONE
    #RC := 2 /* Wrong function
END-DECIDE
#A := '-2:'
/* PERFORM PRINT-OCC /*at end
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE PRINT-OCC /*SU1
************************************************************************
IF *DEVICE NE 'BATCH'
  ESCAPE ROUTINE
END-IF
FORMAT AD=L
RESET #LEN
FOR #J1=1 TO *OCC (+XXUX---P,1)
  FOR #J2=1 TO *OCC (+XXUX---P,2)
*   PRINT 'len:(' #J1 ',' #J2 ')' *LENGTH (+XXUX---P(#J1,#J2))
    ADD *LENGTH (+XXUX---P(#J1,#J2)) TO #LEN
  END-FOR
END-FOR
PRINT *DAT4I *TIME(AL=8) *PROGRAM #A 'fct:' #FUNCTION
  'depth:' +XXUXD--P 'occ1:' *OCC (+XXUX---P,1)
  'occ2:' *OCC (+XXUX---P,2) 'len:' #LEN 'rc:' #RC 'l:' *LEVEL
*
END-SUBROUTINE /* PRINT-OCC
*
************************************************************************
ON ERROR /*SU1
************************************************************************
  PRINT *DAT4I *TIME(AL=8) *PROGRAM '>> error:' *ERROR *ERROR-LINE
  #A := 'er:'
  PERFORM PRINT-OCC
*
END-ERROR
*
END
