* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    ABSCURS
* Version   1.3
* Function  Translate CURSOR-AREA, ROW, COLUMN to an absolute cursor
*           position
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* mrs 93-11-05 s(999999) prefix on/off implemented
* fhi 02-10-30 fhi101    switch on optimizer compiler
* SU1     2016-07-25 NOMALL-1518 NOM3.5 deactivate opt.Compiler
* SU2     2023-10-30 NOMALL-2489 avoid NAT1305
*
************************************************************************
DEFINE SUBROUTINE ABSOLUTE-CURSOR
************************************************************************
IF ED-CAREA > 9 /* CURSOR-AREA is (N1)
  CURSOR-AREA   := 1
ELSE
  CURSOR-AREA   := ED-CAREA
END-IF
IF ED-CROW > 99 /* CURSOR-ROW is (N2)
  CURSOR-ROW := 1
ELSE
  CURSOR-ROW    := ED-CROW
END-IF
IF ED-CCLM > 999 /* CURSOR-COLUMN is (N3)
  CURSOR-COLUMN := 1
ELSE
  CURSOR-COLUMN := ED-CCLM
END-IF
DECIDE ON EVERY VALUE OF CURSOR-AREA
  VALUE 1
    *CURS-LINE := 1
    *CURS-COL  := CURSOR-COLUMN
  VALUE 2
    *CURS-LINE := 2
    *CURS-COL  := CURSOR-COLUMN + 7
  VALUE 3
    *CURS-LINE := 2
    *CURS-COL  := CURSOR-COLUMN + 73
  VALUE 4
    *CURS-LINE := CURSOR-ROW + 2
    *CURS-COL  := CURSOR-COLUMN + 2
  VALUE 5
    *CURS-LINE := CURSOR-ROW + 2
    IF G-EDT-PREFIX-IS-ON
      *CURS-COL := CURSOR-COLUMN + 7
    ELSE
      *CURS-COL := CURSOR-COLUMN
    END-IF
  NONE IGNORE
END-DECIDE
*
END-SUBROUTINE /* ABSOLUTE-CURSOR
** End of ABSCURS ******************************************************
