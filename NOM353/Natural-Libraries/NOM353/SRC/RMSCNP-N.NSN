* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    RMSCNP-N
* Function  Assign ST-ID and reset ST-TYPE and ST-IDENT
* Version   1.3
*
* Maintenance
* uuu     yyyy-mm-dd s(999999)  ...
* mrs     1993-10-13 s(999999) created
* gw      1995-01-11 s(999999) replace read by find to avoid NAT3145
* fhi     2000-08-24 QA03     Use NAT23006 for error values
* fhi     2007-07-12 NOM3202   C-NATERR changed, NAD23006 is obsolete.
* fhi     2010-09-02 NOMALL-97 Extend message line
* fhi     2010-09-21 NOMALL-97 Use no more C-NATERR but C-NATERN instead
* ---------------------------------------------------------------------
DEFINE DATA PARAMETER USING RMSCNP-P
PARAMETER
1 P-ERROR-CODE  (N4)
1 P-ERROR-TEXT  (A250)
************************************************************************
LOCAL
1 SOURCE-TEXT VIEW OF NRM-SOURCE-TEXT
  2 ST-TYPE
  2 ST-IDENT
  2 ST-ID
* -----------------------------local variables-------------------------
1 #ST-TYPE-IDENT(A65)
1 REDEFINE #ST-TYPE-IDENT
  2 #ST-TYPE    (I2)
  2 #ST-IDENT   (A63)
1 #COUNTER      (P10) CONST <50>
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#ST-TYPE  := RMSCNP-SOURCE-TYPE
#ST-IDENT := RMSCNP-SOURCE-IDENT
*
REAST. FIND SOURCE-TEXT WITH ST-TYPE-IDENT = #ST-TYPE-IDENT
  ST-ID := RMSCNP-ST-ID
  RESET ST-TYPE ST-IDENT
*
  UPDATE (REAST.)
*
  IF *COUNTER > #COUNTER
    END OF TRANSACTION
    RESET *COUNTER
  END-IF
END-FIND
*
END OF TRANSACTION
*
************************************************************************
ON ERROR
************************************************************************
  BACKOUT TRANSACTION
  CALLNAT 'C-NATERN' P-ERROR-TEXT
  P-ERROR-CODE := 21
  ESCAPE ROUTINE
END-ERROR
*
END
