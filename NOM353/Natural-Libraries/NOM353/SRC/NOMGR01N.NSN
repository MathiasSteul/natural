* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    NOMGR01N
* Function  Grant Maintenance API
* Version   1.3.4
*
* Maintenance:
* uuu     yyyy-mm-dd s(999999) ....
* gw      1995-10-31 s(230704) created
* jvd     1998-09-14 p(164220) NAT23ÖNOM141
* fhi     2000-08-24 QA03      Use NAT23006 for error values
* xsiszha 2000-09-06 (CE7461) Extend Report and Bundle Names
* xsetggr 2005-06-30 p(265613) evaluate eom-library, eom-def-user
* xsetggr 2007-05-18 p(289847) restore NOM lfile when error occurs
* fhi     2007-07-12 NOM3202   C-NATERR changed, NAD23006 is obsolete.
* xsetggr 2008-08-11 p(300323) add steplibs and get error msg text
* xsetggr 2008-12-05 p(300323) change adding of steplibs
* xsetggr 2009-02-10 P300323   delete steplib handling, use RGETLIB to
*                              get NOM library
* fhi     2009-02-27 P300323 Rename RGETSTEP to NOMGSTEP delivered in SYSTEM
* fhi    2010-09-21 NOMALL-97 Use no more C-NATERR but C-NATERN instead
* SU1     2014-11-12 NOMALL-1527 getting rid of coding for old versions
* SU2     2018-04-05 NOMALL-1961 Use new task IDs
* ----------------------------------------------------------------------
DEFINE DATA
PARAMETER USING NOMGR--P
************************************************************************
LOCAL USING NOMGR--E
LOCAL USING EOM----P
LOCAL USING EOMGRM-P
LOCAL USING EOM----E
LOCAL USING EOMMSG-P
LOCAL USING SATFNC3E
LOCAL USING SATLF02P
*
LOCAL
1 #LFILE-CHANGED      (L)
1 #NOM-DBID           (N5)
1 #NOM-FNR            (N5)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET NOMGR-ERROR-CODE NOMGR-ERROR-TEXT
*
DECIDE FOR EVERY CONDITION
  WHEN NOMGR-NOM-FNR NE 0 AND NOMGR-NOM-DBID NE 0
    PERFORM GET-NOM-LFILE
    PERFORM SET-NOM-LFILE
    #LFILE-CHANGED := TRUE
  WHEN SATLF-ERROR-CODE = 0
    PERFORM GRANT-MAINTENANCE
  WHEN #LFILE-CHANGED
    PERFORM SET-OLD-NOM-LFILE
  WHEN NONE
    IGNORE
END-DECIDE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE GET-NOM-LFILE
************************************************************************
SATLF-LFILE    := 206
SATLF-FUNCTION := 'GET'
CALLNAT SAT-GET-SET-LFILE SATLF-SATVERS SATLF-PARMS (*)
#NOM-DBID := SATLF-DBID-N5
#NOM-FNR  := SATLF-FNR-N5
*
END-SUBROUTINE /* GET-NOM-LFILE
*
************************************************************************
DEFINE SUBROUTINE SET-LFILE
************************************************************************
SATLF-LFILE    := 206
SATLF-FUNCTION := 'SET'
CALLNAT SAT-GET-SET-LFILE SATLF-SATVERS SATLF-PARMS (*)
*
END-SUBROUTINE /* SET-LFILE
*
************************************************************************
DEFINE SUBROUTINE SET-NOM-LFILE
************************************************************************
SATLF-DBID-N5 := NOMGR-NOM-DBID
SATLF-FNR-N5  := NOMGR-NOM-FNR
PERFORM SET-LFILE
*
END-SUBROUTINE /* SET-NOM-LFILE
*
************************************************************************
DEFINE SUBROUTINE SET-OLD-NOM-LFILE
************************************************************************
SATLF-DBID-N5 := #NOM-DBID
SATLF-FNR-N5  := #NOM-FNR
PERFORM SET-LFILE
*
END-SUBROUTINE /* SET-OLD-NOM-LFILE
*
************************************************************************
DEFINE SUBROUTINE CALL-INTERNAL-API
************************************************************************
RESET EOMMSG-PARMS
CALLNAT 'EOMGRM-N' EOM-FUNCTION EOMGRM-PARMS EOMMSG-PARMS
IF EOMMSG-NR NE 0
  NOMGR-ERROR-CODE := EOMMSG-NR
  IF EOMMSG-TEXT = ' '
    PERFORM GET-ERR-TXT
  ELSE
    NOMGR-ERROR-TEXT := EOMMSG-TEXT
  END-IF
  ESCAPE ROUTINE
END-IF
*
END-SUBROUTINE /* CALL-INTERNAL-API
*
************************************************************************
DEFINE SUBROUTINE GRANT-MAINTENANCE
************************************************************************
RESET EOM-LOGGING EOM-LOG-TYPES (*)
CALLNAT 'RGETLIB' EOM-LIBRARY
COMPRESS EOM-LIBRARY 'U' TO  EOM-USER-LIBRARY LEAVING NO
*
EOM-LANGUAGE          := *LANGUAGE
EOMGRM-I-TYPE         := NOMGR-TYPE
EOMGRM-I-TARGET-DBID  := NOMGR-NOM-DBID
EOMGRM-I-TARGET-FNR   := NOMGR-NOM-FNR
EOMGRM-I-USER         := NOMGR-USER-ID
EOMGRM-I-NAME         := NOMGR-NAME
EOMGRM-I-NEWNAME      := NOMGR-NEWNAME
EOM-USER-TYPE         := 'A'
EOMGRM-ATTRIBUTES (*) := NOMGR-ATTRIBUTES (*)
EOM-DEF-USER := F#MONITOR-USER-AUTODEF (<>) /*SU
EOMGRM-I-DEF-USER := EOM-DEF-USER
DECIDE ON FIRST NOMGR-FUNCTION
  VALUE NOMGR-FCT-ADD
    EOM-FUNCTION := EOM-ADD
    PERFORM CALL-INTERNAL-API
  VALUE NOMGR-FCT-READ-HOLD
    EOM-FUNCTION := EOM-READHOLD
    PERFORM CALL-INTERNAL-API
    NOMGR-ATTRIBUTES (*) := EOMGRM-ATTRIBUTES (*)
  VALUE NOMGR-FCT-READ
    EOM-FUNCTION := EOM-READ
    PERFORM CALL-INTERNAL-API
    NOMGR-ATTRIBUTES (*) := EOMGRM-ATTRIBUTES (*)
  VALUE NOMGR-FCT-MODIFY
    EOM-FUNCTION := EOM-MODIFY
    PERFORM CALL-INTERNAL-API
  VALUE NOMGR-FCT-DELETE
    EOM-FUNCTION := EOM-DELETE
    PERFORM CALL-INTERNAL-API
  VALUE NOMGR-FCT-DELETE-ALL
    EOM-FUNCTION := EOM-DELETE-ALL
    PERFORM CALL-INTERNAL-API
  VALUE NOMGR-FCT-COMMIT
    EOM-FUNCTION := EOM-COMMIT
    PERFORM CALL-INTERNAL-API
  VALUE NOMGR-FCT-BACKOUT
    EOM-FUNCTION := EOM-BACKOUT
    PERFORM CALL-INTERNAL-API
  NONE
    NOMGR-ERROR-CODE := 20
    PERFORM GET-ERR-TXT
END-DECIDE
*
END-SUBROUTINE /* GRANT-MAINTENANCE
*
************************************************************************
DEFINE SUBROUTINE GET-ERR-TXT
************************************************************************
NOMGR-ERROR-TEXT := F#GETMSG(<NOMGR-ERROR-CODE,EOMMSG-TOKEN(1:3)>) /*SU2
*
END-SUBROUTINE /* GET-ERR-TXT
*
************************************************************************
ON ERROR
************************************************************************
  IF #LFILE-CHANGED
    PERFORM SET-OLD-NOM-LFILE
  END-IF
  IF *ERROR-NR = 82
    WRITE *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II':'SS'.'T)
      'Missing NOM steplibs' //
      'Please call NOM steplib routine NOMGSTEP before call of NOM API.'
  END-IF
  NOMGR-ERROR-CODE := NOMGR-ERROR-TEXT := 21
  CALLNAT 'C-NATERN' NOMGR-ERROR-TEXT 'W'
  ESCAPE ROUTINE
END-ERROR
*
END
