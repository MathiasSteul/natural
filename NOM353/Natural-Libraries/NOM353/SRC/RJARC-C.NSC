DEFINE SUBROUTINE #INIT
************************************************************************
RESET G-NATRP-ERC G-NATRP-ERT
/*SU8 MAP-NAME := *PROGRAM
#DATA := *DATA
CALLNAT 'N-HEADER' #N-HEADER
LG-FUNCTION := 'W' /*RLOG: write log to output to SU 2018-08
COMPRESS
  H'00' '?' H'01' '?' H'02' '?' H'03' '?' H'04' '?' H'05' '?' H'06' '?'
  H'07' '?' H'08' '?' H'09' '?' H'0A' '?' H'0B' '?' H'0C' '?' H'0D' '?'
  H'0E' '?' H'0F' '?' H'10' '?' H'11' '?' H'12' '?' H'13' '?' H'14' '?'
  H'15' '?' H'16' '?' H'17' '?' H'18' '?' H'19' '?' H'1A' '?' H'1B' '?'
  H'1C' '?' H'1D' '?' H'1E' '?' H'1F' '?'
  TO #TABLE-A LEAVING NO
IF #MF
  COMPRESS #TABLE-A
   H'20' '?' H'21' '?' H'22' '?' H'23' '?' H'24' '?' H'25' '?' H'26' '?'
   H'27' '?' H'28' '?' H'29' '?' H'2A' '?' H'2B' '?' H'2C' '?' H'2D' '?'
   H'2E' '?' H'2F' '?' H'30' '?' H'31' '?' H'32' '?' H'33' '?' H'34' '?'
   H'35' '?' H'36' '?' H'37' '?' H'38' '?' H'39' '?' H'3A' '?' H'3B' '?'
    H'3C' '?' H'3D' '?' H'3E' '?' H'3F' '?'
    TO #TABLE-A LEAVING NO
END-IF
*
IF G-TRACE < 2
  CALLNAT 'NOMGSTEP' '*' G-NATRP-ERC
ELSE
  CALLNAT 'NOMGSTEP' '*' G-NATRP-ERC G-TRACE
  RMSETTIM.FUNCTION := 'S'
  PERFORM RMSETTIM-SETTIME RMSETTIM
END-IF
COMPCB-OP     := 'C'
COMPCB-CHAR   := 'N'                       /* 'N' - New parm list
PERFORM GET-ARCHIVE-RETENTION_ARCHMAX /*SU13
*
END-SUBROUTINE /* #INIT
*
************************************************************************
DEFINE SUBROUTINE PRINT-PARMS
************************************************************************
PRINT NOTITLE NOHDR (AD=L) *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
  'Input: no. parameters=' #DATA '=' #NOMEX008
  'userarc no=' #USERARC-NUMBER
PRINT NOTITLE NOHDR (AD=L) *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
  'current archive no=' #CURRENT-ARCHIVE-NO
  'save archive no=' #SAVE-ARCHIVE-NO
  'archive dsname=' #ARCHIVE-DSNAME
IF #ARCHMAX NE 0
  WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
    'parameter ARCHMAX=' #ARCHMAX(AD=L)
END-IF
*
END-SUBROUTINE /* PRINT-PARMS
*
************************************************************************
DEFINE SUBROUTINE CALL-USER-ARCHIVE
************************************************************************
IF 'A' = 'B' /*NEVER ÜÜ call example to check parms+get XREF
  CALLNAT 'UEXUDA-N' NOMUDA-API-VERSION NOMUDA-PARMS(*)
END-IF
CALLNAT #NATMEM NOMUDA-API-VERSION NOMUDA-PARMS(*)
IF NOMUDA-RC NE 0
  WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
    'Error:' NOMUDA-RC 'from' #NATMEM / NOMUDA-RT
  TERMINATE 50 /*===>>> STOP ÜÜ
END-IF
*
END-SUBROUTINE /* CALL-USER-ARCHIVE
*
************************************************************************
DEFINE SUBROUTINE ARCHIVE-FROM-DB
************************************************************************
RESET #K-SEQ
READ-NRM. READ REPORT-TEXT BY F-REPNAME-RNB-SEQ = #KEY
  IF F-REPNAME NE #K-REPNAME OR F-REPRNB NE #K-REPRNB
    ESCAPE BOTTOM
  END-IF
  FOR I 1 TO C*F-TEXT
    #T-TEXT := F-TEXT (I)
    #T-RECORD-TYPE := 'T'
    EXAMINE #T-TEXT FOR 'X' GIVING LENGTH IN #RECLEN
    ADD 1 TO #RECLEN
    PERFORM WRITE-WORK-VARIABLE
    IF #ARCHIVE-RC
      ESCAPE BOTTOM (READ-NRM.)
    END-IF
  END-FOR
END-READ
*
END-SUBROUTINE /* ARCHIVE-FROM-DB
*
************************************************************************
DEFINE SUBROUTINE ARCHIVE-FROM-SPOOL
************************************************************************
RESET SPOOL-ERROR G-NATRP-ERC G-NATRP-ERT
*
PERFORM READ-SOURCE
IF SPOOL-ERROR
  ESCAPE ROUTINE
END-IF
*
READ-CONT. READ REPORT-CONTENTS BY AC-REP-RNB-SEQ = #AC-REP-RNB-SEQ
  IF AC-REPNAME NE #AC-REPNAME OR AC-REPRNB NE #AC-REPRNB
    ESCAPE BOTTOM
  END-IF
  FOR #IL 1 TO C*AC-INSERTED-LINE
    #I-TEXT := AC-INSERTED-LINE(#IL)
    EXAMINE #I-TEXT FOR 'X' GIVING LENGTH IN #RECLEN
    COMPCB-ILEN := COMPCB-ILEN-OLD := #RECLEN /* for compat
    RESET #T-TEXT
    CALLNAT 'R-NRMCMP' COMPCB #I-TEXT #T-TEXT G-NATRP-ERC G-NATRP-ERT
    IF G-NATRP-ERC NE 0
      #ERROR-CODE := G-NATRP-ERC
      PERFORM CHECK-FATAL-ERROR
      #ERR-TXT := G-NATRP-ERT
      PERFORM WRITE-ERROR-IN-SYSOUT
      SPOOL-ERROR := TRUE
      RESET G-NATRP-ERC G-NATRP-ERT
      ESCAPE ROUTINE
    END-IF
    #RECLEN := COMPCB-OLEN
    RESET COMPCB-OLEN       /* Zero output length
    IF #RECLEN = 0       /* still using old nsmcmp ?
      #RECLEN := COMPCB-OLEN-OLD
    END-IF
    ADD 1 TO #RECLEN
    #T-RECORD-TYPE := 'T'
    PERFORM WRITE-WORK-VARIABLE
    IF #ARCHIVE-RC
      ADD 1 TO #ARCHIVE-ERRORS
      ESCAPE BOTTOM(READ-CONT.)
    END-IF
  END-FOR
*
  DECIDE FOR FIRST CONDITION
    WHEN C*AC-CONTENTS-N9 > 0
      FOR I 1 TO C*AC-CONTENTS-N9
        #FROM-LINE := AC-FROM-LINE-N9(I)
        #TO-LINE   := AC-TO-LINE-N9(I)
        PERFORM READ-SYSOUT-PORTION
        IF SPOOL-ERROR
          ESCAPE ROUTINE
        END-IF
      END-FOR
    WHEN C*AC-CONTENTS > 0
      FOR I 1 TO C*AC-CONTENTS
        #FROM-LINE := AC-FROM-LINE(I)
        #TO-LINE   := AC-TO-LINE(I)
        PERFORM READ-SYSOUT-PORTION
        IF SPOOL-ERROR
          ESCAPE ROUTINE
        END-IF
      END-FOR
    WHEN NONE IGNORE
  END-DECIDE
*
END-READ
*
END-SUBROUTINE /* ARCHIVE-FROM-SPOOL
*
************************************************************************
DEFINE SUBROUTINE READ-SOURCE
************************************************************************
FIND SOURCE WITH SR-ID = ACTIVE-REPORTS.AR-SOURCE-ID
  IF NO RECORDS FOUND
    #ERR-TXT := 'Source record not found'
    PERFORM WRITE-ERROR-IN-SYSOUT
    SPOOL-ERROR := TRUE
    ESCAPE ROUTINE
  END-NOREC
*
/*SU 2018-10-10 G-SOURCE-TYPE       := SR-TYPE
/*SU 2018-10-10 G-SOURCE-ATTRIBUTES := SR-ATTRIBUTES-IDENT
  #SOURCE-ATTRIBUTES  := SR-ATTRIBUTES-IDENT
  CALLNAT 'RMSR7--N' #SOURCE-ATTRIBUTES SR-TYPE
*
  IF SR-TYPE = NOM-DATA-BASE
    #TARGET-DBID := #NOMDB-DBID
    #TARGET-FNR  := #NOMDB-FNR
    PERFORM SET-LFILE
  END-IF
*
END-FIND
*
END-SUBROUTINE /* READ-SOURCE
*
************************************************************************
DEFINE SUBROUTINE UPDATE-ARCHIVE-DATASET
************************************************************************
UPDAD. FIND (1) ARCHIVE-DATASET WITH AD-ARCHIVE-DSNAME = #ARCHIVE-DSNAME
  AD-VOLSERS (1:20) := #VOLSERS (1:20)
  AD-ORIGINAL-REPORT-COUNT := #ARCHIVED
  IF #ARCHIVE-RC AND AD-MARK-FOR-CONDENSE NE 'X'
    AD-MARK-FOR-CONDENSE := 'X'
  END-IF
  UPDATE (UPDAD.)
END-FIND
*
END-SUBROUTINE /* UPDATE-ARCHIVE-DATASET
*
************************************************************************
DEFINE SUBROUTINE UPDATE-DATASET-EXPIRATION-DATE
************************************************************************
AD. FIND (1) ARCHIVE-DATASET WITH AD-ARCHIVE-DSNAME = #ARCHIVE-DSNAME
  AD-EXPIRATION-DATE := #AD-EXPIRATION-DATE
  UPDATE (AD.)
END-FIND
*
END-SUBROUTINE /* UPDATE-DATASET-EXPIRATION-DATE
*
************************************************************************
DEFINE SUBROUTINE STORE-DATASET-REPORT
************************************************************************
DATASET-REPORT.DR-ARCHIVE-DSNAME := #ARCHIVE-DSNAME
DATASET-REPORT.DR-REPNAME        := ACTIVE-REPORTS.AR-REPNAME
DATASET-REPORT.DR-REPRNB         := ACTIVE-REPORTS.AR-REPRNB
*
IF ACTIVE-REPORTS.AR-ARCHIVE-RETENTION NE ' '
  #PERIOD := ACTIVE-REPORTS.AR-ARCHIVE-RETENTION
ELSE
  #PERIOD := #DEFAULT-PERIOD
END-IF
*
#DATE := *DATX
CALLNAT 'RSCHRP-N' #DATE #PERIOD #DATE-OUT /*increase date by period
*
MOVE EDITED #DATE-OUT (EM=YYYYMMDD) TO DATASET-REPORT.DR-EXPIRATION-DATE
*
IF DATASET-REPORT.DR-EXPIRATION-DATE > #AD-EXPIRATION-DATE
  #AD-EXPIRATION-DATE := DATASET-REPORT.DR-EXPIRATION-DATE
  PERFORM UPDATE-DATASET-EXPIRATION-DATE
END-IF
DATASET-REPORT.DR-OBJECT-TYPE := 'DR'
DATASET-REPORT.DR-OBJECT-TIME := *TIMX
STORE DATASET-REPORT
*
END-SUBROUTINE /* STORE-DATASET-REPORT
*
************************************************************************
DEFINE SUBROUTINE READ-NOMDB-PORTION
************************************************************************
#NSMCOMP-BUFFER-LENGTH := 16381 - 7
#NSMCOMP-CODE          := 'N'  /* 'N' - NEW PARM LIST
#NSMCOMP-COMMAND       := 'D'
*
#ST-ID   := #NOMDB-ID
#ST-LINE := #START-LINE := #FROM-LINE
RESET LINE-FOUND
*
NOMDB. READ SOURCE-TEXT BY ST-ID-LINE = #ST-ID-LINE
  IF ST-ID NE #ST-ID
    IF NOT LINE-FOUND
      #ERR-TXT := 'Source text not found'
      PERFORM WRITE-ERROR-IN-SYSOUT
      SPOOL-ERROR := TRUE
    END-IF
    ESCAPE ROUTINE
  END-IF
  RESET #NSMCOMP-WORK
  #RECORD-NUMBER := ST-LINE-START
  SUBTRACT 1 FROM #RECORD-NUMBER
  REP. REPEAT
    RESET #NSMCOMP-LINE
    INCLUDE C-NSMCMP 'SOURCE-TEXT.ST-TEXT-LOB'
    IF #NSMCOMP-RC =4 AND LINE-FOUND
      ESCAPE BOTTOM (REP.)
    END-IF
    IF #NSMCOMP-RC NE 0
      #I4 := #NSMCOMP-RC
      MOVE EDITED #NSMCOMP-RC (EM=HH) TO #ERR-TXT
      COMPRESS 'in reading Source text (' #I4 '/' #ERR-TXT ')'
        TO #ERR-TXT LEAVING NO
      PERFORM WRITE-ERROR-IN-SYSOUT
      SPOOL-ERROR := TRUE
      ESCAPE ROUTINE
    END-IF
*
    ADD 1 TO #RECORD-NUMBER
    IF NOT LINE-FOUND
      IF #RECORD-NUMBER < #START-LINE
        ESCAPE TOP
      END-IF
      LINE-FOUND := TRUE
    END-IF
*
    IF #RECORD-NUMBER > #TO-LINE
      ESCAPE BOTTOM
    END-IF
*
    #I-TEXT     := #NSMCOMP-LINE
    COMPCB-ILEN := COMPCB-ILEN-OLD := #NSMCOMP-OUTLENGTH /* For compat
    PERFORM SYSOUT-PORTION-COMMON
  END-REPEAT
*
END-READ
*
END-SUBROUTINE /* READ-NOMDB-PORTION
*
************************************************************************
DEFINE SUBROUTINE USER-EXIT-8
************************************************************************
RESET NOMEX008-PARMS (1) NOMEX008-ERROR-CODE NOMEX008-FROMLINE
  NOMEX008-TOLINE NOMEX008-RECORD-LENGTH NOMEX008-NODE
NOMEX008-FUNCTION := NOMEX008-FCT-ARCHIVE
NOMEX008-REPNAME  := #REPNAME
NOMEX008-REPRNB   := #REPRNB
IF G-TRACE > 1
  RMSETTIM.FUNCTION := 'G'
  PERFORM RMSETTIM-SETTIME RMSETTIM
  G-TRACE-MSG := 'CPU consumed so far:'
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  RMSETTIM.FUNCTION := 'S'
  PERFORM RMSETTIM-SETTIME RMSETTIM
END-IF
CALLNAT 'NOMEX008' NOMEX008-PARMS(*)
IF G-TRACE > 1
  RMSETTIM.FUNCTION := 'G'
  PERFORM RMSETTIM-SETTIME RMSETTIM
  COMPRESS 'NOMEX008 from' RMSETTIM.MSG TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  RMSETTIM.FUNCTION := 'S'  /* begin new measure after exit
  PERFORM RMSETTIM-SETTIME RMSETTIM
END-IF
*
END-SUBROUTINE /* USER-EXIT-8
*
************************************************************************
DEFINE SUBROUTINE WRITE-WORK-VARIABLE
************************************************************************
IF #COUNTER >= #VOLID-COUNT
  PERFORM GET-CURRENT-VOLSER
END-IF
*
ADD 1 TO #COUNTER
IF #NATMEM NE ' ' AND #NATLIB NE ' '
  NOMUDA-RECORD        := #TEXT-RECORD
  NOMUDA-RECORD-LENGTH := #RECLEN
  PERFORM CALL-USER-ARCHIVE
ELSE
  IF #RECLEN > 252
    WRITE NOTITLE NOHDR *PROGRAM *TIMX(EM=YYYY'-'MM'-'DD' 'HH':'II)
      'Warning: Record length ='  #RECLEN /
      35T 'Please check report/runnumber:' AR-REPNAME '/' AR-REPRNB
      / 'Record:'
    FOR I=1 TO 256 STEP 16
      #LINE := SUBSTR(#T-TEXT,I,16)
      MOVE EDITED #LINE (EM=H(16)) TO #HEX-LINE
      EXAMINE #LINE AND TRANSLATE USING #TABLE (*)
      WRITE NOTITLE NOHDR #HEX-LINE ' - ' #LINE
    END-FOR
    #ARCHIVE-RC := TRUE
    COMPRESS '7125' #RECLEN AR-REPNAME AR-REPRNB TO LG-MSG
    PERFORM #RLOG
    ESCAPE ROUTINE
  END-IF
  PERFORM WRITE-WORK-OPSYS /*DIFFERENT BETWEEN MF / UNIX
END-IF
RECORDS-WRITTEN := TRUE
*
END-SUBROUTINE /* WRITE-WORK-VARIABLE
*
************************************************************************
DEFINE SUBROUTINE CHECK-IF-IN-USE
************************************************************************
RESET #IN-USE
#INUSE.P-REPORT    := AR-REPNAME
#INUSE.P-REPRNB    := AR-REPRNB
#INUSE.P-USER-TYPE := 'A'
CALLNAT 'N-INUSE' #INUSE  /* Check if active report is in use
DECIDE ON FIRST VALUE #INUSE.P-RC
  VALUE 1
    COMPRESS 'in Printout=' #INUSE.P-REPORT '/' #INUSE.P-PO-ID
      TO #ERR-TXT LEAVING NO
  VALUE 2
    COMPRESS 'in Printout=' #INUSE.P-BUNDLE '/' #INUSE.P-PO-ID
      TO #ERR-TXT LEAVING NO
  VALUE 3
    COMPRESS 'in Bundle=' #INUSE.P-BUNDLE '/' #INUSE.P-BUNDRNB
      TO #ERR-TXT LEAVING NO
  ANY VALUE
    PERFORM WRITE-ERROR-IN-SYSOUT
    #IN-USE := TRUE
    ADD 1 TO #ARCHIVE-IN-USE
  NONE IGNORE
END-DECIDE
*
END-SUBROUTINE /* CHECK-IF-IN-USE
*
************************************************************************
DEFINE SUBROUTINE CHECK-USER-ARCHIVE
************************************************************************
IF #USERARC-NUMBER = 0
  ESCAPE ROUTINE
END-IF
FIND NRM-USER-DEFINED-ARCHIVE WITH M-MONITOR-ID = #USERARC-ID
  IF NO RECORDS FOUND
    COMPRESS '0458' 'Archive' #USERARC-ID TO LG-MSG /*user def. arch.
    PERFORM #RLOG
    WRITE NOTITLE NOHDR *PROGRAM *TIMX(EM=YYYY'-'MM'-'DD' 'HH':'II)
      'User defined archive' #USERARC-ID 'not defined'
    TERMINATE 50 /*===>>> STOP ÜÜ
  END-NOREC
  #ARCHIVE-NAME   := M-USERARC-NAME
  #DEFAULT-PERIOD := M-USERARC-RETENTION
  #NATLIB         := M-USERARC-EXITLIB
  #NATMEM         := M-USERARC-EXITMEM
  IF #NATLIB NE ' ' AND #NATMEM NE ' '
    PERFORM ADD-STEPLIB
    NOMUDA-API-VERSION     := 02
    NOMUDA-FUNCTION        := 'A' /*A(rchive)
    NOMUDA-DATA-SET-NAME-1 := #ARCHIVE-DSNAME
    NOMUDA-ARCHIVE-NAME    := M-USERARC-NAME
    NOMUDA-ARCHIVE-NUMBER  := #USERARC-NUMBER
    NOMUDA-ESY-USERID      := G-NPR-USERID
    NOMUDA-ESY-NODE        := G-MONITOR-NODE
* BLI 2016-04-21 NOMALL-1844 below out
    IF #MF
      NOMUDA-EXPIRY-DATE := #AD-EXPIRATION-DATE-PHYS
    END-IF
  END-IF
END-FIND
*
END-SUBROUTINE /* CHECK-USER-ARCHIVE
*
************************************************************************
DEFINE SUBROUTINE CHECK-ARCHIVE-DATASET
************************************************************************
DS. FIND NUMBER ARCHIVE-DATASET WITH AD-ARCHIVE-DSNAME = #ARCHIVE-DSNAME
IF *NUMBER (DS.) = 0
  ESCAPE ROUTINE
END-IF
DSREP. FIND NUMBER DATASET-REPORT WITH DR-ARCHIVE-DSNAME=#ARCHIVE-DSNAME
IF *NUMBER (DSREP.) GT 0
  COMPRESS '0478' #ARCHIVE-DSNAME TO LG-MSG /*Arc.ds:1:already exists
  PERFORM #RLOG
  WRITE NOTITLE NOHDR *PROGRAM *TIMX(EM=YYYY'-'MM'-'DD' 'HH':'II)
    'Archive dataset' #ARCHIVE-DSNAME 'already exists'
  TERMINATE 50 /*===>>> STOP ÜÜ
END-IF
DEL-AR. FIND ARCHIVE-DATASET WITH AD-ARCHIVE-DSNAME = #ARCHIVE-DSNAME
  DELETE (DEL-AR.)
END-FIND
COMPRESS '0477' #ARCHIVE-DSNAME TO LG-MSG /*EmptyArchiveDS:1:overwritten
PERFORM #RLOG
WRITE NOTITLE NOHDR *PROGRAM *TIMX(EM=YYYY'-'MM'-'DD' 'HH':'II)
  'Empty archive dataset' #ARCHIVE-DSNAME 'overwritten'
*
END-SUBROUTINE /* CHECK-ARCHIVE-DATASET
*
************************************************************************
DEFINE SUBROUTINE PURGE-ACTIVE-REPORTS
************************************************************************
READ-EXPIRED. FIND ACTIVE-REPORTS WITH AR-ARCHIVE = 'P'
  #INUSE.P-REPORT    := AR-REPNAME
  #INUSE.P-REPRNB    := AR-REPRNB
  #INUSE.P-USER-TYPE := 'A'
  CALLNAT 'N-INUSE' #INUSE
  IF #INUSE.P-RC = 1 OR=2 OR=3
    END TRANSACTION
    ESCAPE TOP
  END-IF
*
  IF READ-EXPIRED.AR-CURRENT-LOCATION = 'D'
    #K-REPNAME:= READ-EXPIRED.AR-REPNAME
    #K-REPRNB := READ-EXPIRED.AR-REPRNB
    PERFORM DELETE-REPORT
  END-IF
* Update Active Report   /* use this to prevent 3144
  UPDAR. GET ACTIVE-REPORTS *ISN (READ-EXPIRED.)
  RESET UPDAR.AR-EXPIRATION UPDAR.AR-SOURCE-ID
  UPDAR.AR-CURRENT-LOCATION := 'A'
  UPDAR.AR-ARCHIVE := '*'
  RESET UPDAR.AR-ACTIVE
  UPDATE (UPDAR.)
  ADD 1 TO #ET-COUNT
  ADD 1 TO #ARCHIVE-PURGED
  IF #ET-COUNT GE 100
    RESET #ET-COUNT
    END TRANSACTION
  END-IF
  #MA-REPNAME := UPDAR.AR-REPNAME
  #MA-REPRNB  := UPDAR.AR-REPRNB
  PERFORM UPDATE-MAIL-RECORDS

END-FIND
IF #ARCHIVE-PURGED GT 0
  COMPRESS '0474' #ARCHIVE-PURGED TO LG-MSG /*:1:retained rp fully archi
  PERFORM #RLOG
END-IF
END TRANSACTION
*
END-SUBROUTINE /* PURGE-ACTIVE-REPORTS
*
************************************************************************
DEFINE SUBROUTINE ARCHIVE-ACTIVE-REPORTS
************************************************************************
AR. FIND ACTIVE-REPORTS WITH (AR-ARCHIVE = 'A' OR = 'I')
  IF *COUNTER (AR.) = 1
    WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
      'Reports to be archived:' *NUMBER (AR.)(AD=L)
  END-IF
  #CURRENT-CNT := *COUNTER (AR.)
  ACCEPT IF AR-ARCHIVE-TYPE = #USERARC-NUMBER
  ADD 1 TO #ARCHIVE-MARKED
  IF #ARCHMAX NE 0 AND #ARCHIVE-MARKED > #ARCHMAX /*SU13
    SUBTRACT 1 FROM #ARCHIVE-MARKED
    #ARCHMAX-REACHED := TRUE
    #XX-ERROR-CODE   := 499 /*Max.rep.archived(ARCHMAX)
    PERFORM WRITE-MSG-AND-LOG
    ESCAPE BOTTOM (AR.)
  END-IF
  RESET #ID-RECORD
  #AR-REPNAME :=#PO-REPNAME :=#REPNAME:=#K-REPNAME:=#AC-REPNAME:=
    AR-REPNAME
  #AR-REPRNB := #PO-REPRNB := #REPRNB:=#K-REPRNB:=#AC-REPRNB:=AR-REPRNB
*
  IF AR-ARCHIVE NE 'I'
    PERFORM CHECK-IF-IN-USE
    IF #IN-USE
      ESCAPE TOP
    END-IF
  END-IF
  ADD 1 TO #REPNO
  RESET #ARCHIVE-RC SPOOL-ERROR FROM-SPOOL FROM-NRM #K-SEQ #AC-SEQ
  #SPOOL-ATTRIBUTES := AR-SPOOL-ATTRIBUTES
  CALLNAT 'RMSPL7-N' #SPOOL-ATTRIBUTES #SPOOL-TYPE /*conv. Jobnr+node nr
  DECIDE ON FIRST #SPOOL-TYPE
    VALUE JES2, JES3
      #JOBNAME  := #SPOOL-JES-JOB-NAME
      #JOBNO    := #SPOOL-JES-JOB-NUMBER
      #NODE     := #SPOOL-JES-NODE
      #DSTYPE   := #SPOOL-JES-DSTYPE
      #K-FORM   := #SPOOL-JES-FORM
      #K-FCB    := #SPOOL-JES-FCB
      #K-FLASH  := #SPOOL-JES-FLASH
      #K-CHARS  := #SPOOL-JES-CHARS
      #K-RECFM  := #SPOOL-JES-RECFM
      #K-TRC    := #SPOOL-JES-TRC
/*SU10 ->  VALUE POWER #JOBNAME  := #SPOOL-POWER-JOB-NAME
/*    #JOBNO    := #SPOOL-POWER-JOB-NUMBER #NODE := #SPOOL-POWER-NODE
/*    #DSTYPE   := #SPOOL-POWER-TYPE
    NONE IGNORE /*BS2, UNIX
  END-DECIDE
  #K-CREATED := AR-PROCESS-TIME
  IF AR-NUMBER-OF-LINES GT 9999999
    #K-NUMLINES:= 9999999
  ELSE
    #K-NUMLINES := AR-NUMBER-OF-LINES
  END-IF
  #K-USERID         := AR-USERID
  #I-ARCHIVE-DATE-T := #AR-DATE := *TIMX
  #I-ARCHIVE-DATE   := #I-ARCHIVE-DATE-T
  #K-INDICATOR      := 'NRM'
  #I-RECORD-TYPE    := 'I'
  #RECLEN           := 146
*
  RESET FROM-SPOOL FROM-NRM
  DECIDE ON FIRST VALUE OF ACTIVE-REPORTS.AR-CURRENT-LOCATION
    VALUE 'D'
      FROM-NRM := TRUE
      #ARCHIVED-FROM := 'D'
    VALUE 'S'
      FROM-SPOOL := TRUE
      #ARCHIVED-FROM := 'S'
    NONE
      WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
        'Invalid location:' ACTIVE-REPORTS.AR-CURRENT-LOCATION
        'AR:' AR-REPNAME 'RNB:' AR-REPRNB
  END-DECIDE
*
  IF #NATMEM NE ' ' AND #NATLIB NE ' '
    NOMUDA-AR-NAME       := AR-REPNAME
    NOMUDA-AR-RNB        := AR-REPRNB
    NOMUDA-RECORD        := #ID-RECORD
    NOMUDA-RECORD-LENGTH := #ID-REC-LEN
    PERFORM CALL-USER-ARCHIVE
    #FIRST-VOLSER := #LAST-VOLSER := 'NOMUDA'
  ELSE
    PERFORM WRITE-WORK-OPSYS2
    PERFORM GET-CURRENT-VOLSER
    #FIRST-VOLSER := #LAST-VOLSER
  END-IF
  RECORDS-WRITTEN := TRUE
  IF #REPNO = 1
    PERFORM STORE-ARCHIVE-DATASET
  END-IF
  #ACTISN := *ISN (AR.)
  DECIDE FOR FIRST CONDITION
    WHEN FROM-SPOOL  PERFORM ARCHIVE-FROM-SPOOL
    WHEN FROM-NRM    PERFORM ARCHIVE-FROM-DB
    WHEN NONE        IGNORE /*???? SU or MSG here ?
  END-DECIDE
  IF #ARCHIVE-RC OR SPOOL-ERROR
    ADD 1 TO #ARCHIVE-ERRORS
    ESCAPE TOP
  END-IF
*
  IF #SET-BUILD /*remember archived AR in set to change status lateron
    FIND NUMBER ACTIVE-REPORTS WITH AR-REPORT-RNB = #AR-REPORT-RNB
      OR #RETAIN RETAIN AS #RETAIN
  ELSE
    #SET-BUILD := TRUE
    FIND NUMBER ACTIVE-REPORTS WITH AR-REPORT-RNB = #AR-REPORT-RNB
      RETAIN AS #RETAIN
  END-IF
END-FIND
IF RECORDS-WRITTEN
  CLOSE WORK 1
END-IF
*
END-SUBROUTINE /* ARCHIVE-ACTIVE-REPORTS
*
************************************************************************
DEFINE SUBROUTINE FINALIZE-USER-ARCHIVE
************************************************************************
IF #NATLIB = ' ' OR #NATMEM = ' '
  ESCAPE ROUTINE
END-IF
RESET NOMUDA-RECORD NOMUDA-RECORD-LENGTH
/*SU13 ??  NOMUDA-AR-NAME := AR-REPNAME
/*SU13 ??  NOMUDA-AR-RNB  := AR-REPRNB
NOMUDA-SUBFUNC := 'F' /*F(inish)
PERFORM CALL-USER-ARCHIVE
IF #STEPLIB-ADDED
  PERFORM REMOVE-STEPLIB
END-IF
*
END-SUBROUTINE /* FINALIZE-USER-ARCHIVE
*
************************************************************************
DEFINE SUBROUTINE FINALIZE
************************************************************************
#ARCHIVED := #REPNO - #ARCHIVE-ERRORS
IF #ARCHIVED > 0
  PERFORM UPDATE-ARCHIVE-DATASET
  END TRANSACTION
END-IF
*
PERFORM LOG-STATISTICS
IF G-TRACE > 0
  RMSETTIM.FUNCTION := 'G'
  G-TRACE-MSG := 'Consumed after last exit (if present):'
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  PERFORM RMSETTIM-SETTIME RMSETTIM
  PERFORM XXRLOG-WRITE-LOG 'T' RMSETTIM.MSG
  END TRANSACTION
END-IF
IF #ARCHIVE-RC
  TERMINATE 4 /*===>>> STOP ÜÜ
END-IF
WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
  'Archiver terminated normally'
*
TERMINATE 0
*
END-SUBROUTINE /* FINALIZE
*
************************************************************************
DEFINE SUBROUTINE UPD-AR
************************************************************************
IF NOT #SET-BUILD /*nothing archived Ü
  ESCAPE ROUTINE
END-IF
UPD-ACTIVE. FIND ACTIVE-REPORTS WITH #RETAIN
  #CURRENT-CNT := *COUNTER (UPD-ACTIVE.)
  IF NOT (AR-ARCHIVE = 'A' OR='I' OR AR-ARCHIVE-TYPE NE #USERARC-NUMBER)
    ESCAPE TOP /*something changed - MSG ??
  END-IF
  #AR-REPNAME := #PO-REPNAME := #AC-REPNAME := #REPNAME := #K-REPNAME
    := AR-REPNAME
  #REPNAME := #K-REPNAME := #AC-REPNAME := AR-REPNAME
  #AR-REPRNB := #PO-REPRNB := #AC-REPRNB := AR-REPRNB
  #REPRNB := #K-REPRNB := #AC-REPRNB := AR-REPRNB
  RESET #K-SEQ #ARCHIVE-RC #AC-SEQ
  #SPOOL-ATTRIBUTES := AR-SPOOL-ATTRIBUTES
  CALLNAT 'RMSPL7-N' #SPOOL-ATTRIBUTES #SPOOL-TYPE
  #ACTISN := *ISN (UPD-ACTIVE.)
  PERFORM GET-CURRENT-VOLSER
  PERFORM UPDATE-ACTIVE-REPORT
  PERFORM STORE-DATASET-REPORT
  PERFORM UPDATE-ARCHIVE-DATASET
  END TRANSACTION
  #MA-REPNAME := UPD-ACTIVE.AR-REPNAME
  #MA-REPRNB  := UPD-ACTIVE.AR-REPRNB
  PERFORM UPDATE-MAIL-RECORDS
  IF +G-NOMEXIT-ACTIVE (8)
    PERFORM USER-EXIT-8
  END-IF
  IF FROM-NRM AND ACTIVE-REPORTS.AR-ARCHIVE NE 'R'
    PERFORM DELETE-REPORT
  END-IF
END-FIND
RELEASE SET #RETAIN
*
END-SUBROUTINE /* UPD-AR
*
************************************************************************
DEFINE SUBROUTINE DELETE-REPORT
************************************************************************
CALLNAT 'RMDELRTN' #K-REPNAME #K-REPRNB /*DELETE REPORT-TEXT
*
END-SUBROUTINE /* DELETE-REPORT
*
************************************************************************
DEFINE SUBROUTINE SYSOUT-PORTION-COMMON
************************************************************************
RESET #T-TEXT G-NATRP-ERC G-NATRP-ERT
CALLNAT 'R-NRMCMP' COMPCB #I-TEXT #T-TEXT G-NATRP-ERC G-NATRP-ERT
IF G-NATRP-ERC NE 0
  #ERROR-CODE := G-NATRP-ERC
  PERFORM CHECK-FATAL-ERROR
  #ERR-TXT := G-NATRP-ERT
  PERFORM WRITE-ERROR-IN-SYSOUT
  SPOOL-ERROR := TRUE
  RESET G-NATRP-ERC G-NATRP-ERT
  ESCAPE ROUTINE
END-IF
*
#RECLEN := COMPCB-OLEN
RESET COMPCB-OLEN       /* Zero output length
IF #RECLEN = 0       /* still using old nsmcmp ?
  #RECLEN := COMPCB-OLEN-OLD
END-IF
ADD 1 TO #RECLEN
#T-RECORD-TYPE := 'T'
PERFORM WRITE-WORK-VARIABLE
IF #ARCHIVE-RC
  ADD 1 TO #ARCHIVE-ERRORS
END-IF
*
END-SUBROUTINE /* SYSOUT-PORTION-COMMON
*
************************************************************************
DEFINE SUBROUTINE WRITE-ERROR-IN-SYSOUT
************************************************************************
COMPRESS #AC-REPNAME '/' #AC-REPRNB TO #TXT LEAVING NO
COMPRESS #TXT #NOT-ARC 'Error:' TO #TXT
WRITE NOTITLE NOHDR *PROGRAM *TIMX(EM=YYYY'-'MM'-'DD' 'HH':'II) #TXT
WRITE #ERR-TXT
RESET #ERR-TXT
*
END-SUBROUTINE /* WRITE-ERROR-IN-SYSOUT
*
************************************************************************
DEFINE SUBROUTINE LOG-STATISTICS /*SU13:write msg to sysout too
************************************************************************
#XX-ERROR-CODE   := 432 /*:1:reports marked for archiving (:2:).
#XX-MSG-DYNA (1) := #ARCHIVE-MARKED
#XX-MSG-DYNA (2) := #ARCHIVE-NAME
PERFORM WRITE-MSG-AND-LOG
*
#XX-ERROR-CODE   := 433 /*:1:reports archived (:2:).
#XX-MSG-DYNA (1) := #ARCHIVED
#XX-MSG-DYNA (2) := #ARCHIVE-NAME
PERFORM WRITE-MSG-AND-LOG
*
IF #ARCHIVE-IN-USE > 0
  #ARCHIVE-RC      := TRUE
  #XX-ERROR-CODE   := 434 /*:1:reports not archived because in use (:2:)
  #XX-MSG-DYNA (1) := #ARCHIVE-IN-USE
  #XX-MSG-DYNA (2) := #ARCHIVE-NAME
  PERFORM WRITE-MSG-AND-LOG
END-IF
*
IF #ARCHIVE-ERRORS > 0
  #ARCHIVE-RC      := TRUE
  #XX-ERROR-CODE   := 435 /*:1:reports not archived because oferror(:2:)
  #XX-MSG-DYNA (1) := #ARCHIVE-ERRORS
  #XX-MSG-DYNA (2) := #ARCHIVE-NAME
  PERFORM WRITE-MSG-AND-LOG
END-IF
*
#XX-ERROR-CODE   := 431 /*:1:Archive job ended successfully.
#XX-MSG-DYNA (1) := #ARCHIVE-NAME
PERFORM WRITE-MSG-AND-LOG
*
PRINT '*** End of Report ***'
*
END TRANSACTION
*
END-SUBROUTINE /* LOG-STATISTICS
*
************************************************************************
DEFINE SUBROUTINE GET-CURRENT-VOLSER
************************************************************************
RESET G-NATRP-ERC G-NATRP-ERT
*
IF G-MONITOR-NODE = 0
  RESET #VOLSERS(*)
  #VOLSERS(1):= #FIRST-VOLSER := #LAST-VOLSER := 'FILSYS'
  ESCAPE ROUTINE
END-IF
RESET #COUNTER
*
DECIDE FOR FIRST CONDITION
  WHEN #NATLIB NE ' ' AND #NATMEM NE ' ' /*user arc
    RESET #VOLSERS(*)
    #LAST-VOLSER := #VOLSERS(1) := 'NOMUDA'
/*SU10  WHEN #MF AND #SYSTEM-TYPE =SCAN 'VSE' OR=SCAN 'DOS' /*SU9
/*SU10    PERFORM GET-CURRENT-VOLSER-DOS
/*SU10  WHEN #MF AND #SYSTEM-TYPE =SCAN 'BS2' /*SU9
/*SU10    PERFORM GET-CURRENT-VOLSER-BS2
  WHEN NONE /*JES/unix
    CALLNAT 'RMGETVOL' #TAPE-DDNAME G-MONITOR-JOBNAME /*Get Cur. VOLSER
      G-MONITOR-NODE #LAST-VOLSER #ARCHIVE-DSNAME
      G-NATRP-ERC G-NATRP-ERT
    IF G-NATRP-ERC NE 0
      #ERROR-CODE := G-NATRP-ERC
      PERFORM CHECK-FATAL-ERROR
      WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
        'Error from get VOLSER routine' G-NATRP-ERC
      PRINT NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
        G-NATRP-ERT /*SU8 (AL=70)
      RESET G-NATRP-ERC G-NATRP-ERT
    END-IF
    IF #LAST-VOLSER = ' ' OR = H'000000000000'
      #LAST-VOLSER := 'UNKNWN'
    END-IF
    PERFORM ADD-VOLSER
*
END-DECIDE
*
END-SUBROUTINE /* GET-CURRENT-VOLSER
*
************************************************************************
DEFINE SUBROUTINE CHECK-FATAL-ERROR
************************************************************************
IF #ERROR-CODE = 999
  BACKOUT TRANSACTION
  WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
    'Natural Process Node not active'
  WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
    'Archiver abnormal termination'
  LG-MSG := 5501                        /* abnormal termination
  PERFORM #RLOG
  LG-MSG := 7102                        /* node not active
  PERFORM #RLOG
  #ARCHIVE-RC := TRUE
END-IF
*
END-SUBROUTINE /* CHECK-FATAL-ERROR
*
************************************************************************
DEFINE SUBROUTINE WRITE-MSG-AND-LOG /*SU13
************************************************************************
* 1. Log:
COMPRESS #XX-ERROR-CODE-A4 #XX-MSG-DYNA (1:2) TO LG-MSG
PERFORM #RLOG
* *****
* 2. SYSOUT: //#XX-ERROR-TYPE := 'U' #XX-ERROR-APPL := ??
CALLNAT 'XXGMSG-N' #XX-GMSG-PARMS
PRINT NOTITLE NOHDR *PROGRAM *TIMX(EM=YYYY'-'MM'-'DD' 'HH':'II)
  #XX-SHORT-TEXT
RESET #XX-MSG-DYNA (*)
*
END-SUBROUTINE /* WRITE-MSG-AND-LOG
*
************************************************************************
DEFINE SUBROUTINE STORE-ARCHIVE-DATASET
************************************************************************
AD-VISTA.AD-OBJECT-TYPE := 'AD'
AD-VISTA.AD-OBJECT-TIME := *TIMX
STORE-ARCHIVE. STORE AD-VISTA
#ARCHIVE-ISN := *ISN (STORE-ARCHIVE.)
*
GET-AD. GET ARCHIVE-DATASET #ARCHIVE-ISN
ARCHIVE-DATASET.AD-ARCHIVE-DSNAME := #ARCHIVE-DSNAME
ARCHIVE-DATASET.AD-CREATED := *TIMX
ARCHIVE-DATASET.AD-CREATED-INV := #CONST-INV-TIME
  - ARCHIVE-DATASET.AD-CREATED-P12
IF #MF /* BLI 2016-04-21 NOMALL-1844 below out
  ARCHIVE-DATASET.AD-EXPIRATION-DATE-PHYS := #AD-EXPIRATION-DATE-PHYS
END-IF
ARCHIVE-DATASET.AD-ARCHIVE-TYPE:= #USERARC-NUMBER
UPDATE (GET-AD.)
END TRANSACTION /*SU6
*
END-SUBROUTINE /* STORE-ARCHIVE-DATASET
*
************************************************************************
DEFINE SUBROUTINE UPDATE-ACTIVE-REPORT
************************************************************************
GET-ARCHIVE. GET ACTIVE-REPORTS #ACTISN
IF ACTIVE-REPORTS.AR-ARCHIVE = 'I'
  ACTIVE-REPORTS.AR-ARCHIVE := 'R'
ELSE
  ACTIVE-REPORTS.AR-ARCHIVE := '*'
  ACTIVE-REPORTS.AR-CURRENT-LOCATION := 'A'
END-IF
RESET ACTIVE-REPORTS.AR-ACTIVE
ACTIVE-REPORTS.AR-ARCHIVE-DATA-SET := #ARCHIVE-DSNAME
ACTIVE-REPORTS.AR-ARCHIVE-VOLSER (1) := #FIRST-VOLSER
*
IF ACTIVE-REPORTS.AR-ARCHIVE NE 'R'
  RESET ACTIVE-REPORTS.AR-EXPIRATION ACTIVE-REPORTS.AR-SOURCE-ID
END-IF
ACTIVE-REPORTS.AR-ARCHIVE-VOLSER(2) := #LAST-VOLSER
ACTIVE-REPORTS.AR-ARCHIVE-DATE := #AR-DATE
UPDATE(GET-ARCHIVE.)
*
END-SUBROUTINE /* UPDATE-ACTIVE-REPORT
*
************************************************************************
DEFINE SUBROUTINE CHECK_SET-LFILES
************************************************************************
CALLNAT 'SATLGFVN' SATLGV-PARMS
IF SATLGV-RC NE 0
  WRITE NOTITLE NOHDR *PROGRAM *TIMX(EM=YYYY'-'MM'-'DD' 'HH':'II)
    SATLGV-ERROR-TEXT
  IF SATLGV-LOG-DBID NE 0 OR SATLGV-LOG-FNR NE 0
    WRITE NOTITLE NOHDR *PROGRAM *TIMX(EM=YYYY'-'MM'-'DD' 'HH':'II)
      'Dbid:' SATLGV-LOG-DBID 'Fnr:' SATLGV-LOG-FNR
  END-IF
  TERMINATE 50 /*===>>> STOP ÜÜ
END-IF
*
RESET RACTLF-LOGGING
RACTLF-ERROR-LOGGING := TRUE
RACTLF-LOG-USERID    := #_ARCHIVE
RACTLF-LOG-CODE      := 'MO'
RACTLF-LFILE-1       := 91
RACTLF-LFILE-2       := 206
CALLNAT 'RACTLF-N' RACTLF-PARMS
IF RACTLF-ERROR-CODE NE 0
  WRITE NOTITLE NOHDR *PROGRAM *TIMX(EM=YYYY'-'MM'-'DD' 'HH':'II)
    RACTLF-ERROR-CODE RACTLF-ERROR-TEXT
  WRITE NOTITLE NOHDR *PROGRAM *TIMX(EM=YYYY'-'MM'-'DD' 'HH':'II)
    'Dbid1:' RACTLF-DBID-1 'Fnr1:' RACTLF-FNR-1
  WRITE NOTITLE NOHDR *PROGRAM *TIMX(EM=YYYY'-'MM'-'DD' 'HH':'II)
    'Dbid2:' RACTLF-DBID-2 'Fnr2:' RACTLF-FNR-2
  TERMINATE 50 /*===>>> STOP ÜÜ
END-IF
*
END-SUBROUTINE /* CHECK_SET-LFILES
*
************************************************************************
DEFINE SUBROUTINE SET-LFILE
************************************************************************
#LFILE-NEWDBID := #TARGET-DBID
#LFILE-NEWFILE := #TARGET-FNR
**      change physical DBID and File-Number of logical File 186:
CALLNAT 'RMIGSFIL' #LFILE-RC #LFILE-NEWDBID #LFILE-NEWFILE
IF #LFILE-RC NE 0
  COMPRESS 'of setting LFILE RC=' #LFILE-RC TO #ERR-TXT
  PERFORM WRITE-ERROR-IN-SYSOUT
  SPOOL-ERROR := TRUE
END-IF
*
END-SUBROUTINE /* SET-LFILE
*
************************************************************************
DEFINE SUBROUTINE GET-ARCHIVE-RETENTION_ARCHMAX
************************************************************************
IF #DEFAULT-PERIOD NE ' ' /*user arc
  ESCAPE ROUTINE
END-IF
FNDARCH. FIND ARCHIVE-TASK WITH M-MONITOR-ID = #_ARCHIVE
  IF NO RECORDS FOUND
    WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
      'Archive Definitions not found'
    TERMINATE 50 /*===>>> STOP ÜÜ /*SU13 was STOP
  END-NOREC
*
  IF M-ARCHIVE-RETENTION NE ' '
    #DEFAULT-PERIOD := M-ARCHIVE-RETENTION
  ELSE
    #DEFAULT-PERIOD := '6M'
  END-IF
  EOMSYSNR := M-ARCHIVE-VSE-SYSNR
* ARCHMAX: /*SU13
  EXAMINE M-JOBCARD (*) FOR 'ARCHMAX=' GIVING POSITION #POS INDEX #IND
  IF #POS > 0
    SEPARATE SUBSTR(M-JOBCARD (#IND),#POS) INTO #ARCHMAX-A #ARCHMAX-A
    IGNORE WITH DELIMITERS '='
    IF #ARCHMAX-A IS (N6)
      #ARCHMAX := VAL (#ARCHMAX-A)
    END-IF
  END-IF
/*SU13  UPDATE (FNDARCH.) END TRANSACTION
END-FIND
*
END-SUBROUTINE /* GET-ARCHIVE-RETENTION_ARCHMAX
*
************************************************************************
DEFINE SUBROUTINE UPDATE-MAIL-RECORDS
************************************************************************
RESET #MAIL-CNT
FNDMA. FIND MAIL WITH MA-REP-RNB = #MA-REP-RNB
  IF NO RECORDS FOUND
    ESCAPE BOTTOM (FNDMA.)
  END-NOREC
*
  IF MA-CURRENT-LOCATION = ' '
    G-NATRP-ERT := '1549'
    PERFORM XXRLOG-WRITE-LOG 'W' G-NATRP-ERT
  END-IF
  ADD 1 TO #MAIL-CNT
  MA-CURRENT-LOCATION := 'A'
  UPDATE (FNDMA.)
  IF #MAIL-CNT > 50
    END TRANSACTION
    RESET #MAIL-CNT
  END-IF
END-FIND
IF #MAIL-CNT > 0
  END TRANSACTION
  RESET #MAIL-CNT
END-IF
*
END-SUBROUTINE /* UPDATE-MAIL-RECORDS
*
************************************************************************
DEFINE SUBROUTINE ADD-VOLSER /*SU8
************************************************************************
IF #VOLI LE *OCC(#VOLSERS) /*SU8
  IF #VOLI = 0 OR #VOLSERS (#VOLI) NE #LAST-VOLSER
    ADD 1 TO #VOLI
    IF #VOLI LE *OCC(#VOLSERS) /*SU7
      #VOLSERS (#VOLI) := #LAST-VOLSER
    END-IF
  END-IF
END-IF
IF #VOLI > *OCC(#VOLSERS) /*SU8
  PRINT NOTITLE NOHDR (AD=L) *PROGRAM *TIMX(EM=YYYY'-'MM'-'DD' 'HH':'II)
    'more than' *OCC(#VOLSERS) 'VOLSERS; ignored:' #LAST-VOLSER
END-IF
*
END-SUBROUTINE /* ADD-VOLSER
* End of Copycode RJARC-C ***************************************************
