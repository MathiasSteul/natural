* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
DEFINE DATA LOCAL
1 REPORT VIEW OF NRM-REPORTS-NEW
  2 R-REPNAME
  2 R-MASTER-REPNAME
  2 R-TYPE
  2 R-DESC
  2 R-USERID
  2 R-STORE-NATRPT
END-DEFINE
FNDRP. FIND REPORT WITH R-REPNAME = 'NKEW_BIN_REP'
IF NO RECORDS FOUND
  PRINT 'NO REC'
END-NOREC
PRINT 'FOUND: ' R-REPNAME
END-FIND
END
