* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
/*******************************************************************************
/*  Software AG - Entire Output Management
/*  Group:    Util
/*  Module:   NOMGENV
/*  Template:
/*
/*  Function:
/** Get the resolved contents of environment variables */
/*
/** Last :author fhi
/*
/*******************************************************************************
/*  Maintenance
/*******************************************************************************
/*  User ID   yyyy-mm-dd Issue         Remark
/* -----------------------------------------------------------------------------
/*  fhi       2010-11-24               Created.
/*  fhi    2012-04-03 NOMALL-1119 Recataloged due to changes of XXUX---P
/*  fhi    2014-02-20 NOMALL-1338 Parameter sequence changd for XXUX---P
/*  fhi    2014-08-29 NOMALL-1454 Recataloged due to changes of XXUX---P
/*  BLI    2019-05-06 NOMALL-2261 Recataloged due to changes of XXUX---P
/************************************* data ************************************

DEFINE DATA
LOCAL USING XXUX---P
LOCAL
1 #INPUT-STRING                        (A250)
1 #STRING                              (A250)
1 #RESOLVED                            (A78/*)
1 #RESOLVED-OUT                        (A78/10)
1 #ERC                                 (N4)
1 #ERT                                 (A250)
1 #OCC                                 (I4)
END-DEFINE

SET KEY ALL
SET CONTROL 'N'
WRITE ' '

REPEAT
  UNTIL *PF-KEY NE 'ENTR'
  RESET P-RECORD P-FILE-NAME P-ERC P-ERT
  INPUT USING MAP 'NOMGENM&'
  #STRING := #INPUT-STRING
*  fhi    2014-02-20 NOMALL-1338 start commenting
* PERFORM XXGETENV-GET-VARS XXUX---P
*   #STRING #ERC #ERT
*  fhi    2014-02-20 NOMALL-1338 end commenting, start insertion
  PERFORM XXGETENV-GET-VARS
    #STRING #ERC #ERT XXUX---P
*  fhi    2014-02-20 NOMALL-1338 end commenting, end   insertion
  PERFORM XXWRAP-WORD-WRAP 'L' #STRING #RESOLVED (*) 78
  #OCC := *OCC(#RESOLVED)
  IF #OCC > 10
    #OCC := 10
  END-IF
  #RESOLVED-OUT (1:#OCC) := #RESOLVED (1:#OCC)
END-REPEAT

END
