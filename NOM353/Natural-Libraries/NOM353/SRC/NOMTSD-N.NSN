* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
/* --------------------------------------------------------------------
* Subprogram  NOMTSD-N
* Version    3.5.0
* Function   NOM API Maintenance of Shutdown Monitor Tasks
*            Functions  'S' - Shutdown
*                       'G' - Get Status
*
*
* Maintenance:
* CF      2017-11-16 NOMALL-2050 Created
*
/* --------------------------------------------------------------------
DEFINE DATA
PARAMETER USING ESMCNT-A
PARAMETER USING ESMINP-A
LOCAL
/*
1 FUNCT                  (A1)    /* G=Get Monitor status,
/*                                  S=Shutdown Monitor.
1 MSG-CODE               (N4)
1 MSG-TEXT               (A250)
1 LANGUAGE               (N1)
/*
END-DEFINE
/* --------------------------------------------------------------------
/* Main Line
/* --------------------------------------------------------------------
RESET ES-RC
RESET ES-MSG-NR ES-MSG-FIELD ES-MSG-TXT
/*
/* Perform the requested function
/*
DECIDE ON FIRST VALUE OF ES-EXTEND-FUNCTION
  VALUE 'G'               /* Get Monitor status
    FUNCT    := ES-EXTEND-FUNCTION
    LANGUAGE := ES-LANGUAGE
    CALLNAT 'RMDELSUB' FUNCT MSG-CODE MSG-TEXT LANGUAGE
    /*PERFORM TEST
    /*
    ES-MSG-NR  := MSG-CODE
    ES-MSG-TXT := MSG-TEXT
    IF MSG-CODE NE 0
      ES-RC := 4   /* Waiting for shutdown
    END-IF
    /*
  VALUE 'S'               /* Initiate Shutdown Monitor
    FUNCT    := ES-EXTEND-FUNCTION
    LANGUAGE := ES-LANGUAGE
    CALLNAT 'RMDELSUB' FUNCT MSG-CODE MSG-TEXT LANGUAGE
    /*PERFORM TEST
    /*
    ES-MSG-NR  := MSG-CODE
    ES-MSG-TXT := MSG-TEXT
    IF MSG-CODE NE 0
      ES-RC := 5   /* Monitor currently running
    END-IF
    /*
  NONE VALUE
    ES-RC := 2     /* Invalid function code
END-DECIDE
/*
/* --------------------------------------------------------------------
/* Internal Subroutines
/* --------------------------------------------------------------------
/*
DEFINE SUBROUTINE TEST
/*
ADD 1 TO ES-NUMBER
DECIDE ON FIRST VALUE OF ES-NUMBER
  VALUE 1
    MSG-CODE := 8011
    MSG-TEXT := 'Starting monitor shutdown'
  VALUE 2 : 9
    MSG-CODE := 8022
    MSG-TEXT := 'Waiting for shutdown'
  NONE
    MSG-CODE := 0
    MSG-TEXT := 'Monitor shutdown successfully ended'
END-DECIDE
/*
END-SUBROUTINE
/*
/* ********************************************************************
ON ERROR
/* ********************************************************************
  ES-RC := 1
  COMPRESS *PROGRAM 'ERROR' *ERROR-NR *ERROR-LINE TO ES-MSG-TXT
  ESCAPE ROUTINE
END-ERROR
*
END
