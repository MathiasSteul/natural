* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* NOGRRU-N - read grants for printer + user
*
* Maintenance:
* XSETHZ 2002-12-04   created
* XSETHZ 2003-07-09   p(240729) restrict usage for printer p(240729)
* XSETGGR 2012-11-30 nomall-89 rewrite to work in NOM CI
* SU1     2024-08-12 NOM 353     remove PRINT (since NOM341)
************************************************************************
DEFINE DATA PARAMETER
1 #OBJECT-TYPE           (A1)    /*  in
1 #OBJECT-NAME           (A25)   /*  in
1 #USER-ID               (A8)    /*  in
1 #GR-USER-ID            (A8)    /*  out
1 #GRANTED               (L)     /*  out
************************************************************************
LOCAL
1 PRINTERS VIEW OF NRM-PRINTERS
  2 P-DISP
1 #GRANTS                (A1/6)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET #GR-USER-ID #GRANTS (*)
#GRANTED := TRUE
*
CALLNAT 'NOGROU-N' #OBJECT-TYPE #OBJECT-NAME #USER-ID #GR-USER-ID
  #GRANTS(*)
*
/*SU1 PRINT '=' #OBJECT-NAME '=' #GRANTS(*) '=' #GR-USER-ID
IF #GR-USER-ID NE ' '
  IF NOT #GRANTS(*) = 'Y'
    FIND PRINTERS WITH P-ID = #OBJECT-NAME
      IF P-DISP = 'Y'
        RESET #GRANTED
      END-IF
    END-FIND
  END-IF
ELSE
  RESET #GRANTED
END-IF
*
END
