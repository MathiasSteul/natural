* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
*           Invoke via: F#HEX  (<alpha>)  /*return binary field in hex
* ----------------------------------------------------------------------
* Maintenance
* -----------
* uuuuuu  yyyy-mm-dd iTrac       Remark
* SU      2021-11-08 NOMALL-2506 created for RMPRVTM
* ----------------------------------------------------------------------
*
DEFINE FUNCTION F#HEX RETURNS #OUT-HEX (A) DYNAMIC
  DEFINE DATA PARAMETER
  1 #IN-A      (A) DYNAMIC BY VALUE
************************************************************************
  LOCAL
  1 #A1      (A1)
  1 #OUT_A70 (A70)
  1 REDEFINE #OUT_A70
    2 #OUT_A70-TAB (A2/35)
  1 #I       (I2)
  END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET #OUT-HEX
FOR #I=1 TO *LENGTH (#IN-A)
  #A1 := SUBSTR(#IN-A,#I,1)
  MOVE EDITED #A1 (EM=HH) TO #OUT_A70-TAB (#I)
END-FOR
#OUT-HEX := #OUT_A70
*
END-FUNCTION /*(F#HEX)
*
END
