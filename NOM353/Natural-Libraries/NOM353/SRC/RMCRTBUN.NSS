* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RMCRTBUN - Send a Report to Bundle(s)
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* mrs 93-06-30 s(999999) cleanup
* mrs 94-06-08 s(200550) g-bundle-... instead of p-bundle- ...
* mrs 95-03-17 s(218551) assign bc-pagedef and bc-formdef ...
* gw  96-03-12 s(240272) assign bc-repno
* gw  96-03-27 s(240272) #spool-type instead of g-source-type
* gw  96-09-18 s(999999) use NOMRNB-N to get RNB
* gw  96-10-23 s(255042) Bundles with name blank
*                        This is only remedy for symptom, not for cause
* gw  97-01-27 s(260458) P-FLUSH-TIME is ignored
* gw  98-04-04 s(278966) Allow dynamic bundling by ignoring existing
*                        report in bundle definitions.
*                        The report is bundled only in those specified
*                        in G-BUNDLE (*).
* gw  98-08-27 s(999999) G-HOLD
* gw  98-09-07 s(999999) G-BUNDLES-SEQUENCE-NR AND G-BUNDLES-GROUP
*                        G-BUNDLE-REPORT-SEPARATORS
* sju 99-02-22 s(179574) set NAF/CMASPOOL spool attributes
* SJU 99-03-31 S(179744) HONOUR P-BUNDLE-HOLD
* sju 00-03-24 p(191368) monitor multitasking
* wcd 00-04-01 CE 7267   Increase to 20 printers
* sju 00-05-24 p(191368) may also be called by RJREVIVE to put a revived
*                        report into an active bundle, in which case a
*                        bundle contents record with no bundle run
*                        number already exists. We simply have to open
*                        a bundle (if not one already) and adjust bundle
*                        contents record to point to it.
* ws  00-06-30 CE 5630   bundle flush lines exceeded
* xsiszha 2000-08-15 (CE7461) Extend Report and Bundle Names
* sju 01-03-09 p(204915) suppress bundle printing - NB had to use new
* views and do a couple of GETs to avoid changing the GDA
* sju 02-03-01 p(221038) Set bundle defaults when creating a bundle
* sju 02-04-26 NOM221    Solutions for 204915 and 221038 can use GDA now
* XSETHZ 2004-01-29 P(249557) Separator Page not printed
* HH 040825 FORMATTING T CHANGED;                /* HH 040825
* sju 04-12-02 p(225157) Additional separation exit fields
* sju 04-12-06 NOM31     Add date and time (tenths of second) to trace
* sju 05-03-16 NOM31     NAT AM=NOM
* fhi 05-04-21 NOM3107  Support 7-byte job numbers
* xsetggr 2005-10-26 p(270950) ISN must be P10 , not P8
* xsetggr 2007-07-19 p(295731) honour  b-flag-repsep
* xsetggr 2007-09-04 NOM3201   Support P11 format run numbers
* fhi     2008-02-28 P302081   NAT1035 in 8630
* xsetggr 2008-05-05 p(304350) restow due to changes in RMSPL--L
* splildav 2010-02-03 N3246    Support bundle status
* fhi     2010-03-29 P324700   Pass correct file to GETHOLD
* fhi     2010-10-12 NOMALL-97 Use trace levels, use XXRLOG
* fhi     2014-03-03 NOMALL-1363 Get cat cate into trace messages
* SU1     2014-03-05 NOMALL-1281 show last update user+date in NOMRNB-N
* SU2     2014-07-02 NOMALL-1279 fill fields for Adabas Vista
* SU3     2014-11-05 NOMALL-1450 fill fields for Adabas Vista
* fhi     2015-06-30 NOMALL-1655 Leave copies field as entered
* SU4     2016-01-19 NOMALL-1802 do not update Adabas Vista fields
* SU5     2016-08-12 NOMALL-1814(NOM3.5) remove AdaVista fields
* fhi     2016-09-19 NOMALL-1814 Correction of SU3: Fill report name/rnb
* fhi     2016-11-15 NOMALL-1961 Use new task IDs
* fhi     2017-03-31 NOMALL-2009 Improve RDC handling
* SU6     2018-02-01 NOMALL-1823 NOM 3.5: remove CONNECT
* SU7     2018-08-30 NOMALL-2130 sep.var.:GDA MONIT-GL -> PDA RMEXSEPA
* SU8     2024-03-07 ES-34613    NOM 3.6 Remove power
* ----------------------------------------------------------------------
*
DEFINE DATA GLOBAL USING  MONIT-GL
PARAMETER
1 RMEX-SPOOL-ATTRIBUTES   (A250) OPTIONAL
************************************************************************
INDEPENDENT
1 +CMRDC                  (A1)
* *****
LOCAL USING MAXITIML
LOCAL USING VBURP-L
LOCAL USING VMBRP-L
LOCAL USING VGRANT-L
LOCAL USING SUPER-L
LOCAL USING RLOG-L
LOCAL USING RMSPL--L
LOCAL USING RMSR---E
LOCAL USING VDEFBU-L
LOCAL USING RACTLF-A
* *****
LOCAL
1 BC-VISTA VIEW OF NRM-BUNDLE-CONTENTS
  2 BC-OBJECT-TYPE
  2 BC-OBJECT-TIME
1 ACTIVE-BUNDLES-LOC VIEW OF NRM-ACTIVE-BUNDLES
  2 AB-BUNDLE
  2 AB-BUNDRNB
  2 AB-BUNDRNB-INV
  2 AB-COORDINATOR-ID
  2 C*AB-PRINT-LIST
  2 AB-PRINT-LIST         (1:20)
  2 REDEFINE AB-PRINT-LIST
    3 AB-PRINT-LIST-1     (1:20)
      4 AB-PRINTER        (A8)
      4 AB-PRINTER-COPIES (N3)
  2 AB-STATUS
  2 AB-HOLD
  2 AB-FLUSH-TIME
  2 AB-FLUSH-UNTIL
  2 AB-FLUSH-INTERVAL
  2 AB-FLUSH-LINES
  2 AB-OPEN-TIME
  2 AB-COPIES
  2 AB-PLAN-FLUSH-TIME
  2 AB-SEPNO
  2 AB-SEPMEM
  2 REDEFINE AB-SEPMEM
    3 AB-SEPSTART         (A8)
    3 AB-SEPEND           (A8)
  2 C*AB-FLUSH-EVENTS
  2 AB-FLUSH-EVENTS
    3 AB-FLUSH-REPORTS    (1:10)
    3 AB-REPORT-STATUS    (1:10)
  2 AB-RETENTION-ACTION
  2 AB-EXPIRATION
  2 AB-RETENTION-PERIOD
  2 REDEFINE AB-RETENTION-PERIOD
    3 AB-RETENTION-NUM    (N3)
    3 AB-RETENTION-UNIT   (A1)
    3 AB-RETENTION-CALENDAR(A8)
  2 AB-NUMBER-OF-LINES
  2 AB-PRINT-JOBCARD      (1:3)
  2 AB-CONTROL-EXITLIB
  2 AB-OBJECT-TYPE
  2 AB-OBJECT-TIME
  2 AB-CONTROL-EXITMEM    (A8)
* *****
1 BUNDLE-IS-OPEN          (L)
1 #BUNDISN                (P10)
1 #FR                     (P3)
1 #BUNDLE                 (A25)
1 REDEFINE #BUNDLE
  2 #BUNDLE-8             (A8)
  2 #BUNDLE-R             (A17)
1 #BR-BUNDLE-8            (A8)
1 #ADA-RC                 (N4)
1 #AB-BUNDLE-STATUS       (A27)
1 REDEFINE    #AB-BUNDLE-STATUS
  2 #ABS-BUNDLE           (A25)
  2 #ABS-STATUS           (A2)
*
1 #AB-BUNDLE-RNB-INV      (A31)
1 REDEFINE    #AB-BUNDLE-RNB-INV
  2 #ABI-BUNDLE           (A25)
  2 #ABI-INV              (P11)
*
1 #OPENT                  (T)
1 #OPENP                  (P12)
1 #TIMX                   (T)
1 #TIMP                   (P12)
1 #CURRENT-TIME           (T)
1 #DATE-IN                (D)
1 #DATE-OUT               (D)
1 #DATE-A                 (A8)
1 NOMRNB-PARMS
  2 NOMRNB-RNB            (P11)
  2 NOMRNB-NAME           (A25)
  2 NOMRNB-TYPE           (A1) /* 'R' - Report, 'B' - Bundle
1 #ALREADY-IN-BUNDLE      (L)
1 #DEF-PRINT-NMB          (N2) CONST <5>
1 #GI                     (I4)
1 #GR-SUPER               (A34)
1 REDEFINE #GR-SUPER
  2 #GR-TYPE              (A1)
  2 #GR-USERID            (A8)
  2 #GR-OBJECT            (A25)
1 #TEMP-TIME              (A4)
1 REDEFINE    #TEMP-TIME
  2 #TEMP-HH              (N2)
  2 #TEMP-II              (N2)
1 #VALID-WEEKDAYS      (A2/7) INIT <'SU','MO','TU','WE','TH','FR','SA'>
1 #SCHEDULE-IS-VALID      (L)
1 #DI                     (I2)
1 #ADAY                   (A3)
1 #NDAY                   (N3)
1 #TRACING                (L)
1 #CATDATE                (A19)
1 #MONIT-ID               (A16)
1 #REVIVE                 (L)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE SEND-TO-BUNDLE
************************************************************************
IF G-TRACE GE *LEVEL AND G-TRACE-SET = SCAN ('CREATE')
  #TRACING := TRUE
  COMPRESS 'G-Bundles:' G-BUNDLES(*) TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  PERFORM XXCATAL-GET-CATDATE #CATDATE
  COMPRESS *PROGRAM 'cataloged at'  #CATDATE TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
INCLUDE CMRDC
#MONIT-ID := F#MONITOR-TASK-ID1 (<>)
#AR-REPNAME := G-REPORT
#AR-REPRNB  := G-REPRNB
IF G-FATHER-PROG = 'RJREVIVE' OR=MASK('RJREVUX') /*SU7
  #REVIVE := TRUE
END-IF
*
FIND1. FIND BUNDLE-CONTENTS WITH BC-REPORT-RNB = #AR-REPORT-RNB
  #AB-BUNDLE := BC-BUNDLE
  #AB-BUNDRNB := BC-BUNDRNB
  IF #REVIVE
    IF BC-BUNDRNB NE 0
      ESCAPE TOP
    END-IF
    PERFORM SEND-TO-ACTIVE-BUNDLE
    RESET #ALREADY-IN-BUNDLE
    FIND BUNDLE-CONTENTS WITH BC-BUNDLE-RNB = #AB-BUNDLE-RNB
        AND BC-REPORT-RNB = #AR-REPORT-RNB
      #ALREADY-IN-BUNDLE:= TRUE
    END-FIND
    GET BUNDLE-CONTENTS *ISN(FIND1.)
    IF NOT #ALREADY-IN-BUNDLE
      BC-BUNDRNB:= #AB-BUNDRNB
      UPDATE
      PERFORM LOG-BUNDLED-REPORT
    ELSE
      DELETE
      LG-USERID  := G-MONITOR-ID
      LG-CODE    := 'R1'
      LG-REPNAME := #AR-REPNAME
      LG-REPRNB  := #AR-REPRNB
      LG-MSG     := 0437
      CALLNAT 'RLOG' PL-PARMS
    END-IF
    END TRANSACTION
    ESCAPE ROUTINE
  END-IF
*
  FIND2. FIND ACTIVE-BUNDLES WITH AB-BUNDLE-RNB = #AB-BUNDLE-RNB
    SUBTRACT BUNDLE-CONTENTS.BC-NUMBER-OF-LINES FROM
      ACTIVE-BUNDLES.AB-NUMBER-OF-LINES
    ADD ACTIVE-REPORTS.AR-NUMBER-OF-LINES TO
      ACTIVE-BUNDLES.AB-NUMBER-OF-LINES
    IF G-BUNDLE-FLUSH-LINES NE 0
      ACTIVE-BUNDLES.AB-FLUSH-LINES := G-BUNDLE-FLUSH-LINES
    END-IF
    UPDATE (FIND2.)
  END-FIND
*
  BUNDLE-CONTENTS.BC-NUMBER-OF-LINES :=ACTIVE-REPORTS.AR-NUMBER-OF-LINES
  UPDATE (FIND1.)
*
  ESCAPE ROUTINE
END-FIND
*
G-SENT-TO-BUNDLE := FALSE
*
IF G-BUNDLES (*) NE ' '
  FOR #FR 1 TO 5
    IF G-BUNDLES (#FR) NE ' '
      PERFORM DEFINE-REPORT-IN-BUNDLE
    END-IF
  END-FOR
END-IF
*
/*SU 2018-10-04 -> IF +G-IGNORE-REP-IN-BUN-DEFS FOR #I 1 TO 5
/*  IF G-BUNDLES (#I) NE ' ' BR-BUNDLE := G-BUNDLES (#I)
/*    PERFORM SEND-TO-ACTIVE-BUNDLE END-IF END-FOR END TRANSACTION
/*/*SU 2018-10-04 <-  ESCAPE ROUTINE END-IF
FIND BUNDLE-REPORT WITH BR-REPNAME = G-REPORT
  IF NO RECORDS FOUND
    ESCAPE ROUTINE
  END-NOREC
*
  EXAMINE BR-BUNDLE FOR H'00' REPLACE ' '
  IF BR-BUNDLE = ' '
    ESCAPE TOP
  END-IF
*** Check if bundle is defined as 'S' (Suspend)
  FIND BUNDLES WITH B-BUNDLE = BR-BUNDLE
    IF B-BUNDLE-STATUS NE 'S'   /* BUNDLE NOT SUSPENDED
      PERFORM SEND-TO-ACTIVE-BUNDLE
    END-IF
  END-FIND
  END TRANSACTION
END-FIND
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE SEND-TO-ACTIVE-BUNDLE
************************************************************************
IF #REVIVE
  #AB-BUNDLE := #ABS-BUNDLE := #ABI-BUNDLE := BC-BUNDLE
ELSE
  RESET BUNDLE-CONTENTS
  BUNDLE-CONTENTS.BC-REPNAME := ACTIVE-REPORTS.AR-REPNAME
  BUNDLE-CONTENTS.BC-REPRNB := G-REPRNB
  #AB-BUNDLE := #ABS-BUNDLE := #ABI-BUNDLE := BR-BUNDLE
END-IF
RESET BUNDLE-IS-OPEN #AB-BUNDRNB
*
FIND-MASTER-BUND. FIND (1) BUNDLES WITH B-BUNDLE = #AB-BUNDLE
END-FIND
IF *NUMBER (FIND-MASTER-BUND.) = 0
  #BUNDLE := #AB-BUNDLE
  PERFORM STORE-BUNDLE-DEFINITION
END-IF
#ABS-STATUS := 'O'
OPEN-BU. FIND (1) ACTIVE-BUNDLES WITH AB-BUNDLE-STATUS=#AB-BUNDLE-STATUS
  IF NO RECORDS FOUND
    PERFORM GET-RUN-NUMBER
    ESCAPE BOTTOM
  END-NOREC
  #AB-BUNDRNB:= AB-BUNDRNB
  BUNDLE-IS-OPEN := TRUE
  #BUNDISN := *ISN (OPEN-BU.)
END-FIND
IF #AB-BUNDRNB = 0
  #AB-BUNDRNB := 1
END-IF
IF BUNDLE-IS-OPEN
  PERFORM UPDATE-ACTIVE-BUNDLE
ELSE
  PERFORM CREATE-ACTIVE-BUNDLE
END-IF
IF NOT #REVIVE
  PERFORM STORE-REPORT-IN-ACTIVE-BUNDLE
END-IF
*
END-SUBROUTINE /* SEND-TO-ACTIVE-BUNDLE
*
************************************************************************
DEFINE SUBROUTINE GET-RUN-NUMBER
************************************************************************
NOMRNB-NAME := #ABS-BUNDLE
NOMRNB-TYPE := 'B'
CALLNAT 'NOMRNB-N' NOMRNB-RNB NOMRNB-NAME NOMRNB-TYPE G-USERID /*SU1
#AB-BUNDRNB := NOMRNB-RNB
*
END-SUBROUTINE /* GET-RUN-NUMBER
*
************************************************************************
DEFINE SUBROUTINE DEFINE-REPORT-IN-BUNDLE
************************************************************************
#BUNDLE := G-BUNDLES (#FR)
BR1. FIND NUMBER BUNDLE-REPORT WITH BR-BUNDLE = #BUNDLE
AND BR-REPNAME = G-REPORT                                             /*
IF *NUMBER (BR1.) > 0
  ESCAPE ROUTINE
END-IF
BU1. FIND BUNDLES WITH B-BUNDLE = #BUNDLE
END-FIND
IF *NUMBER (BU1.) = 0
  PERFORM STORE-BUNDLE-DEFINITION
END-IF
PERFORM STORE-REPORT-IN-BUNDLE
*
END-SUBROUTINE /* DEFINE-REPORT-IN-BUNDLE
*
************************************************************************
DEFINE SUBROUTINE STORE-BUNDLE-DEFINITION
************************************************************************
RESET BUNDLES
BUNDLES.B-BUNDLE         := #BUNDLE
BUNDLES.B-MASTER-REPNAME := ##MASTER-REPNAME
*
RESET  BUNDLES.B-FLUSH-DAYS (*) BUNDLES.B-FLUSH-WEEK-DAYS (*)
  BUNDLES.B-FLUSH-CALENDAR  BUNDLES.B-FLUSH-BEFORE-AFTER
  BUNDLES.B-FLUSH-START     BUNDLES.B-FLUSH-END    BUNDLES.B-FLUSH-INT
BUNDLES.B-FLUSH-TIME-SCHEDULE := 'N'
*
DECIDE FOR FIRST CONDITION
  WHEN G-BUNDLE-FLUSH-TIME NE T'00:00:00'
    MOVE EDITED G-BUNDLE-FLUSH-TIME (EM=HHII) TO BUNDLES.B-FLUSH-START
    MOVE EDITED G-BUNDLE-FLUSH-TIME (EM=HHII) TO BUNDLES.B-FLUSH-END
    BUNDLES.B-FLUSH-TIME-SCHEDULE := 'Y'
  WHEN G-DEF-FLUSH-TIME NE T'00:00:00'
    MOVE EDITED G-DEF-FLUSH-TIME (EM=HHII) TO BUNDLES.B-FLUSH-START
    MOVE EDITED G-DEF-FLUSH-TIME (EM=HHII) TO BUNDLES.B-FLUSH-END
    BUNDLES.B-FLUSH-TIME-SCHEDULE := 'Y'
  WHEN NONE
    IGNORE
END-DECIDE
IF G-BUNDLE-FLUSH-LINES NE 0
  BUNDLES.B-FLUSH-LINES := G-BUNDLE-FLUSH-LINES
END-IF
*
BUNDLES.B-SEPNO    := G-BUNDLE-SEPNO
BUNDLES.B-SEPSTART := G-BUNDLE-SEPSTART
BUNDLES.B-SEPEND   := G-BUNDLE-SEPEND
IF G-BUNDLE-REPORT-SEPARATORS NE ' '
  BUNDLES.B-FLAG-REPSEP := G-BUNDLE-REPORT-SEPARATORS
ELSE
  BUNDLES.B-FLAG-REPSEP := 'Y'
END-IF
*
BUNDLES.B-PRINT-JOBCARD (1:3) := G-BUNDLE-JOBCARDS (1:3)
*
BUNDLES.B-COORDINATOR-ID := G-BUNDLE-COORDINATOR
IF BUNDLES.B-COORDINATOR-ID = ' '
  BUNDLES.B-COORDINATOR-ID := ##MASTER-OWNER
END-IF
*
BUNDLES.B-PRINT-LIST (*) := G-BUNDLE-PRINT-LIST (*)
IF P-BUNDLE-HOLD NE ' '
  BUNDLES.B-HOLD:= P-BUNDLE-HOLD
ELSE
  BUNDLES.B-HOLD := G-HOLD
END-IF
COMPRESS 'Created by' ##MASTER-REPNAME TO BUNDLES.B-DESC
FIND BUNDLE-DEFAULTS WITH M-MONITOR-ID = #MONIT-ID
  IF BUNDLES.B-RETENTION-PERIOD-PURGE = ' '
    BUNDLES.B-RETENTION-PERIOD-PURGE:=
      BUNDLE-DEFAULTS.B-RETENTION-PERIOD
  END-IF
  IF NOT (BUNDLES.B-PRINT-LIST(*) NE ' ')
    BUNDLES.B-PRINT-LIST(1:#DEF-PRINT-NMB):=
      BUNDLE-DEFAULTS.B-PRINT-LIST(*)
  END-IF
  IF BUNDLES.B-SEPSTART = ' '
    BUNDLES.B-SEPSTART:= BUNDLE-DEFAULTS.B-SEPSTART
  END-IF
  IF BUNDLES.B-SEPEND = ' '
    BUNDLES.B-SEPEND:= BUNDLE-DEFAULTS.B-SEPEND
  END-IF
  IF BUNDLES.B-SEPNO = 0
    BUNDLES.B-SEPNO:= BUNDLE-DEFAULTS.B-SEPNO
  END-IF
  IF BUNDLES.B-FLAG-REPSEP = ' '
    BUNDLES.B-FLAG-REPSEP:= BUNDLE-DEFAULTS.B-FLAG-REPSEP
  END-IF
  IF BUNDLES.B-HOLD = ' '
    BUNDLES.B-HOLD:= BUNDLE-DEFAULTS.B-HOLD
  END-IF
  IF NOT (BUNDLES.B-PRINT-JOBCARD(*) NE ' ')
    BUNDLES.B-PRINT-JOBCARD(1):= BUNDLE-DEFAULTS.B-JOBNAME
  END-IF
END-FIND
IF P-BUNDLE-DESCRIPTION NE ' '
  BUNDLES.B-DESC:= P-BUNDLE-DESCRIPTION
END-IF
IF P-CONTROL-EXIT-LIBRARY NE ' ' AND P-CONTROL-EXIT-MEMBER NE ' '
  BUNDLES.B-CONTROL-EXITLIB:= P-CONTROL-EXIT-LIBRARY
  BUNDLES.B-CONTROL-EXITMEM:= P-CONTROL-EXIT-MEMBER
END-IF
IF P-BUNDLE-FLUSH-REPORT (*) NE ' '
  BUNDLES.B-FLUSH-REPORTS(1:4):= P-BUNDLE-FLUSH-REPORT(*)
END-IF
IF P-BUNDLE-FLUSH-START NE ' ' AND P-BUNDLE-FLUSH-END NE ' '
    AND P-BUNDLE-FLUSH-INT NE ' '
  #SCHEDULE-IS-VALID:= TRUE
  #TEMP-TIME := P-BUNDLE-FLUSH-START
  IF #TEMP-TIME NE MASK (NNNN) OR
      NOT (#TEMP-HH = 0 THRU 23 AND #TEMP-II = 0 THRU 59)
    #SCHEDULE-IS-VALID:= FALSE
  END-IF
  #TEMP-TIME := P-BUNDLE-FLUSH-INT
  IF #TEMP-TIME NE MASK (NNNN) OR
      NOT (#TEMP-HH = 0 THRU 23 AND #TEMP-II = 0 THRU 59)
    #SCHEDULE-IS-VALID:= FALSE
  END-IF
  #TEMP-TIME := P-BUNDLE-FLUSH-END
  IF #TEMP-TIME NE MASK (NNNN) OR
      NOT (#TEMP-HH = 0 THRU 23 AND #TEMP-II = 0 THRU 59)
    #SCHEDULE-IS-VALID:= FALSE
  END-IF
  IF P-BUNDLE-FLUSH-END < P-BUNDLE-FLUSH-START
    #SCHEDULE-IS-VALID:= FALSE
  END-IF
  IF P-BUNDLE-FLUSH-DAYS (*) NE ' '
      AND P-BUNDLE-FLUSH-WEEK-DAYS (*) NE ' '
    #SCHEDULE-IS-VALID:= FALSE
  END-IF
  IF P-BUNDLE-FLUSH-WEEK-DAYS(*) NE ' '
    FOR #DI 1 TO 7
* Translate to English
      IF P-BUNDLE-FLUSH-WEEK-DAYS(#DI) = 'SO'
        P-BUNDLE-FLUSH-WEEK-DAYS(#DI):= 'SU'
      END-IF
      IF P-BUNDLE-FLUSH-WEEK-DAYS(#DI) = 'DI'
        P-BUNDLE-FLUSH-WEEK-DAYS(#DI):= 'TU'
      END-IF
      IF P-BUNDLE-FLUSH-WEEK-DAYS(#DI) = 'MI'
        P-BUNDLE-FLUSH-WEEK-DAYS(#DI):= 'WE'
      END-IF
      IF P-BUNDLE-FLUSH-WEEK-DAYS(#DI) = 'DO'
        P-BUNDLE-FLUSH-WEEK-DAYS(#DI):= 'TH'
      END-IF
      IF NOT (P-BUNDLE-FLUSH-WEEK-DAYS(#DI) = ' '
          OR P-BUNDLE-FLUSH-WEEK-DAYS(#DI) = #VALID-WEEKDAYS(1:7) )
        #SCHEDULE-IS-VALID:= FALSE
      END-IF
    END-FOR
  END-IF
  IF P-BUNDLE-FLUSH-DAYS(*) NE ' '
    FOR #DI 1 TO 30
      IF P-BUNDLE-FLUSH-DAYS(#DI) = ' ' OR = 'ALL' OR = 'LD'
        ESCAPE TOP
      END-IF
      MOVE P-BUNDLE-FLUSH-DAYS(#DI) TO #ADAY
      IF NOT(#ADAY IS (N2) )
        #SCHEDULE-IS-VALID:= FALSE
      ELSE
        #NDAY := VAL(#ADAY)
        IF NOT #NDAY = 1 THRU 31
          #SCHEDULE-IS-VALID:= FALSE
        END-IF
      END-IF
    END-FOR
  END-IF
*
  IF (P-BUNDLE-FLUSH-BEFORE-AFTER = 'A' OR = 'B')
  AND P-BUNDLE-FLUSH-CALENDAR = ' '                                   /*
    #SCHEDULE-IS-VALID:= FALSE
  END-IF
  IF NOT (P-BUNDLE-FLUSH-BEFORE-AFTER = 'A' OR = 'B' OR = ' ')
    #SCHEDULE-IS-VALID:= FALSE
  END-IF
  IF #SCHEDULE-IS-VALID
    BUNDLES.B-FLUSH-TIME-SCHEDULE    := 'Y'
    BUNDLES.B-FLUSH-START            := P-BUNDLE-FLUSH-START
    BUNDLES.B-FLUSH-END              := P-BUNDLE-FLUSH-END
    BUNDLES.B-FLUSH-INT              := P-BUNDLE-FLUSH-INT
    IF P-BUNDLE-FLUSH-DAYS(*) NE ' '
      BUNDLES.B-FLUSH-DAYS(1:31)     := P-BUNDLE-FLUSH-DAYS(*)
    ELSE
      BUNDLES.B-FLUSH-WEEK-DAYS(1:7) := P-BUNDLE-FLUSH-WEEK-DAYS(*)
    END-IF
    BUNDLES.B-FLUSH-CALENDAR         := P-BUNDLE-FLUSH-CALENDAR
    BUNDLES.B-FLUSH-BEFORE-AFTER     := P-BUNDLE-FLUSH-BEFORE-AFTER
  ELSE
    WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY-MM-DD' 'HH:II:SS.T)
      'Invalid bundle schedule specified by user-exit' ##EXITLIB
      ##EXITMEM
      / 'Start:' P-BUNDLE-FLUSH-START 'End:' P-BUNDLE-FLUSH-END
      'Int:' P-BUNDLE-FLUSH-INT 'Cal:' P-BUNDLE-FLUSH-CALENDAR
      'B/A:' P-BUNDLE-FLUSH-BEFORE-AFTER
      / 'Days:' P-BUNDLE-FLUSH-DAYS(*)
      / 'Weekdays:' P-BUNDLE-FLUSH-WEEK-DAYS(*)
  END-IF
END-IF
STORE BUNDLES
*
GRANTS.GR-OBJECT-NAME := #BUNDLE
GRANTS.GR-OBJECT-TYPE := 'B'
GRANTS.GR-OPTION(*)   := 'Y'
GRANTS.GR-USERID      := G-JOBUSERID
STORE GRANTS
*
#GR-TYPE:= 'B'
#GR-OBJECT:= #BUNDLE
FOR #GI = 1 TO 6
  IF P-BUNDLE-GRANTED-USER(#GI) = ' '
    ESCAPE BOTTOM
  END-IF
  #GR-USERID:= P-BUNDLE-GRANTED-USER(#GI)
  DUPGR. FIND NUMBER GRANTS WITH GR-SUPER = #GR-SUPER
  IF *NUMBER(DUPGR.) GT 0
    ESCAPE TOP
  END-IF
  GRANTS.GR-OBJECT-NAME := #BUNDLE
  GRANTS.GR-OBJECT-TYPE := 'B'
  GRANTS.GR-USERID:= P-BUNDLE-GRANTED-USER(#GI)
  GRANTS.GR-OPTION(1):= P-BUNDLE-GRANT-OWNER(#GI)
  GRANTS.GR-OPTION(2):= P-BUNDLE-GRANT-MODIFY(#GI)
  GRANTS.GR-OPTION(3):= P-BUNDLE-GRANT-PURGE(#GI)
  GRANTS.GR-OPTION(4):= P-BUNDLE-GRANT-DISPLAY(#GI)
  GRANTS.GR-OPTION(5):= P-BUNDLE-GRANT-ARCHIVE(#GI)
  GRANTS.GR-OPTION(6):= P-BUNDLE-GRANT-REVIVE(#GI)
  STORE GRANTS
END-FOR
END TRANSACTION
*
END-SUBROUTINE /* STORE-BUNDLE-DEFINITION
*
************************************************************************
DEFINE SUBROUTINE STORE-REPORT-IN-BUNDLE
************************************************************************
IF G-BUNDLES-SEQUENCE-NR (#FR) = 0
  BUNDLE-REPORT.BR-SEQNO := 1
ELSE
  BUNDLE-REPORT.BR-SEQNO := G-BUNDLES-SEQUENCE-NR (#FR)
END-IF
BUNDLE-REPORT.BR-REPNAME := G-REPORT
BUNDLE-REPORT.BR-REPNO := G-COPIES
BUNDLE-REPORT.BR-BUNDLE := #BUNDLE
*
IF BUNDLES.B-FLAG-REPSEP = 'Y'
  BUNDLE-REPORT.BR-SEPNO := 1
END-IF
IF BUNDLES.B-FLAG-REPSEP = 'N'
  BUNDLE-REPORT.BR-SEPNO := 0
END-IF
*
IF G-BUNDLES-GROUP (#FR) = ' '
  BUNDLE-REPORT.BR-GROUP := #BUNDLE-8
ELSE
  BUNDLE-REPORT.BR-GROUP := G-BUNDLES-GROUP (#FR)
END-IF
*
STORE BUNDLE-REPORT
*
LG-USERID  := G-LG-USERID
LG-CODE    := 'AB'
LG-BUNDLE  := BUNDLE-REPORT.BR-BUNDLE
LG-REPNAME := BUNDLE-REPORT.BR-REPNAME
COMPRESS '7013' LG-REPNAME LG-BUNDLE TO LG-MSG
COMPRESS LG-BUNDLE '/' LG-REPNAME TO LG-OBJECT-NAME
CALLNAT 'RLOG' PL-PARMS
*
END-SUBROUTINE /* STORE-REPORT-IN-BUNDLE
*
************************************************************************
DEFINE SUBROUTINE CREATE-ACTIVE-BUNDLE
************************************************************************
RESET ACTIVE-BUNDLES
*
ACTIVE-BUNDLES.AB-BUNDLE           := #AB-BUNDLE
ACTIVE-BUNDLES.AB-BUNDRNB          := #AB-BUNDRNB
ACTIVE-BUNDLES.AB-STATUS           := 'O'
ACTIVE-BUNDLES.AB-BUNDRNB-INV      :=9999999 - ACTIVE-BUNDLES.AB-BUNDRNB
ACTIVE-BUNDLES.AB-COORDINATOR-ID   := BUNDLES.B-COORDINATOR-ID
ACTIVE-BUNDLES.AB-HOLD             := BUNDLES.B-HOLD
ACTIVE-BUNDLES.AB-SEPNO            := BUNDLES.B-SEPNO
ACTIVE-BUNDLES.AB-SEPMEM           := BUNDLES.B-SEPMEM
ACTIVE-BUNDLES.AB-RETENTION-ACTION := BUNDLES.B-RETENTION-ACTION
ACTIVE-BUNDLES.AB-RETENTION-PERIOD := BUNDLES.B-RETENTION-PERIOD
ACTIVE-BUNDLES.AB-PRINT-LIST (1:20):= BUNDLES.B-PRINT-LIST (1:20)
*
IF BUNDLES.B-FLUSH-TIME-SCHEDULE = 'Y'
  #CURRENT-TIME := *TIMX
  CALLNAT 'RSCHED-N' #CURRENT-TIME BUNDLES.B-FLUSH-START
    BUNDLES.B-FLUSH-INT BUNDLES.B-FLUSH-END
    BUNDLES.B-FLUSH-WEEK-DAYS (1:7) BUNDLES.B-FLUSH-DAYS (1:30)
    BUNDLES.B-FLUSH-CALENDAR BUNDLES.B-FLUSH-BEFORE-AFTER
    ACTIVE-BUNDLES.AB-PLAN-FLUSH-TIME
ELSE
  RESET ACTIVE-BUNDLES.AB-PLAN-FLUSH-TIME
END-IF
IF G-BUNDLE-FLUSH-TIME NE T'00:00:00'
  ACTIVE-BUNDLES.AB-PLAN-FLUSH-TIME := G-BUNDLE-FLUSH-TIME
END-IF
*
ACTIVE-BUNDLES.AB-FLUSH-LINES       := BUNDLES.B-FLUSH-LINES
ACTIVE-BUNDLES.AB-PRINT-JOBCARD (*) := BUNDLES.B-PRINT-JOBCARD (*)
*
#TIMX  := *TIMX
#TIMP  := #TIMX
#OPENP := #MAX-INV-TIME - #TIMP
#OPENT := #OPENP
ACTIVE-BUNDLES.AB-OPEN-TIME := #OPENT
*
ACTIVE-BUNDLES.AB-FLUSH-REPORTS (*) := BUNDLES.B-FLUSH-REPORTS (*)
FOR #FR 1 TO BUNDLES.C*B-FLUSH-EVENTS
  IF ACTIVE-BUNDLES.AB-FLUSH-REPORTS (#FR) = G-REPORT
    ACTIVE-BUNDLES.AB-REPORT-STATUS (#FR) := '1'
    ESCAPE BOTTOM
  END-IF
END-FOR
*
ADD ACTIVE-REPORTS.AR-NUMBER-OF-LINES TO
  ACTIVE-BUNDLES.AB-NUMBER-OF-LINES
*
RESET ACTIVE-BUNDLES.AB-EXPIRATION
IF BUNDLES.B-RETENTION-PERIOD NE ' '
  #DATE-IN := *DATX
  CALLNAT 'RCOMED-N' #DATE-IN BUNDLES.B-RETENTION-PERIOD #DATE-OUT
  MOVE EDITED #DATE-OUT (EM=YYYYMMDD) TO #DATE-A
  IF #DATE-A NE '00000102'
    COMPRESS 'F' #DATE-A TO ACTIVE-BUNDLES.AB-EXPIRATION LEAVING NO
  END-IF
END-IF
*
IF BUNDLES.B-RETENTION-PERIOD-PURGE NE ' '
  ACTIVE-BUNDLES.AB-RETENTION-PERIOD :=
    BUNDLES.B-RETENTION-PERIOD-PURGE
  ACTIVE-BUNDLES.AB-RETENTION-ACTION := 'P'
ELSE
  ACTIVE-BUNDLES.AB-RETENTION-ACTION := 'F'
END-IF
*
ACTIVE-BUNDLES.AB-CONTROL-EXITLIB := BUNDLES.B-CONTROL-EXITLIB
ACTIVE-BUNDLES.AB-CONTROL-EXITMEM := BUNDLES.B-CONTROL-EXITMEM
/* copy content of GDA view to local view
MOVE BY NAME ACTIVE-BUNDLES TO ACTIVE-BUNDLES-LOC
ACTIVE-BUNDLES-LOC.AB-OBJECT-TYPE := 'AB'
ACTIVE-BUNDLES-LOC.AB-OBJECT-TIME := *TIMX
STORE-ACTIVE. STORE ACTIVE-BUNDLES-LOC
/* copy content of local view to GDA view
MOVE BY NAME ACTIVE-BUNDLES-LOC TO ACTIVE-BUNDLES /*SU4 <-
#BUNDISN := *ISN (STORE-ACTIVE.)
LG-USERID := G-LG-USERID
LG-CODE := 'AB'
COMPRESS '7012' ACTIVE-BUNDLES.AB-BUNDLE
  ACTIVE-BUNDLES.AB-BUNDRNB TO LG-MSG
LG-BUNDLE  := ACTIVE-BUNDLES.AB-BUNDLE
LG-BUNDRNB := ACTIVE-BUNDLES.AB-BUNDRNB
COMPRESS ACTIVE-BUNDLES.AB-BUNDLE '/' ACTIVE-BUNDLES.AB-BUNDRNB
  TO LG-OBJECT-NAME LEAVING NO
CALLNAT 'RLOG' PL-PARMS
*
END-SUBROUTINE /* CREATE-ACTIVE-BUNDLE
*
************************************************************************
DEFINE SUBROUTINE UPDATE-ACTIVE-BUNDLE
************************************************************************
RESET RACTLF-ERROR-LOGGING RACTLF-LOGGING #ADA-RC
RACTLF-LFILE-1   := 91
CALLNAT 'RACTLF-N' RACTLF-PARMS
IF RACTLF-ERROR-CODE = 0
  CALLNAT 'GETHOLD' RACTLF-DBID-1 RACTLF-FNR-1 #BUNDISN 'BS' #ADA-RC
END-IF
IF #ADA-RC = 145
  G-NATRP-ERC := 145
  GET ACTIVE-BUNDLES #BUNDISN
ELSE
  GET-ACT-BUND. GET ACTIVE-BUNDLES #BUNDISN
  FOR #FR 1 TO ACTIVE-BUNDLES.C*AB-FLUSH-EVENTS
    IF ACTIVE-BUNDLES.AB-FLUSH-REPORTS(#FR) = ACTIVE-REPORTS.AR-REPNAME
      ACTIVE-BUNDLES.AB-REPORT-STATUS(#FR) := '1'
      ESCAPE BOTTOM
    END-IF
  END-FOR
  IF ACTIVE-REPORTS.AR-NUMBER-OF-LINES < 99999999 /* P302081 in
    ADD ACTIVE-REPORTS.AR-NUMBER-OF-LINES TO
      ACTIVE-BUNDLES.AB-NUMBER-OF-LINES
  END-IF                                          /* P302081 in
  UPDATE (GET-ACT-BUND.)
END-IF
*
END-SUBROUTINE /* UPDATE-ACTIVE-BUNDLE
*
************************************************************************
DEFINE SUBROUTINE STORE-REPORT-IN-ACTIVE-BUNDLE
************************************************************************
BC-VISTA.BC-OBJECT-TYPE := 'BC' /*SU3
BC-VISTA.BC-OBJECT-TIME := *TIMX /*SU3
STORE-CONTENTS. STORE BC-VISTA
BC-GET. GET BUNDLE-CONTENTS *ISN(STORE-CONTENTS.)
BUNDLE-CONTENTS.BC-REPNAME := ACTIVE-REPORTS.AR-REPNAME
BUNDLE-CONTENTS.BC-REPRNB  := G-REPRNB
BUNDLE-CONTENTS.BC-BUNDLE  := #AB-BUNDLE
BUNDLE-CONTENTS.BC-BUNDRNB := ACTIVE-BUNDLES.AB-BUNDRNB
*
IF BUNDLE-REPORT.BR-GROUP = ' '
  #BR-BUNDLE-8 := BUNDLE-REPORT.BR-BUNDLE
  BUNDLE-REPORT.BR-GROUP := #BR-BUNDLE-8
END-IF
*
IF BUNDLE-REPORT.BR-SEQNO = 0
  BUNDLE-REPORT.BR-SEQNO := 1
END-IF
*
BUNDLE-CONTENTS.BC-GROUP := BUNDLE-REPORT.BR-GROUP
BUNDLE-CONTENTS.BC-SEQNO := BUNDLE-REPORT.BR-SEQNO
BUNDLE-CONTENTS.BC-SEPNO := BUNDLE-REPORT.BR-SEPNO
IF BUNDLES.B-FLAG-REPSEP = 'N'
  RESET BUNDLE-CONTENTS.BC-SEPNO
END-IF
BUNDLE-CONTENTS.BC-REPNO   := BUNDLE-REPORT.BR-REPNO
BUNDLE-CONTENTS.BC-SEPMEM  := ACTIVE-REPORTS.AR-SEPMEM
BUNDLE-CONTENTS.BC-PRINTER := BUNDLE-REPORT.BR-PRINTER
*
BUNDLE-CONTENTS.BC-PAGEDEF := BUNDLE-REPORT.BR-PAGEDEF
BUNDLE-CONTENTS.BC-FORMDEF := BUNDLE-REPORT.BR-FORMDEF
*
#SPOOL-ATTRIBUTES := RMEX-SPOOL-ATTRIBUTES /*SU7 G-SPOOL-ATTRIBUTES
CALLNAT 'RMSPL7-N' #SPOOL-ATTRIBUTES #SPOOL-TYPE
*
DECIDE ON FIRST #SPOOL-TYPE
  VALUE JES2, JES3
    IF BUNDLE-CONTENTS.BC-REPNO = 0
      BUNDLE-CONTENTS.BC-REPNO := #SPOOL-JES-COPIES
    END-IF
    BUNDLE-CONTENTS.BC-CHARS   := #SPOOL-JES-CHARS
    BUNDLE-CONTENTS.BC-FCB     := #SPOOL-JES-FCB
    BUNDLE-CONTENTS.BC-FORM    := #SPOOL-JES-FORM
    BUNDLE-CONTENTS.BC-FLASH   := #SPOOL-JES-FLASH
    IF #SPOOL-JES-PAGEDEF NE ' '
      BUNDLE-CONTENTS.BC-PAGEDEF := #SPOOL-JES-PAGEDEF
    END-IF
    IF #SPOOL-JES-FORMDEF NE ' '
      BUNDLE-CONTENTS.BC-FORMDEF := #SPOOL-JES-FORMDEF
    END-IF
/*SU8  VALUE POWER
  VALUE SEQUENTIAL-FILE-BS2
    IF BUNDLE-CONTENTS.BC-REPNO = 0
      BUNDLE-CONTENTS.BC-REPNO := #SPOOL-BS2-COPIES
    END-IF
    BUNDLE-CONTENTS.BC-FORM := #SPOOL-BS2-FORM
  VALUE CMASPOOL
    IF BUNDLE-CONTENTS.BC-REPNO = 0
      BUNDLE-CONTENTS.BC-REPNO := #SPOOL-CMA-COPYS
    END-IF
    BUNDLE-CONTENTS.BC-FORM    := #SPOOL-CMA-FORMS
    BUNDLE-CONTENTS.BC-FCB     := #SPOOL-CMA-FCB
    BUNDLE-CONTENTS.BC-PAGEDEF := #SPOOL-CMA-PAGED
    BUNDLE-CONTENTS.BC-FORMDEF := #SPOOL-CMA-FORMD
  VALUE NAF, NAT
    IF BUNDLE-CONTENTS.BC-REPNO = 0
      BUNDLE-CONTENTS.BC-REPNO := #SPOOL-NAF-COPIES
    END-IF
    BUNDLE-CONTENTS.BC-FORM    := #SPOOL-NAF-FORM
  NONE VALUE
    IGNORE
END-DECIDE
*
BUNDLE-CONTENTS.BC-NUMBER-OF-LINES := ACTIVE-REPORTS.AR-NUMBER-OF-LINES
UPDATE (BC-GET.)
PERFORM LOG-BUNDLED-REPORT
*
END-SUBROUTINE /* STORE-REPORT-IN-ACTIVE-BUNDLE
*
************************************************************************
DEFINE SUBROUTINE LOG-BUNDLED-REPORT
************************************************************************
LG-USERID := G-LG-USERID
IF #REVIVE
  LG-CODE:= 'MO'
ELSE
  LG-CODE := 'AB'
END-IF
LG-BUNDLE  := BUNDLE-CONTENTS.BC-BUNDLE
LG-BUNDRNB := BUNDLE-CONTENTS.BC-BUNDRNB
LG-REPNAME := BUNDLE-CONTENTS.BC-REPNAME
LG-REPRNB  := BUNDLE-CONTENTS.BC-REPRNB
*
COMPRESS LG-REPNAME '/' LG-REPRNB TO LG-MSG LEAVING NO
COMPRESS LG-BUNDLE '/' LG-BUNDRNB TO LG-OBJECT-NAME LEAVING NO
COMPRESS '7014' LG-MSG LG-OBJECT-NAME TO LG-MSG
CALLNAT 'RLOG' PL-PARMS
*
END-SUBROUTINE /* LOG-BUNDLED-REPORT
*
END-SUBROUTINE /* SEND-TO-BUNDLE
*
END
