* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
** Subprogram  NOOPT--N
** Version     2.2.1
** Function    add array of options to existing array of options
**
** Maintenance:
** XSETGGR 2001-11-21   created
**-------------------------------------------------------------------
DEFINE DATA PARAMETER
1 #NEW-OPTIONS (A2/8)        /*  in: array need to exist
1 #OPTIONS     (A2/10)       /* in:existing array, out: result array
LOCAL
1 #I           (I2)
1 #J           (I2)
1 #K           (I2)
1 #N           (I2)
END-DEFINE
* ----------------------------------------------------------------------
FOR #I = 1 TO 8
  IF #NEW-OPTIONS(#I) > ' '
    EXAMINE #OPTIONS(*) FOR #NEW-OPTIONS(#I) GIVING INDEX IN #J
    IF #J = 0              /* options already exists
      EXAMINE FULL #OPTIONS(*) FOR '  ' GIVING INDEX IN #K
      IF #K > 0
        #OPTIONS(#K) := #NEW-OPTIONS(#I)
      ELSE
        EXAMINE #OPTIONS(*) FOR 'LX' GIVING INDEX IN #N
        IF #N > 0
          #OPTIONS(#N) := #NEW-OPTIONS(#I)
        END-IF
      END-IF
    END-IF
  END-IF
END-FOR
END

