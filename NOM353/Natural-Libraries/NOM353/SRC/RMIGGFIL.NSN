* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RMIGGFIL
*
* get physical DBID and File-Number for logical file 186
*
* jwo 97-09-18 p(164220) Replace Call 'CMMPP' with NAT00028
*                        Rewritten
* jvd 98-09-10 p(164220) NOM141ÖNAT23
* ------------------------------------------------
DEFINE DATA
PARAMETER
1 P-RC          (I4)   /* OUT
1 P-OLD-DBID    (P5)   /* OUT
1 P-OLD-FNR     (P5)   /* OUT
*
LOCAL USING NRM-028L     /* parameters for NAT00028
*
END-DEFINE
* ------------------------------------------------
RESET P-RC P-OLD-DBID P-OLD-FNR
*
* -- GET THE OLD LFILE SETTING --
*
* jwo 97-09-18 p(164220) start
LFILE := 158
*
CALLNAT 'NAT00028' PARM-NAT00028     /* get phys. file number
*
P-RC  := RESPONSE
IF P-RC NE 0
   ESCAPE ROUTINE
END-IF
*
MOVE PHYSICAL-DBID TO P-OLD-DBID
MOVE PHYSICAL-FNR  TO P-OLD-FNR
*
END
