* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* ----------------------------------------------------------------------
* Member    XXXML-T
* Version   3.3
* Function  Test XML file converter
*
* Description:
*
* Generates 20 lines of text, assigns a tag name for each line and
* and writes the result as an XML file to work file 1.
*
* ----------------------------------------------------------------------
*
* Maintenance
* -----------
* uuuuuu yyyy-mm-dd P999999 Remark
* fhi    2011-10-13         Created.
* ----------------------------------------------------------------------
DEFINE DATA
LOCAL
1 #FCT    (A1)
1 #ARRAY  (A50/20)
1 #TAGS   (A20/20)
1 #LEVEL  (N2)
1 #STRING (A) DYNAMIC
1 #GROUP  (A20) INIT <'document'>
1 #I      (I4)
END-DEFINE
DEFINE WORK FILE 1 TYPE 'UNFORMATTED'
FOR #I = 1 TO 20
  COMPRESS 'This is text line' #I TO #ARRAY (#I)
  COMPRESS 'tag' #I               TO #TAGS (#I) LEAVING NO
END-FOR
#FCT := 'F'
CALLNAT 'XXXML-N' #FCT #ARRAY (*) #TAGS (*) #GROUP #LEVEL #STRING
WRITE WORK FILE 1 VARIABLE #STRING
#FCT   := 'G'
#LEVEL := 3
CALLNAT 'XXXML-N' #FCT #ARRAY (*) #TAGS (*) #GROUP #LEVEL #STRING
WRITE WORK FILE 1 VARIABLE #STRING
*
END
