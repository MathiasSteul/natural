* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    RMB2RE-N
* Function  Rename dsname for a BS2000 spool file
*
* Version   1.3
*
* Maintenance
* uuu     yyyy-mm-dd s(999999) ...
* mrs     1995-10-10 s(999999) created
* fhi     2000-08-24 QA03      Use NAT23006 for error values
* xsetggr 2007-05-02 NOM3201   support 5 byte node numbers
* fhi     2007-07-12 NOM3202   C-NATERR changed, NAD23006 is obsolete.
* fhi     2010-09-03 NOMALL-97 Extend message line
* fhi     2010-09-21 NOMALL-97 Use no more C-NATERR but C-NATERN instead
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 RMB2RE-NODE         (N5)
1 RMB2RE-DSNAME       (A54)
1 RMB2RE-NEW-DSNAME   (A54)
1 RMB2RE-ERROR-CODE   (N4)
1 RMB2RE-ERROR-TEXT   (A250) /* NOMALL-97 was (A70)
************************************************************************
LOCAL
1 VTOC-UPDATE VIEW OF VTOC-UPDATE
  2 ERROR-CODE
  2 ERROR-TEXT
  2 REDEFINE ERROR-TEXT
    3 ERROR-PREFIX    (A7)
    3 ERROR-FIL       (A1)
    3 ERROR-TXT       (A49)
  2 SYSTEM-MESSAGE-CODE
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RENAME. FIND VTOC-UPDATE WITH NODE = RMB2RE-NODE AND FUNCTION = 'RENAME'
    AND DSNAME   = RMB2RE-DSNAME AND NEWNAME  = RMB2RE-NEW-DSNAME
  IF ERROR-CODE NE 0
    RMB2RE-ERROR-CODE := 5000 + ERROR-CODE (RENAME.)
    COMPRESS ERROR-PREFIX (RENAME.) '(' SYSTEM-MESSAGE-CODE (RENAME.)
      ')' ERROR-TXT (RENAME.) TO RMB2RE-ERROR-TEXT
  END-IF
*
END-FIND
*
************************************************************************
ON ERROR
************************************************************************
  CALLNAT 'C-NATERN' RMB2RE-ERROR-TEXT
  RMB2RE-ERROR-CODE := 21
  ESCAPE ROUTINE
END-ERROR
*
END
