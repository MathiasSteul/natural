* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* NOMTDIFF - Get the inverse time value for comparing active reports
*
*  Maintenance
*  User ID   yyyy-mm-dd Issue         Remark
* --------------------------------------------------------------------- --------
*  fhi       2010-11-23               Created.
*  fhi       2015-05-04               Adapted to NOM 3.4.3
*  fhi       2019-05-13 NOMALL-2272   Correct eval. of time inverted
************************************* data **************************** ********
DEFINE DATA
LOCAL USING CONST-L
LOCAL
1 #INPUT-TIME     (A10)
1 #TIME           (T)
1 REDEFINE #TIME
  2 #TIME-P       (P13)
1 REDEFINE #TIME
  2 #TIME-B       (B7)
1 #TIME-MAX       (P13)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#TIME-MAX := #CONST-INV-TIME
SET KEY ALL
SET CONTROL 'N'
WRITE ' '
REPEAT UNTIL *PF-KEY NE 'ENTR'
  INPUT NO ERASE
    '********************** NOM Time Difference ***********************'
    / / / 'Please enter date to be converted (End=PF3),' /
    'format is ''YYYY-MM-DD'':'
    #INPUT-TIME (AD=MILT'_')
  SET CONTROL 'N'
  IF #INPUT-TIME = MASK (YYYY'-'MM'-'DD)
    MOVE EDITED #INPUT-TIME TO #TIME (EM=YYYY'-'MM'-'DD)
    WRITE NOTITLE NOHDR ///////
      'Numeric  date value is:' #TIME-P '- hex:' #TIME-B
      (EM=H-H-H-H-H-H-H) / /
    #TIME-P := #TIME-MAX - #TIME-P
    WRITE NOTITLE NOHDR
      'Inverted date value is:' #TIME-P '- hex:' #TIME-B
      (EM=H-H-H-H-H-H-H)
  ELSE
    WRITE NOTITLE NOHDR ///////
      'Please enter a correct date.'
  END-IF
END-REPEAT
*
END
