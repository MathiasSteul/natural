  2 HOME-PHONE-COUNTRY   (N2)
  2 HOME-PHONE           (A15)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
IF *OCC(B64-TEXT-ARRAY) = 0
  EXPAND ARRAY B64-TEXT-ARRAY TO (1:5)
END-IF
IF NOT #SAVE
  IF #TAG-CURRENT = #TAG-OLD
    ADD 1 TO #IND
  ELSE
    #IND := 1
  END-IF
  IF #VALUE-CURRENT = ' '
    ESCAPE MODULE
  END-IF
  DECIDE ON FIRST VALUE OF #TAG-CURRENT
    VALUE 'US-OBJECT-TYPE'
      US-FILL.US-OBJECT-TYPE := #VALUE-CURRENT
    VALUE 'US-OBJECT-TIME'
      MOVE EDITED #VALUE-CURRENT TO US-FILL.US-OBJECT-TIME
        (EM=YYYY'-'MM'-'DD'-'HH':'II':'SS'.'T)
    VALUE 'US-LAST-UPDATE'
      MOVE EDITED #VALUE-CURRENT TO US-FILL.US-LAST-UPDATE
        (EM=YYYY'-'MM'-'DD'-'HH':'II':'SS'.'T)
    VALUE 'US-LAST-UPDATE-USER'
      US-FILL.US-LAST-UPDATE-USER := #VALUE-CURRENT
    VALUE 'USER-ID'
      US-FILL.USER-ID := #VALUE-CURRENT
    VALUE 'USER-PASSWORD'
      US-FILL.USER-PASSWORD := #VALUE-CURRENT
    VALUE 'USER-PROFILE'
      US-FILL.USER-PROFILE := #VALUE-CURRENT
    VALUE 'MR-MRS'
      US-FILL.MR-MRS := #VALUE-CURRENT
    VALUE 'LAST-NAME'
      US-FILL.LAST-NAME := #VALUE-CURRENT
    VALUE 'FIRST-NAME'
      US-FILL.FIRST-NAME := #VALUE-CURRENT
    VALUE 'INITIAL'
      US-FILL.INITIAL := #VALUE-CURRENT
    VALUE 'WORK-TITLE'
      US-FILL.WORK-TITLE := #VALUE-CURRENT
    VALUE 'WORK-ORGANIZATION'
      US-FILL.WORK-ORGANIZATION := #VALUE-CURRENT
    VALUE 'WORK-LOCATION'
      US-FILL.WORK-LOCATION := #VALUE-CURRENT
    VALUE 'WORK-DEPT-NAME'
      US-FILL.WORK-DEPT-NAME := #VALUE-CURRENT
    VALUE 'WORK-DEPT-NUM'
      US-FILL.WORK-DEPT-NUM := #VALUE-CURRENT
    VALUE 'WORK-ADDRESS'
      US-FILL.WORK-ADDRESS (#IND) := #VALUE-CURRENT
    VALUE 'WORK-CITY'
      US-FILL.WORK-CITY := #VALUE-CURRENT
    VALUE 'WORK-STATE-PROV'
      US-FILL.WORK-STATE-PROV := #VALUE-CURRENT
    VALUE 'WORK-POSTAL-CODE'
      US-FILL.WORK-POSTAL-CODE := #VALUE-CURRENT
    VALUE 'WORK-COUNTRY'
      US-FILL.WORK-COUNTRY := #VALUE-CURRENT
    VALUE 'WORK-PHONE-COUNTRY'
      IF #VALUE-CURRENT IS (N2)
        US-FILL.WORK-PHONE-COUNTRY := VAL (#VALUE-CURRENT)
      ELSE
        #MSG := 'WORK-PHONE-COUNTRY'
        PERFORM FIELD-IGNORED /*RMIMP-C1
      END-IF
    VALUE 'WORK-PHONE'
      US-FILL.WORK-PHONE := #VALUE-CURRENT
    VALUE 'WORK-PHONE-EXT'
      US-FILL.WORK-PHONE-EXT := #VALUE-CURRENT
    VALUE 'HOME-ADDRESS'
      US-FILL.HOME-ADDRESS (#IND) := #VALUE-CURRENT
    VALUE 'HOME-CITY'
      US-FILL.HOME-CITY := #VALUE-CURRENT
    VALUE 'HOME-STATE-PROV'
      US-FILL.HOME-STATE-PROV := #VALUE-CURRENT
    VALUE 'HOME-POSTAL-CODE'
      US-FILL.HOME-POSTAL-CODE := #VALUE-CURRENT
    VALUE 'HOME-COUNTRY'
      US-FILL.HOME-COUNTRY := #VALUE-CURRENT
    VALUE 'HOME-PHONE-COUNTRY'
      IF #VALUE-CURRENT IS (N2)
        US-FILL.HOME-PHONE-COUNTRY := VAL (#VALUE-CURRENT)
      ELSE
        #MSG := 'HOME-PHONE-COUNTRY'
        PERFORM FIELD-IGNORED /*RMIMP-C1
      END-IF
    VALUE 'HOME-PHONE'
      US-FILL.HOME-PHONE := #VALUE-CURRENT
    NONE IGNORE
  END-DECIDE
ELSE
  #OBJ-NAME := US-FILL.USER-ID
  OBJ. FIND (1) US WITH USER-ID = US-FILL.USER-ID /*SU4 was #KEY
    IF NO RECORDS FOUND
      MOVE BY NAME US-FILL TO US
      STORE US
      PERFORM ADD-LOADED
      ESCAPE BOTTOM (OBJ.)
    END-NOREC
    MOVE BY NAME US-FILL TO US
    IF #REPL = 'Y'
      UPDATE (OBJ.)
      PERFORM ADD-REPLACED
    ELSE
      COMPRESS US-FILL.USER-ID 'not replaced for US' TO #MSG /*SU4:#KEY
      PERFORM XXRLOG-WRITE-LOG 'W' #MSG
      PERFORM ADD-NOT-REPLACED
    END-IF
  END-FIND
  END TRANSACTION
END-IF
*
INCLUDE RMIMP-C1
*
END
