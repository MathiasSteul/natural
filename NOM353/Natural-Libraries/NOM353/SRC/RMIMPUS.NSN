LOCAL
1 US VIEW OF NRM-USERS /*SU6 was RMIMPUSL
  2 US-OBJECT-TYPE       (A10)
  2 US-OBJECT-TIME       (T)
  2 US-LAST-UPDATE       (T)
  2 US-LAST-UPDATE-USER  (A16)
