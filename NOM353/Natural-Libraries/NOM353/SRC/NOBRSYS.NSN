  END-IF
  IF I >= #EX-BNUM
    ESCAPE BOTTOM
  END-IF
END-FIND
*
END-SUBROUTINE /* GET-SYSOUT-LINES-FBS2
*
************************************************************************
DEFINE SUBROUTINE GET-SYSOUT-LINES-NOMDB
************************************************************************
#SOURCE-ATTRIBUTES     := SOURCE.SR-ATTRIBUTES-IDENT
#NSMCOMP-BUFFER-LENGTH := 16381 - 7
#NSMCOMP-CODE          := 'N' /* 'N' - NEW PARM LIST
#NSMCOMP-COMMAND       := 'D'
*
#ST-ID   := #NOMDB-ID
#ST-LINE := #ST-START-LINE := #FR (#K)
RESET LINE-FOUND
*
IF SOURCE-TEXT.ST-LINE-START > 0
AND #FR (#K) = SOURCE-TEXT.ST-LINE-START THRU SOURCE-TEXT.ST-LINE-END /*
  READ-BUFFER := FALSE
ELSE
  READ-BUFFER := TRUE
END-IF
*
REAST. REPEAT
  IF READ-BUFFER
    READ-SOURCE. READ (1) SOURCE-TEXT BY ST-ID-LINE = #ST-ID-LINE
      IF ST-ID NE #ST-ID
        IF NOT LINE-FOUND
          EX-ECODE := 9999
          EX-UDATA := 'Start Line not found'
        END-IF
        ESCAPE BOTTOM (REAST.)
      END-IF
    END-READ
    IF *COUNTER (READ-SOURCE.) = 0
      IF NOT LINE-FOUND
        EX-ECODE := 9999
        EX-UDATA := 'Start Line not found'
      END-IF
      ESCAPE BOTTOM (REAST.)
    END-IF
  END-IF
*
  READ-BUFFER := TRUE
  RESET #NSMCOMP-WORK
  #ST-RECORD-NUMBER := SOURCE-TEXT.ST-LINE-START
  SUBTRACT 1 FROM #ST-RECORD-NUMBER
*
  REP. REPEAT
    RESET #NSMCOMP-LINE
    INCLUDE C-NSMCMP '#ST-TEXT-BUFFER-LOB'
    DECIDE ON FIRST #NSMCOMP-RC
      VALUE 0
        IGNORE
      VALUE 4
        IF NOT LINE-FOUND
          EX-ECODE := 9999
          EX-UDATA := 'Start Line not found'
          ESCAPE BOTTOM (REAST.)
        END-IF
        #ST-LINE := #ST-RECORD-NUMBER + 1
        ESCAPE BOTTOM (REP.)
      NONE
        EX-ECODE := 9999
        COMPRESS 'Decompression Error rc=' #NSMCOMP-RC TO EX-UDATA
        ESCAPE BOTTOM (REAST.)
    END-DECIDE
*
    ADD 1 TO #ST-RECORD-NUMBER
    IF NOT LINE-FOUND
      IF #ST-RECORD-NUMBER < #ST-START-LINE
        ESCAPE TOP
      END-IF
      LINE-FOUND := TRUE
    END-IF
*
    IF #ST-RECORD-NUMBER > #TR(#K)
      ESCAPE BOTTOM (REAST.)
    END-IF
*
    ADD 1 TO I
    O-RECORD := #NSMCOMP-LINE
*
    IF EX-REQ = 'S'
      #RECORD-NUMBER := #BASE-LINE + (#ST-RECORD-NUMBER - #AC-FROM-LINE)
    END-IF
*
    IF #TIMEOUT-CONTROL
      PERFORM CHECK-TIMEOUT
      IF #TIMEOUT-OCCURS
        ESCAPE BOTTOM (REAST.)
      END-IF
    END-IF
*
    PERFORM BUILD-RECORD
*
    IF EX-REQ = 'G' OR (EX-REQ = 'S' AND #STRING-FOUND)
      #NSMCOMP-LINE := O-RECORD
      ADD 1 TO #LINE-NUMBER
      IF #LINE-NUMBER LE #LINES-IN-TABLE
        P-LINES(#LINE-NUMBER):= #NSMCOMP-LINE
      END-IF
      K := R-DISP
      L := R-LEN
      ADD L TO K
      R-DISP := K
    END-IF
*
    IF EX-REQ = 'S ' AND #STRING-FOUND
      ESCAPE ROUTINE
    END-IF
*
    IF I >= #EX-BNUM
      ESCAPE BOTTOM (REAST.)
    END-IF
  END-REPEAT
END-REPEAT
*
END-SUBROUTINE /* GET-SYSOUT-LINES-NOMDB
*
************************************************************************
DEFINE SUBROUTINE GET-INSERTED-LINES
************************************************************************
IF #FR(#K) = 0
  #FR(#K) := 1
END-IF
*
FOR #W = #FR(#K)  TO #TR(#K)
  IF #TIMEOUT-CONTROL
    PERFORM CHECK-TIMEOUT
    IF #TIMEOUT-OCCURS
      ESCAPE BOTTOM
    END-IF
  END-IF
*
  ADD 1 TO I
  ADD 1 TO #RECORD-NUMBER
  O-RECORD := REPORT-CONTENTS.AC-INSERTED-LINE(#W)
*
  PERFORM BUILD-RECORD
  IF EX-REQ = 'G' OR (EX-REQ = 'S' AND #STRING-FOUND)
    REPORT-CONTENTS.AC-INSERTED-LINE(#W) := O-RECORD
    ADD 1 TO #LINE-NUMBER
    P-LINES(#LINE-NUMBER):= REPORT-CONTENTS.AC-INSERTED-LINE(#W)
    K := R-DISP
    L := R-LEN
    ADD L TO K
    R-DISP := K
  END-IF
*
  IF EX-REQ = 'S' AND #STRING-FOUND
    ESCAPE ROUTINE
  END-IF
*
  IF I >= #EX-BNUM
    ESCAPE BOTTOM
  END-IF
END-FOR
*
END-SUBROUTINE /* GET-INSERTED-LINES
*
************************************************************************
DEFINE SUBROUTINE CHECK-TIMEOUT
************************************************************************
RESET #TIMEOUT-OCCURS
*
IF *TIMX > #TIMEOUT
  #TIMEOUT-OCCURS     := TRUE
  RESET P-CLIENT-TIMEOUT            /* to call browser repeateedly
  #BREAK-LINE-NUMBER  := #RECORD-NUMBER
  ES-NEXT-KEY-PARM(1) := #BREAK-LINE-NUMBER-A
  #BREAK-SEQNO        := #SEQNO
  ES-NEXT-KEY-PARM(2) := #BREAK-SEQNO-A
  #EX-UDATA           := EX-UDATA
  ES-NEXT-KEY-PARM(3) := #EX-UDATA1
  IF #EX-UDATA2 > ' '
    ES-NEXT-KEY-PARM(4) := #EX-UDATA2
  END-IF
END-IF
*
END-SUBROUTINE /* CHECK-TIMEOUT
*
************************************************************************
DEFINE SUBROUTINE BUILD-RECORD
************************************************************************
#LEN1 := 251 - #EX-SCOL + 1
IF (O-RECORD-V (1) = '1'   AND SOURCE.SR-CC-TYPE = ASA-CODE)
OR (O-RECORD-V (1) = H'89' AND SOURCE.SR-CC-TYPE = MACHINE-CODE)      /*
OR (O-RECORD-V (1) = H'8B' AND SOURCE.SR-CC-TYPE = MACHINE-CODE)      /*
OR (O-RECORD-V (1) = H'81' AND SOURCE.SR-CC-TYPE = BS2000-CC)         /*
OR (O-RECORD-V (1) = 'A'   AND SOURCE.SR-CC-TYPE = BS2000-CC)         /*
  #HEADNO := 1
  SW-NP := TRUE
ELSE
  IF SW-NP
    ADD 1 TO #HEADNO
  END-IF
END-IF
IF EX-NRM-ASA-CODE-ON = 'N'
  RESET O-RECORD-V (1)
END-IF
*
IF EX-NRM-FCOL (1) = H'00'
OR (EX-NRM-HEAD NE 0 AND #HEADNO = 1 THRU EX-NRM-HEAD)                /*
  IF EX-NRM-ASA-CODE-ON NE 'F' OR EX-NRM-SOURCE-CC-TYPE = NO-CC
    I-RECORD := O-RECORD
  ELSE
    I-RECORD-V (2:251) := O-RECORD-V (1:250)
    RESET I-RECORD-V (1)
  END-IF
  RESET O-RECORD
  O-RECORD-V (1 : #LEN1) := I-RECORD-V (#EX-SCOL : 251)
  PERFORM SCAN-CHECK
  ESCAPE ROUTINE
END-IF
IF EX-NRM-SOURCE-CC-TYPE = NO-CC
  #OPOS := 1
ELSE
  #OPOS := 2
END-IF
IF EX-NRM-ASA-CODE-ON NE 'F'
  I-RECORD-V (1:250) := O-RECORD-V (2:251)
  RESET I-RECORD-V (251) O-RECORD-V (2:251)
ELSE
  I-RECORD := O-RECORD
  RESET  O-RECORD
END-IF
*
FOR #N 1 TO 10
  IF EX-NRM-FCOL (#N) = H'00'
    ESCAPE BOTTOM
  END-IF
  #FROM-COL := EX-NRM-FCOL (#N)
  #TO-COL := EX-NRM-TCOL (#N)
  #LEN := #TO-COL - #FROM-COL
  O-RECORD-V (#OPOS:#OPOS + #LEN) := I-RECORD-V (#FROM-COL:#TO-COL)
  #OPOS := #OPOS + #LEN + 2
END-FOR
I-RECORD := O-RECORD
RESET O-RECORD
O-RECORD-V (1:#LEN1) := I-RECORD-V (#EX-SCOL:251)
PERFORM SCAN-CHECK
*
END-SUBROUTINE /* BUILD-RECORD
*
************************************************************************
DEFINE SUBROUTINE SCAN-CHECK
************************************************************************
IF EX-REQ = 'S'
  EXAMINE O-RECORD TRANSLATE INTO UPPER CASE
  EXAMINE O-RECORD FOR EX-UDATA GIVING NUMBER IN #NUM
  IF #NUM > 0
    #STRING-FOUND := TRUE
    EX-RTOP := #RECORD-NUMBER
  ELSE
    IF #RECORD-NUMBER >= #EX-RMAX-R
      EX-STYPE := 'L'
      #SCAN-LIMIT-REACHED := TRUE
    END-IF
  END-IF
END-IF
*
END-SUBROUTINE /* SCAN-CHECK
*
************************************************************************
DEFINE SUBROUTINE BUILD-SEARCH
************************************************************************
#SOURCE-ATTRIBUTES := SOURCE.SR-ATTRIBUTES-IDENT
CALLNAT 'RMSR7--N' #SOURCE-ATTRIBUTES SR-TYPE
IF EX-REQ = 'S'
  #SEARCH-STRING := EX-UDATA
  #SCAN-TYPE     := 'A'
  #SCAN          := 'YES'
ELSE
  #SEARCH-STRING := '*'
  #SCAN          := 'NO'
  RESET #SCAN-TYPE
END-IF
IF #SCAN-LIMIT GT 9999999
  #SCAN-LIMIT:= 0
END-IF
*
END-SUBROUTINE /* BUILD-SEARCH
*
END
