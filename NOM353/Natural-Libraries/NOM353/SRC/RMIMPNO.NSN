DEFINE DATA
PARAMETER USING RMIMP-A
PARAMETER
1 NO-FILL /*SU3: M- -> MF-
  2 MF-REMOTE-CODEPAGE         (A64)
  2 MF-PRODUCT-NAME            (A16)
  2 MF-INTERNAL-NODE-ID        (P11)
  2 MF-LAST-UPDATE             (T)
  2 MF-LAST-UPDATE-USER        (A16)
  2 MF-EMAIL-RECIPIENTS        (A250/1:2)
  2 MF-TYPE                    (A1)
  2 MF-NPR-USERID              (A8)
  2 MF-TIME-SCHEDULE           (A1)
  2 MF-MONITOR-DESCRIPTION     (A50)
  2 MF-SPOOL-TYPE              (A8)
  2 MF-SYSTEM-TYPE             (A8)
  2 MF-MONITOR-ID              (A20)
  2 MF-STATUS                  (B1)
  2 MF-MONITOR-NODE            (N5)
  2 MF-TEMP-CLASS              (A4)
  2 MF-PRINT-CLASS             (A1)
  2 MF-CLASSES                 (A1/1:20)
  2 MF-JES3-OUTPUT-CLASSES     (A1/1:20)
  2 MF-BS2-DEST                (A8/1:4)
