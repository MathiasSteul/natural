LOCAL USING RMIMP-L /*SU4
LOCAL USING RMBAS64P
/*SU5 LOCAL USING RMIMPNOL  /* NOMALL-2215 fhi in
*
LOCAL
1 NO VIEW OF NRM-MF-NODES /*SU5 was RMIMPNOL
  2 MF-REMOTE-CODEPAGE     (A64)
  2 MF-PRODUCT-NAME        (A16)
  2 MF-INTERNAL-NODE-ID    (P11)
  2 MF-LAST-UPDATE         (T)
  2 MF-LAST-UPDATE-USER    (A16)
  2 MF-TYPE                (A1)
  2 MF-NPR-USERID          (A8)
  2 MF-TIME-SCHEDULE       (A1)
  2 MF-MONITOR-DESCRIPTION (A50)
  2 MF-SPOOL-TYPE          (A8)
  2 MF-SYSTEM-TYPE         (A8)
  2 MF-MONITOR-ID          (A20)
  2 MF-MONITOR-NODE        (N5)
  2 MF-TEMP-CLASS          (A4)
  2 MF-PRINT-CLASS         (A1)
  2 MF-CLASSES             (A1/1:20)
  2 MF-JES3-OUTPUT-CLASSES (A1/1:20)
  2 MF-BS2-DEST            (A8/1:4)
  2 MF-ERR-CLASS           (A1)
1 #A16-FF                  (A16) /*SU6
1 #FF8                     (A8) CONST FULL LENGTH <H'FF'> /*SU6
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
MOVE EDITED #FF8 (EM=H(8)) TO #A16-FF /*SU6
IF *OCC(B64-TEXT-ARRAY) = 0
  EXPAND ARRAY B64-TEXT-ARRAY TO (1:5)
END-IF
IF NOT #SAVE
  IF #TAG-CURRENT = #TAG-OLD
    ADD 1 TO #IND
  ELSE
    #IND := 1
  END-IF
  IF #VALUE-CURRENT = ' '
    ESCAPE MODULE
  END-IF
  DECIDE ON FIRST VALUE OF #TAG-CURRENT
    VALUE 'M-REMOTE-CODEPAGE'
      NO-FILL.MF-REMOTE-CODEPAGE := #VALUE-CURRENT
    VALUE 'M-PRODUCT-NAME'
      NO-FILL.MF-PRODUCT-NAME := #VALUE-CURRENT
    VALUE 'M-INTERNAL-NODE-ID'
      IF #VALUE-CURRENT IS (P11)
        NO-FILL.MF-INTERNAL-NODE-ID := VAL (#VALUE-CURRENT)
      ELSE
        #MSG := 'M-INTERNAL-NODE-ID'
        PERFORM FIELD-IGNORED /*RMIMP-C1
      END-IF
    VALUE 'M-LAST-UPDATE'
      MOVE EDITED #VALUE-CURRENT TO NO-FILL.MF-LAST-UPDATE
        (EM=YYYY'-'MM'-'DD'-'HH':'II':'SS'.'T)
    VALUE 'M-LAST-UPDATE-USER'
      NO-FILL.MF-LAST-UPDATE-USER := #VALUE-CURRENT
    VALUE 'M-EMAIL-RECIPIENTS'
      NO-FILL.MF-EMAIL-RECIPIENTS (#IND) := #VALUE-CURRENT
    VALUE 'M-TYPE'
      NO-FILL.MF-TYPE := #VALUE-CURRENT
    VALUE 'M-NPR-USERID'
      NO-FILL.MF-NPR-USERID := #VALUE-CURRENT
    VALUE 'M-TIME-SCHEDULE'
      NO-FILL.MF-TIME-SCHEDULE := #VALUE-CURRENT
    VALUE 'M-MONITOR-DESCRIPTION'
      NO-FILL.MF-MONITOR-DESCRIPTION := #VALUE-CURRENT
    VALUE 'M-SPOOL-TYPE'
      NO-FILL.MF-SPOOL-TYPE := #VALUE-CURRENT
    VALUE 'M-SYSTEM-TYPE'
      NO-FILL.MF-SYSTEM-TYPE := #VALUE-CURRENT
    VALUE 'M-MONITOR-ID'
      NO-FILL.MF-MONITOR-ID := #VALUE-CURRENT
    VALUE 'M-STATUS'
      B64-FUNCTION := 'AB'
      B64-TEXT-ARRAY(1) := #VALUE-CURRENT
      CALLNAT 'RMBAS64N' B64-PARMS 248
      NO-FILL.MF-STATUS := B64-B
    VALUE 'M-MONITOR-NODE'
      IF #VALUE-CURRENT IS (N5)
        NO-FILL.MF-MONITOR-NODE := VAL (#VALUE-CURRENT)
      ELSE
        #MSG := 'M-MONITOR-NODE'
        PERFORM FIELD-IGNORED /*RMIMP-C1
      END-IF
    VALUE 'M-TEMP-CLASS'
      NO-FILL.MF-TEMP-CLASS := #VALUE-CURRENT
    VALUE 'M-PRINT-CLASS'
      NO-FILL.MF-PRINT-CLASS := #VALUE-CURRENT
    VALUE 'M-CLASSES'
      NO-FILL.MF-CLASSES (#IND) := #VALUE-CURRENT
    VALUE 'M-JES3-OUTPUT-CLASSES'
      NO-FILL.MF-JES3-OUTPUT-CLASSES (#IND) := #VALUE-CURRENT
    VALUE 'M-BS2-DEST'
    IF #VALUE-CURRENT = #A16-FF /*SU6
      #VALUE-CURRENT := #FF8 /*'FF' -> H'FF' see RMEXPNO
    END-IF
      NO-FILL.MF-BS2-DEST (#IND) := #VALUE-CURRENT
    VALUE 'M-ERR-CLASS'
      NO-FILL.MF-ERR-CLASS := #VALUE-CURRENT
    VALUE 'M-OBJECT-TYPE'
      NO-FILL.MF-OBJECT-TYPE := #VALUE-CURRENT
    VALUE 'M-OBJECT-TIME'
      MOVE EDITED #VALUE-CURRENT TO NO-FILL.MF-OBJECT-TIME
        (EM=YYYY'-'MM'-'DD'-'HH':'II':'SS'.'T)
    VALUE 'M-NGC-PARMS'
      NO-FILL.MF-NGC-PARMS := #VALUE-CURRENT
    NONE IGNORE
  END-DECIDE
ELSE
  #OBJ-NAME := NO-FILL.MF-MONITOR-ID
  OBJ. FIND (1) NO WITH MF-MONITOR-ID = NO-FILL.MF-MONITOR-ID /*SU4:#KEY
    IF NO RECORDS FOUND
      MOVE BY NAME NO-FILL TO NO
      STORE NO
      PERFORM ADD-LOADED
      ESCAPE BOTTOM (OBJ.)
    END-NOREC
    MOVE BY NAME NO-FILL TO NO
    IF #REPL = 'Y'
      UPDATE (OBJ.)
      PERFORM ADD-REPLACED
    ELSE
      COMPRESS NO-FILL.MF-MONITOR-ID 'not replaced for NO' TO #MSG /*SU4
      PERFORM XXRLOG-WRITE-LOG 'W' #MSG
      PERFORM ADD-NOT-REPLACED
    END-IF
  END-FIND
  END TRANSACTION
END-IF
