  02 ALC-LABEL-TYPE      (A3)   /* (SL/NL/BLP/AL/AUL/SUL/NSL/LTM
  02 ALC-LABEL-EXPDT     (N7)   /* EXPIRATION DATE (YYYYDDD)
  02 ALC-LABEL-RETPD     (N4)   /* RETENTION PERIOD IN DAYS
  02 ALC-SYSOUT-CLASS    (A1)   /* JES OUTPUT CLASS
  02 ALC-SYSOUT-PROGRAM  (A8)   /* JES OUTPUT WRITER NAME
  02 ALC-SYSOUT-FORM     (A4)   /* JES OUTPUT FORM NAME
  02 ALC-SYSOUT-LIMIT    (N8)   /* JES OUTPUT LIMIT
  02 ALC-SYSOUT-COPIES   (N3)   /* JES OUTPUT COPIES
  02 ALC-SYSOUT-HOLD     (A1)   /* (Y,N, ) Y = JES OUTPUT HOLD QUEUE
  02 ALC-SYSOUT-SEGMENT  (N5)   /* JES OUTPUT SEGMENTATION
  02 ALC-SYSOUT-NODE     (A8)   /* JES OUTPUT REMOTE NODE
  02 ALC-SYSOUT-USERID   (A8)   /* JES OUTPUT REMOTE NODE USERID
  02 ALC-SYSOUT-OUTPUT   (A8)   /* REFERENCED OUTPUT STATEMENT
  02 ALC-DCB-DDNAME      (A8)   /* DCB RETRIEVED FROM DDNAME
  02 ALC-DCB-DSORG       (A3)   /* DATASET ORG. (PS/PO/DA)
  02 ALC-DCB-RECFM       (A4)   /* RECORD FORMAT
  02 ALC-DCB-BLKSZ       (N5)   /* BLOCK SIZE
  02 ALC-DCB-LRECL       (N5)   /* RECORD LENGTH
  02 ALC-DCB-BUFNO       (N2)   /* NUMBER OF I/O BUFFERS
/* In version 1 V1-ALC-DCB-BUFNO(N3) will be used instead
  02 ALC-DCB-DENSITY     (N1)   /* TAPE DENSITY (1/2/3/4)
  02 ALC-SMS-STORCLAS    (A8)   /* SMS STORAGE CLASS
  02 ALC-SMS-MGMTCLAS    (A8)   /* SMS MANAGEMENT CLASS
  02 ALC-SMS-DATACLAS    (A8)   /* SMS DATA CLASS
  02 ALC-PATH            (A253) /* PATH NAME
  02 ALC-PATH-DISP1      (A6)   /* PATH DISP. 1 (DELETE/KEEP)
  02 ALC-PATH-DISP2      (A6)   /* PATH DISP. 2 (DELETE/KEEP)
  02 ALC-PATH-OPTS       (B4)   /* PATH OPTIONS
  02 ALC-PATH-MODE       (B4)   /* PATH MODE
  02 ALC-PATH-FILEDAT    (A6)   /* FILE TYPE (BINARY/TEXT)
/*
01 USR2021N
  02 VERSION             (I01)     INIT <2>
  02 V1-ALC-DCB-BUFNO    (N03)
  02 V2-ALC-DSTYPE       (A04)   /* DATASET TYPE (PDS/PDSE)
01 REDEFINE USR2021N
  02 EXTENDED-PARMS
    03 EXTENDED-DATA     (A01/1:8)
*
* NOM Check for Admin rights, enter a Log
LOCAL USING NOMFNC-E            /* NOM API's
LOCAL USING NOMUS--P
LOCAL USING NOMUS--E
LOCAL USING RLOG-L
LOCAL
01 #ACCESS-CODE          (A8)
END-DEFINE
*
*
*
*
*
DEFINE SUBROUTINE ADD-ARC-TO-ARRAY
ADD 1 TO #XDIM
WRITE #XDIM #ARCHIVE-DSNAME
EXPAND ARRAY #ARCHIVE-DSNAME-A TO (1:#XDIM)
#ARCHIVE-DSNAME-A(#XDIM) := #ARCHIVE-DSNAME
EXPAND ARRAY #PORTABLE-DSNAME-A TO (1:#XDIM)
EXAMINE #ARCHIVE-DSNAME FOR '*' GIVING LENGTH #LEN
IF #LEN LE 42
  COMPRESS #ARCHIVE-DSNAME '.P' INTO  #PORTABLE-DSNAME-A(#XDIM)
    LEAVING NO
ELSE
  /* Should never happen, since an archive name should be less than
  /* 42 byte
  #PORTABLE-DSNAME-A(#XDIM) := #ARCHIVE-DSNAME
  EXAMINE #PORTABLE-DSNAME-A(#XDIM) FOR 'NOM' REPLACE 'P-M'
END-IF
END-SUBROUTINE
*
*
*
DEFINE SUBROUTINE HANDLE-ONE-ACHIVE
/*
/* Add entry to user log
PL-PARMS.LG-USERID      := *USER
PL-PARMS.LG-CODE        := 'UI'   /* User information
PL-PARMS.LG-OBJECT-NAME := *PROGRAM
COMPRESS #ARCHIVE-DSNAME-A(#XDIM) 'unloading.'
  INTO PL-PARMS.LG-MSG
CALLNAT 'RLOG' PL-PARMS
*
* NOMLGUS-PARMS.LG-OBJECT-NAME := *PROGRAM
* COMPRESS 'Unload' #ARCHIVE-DSNAME-A(#XDIM)
*   INTO NOMLGUS-PARMS.LG-MSG
* CALLNAT 'NOMLGUSN' NOMLGUS-VERSION NOMLGUS-PARMS
END TRANSACTION
/*
/*
FIND AD1 WITH AD-ARCHIVE-DSNAME = #ARCHIVE-DSNAME-A(#XDIM)
*
  IF NO RECORD FOUND
    WRITE 'Error: No entry in NRM-ARCHIVE-DATASET for'
      #ARCHIVE-DSNAME-A(#XDIM)
    ESCAPE ROUTINE
  END-NOREC
*
  RESET ADO
*
  ADO-RECORD-TYPE := 'A' /* A for NRM-ARCHIVE-DATASET
*
  ADO-ARCHIVE-DSNAME := AD1.AD-ARCHIVE-DSNAME                /* A44       0001 - 0044
  IF AD1.AD-CREATED = 0
    RESET ADO-CREATED
  ELSE
    #P13 := AD1.AD-CREATED
    MOVE EDITED #P13 (EM=9999999999999) TO ADO-CREATED       /* A13 := T  0045 - 0057
  END-IF
  IF AD1.AD-CREATED-INV = 0
    RESET ADO-CREATED-INV
  ELSE
    #P13 := AD1.AD-CREATED-INV
    MOVE EDITED #P13 (EM=999999999999) TO ADO-CREATED-INV    /* A13 := T  0058 - 0070
  END-IF
  ADO-EXPIRATION-DATE := AD1.AD-EXPIRATION-DATE              /* A8        0071 - 0078
  ADO-EXPIRATION-DATE-PHYS := AD1.AD-EXPIRATION-DATE-PHYS    /* A8        0079 - 0086
  ADO-CONDENSE-OUTPUT := AD1.AD-CONDENSE-OUTPUT              /* A1        0087 - 0087
  MOVE EDITED AD1.AD-ORIGINAL-REPORT-COUNT (EM=9999999)
    TO ADO-ORIGINAL-REPORT-COUNT                             /* A7 := P7  0088 - 0094
  ADO-VOLSERS(*) := AD1.AD-VOLSERS(*)                        /* A6/1:20   0095 - 0214
  ADO-MARK-FOR-CONDENSE := AD1.AD-MARK-FOR-CONDENSE          /* A1        0215 - 0215
  MOVE EDITED AD1.AD-ARCHIVE-TYPE (EM=9) TO ADO-ARCHIVE-TYPE /* A1 := N1  0216 - 0216
  ADO-OBJECT-TYPE := AD1.AD-OBJECT-TYPE                      /* A10       0217 - 0226
*   IF AD1.AD-OBJECT-TIME = 0
*     RESET ADO-OBJECT-TIME
*   ELSE
*     #P13 := AD1.AD-OBJECT-TIME
*     MOVE EDITED #P13 (EM=9999999999999) TO ADO-OBJECT-TIME   /* A13 := T  0227 - 0239
*   END-IF
  WRITE WORK 2 VARIABLE ADO
*
  IF #LOG GT 2
    WRITE '  Archive:' AD1.AD-ARCHIVE-DSNAME
      / '  ========'
      / '  Volser1:'ADO-VOLSERS(1) 'Volser2:' ADO-VOLSERS(2)
      'NumRp:' AD1.AD-ORIGINAL-REPORT-COUNT (AD=L)
      'ArcType:' ADO-ARCHIVE-TYPE
      / '  Created:' AD1.AD-CREATED (EM=YYYY-MM-DD' 'HH:II)
      'LogExpD:' ADO-EXPIRATION-DATE
      'PhysExpD:' ADO-EXPIRATION-DATE-PHYS
  END-IF
*
END-FIND
*
ADD 1 TO #ARCS-TOTAL
RESET #CNT-REP #CNT-WARN
*
IF #LOG GT 1
  MOVE ALL '=' TO #MSG
  COMPRESS ' Start reading archive' #XDIM INTO #MSG-1
  WRITE NOTITLE NOHDR #MSG
END-IF
*
*
READ WORK FILE 1 #TEXT-RECORD GIVING LENGTH #RECORD-LENGTH
  DECIDE ON FIRST VALUE OF #T-RECORD-TYPE
    VALUE 'I'
      RESET #WARN
/*
      IF #CNT-TXT NE 0
        IF #LOG GT 2
          WRITE '  Act-Reps:' #CNT-AR 'DS-Reps:' #CNT-DR
            'Mail-Recs:' #CNT-MAIL 'Txt-Recs:' #CNT-TXT
        END-IF
      END-IF
      RESET #CNT-AR #CNT-DR #CNT-MAIL #CNT-TXT
/*
      #ID-RECORD := #TEXT-RECORD
/*
      WF-RECORD-TYPE  := #I-RECORD-TYPE  /* A1  ALWAYS 'I'
      WF-ARCHIVE-FROM := #ARCHIVE-FROM   /* A1  S-SPOOL, D-DATABASE, C-CONNECT
/*
      DECIDE FOR FIRST CONDITION
          /*
          /* repname a17,reprnb p7,jobnumber n5,node n3
        WHEN #RECORD-LENGTH LE 132                           /* NOM141
          #AR-REPNAME:= #REPNAME3
          #AR-REPRNB:= #REPRNB3
          /*
          WF-REPNAME        := #REPNAME3                      /* A25 := A17
          MOVE EDITED #REPRNB3 (EM=99999999999) TO WF-REPRNB  /* P7 TO A11
          WF-JOBNAME        := #JOBNAME3                      /* A8
          MOVE EDITED #JOBNO3 (EM=9999999) TO WF-JOBNO        /* N5 TO A7
          MOVE EDITED #NODE3 (EM=99999) TO WF-NODE            /* N3 TO A5
          WF-DSTYPE         := #DSTYPE3                       /* A2
          MOVE EDITED #DSNO3 (EM=9999999) TO WF-DSNO          /* N7 TO A7
          MOVE EDITED #I-ARCHIVE-DATE3 (EM=9999999999999) TO WF-I-ARCHIVE-DATE /* P13(T) TO A13
          WF-CABINET        := #K-CABINET3                    /* A8
          WF-INDICATOR      := #K-INDICATOR3                  /* A3
          WF-CHARS          := #K-CHARS3                      /* A16
          WF-RECFM          := #K-RECFM3                      /* A3
          WF-FCB            := #K-FCB3                        /* A4
          WF-FLASH          := #K-FLASH3                      /* A4
          WF-FORM           := #K-FORM3                       /* A8
          WF-TRC            := #K-TRC3                        /* A3
          WF-SEPMEM         := #K-SEPMEM3                     /* A8
          IF #K-CREATED3 = 0
            RESET WF-CREATED
          ELSE
            #P13 := #K-CREATED3                               /* P13 := T
            MOVE EDITED #P13 (EM=9999999999999) TO WF-CREATED /* P13 TO A13 := T
          END-IF
          MOVE EDITED #K-NUMLINES3 (EM=9999999) TO WF-NUMLINES /* P7 TO A7
          WF-USERID         := #K-USERID3                     /* A8
          /*
          /* repname a25,reprnb p7,jobnumber n5,node n3
        WHEN #RECORD-LENGTH = 133 THRU 140                   /* NOM211
          #AR-REPNAME:= #REPNAME1 /* jobname (n5)
          #AR-REPRNB:= #REPRNB1
          /*
          WF-REPNAME        := #REPNAME1                      /* A25 := A25
          MOVE EDITED #REPRNB1 (EM=99999999999) TO WF-REPRNB  /* P7 TO A11
          WF-JOBNAME        := #JOBNAME1                      /* A8
          MOVE EDITED #JOBNO1 (EM=9999999) TO WF-JOBNO        /* N5 TO A7
          MOVE EDITED #NODE1 (EM=99999) TO WF-NODE            /* N3 TO A5
          WF-DSTYPE         := #DSTYPE1                       /* A2
          MOVE EDITED #DSNO1 (EM=9999999) TO WF-DSNO          /* N7 TO A7
          MOVE EDITED #I-ARCHIVE-DATE1 (EM=9999999999999) TO WF-I-ARCHIVE-DATE /* P13(T) TO A13
          WF-CABINET        := #K-CABINET1                    /* A8
          WF-INDICATOR      := #K-INDICATOR1                  /* A3
          WF-CHARS          := #K-CHARS1                      /* A16
          WF-RECFM          := #K-RECFM1                      /* A3
          WF-FCB            := #K-FCB1                        /* A4
          WF-FLASH          := #K-FLASH1                      /* A4
          WF-FORM           := #K-FORM1                       /* A8
          WF-TRC            := #K-TRC1                        /* A3
          WF-SEPMEM         := #K-SEPMEM1                     /* A8
          IF #K-CREATED1 = 0
            RESET WF-CREATED
          ELSE
            #P13 := #K-CREATED1                               /* P13 := T
            MOVE EDITED #P13 (EM=9999999999999) TO WF-CREATED /* P13 TO A13 := T
          END-IF
          MOVE EDITED #K-NUMLINES1 (EM=9999999) TO WF-NUMLINES /* P7 TO A7
          WF-USERID         := #K-USERID1                     /* A8
          /*
          /* repname a25,reprnb p7,jobnumber n7,node n3
        WHEN #RECORD-LENGTH = 141 THRU 142                   /* NOM311
          #AR-REPNAME:= #REPNAME2
          #AR-REPRNB:= #REPRNB2
          /*
          WF-REPNAME        := #REPNAME2                      /* A25 := A25
          MOVE EDITED #REPRNB2 (EM=99999999999) TO WF-REPRNB  /* P7 TO A11
          WF-JOBNAME        := #JOBNAME2                      /* A8
          MOVE EDITED #JOBNO2 (EM=9999999) TO WF-JOBNO        /* N7 TO A7
          MOVE EDITED #NODE2 (EM=99999) TO WF-NODE            /* N3 TO A5
          WF-DSTYPE         := #DSTYPE2                       /* A2
          MOVE EDITED #DSNO2 (EM=9999999) TO WF-DSNO          /* N7 TO A7
          MOVE EDITED #I-ARCHIVE-DATE2 (EM=9999999999999) TO WF-I-ARCHIVE-DATE /* P13(T) TO A13
          WF-CABINET        := #K-CABINET2                    /* A8
          WF-INDICATOR      := #K-INDICATOR2                  /* A3
          WF-CHARS          := #K-CHARS2                      /* A16
          WF-RECFM          := #K-RECFM2                      /* A3
          WF-FCB            := #K-FCB2                        /* A4
          WF-FLASH          := #K-FLASH2                      /* A4
          WF-FORM           := #K-FORM2                       /* A8
          WF-TRC            := #K-TRC2                        /* A3
          WF-SEPMEM         := #K-SEPMEM2                     /* A8
          IF #K-CREATED2 = 0
            RESET WF-CREATED
          ELSE
            #P13 := #K-CREATED2                               /* P13 := T
            MOVE EDITED #P13 (EM=9999999999999) TO WF-CREATED /* P13 TO A13 := T
          END-IF
          MOVE EDITED #K-NUMLINES2 (EM=9999999) TO WF-NUMLINES /* P7 TO A7
          WF-USERID         := #K-USERID2                     /* A8
          /*
          /* repname a25,reprnb p11,jobnumber n7,node n5
        WHEN #RECORD-LENGTH > 142                            /* NOM321
          #AR-REPNAME:= #REPNAME /* rnb(p11), node (n5)
          #AR-REPRNB:= #REPRNB
          /*
          WF-REPNAME        := #REPNAME                       /* A25 := A25
          MOVE EDITED #REPRNB  (EM=99999999999) TO WF-REPRNB  /* P7 TO A11
          WF-JOBNAME        := #JOBNAME                       /* A8
          IF #JOBNO-A7 = ' '
            RESET WF-JOBNO
          ELSE
            MOVE EDITED #JOBNO  (EM=9999999) TO WF-JOBNO      /* N7 TO A7
          END-IF
          IF #NODE-A5 = ' '
            RESET WF-NODE
          ELSE
            MOVE EDITED #NODE  (EM=99999) TO WF-NODE          /* N5 TO A5
          END-IF
          WF-DSTYPE         := #DSTYPE                        /* A2
          IF #DSNO-A7 = ' '
            RESET WF-DSNO
          ELSE
            MOVE EDITED #DSNO  (EM=9999999) TO WF-DSNO        /* N7 TO A7
          END-IF
          MOVE EDITED #I-ARCHIVE-DATE  (EM=9999999999999) TO WF-I-ARCHIVE-DATE /* P13(T) TO A13
          WF-CABINET        := #K-CABINET                     /* A8
          WF-INDICATOR      := #K-INDICATOR                   /* A3
          WF-CHARS          := #K-CHARS                       /* A16
          WF-RECFM          := #K-RECFM                       /* A3
          WF-FCB            := #K-FCB                         /* A4
          WF-FLASH          := #K-FLASH                       /* A4
          WF-FORM           := #K-FORM                        /* A8
          WF-TRC            := #K-TRC                         /* A3
          WF-SEPMEM         := #K-SEPMEM                      /* A8
          IF #K-CREATED = 0
            RESET WF-CREATED
          ELSE
            #P13 := #K-CREATED                                /* P13 := T
            MOVE EDITED #P13 (EM=9999999999999) TO WF-CREATED /* P13 TO A13 := T
          END-IF
          MOVE EDITED #K-NUMLINES (EM=9999999) TO WF-NUMLINES /* P7 TO A7
          WF-USERID         := #K-USERID                      /* A8
        WHEN NONE IGNORE
      END-DECIDE
      /*
      /*
      #DR-ARCHIVE-DSNAME := #ARCHIVE-DSNAME-A(#XDIM)
      #DR-REPNAME := #AR-REPNAME
      #DR-REPRNB := #AR-REPRNB
      FIND NUMBER DR1 WITH DR-DSNAME-REPORT-RNB = #DR1-KEY
      IF *NUMBER GT 0
        /* Use old v343 view, since FIND NUMBER returns the same
        /* result than the v351 view (2 additinal, none key fields).
        FIND NUMBER AR1-343 WITH AR-REPORT-RNB = #AR1-KEY
        IF *NUMBER GT 0
          FIND NUMBER MA1 WITH MA-REP-RNB = #AR1-KEY
          IF *NUMBER GT 0
            /*
            /*
*  Record Type 'D'
            /* Write 'D' before record type 'I', to check for
            /* duplicated when loading the records
            FIND DR1 WITH DR-DSNAME-REPORT-RNB = #DR1-KEY
              /* Cannot happen, checked above
              /* IF NO RECORDS FOUND
              /*   WRITE 'Warning: No entry in NRM-DATASET-REPORT for'
              /*     #DR-ARCHIVE-DSNAME #DR-REPNAME #DR-REPRNB
              /*   #WARN := TRUE
              /*   ESCAPE BOTTOM
              /* END-NOREC
              /*
              RESET DRO
              DRO-ARCHIVE-DSNAME       := DR1.DR-ARCHIVE-DSNAME
              DRO-REPNAME              := DR1.DR-REPNAME
              MOVE EDITED DR1.DR-REPRNB (EM=99999999999) TO DRO-REPRNB
              DRO-STATUS               := DR1.DR-STATUS
              DRO-EXPIRATION-DATE      := DR1.DR-EXPIRATION-DATE
              DRO-EXPIRATION-DATE-ORIG := DR1.DR-EXPIRATION-DATE-ORIG
              DRO-OBJECT-TYPE          := DR1.DR-OBJECT-TYPE
              /* IF DR1.DR-OBJECT-TIME = 0
              /*   RESET DRO-OBJECT-TIME
              /* ELSE
              /*   #P13 := DR1.DR-OBJECT-TIME
              /*   MOVE EDITED #P13 (EM=9999999999999) TO DRO-OBJECT-TIME
              /* END-IF
              /*
              DRO-RECORD-TYPE := 'D'
              /*
              WRITE WORK 2 VARIABLE DRO
              ADD 1 TO #CNT-DR
            END-FIND
            /*
            /*
            /*
*  Record Type 'I'
            /* Write 'I' after record type 'D', to check for
            /* duplicated when loading the records
            WRITE WORK 2 VARIABLE WF-ID-RECORD
            /*
            /*
            /*
          ELSE
            IF #LOG GT 2
              WRITE 'Report:' #AR-REPNAME 'Rnb:' #AR-REPRNB
                / '  skipped, NRM-MAIL entry missing'
            END-IF
            ADD 1 TO #CNT-WARN
            #WARN := TRUE
            ESCAPE TOP
          END-IF
        ELSE
          IF #LOG GT 2
            WRITE 'Report:' #AR-REPNAME 'Rnb:' #AR-REPRNB
              / '  skipped, NRM-ACTIVE-REPORTS entry missing'
          END-IF
          ADD 1 TO #CNT-WARN
          #WARN := TRUE
          ESCAPE TOP
        END-IF
      ELSE
        IF #LOG GT 2
          WRITE 'Archive:' #DR-ARCHIVE-DSNAME
            / 'Report:' #DR-REPNAME 'Rnb:' #DR-REPRNB
            / '  skipped, NRM-DATASET-REPORT entry missing'
        END-IF
        ADD 1 TO #CNT-WARN
        #WARN := TRUE
        ESCAPE TOP
      END-IF
      /*
      /*
      /*
      ADD 1 TO #CNT-REP
      IF #LOG GT 1
        WRITE 'Report:' #AR-REPNAME 'Rnb:' #AR-REPRNB
      END-IF
      /*
      /*
      /*
      /*
      /*
*  Record Type 'R'
      FIND AR1-343 WITH AR-REPORT-RNB = #AR1-KEY
*        WHERE AR-REVIVE ='D' OR='S' /*SU5 OR='C'
        /* Cannot happen, checked above
        /* IF NO RECORDS FOUND
        /*   WRITE 'Warning: No entry in NRM-ACTIVE-REPORTS for'
        /*     #AR-REPNAME #AR-REPRNB
        /*   #WARN := TRUE
        /*   ESCAPE BOTTOM
        /* END-NOREC
*
        RESET ARO
*
        ARO-KEYWORDS(*)             := AR-KEYWORDS(*)       /* (A15/1:6)           0001 - 0090
*                                                           /* (A13) := (P13.0)    0091 - 0103
        MOVE EDITED AR-PROCESS-TIME-INV (EM=9999999999999) TO ARO-PROCESS-TIME-INV
        ARO-REPNAME                 := AR-REPNAME           /* (A25)               0104 - 0128
        MOVE EDITED AR-REPRNB (EM=99999999999) TO ARO-REPRNB /* A11 := P11.0       0129 - 0139
        ARO-MASTER-REPNAME          := AR-MASTER-REPNAME    /* (A25)               0140 - 0164
        /* (A11) := (P11.0)    0165 - 0175
*       MOVE EDITED AR-INTERNAL-NODE-ID (EM=99999999999) TO ARO-INTERNAL-NODE-ID
        ARO-NODE-UX                 := AR-NODE-UX           /* (A16)               0176 - 0191
        ARO-STATUS                  := AR-STATUS            /* (A1)                0192 - 0192
        ARO-EXPIRATION              := AR-EXPIRATION        /* (A8)                0193 - 0200
        ARO-RETENTION-ACTION        := AR-RETENTION-ACTION  /* (A1)                0201 - 0201
        ARO-RETENTION-PERIOD        := AR-RETENTION-PERIOD  /* (A12)               0202 - 0213
        ARO-DESC                    := AR-DESC              /* (A50)               0214 - 0263
        ARO-REMOTE-CODEPAGE         := AR-REMOTE-CODEPAGE   /* (A64)               0264 - 0327
*       ARO-LOCAL-CODEPAGE          := AR-LOCAL-CODEPAGE    /* (A64)               0328 - 0391
        IF AR-PROCESS-TIME = 0
          RESET ARO-PROCESS-TIME
        ELSE
          #P13 := AR1-343.AR-PROCESS-TIME                         /* P13 := T
          MOVE EDITED #P13 (EM=9999999999999) TO ARO-PROCESS-TIME /* A13 := P13    0392 - 0404
        END-IF
        /* (A8) := (P8.0)
        MOVE EDITED AR-NUMBER-OF-LINES (EM=99999999) TO ARO-NUMBER-OF-LINES     /* 0405 - 0412
        ARO-INSERTED                := AR-INSERTED          /* (A1)                0413 - 0413
        ARO-CURRENT-LOCATION        := AR-CURRENT-LOCATION  /* (A1)                0414 - 0414
        ARO-STORE-NATRPT            := AR-STORE-NATRPT      /* (A1)                0415 - 0415
        MOVE EDITED AR-ORDER-ID (EM=9999999999) TO ARO-ORDER-ID    /* A10 := P10.0 0416 - 0425
        MOVE EDITED AR-SOURCE-ID (EM=9999999999) TO ARO-SOURCE-ID  /* A10 := P10.0 0426 - 0435
        MOVE EDITED AR-CC-TYPE (EM=HHHH) TO ARO-CC-TYPE            /* A4 := B2     0436 - 0439
        MOVE EDITED AR-RECORD-LENGTH (EM=999) TO ARO-RECORD-LENGTH /* A3 := N3.0   0440 - 0442
*
        #SPOOL-ATTRIBUTES           := AR-SPOOL-ATTRIBUTES     /* A250 := A250
        CALLNAT 'RMSPL7-N' #SPOOL-ATTRIBUTES #SPOOL-TYPE
*
*
        MOVE EDITED #SPOOL-TYPE (EM=99999) TO ARO-SPOOL-TYPE   /* (A5) := (I2)     0443 - 0447
*
*
        DECIDE ON FIRST VALUE OF #SPOOL-TYPE
            /*
          VALUE SEQUENTIAL-FILE-BS2  /* 0007
*   ---------------------------------      -----------------------------------
*   BS2000
*   ---------------------------------      -----------------------------------
            MOVE EDITED #SPOOL-BS2-NODE (EM=99999) TO ARO-SPOOL-BS2-NODE /* A5 := N5 0448 - 0452
            ARO-SPOOL-BS2-JOB-NAME    := #SPOOL-BS2-JOB-NAME          /* (A8)        0453 - 0460
            ARO-SPOOL-BS2-USER-ID     := #SPOOL-BS2-USER-ID           /* (A8)        0461 - 0468
            ARO-SPOOL-BS2-JOB-ID      := #SPOOL-BS2-JOB-ID            /* (A5)        0469 - 0473
            ARO-SPOOL-BS2-ORIGINATOR-JOB-ID := #SPOOL-BS2-ORIGINATOR-JOB-ID /* (A5)  0474 - 0478
            /* A3 := N3
            MOVE EDITED #SPOOL-BS2-COPIES (EM=999) TO ARO-SPOOL-BS2-COPIES        /* 0479 - 0481
            ARO-SPOOL-BS2-FORM        := #SPOOL-BS2-FORM              /* (A8)        0482 - 0489
            ARO-SPOOL-BS2-CHARS       := #SPOOL-BS2-CHARS             /* (A16)       0490 - 0505
            ARO-SPOOL-BS2-DSNAME      := #SPOOL-BS2-DSNAME            /* (A54)       0506 - 0559
            ARO-SPOOL-BS2-CONTROL-OPTION := #SPOOL-BS2-CONTROL-OPTION /* (A16)       0560 - 0575
