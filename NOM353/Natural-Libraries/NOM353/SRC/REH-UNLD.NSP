            /* A7 := N7    0475 - 0481
            MOVE EDITED #SPOOL-JES-DATASET-KEY (EM=9999999) TO ARO-SPOOL-JES-DATASET-KEY
            ARO-SPOOL-JES-GROUP-ID    := #SPOOL-JES-GROUP-ID          /* (A20)       0482 - 0501
            ARO-SPOOL-JES-PROCNAME    := #SPOOL-JES-PROCNAME          /* (A8)        0502 - 0509
            ARO-SPOOL-JES-STEPNAME    := #SPOOL-JES-STEPNAME          /* (A8)        0510 - 0517
            ARO-SPOOL-JES-DDNAME      := #SPOOL-JES-DDNAME            /* (A8)        0518 - 0525
            ARO-SPOOL-JES-CHARS       := #SPOOL-JES-CHARS             /* (A20)       0526 - 0545
            ARO-SPOOL-JES-FCB         := #SPOOL-JES-FCB               /* (A4)        0546 - 0549
            ARO-SPOOL-JES-FLASH       := #SPOOL-JES-FLASH             /* (A4)        0550 - 0553
            ARO-SPOOL-JES-FORM        := #SPOOL-JES-FORM              /* (A8)        0554 - 0561
            ARO-SPOOL-JES-FORMDEF     := #SPOOL-JES-FORMDEF           /* (A8)        0562 - 0569
            ARO-SPOOL-JES-PAGEDEF     := #SPOOL-JES-PAGEDEF           /* (A8)        0570 - 0577
            ARO-SPOOL-JES-TRC         := #SPOOL-JES-TRC               /* (A3)        0578 - 0580
            ARO-SPOOL-JES-RECFM       := #SPOOL-JES-RECFM             /* (A3)        0581 - 0583
            /* A3 := N3
            MOVE EDITED #SPOOL-JES-COPIES (EM=999) TO ARO-SPOOL-JES-COPIES        /* 0584 - 0586
            ARO-SPOOL-JES-UCS         := #SPOOL-JES-UCS               /* (A4)        0587 - 0590
            ARO-SPOOL-JES-BURST       := #SPOOL-JES-BURST             /* (A3)        0591 - 0593
            ARO-SPOOL-JES-COMPACT     := #SPOOL-JES-COMPACT           /* (A8)        0594 - 0601
            /* A3 := N3
            MOVE EDITED #SPOOL-JES-LINECT (EM=999) TO ARO-SPOOL-JES-LINECT        /* 0602 - 0604
            ARO-SPOOL-JES-DESTINATION := #SPOOL-JES-DESTINATION       /* (A8)        0605 - 0612
            ARO-SPOOL-JES-TRIGGER-DSNAME := #SPOOL-JES-TRIGGER-DSNAME /* (A44)       0613 - 0656
            /* A5 := N5
            MOVE EDITED #SPOOL-JES-DSNO (EM=99999) TO ARO-SPOOL-JES-DSNO          /* 0657 - 0661
            /* 34 free     0662 - 0695
            /*
          VALUE NAT                  /* 0010
            /* A3 := N3
            MOVE EDITED #SPOOL-NAF-DBID-OLD (EM=999) TO ARO-SPOOL-NAF-DBID-OLD    /* 0448 - 0450
            /* A3 := N3
            MOVE EDITED #SPOOL-NAF-FNR-OLD (EM=999) TO ARO-SPOOL-NAF-FNR-OLD      /* 0451 - 0453
            ARO-SPOOL-NAF-USER-ID     := #SPOOL-NAF-USER-ID           /* (A8)        0454 - 0461
            MOVE EDITED #SPOOL-NAF-PNR (EM=99) TO ARO-SPOOL-NAF-PNR   /* A2 := N2    0462 - 0463
*
            IF #NAF-DATE = MASK(YYYYMMDD)
              ARO-SPOOL-NAF-DATE-TIME   := #SPOOL-NAF-TIME            /* A15      ÜÜ 0464 - 0478
              ARO-SPOOL-NAF-TIME-FORMAT := 'A'                        /* A1       ÜÜ 0479 - 0479
            ELSE
              IF #SPOOL-NAF-TIME NE ' ' AND #NAF-TIMX NE 0
                #P13 := #NAF-TIMX                                     /* P13 := T
                MOVE EDITED #P13 (EM=9999999999999)
                  TO ARO-SPOOL-NAF-DATE-TIME                          /* A15 := P13Ü 0464 - 0478
                ARO-SPOOL-NAF-TIME-FORMAT := 'T'                      /* A1       ÜÜ 0479 - 0479
              ELSE
                RESET ARO-SPOOL-NAF-DATE-TIME                         /*          ÜÜ 0464 - 0478
                RESET ARO-SPOOL-NAF-TIME-FORMAT                       /* A1       ÜÜ 0479 - 0479
              END-IF
            END-IF
*
            ARO-SPOOL-NAF-NATPGM      := #SPOOL-NAF-NATPGM            /* (A8)        0480 - 0487
            ARO-SPOOL-NAF-NATLIB      := #SPOOL-NAF-NATLIB            /* (A8)        0488 - 0495
            ARO-SPOOL-NAF-FORM        := #SPOOL-NAF-FORM              /* (A8)        0496 - 0503
            ARO-SPOOL-NAF-PROFILE     := #SPOOL-NAF-PROFILE           /* (A8)        0504 - 0511
            /* A3 := N3
            MOVE EDITED #SPOOL-NAF-COPIES (EM=999) TO ARO-SPOOL-NAF-COPIES        /* 0512 - 0514
            ARO-SPOOL-NAF-NAME        := #SPOOL-NAF-NAME              /* (A8)        0515 - 0522
            ARO-SPOOL-NAF-DISP        := #SPOOL-NAF-DISP              /* (A1)        0523 - 0522
            /* A10 := P10
            MOVE EDITED #SPOOL-NAF-ST-ID (EM=99999) TO ARO-SPOOL-NAF-ST-ID        /* 0524 - 0533
            MOVE EDITED #SPOOL-NAF-DBID (EM=99999) TO ARO-SPOOL-NAF-DBID /* A5 := N5 0534 - 0538
            MOVE EDITED #SPOOL-NAF-FNR (EM=99999) TO ARO-SPOOL-NAF-FNR   /* A5 := N5 0539 - 0543
            ARO-SPOOL-NAF-DEST        := #SPOOL-NAF-DEST              /* (A8)        0544 - 0551
            ARO-SPOOL-NAF-OUTPUT      := #SPOOL-NAF-OUTPUT            /* (A8)        0552 - 0559
            ARO-SPOOL-NAF-REST        := #SPOOL-NAF-REST              /* 136 free    0560 - 0695
            /*
          VALUE SEQUENTIAL-FILE-UNIX
            ARO-SPOOL-UNIX-NODE-NAME  := #SPOOL-UNIX-NODE-NAME        /* (A16)
            ARO-SPOOL-UNIX-USERID     := #SPOOL-UNIX-USERID           /* (A8)
            ARO-SPOOL-UNIX-CIPHER-PASSWORD := #SPOOL-UNIX-CIPHER-PASSWORD /* (A32)
            ARO-SPOOL-UNIX-GROUP      := #SPOOL-UNIX-GROUP            /* (A8)
            ARO-SPOOL-UNIX-PATH       := #SPOOL-UNIX-PATH             /* (A70)
            ARO-SPOOL-UNIX-FILE-NAME  := #SPOOL-UNIX-FILE-NAME        /* (A50)
            MOVE EDITED #SPOOL-UNIX-CONTAINER-DBID (EM=99999) TO ARO-SPOOL-UNIX-CONTAINER-DBID /* A5 = N5
            MOVE EDITED #SPOOL-UNIX-CONTAINER-FNR (EM=99999) TO ARO-SPOOL-UNIX-CONTAINER-FNR   /* A5 = N5
            ARO-SPOOL-UNIX-FILL       := #SPOOL-UNIX-FILL             /* (A20)
            MOVE EDITED #SPOOL-UNIX-SIZE (EM=9999999999) TO ARO-SPOOL-UNIX-SIZE /* A10 = I4
          NONE
            WRITE 'Unknown #SPOOL-TYPE:' #SPOOL-TYPE
        END-DECIDE
*
        ARO-SPOOL-ATTR-EXTENDED(*)  := AR-SPOOL-ATTR-EXTENDED(1:3) /* (A250/1:3)   0696 - 1445
        ARO-USERID                  := AR-USERID            /* (A8)                1446 - 1453
        ARO-NATRPT-DIST(*)          := AR-NATRPT-DIST(*)    /* (A8/1:10)           1454 - 1533
        ARO-PRINTERS(*)             := AR-PRINTERS(*)       /* (A12/1:20)          1536 - 1773
        ARO-HOLD-PRINT              := AR-HOLD-PRINT        /* (A1)                1774 - 1774
        ARO-SEPMEM                  := AR-SEPMEM            /* (A16)               1774 - 1790
        MOVE EDITED AR-SEPNO (EM=999) TO ARO-SEPNO          /* (A3) := (P3.0)      1791 - 1793
        ARO-ACTIVE                  := AR-ACTIVE            /* (A1)                1794 - 1794
        ARO-ARCHIVE                 := AR-ARCHIVE           /* (A1)                1795 - 1795
        ARO-ARCHIVE-RETENTION       := AR-ARCHIVE-RETENTION /* (A5)                1796 - 1800
        /* (A8) := (N8.0)
        MOVE EDITED AR-ARCHIVE-RECNO (EM=99999999) TO ARO-ARCHIVE-RECNO         /* 1801 - 1808
        IF AR1-343.AR-ARCHIVE-DATE = 0
          RESET ARO-ARCHIVE-DATE
        ELSE
          #P13 := AR1-343.AR-ARCHIVE-DATE                         /* P13 := T
          MOVE EDITED #P13 (EM=9999999999999) TO ARO-ARCHIVE-DATE /* A13 := P13    1809 - 1821
        END-IF
        ARO-ARCHIVE-DATA-SET        := AR-ARCHIVE-DATA-SET  /* (A44)               1822 - 1865
        ARO-ARCHIVE-VOLSER(*)       := AR-ARCHIVE-VOLSER(*) /* (A6/1:10)           1866 - 1925
        ARO-REVIVE                  := AR-REVIVE            /* (A1)                1926 - 1926
        ARO-REVIVE-EXPIRATION       := AR-REVIVE-EXPIRATION /* (A8)                1927 - 1934
        IF AR1-343.AR-REVIVE-DATE = 0
          RESET ARO-REVIVE-DATE
        ELSE
          #P13 := AR1-343.AR-REVIVE-DATE                         /* P13 := T
          MOVE EDITED #P13 (EM=9999999999999) TO ARO-REVIVE-DATE /* A13 := P13     1935 - 1947
        END-IF
        ARO-REVIVE-RETENTION-PERIOD := AR-REVIVE-RETENTION-PERIOD  /* (A12)        1948 - 1959
        ARO-CHARS                   := AR-CHARS                    /* (A20)        1960 - 1979
        ARO-DATASET-IDENTIFIER      := AR-DATASET-IDENTIFIER       /* (A25)        1980 - 2004
        MOVE EDITED AR-DATASET-KEY (EM=9999999) TO ARO-DATASET-KEY /* A7 := N7.0   2005 - 2011
        MOVE EDITED AR-DSNO (EM=999) TO ARO-DSNO                   /* A3 := N3.0   2012 - 2014
        ARO-DSTYPE                  := AR-DSTYPE            /* (A2)                2015 - 2016
        ARO-FCB                     := AR-FCB               /* (A4)                2017 - 2020
        ARO-FLASH                   := AR-FLASH             /* (A4)                2021 - 2024
        ARO-FORM                    := AR-FORM              /* (A8)                2025 - 2032
        ARO-FORMDEF                 := AR-FORMDEF           /* (A8)                2033 - 2040
        ARO-GROUP-ID                := AR-GROUP-ID          /* (A20)               2041 - 2060
        ARO-JOBNAME                 := AR-JOBNAME           /* (A10)               2061 - 2070
        MOVE EDITED AR-JOBNO (EM=9999999) TO ARO-JOBNO      /* (A7) := (N7.0)      2071 - 2077
        ARO-PROCNAME                := AR-PROCNAME          /* (A8)                2078 - 2085
        ARO-DDNAME                  := AR-DDNAME            /* (A8)                2086 - 2093
        ARO-PAGEDEF                 := AR-PAGEDEF           /* (A8)                2094 - 2101
        ARO-RECFM                   := AR-RECFM             /* (A3)                2102 - 2104
        ARO-STEPNAME                := AR-STEPNAME          /* (A8)                2105 - 2112
        ARO-TRC                     := AR-TRC               /* (A3)                2113 - 2115
        MOVE EDITED AR-COPIES (EM=999) TO ARO-COPIES               /* A3 := N3.0   2116 - 2118
        MOVE EDITED AR-ARCHIVE-TYPE (EM=9) TO ARO-ARCHIVE-TYPE     /* A1 := N1.0   2119 - 2119
        ARO-STYLESHEET-URL          := AR-STYLESHEET-URL    /* (A70)               2120 - 2189
        ARO-REP-FORMAT              := AR-REP-FORMAT        /* (A1)                2190 - 2190
        ARO-SOURCE                  := AR-SOURCE            /* (A16)               2191 - 2206
        ARO-SENDER                  := AR-SENDER            /* (A16)               2207 - 2222
        IF AR-LAST-UPDATE = 0
          RESET ARO-LAST-UPDATE
        ELSE
          #P13 := AR1-343.AR-LAST-UPDATE                         /* P13 := T
          MOVE EDITED #P13 (EM=9999999999999) TO ARO-LAST-UPDATE /* A13 := P13     2223 - 2235
        END-IF
        ARO-LAST-UPDATE-USER        := AR-LAST-UPDATE-USER  /* (A16)               2236 - 2251
        ARO-OBJECT-TYPE             := AR-OBJECT-TYPE       /* (A10)               2252 - 2261
*         IF AR-OBJECT-TIME = 0
*           RESET ARO-OBJECT-TIME
*         ELSE
*           #P13 := AR1.AR-OBJECT-TIME                             /* P13 := T
*           MOVE EDITED #P13 (EM=9999999999999) TO ARO-OBJECT-TIME /* A13 := P13     2262 - 2274
*         END-IF
*

        IF L-VERS = 35
          FIND AR1 WITH AR-REPORT-RNB = #AR1-KEY
            /* (A11) := (P11.0)    0165 - 0175
            MOVE EDITED AR-INTERNAL-NODE-ID (EM=99999999999) TO ARO-INTERNAL-NODE-ID
            ARO-LOCAL-CODEPAGE          := AR-LOCAL-CODEPAGE    /* (A64)               0328 - 0391
          END-FIND
        END-IF

        ARO-RECORD-TYPE := 'R'
*
        WRITE WORK 2 VARIABLE ARO
        ADD 1 TO #CNT-AR
*
      END-FIND
      /*
      /*
      /*
      /*
      /*
*  Record Type 'M'
      FIND MA1 WITH MA-REP-RNB = #AR1-KEY
*
        /* Cannot happen, checked above
        /* IF NO RECORDS FOUND
        /*   WRITE 'Warning: No entry in NRM-MAIL for'
        /*     #AR-REPNAME #AR-REPRNB
        /*   #WARN := TRUE
        /*   ESCAPE BOTTOM
        /* END-NOREC
*
        RESET MAO
*
        MAO-USERID := MA1.MA-USERID                             /* A8              0001 - 0008
        MOVE EDITED MA1.MA-FO-ID (EM=HHHH) TO MAO-FO-ID         /* A4 := B2        0009 - 0012
        MAO-REPNAME := MA1.MA-REPNAME                           /* A25             0013 - 0037
        MOVE EDITED MA1.MA-REPRNB (EM=99999999999) TO MAO-REPRNB  /* A11 := P11    0038 - 0048
        /* A13 := P13.0
        MOVE EDITED MA1.MA-INV-TIME (EM=9999999999999) TO MAO-INV-TIME         /*  0049 - 0061
        MAO-STATUS := MA1.MA-STATUS                             /* A1              0062 - 0062
        /* A3/1:10 := P3/1:10
        MOVE EDITED MA1.MA-FROM(*) (EM=999) TO MAO-FROM(*)                     /*  0063 - 0092
        /* A3/1:10 := P3/1:10
        MOVE EDITED MA1.MA-TO(*) (EM=999) TO MAO-TO(*)                         /*  0093 - 0122
        MOVE EDITED MA1.MA-HEADLINES (EM=999) TO MAO-HEADLINES  /* A3 := N3.0      0123 - 0125
        MAO-CURRENT-LOCATION := MA1.MA-CURRENT-LOCATION         /* A1              0126 - 0126
        /* A13 := P13.0
        MOVE EDITED MA1.MA-PROCESS-TIME (EM=9999999999999) TO MAO-PROCESS-TIME /*  0127 - 0139
        /* A13 := P13.0    0140 - 0152
        MOVE EDITED MA1.MA-PROCESS-TIME-INV (EM=9999999999999) TO MAO-PROCESS-TIME-INV
        MAO-OBJECT-TYPE := MA1.MA-OBJECT-TYPE                   /* A10             0153 - 0162
*         IF MA1.MA-OBJECT-TIME = 0
*           RESET MAO-OBJECT-TIME
*         ELSE
*           #P13 := MA1.MA-OBJECT-TIME
*           MOVE EDITED #P13 (EM=9999999999999) TO MAO-OBJECT-TIME /* A13 := T       0163 - 0175
*         END-IF
*
*
        #FO-USER-ID := MA1.MA-USERID
        #FO-ID      := MA1.MA-FO-ID
        FIND FO1 WITH FO-USER-FO-ID = #FO-USER-FO-ID
          IF NO RECORDS FOUND
            RESET MAO-FO-NAME
          END-NOREC
          MAO-FO-NAME := FO1.FO-NAME
        END-FIND
        /*
        MAO-RECORD-TYPE := 'M'
        WRITE WORK 2 VARIABLE MAO
        ADD 1 TO #CNT-MAIL
*
*
      END-FIND
      /*
      /*
    VALUE 'T'
      IF NOT #WARN
        /*
        /* Decompress archive records
        COMPCB-OP:='D'
        COMPCB-CHAR:='N'                             /* 'N' - New parm list
        SUBTRACT 1 FROM #RECORD-LENGTH
        COMPCB-ILEN := #RECORD-LENGTH
        COMPCB-ILEN-OLD := #RECORD-LENGTH   /* For compat
        IF #RECORD-LENGTH > 251
          COMPCB-ILEN := 251
          COMPCB-ILEN-OLD := 251            /* For compat
        END-IF
        CALLNAT 'R-NRMCMP' COMPCB #T-TEXT #F-TEXT
          G-NATRP-ERC G-NATRP-ERT
        #RECORD-LENGTH := COMPCB-OLEN
        RESET COMPCB-OLEN       /* Zero output length
        ADD 1 TO #RECORD-LENGTH
        #T-TEXT := #F-TEXT
        /*
        EXAMINE #TEXT-RECORD AND TRANSLATE USING #TABLE (*)
        WRITE WORK 2 VARIABLE #TEXT-RECORD-V(1:#RECORD-LENGTH)
        ADD 1 TO #CNT-TXT
      END-IF
    NONE VALUE
      IGNORE
  END-DECIDE
*
END-WORK
*
IF #CNT-TXT NE 0
  IF #LOG GT 2
    WRITE '  Act-Reps:' #CNT-AR 'DS-Reps:' #CNT-DR
      'Mail-Recs:' #CNT-MAIL 'Txt-Recs:' #CNT-TXT
  END-IF
END-IF
*
RESET #TEXT-RECORD
#T-RECORD-TYPE := 'E'
WRITE WORK 2 VARIABLE #TEXT-RECORD-V(1:1)
*
CLOSE WORK 1
CLOSE WORK 2
*
IF #LOG GT 1
  MOVE ALL '=' TO #MSG
  COMPRESS ' End reading archive' #XDIM INTO #MSG-1
  WRITE NOTITLE NOHDR #MSG
END-IF
*
IF #LOG GT 0
  COMPRESS #CNT-REP 'reports unloaded to' #PORTABLE-DSNAME-A(#XDIM) INTO #MSG
  WRITE 'Unload archive finished' *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
    / #MSG
END-IF
/*
/* Add entry to user log
PL-PARMS.LG-USERID      := *USER
PL-PARMS.LG-CODE        := 'UI'   /* User information
PL-PARMS.LG-OBJECT-NAME := *PROGRAM
COMPRESS #PORTABLE-DSNAME-A(#XDIM) 'created with' #CNT-REP 'reports.'
  INTO PL-PARMS.LG-MSG
CALLNAT 'RLOG' PL-PARMS
END TRANSACTION
/*
IF #CNT-WARN GT 0
  COMPRESS #CNT-WARN 'reports with no or uncomplete catalog data, not unloaded.'
    INTO #MSG
  WRITE #MSG
END-IF
*
END-SUBROUTINE
*
*
DEFINE SUBROUTINE BACKOUT
NOMUS-FUNCTION := NOMUS-FCT-BACKOUT
CALLNAT NOM-USER-MAINTENANCE
  NOMUS-NOMVERS NOMUS-PARMS (*)
*
IF NOMUS-ERROR-CODE NE 0
  PRINT '=' NOMUS-ERROR-CODE
  PRINT '=' NOMUS-ERROR-TEXT
END-IF
END-SUBROUTINE
*
*
*
*
*
IF *MACHINE-CLASS NE 'MAINFRAME'
  COMPRESS 'Machine-Class' *MACHINE-CLASS 'not supported.'
    INTO #MESSAGE
  WRITE #MESSAGE
  ESCAPE ROUTINE
END-IF
*
*
INPUT (AD=MIT'_' IP=OFF) 'Enter access code ..' #ACCESS-CODE
IF #ACCESS-CODE NE *PROGRAM
  WRITE 'Wrong access code. Stopping..'
  ESCAPE ROUTINE
END-IF
*
*
NOMUS-NOMVERS  := NOM-CURRENT-VERSION
NOMUS-USER     := *USER
NOMUS-LANGUAGE := *LANGUAGE
NOMUS-LOG-TYP  := 'U'
NOMUS-USER-ID  := *USER
RESET NOMUS-ERROR-CODE
  NOMUS-ERROR-TEXT
* read record from users file
RESET NOMUS-ATTR(*)
NOMUS-FUNCTION := NOMUS-FCT-READ
CALLNAT NOM-USER-MAINTENANCE
  NOMUS-NOMVERS NOMUS-PARMS (*)
IF NOMUS-ERROR-CODE NE 0
  PRINT '=' NOMUS-ERROR-CODE
  PRINT '=' NOMUS-ERROR-TEXT
  ESCAPE ROUTINE
END-IF
PERFORM BACKOUT
IF NOMUS-PROF-TYPE NE 'A'
  WRITE 'User' NOMUS-USER-ID 'is not an administrator. The type is'
    NOMUS-PROF-TYPE
    / 'Stopping ...'
  ESCAPE ROUTINE
END-IF
*
* Enter entry in Monitor log
*
PL-PARMS.LG-USERID := *USER
PL-PARMS.LG-CODE   :=  'MO'
COMPRESS 'Program' *PROGRAM 'started' INTO PL-PARMS.LG-MSG
CALLNAT 'RLOG' PL-PARMS
END TRANSACTION
*
*
*
WRITE '-' (26) (YEI)
  / 'Create Portable Archive(s)' (YEI)
  / '-' (26) (YEI)
*
COMPRESS
  H'00' '?' H'01' '?' H'02' '?' H'03' '?' H'04' '?' H'05' '?' H'06' '?'
  H'07' '?' H'08' '?' H'09' '?' H'0A' '?' H'0B' '?' H'0C' '?' H'0D' '?'
  H'0E' '?' H'0F' '?' H'10' '?' H'11' '?' H'12' '?' H'13' '?' H'14' '?'
  H'15' '?' H'16' '?' H'17' '?' H'18' '?' H'19' '?' H'1A' '?' H'1B' '?'
  H'1C' '?' H'1D' '?' H'1E' '?' H'1F' '?'
  H'20' '?' H'21' '?' H'22' '?' H'23' '?' H'24' '?' H'25' '?' H'26' '?'
  H'27' '?' H'28' '?' H'29' '?' H'2A' '?' H'2B' '?' H'2C' '?' H'2D' '?'
  H'2E' '?' H'2F' '?' H'30' '?' H'31' '?' H'32' '?' H'33' '?' H'34' '?'
  H'35' '?' H'36' '?' H'37' '?' H'38' '?' H'39' '?' H'3A' '?' H'3B' '?'
  H'3C' '?' H'3D' '?' H'3E' '?' H'3F' '?'
  TO #TABLE-A LEAVING NO
*
*
*
* #ARCHIVE-DSNAME := 'FHI.ARC350.NOM1482'
IF *OPSYS = MASK('BS2') THEN
  #ARCHIVE-DSNAME  := '$SAGESM.ARC.NOM.NOM0187'
* #PORTABLE-DSNAME := '$SAGESM.ARC.NOM.NOM0187.P'
* #PORTABLE-DSNAME := '$SAGESM.GGS.NOM.WORK01'
ELSE
  #ARCHIVE-DSNAME  := 'FHI.CDN350.NOM1507'
* #PORTABLE-DSNAME := 'FHI.CDN350.NOM1507.P'
* #PORTABLE-DSNAME := 'GGS.NOM.WORK01'
END-IF
#LOG := 2
*
FUNCTION_CODE := 5
L_FILE := 91
CALLNAT 'NAT23001' PARAMETER_BLOCK P_RESP
COMPRESS '(' DBID ',' FNR ')' INTO #NOM-AD LEAVING NO
*
*
* Check NOM Active Data (Lfile 91) for version
*  1. Check if DBID/FNR is defined and running
*  2. Check if a given field is defined on this FDT
*
L-DBID := DBID
L-FNR := FNR
*
* from TST.NOM351.JOBS.OLD(NOM35DBS)
*
* NEWFIELD FNDEF='01,J5,6,P,NU'
* NEWFIELD FNDEF='01,ZK,64,A,NU'
L-FIELD-SNAME(1) := 'J5'
L-FIELD-LEN(1)   := 6
L-FIELD-FOR(1)   := 'P'
L-FIELD-SNAME(2) := 'ZK'
L-FIELD-LEN(2)   := 64
L-FIELD-FOR(2)   := 'A'
*
FOR #IX = 1 TO LF-IX
*
* Subprogram N-DBFDT copied from SYSREVDB
* CALLNAT 'N-DBFDT' L-DBID L-FNR L-RSP L-FIELD-SNAME(#IX)
*   L-FIELD-LEN(#IX) L-FIELD-FOR(#IX) L-MATCH(#IX)
*
  RESET L-RSP L-MATCH(#IX)
*
  MOVE 'LF' TO CB-COM
  IF L-DBID > 255 OR L-FNR > 255 THEN
    MOVE H'30' TO CB-1ST
    MOVE L-DBID TO CB-RSP
    MOVE L-FNR TO CB-FILE
  ELSE
    MOVE L-DBID TO CB-DBID
    MOVE L-FNR TO CB-FNR
  END-IF
  MOVE 32766 TO CB-RBL
  RESET CB-FBL CB-SBL CB-VBL CB-IBL
  MOVE 'S' TO CB-CO2
  CALL 'CMADA' CB FB RB(*) SB VB IB #WORK
  IF CB-RSP NE H'0000' THEN
    L-RSP := CB-RSP
  ELSE
    MOVE P-LF-FIELD-NR TO FIELD-NR
    FOR I = 1 TO FIELD-NR
      MOVE P-LF-ENTRY-I(I) TO LF-ENTRY
      J := I + 1
      MOVE P-LF-ENTRY-I(J) TO NEXT-LF-ENTRY
      IF LF-INDIC = 'F' /* Field
        IF LF-NAME = L-FIELD-SNAME(#IX) AND
            LF-LENGTH = L-FIELD-LEN(#IX) AND
            LF-FORMAT = L-FIELD-FOR(#IX) THEN
          L-MATCH(#IX) := TRUE
          ESCAPE BOTTOM
        END-IF
      END-IF
    END-FOR
  END-IF
*   IF L-RSP NE 0
*     DECIDE ON FIRST VALUE OF L-RSP
*       VALUE 17
*         COMPRESS 'Invalid file number' L-FNR 'on DBID' L-DBID
*           INTO #MESSAGE
*         COMPRESS #MESSAGE '.' INTO #MESSAGE LEAVING NO
*       VALUE 148
*         COMPRESS 'DBID' L-DBID 'not active.' INTO #MESSAGE
*       NONE
*         COMPRESS 'Adabas rsp' L-RSP 'accessing DBID' L-DBID
*           'FNR' L-FNR INTO #MESSAGE
*         COMPRESS #MESSAGE '.' INTO #MESSAGE LEAVING NO
*     END-DECIDE
*   ELSE
*     IF NOT L-MATCH(#IX)
*       COMPRESS 'DBID' L-DBID 'and FNR' L-FNR 'is not a REVIEW-DB.'
*         INTO #MESSAGE
*     ELSE
*       COMPRESS 'ShortName' L-FIELD-SNAME(#IX) 'exists and has format'
*         L-FIELD-FOR(#IX)  'and length' L-FIELD-LEN(#IX)
*         INTO #MESSAGE
*     END-IF
*   END-IF
*
*   WRITE #IX #MESSAGE (AL=70)
END-FOR
*
DECIDE FOR EVERY CONDITION
  WHEN L-MATCH(1) AND L-MATCH(2)
    L-VERS := 35
    WRITE 'Reading from NOM35 Active Data (LFILE 91)' (TU) #NOM-AD
  WHEN NOT(L-MATCH(1) AND L-MATCH(2))
    L-VERS := 34
    WRITE 'Reading from NOM34 Active Data (LFILE 91)' (TU) #NOM-AD
  WHEN NONE
    L-VERS := 0
END-DECIDE
*
*
*
*
WRITE 'Create portable archive(s) for' (YEI)
IF *DEVICE = 'BATCH' OR *TPSYS = 'TSO' OR *OPSYS = MASK('BS2')
  /*
  IF *OPSYS = MASK('BS2')
    #SPACEP := 3840
    #SPACES := 768
    INPUT (AD=MIT'_' IP=OFF) #ARCHIVE-DSNAME
      / 'Space for a portable archive, Primary..' #SPACEP
      'Secondary ..' #SPACES
      / 'Log output ...................' #LOG '(0-3)'
  ELSE
    ALC-SPACE-TYPE := 'CYLINDER' /* TRACKS, BLOCKS
    ALC-SPACE-PRIMARY := 100
    ALC-SPACE-SECONDARY := 10
    INPUT (AD=MIT'_' IP=OFF) #ARCHIVE-DSNAME
      / 'Space for a portable archive, Type ..' ALC-SPACE-TYPE
      'Primary ..' ALC-SPACE-PRIMARY
      'Secondary ..' ALC-SPACE-SECONDARY
      / 'Log output ...................' #LOG '(0-3)'
  END-IF
  /*
  IF #ARCHIVE-DSNAME = SCAN('*') OR = SCAN('?')
    MASK := #ARCHIVE-DSNAME
    /* WILDCARD default is '?', ASTERISK default is '*'
    /* MATCHED return value 'Y' or 'N'
    READ AD1 BY AD-CREATED-INV /* = #RSTART
      FIELD := AD-ARCHIVE-DSNAME
      CALLNAT 'NAT00083' FIELD MASK WILDCARD ASTERISK LENGTH MATCHED
      IF MATCHED = 'Y'
        #ARCHIVE-DSNAME := AD-ARCHIVE-DSNAME
        PERFORM ADD-ARC-TO-ARRAY
      END-IF
    END-READ
  ELSE
    PERFORM ADD-ARC-TO-ARRAY
  END-IF
  /*
ELSE
  INPUT (AD=MIT'_' IP=OFF CD=NE)
    'Log output ...................' (TU) #LOG '(0-3)'
  /*
  PERFORM ADD-ARC-TO-ARRAY
END-IF
*
*
IF #LOG GT 1
  WRITE '-' (19)
    / 'Start processing... LOG level' #LOG
    /  '-' (19)
END-IF
*
FOR #XDIM = 1 TO *OCC(#ARCHIVE-DSNAME-A)
*
  IF #LOG GT 1
    MOVE ALL '=' TO #MSG
    COMPRESS ' Processing archive' #XDIM INTO #MSG-2
    WRITE NOTITLE NOHDR #MSG
  END-IF
  /*
  IF #LOG GT 0
    WRITE '  Reading from Work File 1' #ARCHIVE-DSNAME-A(#XDIM)
      / '  Writing to   Work File 2' #PORTABLE-DSNAME-A(#XDIM)
  END-IF
*
  IF *OPSYS = MASK('BS2') THEN  /* batch and online
    /*
    RESET PA-FILE
    RESET PA-VSNLIST(*)
    PA-NAME := #ARCHIVE-DSNAME-A(#XDIM)
    PA-LINK := 'W01'
    OPTIONS ECHECK=OFF
    CALLNAT 'USR2029N' PA-FILE PA-ERRTEXT PA-VSNLIST (*) PA-RC PA-RC2
    OPTIONS ECHECK=ON
    /* ***************************************************************
    /* CHECK RETURN CODE
    /* ***************************************************************
    DECIDE ON FIRST VALUE OF PA-RC
      VALUE 0
        RESET PA-FILE
        RESET PA-VSNLIST (*)
        WRITE 'USR2029N: Work file 1 allocated.'
        /*
        DEFINE WORK FILE 1 'W01' TYPE 'FORMATTED'
        /*
      NONE VALUE
        WRITE 'USR2029N ended with returncode' PA-RC ':'
        WRITE PA-ERRTEXT (AL=79)
        WRITE 'WORK FILE 1 not available, stopping...'
        STOP
    END-DECIDE
    PA-NAME := #PORTABLE-DSNAME-A(#XDIM)
    PA-LINK := 'W02'
    PA-BLKSIZE := '(STD,2)'  /* (A8)
    PA-RECFORM := 'V'      /* (A1)
    PA-FCBTYPE := 'SAM'
    PA-SPACEP := #SPACEP
    PA-SPACES := #SPACES
    /* PA-RECSIZE := 32756    /* (N5.0) does not matter for RECFORM V
    OPTIONS ECHECK=OFF
    CALLNAT 'USR2029N' PA-FILE PA-ERRTEXT PA-VSNLIST (*) PA-RC PA-RC2
    OPTIONS ECHECK=ON
    /* ***************************************************************
    /* CHECK RETURN CODE
    /* ***************************************************************
    DECIDE ON FIRST VALUE OF PA-RC
      VALUE 0
        RESET PA-FILE
        RESET PA-VSNLIST (*)
        WRITE 'USR2029N: Work file 2 allocated.'
        /*
        DEFINE WORK FILE 2 'W02' TYPE 'FORMATTED'
        /*
      NONE VALUE
        WRITE 'USR2029N ended with returncode' PA-RC ':'
        WRITE PA-ERRTEXT (AL=79)
        WRITE 'WORK FILE 2 not available, stopping...'
        STOP
    END-DECIDE
  ELSE /* z/OS
    IF *DEVICE = 'BATCH' OR *TPSYS = 'TSO'
      /*
      COMPRESS '''' #ARCHIVE-DSNAME-A(#XDIM) '''' INTO #WF-1 LEAVING NO
      COMPRESS '''' #PORTABLE-DSNAME-A(#XDIM) '''' INTO #WF-2 LEAVING NO
      /*
      DEFINE WORK FILE 1 #WF-1 TYPE 'FORMATTED'
      /*
      IF *OPSYS NE MASK('MVS') THEN
        WRITE NOTITLE 'USR2021N can be used under MVS only' (I)
        ESCAPE ROUTINE
      ELSE
        ALC-FUNCTION := 'UNALLOC'
        ALC-DDNAME := 'CMWKF02'
        OPTIONS ECHECK=OFF
        CALLNAT 'USR2021N' ALC USR2021N.EXTENDED-PARMS
        OPTIONS ECHECK=ON
        IF ALC-ERROR-CODE = 0 OR = H'0438' /* Specified ddname not found.
          IGNORE
        ELSE
          WRITE 'UNALLOC' ALC-ERROR-TEXT (AL=50) ALC-ERROR-CODE (EM=HHHH)
            ALC-INFO-CODE (EM=HHHH)
        END-IF
        /*
        ALC-FUNCTION := 'ALLOC'
        ALC-DDNAME := 'CMWKF02'
        ALC-DSNAME := #PORTABLE-DSNAME-A(#XDIM)
        ALC-DISP1 := 'NEW'
        /* Returns an error, if the dataset already exists.
        /* Processing continues with the existig dataset.
        /* ALC-DISP1 := 'OLD'
        /* ALC-DISP1 := 'SHR'
        /* ALC-DISP1 := 'MOD'
        ALC-DISP2 := 'CATLG'
        /* ALC-DISP2 := 'UNCATLG'
        /* ALC-DISP2 := 'KEEP'
        /* ALC-DISP2 := 'DELETE'
        /* ALC-SPACE-TYPE := 'CYLINDER'
        /* ALC-SPACE-TYPE := 'TRACKS'
        /* ALC-SPACE-TYPE := 'BLOCKS'
        /* ALC-SPACE-PRIMARY := 2
        /* ALC-SPACE-SECONDARY := 1
        ALC-DCB-RECFM := 'VB'
        ALC-DCB-BLKSZ := 4096
        ALC-DCB-LRECL := 4090
        IF ALC-UNIT NE ' ' AND ALC-VOLUME-SERIAL NE ' ' THEN
          ALC-UNIT := ' '
        END-IF
        ALC-SPACE-DIRECTORY := 0
        ALC-DCB-DSORG := 'PS'
        OPTIONS ECHECK=OFF
        CALLNAT 'USR2021N' ALC USR2021N.EXTENDED-PARMS
        OPTIONS ECHECK=ON
        IF ALC-ERROR-CODE = 0 OR = H'970C'
          /* 970C: Severe SMS VTOC service err => dataset already exists
          IGNORE
        ELSE
          WRITE '  ALLOC' ALC-ERROR-TEXT (AL=50) ALC-ERROR-CODE (EM=HHHH)
            ALC-INFO-CODE (EM=HHHH)
        END-IF
      END-IF
      /*
      DEFINE WORK FILE 2 #WF-2 TYPE 'FORMATTED'
    ELSE
      WRITE 'Environment not supported, try batch or TSO. Stopping...'
      STOP
*       FUNCTION  := 'G'
*       WORK-NUM  := 1
*       WORK-TYPE := 'D'
*       CALLNAT 'USR2011N'  USR2011L  USR2011N.EXTENDED-PARMS
*       USR8223N-DDNAME := WORK-FILE-A(1)
*       CALLNAT 'USR8223N' USR8223N-DDNAME USR8223N-DSNAME
*         USR8223N-RETURN-CODE
*       DECIDE ON FIRST VALUE OF USR8223N-RETURN-CODE
*         VALUE   0   COMPRESS 'Found DSNAME for DDNAME' USR8223N-DDNAME
*                       INTO MESSAGE
*           /*
*           DEFINE WORK FILE 1 'WF1' TYPE 'FORMATTED'
*           /*
*         VALUE   4   COMPRESS 'DSNAME for DDNAME' USR8223N-DDNAME 'not found'
*                       INTO MESSAGE
*         VALUE   8   MESSAGE := 'Program is not running under z/OS'
*         VALUE  12   MESSAGE := 'Invalid number of parameters for system call'
*         NONE VALUE  COMPRESS NUMERIC 'Unknown return code'
*                       USR8223N-RETURN-CODE INTO MESSAGE
*       END-DECIDE
*       PRINT 'Get z/OS Work File 1, Return code' USR8223N-RETURN-CODE
*         / 'Message ...' MESSAGE
*         / '  DDNAME ..' USR8223N-DDNAME
*         / '  DSNAME ..' USR8223N-DSNAME
*       IF USR8223N-RETURN-CODE NE 0
*         WRITE 'WORK FILE 1 not available, stopping...'
*         STOP
*       END-IF
*       FUNCTION  := 'G'
*       WORK-NUM  := 2
*       WORK-TYPE := 'D'
*       CALLNAT 'USR2011N'  USR2011L  USR2011N.EXTENDED-PARMS
*       USR8223N-DDNAME := WORK-FILE-A(1)
*       CALLNAT 'USR8223N' USR8223N-DDNAME USR8223N-DSNAME
*         USR8223N-RETURN-CODE
*       DECIDE ON FIRST VALUE OF USR8223N-RETURN-CODE
*         VALUE   0   COMPRESS 'Found DSNAME for DDNAME' USR8223N-DDNAME
*                       INTO MESSAGE
*           /*
*           DEFINE WORK FILE 2 'WF2' TYPE 'FORMATTED'
*           /*
*         VALUE   4   COMPRESS 'DSNAME for DDNAME' USR8223N-DDNAME 'not found'
*                       INTO MESSAGE
*         VALUE   8   MESSAGE := 'Program is not running under z/OS'
*         VALUE  12   MESSAGE := 'Invalid number of parameters for system call'
*         NONE VALUE  COMPRESS NUMERIC 'Unknown return code'
*                       USR8223N-RETURN-CODE INTO MESSAGE
*       END-DECIDE
*       PRINT 'Get z/OS Work File 2, Return code' USR8223N-RETURN-CODE
*         / 'Message ...' MESSAGE
*         / '  DDNAME ..' USR8223N-DDNAME
*         / '  DSNAME ..' USR8223N-DSNAME
*       IF USR8223N-RETURN-CODE NE 0
*         WRITE 'WORK FILE 2 not available, stopping...'
*         STOP
*       END-IF
    END-IF
    /*
  END-IF
  /*
  PERFORM HANDLE-ONE-ACHIVE
  /*
  ADD #CNT-REP  TO #CNT-TOTAL
  /*
END-FOR
*
REDUCE ARRAY #ARCHIVE-DSNAME-A TO 0
REDUCE ARRAY #PORTABLE-DSNAME-A TO 0
*
WRITE '-' (7) / 'Summary' / '-' (7)
COMPRESS #ARCS-TOTAL 'archive(s) with total' #CNT-TOTAL
  'reports unloaded.' INTO #MSG
WRITE #MSG
  / '-' (15)
  / 'End processing.'
  / '-' (15)
*
END
