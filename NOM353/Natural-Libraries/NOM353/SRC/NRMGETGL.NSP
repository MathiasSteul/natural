* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* NRMGETGL - COPY SESSION 49
*
* Maintenance
* mrs 91-12-13 s(141159) number of entries changed from 42 to 68
* mrs 93-10-26 s(999999) set steplibs if NSC not installed
* jwo 97-04-28 P(162034) add steplib SYSNOMS in non NSC environment
* jwo 97-09-18 p(164220) Replace Call 'CMMPP' with NAT00028
* jvd 98-09-18 p(164220) NOM141ÖNAT23
* jvd 99-09-16 p(186693) NAT31 ready
* fhi 00-01-28 s(191368) NOM142 changes merged to get NOM211 basis
* fhi 00-11-22 QA01      NAT22 dependencies disabled.
* xsetggr 01-06-19 p(209875) add steplibs with RSTEPLIB
* sju 02-02-25 NOM221    New lfile for active data
* sju 02-11-14 QA        Nat0082 in RACTLF-N in non-NSC environments
* fhi 03-07-23 p(242064) Unify steplib concatentation
* fhi 07-05-30 P297047   Replace RSTEPLIB, old comments deleted
* fhi 08-06-18 P296314   SAVE GDA for Unix
* fhi     2009-02-27 P300323 Rename RGETSTEP to NOMGSTEP delivered in SYSTEM
* fhi     2009-03-17 P296314 Don't save GDA under Unix
* bli     2012-09-19 NOMALL-94 remove old version checks
* SU1     2019-03-04 NOMALL-2243 init AIVs not done in NRMGETAI/NRMPUTAI
* ----------------------------------------------------------------------
*****************
DEFINE DATA GLOBAL USING NRM-GL
LOCAL USING NRM-028L  /*  parameters for NAT00028
LOCAL USING EDIT-CB
LOCAL USING RACTLF-A
LOCAL
1 EDIT-PREF
  2 L-PREFIX           (A2/1:14)
1 EDIT-DATA
  2 L-DATA             (A250/1)
1 EDIT-ALIN            (A14)
1 REDEFINE  EDIT-ALIN
  2 CB-ALIN-V          (N1/14)
1 EDIT-ADAT            (A14)
1 REDEFINE  EDIT-ADAT
  2 CB-ADAT-V          (N1/14)
1 I                    (N3)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
FORMAT LS=250
IF *MACHINE-CLASS = 'MAINFRAME'
  ED-DSTYPE  := 'DAT'
  ED-SESNUM  := 49
  ED-BPUSE   := 1
  ED-DTPLACE := 1
  ED-PRFLEN  := 2
  ED-PRFENT  := 2
  ED-LINENTL := 250
  ED-SCRLEN  := 250
  ED-RECLEN  := 250
  ED-SCRNUM  := 1
  ED-SCRMAX  := 1
  ED-RECMAX  := 80
  ED-RECTOP  := 1
  PROF-CAPS  := 'N'
  ED-REQUEST := 'GETL'
  FOR I = 1 TO *OCC(GLOBAL-SEGMENT)
    CALL 'EDITOR' EDIT-CB EDIT-ALIN EDIT-PREF EDIT-ADAT EDIT-DATA
    IF ED-ERRNUM NE 0
      G-NATRP-ERC := 3
      G-NATRP-ERT := ED-ERRNUM
      ESCAPE ROUTINE
    END-IF
    GLOBAL-SEGMENT (I) := L-DATA (1)
  END-FOR
*
END-IF
*ERROR-TA := 'NRMERRTA'
PERFORM ADD-STEPLIBS
RESET RACTLF-LOGGING RACTLF-ERROR-LOGGING
RACTLF-LFILE-1 := 91
RACTLF-LFILE-2 := 206
CALLNAT 'RACTLF-N' RACTLF-PARMS
IF RACTLF-ERROR-CODE NE 0
  WRITE *PROGRAM RACTLF-ERROR-CODE RACTLF-ERROR-TEXT
  WRITE *PROGRAM 'Dbid1:' RACTLF-DBID-1 'Fnr1:' RACTLF-FNR-1
  WRITE *PROGRAM 'Dbid2:' RACTLF-DBID-2 'Fnr2:' RACTLF-FNR-2
  G-NATRP-ERC:= RACTLF-ERROR-CODE
END-IF
CALLNAT 'RMSWNODE'  'L' 1 0 0 FALSE /* Get local monitor node SU1
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE ADD-STEPLIBS
************************************************************************
RESET G-NATRP-ERC G-NATRP-ERT
CALLNAT 'NOMGSTEP' '*' G-NATRP-ERC
LFILE := 204
*
END-SUBROUTINE /* ADD-STEPLIBS
*
END
