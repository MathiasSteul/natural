* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 5
* <Natural Source Header
* NOARSA-N - EOM API Active Reports Searched List
*             Read one buffer/logical page of data
*             Restart with given ISN number for next buffer/log. page
*             ==> basically a copy of NOARLS1N
*
* Maintenance:
* CF      2014-04-22 created (NOMALL-1392)
* ===> latest old changes from base routine NOARLS1N:
* XSETHZ  2013-01-04 ES-104 optimization (new descriptors in NRM-MAIL)
* XSETHZ  2013-02-14 ES-1499 (new descriptors in NRM-MAIL)
* XSETHZ  2013-03-25 ES-104 (new descriptors in NRM-MAIL)
* SU1     2013-08-28 remove unused variables
* RAYA    2013-09-12 NOMALL-1278 new superdescriptor for filtering mails
* SU2     2014-02-17 NOMALL-1278 compare correct dates
* ----------------------------------------------------------------------
* ===> new changes to be noted here:
* CF1     2014-04-29 NOMALL-1412 Correct filter for revived reports
* CF2     2015-02-06 NOMALL-1563 Provide list header without DB access
* fhi     2015-05-18 NOMALL-1552 Show real size, not base64 size
* SU3     2015-06-01 NOMALL-1552 Show size 1 (instead 0)
* BLI     2016-03-01 NOMALL-1829 Check flags A R L
* BLI     2016-11-02 NOMALL-1914 Check folder-num
* SU4     2018-02-15 NOMALL-1823 NOM 3.5: remove CONNECT
* fhi     2019-05-13 NOMALL-2272 Correct evaluation of time inverted
* HEB1    2020-09-28 NOMALL-2439 return error message to client/NOMLOG
* HEB2    2023-10-04 ES-34375    active help for keyword + and/or
************************************************************************
*
DEFINE DATA
PARAMETER USING ESMCNT-A
PARAMETER USING ESMINP-A
PARAMETER USING ESMWORKA
PARAMETER USING NOARLS-A
************************************************************************
LOCAL USING ESMCONSL
LOCAL USING NOARSL-A
LOCAL USING NADA2000
LOCAL USING NAD-MSG
LOCAL USING NAD-FLD
LOCAL USING VAREP1-L
LOCAL USING NOUSUP-L
LOCAL USING RMSPL--L
LOCAL USING CONST-L
*
LOCAL
1 DR VIEW OF NRM-DATASET-REPORT
  2 DR-EXPIRATION-DATE
1 MA VIEW OF NRM-MAIL
  2 MA-REPNAME
  2 MA-REPRNB
  2 MA-USERID
  2 MA-PROCESS-TIME-INV
  2 MA-PROCESS-TIME
  2 MA-FO-ID
  2 MA-STATUS
1 MA-N VIEW OF NRM-MAIL
  2 MA-FO-ID
1 FO VIEW OF NRM-FOLDER
  2 FO-ID
  2 FO-NAME
  2 FO-USER-ID
  2 FO-LINKED-FO-ID
  2 REDEFINE FO-LINKED-FO-ID
    3 FO-LINKED-USER-ID    (A8)
    3 FO-LINKED-ID         (B2)
1 FO-L VIEW OF NRM-FOLDER
  2 FO-ID
  2 FO-USER-ID
  2 FO-LINKED-FO-ID
  2 REDEFINE FO-LINKED-FO-ID
    3 FO-LINKED-USER-ID    (A8)
    3 FO-LINKED-ID         (B2)
1 BC VIEW OF NRM-BUNDLE-CONTENTS
1 USERS VIEW OF NRM-USERS
  2 USER-PROFILE
1 #I                       (I4)
1 #K                       (I4)
1 #L                       (I4)
1 #I2                      (I4)
1 #IMAX                    (I4)
1 #DATE-14                 (A14)
1 #F-DATE-C-PUR            (T)
1 #F-DATE-C                (T)
1 REDEFINE #F-DATE-C
  2 #F-DATE-C-P            (P13)
1 #T-DATE-C-PUR            (T)
1 #T-DATE-C                (T)
1 REDEFINE #T-DATE-C
  2 #T-DATE-C-P            (P13)
1 #REPORT-RNB              (A31)
1  REDEFINE #REPORT-RNB
  2 #REPNAME               (A25)
  2 #REPRNB                (P11)
  2 REDEFINE #REPRNB
    3 #REPRNB-A            (A6)
1 #SELECTED                (L)
1 #SOURCE-EXIST            (L)
1 #OPTIONS                 (A2/10)
1 #NEXT-FO-ID              (A5)
1 REDEFINE #NEXT-FO-ID
  2 #NEXT-FO-ID-N          (N5)
1 #NEXT-TIME               (A13)
1 REDEFINE #NEXT-TIME
  2 #NEXT-TIME-N           (N13)
/*
1 #MA-FOLDER-PROCESS-TIME          (A17)
1 REDEFINE #MA-FOLDER-PROCESS-TIME
  2 #MA-USERID             (A8)
  2 #MA-FO-ID              (B2)
  2 #MA-PROCESS-TIME       (P13)
1 #MA-FOLDER-PROCESS-TIME-E (A17)
1 #MA-FOLDER-REP-PROCESS-TIME      (A42)
1 REDEFINE #MA-FOLDER-REP-PROCESS-TIME
  2 #MAR-USERID            (A8)
  2 #MAR-FO-ID             (B2)
  2 #MAR-REPNAME           (A25)
  2 #MAR-PROCESS-TIME      (P13)
1 #MA-RNB-USER             (A14)
1 REDEFINE #MA-RNB-USER
  2 #MA-RNB                (P11)
  2 #MA-USER               (A8)
1 #FO-USERNAME             (A24)
1 REDEFINE #FO-USERNAME
  2 #FO-USER               (A8)
  2 #FO-NAME               (A16)
1 #S-USER-FO-ID            (A10)
1 REDEFINE #S-USER-FO-ID
  2 #S-USER                (A8)
  2 #S-FO-ID               (B2)
1 #BC-REPORT-RNB           (A31)
1 REDEFINE #BC-REPORT-RNB
  2 #BC-REPORT             (A25)
  2 #BC-REPRNB             (P11)
1 #TIME                    (T)
1 REDEFINE #TIME
  2 #TIME-P13              (P13)
1 #MA-FOLDER-REP           (A41)
1  REDEFINE #MA-FOLDER-REP
  2 #MA-FOLDER-USER-ID     (A8)
  2 #MA-FOLDER-ID          (B2)
  2 #MA-REP                (A25)
  2 #MA-RNBR               (P11)
1 #MA-FOLDER-REP-E         (A41)
1  REDEFINE #MA-FOLDER-REP-E
  2 #MA-FOLDER-USER-ID-E   (A8)
  2 #MA-FOLDER-ID-E        (B2)
  2 #MA-REP-E              (A25)
  2 #MA-RNB-E              (P11)
1 #MSG-NR                  (N4) INIT <6102>
1 #J                       (I2) INIT  <0014>
1 #HEADER                  (A20)
1 #NEXT                    (L)
1 #TT                      (T)
1 #NEW-OPTIONS             (A2/1:8)
1 #MA-REP-RNB              (A31)
1 REDEFINE #MA-REP-RNB
  2 #MA-REPORT             (A25)
  2 #MA-REPRNB             (P11)
1 #A4                      (A4)
1 REDEFINE #A4
  2 #I4                    (I4)
1 #ERC                     (N4)
1 #ERT                     (A250)
1 #RECNUM                  (I4)
1 #BIN-SIZE                (I4)
1 #LOC                     (A1)   INIT <'*'>
1 #SOURCE-F                (A17)
1 #SOURCE-T                (A17)
1 #SENDER-F                (A17)
1 #SENDER-T                (A17)
1 #BIN-REPNAME             (A25)
1 #BIN-REPRNB              (P11)
1 #GR-USERID               (A8)
1 #GR-NAME                 (A25)
1 #OWNER-REPORT            (L)
1 #FO-ID-N                 (N5)
1 REDEFINE #FO-ID-N
  2 #FO-ID-A               (A5)
1 #GRANTS                  (A1/6)
1 #MY-FOLDER               (L)  INIT <TRUE>
1 #FO-USER-FO-ID           (A10)
1 REDEFINE #FO-USER-FO-ID
  2 #FO-USER-ID            (A8)
  2 #FO-ID                 (B2)
1 #START-ISN-N             (N10)
1 REDEFINE #START-ISN-N
  2 #START-ISN-A           (A10)
1 #START-ISN-S             (N10)
1 #START-IN-SET            (N10)
1 #ISN-SET                 (A16)
1 #NUMBER-IN-SET           (I4)
1 #TIMEOUT                 (T)
1 #MA-L-FOLDER-REP         (A42)
1 REDEFINE #MA-L-FOLDER-REP
  2 #MA-CURRENT-LOC-R      (A1)
  2 #MA-USERID-R           (A8)
  2 #MA-FO-ID-R            (B2)
  2 #MA-REP-R              (A25)
  2 #MA-RNB-R              (P11)
1 #MA-L-FOLDER-REP-E       (A42)
1 #MA-L-FOLDER-PROCESS-TIME (A18)
1 REDEFINE #MA-L-FOLDER-PROCESS-TIME
  2 #MA-CURRENT-LOC-T       (A1)
  2 #MA-USERID-T            (A8)
  2 #MA-FO-ID-T             (B2)
  2 #MA-PROCESS-TIME-T      (P13)
1 #MA-L-FOLDER-PROCESS-TIME-E (A18)
*
1 #RETRIEVE                (I4)
1 #NATRP-ERC               (N4)                         /* HEB1
1 #NATRP-ERT               (A250)                       /* HEB1
1 #KY-SEL                  (A15/1:4)                    /* HEB2 >
1 #NUM                     (I2)
1 #L1                      (I2)
1 #L2                      (I2)
1 #L3                      (I2)
1 #L4                      (I2)                         /* HEB2 <
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET ES-RC ES-NUMBER ES-STARTINDEX #TT ES-INVCOL-NUM
/*
/* Set the number of records to be retrieved
IF ES-NEXT-KEY-PARM(4) NE ' ' AND ES-NEXT-KEY-PARM(4) IS (I4)
  #RETRIEVE := VAL(ES-NEXT-KEY-PARM(4))
END-IF
/*
IF ES-CLIENT-TIMEOUT > 10 AND ES-CLIENT-TIMEOUT < 9999
  #TIMEOUT := *TIMX + (ES-CLIENT-TIMEOUT - 10) * 10
ELSE
  #TIMEOUT := *TIMX + 450
END-IF
ES-EOF := 'X'
#NOARSL := ES-SELECT
EXAMINE #NOARSL.#SOURCE FOR '*' DELETE
EXAMINE #NOARSL.#SENDER FOR '*' DELETE
COMPRESS #NOARSL.#SOURCE H'00' TO #SOURCE-F LEAVING NO
COMPRESS #NOARSL.#SOURCE H'FF' TO #SOURCE-T LEAVING NO
COMPRESS #NOARSL.#SENDER H'00' TO #SENDER-F LEAVING NO
COMPRESS #NOARSL.#SENDER H'FF' TO #SENDER-T LEAVING NO
/* HEB2 >
#KY-SEL (1)   := #NOARSL.#KEYWORD
#KY-SEL (2:4) := #NOARSL.#KEYWORD-2-4 (1:3)
IF #KY-SEL (*) = '*'
    AND #KEYWORD-AND-OR NE 'A'
  RESET #KY-SEL (*)
END-IF
EXAMINE #KY-SEL (1) FOR '*' REPLACE WITH ' '
  GIVING NUMBER #NUM LENGTH #L1
IF #L1 < 1 OR #NUM = 0      #L1 := 15 END-IF
EXAMINE #KY-SEL (2) FOR '*' REPLACE WITH ' '
  GIVING NUMBER #NUM LENGTH #L2
IF #L2 < 1 OR #NUM = 0      #L2 := 15 END-IF
EXAMINE #KY-SEL (3) FOR '*' REPLACE WITH ' '
  GIVING NUMBER #NUM LENGTH #L3
IF #L3 < 1 OR #NUM = 0      #L3 := 15 END-IF
EXAMINE #KY-SEL (4) FOR '*' REPLACE WITH ' '
  GIVING NUMBER #NUM LENGTH #L4
IF #L4 < 1 OR #NUM = 0      #L4 := 15 END-IF
/* HEB2 <
FIND USERS WITH USER-ID = ES-USER
  PROFILE-STRING := USER-PROFILE
END-FIND
EXAMINE #NOARSL.#KEYWORD FOR '*' DELETE
EXAMINE #NOARSL.#REPNAME FOR '*' DELETE
PERFORM INIT-DAT-KEY
IF ES-KEY-CODE(3) = 'LC'
  #LOC := ES-KEY-PARM(3)
END-IF
ES-OPTION-COUNT := 10
/*
DECIDE ON FIRST VALUE OF ES-FUNCTION
  VALUE 'SA3', 'SA4'
    /* Active Reports in Summary Report (first page / next page)
    ES-SORTKEY := 0
    ES-SORTORDER := 1
    IF #NOARSL.#SOURCE NE ' ' OR #NOARSL.#SENDER NE ' '
      ES-SORTKEY := 13
      ES-SORTORDER := 0
    END-IF
    #IMAX := 130
    ES-FIELD-COUNT := 14
    NOARL1-FIELD-LENGTH(1:2)  := 812
    NOARL1-FIELD-LENGTH(3)    := 911
    NOARL1-FIELD-LENGTH(4:5)  := 909
    NOARL1-FIELD-LENGTH(6:8)  := 1
    NOARL1-FIELD-LENGTH(9:11) := 808
    NOARL1-FIELD-LENGTH(12)   := 10
    NOARL1-FIELD-LENGTH(13)   := 50
    NOARL1-FIELD-LENGTH(14)   := 33
    /*
    IF #RETRIEVE = 0  /* Return list header only           /* CF2 ->
      ES-NUMBER := 1
      ES-STARTINDEX := 2
      PERFORM LIST-HEADER-IN-FOLDER-REPORT
    ELSE                                                   /* CF2 <-
      PERFORM LIST-ACTIVE-REPORTS-IN-FOLDER-REPORT
    END-IF                                                 /* CF2
    /*
  VALUE 'SA1', 'SA2'
    /* Active Reports in Folder (first page / next page)
    IF PROF-AR-SORT = 'D' OR #NOARSL.#REPNAME = ' ' OR='*'
      ES-SORTKEY := 2
      ES-SORTORDER := 1
    ELSE
      ES-SORTKEY := ES-SORTORDER := 0
    END-IF
    IF #NOARSL.#SOURCE NE ' ' OR #NOARSL.#SENDER NE ' '
      ES-SORTKEY := 14
      ES-SORTORDER := 0
    END-IF
    #IMAX := 115
    ES-FIELD-COUNT := 15
    NOARL2-FIELD-LENGTH(1)     := 25
    NOARL2-FIELD-LENGTH(2)     := 911
    NOARL2-FIELD-LENGTH(3:4)   := 812
    NOARL2-FIELD-LENGTH(5:6)   := 909
    NOARL2-FIELD-LENGTH(7:9)   := 1
    NOARL2-FIELD-LENGTH(10:12) := 808
    NOARL2-FIELD-LENGTH(13)    := 10
    NOARL2-FIELD-LENGTH(14)    := 50
    NOARL2-FIELD-LENGTH(15)    := 33
    /*
    IF #RETRIEVE = 0  /* Return list header only           /* CF2 ->
      ES-NUMBER := 1
      ES-STARTINDEX := 2
      PERFORM LIST-HEADER-IN-FOLDER
    ELSE                                                   /* CF2 <-
      PERFORM LIST-ACTIVE-REPORTS-IN-FOLDER
    END-IF                                                 /* CF2
    /*
  NONE VALUE IGNORE
END-DECIDE
/*
/*
************************************************************************
* Internal subroutines:
*
************************************************************************
DEFINE SUBROUTINE LIST-ACTIVE-REPORTS-IN-FOLDER
************************************************************************
/* SA1 : Get data buffers for first page
/* SA2 : Get data buffers for next page
/*
COMPRESS ES-USER *PROGRAM TO #ISN-SET LEAVING NO
IF ES-NEXT-KEY-PARM(1) NE ' ' AND ES-FUNCTION = 'SA1'
  #START-ISN-A := ES-NEXT-KEY-PARM(1)
  #START-ISN-S := #START-IN-SET := #START-ISN-N
  ES-STARTINDEX := 1
ELSE
  IF ES-FUNCTION = 'SA1'
    ES-STARTINDEX := 2
    ADD 1 TO #RETRIEVE
    #I2 := ES-NUMBER := 1
    RESET #START-IN-SET #START-ISN-S #START-ISN-N
    PERFORM LIST-HEADER-IN-FOLDER                          /* CF2 ->
*     RESET INITIAL #J
*     PERFORM GET-TEXT
*     COMPRESS LONG-MSG(#J) TO NOARL2-HEADER(1) LEAVING NO
*     SUBTRACT 1 FROM #J
*     FOR #I = #J TO 1 STEP -1
*       COMPRESS  LONG-MSG(#I) C-HEADER-DELIMITER NOARL2-HEADER(1)
*         TO NOARL2-HEADER(1) LEAVING NO
*     END-FOR
*     COMPRESS NOARL2-HEADER(1) C-HEADER-DELIMITER LONG-MSG(16)
*       TO NOARL2-HEADER(1) LEAVING NO                     /* CF2 <-
  ELSE
    #START-ISN-A := ES-NEXT-KEY-PARM(1)
    #START-ISN-S := #START-IN-SET := #START-ISN-N
    ES-STARTINDEX := 1
  END-IF
  #FO-USER := ES-USER
  #FO-NAME := ES-KEY-PARM(1)
  IF #FO-NAME = '#Inbasket' OR = '#Listeneingang'
    #S-USER := #FO-USER
    #S-FO-ID := 1
    FIND FO WITH FO-USER-FO-ID = #S-USER-FO-ID
      #FO-NAME := FO.FO-NAME
    END-FIND
  END-IF
  RESET #FO-ID-N
  FIND FO WITH FO-USER-NAME = #FO-USERNAME
    FO-L.FO-ID           := FO.FO-ID
    FO-L.FO-USER-ID      := FO.FO-USER-ID
    FO-L.FO-LINKED-FO-ID := FO.FO-LINKED-FO-ID
    #MA-USERID := FO-L.FO-USER-ID
    #MA-FO-ID := FO-L.FO-ID
    R. REPEAT WHILE FO-L.FO-LINKED-FO-ID NE ' '
      #S-USER  := FO-L.FO-LINKED-USER-ID
      #S-FO-ID := FO-L.FO-LINKED-ID
      FIND FO-L WITH FO-USER-FO-ID = #S-USER-FO-ID
        IF NO RECORDS FOUND
          ESCAPE BOTTOM (R.)
        END-NOREC
        #MA-USERID := FO-L.FO-USER-ID
        #MA-FO-ID := FO-L.FO-ID
      END-FIND
    END-REPEAT
    PERFORM GET-FOLDER-GRANTS
  END-FIND
  #MA-FOLDER-USER-ID := #MA-USERID
  #MA-FOLDER-ID := #MA-FO-ID
  #MA-PROCESS-TIME := #T-DATE-C-P
  #MA-FOLDER-PROCESS-TIME-E := #MA-FOLDER-PROCESS-TIME
  #MA-PROCESS-TIME := #F-DATE-C-P
  EXAMINE #NOARSL.#REPNAME FOR '*' DELETE
  IF #NOARSL.#POSTFIX NE 'Y'
    COMPRESS #NOARSL.#REPNAME H'FF' TO #MA-REP LEAVING NO
    #MA-FOLDER-REP-E := #MA-FOLDER-REP
    #MA-REP := #NOARSL.#REPNAME
  ELSE
    #MA-REP := H'FF'
    #MA-FOLDER-REP-E := #MA-FOLDER-REP
    #MA-REP := ' '
  END-IF
  #MA-USERID-R := #MA-USERID-T := #MA-USERID
  #MA-FO-ID-R := #MA-FO-ID-T := #MA-FO-ID
  IF #LOC ='A' OR='B' OR='D' OR='S'
    #MA-CURRENT-LOC-R := #LOC
  ELSE
    IF #NOARSL.#ARCHIVE = '*'
      #MA-CURRENT-LOC-R := 'A'
    ELSE
      IF #NOARSL.#LOCATION ='A' OR='D' OR='S'
        #MA-CURRENT-LOC-R := #NOARSL.#LOCATION
      END-IF
    END-IF
  END-IF
  IF #MA-CURRENT-LOC-R ='D' OR='S'
    #MA-CURRENT-LOC-R := 'B'
  END-IF
  IF #NOARSL.#ARCHIVE = '*' AND #NOARSL.#REVIVE = '*'     /* CF1 ->
    #MA-CURRENT-LOC-R := 'B'
  END-IF                                                  /* CF1 <-
  #MA-CURRENT-LOC-T := #MA-CURRENT-LOC-R
  #MA-REP-R := #MA-REP-E
  #MA-RNB-R := 99999999999
  #MA-L-FOLDER-REP-E := #MA-L-FOLDER-REP
  #MA-REP-R := #MA-REP
  #MA-RNB-R := 0
  #MA-PROCESS-TIME-T := #T-DATE-C-P
  #MA-L-FOLDER-PROCESS-TIME-E := #MA-L-FOLDER-PROCESS-TIME
  #MA-PROCESS-TIME-T := #F-DATE-C-P
  IF (#LOC = 'A' OR='B' OR='D' OR='S') OR #NOARSL.#ARCHIVE = '*' OR
      (#NOARSL.#LOCATION ='A' OR='D' OR='S')
    IF #MA-REP NE ' ' OR #MA-REP =  ' ' AND
        #CREAT-DATE-FROM = ' ' AND #CREAT-DATE-TO = ' '
      FL1. FIND NUMBER MA WITH MA-LOC-USER-FOLDER-REP-RNB =
        #MA-L-FOLDER-REP THRU #MA-L-FOLDER-REP-E
        RETAIN AS #ISN-SET
      #NUMBER-IN-SET := *NUMBER (FL1.)
    END-IF
    IF (#CREAT-DATE-FROM NE ' ' OR #CREAT-DATE-TO NE ' ')
      IF #NUMBER-IN-SET > 0
        FL2. FIND NUMBER MA WITH MA-LOC-USER-FOLDER-PROCESS-TIME =
          #MA-L-FOLDER-PROCESS-TIME THRU
          #MA-L-FOLDER-PROCESS-TIME-E AND #ISN-SET
          RETAIN AS #ISN-SET
        #NUMBER-IN-SET := *NUMBER (FL2.)
      ELSE
        FL3. FIND NUMBER MA WITH MA-LOC-USER-FOLDER-PROCESS-TIME =
          #MA-L-FOLDER-PROCESS-TIME THRU
          #MA-L-FOLDER-PROCESS-TIME-E RETAIN AS #ISN-SET
        #NUMBER-IN-SET := *NUMBER (FL3.)
      END-IF
    END-IF
  ELSE
    IF #MA-REP NE ' ' OR #MA-REP =  ' ' AND
        #CREAT-DATE-FROM = ' ' AND #CREAT-DATE-TO = ' '
      FN1. FIND NUMBER MA
        WITH MA-FOLDER-REP-RNB = #MA-FOLDER-REP THRU #MA-FOLDER-REP-E
        RETAIN AS #ISN-SET
      #NUMBER-IN-SET := *NUMBER (FN1.)
    END-IF
    IF (#CREAT-DATE-FROM NE ' ' OR #CREAT-DATE-TO NE ' ')
      IF #NUMBER-IN-SET > 0
        FN2. FIND NUMBER MA
          WITH MA-FOLDER-PROCESS-TIME =
          #MA-FOLDER-PROCESS-TIME THRU #MA-FOLDER-PROCESS-TIME-E
          AND #ISN-SET RETAIN AS #ISN-SET
        #NUMBER-IN-SET := *NUMBER (FN2.)
      ELSE
        FN3. FIND NUMBER MA
          WITH MA-FOLDER-PROCESS-TIME =
          #MA-FOLDER-PROCESS-TIME THRU #MA-FOLDER-PROCESS-TIME-E
          RETAIN AS #ISN-SET
        #NUMBER-IN-SET := *NUMBER (FN3.)
      END-IF
    END-IF
  END-IF
END-IF
/*
* PRINT *PROGRAM *LINE 'HEB-KY' '=' #NOARSL  /* HEB-TEMP
/* Retrieve data basing on ISN list (new or onward reading)
RESET ES-WORK
FS2. FIND MA WITH #ISN-SET STARTING WITH ISN = #START-IN-SET
  #START-ISN-S := #START-ISN-N
  #START-ISN-N := *ISN(FS2.)
  #REPORT-RNB.#REPNAME := MA-REPNAME
  #REPRNB  := MA-REPRNB
  IF *TIMX > #TIMEOUT
    #START-ISN-N := #START-ISN-S
    ES-NEXT-KEY-PARM(1) := #START-ISN-A
    RESET ES-EOF
    ESCAPE BOTTOM (FS2.)
  END-IF
  FNDAR2. FIND ACTIVE-REPORTS WITH AR-REPORT-RNB = #REPORT-RNB
    RESET #OWNER-REPORT
    IF AR-USERID = ES-USER
      #OWNER-REPORT := TRUE
    END-IF
    PERFORM SELECT-RECORD
    IF #SELECTED
      ADD 1 TO #I2
      IF #I2 GT #IMAX OR #I2 GT #RETRIEVE
        #START-ISN-N := #START-ISN-S
        ES-NEXT-KEY-PARM(1) := #START-ISN-A
        ES-NUMBER := #I2 - 1
        IF #I2 LE #RETRIEVE
          RESET ES-EOF
        END-IF
        ESCAPE BOTTOM (FS2.)
      END-IF
      PERFORM DATA-TO-PDA
      ES-NUMBER := #I2
    END-IF
  END-FIND
END-FIND
/*
IF ES-EOF = 'X'
  RELEASE SET #ISN-SET
ELSE
  SUBTRACT ES-NUMBER FROM #RETRIEVE
  ES-NEXT-KEY-PARM(4) := #RETRIEVE
END-IF
/* Further buffers of same conversation always read with SA1
ES-FUNCTION := 'SA1'
/*
END-SUBROUTINE /* LIST-ACTIVE-REPORTS-IN-FOLDER
*
************************************************************************
DEFINE SUBROUTINE LIST-ACTIVE-REPORTS-IN-FOLDER-REPORT
************************************************************************
/* SA3 : Get data buffers for first page
/* SA4 : Get data buffers for next page
/*
#MAR-REPNAME := ES-KEY-PARM(3)
IF ES-NEXT-KEY-PARM(1) NE ' ' AND ES-FUNCTION = 'SA3'
  #MAR-USERID := ES-NEXT-KEY-PARM(1)
  #NEXT-FO-ID := ES-NEXT-KEY-PARM(2)
  #MAR-FO-ID := #NEXT-FO-ID-N
  #NEXT-TIME := ES-NEXT-KEY-PARM(3)
  #MAR-PROCESS-TIME := #NEXT-TIME-N
  #S-USER := #MAR-USERID
  #S-FO-ID := #MAR-FO-ID
  FIND FO WITH FO-USER-FO-ID = #S-USER-FO-ID
  END-FIND
ELSE
  IF ES-FUNCTION = 'SA3'
    ES-STARTINDEX := 2
    ADD 1 TO #RETRIEVE
    #I2 := ES-NUMBER := 1
    PERFORM LIST-HEADER-IN-FOLDER-REPORT                   /* CF2 ->
*     RESET INITIAL #J
*     PERFORM GET-TEXT
*     COMPRESS LONG-MSG(#J) TO NOARL1-HEADER(1) LEAVING NO
*     SUBTRACT 1 FROM #J
*     FOR #I = #J TO 5 STEP -1
*       COMPRESS  LONG-MSG(#I) C-HEADER-DELIMITER NOARL1-HEADER(1)
*         TO NOARL1-HEADER(1) LEAVING NO
*     END-FOR
*     COMPRESS LONG-MSG(2) C-HEADER-DELIMITER NOARL1-HEADER(1)
*       TO NOARL1-HEADER(1) LEAVING NO
*     COMPRESS LONG-MSG(4) C-HEADER-DELIMITER NOARL1-HEADER(1)
*       TO NOARL1-HEADER(1) LEAVING NO
*     COMPRESS LONG-MSG(3) C-HEADER-DELIMITER NOARL1-HEADER(1)
*       TO NOARL1-HEADER(1) LEAVING NO
*     COMPRESS NOARL1-HEADER(1) C-HEADER-DELIMITER LONG-MSG(16)
*       TO NOARL1-HEADER(1) LEAVING NO                     /* CF2 <-
  ELSE
    #MAR-USERID := ES-NEXT-KEY-PARM(1)
    #NEXT-FO-ID := ES-NEXT-KEY-PARM(2)
    #MAR-FO-ID := #NEXT-FO-ID-N
    #NEXT-TIME := ES-NEXT-KEY-PARM(3)
    #MAR-PROCESS-TIME := #NEXT-TIME-N
    #S-USER := #MAR-USERID
    #S-FO-ID := #MAR-FO-ID
    FIND FO WITH FO-USER-FO-ID = #S-USER-FO-ID
    END-FIND
  END-IF
  #FO-USER := ES-USER
  #FO-NAME := ES-KEY-PARM(1)
  IF #FO-NAME = '#Inbasket' OR = '#Listeneingang'
    #S-USER := #FO-USER
    #S-FO-ID := 1
    FIND FO WITH FO-USER-FO-ID = #S-USER-FO-ID
      #FO-NAME := FO.FO-NAME
    END-FIND
  END-IF
  RESET #FO-ID-N
  FIND FO WITH FO-USER-NAME = #FO-USERNAME
    #MAR-USERID := FO-USER-ID
    #MAR-FO-ID  := FO-ID
    #MAR-PROCESS-TIME       := #F-DATE-C-P
    PERFORM GET-FOLDER-GRANTS
  END-FIND
END-IF
/*
/* Retrieve data basing on search criteria (new or onward reading)
RESET ES-WORK
FS3. REPEAT WHILE FO.FO-USER-ID NE ' '
  READ MA BY MA-FOLDER-REP-PROCESS-TIME = #MA-FOLDER-REP-PROCESS-TIME
    IF MA.MA-USERID NE #MAR-USERID OR MA.MA-FO-ID NE #MAR-FO-ID
    OR MA-REPNAME NE #MAR-REPNAME OR MA-PROCESS-TIME-INV >   #T-DATE-C-P
      ESCAPE BOTTOM
    END-IF
    RESET #NEXT
    #MA-RNB := MA-REPRNB
    FO-L.FO-LINKED-FO-ID := FO.FO-LINKED-FO-ID
    REPFOL2. REPEAT WHILE FO-L.FO-LINKED-USER-ID NE ' '
      #MA-USER := FO-L.FO-LINKED-USER-ID
      FIND MA-N WITH MA-RNB-USER = #MA-RNB-USER
          WHERE MA-N.MA-FO-ID = FO-L.FO-LINKED-ID
        #NEXT := TRUE
        ESCAPE BOTTOM (REPFOL2.)
      END-FIND
      #S-USER := FO-L.FO-LINKED-USER-ID
      #S-FO-ID := FO-L.FO-LINKED-ID
      FIND FO-L WITH FO-USER-FO-ID = #S-USER-FO-ID
        IF NO RECORDS FOUND
          ESCAPE BOTTOM (REPFOL2.)
        END-NOREC
      END-FIND
    END-REPEAT
    REJECT IF #NEXT
    ADD 1 TO #I2
    IF #I2 GT #IMAX OR #I2 GT #RETRIEVE
      ES-NEXT-KEY-PARM(1) := MA.MA-USERID
      #NEXT-FO-ID-N := MA.MA-FO-ID
      ES-NEXT-KEY-PARM(2) := #NEXT-FO-ID
      #NEXT-TIME-N := MA-PROCESS-TIME-INV
      ES-NEXT-KEY-PARM(3) := #NEXT-TIME
      ES-NUMBER := #I2 - 1
      IF #I2 LE #RETRIEVE
        RESET ES-EOF
      END-IF
      ESCAPE BOTTOM (FS3.)
    END-IF
    #REPORT-RNB.#REPNAME := MA-REPNAME
    #REPRNB  := MA-REPRNB
    FIND ACTIVE-REPORTS WITH AR-REPORT-RNB = #REPORT-RNB
      IF NO RECORDS FOUND
        #I2 := ES-NUMBER
        ESCAPE BOTTOM
      END-NOREC
      RESET #OWNER-REPORT
      IF AR-USERID = ES-USER
        #OWNER-REPORT := TRUE
      END-IF
      PERFORM SELECT-RECORD
      IF #SELECTED
        PERFORM DATA-TO-PDA
        ES-NUMBER := #I2
      ELSE
        #I2 := ES-NUMBER
      END-IF
    END-FIND
  END-READ
  FO.FO-USER-ID := ' '
  IF FO.FO-LINKED-FO-ID NE ' '
    #S-USER := FO.FO-LINKED-USER-ID
    #S-FO-ID := FO.FO-LINKED-ID
    FIND FO WITH FO-USER-FO-ID = #S-USER-FO-ID
      #MAR-USERID := FO-USER-ID
      #MAR-FO-ID := FO-ID
      #MAR-PROCESS-TIME := #F-DATE-C-P
    END-FIND
  END-IF
END-REPEAT
IF ES-EOF = ' '
  SUBTRACT ES-NUMBER FROM #RETRIEVE
  ES-NEXT-KEY-PARM(4) := #RETRIEVE
END-IF
/* Further buffers of same conversation always read with SA3
ES-FUNCTION := 'SA3'
*
END-SUBROUTINE /* LIST-ACTIVE-REPORTS-IN-FOLDER-REPORT
*
************************************************************************
DEFINE SUBROUTINE INIT-DAT-KEY
************************************************************************
IF #CREAT-DATE-FROM = ' '
  MOVE EDITED '19010101000000' TO #F-DATE-C-PUR(EM=YYYYMMDDHHIISS)
  #T-DATE-C-P := #CONST-INV-TIME
ELSE
  IF #CREAT-TIME-FROM = ' '
    COMPRESS #CREAT-DATE-FROM '000000' TO #DATE-14 LEAVING NO
  ELSE
    COMPRESS #CREAT-DATE-FROM SUBSTRING(#CREAT-TIME-FROM,1,4) '00'
      TO #DATE-14 LEAVING NO
  END-IF
  MOVE EDITED #DATE-14 TO #T-DATE-C(EM=YYYYMMDDHHIISS)
  #F-DATE-C-PUR := #T-DATE-C
  #T-DATE-C-P := #CONST-INV-TIME - #T-DATE-C-P
END-IF
IF #CREAT-DATE-TO = ' '
  MOVE EDITED '20991231235959' TO #T-DATE-C-PUR(EM=YYYYMMDDHHIISS)
  #F-DATE-C-P := 0
ELSE
  IF #CREAT-TIME-TO = ' '
    COMPRESS #CREAT-DATE-TO '235959' TO #DATE-14 LEAVING NO
  ELSE
    COMPRESS #CREAT-DATE-TO SUBSTRING(#CREAT-TIME-TO,1,4) '59'
      TO #DATE-14 LEAVING NO
  END-IF
  MOVE EDITED #DATE-14 TO #F-DATE-C(EM=YYYYMMDDHHIISS)
  #T-DATE-C-PUR := #F-DATE-C
  #F-DATE-C-P := #CONST-INV-TIME - #F-DATE-C-P
END-IF
*
END-SUBROUTINE /* INIT-DAT-KEY
*
************************************************************************
DEFINE SUBROUTINE SELECT-RECORD
************************************************************************
#SELECTED := TRUE
IF #LOC NE '*'
    AND (#LOC NE 'B' AND ACTIVE-REPORTS.AR-CURRENT-LOCATION NE #LOC
    OR #LOC ='B' AND NOT(ACTIVE-REPORTS.AR-CURRENT-LOCATION='S' OR='D'))
  #SELECTED := FALSE
  ESCAPE ROUTINE
END-IF
IF ES-USER-TYPE NE 'A' AND ES-FUNCTION = 'LSA'
  #MA-USER:= ES-USER
  #MA-REPORT:= ACTIVE-REPORTS.AR-REPNAME
  #MA-REPRNB:= ACTIVE-REPORTS.AR-REPRNB
  #MA-RNB := ACTIVE-REPORTS.AR-REPRNB
  FNDMA. FIND NUMBER MA WITH MA-RNB-USER = #MA-RNB-USER
    AND  MA-REP-RNB  = #MA-REP-RNB
  IF *NUMBER(FNDMA.) = 0
    RESET #SELECTED
  END-IF
END-IF
IF #NOARSL NE ' '
  /* PRINT *PROGRAM *LINE 'HEB-KY >>>' '=' #NOARSL  /* HEB-TEMP
  /* / '1' #KY-SEL(1) / '2' #KY-SEL(2) / '3' #KY-SEL(3) / '4' #KY-SEL(4)
  DECIDE FOR EVERY CONDITION
    WHEN #NOARSL.#SOURCE NE ' ' AND
        NOT (ACTIVE-REPORTS.AR-SOURCE = #SOURCE-F THRU #SOURCE-T)
      #SELECTED := FALSE
      ESCAPE ROUTINE
*   WHEN #NOARSL.#KEYWORD NE ' '                         /* HEB2 > --
*     EXAMINE #NOARSL.#KEYWORD FOR H'00' GIVING LENGTH #L
*     FOR #K = 1 TO 6
*       IF SUBSTRING(ACTIVE-REPORTS.AR-KEYWORDS(#K),1,#L)
*           = #NOARSL.#KEYWORD
*         ESCAPE BOTTOM
*       END-IF
*     END-FOR
*     IF #K > 6
*       #SELECTED := FALSE
*       ESCAPE ROUTINE
*     END-IF                                             /* HEB2 <
    WHEN #KY-SEL (*) NE ' '                              /* HEB2 > ++
      IF #KEYWORD-AND-OR NE 'A' /* OR
        FOR #K = 1 TO 6
          IF AR-KEYWORDS(#K) NE ' '
              AND (    SUBSTR(AR-KEYWORDS(#K),1,#L1) = #KY-SEL (1)
              OR SUBSTR(AR-KEYWORDS(#K),1,#L2) = #KY-SEL (2)
              OR SUBSTR(AR-KEYWORDS(#K),1,#L3) = #KY-SEL (3)
              OR SUBSTR(AR-KEYWORDS(#K),1,#L4) = #KY-SEL (4) )
            ESCAPE BOTTOM
          END-IF
        END-FOR
        IF #K > 6
          #SELECTED := FALSE
          ESCAPE ROUTINE
        END-IF
      ELSE                      /* AND
        IF  ( #KY-SEL (1) = ' '
            OR SUBSTR(AR-KEYWORDS(*),1,#L1) = #KY-SEL (1) )
            AND ( #KY-SEL (2) = ' '
            OR SUBSTR(AR-KEYWORDS(*),1,#L2) = #KY-SEL (2) )
            AND ( #KY-SEL (3) = ' '
            OR SUBSTR(AR-KEYWORDS(*),1,#L3) = #KY-SEL (3) )
            AND ( #KY-SEL (4) = ' '
            OR SUBSTR(AR-KEYWORDS(*),1,#L4) = #KY-SEL (4) )
          IGNORE
        ELSE
          #SELECTED := FALSE
          ESCAPE ROUTINE
        END-IF
      END-IF                                             /* HEB2 <
    WHEN (ES-FUNCTION = 'SA1' OR= 'SA2' OR= 'SA3' OR= 'SA4')
    AND NOT (ACTIVE-REPORTS.AR-PROCESS-TIME = #F-DATE-C-PUR           /*
    THRU #T-DATE-C-PUR)                                               /*
      #SELECTED := FALSE
      ESCAPE ROUTINE
    WHEN ES-FUNCTION = 'SA1' OR= 'SA2' AND #NOARSL.#POSTFIX NE 'Y'
      IF #NOARSL.#REPNAME NE ' '
        EXAMINE #NOARSL.#REPNAME FOR H'00' GIVING LENGTH #L
        IF SUBSTRING(ACTIVE-REPORTS.AR-REPNAME,1,#L) NE #NOARSL.#REPNAME
          #SELECTED := FALSE
          ESCAPE ROUTINE
        END-IF
      END-IF
    WHEN ES-FUNCTION = 'SA1' OR= 'SA2' AND #NOARSL.#POSTFIX = 'Y'
        AND #NOARSL.#REPNAME NE ' '
        AND ACTIVE-REPORTS.AR-REPNAME NE SCAN #NOARSL.#REPNAME
      #SELECTED := FALSE
      ESCAPE ROUTINE
    WHEN #NOARSL.#EXPIR-DATE NE ' ' AND
        ACTIVE-REPORTS.AR-EXPIRATION NE #NOARSL.#EXPIR-DATE
      #SELECTED := FALSE
      ESCAPE ROUTINE
    WHEN #NOARSL.#ARCHIVE NE ' ' AND
        #NOARSL.#ARCHIVE NE ACTIVE-REPORTS.AR-ARCHIVE
      #SELECTED := FALSE
      ESCAPE ROUTINE
    WHEN #NOARSL.#REVIVE NE ' ' AND
        #NOARSL.#REVIVE NE ACTIVE-REPORTS.AR-REVIVE
      #SELECTED := FALSE
      ESCAPE ROUTINE
    WHEN #NOARSL.#LOCATION NE ' ' AND
        #NOARSL.#LOCATION NE ACTIVE-REPORTS.AR-CURRENT-LOCATION
      #SELECTED := FALSE
      ESCAPE ROUTINE
    WHEN NONE IGNORE
  END-DECIDE
END-IF
*
END-SUBROUTINE /* SELECT-RECORD
*
************************************************************************
DEFINE SUBROUTINE DATA-TO-PDA
************************************************************************
RESET #SPOOL-ATTRIBUTES #BIN-REPRNB #BIN-REPNAME
IF ACTIVE-REPORTS.AR-CC-TYPE = 0005
  #SPOOL-ATTRIBUTES := ACTIVE-REPORTS.AR-SPOOL-ATTRIBUTES
  #BIN-REPNAME      := ACTIVE-REPORTS.AR-REPNAME
  #BIN-REPRNB       := ACTIVE-REPORTS.AR-REPRNB
  PERFORM GET-BINARY-SIZE
END-IF
IF ES-FUNCTION NE 'LS'
  PERFORM OPTIONS
END-IF
DECIDE ON FIRST VALUE OF ES-FUNCTION
  VALUE 'SA3', 'SA4'
    NOARL1-REPRNB(#I2) := ACTIVE-REPORTS.AR-REPRNB
    MOVE RIGHT JUSTIFIED NOARL1-REPRNB(#I2) TO NOARL1-REPRNB(#I2)
    NOARL1-DESC(#I2)   := ACTIVE-REPORTS.AR-DESC
    IF ACTIVE-REPORTS.AR-SOURCE = ' ' AND ACTIVE-REPORTS.AR-SENDER = ' '
      RESET NOARL1-OWNER(#I2)
    ELSE
      COMPRESS ACTIVE-REPORTS.AR-SOURCE '/'
        ACTIVE-REPORTS.AR-SENDER TO NOARL1-OWNER(#I2) LEAVING NO
    END-IF
    IF ACTIVE-REPORTS.AR-PROCESS-TIME NE #TT
      MOVE EDITED ACTIVE-REPORTS.AR-PROCESS-TIME (EM=YYYYMMDDHHII) TO
        NOARL1-TIME (#I2)
    ELSE
      RESET NOARL1-TIME (#I2)
    END-IF
    #TIME-P13 := MA-PROCESS-TIME
    IF #TIME NE #TT
      MOVE EDITED #TIME (EM=YYYYMMDDHHII) TO NOARL1-MAIL(#I2)
    ELSE
      RESET NOARL1-MAIL(#I2)
    END-IF
    IF ACTIVE-REPORTS.AR-CC-TYPE = 0005
      RESET NOARL1-NUMBER-OF-LINES(#I2)
      NOARL1-BYTES(#I2) := #BIN-SIZE
      MOVE RIGHT JUSTIFIED NOARL1-BYTES(#I2) TO NOARL1-BYTES(#I2)
    ELSE
      RESET NOARL1-BYTES(#I2)
      NOARL1-NUMBER-OF-LINES(#I2) :=
        ACTIVE-REPORTS.AR-NUMBER-OF-LINES
      MOVE RIGHT JUSTIFIED NOARL1-NUMBER-OF-LINES(#I2)
        TO NOARL1-NUMBER-OF-LINES(#I2)
    END-IF
    NOARL1-ARCHIVE(#I2) := ACTIVE-REPORTS.AR-ARCHIVE
    NOARL1-REVIVE(#I2)  := ACTIVE-REPORTS.AR-REVIVE
    NOARL1-CURRENT-LOCATION(#I2) :=
      ACTIVE-REPORTS.AR-CURRENT-LOCATION
    IF ACTIVE-REPORTS.AR-EXPIRATION > ' '
      NOARL1-EXPIRATION(#I2) := ACTIVE-REPORTS.AR-EXPIRATION
    ELSE
      RESET  NOARL1-EXPIRATION(#I2)
    END-IF
    IF ACTIVE-REPORTS.AR-REVIVE-EXPIRATION > ' '
      NOARL1-REVIVE-EXPIRATION(#I2) :=
        ACTIVE-REPORTS.AR-REVIVE-EXPIRATION
    ELSE
      RESET  NOARL1-REVIVE-EXPIRATION(#I2)
    END-IF
    #REPORT-RNB.#REPNAME := ACTIVE-REPORTS.AR-REPNAME
    #REPRNB              := ACTIVE-REPORTS.AR-REPRNB
    RESET NOARL1-ARCHIVE-EXPIRATION(#I2)
    FIND DR WITH DR-REPORT-RNB = #REPORT-RNB
      IF DR-EXPIRATION-DATE > ' '
        NOARL1-ARCHIVE-EXPIRATION(#I2) := DR-EXPIRATION-DATE
      ELSE
        RESET NOARL1-ARCHIVE-EXPIRATION(#I2)
      END-IF
    END-FIND
    NOARL1-OPTIONS(#I2,*) := #OPTIONS(*)
    NOARL1-MESSAGE(#I2)   := MA-STATUS
    /*
  VALUE 'SA1', 'SA2'
    NOARL2-REPNAME(#I2) := ACTIVE-REPORTS.AR-REPNAME
    NOARL2-REPRNB(#I2)  := ACTIVE-REPORTS.AR-REPRNB
    MOVE RIGHT JUSTIFIED NOARL2-REPRNB(#I2) TO NOARL2-REPRNB(#I2)
    NOARL2-DESC(#I2)    := ACTIVE-REPORTS.AR-DESC
    IF ACTIVE-REPORTS.AR-SOURCE = ' ' AND
        ACTIVE-REPORTS.AR-SENDER = ' '
      RESET NOARL2-OWNER(#I2)
    ELSE
      COMPRESS ACTIVE-REPORTS.AR-SOURCE '/'
        ACTIVE-REPORTS.AR-SENDER TO NOARL2-OWNER(#I2) LEAVING NO
    END-IF
    IF ACTIVE-REPORTS.AR-PROCESS-TIME NE #TT
      MOVE EDITED ACTIVE-REPORTS.AR-PROCESS-TIME (EM=YYYYMMDDHHII)
        TO NOARL2-TIME (#I2)
    ELSE
      RESET NOARL2-TIME (#I2)
    END-IF
    #TIME-P13 := MA-PROCESS-TIME
    IF #TIME NE #TT
      MOVE EDITED #TIME (EM=YYYYMMDDHHII) TO NOARL2-MAIL (#I2)
    ELSE
      RESET NOARL2-MAIL (#I2)
    END-IF
    IF ACTIVE-REPORTS.AR-CC-TYPE = 0005
      RESET NOARL2-NUMBER-OF-LINES(#I2)
      NOARL2-BYTES(#I2) := #BIN-SIZE
      MOVE RIGHT JUSTIFIED NOARL2-BYTES(#I2) TO NOARL2-BYTES(#I2)
    ELSE
      RESET NOARL2-BYTES(#I2)
      NOARL2-NUMBER-OF-LINES(#I2) := ACTIVE-REPORTS.AR-NUMBER-OF-LINES
      MOVE RIGHT JUSTIFIED NOARL2-NUMBER-OF-LINES(#I2) TO
        NOARL2-NUMBER-OF-LINES(#I2)
    END-IF
    NOARL2-ARCHIVE(#I2) := ACTIVE-REPORTS.AR-ARCHIVE
    NOARL2-REVIVE(#I2)  := ACTIVE-REPORTS.AR-REVIVE
    NOARL2-CURRENT-LOCATION(#I2) := ACTIVE-REPORTS.AR-CURRENT-LOCATION
    IF ACTIVE-REPORTS.AR-EXPIRATION NE ' '
      NOARL2-EXPIRATION (#I2) := ACTIVE-REPORTS.AR-EXPIRATION
    ELSE
      RESET  NOARL2-EXPIRATION (#I2)
    END-IF
    IF ACTIVE-REPORTS.AR-REVIVE-EXPIRATION NE ' '
      NOARL2-REVIVE-EXPIRATION (#I2) :=
        ACTIVE-REPORTS.AR-REVIVE-EXPIRATION
    ELSE
      RESET NOARL2-REVIVE-EXPIRATION (#I2)
    END-IF
    #REPORT-RNB.#REPNAME := ACTIVE-REPORTS.AR-REPNAME
    #REPRNB              := ACTIVE-REPORTS.AR-REPRNB
    RESET NOARL2-ARCHIVE-EXPIRATION(#I2)
    FIND DR WITH DR-REPORT-RNB = #REPORT-RNB
      IF DR-EXPIRATION-DATE NE ' '
        NOARL2-ARCHIVE-EXPIRATION (#I2) := DR-EXPIRATION-DATE
      ELSE
        RESET NOARL2-ARCHIVE-EXPIRATION (#I2)
      END-IF
    END-FIND
    NOARL2-OPTIONS(#I2,*) := #OPTIONS(*)
    NOARL2-MESSAGE(#I2)   := MA-STATUS
  NONE VALUE IGNORE
END-DECIDE
*
END-SUBROUTINE /* DATA-TO-PDA
*
************************************************************************
DEFINE SUBROUTINE GET-BINARY-SIZE
************************************************************************
RESET #BIN-SIZE #RECNUM #ERC #ERT
IF NOT (#SPOOL-DI-SIZE = #I4 OR = 0)
  #BIN-SIZE := (#SPOOL-DI-SIZE / 1024) * 3 / 4 + 1 /*SU3
ELSE
  CALLNAT 'RBINSZ-N' #BIN-REPNAME #BIN-REPRNB 'R' #RECNUM #BIN-SIZE
    #ERC #ERT
  IF #ERC = 0 AND #BIN-SIZE NE 0
    #BIN-SIZE := #BIN-SIZE / 1024 + 1
  END-IF
END-IF
*
END-SUBROUTINE /* GET-BINARY-SIZE
*
************************************************************************
DEFINE SUBROUTINE OPTIONS
************************************************************************
RESET #OPTIONS(*) #NEW-OPTIONS(*) #I
  #NATRP-ERC #NATRP-ERT                             /* HEB1
IF ES-KEY-CODE(1) NE 'FO'
  PERFORM CHECK-OTHER-FOLDERS
END-IF
CALLNAT 'NOSRCK1N' ACTIVE-REPORTS.AR-CURRENT-LOCATION
  ACTIVE-REPORTS.AR-SOURCE-ID ACTIVE-REPORTS.AR-REVIVE
  ACTIVE-REPORTS.AR-REVIVE-EXPIRATION ACTIVE-REPORTS.AR-ARCHIVE
  ACTIVE-REPORTS.AR-EXPIRATION #SOURCE-EXIST
  #NATRP-ERC #NATRP-ERT ES-USER (AD=O)                  /* HEB1
  ES-APP-SERVER-LIBRARY (AD=O)                          /* HEB1
IF #NATRP-ERC NE 0                                      /* HEB1 >
  ES-RC := 1
  ES-MSG-NR := #NATRP-ERC
  ES-MSG-TXT := #NATRP-ERT
  ESCAPE MODULE
END-IF                                                  /* HEB1 <
IF NOT #SOURCE-EXIST
  #OPTIONS(1) := 'BB'
  #OPTIONS(2) := 'PR'
  #OPTIONS(3) := 'AR'
  #OPTIONS(4) := 'DI'
  #OPTIONS(5) := 'BU'
  #I := 5
ELSE
  IF NOT #MY-FOLDER
    ADD 1 TO #I
    #OPTIONS(#I) := 'DI'
  END-IF
  IF ACTIVE-REPORTS.AR-CC-TYPE = 0005 AND #BIN-SIZE = 0
    ADD 1 TO #I
    #OPTIONS(#I) := 'BB'
  END-IF
  IF NOT (ACTIVE-REPORTS.AR-ARCHIVE = ' ' OR = 'A')
    ADD 1 TO #I
    #OPTIONS(#I) := 'AR'
  END-IF
END-IF
** IF NOT (ACTIVE-REPORTS.AR-ARCHIVE = '*' OR = 'P' OR = 'R') OR
IF NOT (ACTIVE-REPORTS.AR-ARCHIVE = '*') OR   /* BLI NOMALL-1829
    ACTIVE-REPORTS.AR-REVIVE = '*'
  ADD 1 TO #I
  #OPTIONS(#I) := 'RV'
END-IF
#BC-REPORT := ACTIVE-REPORTS.AR-REPNAME
#BC-REPRNB := ACTIVE-REPORTS.AR-REPRNB
FNBC1. FIND NUMBER BC WITH BC-REPORT-RNB = #BC-REPORT-RNB
IF *NUMBER(FNBC1.) = 0
  ADD 1 TO #I
  #OPTIONS(#I) := 'LX'
END-IF
IF ES-USER-TYPE NE 'A' AND NOT #OWNER-REPORT
  DECIDE FOR EVERY CONDITION
    WHEN NOT (PROF-AREPS = 'P' OR = 'M' OR = 'D' OR #GRANTS(4) = 'Y' )
      #NEW-OPTIONS(1) := 'BB'
    WHEN NOT (PROF-AREPS = 'P' OR = 'M' OR #GRANTS(2) = 'Y' )
      #NEW-OPTIONS(2) := 'OP'
      #NEW-OPTIONS(3) := 'FI'
    WHEN NOT (PROF-AREPS = 'P' OR #GRANTS(3) = 'Y' )
      #NEW-OPTIONS(4) := 'DL'
    WHEN NOT (PROF-ARCHIVE = 'Y' OR = 'M' OR #GRANTS(5) = 'Y' )
      #NEW-OPTIONS(5) := 'AR'
    WHEN NOT (PROF-REVIVE = 'Y' OR = 'M' OR #GRANTS(6) = 'Y' )
      #NEW-OPTIONS(6) := 'RV'
    WHEN ANY
      CALLNAT 'NOOPT--N'  #NEW-OPTIONS(*) #OPTIONS(*)
    WHEN NONE IGNORE
  END-DECIDE
END-IF
*
END-SUBROUTINE /* OPTIONS
*
************************************************************************
DEFINE SUBROUTINE GET-FOLDER-GRANTS
************************************************************************
RESET #GR-USERID #GRANTS(*) #GR-NAME
IF ES-USER-TYPE = 'A' OR FO-L.FO-USER-ID = ES-USER OR #OWNER-REPORT
  #GRANTS(*) := 'Y'
  #MY-FOLDER := TRUE
ELSE
  #FO-ID-N := FO-L.FO-ID
  COMPRESS FO-L.FO-USER-ID #FO-ID-A TO #GR-NAME LEAVING NO
  CALLNAT 'NOGROU-N' 'F' #GR-NAME ES-USER #GR-USERID #GRANTS(*)
  #MY-FOLDER := FALSE
END-IF
*
END-SUBROUTINE /* GET-FOLDER-GRANTS
*
************************************************************************
DEFINE SUBROUTINE CHECK-OTHER-FOLDERS
************************************************************************
RESET #GRANTS(*) #MY-FOLDER
IF NOT (ES-USER-TYPE = 'A' OR #OWNER-REPORT)
  FNDMA1. FIND MA WITH MA-REP-RNB = #REPORT-RNB
    IF MA-USERID = ES-USER
      FO-L.FO-USER-ID := ES-USER
    ELSE
      #FO-ID      := MA-FO-ID
      #FO-USER-ID := MA-USERID
* BLI 2016-11-02 NOMALL-1914 correct next line
**    FIND FO-L WITH FO-USER-FO-ID = #FO-USER-ID
      FIND FO-L WITH FO-USER-FO-ID = #FO-USER-FO-ID
      END-FIND
    END-IF
  END-FIND
END-IF
PERFORM GET-FOLDER-GRANTS
*
END-SUBROUTINE /* CHECK-OTHER-FOLDERS
*
************************************************************************
DEFINE SUBROUTINE LIST-HEADER-IN-FOLDER-REPORT                 /* CF2 ->
************************************************************************
RESET INITIAL #J
PERFORM GET-TEXT
COMPRESS LONG-MSG(#J) TO NOARL1-HEADER(1) LEAVING NO
SUBTRACT 1 FROM #J
FOR #I = #J TO 5 STEP -1
  COMPRESS  LONG-MSG(#I) C-HEADER-DELIMITER NOARL1-HEADER(1)
    TO NOARL1-HEADER(1) LEAVING NO
END-FOR
COMPRESS LONG-MSG(2) C-HEADER-DELIMITER NOARL1-HEADER(1)
  TO NOARL1-HEADER(1) LEAVING NO
COMPRESS LONG-MSG(4) C-HEADER-DELIMITER NOARL1-HEADER(1)
  TO NOARL1-HEADER(1) LEAVING NO
COMPRESS LONG-MSG(3) C-HEADER-DELIMITER NOARL1-HEADER(1)
  TO NOARL1-HEADER(1) LEAVING NO
COMPRESS NOARL1-HEADER(1) C-HEADER-DELIMITER LONG-MSG(16)
  TO NOARL1-HEADER(1) LEAVING NO
*
END-SUBROUTINE /* LIST-HEADER-IN-FOLDER-REPORT
*
************************************************************************
DEFINE SUBROUTINE LIST-HEADER-IN-FOLDER
************************************************************************
RESET INITIAL #J
PERFORM GET-TEXT
COMPRESS LONG-MSG(#J) TO NOARL2-HEADER(1) LEAVING NO
SUBTRACT 1 FROM #J
FOR #I = #J TO 1 STEP -1
  COMPRESS  LONG-MSG(#I) C-HEADER-DELIMITER NOARL2-HEADER(1)
    TO NOARL2-HEADER(1) LEAVING NO
END-FOR
COMPRESS NOARL2-HEADER(1) C-HEADER-DELIMITER LONG-MSG(16)
  TO NOARL2-HEADER(1) LEAVING NO
*
END-SUBROUTINE /* LIST-HEADER-IN-FOLDER                        /* CF2 <-
*
************************************************************************
DEFINE SUBROUTINE GET-TEXT
************************************************************************
RESET SHORT-MSG LONG-MSG(*) #HEADER
VERSION := 0
NADA2000.OBJECT-KIND := 'U'
NADA2000.ERROR-NUMBER := #MSG-NR
NADA2000.OPT-INSERT-DYN := FALSE
NADA2000.OPT-LANGUAGE := ES-LANGUAGE
NADA2000.LIBRARY := ES-APP-SERVER-LIBRARY
CALLNAT 'NATA2000' NADA2000 NATA2000.EXTENDED-PARMS NAD-MSG NAD-FLD
*
END-SUBROUTINE /* GET-TEXT
*
************************************************************************
ON ERROR
************************************************************************
  ES-RC := 1
  COMPRESS *PROGRAM 'Error' *ERROR-NR 'in line' *ERROR-LINE
    TO ES-MSG-TXT
  ESCAPE ROUTINE
*
END-ERROR
*
END
