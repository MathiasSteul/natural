* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    RMASAMCN
* Function  Converts ASA to Machine Code
* Version   1.3
*
* Maintenance:
* uuu yy-mm-dd s(999999) ....
* mrs 93-03-15           created
* SU1     2020-05-14 NOMALL-2349 restruct
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER USING RMASAMCP
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET P-PRINT-NUMBER
*
DECIDE FOR FIRST CONDITION
  WHEN P-BRACKET = 'F'
    PERFORM HANDLE-FIRST-RECORD
  WHEN P-BRACKET = 'M' AND P-REC-CC = '1'
    PERFORM HANDLE-LAST-RECORD
    PERFORM HANDLE-FIRST-RECORD
  WHEN P-BRACKET = 'L'
    PERFORM HANDLE-LAST-RECORD
  WHEN NONE
    PERFORM HANDLE-NORMAL-RECORD
END-DECIDE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE HANDLE-FIRST-RECORD
************************************************************************
RESET P-PREV-RECORD
*
DECIDE ON FIRST P-REC-CC
  VALUE '1'  P-PREV-CC := H'8B' /* skip to Chan.  1  immediate
  VALUE '2'  P-PREV-CC := H'93' /* skip to Chan.  2  immediate
  VALUE '3'  P-PREV-CC := H'9B' /* skip to Chan.  3  immediate
  VALUE '4'  P-PREV-CC := H'A3' /* skip to Chan.  4  immediate
  VALUE '5'  P-PREV-CC := H'AB' /* skip to Chan.  5  immediate
  VALUE '6'  P-PREV-CC := H'B3' /* skip to Chan.  6  immediate
  VALUE '7'  P-PREV-CC := H'BB' /* skip to Chan.  7  immediate
  VALUE '8'  P-PREV-CC := H'C3' /* skip to Chan.  8  immediate
  VALUE '9'  P-PREV-CC := H'CB' /* skip to Chan.  9  immediate
  VALUE 'A'  P-PREV-CC := H'D3' /* skip to Chan. 10  immediate
  VALUE 'B'  P-PREV-CC := H'DB' /* skip to Chan. 11  immediate
  VALUE 'C'  P-PREV-CC := H'E3' /* skip to Chan. 12  immediate
  VALUE '+'  P-PREV-CC := H'03' /* no operation      immediate
  VALUE ' '  P-PREV-CC := H'0B' /* space 1 Line      immediate
  VALUE '0'  P-PREV-CC := H'13' /* space 2 Lines     immediate
  VALUE '-'  P-PREV-CC := H'1B' /* space 3 Lines     immediate
  NONE       P-PREV-CC := H'0B' /* space 1 Line      immediate
END-DECIDE
ADD 1 TO P-PRINT-NUMBER
P-PRINT-RECORD (P-PRINT-NUMBER) := P-PREV-RECORD
P-PREV-RECORD := P-RECORD
*
END-SUBROUTINE /* HANDLE-FIRST-RECORD
*
************************************************************************
DEFINE SUBROUTINE HANDLE-NORMAL-RECORD
************************************************************************
DECIDE ON FIRST P-REC-CC
  VALUE '1'  P-PREV-CC := H'89' /* write and skip to Chan.  1
  VALUE '2'  P-PREV-CC := H'91' /* write and skip to Chan.  2
  VALUE '3'  P-PREV-CC := H'99' /* write and skip to Chan.  3
  VALUE '4'  P-PREV-CC := H'A1' /* write and skip to Chan.  4
  VALUE '5'  P-PREV-CC := H'A9' /* write and skip to Chan.  5
  VALUE '6'  P-PREV-CC := H'B1' /* write and skip to Chan.  6
  VALUE '7'  P-PREV-CC := H'B9' /* write and skip to Chan.  7
  VALUE '8'  P-PREV-CC := H'C1' /* write and skip to Chan.  8
  VALUE '9'  P-PREV-CC := H'C9' /* write and skip to Chan.  9
  VALUE 'A'  P-PREV-CC := H'D1' /* write and skip to Chan. 10
  VALUE 'B'  P-PREV-CC := H'D9' /* write and skip to Chan. 11
  VALUE 'C'  P-PREV-CC := H'E1' /* write and skip to Chan. 12
  VALUE '+'  P-PREV-CC := H'01' /* write without spacing
  VALUE ' '  P-PREV-CC := H'09' /* write and space 1 Line
  VALUE '0'  P-PREV-CC := H'11' /* write and space 2 Lines
  VALUE '-'  P-PREV-CC := H'19' /* write and space 3 Lines
  NONE       P-PREV-CC := H'09' /* write and skip 1 Line
END-DECIDE
*
ADD 1 TO P-PRINT-NUMBER
P-PRINT-RECORD (P-PRINT-NUMBER) := P-PREV-RECORD
P-PREV-RECORD := P-RECORD
*
END-SUBROUTINE /* HANDLE-NORMAL-RECORD
*
************************************************************************
DEFINE SUBROUTINE HANDLE-LAST-RECORD
************************************************************************
IF P-BRACKET = 'L'
  PERFORM HANDLE-NORMAL-RECORD
END-IF
*
P-PREV-CC := H'01'
ADD 1 TO P-PRINT-NUMBER
P-PRINT-RECORD (P-PRINT-NUMBER) := P-PREV-RECORD
*
END-SUBROUTINE /* HANDLE-LAST-RECORD
*
END
