* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RMDELRTN  DELETE REPORT-TEXT
*
* MAINTENANCE:
* XSISZHA 2000-08-01 (CE7461) EXTEND REPORT AND BUNDLE NAMES
* XSETGGR 2007-05-02 NOM3201  SUPPORT RUN NUMBERS IN FORMAT P11
* ----------------------------------------------------------------------
*
DEFINE DATA
PARAMETER
1 P-REPNAME   (A25)
1 P-REPRNB    (P11)
************************************************************************
LOCAL
1 REPORT-TEXT VIEW OF NRM-FILED-SYSOUTS
  2 F-REPNAME
  2 F-REPRNB
*
1 #KEY(A35)
1 REDEFINE #KEY
  2 #K-REPNAME(A25)
  2 #K-REPRNB(P11)
  2 #K-SEQ(B4)
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#K-REPNAME := P-REPNAME
#K-REPRNB := P-REPRNB
RESET #K-SEQ
*
DEL-TEXT.
READ REPORT-TEXT BY F-REPNAME-RNB-SEQ = #KEY
  IF F-REPNAME NE #K-REPNAME OR F-REPRNB NE #K-REPRNB
    ESCAPE BOTTOM
  END-IF
  DELETE RECORD
  IF *COUNTER(DEL-TEXT.) >= 50
    END TRANSACTION
    RESET *COUNTER(DEL-TEXT.)
  END-IF
END-READ
END TRANSACTION
END
