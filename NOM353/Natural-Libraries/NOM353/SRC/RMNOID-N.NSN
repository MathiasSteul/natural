* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    RMNOID-N
* Function  Issue unique internal node id (new with 3.5)
*           Next free id stored in field MF-INTERNAL-EMAIL-NODE and
*           this field is used only in this routine Ü
*
* Maintenance
* uuu     yyyy-mm-dd s(999999) ...
* fhi     2016-11-09 NOMALL-1620 Created from RMSRID-N
* SU1     2018-03-26 use non-descriptor field to avoid 'AND NOT'
* SU2     2020-11-10 NOMALL-2440 split DDM -> NRM-MF-NODES
* ---------------------------------------------------------------------
DEFINE DATA PARAMETER
1 P-ID (P11) /* out
* ---------------------------------------------------------------------
LOCAL
1 MF-NODE VIEW OF NRM-MF-NODES /*SU2 was NRM-MONITOR VIEW OF NRM-MONITOR
  2 MF-MONITOR-ID
  2 MF-INTERNAL-EMAIL-NODE /*SU1
  2 MF-INTERNAL-NODE-ID
1 NODE VIEW OF NRM-MF-NODES /*SU2 was NRM-MONITOR
*
1 #ID (A20) CONST <'INTERNAL-NODE-ID'>
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
FNDID. FIND MF-NODE WITH MF-MONITOR-ID = #ID
  IF NO RECORDS FOUND /*STORE it later
    MF-MONITOR-ID := #ID
    RESET MF-INTERNAL-EMAIL-NODE /*SU1 M-INTERNAL-NODE-ID
  END-NOREC
  #REP. REPEAT /*number free ? if not increase
    ADD 1 TO MF-INTERNAL-EMAIL-NODE /*SU1 M-INTERNAL-NODE-ID
    N. FIND NUMBER NODE WITH MF-INTERNAL-NODE-ID =MF-INTERNAL-EMAIL-NODE
/*SU1  M-INTERNAL-NODE-ID
    IF *NUMBER (N.) = 0
      ESCAPE BOTTOM (#REP.)
    END-IF
  END-REPEAT /*(#REP.)
  IF *NUMBER (FNDID.) = 0 /*just to be sure
    STORE MF-NODE /*'INTERNAL-NODE-ID'
  ELSE
    RESET MF-INTERNAL-NODE-ID /*just to be sure /*SU1
    UPDATE (FNDID.)
  END-IF
  P-ID := MF-INTERNAL-EMAIL-NODE /*SU1 M-INTERNAL-NODE-ID
END-FIND
*
END
