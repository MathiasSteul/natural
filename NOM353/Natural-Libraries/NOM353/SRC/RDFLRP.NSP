* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    RDFLRP
* Version   1.3
* Function  Define Report Defaults
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* mrs 93-06-12           rewritten
* gw  95-12-11 s(222350) user exit to allow/disallow access to NSPF
* gw  96-09-09 s(250901) avoid NAT1106 when invoking NSPF
* gw  98-03-13 s(278970) save search values in independent variables
* wcd 00-04-01 CE 7267   New PFkey for additional printers in RPFK---L
* sju 00-07-24 CE 7465   Create definition default (re-stow)
* xsetggr 01-03-27 p(205776) consistent error message handling
* xsetggr 01-04-02 p(205825) handling of PF10 (edit/layout)
* sju 02-04-16 NOM221    Allow display mode
* xsetggr 2008-07-18 p(300480) allow create new members with pf10 only
*                              if spf installed
* xsetggr 2009-10-09 P320995    returns to system defaults menu screen
*                               after editing exit in NOM/unix
* fhi     2009-11-16 P304569  Modify only if PF10 pressed
* xsetggr 2010-01-18 P300184  use G-LANGUAGE instead of *LANGUAGE
* fhi     2010-02-01 P304569  Show additionally record kind
* xsetggr 2010-02-18 P304569  keep mode (modify/display) after edit exit
* fhi     2010-09-03 NOMALL-97 Extend message line
* SU1     2013-01-31 unused      Deactivate unused data areas
* SU2     2014-07-01 NOMALL-1281 show last update user+date
* SU3     2016-08-15 NOMALL-1906 allow NONE/KEIN for separator page
* SU4     2016-09-28 NOMALL-1906 show msg 32 only once+handle NONE/KEIN
* SU5     2016-10-18 NOM3.5 restruct: use ext. routines
* fhi     2016-11-15 NOMALL-1961 Use new task IDs
* SU2     2020-11-10 NOMALL-2440 split DDM -> NRM-MF-NODES
* NKEW1   2024-07-24 EF-4541     Decide what to show on map with func
* ----------------------------------------------------------------------
DEFINE DATA GLOBAL USING NRM-GL
*
LOCAL USING RPFK---L
LOCAL USING VDEFRP-L
LOCAL USING RLOG-L
LOCAL USING CONST-L /* NKEW1 changed
*
LOCAL
1 #FATHER-PROG      (A8) INIT <'RDFMEN'>
1 CV-MAP            (C) INIT <(AD=I)>
1 L-HEADER          (A78)
1 #ALLOWED          (L)
1 #FUNC             (A1)
1 #LANGUAGE         (I1)
1 #EXIST            (L)
1 #PROGRAM          (A8) INIT <*PROGRAM>
1 #ISN              (N10)
1 #LOG-FLAG         (L)
1 #LAST-MOD         (A40) /*SU2
1 #POS              (I4) /*SU3
1 #OLD-SEPSTART     (A8) /*SU3
1 #OLD-SEPEND       (A8) /*SU3
1 #CURS-FIELD       (I4)
1 #POS-START        (I4)
1 #POS-END          (I4)
1 #ESC-COMMIT       (L)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
* NKEW1 <
#JOB_ADD_FIELD := F#SETVAR(<#_JOBCARDS(1:2),#_ADDITIONALPARA(1:2)>)
* NKEW1 >
RESET G-COMMIT G-MAP-MODIFIED /*SU3
IF G-C-FUNC = 'X' /* recursivly called
  G-C-FUNC := #FUNC := 'M'
ELSE
  #FUNC := 'D'
END-IF
*
MAIN-LOOP. REPEAT
  REPORT-DEFAULTS.M-MONITOR-ID := F#MONITOR-TASK-ID1 (<>)
  FIND-LOOP. FIND REPORT-DEFAULTS WITH M-MONITOR-ID =
      REPORT-DEFAULTS.M-MONITOR-ID
    IF NO RECORDS FOUND
      G-NATRP-ERC := 491
      ESCAPE MODULE
/*SU 2018-05-23 REPORT-DEFAULTS.M-MONITOR-ID := RMTASK-P.TASK-ID
/*      M-LAST-UPDATE      := *TIMX /*SU2
/*      M-LAST-UPDATE-USER := G-USERID /*SU2
/*      STOR. STORE REPORT-DEFAULTS
/*      END TRANSACTION
/*      ESCAPE BOTTOM
    END-NOREC
    #ISN := *ISN
    G-HOLD-TIME := *TIMX
    CALLNAT 'N-HEAD2' M-LAST-UPDATE-USER M-LAST-UPDATE /*SU2
      #LAST-MOD G-DATE-FORMAT /*SU2
    DECIDE ON FIRST VALUE OF #FUNC
      VALUE 'M'
        CALLNAT 'NARPSEC' G-USER-PROFILE 'MMO' #ALLOWED
        INCLUDE C-NALLOW
        IF NOT #LOG-FLAG
          LG-USERID := G-USERID
          LG-CODE := 'MO'
          IF G-LANGUAGE = 2
            G-NATRP-ERT := '''Report-Standards'''
          ELSE
            G-NATRP-ERT := '''Report-Defaults'''
          END-IF
          COMPRESS '1543' G-NATRP-ERT TO LG-MSG
          G-NATRP-ERC := 1543
          CALLNAT 'RLOG' PL-PARMS
          END TRANSACTION
          #LOG-FLAG := TRUE
        END-IF
        GETREC. GET REPORT-DEFAULTS #ISN
      VALUE 'D'
        CALLNAT 'NARPSEC' G-USER-PROFILE 'DMO' #ALLOWED
        INCLUDE C-NALLOW
        CV-MAP := (AD=IP)
      NONE VALUE
        IGNORE
    END-DECIDE
*
    SCREEN-LOOP. REPEAT
      IF #LANGUAGE NE *LANGUAGE
        PERFORM INIT-PFKEYS
        PERFORM SET-PFKEYS
        MOVE G-LANGUAGE TO #LANGUAGE *LANGUAGE
      END-IF
*
      CALLNAT 'N-NONE' REPORT-DEFAULTS.R-SEPSTART
        REPORT-DEFAULTS.R-SEPEND /*SU4
      CALLNAT 'N-HEADER' L-HEADER G-DATE-FORMAT 'RDEFMOM1'
      PERFORM FLIP-DISPLAY
      IF #POS = 0 /*SU3
        #POS := POS(G-DIRECT-COMMAND)
      END-IF
      INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT MARK #POS /*SU2
        USING MAP 'RDFLRPM&'
      RESET G-NATRP-ERC G-NATRP-ERT #POS
*
      INCLUDE RPFKVA-C
      INCLUDE C-DIRECT
*
      INCLUDE RPFKED-C
      IF G-PF-FUNC = ##PFK-MODIFY AND G-C-FUNC = 'M' /*modify allowed
        G-C-FUNC := 'X'
        FETCH RETURN #PROGRAM
        ESCAPE BOTTOM (MAIN-LOOP.)
      END-IF
      IF (CV-MAP MODIFIED OR G-MAP-MODIFIED) AND #FUNC NE 'D'
        IF G-AUTOCOMMIT = 'I'
          RESET G-MAP-MODIFIED
        ELSE
          G-MAP-MODIFIED := TRUE
        END-IF
        PERFORM VALIDATE-INPUT
        IF G-NATRP-ERC NE 0 /*SU3
          ESCAPE TOP
        END-IF
        M-LAST-UPDATE      := *TIMX /*SU2
        M-LAST-UPDATE-USER := G-USERID /*SU2
        UPDATE (GETREC.)
        IF CV-MAP MODIFIED
          G-NATRP-ERC := 0032
        END-IF
        INCLUDE C-COMMI2
/*SU3 lines below deactivated(already done in C-COMMIT)
/*SU3 IF G-COMMIT END TRANSACTION END-IF /* Do not wait until prog te   rminates
      END-IF
*
      IF G-PF-FUNC = ##PFK-EDIT
        PERFORM EDIT-SEPARATOR
      END-IF
      IF #ESC-COMMIT
        RESET #ESC-COMMIT
        ESCAPE BOTTOM(FIND-LOOP.)
      END-IF
      INCLUDE REXDO--C
*
    END-REPEAT
  END-FIND  /* (FIND-LOOP.)
END-REPEAT  /* (MAIN-LOOP.)
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-INPUT
************************************************************************
IF NOT (REPORT-DEFAULTS.R-STORE-NATRPT  = 'Y' OR = 'N' OR = ' ')
  REINPUT *1099 MARK *REPORT-DEFAULTS.R-STORE-NATRPT
END-IF
IF NOT (REPORT-DEFAULTS.R-CREATE-DEFINITION  = 'Y' OR = 'N' OR = ' ')
  REINPUT *1099 MARK *REPORT-DEFAULTS.R-CREATE-DEFINITION
END-IF
IF REPORT-DEFAULTS.R-RETENTION-NUM = 0
    AND (REPORT-DEFAULTS.R-RETENTION-UNIT NE ' '
    OR REPORT-DEFAULTS.R-RETENTION-CALENDAR NE ' ')
  REINPUT *415 MARK *REPORT-DEFAULTS.R-RETENTION-NUM
END-IF
IF REPORT-DEFAULTS.R-RETENTION-NUM > 0
  IF REPORT-DEFAULTS.R-RETENTION-CALENDAR = SCAN '*'
    REINPUT USING HELP MARK *REPORT-DEFAULTS.R-RETENTION-CALENDAR
  END-IF
  IF REPORT-DEFAULTS.R-RETENTION-CALENDAR NE ' '
    CALLNAT 'RCHKCA' REPORT-DEFAULTS.R-RETENTION-CALENDAR #EXIST
    IF NOT #EXIST
      REINPUT *2004 MARK *REPORT-DEFAULTS.R-RETENTION-CALENDAR
    END-IF
    REPORT-DEFAULTS.R-RETENTION-UNIT := 'W'
  END-IF
  IF NOT (REPORT-DEFAULTS.R-RETENTION-UNIT = 'W'
      OR = 'A' OR = 'V' OR = 'M' OR = 'G')
    REINPUT *1087 MARK *REPORT-DEFAULTS.R-RETENTION-UNIT
  END-IF
  IF REPORT-DEFAULTS.R-RETENTION-UNIT = 'G'
    RESET REPORT-DEFAULTS.R-RETENTION-CALENDAR
  END-IF
  IF REPORT-DEFAULTS.R-RETENTION-UNIT = 'W'
    IF REPORT-DEFAULTS.R-RETENTION-CALENDAR = ' '
      RESET REPORT-DEFAULTS.R-RETENTION-UNIT
      REINPUT *2003 MARK *REPORT-DEFAULTS.R-RETENTION-CALENDAR
    END-IF
  END-IF
END-IF
IF NOT (REPORT-DEFAULTS.R-RETENTION-ACTION = 'A' OR = 'P' OR = ' ')
  REINPUT *1088 MARK *REPORT-DEFAULTS.R-RETENTION-ACTION
END-IF
IF NOT (REPORT-DEFAULTS.R-ARCHIVE = 'Y' OR = 'N' OR = 'I' OR = ' ' )
  REINPUT *1107 MARK *REPORT-DEFAULTS.R-ARCHIVE
END-IF
CALLNAT 'N-SEPMEM' REPORT-DEFAULTS.R-SEPSTART #OLD-SEPSTART
  'S' 'R' 2X G-NATRP-ERC G-NATRP-ERT
IF G-NATRP-ERC NE 0
  #POS := POS(REPORT-DEFAULTS.R-SEPSTART)
  ESCAPE ROUTINE
END-IF
*
CALLNAT 'N-SEPMEM' REPORT-DEFAULTS.R-SEPEND #OLD-SEPEND
  'E' 'R' 2X G-NATRP-ERC G-NATRP-ERT
IF G-NATRP-ERC NE 0
  #POS := POS(REPORT-DEFAULTS.R-SEPEND)
  ESCAPE ROUTINE
END-IF
*
END-SUBROUTINE /* VALIDATE-INPUT
*
************************************************************************
DEFINE SUBROUTINE EDIT-SEPARATOR
************************************************************************
#CURS-FIELD := *CURS-FIELD
#POS-START  := POS(R-SEPSTART)
#POS-END    := POS(R-SEPEND)
PERFORM S-SEPEDT #PROGRAM #CURS-FIELD #POS-START R-SEPSTART
  #POS-END R-SEPEND 5X #FUNC 2X
IF G-NATRP-ERC NE 0
  #POS := #POS-START
  IF NOT(G-MAP-MODIFIED AND G-NATRP-ERC=4028) /*Std sep. page edited 'PF
    ESCAPE TOP
  END-IF
END-IF
*
END-SUBROUTINE /* EDIT-SEPARATOR
*
************************************************************************
DEFINE SUBROUTINE INIT-PFKEYS
************************************************************************
INCLUDE RPFSTD-C
INCLUDE RPFCOM-C
G-PF-IDENT (11) := ##PFN-EDIT
G-PF-CODE  (11) := ##PFK-EDIT
G-PF-IDENT (23) := ##PFN-EDIT
G-PF-CODE  (23) := ##PFK-EDIT
IF G-C-FUNC = 'M' /* modify allowed in user profile
  G-PF-IDENT (10) := ##PFN-MODIFY
  G-PF-CODE  (10) := ##PFK-MODIFY
  G-PF-IDENT (22) := ##PFN-MODIFY
  G-PF-CODE  (22) := ##PFK-MODIFY
END-IF
CALLNAT 'RPFINI-N' G-PF G-PFB
*
END-SUBROUTINE /* INIT-PFKEYS
* --------------------------------------- set pfkeys -------------------
INCLUDE RPFSET-C
*
END
