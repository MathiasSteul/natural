* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 5
* <Natural Source Header
* NOMSAT - (Copied from NOMSAT32) * Start NOM Monitor (SAT Version 3.2)
*
* Maintenance
* uuu     yyyy-mm-dd s(999999) ...
* xsetggr 2007-07-09 NOM3201   created from NOMSAT31
* xsetggr 2008-01-15 p(300439) change mask for printing node in sysout
* fhi     2008-03-26 fhi249    fallback to SATP member if SP not found
* XSETHZ  2009-02-04 P307593   Add Parameter to NOMVER-N
* xsetggr 2009-03-12 P303102   make steplib handling unix compliant
* fhi     2010-09-03 NOMALL-97  Extend message line
* fhi     2010-11-18 NOMALL-97  Disallow batch monitor in BS2000
* fhi     2011-06-14 NOMALL-927 Show only major version
* fhi     2012-03-08 NOMALL-965 Correct major version
* fhi     2012-08-17 FHI282     Enhance error output
* bli     2012-09-19 NOMALL-94  2 digit versions, remove old versions
* fhi     2013-05-08 NOMALL-1214 Introduce new migration flags
* raya    2013-06-19 NOMALL-1259 use SATID02N
* SU1     2014-01-27 NOMALL-1341 remove LA-fields
* fhi     2014-11-21 NOMALL-1506 Use correct DD Name
* BLI     2015-07-09 NOMALL-1670 onitor started twice with same name
* fhi     2016-08-18 NOMALL-1621 Introduce Multinode Feature
* fhi     2016-11-15 NOMALL-1961 Use new task IDs
* fhi     2017-02-08 NOMALL-1961 Add trace: Enter SATVERS 99 to indicate
*                                that trace is to be switched on
* fhi     2018-02-07 NOMALL-1918 Adapt for Unix
* SU2     2020-06-09 NOMALL-2349 use N-ESYLG
* SU3     2020-08-17 NOMALL-2404 correct above to avoid NAT0903 sto.ovfl
* SU4     2020-11-10 NOMALL-2440 split DDM -> NRM-MF-NODES
* SU5     2021-04-16 NOMALL-2454 recat RMTASK-P to avoid NAT1305
*         +                      recat for VMONIT-L M-NATRPT-DBID/-FNR
* SU6     2022-03-21 NOMALL-2538 no monitor: MSG+TERMINATE
* SU7     2022-08-04 ES-31130    Inv.int. version(NOMVI-2C): better msg
* SU8     2023-03-22 NOMALL-2629 PWD: SY-TST-N -> SATTS01N
* SU9     2023-08-25 NOMALL-2647 more than 8 steplibs
* ----------------------------------------------------------------------
DEFINE DATA GLOBAL USING MONIT-GL
INDEPENDENT
/*SU4 1 +NOD-LOCAL-ID            (A20) /* MONITOR-ID of the local node
1 +NOD-LOCAL-NODE          (N5) /*SU4
* *****
/*SU4 LOCAL USING VMONITUL
LOCAL USING SATFNC3E
LOCAL USING SATMM02P
LOCAL USING SATLF02P
LOCAL USING SATKY--P
LOCAL USING SATST03P
LOCAL USING SATSP02P
LOCAL USING RLOG-L
LOCAL USING RMSETSTE
LOCAL USING SATEL02P
LOCAL USING SAT00009
LOCAL USING SATPA02P
LOCAL USING NOMVI-2A
LOCAL USING VSUBPA-L
LOCAL USING SATLGV1P
LOCAL USING RACTLF-A
LOCAL USING RMTASK-P
* ----------------------------------------------------------------------
LOCAL
1 MONITOR VIEW OF NRM-MONITOR
/*SU4  2 M-MONITOR-NODE
/*SU5  2 M-NATRPT-DBID
/*SU5  2 M-NATRPT-FNR
  2 M-NATRPT-DBID-N5
  2 M-NATRPT-FNR-N5
  2 M-WAIT-MINIMUM
  2 M-WAIT-MAXIMUM
  2 M-WAIT-INCREMENT
  2 M-BATCH-MODULE
  2 M-VERSION
  2 REDEFINE M-VERSION
    3 M-VERS-VERSION-A                (A2)
    3 REDEFINE M-VERS-VERSION-A
      4 M-VERS-VERSION-A0             (A1)
      4 M-VERS-VERSION-A1             (A1)
    3 M-VERS-RELEASE-A                (A2)
    3 REDEFINE M-VERS-RELEASE-A
      4 M-VERS-RELEASE-A0             (A1)
      4 M-VERS-RELEASE-A1             (A1)
    3 M-VERS-SP-A                     (A2)
    3 REDEFINE M-VERS-SP-A
      4 M-VERS-SP-A0                  (A1)
      4 M-VERS-SP-A1                  (A1)
    3 M-VERS-CF-A                     (A4)
    3 M-VERS-MIGRATION-IN-PROGRESS    (A1)
    3 M-VERS-DATE                     (A8)
  2 REDEFINE M-VERSION
    3 M-VERS-VERSION-N                (N2)
    3 M-VERS-RELEASE-N                (N2)
    3 M-VERS-SP-N                     (N2)
    3 M-VERS-CF-N                     (N4)
1 #NOM-VERSION-A3                    (A3)
1 SYSTEM-INFO VIEW OF SYSTEM-INFO
  2 ERROR-CODE
  2 ERROR-TEXT
  2 SYSTEM-TYPE
  2 SYSTEM-RELEASE
  2 ESY-VERSION
  2 REDEFINE ESY-VERSION
    3 ESY-MAIN-VERSION (N1)
1 NATPROC-USERS  VIEW OF NATPROC-USERS
  2 JOB-ID
* *****
1 #START-BY                  (A8)
1 #NODE                      (N5)
1 REDEFINE #NODE
  2 #NODE-A                  (A5)
1 #EOM-SYSF                  (A10)
1 REDEFINE #EOM-SYSF
  2 #EOM-DBID                (N5)
  2 #EOM-FNR                 (N5)
1 #SAT-LIBRARY               (A8)
1 #SAT-SYSF                  (A10)
1 REDEFINE #SAT-SYSF
  2 #SAT-DBID                (N5)
  2 #SAT-FNR                 (N5)
1 #SAT-MEMBER-OLD            (A8)    INIT <'SATP000'>
1 REDEFINE #SAT-MEMBER-OLD
  2 #SAT-FIL2                (A4)
  2 #SAT-NODE-OLD            (N3)
1 #SAT-MEMBER                (A8)    INIT <'SP00000'>
1 REDEFINE #SAT-MEMBER
  2 #SAT-FIL1                (A2)
  2 #SAT-NODE                (N5)
1 #SAT-NAME                  (A16)   INIT <'SAT'>
1 #PRD-MEMBER                (A8)
1 #PRD-NAME                  (A16)
1 #SYSF                      (A12)
1 I                          (I2)
1 J                          (I2)
1 #SATENV-BLOCK              (A250)
1 REDEFINE #SATENV-BLOCK
  2 #SATENV-LINES            (A50/1:5)
1 #NATENV-BLOCK              (A1080)
1 REDEFINE #NATENV-BLOCK
  2 #NATENV-LINES            (A60/1:18)
1 #BTCH-MODULE               (A54)
1 #BTCH-JOBNAME              (A8) INIT <'NOM00000'>
1 REDEFINE #BTCH-JOBNAME
  2 #BTCH-PREF               (A3)
  2 #BTCH-NODE               (N5)
1 #TYPE                      (A8)
1 #ESY-USER                  (A8)
1 #SUBT-MODULE               (A54)
/* Please take note if you change the NAME of subtask then you
/* must also make changes to RHANMO and RHANMON ....
/* Also please remember that NPR uses SUB-TASK name for
/* eventing, so if you make a change here NPR must know
/* about this change, this value is hard coded in NPR ???
*
1 #CHK-DBID                  (N5)
1 #CHK-FNR                   (N5)
1 #SKEL-MEMBER               (A8)
1 #NSC-ACTIVE                (L)
1 #NSC-USERID                (A8)
1 #NSC-PASSWORD              (A8)
1 PI                         (P2)
1 SI                         (N1)
1 REDEFINE SI
  2 SI-A                     (A1)
1 #STEPLIB                   (A20) INIT <'        /     /     '>
1 REDEFINE #STEPLIB
  2 #STEPLIB-LIBRARY         (A8)
  2 #STEPLIB-FIL1            (A1)
  2 #STEPLIB-DBID            (N5)
  2 #STEPLIB-FIL2            (A1)
  2 #STEPLIB-FNR             (N5)
1 #INPUT-LINE                (A80)
1 #SCRAMBLED                 (A32)
1 #UNSCRAMBLED               (A16)
1 #VERSION-MSG               (A13)
1 NATURAL-SUB-TASK VIEW OF NATURAL-SUB-TASK
  2 ERROR-CODE
  2 NAT-STATUS
  2 DDNAME
1 COMMON-DATA VIEW OF COMMON-DATA
  2 ERROR-CODE
1 #COM-CREATE (L)
1 #I                (I4)
1 #SUFFIX-CHARS     (A26) INIT <'MABCDEFGHIJKLNOPQRSTUVWXYZ'>
1 REDEFINE #SUFFIX-CHARS
  2 #SUFFIX-CHAR    (A1/26)
1 EVENTING
  2 P-NODE                      (N5)
  2 P-EVENT-NAME                (A8)
  2 P-FUNCTION                  (A8)
  2 P-WAIT-TIME                 (N4)
  2 P-ERROR-CODE                (N4)
  2 P-ERROR-TEXT                (A250)
  2 P-EVENT-MESSAGE             (A250)
1 NAT00053-PARMS
  2 NAT00053-NAT-FCT            (A1)
  2 NAT00053-NAT-MEM            (A8)
  2 NAT00053-NAT-LIB            (A8)
  2 NAT00053-NAT-DBID           (B2)
  2 NAT00053-NAT-FNR            (B2)
  2 NAT00053-RSP-CODE           (I2)
  2 NAT00053-RSP-FIELDS         (A55)
1 #STEPLIB-EXIST                (L)
1 #TRACE                        (A5)
1 #TRACING                      (L)    INIT <TRUE> /* set to FALSE ÜÜÜ
1 #TRACE-LEVEL                  (I2)   CONST <100> /* set to 0     ÜÜÜ
1 #FOUND                        (L)
1 #CALLER                       (A8) INIT <*PROGRAM>
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
FORMAT PS=60 LS=133
WRITE NOTITLE NOHDR ' '
*
RESET G-NATRP-ERC
*
PERFORM DISPLAY-HEADER
*
DECIDE FOR EVERY CONDITION
  WHEN G-NATRP-ERC = 0
    PERFORM INPUT-PARAMETER
  WHEN G-NATRP-ERC = 0
    PERFORM SYSTEM-INFORMATION
  WHEN G-NATRP-ERC = 0
    PERFORM SET-EOM-SYSTEM-FILE
  WHEN G-NATRP-ERC = 0
    IF #TRACING
      CALLNAT 'RMSETSTN' #EQU-INIT #NODE #EOM-DBID #EOM-FNR
        G-SHUTDOWN G-TASK-NUMBER #TRACE-LEVEL /* set trace level 100
    ELSE
      CALLNAT 'RMSETSTN' #EQU-INIT #NODE #EOM-DBID #EOM-FNR
        G-SHUTDOWN G-TASK-NUMBER
    END-IF
    END TRANSACTION
  WHEN G-NATRP-ERC = 0
    PERFORM EVALUATE-SATENV-PARAMETER
  WHEN G-NATRP-ERC = 0
    IF SYSTEM-INFO.SYSTEM-TYPE = SCAN 'BS2'
      PERFORM EVALUATE-BS2000-USER
    END-IF
  WHEN G-NATRP-ERC = 0
    IF NOT G-NSC-ACTIVE
      PERFORM EVALUATE-STEPLIBS
    END-IF
  WHEN G-NATRP-ERC = 0
    PERFORM EVALUATE-NATENV-PARAMETER
  WHEN G-NATRP-ERC = 0
    PERFORM READ-MONITOR-DEFINITIONS
  WHEN G-NATRP-ERC = 0
    PERFORM LOGON-TO-ESY
  WHEN G-NATRP-ERC = 0
    PERFORM START-PRODUCT
  WHEN G-NATRP-ERC = 0
    PERFORM WRITE-LOG-RECORD
  WHEN NONE IGNORE
END-DECIDE
*
IF  #COM-CREATE
  FIND COMMON-DATA WITH NODE = #NODE AND FUNCTION = 'DELETE'
  AND DATA-ID = SATST-SUBTASK-MESSAGE-FILE                            /*
    IF COMMON-DATA.ERROR-CODE EQ 0
      WRITE *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II':'SS'.'T)
        SATST-SUBTASK-MESSAGE-FILE 'Un-created'
    END-IF
  END-FIND
END-IF
*
PERFORM DISPLAY-TRAILER
*
STACK TOP COMMAND 'TECH'
STACK TOP COMMAND 'SYSPROF'
STACK TOP COMMAND 'LASTMSG'
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE INPUT-PARAMETER
************************************************************************
IF *DATA EQ 1
  INPUT (IP=OFF) #INPUT-LINE
  PRINT *PROGRAM ' INPUT-LINE => ' #INPUT-LINE
  SEPARATE #INPUT-LINE INTO #START-BY #NODE-A #EOM-SYSF #SAT-LIBRARY
    #SAT-SYSF
  #NODE := VAL(#NODE-A)
ELSE
  INPUT  (IP=OFF) #START-BY #NODE #EOM-SYSF #SAT-LIBRARY #SAT-SYSF
  WRITE 'Startup parameters:' /
    '=' #START-BY '=' #NODE '=' #EOM-SYSF '=' #SAT-LIBRARY '=' #SAT-SYSF
END-IF
PERFORM ADD-SAT-STEPLIB
IF G-NATRP-ERC NE 0
  ESCAPE ROUTINE
END-IF
*
PERFORM EVALUATE-START-RECORD
IF G-NATRP-ERC NE 0
  ESCAPE ROUTINE
END-IF
CALLNAT 'SATLGFVN' SATLGV-PARMS
IF SATLGV-RC NE 0
  WRITE *PROGRAM SATLGV-ERROR-TEXT
  IF SATLGV-LOG-DBID NE 0 OR SATLGV-LOG-FNR NE 0
    WRITE *PROGRAM 'Dbid:' SATLGV-LOG-DBID 'Fnr:' SATLGV-LOG-FNR
  END-IF
  G-NATRP-ERC:= SATLGV-RC
END-IF
IF G-NATRP-ERC NE 0
  ESCAPE ROUTINE
END-IF
RESET RACTLF-LOGGING RACTLF-ERROR-LOGGING
RACTLF-LFILE-1:= 91
RACTLF-LFILE-2:= 206
CALLNAT 'RACTLF-N' RACTLF-PARMS
IF RACTLF-ERROR-CODE NE 0
  WRITE *PROGRAM RACTLF-ERROR-CODE RACTLF-ERROR-TEXT
  WRITE *PROGRAM 'Dbid1:' RACTLF-DBID-1 'Fnr1:' RACTLF-FNR-1
  WRITE *PROGRAM 'Dbid2:' RACTLF-DBID-2 'Fnr2:' RACTLF-FNR-2
  G-NATRP-ERC:= RACTLF-ERROR-CODE
END-IF
*
WRITE 'Parameter for this run'
WRITE '   Started by ................' #START-BY
WRITE '   Node ......................' #NODE
*
COMPRESS '(' #EOM-DBID ',' #EOM-FNR ')' TO #SYSF LEAVING NO
WRITE '   NOM System File ...........' #SYSF
COMPRESS '(' RACTLF-DBID-1 ',' RACTLF-FNR-1 ')' TO #SYSF LEAVING NO
WRITE '   NOM Active Data ...........' #SYSF
COMPRESS '(' SATLGV-LOG-DBID ',' SATLGV-LOG-FNR ')' TO #SYSF LEAVING NO
WRITE '   SAT Log File ..............' #SYSF
*
WRITE '   SAT Library ...............' #SAT-LIBRARY
*
COMPRESS '(' #SAT-DBID ',' #SAT-FNR ')' TO #SYSF LEAVING NO
WRITE '   SAT SYSF ..................' #SYSF
WRITE '   SAT Parameter Member ......' #SAT-MEMBER
WRITE '   SAT Parameter Prefix ......' #SAT-NAME
WRITE '   Product Parameter Member ..' #PRD-MEMBER
WRITE '   Product Parameter Prefix ..' #PRD-NAME
*
END-SUBROUTINE /* INPUT-PARAMETER
*
************************************************************************
DEFINE SUBROUTINE DISPLAY-HEADER
************************************************************************
WRITE 'S T A R T   P R O C E D U R E   F O R   E O M   M O N I T O R'
WRITE '============================================================='
WRITE *PROGRAM 'started at' *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
SKIP 3
*
END-SUBROUTINE /* DISPLAY-HEADER
*
************************************************************************
DEFINE SUBROUTINE DISPLAY-TRAILER
************************************************************************
SKIP 3
WRITE *PROGRAM 'ended at' *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
*
END-SUBROUTINE  /*  DISPLAY-TRAILER
*
************************************************************************
DEFINE SUBROUTINE SET-EOM-SYSTEM-FILE
************************************************************************
SATLF-FUNCTION := 'SET'
SATLF-LFILE    := 206
SATLF-DBID-N5  := #EOM-DBID
SATLF-FNR-N5   := #EOM-FNR
*
SATLF-SATVERS  := 21
CALLNAT SAT-GET-SET-LFILE SATLF-SATVERS SATLF-PARMS (*)
*
IF SATLF-ERROR-CODE NE 0
  G-NATRP-ERC := SATLF-ERROR-CODE
  G-NATRP-ERT := SATLF-ERROR-TEXT
  SKIP  2
  WRITE '--> Error setting NOM System File ' G-NATRP-ERC
  PRINT '-->' G-NATRP-ERT /*SU2 (AL=70)
ELSE
  SKIP  2
  WRITE '-->TRACE: LFILE 206 set to' SATLF-DBID-N5 '/' SATLF-FNR-N5
END-IF
*
END-SUBROUTINE /* SET-EOM-SYSTEM-FILE
*
************************************************************************
DEFINE SUBROUTINE EVALUATE-SATENV-PARAMETER
************************************************************************
RESET  SATMM-PARMS (*)
SATMM-TYPE := 'SATENV'
*
PERFORM EVALUATE-PARAMETER-BLOCK
IF G-NATRP-ERC NE 0
  ESCAPE ROUTINE
END-IF
*
#SATENV-BLOCK := SATMM-BLOCK-RESULT
*
RESET  SATKY-PARMS (*)
SATKY-LINE := #SATENV-BLOCK
*
SATKY-SATVERS := 21
REPKY. REPEAT
  UNTIL SATKY-EOL = TRUE
*
  CALLNAT SAT-GET-KEY-VALUE SATKY-SATVERS SATKY-PARMS (*)
*
  IF SATKY-ERROR-CODE NE 0
    G-NATRP-ERC := SATKY-ERROR-CODE
    G-NATRP-ERT := SATKY-ERROR-TEXT
    SKIP  2
    COMPRESS 'Error reading SATENV Keywords ' G-NATRP-ERC TO G-NATRP-ERT
    PERFORM WRITE-ERR
    ESCAPE BOTTOM (REPKY.)
  ELSE
    WRITE '-->TRACE: SATKEY' SATKY-KEYWORD ':=' SATKY-VALUE
  END-IF
*
  DECIDE ON FIRST SATKY-KEYWORD
    VALUE 'NATTASK'  #SUBT-MODULE  := SATKY-VALUE
    VALUE 'NATBATCH' #BTCH-MODULE  := SATKY-VALUE
    VALUE 'JOBPREF'  #BTCH-PREF    := SATKY-VALUE
    VALUE 'NATSKEL'  #SKEL-MEMBER  := SATKY-VALUE
    VALUE 'ESYUSER'  #ESY-USER     := SATKY-VALUE
    VALUE 'NSCUSER'  #NSC-USERID   := SATKY-VALUE
    VALUE 'NSCPSWD'  #NSC-PASSWORD := SATKY-VALUE
    VALUE 'NSC'
      IF SATKY-VALUE = 'YES'
        #NSC-ACTIVE := TRUE
      ELSE
        #NSC-ACTIVE := FALSE
      END-IF
    VALUE 'TRACE'
      #TRACE := SATKY-VALUE
      IF #TRACE = 'ON' OR = '1' OR = '100' OR = 'YES'
        #TRACING := TRUE
      ELSE
        #TRACING := FALSE
      END-IF
    NONE VALUE IGNORE
  END-DECIDE
END-REPEAT
*
IF #ESY-USER = ' '
  #ESY-USER := *USER
END-IF
*
#BTCH-NODE := #NODE
EXAMINE #BTCH-JOBNAME FOR ' ' DELETE
RMTASK-P.FUNCTION       := 'T'
RMTASK-P.SUBTASK-NUMBER := 1
CALLNAT 'RMTASKID' RMTASK-P
IF #TRACING
  WRITE '-->Trace:' '=' #BTCH-NODE '=' RMTASK-P.TASK-ID
END-IF
*
SKIP 2
WRITE 'SAT Environment (SATENV)'
WRITE '   ESY UserID ................' #ESY-USER
WRITE '   NATURAL Version ...........' *NATVERS
*
IF #TYPE = 'SUBTASK'
  WRITE '   NATURAL Subtask Module ....' #SUBT-MODULE
  WRITE '   NATURAL Subtask Name ......' RMTASK-P.TASK-ID
ELSE
  WRITE '   NATURAL Batch Module ......' #BTCH-MODULE
  WRITE '   NATURAL Batch Jobname .....' #BTCH-JOBNAME
  WRITE '   Skeleton Library ..........' #SAT-LIBRARY
  WRITE '   Skeleton Member ...........' #SKEL-MEMBER
  COMPRESS '(' #SAT-DBID ',' #SAT-FNR ')' TO #SYSF LEAVING NO
  WRITE '   Skeleton SYSF .............' #SYSF
END-IF
*
IF #NSC-ACTIVE
  WRITE '   NATURAL SECURITY UserID ...' #NSC-USERID
  WRITE '   NATURAL SECURITY Password .' '$$$$$$$$'
END-IF
*
END-SUBROUTINE /* EVALUATE-SATENV-PARAMETER
*
************************************************************************
DEFINE SUBROUTINE EVALUATE-BS2000-USER
************************************************************************
RESET  SATPA-PARMS (*)
SATPA-SATDBID-N5     := #SAT-DBID
SATPA-SATFNR-N5      := #SAT-FNR
SATPA-TYPE           := 'NOMENV'
SATPA-LIBRARY  (1:2) := #SAT-LIBRARY
SATPA-MEMBER   (1)   := #SAT-MEMBER
SATPA-MEMBER   (2)   := #PRD-MEMBER
SATPA-NAME     (1)   := #SAT-NAME
SATPA-NAME     (2)   := #PRD-NAME
SATPA-KEYWORD  (1)   := 'BS2USER'
SATPA-SATVERS        := 21
CALLNAT SAT-GET-MERGED-PARM-ARRAY SATPA-SATVERS SATPA-PARMS (*)
*
IF SATPA-ERROR-CODE NE 0
  G-NATRP-ERC := SATPA-ERROR-CODE
  G-NATRP-ERT := SATPA-ERROR-TEXT
  SKIP  2
  COMPRESS 'Error reading BS2USER' G-NATRP-ERC G-NATRP-ERT TO G-NATRP-ERT
  PERFORM WRITE-ERR
  ESCAPE ROUTINE
END-IF
*
IF SATPA-VALUE (1) NE ' '
  #ESY-USER := SATPA-VALUE (1)
END-IF
*
WRITE '   BS2000 UserID .............' #ESY-USER
*
END-SUBROUTINE /* EVALUATE-BS2000-USER
*
************************************************************************
DEFINE SUBROUTINE EVALUATE-NATENV-PARAMETER
************************************************************************
RESET  SATMM-PARMS (*)
SATMM-TYPE := 'NATENV'
*
PERFORM EVALUATE-PARAMETER-BLOCK
IF G-NATRP-ERC NE 0
  ESCAPE ROUTINE
END-IF
*
#NATENV-BLOCK := SATMM-BLOCK-RESULT
CALLNAT 'SATID02N' #NATENV-BLOCK
*
RESET J
FOR I = 1 TO 18
  IF #NATENV-LINES (I) = ' '
    ESCAPE TOP
  END-IF
  ADD 1 TO J
  IF J = 1
    SKIP 2
    WRITE 'Natural Environment (NATENV) .' #NATENV-LINES (I)
  ELSE
    WRITE '                              ' #NATENV-LINES (I)
  END-IF
END-FOR
*
END-SUBROUTINE  /* EVALUATE-NATENV-PARAMETER
*
************************************************************************
DEFINE SUBROUTINE EVALUATE-PARAMETER-BLOCK
************************************************************************
SATMM-SATDBID-N5 := #SAT-DBID
SATMM-SATFNR-N5  := #SAT-FNR
SATMM-LIBRARY (1) := #SAT-LIBRARY
SATMM-MEMBER  (1) := #SAT-MEMBER
SATMM-NAME    (1) := #SAT-NAME
SATMM-LIBRARY (2) := #SAT-LIBRARY
SATMM-MEMBER  (2) := #PRD-MEMBER
SATMM-NAME    (2) := #PRD-NAME
SATMM-SATVERS := 21
CALLNAT SAT-MERGE-PARM-MEMBERS SATMM-SATVERS SATMM-PARMS (*)
IF SATMM-ERROR-CODE NE 0
  G-NATRP-ERC := SATMM-ERROR-CODE
  G-NATRP-ERT := SATMM-ERROR-TEXT
  SKIP  2
  COMPRESS 'Error reading Parameter Block ' G-NATRP-ERC G-NATRP-ERT
    TO G-NATRP-ERT
  PERFORM WRITE-ERR
END-IF
*
END-SUBROUTINE /* EVALUATE-PARAMETER-BLOCK
*
************************************************************************
DEFINE SUBROUTINE READ-MONITOR-DEFINITIONS
************************************************************************
CALLNAT 'NOMVI-2N' NOMVI
RMTASK-P.FUNCTION       := 'S'
RMTASK-P.SUBTASK-NUMBER := 1
CALLNAT 'RMTASKID' RMTASK-P
IF #TRACING
  WRITE '-->Trace: Task-ID generated:' RMTASK-P.TASK-ID
END-IF
FNDMO. FIND MONITOR WITH M-MONITOR-ID = RMTASK-P.TASK-ID
  IF NO RECORDS FOUND
    G-NATRP-ERC := 9999
    SKIP  2
    COMPRESS 'Monitor defintion not found' G-NATRP-ERC G-NATRP-ERT
      TO G-NATRP-ERT
    PERFORM WRITE-ERR
    ESCAPE BOTTOM (FNDMO.)
  END-NOREC
/* Get local monitor node number +NOD-LOCAL-NODE
  CALLNAT 'RMSWNODE' 'L' 1 0 0 FALSE #FOUND
  IF NOT #FOUND /*SU6 ..
    G-NATRP-ERC := 0491 /*Monitor record not found.
    G-NATRP-ERT := F#GETMSG (<G-NATRP-ERC>)
    PRINT G-NATRP-ERT
    PERFORM WRITE-MESSAGE-TO-LOG
    G-NATRP-ERC := 9105 /*NOM is not installed correctly...
    G-NATRP-ERT := F#GETMSG (<G-NATRP-ERC>)
    PRINT G-NATRP-ERT
    PERFORM WRITE-MESSAGE-TO-LOG
    TERMINATE 50
/*  G-NATRP-ERC := 9999 SKIP  2
/*  COMPRESS 'Node spool definition not found' G-NATRP-ERC G-NATRP-ERT
/*    TO G-NATRP-ERT PERFORM WRITE-ERR ESCAPE BOTTOM (FNDMO.)
  END-IF
/*SU4 FNDUPD. FIND(1) NODE-SPOOL-DATA WITH M-MONITOR-ID=+NOD-LOCAL-ID
/*SU4  END-FIND
  RESET #CHK-DBID #CHK-FNR
  DECIDE FOR FIRST CONDITION
    WHEN M-NATRPT-DBID-N5 > 0
      #CHK-DBID := M-NATRPT-DBID-N5
      #CHK-FNR  := M-NATRPT-FNR-N5
/*SU5 WHEN M-NATRPT-DBID > 0
/*SU5      #CHK-DBID := M-NATRPT-DBID
/*SU5      #CHK-FNR  := M-NATRPT-FNR
    WHEN NONE IGNORE
  END-DECIDE
*
  DECIDE FOR FIRST CONDITION
    WHEN #CHK-DBID NE #EOM-DBID
      COMPRESS 'Invalid System File DBID' #CHK-DBID TO G-NATRP-ERT
      PERFORM WRITE-ERR
    WHEN #CHK-FNR NE #EOM-FNR
      COMPRESS 'Invalid System File FNR' #CHK-FNR TO G-NATRP-ERT
      PERFORM WRITE-ERR
    WHEN +NOD-LOCAL-NODE NE #NODE /*SU4
      COMPRESS 'Invalid Node' +NOD-LOCAL-NODE TO G-NATRP-ERT /*SU4
      PERFORM WRITE-ERR
    WHEN M-VERS-VERSION-N NE NOMVI-N-VERSION
    OR M-VERS-RELEASE-N NE NOMVI-N-RELEASE OR M-VERS-SP-N NE  NOMVI-N-SP
      COMPRESS 'Version mismatch:' M-VERS-VERSION-N '.' /*SU7
        M-VERS-RELEASE-N '.' M-VERS-SP-N '/' NOMVI-N-VERSION '.'
        NOMVI-N-RELEASE '.' NOMVI-N-SP TO G-NATRP-ERT LEAVING NO
      PERFORM WRITE-ERR
      G-NATRP-ERT := 'execute MIGEND in SYSNOM.' /*SU7
      PERFORM WRITE-ERR
    WHEN M-VERS-MIGRATION-IN-PROGRESS ='Y'
      G-NATRP-ERT := 'Migration in progress.'
      PERFORM WRITE-ERR
    WHEN ANY
      G-NATRP-ERC := 999
      ESCAPE BOTTOM (FNDMO.)
    WHEN NONE IGNORE
  END-DECIDE
*
  RMTASK-P.FUNCTION       := 'L'
  RMTASK-P.SUBTASK-NUMBER := 1
  CALLNAT 'RMTASKID' RMTASK-P
  G-MONITOR-ID := RMTASK-P.TASK-ID
  IF #TRACING
    WRITE '-->Trace: Task ID ='  RMTASK-P.TASK-ID
  END-IF
  IF M-VERS-CF-N  < NOMVI-N-CF
    M-VERS-CF-N   := NOMVI-N-CF
  END-IF
*
  SKIP  2
  WRITE 'Monitor parameters for this run'
  COMPRESS M-VERS-VERSION-A '.' M-VERS-RELEASE-A '.'
    M-VERS-SP-A '.' M-VERS-CF-A TO #VERSION-MSG LEAVING NO
  WRITE '   System File Major Version .' #VERSION-MSG
  WRITE '   Monitor Node ..............' +NOD-LOCAL-NODE (EM=ZZ999)
  WRITE '   Wait minimum ..............' M-WAIT-MINIMUM   (EM=ZZ9)
  WRITE '   Wait increment ............' M-WAIT-INCREMENT (EM=ZZ9)
  WRITE '   Wait maximum ..............' M-WAIT-MAXIMUM   (EM=ZZ9)
*
  IF #TYPE = 'BATCH'
    G-NATRP-ERC := 5
    G-NATRP-ERT := 'Batch mode no longer supported. '-
      'Start NOM monitor in subtask mode.'
    SKIP 3
    WRITE '--> Error ' G-NATRP-ERC ' starting product'
    PRINT G-NATRP-ERT /*SU2 (AL=70)
    PERFORM WRITE-MESSAGE-TO-LOG
    ESCAPE ROUTINE
  END-IF
  M-BATCH-MODULE := #SUBT-MODULE
  UPDATE
  END OF TRANSACTION
*
END-FIND
*
END-SUBROUTINE /* READ-MONITOR-DEFINITIONS
*
************************************************************************
DEFINE SUBROUTINE LOGON-TO-ESY
************************************************************************
CALLNAT 'N-ESYLG' 1X #NODE #ESY-USER #CALLER
  G-NATRP-ERC G-NATRP-ERT 1X
WRITE '-->Trace: After logon to node ' #NODE /
  '-->Trace: WhoAmI function returns ESY-User:' F#WHOAMI(<#NODE>)
IF G-NATRP-ERC NE 0
  SKIP 2
  COMPRESS  'Error logging on to ESY ' G-NATRP-ERC G-NATRP-ERT
    TO G-NATRP-ERT
  PERFORM WRITE-ERR
ELSE
  WRITE '-->TRACE: Logged on to node:' #NODE 'user:' #ESY-USER
END-IF
*
END-SUBROUTINE  /*  LOGON-TO-ESY
*
************************************************************************
DEFINE SUBROUTINE START-PRODUCT
************************************************************************
SATST-NODE-N5        := #NODE
SATST-SYSTEM-TYPE    := SYSTEM-INFO.SYSTEM-TYPE
SATST-SYSTEM-RELEASE := SYSTEM-INFO.SYSTEM-RELEASE
SATST-TYPE           := #TYPE
IF #TRACING
  WRITE '-->TRACE:' '=' SATST-NODE-N5 '=' SATST-SYSTEM-TYPE
    '=' SATST-SYSTEM-RELEASE '=' SATST-TYPE
END-IF
IF #NSC-ACTIVE
  SATST-NSC-ACTIVE   := TRUE
  SATST-NSC-USERID   := #NSC-USERID
  SATST-NSC-PASSWORD := #NSC-PASSWORD
END-IF
*
#NOM-VERSION-A3 := SUBSTR(#PRD-NAME,4)
*
COMPRESS SATSP-START-PRODUCT #NOM-VERSION-A3
  'MON' TO SATST-SUBTASK-MESSAGE-FILE LEAVING NO
IF #TRACING
  WRITE '-->TRACE: DDNAME:' SATST-SUBTASK-MESSAGE-FILE
END-IF
* Create unique sysout DD name if using subtasking
IF #TYPE = 'SUBTASK'
  SETDDNAME.
  FOR #I = 1 TO 26
    COMPRESS 'NO' #SUFFIX-CHAR(#I) #NOM-VERSION-A3 'MO'
      TO SATST-SUBTASK-MESSAGE-FILE LEAVING NO
    FIND COMMON-DATA WITH NODE = #NODE AND FUNCTION = 'CREATE'
    AND DATA-ID = SATST-SUBTASK-MESSAGE-FILE                          /*
    AND NUMBER-OF-ENTRIES = 1 AND ENTRY-LENGTH = 1                    /*
      IF COMMON-DATA.ERROR-CODE EQ 621   /* Already exists
        IF #TRACING
          WRITE '-->TRACE: DDNAME' SATST-SUBTASK-MESSAGE-FILE 'exists.'
        END-IF
        WRITE *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II':'SS'.'T)
          SATST-SUBTASK-MESSAGE-FILE 'Already created'
        RESET #COM-CREATE
      ELSE
        WRITE *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II':'SS'.'T)
          'Create for' SATST-SUBTASK-MESSAGE-FILE 'RC='
          COMMON-DATA.ERROR-CODE
        #COM-CREATE := TRUE
      END-IF
    END-FIND
    IF NOT #COM-CREATE
      ESCAPE TOP
    END-IF
    FIND NATURAL-SUB-TASK WITH NODE = #NODE AND FUNCTION = 'LIST'
    AND NAT-STATUS = 'ACTIVE' AND DDNAME = SATST-SUBTASK-MESSAGE-FILE /*
      IF NO RECORDS FOUND
        P-FUNCTION := 'CHECK' /* whether event is present
        PERFORM EVENTING
        IF P-ERROR-CODE = 0 /* already present, don't use!
          ESCAPE TOP
        END-IF
        ESCAPE BOTTOM(SETDDNAME.)
      END-NOREC
      WRITE *PROGRAM NAT-STATUS DDNAME
      IF NATURAL-SUB-TASK.ERROR-CODE NE 0
        P-FUNCTION := 'CHECK' /* whether event is present
        PERFORM EVENTING
        IF P-ERROR-CODE = 0 /* already present, don't use!
          ESCAPE TOP
        END-IF
        ESCAPE BOTTOM(SETDDNAME.)
      END-IF
    END-FIND
  END-FOR
  P-FUNCTION := 'DEFINE' /* Now it is our event.
  PERFORM EVENTING
END-IF
*
RMTASK-P.FUNCTION       := 'T'
RMTASK-P.SUBTASK-NUMBER := 1
CALLNAT 'RMTASKID' RMTASK-P
*
SATST-BATCH-MODULE   := #BTCH-MODULE
SATST-SUBTASK-MODULE := #SUBT-MODULE
SATST-BATCH-JOBNAME  := #BTCH-JOBNAME
SATST-SUBTASK-NAME   := RMTASK-P.TASK-ID
SATST-SKEL-LIBRARY   := #SAT-LIBRARY
SATST-SKEL-MEMBER    := #SKEL-MEMBER
SATST-SKEL-DBID-N5   := #SAT-DBID
SATST-SKEL-FNR-N5    := #SAT-FNR
SATST-NATLIB         := *LIBRARY-ID
SATST-NATENV         := #NATENV-BLOCK
SATST-NATPGM         := 'RMINIT'
PERFORM SAVE-SUBTASK-PARMS
*
COMPRESS G-MONITOR-ID MONITOR.M-WAIT-MINIMUM MONITOR.M-WAIT-MAXIMUM
  MONITOR.M-WAIT-INCREMENT #NODE #EOM-SYSF #SAT-SYSF #SAT-LIBRARY
  #SAT-MEMBER TO SATST-NATPGM-PARMS
*
SATST-SATVERS := 21
WRITE *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II':'SS'.'T)
  'Starting server task with DDname'
  SATST-SUBTASK-MESSAGE-FILE
CALLNAT SAT-SERVER-START SATST-SATVERS SATST-PARMS-03
*
IF SATST-ERROR-CODE = 0
  SKIP 3
  IF SATST-TYPE = 'BATCH'
    WRITE 'Server Job started (Jobno) ...' SATST-BATCH-JOB-NUMBER
    G-NATRP-ERC := 1500
    COMPRESS SATST-BATCH-JOBNAME '/' SATST-BATCH-JOB-NUMBER
      TO G-NATRP-ERT LEAVING NO
    PERFORM WRITE-MESSAGE-TO-LOG
  ELSE
    WRITE 'Server Task started (Name) ...' SATST-SUBTASK-NAME
    G-NATRP-ERC := 1520
    G-NATRP-ERT := SATST-SUBTASK-NAME
    PERFORM WRITE-MESSAGE-TO-LOG
    IF SYSTEM-INFO.SYSTEM-TYPE = SCAN 'BS2'
        AND SYSTEM-INFO.ESY-MAIN-VERSION > 2 /* NPR 3.1.1 and above
      G-NATRP-ERC := 1500
      FIND (1) NATPROC-USERS WITH NODE = #NODE
          AND TASK-ID = SATST-SUBTASK-NAME AND FULL-SCAN = 'YES'
        COMPRESS SATST-BATCH-JOBNAME '/' JOB-ID
          TO G-NATRP-ERT LEAVING NO
        PERFORM WRITE-MESSAGE-TO-LOG
      END-FIND
    END-IF
  END-IF
ELSE
  G-NATRP-ERC := SATST-ERROR-CODE
  G-NATRP-ERT := SATST-ERROR-TEXT
  SKIP 3
  WRITE '--> error starting product' G-NATRP-ERC
  IF G-NATRP-ERC = 5500 THRU 5999
    PRINT G-NATRP-ERT /*SU2 (AL=70)
    PERFORM WRITE-MESSAGE-TO-LOG
  END-IF
END-IF
*
END-SUBROUTINE /* START-PRODUCT
*
************************************************************************
DEFINE SUBROUTINE SYSTEM-INFORMATION
************************************************************************
FNDSY. FIND (1) SYSTEM-INFO WITH NODE = #NODE
  IF SYSTEM-INFO.ERROR-CODE NE 0
    G-NATRP-ERC := SYSTEM-INFO.ERROR-CODE + 5000
    G-NATRP-ERT := SYSTEM-INFO.ERROR-TEXT
    WRITE '   --> error reading system info' G-NATRP-ERC
    PRINT '   -->' G-NATRP-ERT /*SU2 (AL=70)
  END-IF
  EXAMINE FULL VALUE OF
    SYSTEM-INFO.SYSTEM-TYPE FOR H'00' REPLACE WITH ' '
  SKIP  2
  WRITE 'System Information'
  WRITE '   System Type ...............' SYSTEM-INFO.SYSTEM-TYPE
  WRITE '   System Release ............' SYSTEM-INFO.SYSTEM-RELEASE
END-FIND
*
END-SUBROUTINE  /* SYSTEM-INFORMATION
*
************************************************************************
DEFINE SUBROUTINE EVALUATE-START-RECORD
************************************************************************
RESET SATSP-PARMS (*)
*
#SAT-NODE := #NODE
IF #NODE < 1000
  #SAT-NODE-OLD := #NODE
  NAT00053-NAT-FCT := 'S'
  NAT00053-NAT-MEM := #SAT-MEMBER-OLD
  NAT00053-NAT-LIB := #SAT-LIBRARY
  CALLNAT 'NAT00053' NAT00053-PARMS
  IF  NAT00053-RSP-CODE = 0        /* source exists,
    #SAT-MEMBER := #SAT-MEMBER-OLD /* take this one
  END-IF
END-IF
*
SATSP-SATLIB            := #SAT-LIBRARY
SATSP-SATMEM            := #SAT-MEMBER
SATSP-SATDBID-N5        := #SAT-DBID
SATSP-SATFNR-N5         := #SAT-FNR
SATSP-START-SERVDBID-N5 := #EOM-DBID
SATSP-START-SERVFNR-N5  := #EOM-FNR
SATSP-SATVERS           := 21
CALLNAT SAT-START-PARMS SATSP-SATVERS SATSP-PARMS (*)
*
IF SATSP-ERROR-CODE NE 0
  G-NATRP-ERC := SATSP-ERROR-CODE
  G-NATRP-ERT := SATSP-ERROR-TEXT
  SKIP  2
  WRITE '--> Error reading start record ' G-NATRP-ERC
  PRINT '-->' G-NATRP-ERT /*SU2 (AL=70)
  ESCAPE ROUTINE
END-IF
*
#TYPE              := SATSP-START-TYPE
IF SATSP-START-MEMBER = ' '
  #PRD-MEMBER := #SAT-MEMBER
ELSE
  #PRD-MEMBER := SATSP-START-MEMBER
END-IF
COMPRESS SATSP-START-PRODUCT SATSP-START-PREFIX TO #PRD-NAME LEAVING NO
*
END-SUBROUTINE /* EVALUATE-START-RECORD
*
************************************************************************
DEFINE SUBROUTINE EVALUATE-STEPLIBS
************************************************************************
RESET  SATPA-PARMS (*)
SATPA-SATDBID-N5    := #SAT-DBID
SATPA-SATFNR-N5     := #SAT-FNR
SATPA-TYPE          := 'SATENV'
SATPA-LIBRARY (1:2) := #SAT-LIBRARY
SATPA-MEMBER (1)    := #SAT-MEMBER
SATPA-MEMBER (2)    := #PRD-MEMBER
SATPA-NAME   (1)    := #SAT-NAME
SATPA-NAME   (2)    := #PRD-NAME
FOR SI = 1 TO 6
  ADD 1 TO PI
  COMPRESS 'STEPLIB' SI-A TO SATPA-KEYWORD (PI) LEAVING NO
END-FOR
*
SATPA-SATVERS := 21
CALLNAT SAT-GET-MERGED-PARM-ARRAY SATPA-SATVERS SATPA-PARMS (*)
*
IF SATPA-ERROR-CODE NE 0
  G-NATRP-ERC := SATPA-ERROR-CODE
  G-NATRP-ERT := SATPA-ERROR-TEXT
  SKIP  2
  WRITE '--> Error reading STEPLIB Parameters ' G-NATRP-ERC
  PRINT '-->' G-NATRP-ERT /*SU2 (AL=70)
  ESCAPE ROUTINE
END-IF
*
FOR PI = 1 TO 6
  IF SATPA-VALUE (PI) = ' '
    ESCAPE TOP
  END-IF
*
  SATEL-SATVERS := 31
  SATEL-VALUE   := SATPA-VALUE (PI)
  CALLNAT SAT-EXTRACT-STEPLIB SATEL-SATVERS SATEL-PARMS (*)
  IF SATEL-ERROR-CODE NE 0
    G-NATRP-ERC := SATEL-ERROR-CODE
    G-NATRP-ERT := SATEL-ERROR-TEXT
    SKIP  2
    WRITE '--> Error extracting STEPLIB Parameters ' G-NATRP-ERC
    PRINT '-->' G-NATRP-ERT /*SU2 (AL=70)
    ESCAPE ROUTINE
  END-IF
*
  RESET NAT00009-PARMS
  NAT00009-LIBRARY  := SATEL-LIBRARY
  NAT00009-DBID     := SATEL-DBID-N5
  NAT00009-FNR      := SATEL-FNR-N5
  NAT00009-CIPHER   := SATEL-CIPHER
  NAT00009-PASSWORD := SATEL-PASSWORD
  PERFORM ADD-STEPLIB
  IF G-NATRP-ERC NE 0
    ESCAPE ROUTINE
  END-IF
END-FOR
*
PERFORM DISPLAY-STEPLIBS
*
END-SUBROUTINE /* EVALUATE-STEPLIBS
*
************************************************************************
DEFINE SUBROUTINE ADD-SAT-STEPLIB
************************************************************************
RESET NAT00009-PARMS
NAT00009-LIBRARY := 'SYSSAT'
NAT00009-DBID    := #SAT-DBID
NAT00009-FNR     := #SAT-FNR
PERFORM ADD-STEPLIB
*
END-SUBROUTINE /* ADD-SAT-STEPLIB
*
************************************************************************
DEFINE SUBROUTINE ADD-STEPLIB
************************************************************************
CALLNAT 'RLIBACT' NAT00009-LIBRARY #STEPLIB-EXIST
IF NOT #STEPLIB-EXIST
  RESET NAT00009-DBID NAT00009-FNR
  NAT00009-APPLIC := *LIBRARY-ID
*
  NAT00009-FUNCTION := 08
  CALLNAT 'NAT00009' NAT00009-PARMS
  IF #TRACING
    WRITE '-->Trace: Steplib function executed:'
    WRITE
      'Fct:'      NAT00009-FUNCTION (EM=H)
      'Rsp:'      NAT00009-RESPONSE
      '# active:' NAT00009-NUMBER-ACTIVE
      'IX:'       NAT00009-CURRENT-INDEX /
      'Applic:'   NAT00009-APPLIC
      'Library:'  NAT00009-LIBRARY
      'DBID:'     NAT00009-DBID
      'FNR:'      NAT00009-FNR
  END-IF
  IF NAT00009-NUMBER-ACTIVE > 8
    IF NAT00009-LIBRARY = 'SYSSAT'
      SKIP  2
      WRITE '--> Unable to add SYSSAT Steplib'
      WRITE '--> Steplib table is full'
      WRITE '--> Will attempt to initialize'
      SKIP  2
    ELSE
      G-NATRP-ERC := 0005
      G-NATRP-ERT := 'Error accessing STEPLIB Table'
      SKIP  2
      WRITE '--> Too many STEPLIBs'
    END-IF
    ESCAPE ROUTINE
  END-IF
ELSE
  IF NAT00009-LIBRARY = 'SYSSAT'
    SKIP  2
    WRITE '--> SYSSAT steplib already exists.'
    SKIP  2
  END-IF
END-IF
*
END-SUBROUTINE /* ADD-STEPLIB
*
************************************************************************
DEFINE SUBROUTINE DISPLAY-STEPLIBS
************************************************************************
/*SU9 -> NAT00009-NUMBER-ACTIVE := 8
/* FOR PI = 1 TO NAT00009-NUMBER-ACTIVE
RESET PI
#REP. REPEAT
  ADD 1 TO PI /*SU9
  NAT00009-FUNCTION := 12
  NAT00009-CURRENT-INDEX := PI
  CALLNAT 'NAT00009' NAT00009-PARMS
*
  RESET INITIAL #STEPLIB
  #STEPLIB-LIBRARY := NAT00009-LIBRARY
  #STEPLIB-DBID    := NAT00009-DBID
  #STEPLIB-FNR     := NAT00009-FNR
  EXAMINE #STEPLIB FOR ' ' DELETE
*
  IF PI = 1
    WRITE '   STEPLIBs...................' #STEPLIB
  ELSE
    WRITE '                              ' #STEPLIB
  END-IF
  IF PI GE NAT00009-NUMBER-ACTIVE /*SU9
    ESCAPE BOTTOM
  END-IF
END-REPEAT
*
END-SUBROUTINE /* DISPLAY-STEPLIBS
*
************************************************************************
DEFINE SUBROUTINE WRITE-LOG-RECORD
************************************************************************
IF #START-BY = 'AUTOSTAR'
  LG-USERID := G-MONITOR-ID
  LG-MSG := '1512' /* 'MONITOR<AUTO-STARTUP>'
ELSE
  LG-USERID := #START-BY
  LG-MSG := '1511' /* 'MONITOR<STARTUP>'
END-IF
LG-CODE := 'MO'
CALLNAT 'RLOG' PL-PARMS
END TRANSACTION
*
END-SUBROUTINE /* WRITE-LOG-RECORD
*
************************************************************************
DEFINE SUBROUTINE WRITE-MESSAGE-TO-LOG
************************************************************************
IF G-NATRP-ERC = 5500 THRU 5999
  LG-MSG:= G-NATRP-ERT
ELSE
  COMPRESS G-NATRP-ERC G-NATRP-ERT TO LG-MSG
END-IF
IF #START-BY = 'AUTOSTAR'
  LG-USERID := G-MONITOR-ID
ELSE
  LG-USERID := #START-BY
END-IF
IF LG-USERID = ' '
  LG-USERID := *PROGRAM
END-IF
*
LG-CODE := 'MO'
CALLNAT 'RLOG' PL-PARMS
END TRANSACTION
RESET G-NATRP-ERC G-NATRP-ERT
*
END-SUBROUTINE /* WRITE-MESSAGE-TO-LOG
*
************************************************************************
DEFINE SUBROUTINE SAVE-SUBTASK-PARMS
************************************************************************
FIND NRM-SUBTASK-PARMS WITH M-MONITOR-ID = 'SUBTPARM'
  DELETE
END-FIND
NRM-SUBTASK-PARMS.M-MONITOR-ID        := 'SUBTPARM'
NRM-SUBTASK-PARMS.SP-SYSTEM-TYPE      := SATST-SYSTEM-TYPE
NRM-SUBTASK-PARMS.SP-SYSTEM-RELEASE   := SATST-SYSTEM-RELEASE
NRM-SUBTASK-PARMS.SP-TASK-TYPE        := SATST-TYPE
NRM-SUBTASK-PARMS.SP-NSC-ACTIVE       := SATST-NSC-ACTIVE
NRM-SUBTASK-PARMS.SP-NSC-USERID       := SATST-NSC-USERID
#UNSCRAMBLED                          := SATST-NSC-PASSWORD
CALLNAT 'SATTS01N' 'S' #UNSCRAMBLED #SCRAMBLED /*SU8
NRM-SUBTASK-PARMS.SP-NSC-PASSWORD     := #SCRAMBLED
NRM-SUBTASK-PARMS.SP-BATCH-MODULE     := SATST-BATCH-MODULE
NRM-SUBTASK-PARMS.SP-SUBTASK-MODULE   := SATST-SUBTASK-MODULE
NRM-SUBTASK-PARMS.SP-SKELETON-LIBRARY := SATST-SKEL-LIBRARY
NRM-SUBTASK-PARMS.SP-SKELETON-NAME    := SATST-SKEL-MEMBER
NRM-SUBTASK-PARMS.SP-SAT-DBID         := SATST-SKEL-DBID-N5
NRM-SUBTASK-PARMS.SP-SAT-FNR          := SATST-SKEL-FNR-N5
* SU1 ATTENTION: A250 := A1080 -> data loss possible ÜÜ
NRM-SUBTASK-PARMS.SP-NATENV           := SATST-NATENV
STORE NRM-SUBTASK-PARMS
END TRANSACTION
*
END-SUBROUTINE /* SAVE-SUBTASK-PARMS
*
************************************************************************
DEFINE SUBROUTINE EVENTING
************************************************************************
P-NODE            := #NODE
P-EVENT-NAME      := SATST-SUBTASK-MESSAGE-FILE
P-WAIT-TIME       := 0
IF P-EVENT-NAME = ' ' /* no eventing intended
  P-ERROR-CODE := 1
  ESCAPE ROUTINE
END-IF
CALLNAT 'RMEVNT-N' EVENTING
IF P-ERROR-CODE NE 0 AND P-ERROR-CODE NE 890 /* does not exist
  G-NATRP-ERC := P-ERROR-CODE
  G-NATRP-ERT := P-ERROR-TEXT
  SKIP 3
  WRITE '--> error starting product' G-NATRP-ERC
  PRINT G-NATRP-ERT /*SU2 (AL=70)
  PERFORM WRITE-MESSAGE-TO-LOG
END-IF
*
END-SUBROUTINE /* EVENTING
*
************************************************************************
DEFINE SUBROUTINE WRITE-ERR /*SU2
/*SU3 PERFORM WRITE-ERR
************************************************************************
G-NATRP-ERC := 5
PRINT '-->' G-NATRP-ERT /*SU2 (AL=70)
EXAMINE G-NATRP-ERT FOR ' ' REPLACE '_'
PERFORM WRITE-MESSAGE-TO-LOG
*
END-SUBROUTINE /* EVENTING
*
END
