DEFINE DATA LOCAL
/* >Natural Source Header 000000
/* :Mode S
/* :CP
/* <Natural Source Header
1 GDATA (A252) /* GLOBAL DATA AREA
1 REDEFINE GDATA /* ----------------
  2 GLENG (I2) /* LENGTH OF GLOBAL DATA
  2 GFILLER1 (A2)
  2 GWRKA (B4)
  2 GBASP (A8) /* BASE SOFTWARE AG PRODUCT
  2 GVER (A4) /* PRODUCT VERSION AND SM-LEVEL
  2 GFILLER2 (A4)
  2 GTPM (A8) /* TP-MONITOR (*TPSYS)
  2 GOPS (A8) /* OPERATING SYSTEM (*OPSYS)
  2 GMOD1 (B1) /* RUN MODES (XA-ESA SYSTEMS)
  2 GMOD2 (B1)
  2 GWRKL (I2)
  2 GFILLER3 (A8)
  2 GANCH (B4)
  2 GTERM (A8) /* TP-TERMINAL ID  (*INIT-ID)
  2 GIUID (A8) /* INITIAL USER ID (*INIT-USER)
  2 GCUID (A8) /* CURRENT USER ID (*USER)
  2 GGRP (A8) /* CURRENT GROUP   (*GROUP)
  2 GCAPL (A8) /* CURRENT LOGON   (*APPLIC-ID)
  2 GPGM (A8) /* CURRENT PROGRAM (*PROGRAM)
  2 GLINE (N4) /* CURRENT STATEMENT LINE NUMBER
  2 GLEV (I1) /* CURRENT PROGRAM LEVEL (*LEVEL
  2 GTYPE (A1) /* CURRENT EVENT TYPE
  2 GCPUTM (I2) /* CPU TIME REMAINDER (MS)
  2 GCPUT (I4) /* SESSION CPU-TIME 1/100S
1 LDATA (A252) /* LOCAL DATA AREA
1 REDEFINE LDATA /* ---------------
  2 LLENG (I2) /* LENGTH OF LOCAL DATA
  2 LTYPE (A1) /* CURRENT EVENT SUBTYPE
1 LOCALS (A40) /* SESSION CONTROL EVENT DATA
1 REDEFINE LOCALS /* --------------------------
  2 SLENG (I2) /* LENGTH OF SESSION CONTR. DATA
  2 STYPE (A1) /* SESSION EVENT SUBTYPE
  2 SRCI (A1) /* SYSTEM/USER RETURN CODE IND.
  2 SRC (B4) /* TERMINATION RETURN CODE
  2 SMSG (A8) /* TERMINATION MESSAGE ID
  2 SBPGM (A8) /* SESSION BACKEND PROGRAM NAME
1 LOCALP (A40) /* PROGRAM EVENT DATA
1 REDEFINE LOCALP /* ------------------
  2 PLENG (I2) /* LENGTH OF PROGRAM DATA
  2 PTYPE (A1) /* PROGRAM EVENT SUBTYPE
  2 PPTYP (A1) /* PROGRAM TYPE
  2 PRLIB (A8) /* PROGRAM LIBRARY
  2 PRNAM (A8) /* PROGRAM NAME
  2 PREST (A20)
  2 REDEFINE PREST /* PROGRAM START/END ONLY
    3 PDBID (I4) /* SYSTEM FILE DBID
    3 PFNR (I4) /* SYSTEM FILE FNR
  2 REDEFINE PREST /* PROGRAM LOAD ONLY
    3 PITYP (A1) /* INVOCATION TYPE
1 LOCALD (A40) /* DATABASE CALL EVENT DATA
1 REDEFINE LOCALD /* -------------------------
  2 DLENG (I2) /* LENGTH OF DATABASE CALL DATA
  2 DTYPE (A1) /* BEFORE/AFTER DATABASE CALL
  2 DBTYP (A1) /* DATABASE TYPE
  2 DBAL (B4)
  2 DCMD (A4) /* COMMAND CODE
  2 DCID (B4) /* COMMAND ID
  2 DDBID (I4) /* DATABASE ID
  2 DFNR (I4) /* FILE NUMBER
  2 DRSP (I4) /* RESPONSE CODE
  2 DSUBC (I4) /* SUBCODE AFTER DB CALL
  2 DCTIM (I4) /* ADABAS COMMAND TIME
1 LOCALI (A40) /* TERMINAL I/O EVENT DATA
1 REDEFINE LOCALI /* -----------------------
  2 ILENG (I2) /* LENGTH OF TERMINAL I/O DATA
  2 ITYPE (A1) /* BEFORE/AFTER TERMINAL I/O
  2 IFILLER1 (A1)
  2 IOLNG (I4) /* NUMBER OF BYTES SEND OUT
  2 IILNG (I4) /* NUMBER OF BYTES READ IN
  2 ITSA (I4) /* TOTAL SESSION STORAGE ALLOC.
  2 ICMP (I4) /* COMPRESSED STORAGE LENGTH
1 LOCALC (A40) /* EXT. SUBPROG. CALL EVENT DATA
1 REDEFINE LOCALC /* -----------------------------
  2 CLENG (I2) /* LENGTH OF EXT. PGM. CALL DATA
  2 CTYPE (A1) /* BEFORE/AFTER SUBPROGRAM CALL
  2 CMODE (A1) /* STATIC/DYNAMIC SUBPROGRAM
  2 CLOC (A1) /* STATIC SUBPROGRAM LOCATION
  2 CCALL (A1) /* CALL BY REFERENCE/VALUE
  2 CFILLER1 (A2)
  2 CPADR (B4) /* SUBPROGRAM PARAMETER ADDRESS
  2 CDADR (B4) /* PARAMETER DESCRIPTION ADDRESS
  2 CNAME (A8) /* SUBPROGRAM NAME
  2 CRESP (B4) /* SUBPROGRAM RESPONSE CODE
1 LOCALE (A40) /* RUNTIME ERROR EVENT DATA
1 REDEFINE LOCALE /* ------------------------
  2 ELENG (I2) /* LENGTH OF RUNTIME ERROR DATA
  2 ETYPE (A1)
  2 EFILLER1 (A1)
  2 ENUM (N4) /* ERROR NUMBER
  2 EABC (A4) /* EXTERNAL ABEND CODE (NAT0954)
  2 ETA (A8) /* ERROR HANDLING PGM (*ERROR-TA
1 LOCALN (A253) /* INTERNAL TRACE EVENT DATA
1 REDEFINE LOCALN /* --------------------
  2 NLENG (I2) /* LENGTH OF INTERNAL TRACE DATA
  2 NTYPE (A1) /* INTERNAL TRACE EVENT SUBTYPE
  2 NDATA (A250) /* INTERNAL TRACE DATA
1 LOCALU (A252) /* USER TRACE CALL EVENT DATA
1 REDEFINE LOCALU /*--------------------------
  2 ULENG (I2) /* LENGTH OF USER TRACE DATA
  2 UDATA (A250) /* USER TRACE DATA
1 LOCALR (A250) /* RPC request data
1 REDEFINE LOCALR /*-----------------
  2 RLENG (I2) /* Length of RPC data
  2 RTYPE (A1) /* RPC trace subtype
  2 RENV (A1) /* RPC environment S/C
  2 RDATA (A246) /* Subtype specific data
  2 REDEFINE RDATA /* ---------------------
    3 RPGM (A8) /* RPC subprogram name
    3 RETID (A8) /* RPC ETID of request
    3 RSTAT (A2) /* RPC conversation status
    3 RLOGN (A1) /* RPC logon indicator
    3 RIMP (A1) /* RPC impersonation indicator
  2 REDEFINE RDATA /* ---------------------
    3 RTP (A1) /* RPC transport protocol
    3 RFUNC (A1) /* RPC function
    3 RUTYP (A1) /* Client user ID type
    3 RRES (A1) /* Filler
    3 RMLNG (I4) /* Message length
    3 RRC (A8) /* RPC return code
    3 RECID (A16) /* RPC external conv ID
    3 RCUID (A32) /* RPC client user ID
    3 RSNOD (A32) /* RPC server node
    3 RSNAM (A32) /* RPC server name
END-DEFINE
