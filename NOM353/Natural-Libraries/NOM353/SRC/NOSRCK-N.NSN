* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* NOSRCK-N - check of source existance of Active Reports in NGC
*
* Maintenance:
* XSETGGR 2010-08-25 NOMALL-870 created
* XSETGGR 2011-01-05 NOMALL-907 corrected
* xsetggr 2011-03-03 NOMALL-907 corrections
* SU1     2013-01-31 unused      Deactivate unused data areas
* SU2     2020-04-20 NOMALL-2349 error handling (NPR)
*   ÜÜ no parm to return error and ES-MSG-TXT only (A70)/log ?? ÜÜ
* HEB1    2020-09-28 NOMALL-2439 return error message to client/NOMLOG
* SU3     2024-03-07 ES-34613    NOM 3.6 Remove power
* ---------------------------------------------------------------------
DEFINE DATA
PARAMETER
1 P-REPNAME      (A25)           /* in
1 P-REPRNB       (P11)           /* in
1 P-SOURCE-EXIST (L)             /* out
1 P-NATRP-ERC    (N4)            /* out                 HEB1
1 P-NATRP-ERT    (A250)          /* out                 HEB1
1 P-ES-USER      (A8)            /* in                  HEB1
1 P-ES-APP-SERVER-LIBRARY (A8)   /* in                  HEB1
*
LOCAL USING RMSR---L
LOCAL USING RMSR---E
LOCAL
1 ACTIVE-REPORTS VIEW OF NRM-ACTIVE-REPORTS
  2 AR-CURRENT-LOCATION
  2 AR-SOURCE-ID
  2 AR-REVIVE
1 SOURCE VIEW OF NRM-SOURCE
  2 SR-TYPE
  2 SR-ATTRIBUTES-IDENT
1 SPOOL-FILE VIEW OF SPOOL-FILES
  2 ERROR-CODE
  2 ERROR-TEXT
1 SPOOL-QUEUE VIEW OF SPOOL-QUEUE
  2 ERROR-CODE
  2 ERROR-TEXT
  2 QUEUE
1 CATALOG VIEW OF CATALOG
  2 ERROR-CODE
  2 ERROR-TEXT
1 #AR-REPORT-RNB   (A31)
1 REDEFINE #AR-REPORT-RNB
  2 #AR-REPORT     (A25)
  2 #AR-RNB        (P11)
*
1 #USER-LIB        (A8)                                 /* HEB1
LOCAL USING RLOG-L                                      /* HEB1
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
/* HEB1 > Test the logging in the log file
* COMPRESS *PROGRAM *LINE
*          'ESY5713 Jobname and Job ID missing. One of them required.'
*          'job-name= ' 'node= 148'
*          'job-number= 504872' 'type= STC'
*     INTO P-NATRP-ERT
* PERFORM WRITE-LOG /* => ESCAPE MODULE
/* HEB1 <
*
P-SOURCE-EXIST := TRUE
*
#AR-REPORT := P-REPNAME
#AR-RNB    := P-REPRNB
*
FIND ACTIVE-REPORTS WITH AR-REPORT-RNB = #AR-REPORT-RNB
END-FIND
IF ACTIVE-REPORTS.AR-CURRENT-LOCATION = 'A' /* already archived
  RESET P-SOURCE-EXIST
  ESCAPE ROUTINE
END-IF
* no source-id / revived report located in NOM db
IF AR-SOURCE-ID = 0 OR (AR-REVIVE = '*' AND AR-CURRENT-LOCATION = 'D')
OR *MACHINE-CLASS = 'PC' /* only for local using of NGC               /*
  ESCAPE ROUTINE
END-IF
*
FIND (1) SOURCE WITH SR-ID = ACTIVE-REPORTS.AR-SOURCE-ID
  #SOURCE-ATTRIBUTES := SR-ATTRIBUTES-IDENT
END-FIND
CALLNAT 'RMSR7--N' #SOURCE-ATTRIBUTES SR-TYPE
DECIDE ON FIRST VALUE SR-TYPE
  VALUE JES2-QUEUE-ENTRY ,JES3-QUEUE-ENTRY
    JESQ. FIND (1) SPOOL-QUEUE WITH NODE = #JES-QUEUE-NODE
    AND JOB-NAME = #JES-QUEUE-JOB-NAME AND GROUP-ID =#JES-QUEUE-GROUP-ID
    AND JOB-NUMBER = #JES-QUEUE-JOB-NUMBER                            /*
      IF NO
        RESET P-SOURCE-EXIST
      END-NOREC
    END-FIND
    IF *COUNTER (JESQ.) = 0
      RESET P-SOURCE-EXIST
    END-IF
*
  VALUE JES2, JES3
    IF #JES-TYPE = 'AL'
      #JES-TYPE:= '*'
    END-IF
    FIND SPOOL-FILE WITH JOB-NAME = #JES-JOB-NAME AND NODE = #JES-NODE
    AND JOB-NUMBER = #JES-JOB-NUMBER AND TYPE = #JES-TYPE             /*
    AND DATA-SET-KEY = #JES-DATA-SET-KEY                              /*
      IF NO
        RESET P-SOURCE-EXIST
      END-NOREC
      DECIDE ON FIRST ERROR-CODE
        VALUE 0
          IGNORE
        VALUE 724, 722
          RESET P-SOURCE-EXIST
        NONE /*SU2
          /* HEB1 > del
          /* PRINT (AD=L) *PROGRAM *LINE ERROR-CODE ERROR-TEXT
          /*   'job-name=' #JES-JOB-NAME 'node=' #JES-NODE
          /*   'job-number=' #JES-JOB-NUMBER 'type=' #JES-TYPE
          /*  'data-set-key=' #JES-DATA-SET-KEY
          /* this will lead to I/O ÜÜ -> error in NGC
          /* HEB1 < del
          /* HEB1 >
          P-NATRP-ERC := 5 /* :1:
          COMPRESS *PROGRAM *LINE ERROR-CODE ERROR-TEXT
            'job-name=' #JES-JOB-NAME 'node=' #JES-NODE
            'job-number=' #JES-JOB-NUMBER 'type=' #JES-TYPE
            'data-set-key=' #JES-DATA-SET-KEY
            INTO P-NATRP-ERT
          PERFORM WRITE-LOG /* => ESCAPE MODULE
          /* HEB1 <
      END-DECIDE
    END-FIND
*
/*SU3  VALUE POWER
/*SU3  VALUE SEQUENTIAL-FILE-VSE /*SU2 error handling ??
*
  VALUE SEQUENTIAL-FILE-MVS
    FNDCAT. FIND CATALOG WITH NODE = #FMVS-NODE
    AND DSNAME = #FMVS-DSNAME AND PREFIX = 'NO'                       /*
      DECIDE ON FIRST ERROR-CODE
        VALUE 0
          IGNORE
        VALUE 562
          RESET P-SOURCE-EXIST
        NONE /*SU2
          /* HEB1 > del
          /* PRINT (AD=L) *PROGRAM *LINE ERROR-CODE ERROR-TEXT
          /*  'node=' #FMVS-NODE 'dsname=' #FMVS-DSNAME 'prefix=''no'''
          /* this will lead to I/O ÜÜ -> error in NGC
          /* HEB1 < del
          /* HEB1 >
          P-NATRP-ERC := 5 /* :1:
          COMPRESS *PROGRAM *LINE ERROR-CODE ERROR-TEXT
            'node=' #FMVS-NODE 'dsname=' #FMVS-DSNAME 'prefix=''no'''
            INTO P-NATRP-ERT
          PERFORM WRITE-LOG /* => ESCAPE MODULE
          /* HEB1 <
      END-DECIDE
    END-FIND
    IF *COUNTER (FNDCAT.) = 0
      RESET P-SOURCE-EXIST
    END-IF
  VALUE SEQUENTIAL-FILE-BS2
    FNDBS2. FIND CATALOG WITH NODE   = #FBS2-NODE
    AND DSNAME = #FBS2-DSNAME AND GEN = 'YES'                         /*
      DECIDE ON FIRST ERROR-CODE
        VALUE 0
          IGNORE
        VALUE 722, 750
          RESET P-SOURCE-EXIST
        NONE /*SU2
          /* HEB1 > del
          /* PRINT (AD=L) *PROGRAM *LINE ERROR-CODE ERROR-TEXT
          /*  'node=' #FBS2-NODE 'dsname=' #FBS2-DSNAME 'GEN=''yes'''
          /* this will lead to I/O ÜÜ -> error in NGC
          /* HEB1 < del
          /* HEB1 >
          P-NATRP-ERC := 5 /* :1:
          COMPRESS *PROGRAM *LINE ERROR-CODE ERROR-TEXT
            'node=' #FBS2-NODE 'dsname=' #FBS2-DSNAME 'GEN=''yes'''
            INTO P-NATRP-ERT
          PERFORM WRITE-LOG /* => ESCAPE MODULE
          /* HEB1 <
      END-DECIDE
    END-FIND
    IF *COUNTER (FNDBS2.) = 0
      RESET P-SOURCE-EXIST
    END-IF
*
  NONE IGNORE /*LMS/EPS/ NOM-DATA-BASE IGNORE
*
END-DECIDE
*
************************************************************************
DEFINE SUBROUTINE WRITE-LOG /* HEB1 >>
COMPRESS P-ES-APP-SERVER-LIBRARY 'U' TO #USER-LIB LEAVING NO
P-NATRP-ERC := 5 /* :1:
LG-MSG      := P-NATRP-ERT
LG-USERID   := P-ES-USER
LG-CODE     := 'MO'  /* MOnitor (LG codes documented in NOLG---N)
LG-FUNCTION := 'W'   /* log to SAT log file and write to output
CALLNAT 'NOLG---N' PL-PARMS #USER-LIB
END TRANSACTION
ESCAPE MODULE
*
END-SUBROUTINE /* WRITE-LOG
END
