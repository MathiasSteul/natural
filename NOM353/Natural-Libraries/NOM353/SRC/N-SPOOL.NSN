* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* N-SPOOL - return spool type as logical variables
*
* MAINTENANCE:
* User ID yyyy-mm-dd itrac       Comment
* ------- ---------- ----------- ---------------------------------------
* SU      2018-05-22             NOM 3.5 Created
* SU1     2019-03-05 NOMALL-2243 AIV gone: show more info
* SU2     2024-03-07 ES-34613    NOM 3.6 Remove power
************************************************************************
*
DEFINE DATA
PARAMETER USING N-SPOOLA
************************************************************************
INDEPENDENT
1 +NOD-LOCAL-SPOOL-TYPE    (A8)  /* Spool  type of the local node
LOCAL
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET #N-SPOOLA
DECIDE ON FIRST VALUE OF +NOD-LOCAL-SPOOL-TYPE
  VALUE 'JES2'  #JES2 := TRUE
  VALUE 'JES3'  #JES3 := TRUE
/*SU2  VALUE 'POWR'  #POWR := TRUE
  VALUE 'SPOOL' #BS2  := TRUE /*OR=scan'BS2' or M-SYSTEM-TYPE=SCAN 'BS2'
  VALUE 'UNIX'  #UNIX := TRUE
  NONE
    PRINT (AD=L) *PROGRAM 'invalid spool type:' +NOD-LOCAL-SPOOL-TYPE
      '(hex:' +NOD-LOCAL-SPOOL-TYPE (EM=H(8)) ')' /*SU1
      / 'Check AIV' +NOD-LOCAL-SPOOL-TYPE '(Natural Command: AIV)'
    SET CONTROL '<TECH' /*SU1
END-DECIDE
*
END
