DEFINE DATA PARAMETER
/* >Natural Source Header 000000
/* :Mode S
/* :CP
/* <Natural Source Header
* ***********************************************************************
*   PDA RMEXP-A  fields of NRM-ORDER as parm   RMEXPORT vs RMEXPnn
*
*   Maintenance
*   uuu  yyyy-mm-dd iTrac
*   SU   2021-02-17 NOMALL-2443      created
* *************************     *****************************************
1 #EXPORT
  2 #OD-ID (P10)
  2 #OD-TYPE (B2)
  2 #OD-MONITOR-ID (A8)
  2 #OD-USER-ID (A8)
  2 #OD-PARAMETER (A250/1:1)
  2 REDEFINE #OD-PARAMETER
    3 #OD-OBJECT (A2)
    3 #OD-OBJECT-PREFIX (A25)
    3 #OD-OBJECT-MASK (A25)
    3 #OD-WILDCARD (A1)
    3 #OD-MASK-CHAR (A1)
    3 #OD-LOG (A1)
    3 #OD-NODE (A16)
    3 #OD-FILE (A50)
  2 #OD-TIME-CREATED (T)
  2 #OD-TIME-SCHEDULED (T)
  2 #OD-TIME-PROCESSED (T)
  2 #OD-ERROR-CODE (N4)
  2 #OD-ERROR-TEXT (A250)
*
  2 #COUNT (1:20)
    3 #CNT-TYPE (A2)
    3 #CNT (I4)
* **End of PDA RMEXP-A **************************************************
END-DEFINE
