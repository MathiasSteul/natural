* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    RPFINI-N
* Function  Init PF-Key's
*           Read the PF-Key Definition from SYSERR only if it
*           is not in the GLOBAL Pool
* Version   1.3
*
* Maintenance
* uuu     yyyy-mm-dd s(999999) ...
* fhi     2010-09-03 NOMALL-97 Extend message line
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 G-PF
  2 G-PF-KEYS         (1:24)
    3 G-PF-IDENT      (I2)
    3 G-PF-CODE       (A8)
    3 G-PF-TEXT       (A5)
1 G-PFB
  2 G-PFB-NUM         (I2)
  2 G-PFKEY-BUFFER    (1:20)
    3 G-PFB-IDENT     (I2)
    3 G-PFB-USE       (P5)
    3 G-PFB-TEXT      (A5)
* ----------------------------------------------------------------------
LOCAL USING XXGMSG-A
LOCAL
1 #PF-NUM             (I2)   CONST <24>
1 #PFB-NUM            (I2)   CONST <20>
1 #FND-ENTRY          (I2)
1 #I                  (I2)
1 #J                  (I2)
1 #MIN-ENTRY          (I2)
1 #MIN-USE            (P5)   INIT <99999>
1 #START-VALUE        (P5)   INIT <99999>
1 #LAN                (A1)
1 EXIST-IN-POOL       (L)
1 #ERRN               (N4)
1 #ERT                (A250)
1 REDEFINE #ERT
  2 #ERT-TEXT         (A5)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
FOR #J = 1 TO #PF-NUM
  RESET INITIAL #FND-ENTRY #I #MIN-ENTRY #MIN-USE EXIST-IN-POOL #ERT
  IF G-PF-IDENT (#J) = 0
    RESET G-PF-TEXT (#J)
  ELSE
    PERFORM INIT-PF-KEY
    G-PF-TEXT (#J) := G-PFB-TEXT (#FND-ENTRY)
  END-IF
END-FOR
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE INIT-PF-KEY
************************************************************************
MOVE *LANGUAGE TO #LAN
PERFORM CHECK-IF-EXIST
IF NOT EXIST-IN-POOL
  PERFORM REPLACE-AN-ENTRY
END-IF
*
END-SUBROUTINE /* INIT-PF-KEY
*
************************************************************************
DEFINE SUBROUTINE CHECK-IF-EXIST
************************************************************************
RESET INITIAL #MIN-USE EXIST-IN-POOL
FOR #I = 1 TO G-PFB-NUM
  IF G-PFB-IDENT (#I) = G-PF-IDENT (#J)
    #FND-ENTRY := #I
    G-PFB-USE (#I) := #START-VALUE
    EXIST-IN-POOL := TRUE
  ELSE
    SUBTRACT 1 FROM G-PFB-USE (#I)
    IF G-PFB-USE (#I) < #MIN-USE
      #MIN-USE := G-PFB-USE (#I)
      #MIN-ENTRY := #I
    END-IF
  END-IF
END-FOR
*
END-SUBROUTINE /* CHECK-IF-EXIST
*
************************************************************************
DEFINE SUBROUTINE REPLACE-AN-ENTRY
************************************************************************
IF G-PFB-NUM < #PFB-NUM
  ADD 1 TO G-PFB-NUM
  #FND-ENTRY := G-PFB-NUM
ELSE
  #FND-ENTRY := #MIN-ENTRY
END-IF
G-PFB-IDENT (#FND-ENTRY) := G-PF-IDENT (#J)
G-PFB-USE   (#FND-ENTRY) := #START-VALUE
#ERRN                    := G-PF-IDENT (#J)
#XX-ERROR-CODE           := #ERRN
CALLNAT 'XXGMSG-N' #XX-GMSG-PARMS
G-PFB-TEXT  (#FND-ENTRY) := #XX-SHORT-TEXT
*
END-SUBROUTINE /* REPLACE-AN-ENTRY
*
END
