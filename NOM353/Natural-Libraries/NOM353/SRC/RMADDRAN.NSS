* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RMADDRAN - Add a range of lines to a container
*
* Maintenance:
* uuu yyyy-mm-dd s(999999) ....
* mrs   93-01-12 s(999999) clean up
* mrs   93-11-09 s(999999) seq. Files MVS added
* mrs   94-03-01 s(999999) BS2000 added
* jvd   98-05-04 p(168326) Increase display size to show lines > 10m
* jvd   98-09-10 p(164220) NOM141ÖNAT23
*                p(168326) is now in p(164220) so I have removed
*                          all refferance to P(168326) to make easier
*                          reading  (Only a re-cat for this program)
* fhi   00-03-03 S(192651) Line length > 253 not stored in DB
* fhi   00-10-04 QA05      Improve error message
* jwo   01-10-26 S(215342) Corrected suggested by UKSJU inserted
* sju   04-12-06 NOM31     Add date and time (tenths of second) to trace
* fhi   05-04-19 NOM31107  Support 7-byte job numbers
* xsetggr 2005-11-28 p(271774) support more than 40 Power segments
* fhi     2008-02-29 P302579   Limit Occurrencies of ##CUR-RECORD
* fhi     2009-07-23 P319198   Message of Compression routine too long
* fhi     2009-07-28 P319282 Binary files on Linux corrupted
* fhi     2009-09-15 P320367 Use compression routine NOMCOMPR
* SPLILDAV 2010-06-27 NOMALL-31 If spool file was generated by
*                    'NOMVPRNT', delete it
* fhi      2010-08-30 NOMALL-813 Use GET-NEXT in VSE
* fhi      2010-09-03 NOMALL-97 Extend message line
* fhi      2010-10-12 NOMALL-97 Use trace levels, use XXRLOG
* SPLILDAV 2012-06-27 NOMALL-1078 SUPPORT COMPRESSION 16K BYTE RECORDS
* raya     2012-09-27 NOMALL-1143 work with lob fields
* SU1     2014-01-27 NOMALL-1341 remove LA-fields
* SU2     2016-09-01 NOMALL-1912 show compression err. not in hex
* fhi     2017-01-18 NOMALL-1916 Use binary NPR RECORD* fields
* fhi     2017-01-27 NOMALL-1961 Show node name in errors
* fhi     2017-03-31 NOMALL-2009 Improve RDC handling
* fhi     2017-07-07 NOMALL-2021 Add trace.
* fhi     2017-07-11 NOMALL-2021 NPR error: use RECORD temporarily ÜÜÜ
* SU3     2018-02-13 NOMALL-1823 NOM 3.5: remove CONNECT
* fhi     2018-03-23 NOMALL-1918 Use correct source ID and node
* SU4     2018-08-30 NOMALL-2130 sep.var.:GDA MONIT-GL -> PDA RMEXSEPA
* SU5     2021-10-12 ES-31134    Unix:BS2:use ESA transl/no hex
* SU6     2024-03-07 ES-34613    NOM 3.6 Remove power
* ----------------------------------------------------------------------
*
DEFINE DATA GLOBAL USING MONIT-GL
PARAMETER USING RMEXSEPA
************************************************************************
INDEPENDENT
1 +NOD-CURRENT-NAME   (A16)
1 +NOD-CURRENT-ID     (A20)
1 +NOD-CURRENT-USER   (A8)
1 +NOD-LOCAL-ID       (A20)
1 +CMRDC              (A1)
* *****
LOCAL USING RMSR---E
LOCAL USING RMSR---L
LOCAL USING RLOG-L
LOCAL
1 SPOOL-FILES VIEW OF SPOOL-FILES
  2 ERROR-TEXT
1 SPOOL-QUEUE VIEW OF SPOOL-QUEUE
  2 FORM
/*SU6 1 SPOOL-UPDATE VIEW OF SPOOL-UPDATE 2 ERROR-TEXT
1 READ-SPOOL VIEW OF READ-SPOOL
  2 ERROR-CODE
  2 ERROR-TEXT
  2 RECORD-NUMBER
  2 RECORD-LENGTH
  2 RECORD /*DO NOT DELETE - must for HEX fields ÜÜ
  2 RECORD-HEX1
  2 RECORD-HEX2
  2 RECORD-HEX3
1 READ-FILE VIEW OF READ-FILE
  2 ERROR-CODE
  2 ERROR-TEXT
  2 RECORD-NUMBER
  2 RECORD-LENGTH
  2 RECORD /*DO NOT DELETE - must for HEX fields ÜÜ
  2 RECORD-HEX1
  2 RECORD-HEX2
  2 RECORD-HEX3
  2 SEGMENT-LENGTH
  2 SEGMENT-NUMBER
1 READ-FILE-ESA VIEW OF READ-FILE /*SU5
  2 ERROR-CODE
  2 ERROR-TEXT
  2 RECORD-NUMBER
  2 RECORD-LENGTH
  2 RECORD /*DO NOT DELETE - must for HEX fields ÜÜ
  2 SEGMENT-LENGTH
  2 SEGMENT-NUMBER
/*SU6 -> 1 SOURCE VIEW OF NRM-SOURCE 2 SR-SPOOL-ATTR-EXTENDED (1:2)
/*  2 REDEFINE SR-SPOOL-ATTR-EXTENDED 3 #EXTRA-SEGMENTS  (N3)
/*SU6 <- 3 #EXTRA-LAST-LINES            (B4/41:127)
1 SOURCE-TEXT VIEW OF NRM-SOURCE-TEXT
  2 ST-ID
  2 ST-LINE-START
  2 ST-TEXT                        (1:66)
  2 REDEFINE ST-TEXT
    3 ST-TEXT-LOB                  (A16381)
* *****
1 #FORM                            (A8)
1 #RECORD                          (A253)
1 #RECORD-NUMBER                   (P10)
1 #RECORD-LENGTH                   (N5)
1 LINE-FOUND                       (L)
1 #ST-ID-LINE                      (B10)
1 REDEFINE #ST-ID-LINE
  2 #ST-ID                         (P10)
  2 #ST-LINE                       (B4)
1 #START-LINE                      (P10)
1 #NSMCOMP-CB                      (B40)
1 REDEFINE #NSMCOMP-CB
  2 #NSMCOMP-COMMAND               (A1)
  2 #NSMCOMP-CODE                  (B1)
  2 #NSMCOMP-INLENGTH-OLD          (B1)
  2 #NSMCOMP-OUTLENGTH-OLD         (B1)
  2 #NSMCOMP-INLENGTH              (B2)
  2 #NSMCOMP-OUTLENGTH             (B2)
1 #NSMCOMP-RC                      (B2)
1 #NSMCOMP-WORK                    (B4)
1 #NSMCOMP-LINE                    (A251)
1 #NSMCOMP-BUFFER-LENGTH           (B4)
1 #FILE                            (A60)
1 #SEGMENT-LENGTH                  (N3)
1 #G-SOURCE-TYPE                   (P3)
1 #G-SOURCE-TYPE-B2                (B2)
1 #TEMP-LENGTH                     (N5)
1 #CUR-RECORD-MAX                  (P2)
1 #TRACING                         (L)
1 #TYPE                            (A80)
1 #ESC                             (L)
1 #USE-ESA                         (L)   /*SU5
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
FORMAT LS=100
*
************************************************************************
DEFINE SUBROUTINE ADD-RANGE
************************************************************************
INCLUDE RMCURREC
IF G-TRACE GE *LEVEL
  #TRACING := TRUE
  COMPRESS 'Start -> From' P-FROMLINE 'to' P-TOLINE TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
INCLUDE CMRDC
*
IF P-FROMLINE = 0
  ESCAPE ROUTINE
END-IF
#SOURCE-ATTRIBUTES := RMEX-SOURCE-ATTRIBUTES
IF +NOD-LOCAL-ID NE +NOD-CURRENT-ID /* it'a a remote node
  #G-SOURCE-TYPE := NOM-DATA-BASE   /* Always use Copy-to-DB=YES remote
ELSE
  #G-SOURCE-TYPE := RMEX-SOURCE-TYPE
END-IF
#G-SOURCE-TYPE-B2 := #G-SOURCE-TYPE
CALLNAT 'RMSR7--N' #SOURCE-ATTRIBUTES #G-SOURCE-TYPE-B2  /*Jobnr:N5->N7
*
IF #TRACING
  G-TRACE-MSG := 'Processing source type'
  DECIDE ON FIRST VALUE OF #G-SOURCE-TYPE
    VALUE JES2, JES3
      COMPRESS G-TRACE-MSG 'JES spool' TO G-TRACE-MSG
/*SU6 VALUE POWER COMPRESS G-TRACE-MSG 'POWER spool' TO G-TRACE-MSG
/*SU6 VALUE SEQUENTIAL-FILE-VSE COMPRESS G-TRACE-MSG 'VSE file' TO G-TRACE-MSG
    VALUE SEQUENTIAL-FILE-MVS
      COMPRESS G-TRACE-MSG 'Z/OS file' TO G-TRACE-MSG
    VALUE SEQUENTIAL-FILE-BS2
      COMPRESS G-TRACE-MSG 'BS2000 file' TO G-TRACE-MSG
    VALUE NOM-DATA-BASE
      COMPRESS G-TRACE-MSG 'NOM Database' TO G-TRACE-MSG
    NONE
      COMPRESS G-TRACE-MSG 'unknown' TO G-TRACE-MSG
  END-DECIDE
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
DECIDE ON FIRST VALUE OF #G-SOURCE-TYPE
  VALUE JES2, JES3            PERFORM ADD-RANGE-JES
/*SU6 VALUE POWER                 PERFORM ADD-RANGE-POWER
/*SU6 VALUE SEQUENTIAL-FILE-VSE   PERFORM ADD-RANGE-FVSE
  VALUE SEQUENTIAL-FILE-MVS   PERFORM ADD-RANGE-FMVS
  VALUE SEQUENTIAL-FILE-BS2   PERFORM ADD-RANGE-FBS2
  VALUE NOM-DATA-BASE         PERFORM ADD-RANGE-NOMDB
  NONE
    G-NATRP-ERC := 9999
    COMPRESS *PROGRAM 'Invalid Source Type'
      #G-SOURCE-TYPE TO G-NATRP-ERT
END-DECIDE
*
IF ##IN-NRM AND ##CUR-RECORD > 0 AND G-NATRP-ERC = 0
  PERFORM PROCESS-BUFFER
  RESET ##CUR-RECORD #TEXT-ARRAY(1:20) ##RECLEN-VEC(*)
END-IF
*
*** SPLILDAV - Start insert (NOMALL-31)
*** If this sysout file was generated by 'NOMVPRNT', we can delete it
*** because it was just written to the container file.
*** We determine that it's such a file as follows :
***     1. The DDname is 'SYS' followed by 5 digits which means that
***        it was dynamically allocated.
***     2. The form for this file is 'NOMV'
IF #G-SOURCE-TYPE = JES2 OR = JES3 AND #JES-DDNAME = MASK('SYS'NNNNN)
  RESET #FORM
  FIND (1) SPOOL-FILES WITH JOB-NUMBER = #JES-JOB-NUMBER
  AND DDNAME = #JES-DDNAME AND NODE = #JES-NODE                       /*
    #FORM := FORM
  END-FIND
  IF #FORM = 'NOMV'
    FIND (1) SPOOL-FILES WITH JOB-NUMBER = #JES-JOB-NUMBER
    AND DDNAME =#JES-DDNAME AND NODE = #JES-NODE AND FUNCTION = 'DELETE'
      WRITE 'DELETE "NOMV" SPOOL FILE:' SPOOL-FILES.ERROR-TEXT
    END-FIND
  END-IF
END-IF
*
/*SU6 -> IF #G-SOURCE-TYPE = POWER
***  b. For VSE :  The form for this job is 'NOMV'
/*  FIND (1) SPOOL-QUEUE WITH JOB-NUMBER = #JES-JOB-NUMBER
/*  AND FORM = 'NOMV' AND NODE = #JES-NODE                            /*
/*    FIND (1) SPOOL-UPDATE WITH JOB-NUMBER = #JES-JOB-NUMBER
/*  AND JOB-NAME = #JES-JOB-NAME AND FUNCTION = 'CANCEL'              /*
/*  AND QUEUE    = 'LST' AND NODE = #JES-NODE                         /*
/*      WRITE 'DELETE "NOMV" SPOOL FILE:' SPOOL-FILES.ERROR-TEXT
/*    END-FIND
/*  END-FIND
/*SU6 <- END-IF *** SPLILDAV - End insert (NOMALL-31)
IF #TRACING
  COMPRESS 'End ->' G-NATRP-ERC  G-NATRP-ERT TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END TRANSACTION
END-IF
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE ADD-RANGE-JES
************************************************************************
#TYPE := 'JES'
IF #TRACING
  COMPRESS 'Reading JES node' #JES-NODE '- job name' #JES-JOB-NAME
    '- job no' #JES-JOB-NUMBER '- type' #JES-TYPE TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
CALLNAT 'RMNPRUSR' #JES-NODE +NOD-CURRENT-USER
  G-NATRP-ERC G-NATRP-ERT #TRACING
FNDJES. FIND READ-SPOOL WITH NODE = #JES-NODE
AND JOB-NAME = #JES-JOB-NAME AND JOB-NUMBER     = #JES-JOB-NUMBER     /*
AND TYPE = #JES-TYPE AND DATA-SET-KEY   = #JES-DATA-SET-KEY           /*
AND RECORD-NUMBER >= P-FROMLINE                                       /*
  #RECORD-NUMBER := RECORD-NUMBER
  COMPRESS #JES-JOB-NAME '/' #JES-JOB-NUMBER '/'
    #JES-TYPE '/' #JES-DATA-SET-KEY TO #FILE LEAVING NO
  PERFORM HANDLE-IT_READ-SPOOL
  IF #ESC
    ESCAPE ROUTINE
  END-IF
END-FIND
*
END-SUBROUTINE /* ADD-RANGE-JES
*
************************************************************************
DEFINE SUBROUTINE ADD-RANGE-FMVS
************************************************************************
COMPRESS 'seq. File MVS' #FMVS-DSNAME 'on node' #FMVS-NODE TO #TYPE
IF #TRACING
  COMPRESS 'Reading' #TYPE TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
CALLNAT 'RMNPRUSR' #FMVS-NODE +NOD-CURRENT-USER
  G-NATRP-ERC G-NATRP-ERT #TRACING
FNDFMVS. FIND READ-FILE WITH NODE = #FMVS-NODE AND DSNAME = #FMVS-DSNAME
AND RECFM = #FMVS-RECFM AND LRECL = #FMVS-LRECL AND SEGMENT-LENGTH = 251
AND BLKSIZE = #FMVS-BLKSIZE AND RECORD-NUMBER >= P-FROMLINE           /*
  IF #TRACING
    COMPRESS 'Range FMVS -> DSNAME' #FMVS-DSNAME '- Node:' #FMVS-NODE
      '- Msg:' READ-FILE.ERROR-CODE READ-FILE.ERROR-TEXT
      '- hex1:' READ-FILE.RECORD-HEX1 '- hex2:' READ-FILE.RECORD-HEX2
      '- hex3:' READ-FILE.RECORD-HEX3 TO G-TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
    END TRANSACTION
  END-IF
  #FILE := #FMVS-DSNAME
  PERFORM HANDLE-IT_READ-FILE
END-FIND
*
END-SUBROUTINE /* ADD-RANGE-FMVS
*
************************************************************************
DEFINE SUBROUTINE ADD-RANGE-FBS2
************************************************************************
COMPRESS 'seq. File BS2' #FBS2-DSNAME 'on node' #FBS2-NODE TO #TYPE
IF #TRACING
  COMPRESS 'Reading' #TYPE TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
CALLNAT 'RMNPRUSR' #FBS2-NODE +NOD-CURRENT-USER
  G-NATRP-ERC G-NATRP-ERT #TRACING
*
IF *MACHINE-CLASS NE 'MAINFRAME' /*SU5
  IF F#ESA (<#FBS2-NODE>) /*must be separate IF ÜÜ
   CALLNAT 'NOMESA' #FBS2-NODE(AD=O) +NOD-CURRENT-NAME(AD=O) 1X #USE-ESA
  END-IF
END-IF
*
IF #USE-ESA /*SU5
  #ESA. FIND READ-FILE-ESA WITH NODE =#FBS2-NODE AND DSNAME=#FBS2-DSNAME
  AND RECORD-NUMBER >= P-FROMLINE AND SEGMENT-LENGTH = 251            /*
    #FILE           := #FBS2-DSNAME
    MOVE BY NAME READ-FILE-ESA TO READ-FILE
    PERFORM HANDLE-IT_READ-FILE
  END-FIND
ELSE /*NPR
  FNDFBS2. FIND READ-FILE WITH NODE = #FBS2-NODE AND DSNAME=#FBS2-DSNAME
  AND RECORD-NUMBER >= P-FROMLINE AND SEGMENT-LENGTH = 251            /*
    #FILE           := #FBS2-DSNAME
    PERFORM HANDLE-IT_READ-FILE
  END-FIND
END-IF
*
END-SUBROUTINE /* ADD-RANGE-FBS2
*
************************************************************************
DEFINE SUBROUTINE HANDLE-IT_READ-SPOOL
************************************************************************
RESET #ESC
IF READ-SPOOL.ERROR-CODE NE 0
  WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
    '-> error reading' #TYPE
  WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
    READ-SPOOL.ERROR-TEXT
  ##PROCESS-ERROR := TRUE
  G-NATRP-ERC := 0005
  COMPRESS READ-SPOOL.ERROR-TEXT '/' +NOD-CURRENT-NAME '/' *PROGRAM
    '/' *LINE TO G-NATRP-ERT
  #ESC := TRUE
  ESCAPE ROUTINE
END-IF
IF #RECORD-NUMBER > P-TOLINE
  #ESC := TRUE
  ESCAPE ROUTINE
END-IF
#RECORD := F#CONVERT-RECORD-HEX
  (<READ-SPOOL.RECORD-HEX1, READ-SPOOL.RECORD-HEX2,
  READ-SPOOL.RECORD-HEX3,#TRACING,RMEX-SOURCE-CODEPAGE>)
#RECORD-LENGTH := READ-SPOOL.RECORD-LENGTH
#SEGMENT-LENGTH := 0 /* no NPR segmentation
PERFORM ADD-RANGE-COMMON
*
END-SUBROUTINE /* HANDLE-IT_READ-SPOOL
*
************************************************************************
DEFINE SUBROUTINE HANDLE-IT_READ-FILE
************************************************************************
IF READ-FILE.ERROR-CODE NE 0
  PRINT NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
    '-> error reading' #TYPE
  WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
    READ-FILE.ERROR-TEXT
  IF #G-SOURCE-TYPE = SEQUENTIAL-FILE-BS2
    WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
      'Active User on node' #FBS2-NODE 'is' F#WHOAMI(<#FBS2-NODE>)
  END-IF
  ##PROCESS-ERROR := TRUE
  G-NATRP-ERC := 0005
  COMPRESS READ-FILE.ERROR-TEXT '/' +NOD-CURRENT-NAME '/' *PROGRAM
    '/' *LINE TO G-NATRP-ERT
  ESCAPE BOTTOM /*(FNDFVSE.)/(FNDFMVS.)/(#ESA.)/(FNDFBS2.) SU5
/*SU5 ESCAPE ROUTINE
END-IF
IF READ-FILE.RECORD-NUMBER > P-TOLINE
  ESCAPE BOTTOM /*(FNDFVSE.)/(FNDFMVS.)/(#ESA.)/(FNDFBS2.)
END-IF
IF #USE-ESA /*SU5
  #RECORD := READ-FILE.RECORD
ELSE
  #RECORD := F#CONVERT-RECORD-HEX (<READ-FILE.RECORD-HEX1,
    READ-FILE.RECORD-HEX2,READ-FILE.RECORD-HEX3,
    #TRACING,RMEX-SOURCE-CODEPAGE>)
END-IF
#RECORD-LENGTH  := READ-FILE.RECORD-LENGTH
#SEGMENT-LENGTH := READ-FILE.SEGMENT-LENGTH
PERFORM ADD-RANGE-COMMON
*
END-SUBROUTINE /* HANDLE-IT_READ-FILE
*
************************************************************************
DEFINE SUBROUTINE ADD-RANGE-NOMDB
************************************************************************
#NSMCOMP-BUFFER-LENGTH := 16381 - 7
#NSMCOMP-CODE    := 'N'  /* 'N' - NEW PARM LIST
#NSMCOMP-COMMAND := 'D'
*
#ST-ID           := #NOMDB-ID
#ST-LINE         := P-FROMLINE
#START-LINE      := P-FROMLINE
RESET   LINE-FOUND
*
IF #TRACING
  COMPRESS 'Reading source' #ST-ID-LINE TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
READNOMDB. READ SOURCE-TEXT BY ST-ID-LINE = #ST-ID-LINE
  IF ST-ID NE #ST-ID
    IF NOT LINE-FOUND
      G-NATRP-ERC := 0005
      G-NATRP-ERT := 'Start Line not found'
    END-IF
    ESCAPE BOTTOM (READNOMDB.)
  END-IF
  RESET   #NSMCOMP-WORK
  #RECORD-NUMBER := ST-LINE-START
  SUBTRACT 1 FROM #RECORD-NUMBER
  REP. REPEAT
    RESET #NSMCOMP-LINE
    INCLUDE C-NSMCMP 'SOURCE-TEXT.ST-TEXT-LOB'
    DECIDE ON FIRST #NSMCOMP-RC
      VALUE 0
        IGNORE
      VALUE 4
        IF NOT LINE-FOUND
          G-NATRP-ERC := 0005
          G-NATRP-ERT := 'Start Line not found'
          ESCAPE BOTTOM (READNOMDB.)
        END-IF
        ESCAPE BOTTOM (REP.)
      NONE
        G-NATRP-ERC := 0005
        MOVE EDITED #NSMCOMP-RC (EM=H(4)) TO G-NATRP-ERT /*SU2
        COMPRESS 'Compression Routine rc=' G-NATRP-ERT /*SU2
          TO G-NATRP-ERT
        ESCAPE BOTTOM (READNOMDB.)
    END-DECIDE
    ADD 1 TO #RECORD-NUMBER
    IF NOT LINE-FOUND
      IF #RECORD-NUMBER < #START-LINE
        ESCAPE TOP
      END-IF
      LINE-FOUND := TRUE
    END-IF
    IF #RECORD-NUMBER > P-TOLINE
      ESCAPE BOTTOM
    END-IF
    #RECORD        := #NSMCOMP-LINE
    #RECORD-LENGTH := #NSMCOMP-OUTLENGTH
    IF #RECORD-LENGTH = 0       /* still using old nsmcmp ?
      #RECORD-LENGTH := #NSMCOMP-OUTLENGTH-OLD
    END-IF
    #FILE           := 'NOM-DB'
    #SEGMENT-LENGTH := 0
    PERFORM ADD-RANGE-COMMON
  END-REPEAT
END-READ
*
END-SUBROUTINE /* ADD-RANGE-NOMDB
*
************************************************************************
DEFINE SUBROUTINE ADD-RANGE-COMMON
************************************************************************
##REPORT-IS-OPENED := TRUE
ADD 1 TO ##REC-COUNT
IF ##IN-NRM
  ADD 1 TO ##CUR-RECORD
  IF NOT(##CUR-RECORD = 1 THRU #CUR-RECORD-MAX)
    ##CUR-RECORD := 1
  END-IF
  #TEXT-ARRAY (##CUR-RECORD) := #RECORD
  ##RECLEN-VEC (##CUR-RECORD) := #RECORD-LENGTH
  DECIDE FOR EVERY CONDITION
    WHEN #RECORD-LENGTH > 251 AND #SEGMENT-LENGTH = 0
      ##RECLEN-VEC (##CUR-RECORD) := 251
      LG-USERID := G-MONITOR-ID
      LG-CODE := 'MO'
      COMPRESS '7205' ##REC-COUNT #FILE TO LG-MSG
      CALLNAT 'RLOG' PL-PARMS
      END TRANSACTION
    WHEN #SEGMENT-LENGTH NE 0
      ##RECLEN-VEC (##CUR-RECORD) := #SEGMENT-LENGTH
      IF READ-FILE.SEGMENT-NUMBER > 1 AND #SEGMENT-LENGTH < 251
        COMPRESS '§' #TEXT-ARRAY  (##CUR-RECORD)
          TO #TEXT-ARRAY  (##CUR-RECORD) LEAVING NO /* cc character
        EXAMINE SUBSTRING (#TEXT-ARRAY  (##CUR-RECORD),1,1) FOR '§'
          REPLACE WITH ' '
        #TEMP-LENGTH := ##RECLEN-VEC(##CUR-RECORD)
        ADD 1 TO #TEMP-LENGTH
        ##RECLEN-VEC(##CUR-RECORD) := #TEMP-LENGTH
      END-IF
    WHEN NONE
      IGNORE
  END-DECIDE
  IF ##CUR-RECORD = #CUR-RECORD-MAX
    PERFORM PROCESS-BUFFER
    RESET ##CUR-RECORD #TEXT-ARRAY(1:20) ##RECLEN-VEC(*)
  END-IF
END-IF
RESET #SEGMENT-LENGTH /* for next call
*
END-SUBROUTINE /* ADD-RANGE-COMMON
*
END-SUBROUTINE /* ADD-RANGE
*
END
