************************************************************************
DEFINE SUBROUTINE CHECK-BUNDLE
************************************************************************
#BC-REPNAME := #ACTREP-REPORT
#BC-REPRNB  := #ACTREP-REPRNB
RESET #ALREADY-BUNDLED #REVIVE-TO-BUNDLE #BC-ISN
FIND BUNDLE-CONTENTS WITH BC-REPORT-RNB = #BC-REPORT-RNB
  IF BC-BUNDRNB = 0
    G-REPORT      := #ACTREP-REPORT
    G-REPRNB      := #ACTREP-REPRNB
    G-FATHER-PROG := *PROGRAM
    PERFORM SEND-TO-BUNDLE 1X /*RMCRTBUN /no RMEX-SPOOL-ATTR..
  END-IF
END-FIND
*
END-SUBROUTINE /* CHECK-BUNDLE
*
************************************************************************
DEFINE SUBROUTINE USER-EXIT-8
************************************************************************
RESET NOMEX008-PARMS (1) NOMEX008-ERROR-CODE NOMEX008-FROMLINE
  NOMEX008-TOLINE NOMEX008-RECORD-LENGTH NOMEX008-NODE
*
NOMEX008-FUNCTION := NOMEX008-FCT-REVIVE
NOMEX008-REPNAME  := AR-REPNAME (UPDREV.)
NOMEX008-REPRNB   := AR-REPRNB  (UPDREV.)
*
IF G-TRACE > 1
  RMSETTIM.FUNCTION := 'S'
  PERFORM RMSETTIM-SETTIME RMSETTIM
END-IF
IF G-TRACE > 1
  RMSETTIM.FUNCTION := 'G'
  PERFORM RMSETTIM-SETTIME RMSETTIM
  G-TRACE-MSG := 'CPU consumed so far:'
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  RMSETTIM.FUNCTION := 'S'
  PERFORM RMSETTIM-SETTIME RMSETTIM
END-IF
CALLNAT 'NOMEX008' NOMEX008-PARMS(*)
IF G-TRACE > 1
  RMSETTIM.FUNCTION := 'G'
  PERFORM RMSETTIM-SETTIME RMSETTIM
  COMPRESS 'NOMEX008 from' RMSETTIM.MSG TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  RMSETTIM.FUNCTION := 'S'  /* begin new measure after exit
  PERFORM RMSETTIM-SETTIME RMSETTIM
END-IF
*
END-SUBROUTINE /* USER-EXIT-8
** End of Copycode RJREVUXC ********************************************
