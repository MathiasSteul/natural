DEFINE SUBROUTINE HANDLE-ID-RECORD
************************************************************************
PERFORM FLUSH-LAST-BUFFER
IF END-OF-PROCESSING
  ESCAPE ROUTINE
END-IF
*
RESET ERROR-OCCURED
*
#ID-RECORD := #TEXT-RECORD
DECIDE FOR FIRST CONDITION
/* repname a25,reprnb p7,jobnumber n5,node n3
  WHEN #RECORD-LENGTH = 133 THRU 140      /* NOM311 format archive
    #ACTREP-REPORT := #REPNAME1 /* jobname (n5)
    #ACTREP-REPRNB := #REPRNB1
/* repname a25,reprnb p7,jobnumber n7,node n3
  WHEN #RECORD-LENGTH = 141 THRU 142 /* jobname (n7)
    #ACTREP-REPORT := #REPNAME2
    #ACTREP-REPRNB := #REPRNB2
/* repname a25,reprnb p11,jobnumber n7,node n5
  WHEN #RECORD-LENGTH > 142
    #ACTREP-REPORT := #REPNAME /* rnb(p11), node (n5)
    #ACTREP-REPRNB := #REPRNB
/* repname a17,reprnb p7,jobnumber n5,node n3
  WHEN #RECORD-LENGTH LE 132           /* repname (a17) - nom211 format
    #ACTREP-REPORT := #REPNAME3
    #ACTREP-REPRNB := #REPRNB3
  WHEN NONE IGNORE /*SU5 ERROR Ü?
END-DECIDE
IF G-TRACE > 0
  COMPRESS 'Found report' #ACTREP-REPORT '/' #ACTREP-REPRNB
    TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END TRANSACTION
END-IF
*
#MA-REPNAME := #ACTREP-REPORT
#MA-REPRNB  := #ACTREP-REPRNB
*
FIND-ACT. FIND ACTIVE-REPORTS WITH AR-REPORT-RNB = #ACTREP-KEY
WHERE AR-REVIVE ='D' OR='S'                                           /*
  IF NO RECORDS FOUND
    REVIVE-IT := FALSE
    ESCAPE BOTTOM
  END-NOREC
*
  REVIVE-IT := TRUE
  RESET #REC-NO
  #REPISN := *ISN (FIND-ACT.)
  #K-REPNAME := #ACTREP-REPORT
  #K-REPRNB := #ACTREP-REPRNB
END-FIND
*
IF G-TRACE > 0
  IF REVIVE-IT
    G-TRACE-MSG := 'REVIVE-IT is true'
  ELSE
    G-TRACE-MSG := 'REVIVE-IT is false'
  END-IF
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END TRANSACTION
END-IF
IF NOT REVIVE-IT
  ESCAPE ROUTINE
END-IF
*
RESET G-NATRP-ERC FROM-SWITCHES
*
* BLI1 validate Calendar start
IF NOT ERROR-OCCURED
  IF AR-REVIVE-RETENTION-PERIOD = ' '
    FIND REPORT WITH R-REPNAME = AR-REPNAME
      AR-REVIVE-RETENTION-PERIOD := REPORT.R-REVIVE-RETENTION
    END-FIND
    IF AR-RETENTION-NUM > 0 AND AR-RETENTION-UNIT = 'W'
      IF AR-RETENTION-CALENDAR = ' '
        ERROR-OCCURED := TRUE
        COMPRESS AR-REPNAME  '/' AR-REPRNB
          TO LG-MSG LEAVING NO
        COMPRESS '2010' LG-MSG TO LG-MSG
        PERFORM #RLOG
        END TRANSACTION
        WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
          'Enter calendar for' AR-REPNAME '/' AR-REPRNB
      ELSE
        CALLNAT 'RCHKCA' AR-RETENTION-CALENDAR EXIST
        IF NOT EXIST
          ERROR-OCCURED := TRUE
          COMPRESS AR-REPNAME  '/' AR-REPRNB
            TO LG-MSG LEAVING NO
          COMPRESS '2004' LG-MSG TO LG-MSG
          PERFORM #RLOG
          END TRANSACTION
        WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
            'Calendar' AR-RETENTION-CALENDAR 'does not exist.'
        END-IF
      END-IF
    END-IF
  END-IF
END-IF
*
IF NOT ERROR-OCCURED  /* BLI1 end
  DECIDE ON EVERY VALUE OF ACTIVE-REPORTS.AR-REVIVE
    VALUE 'S'
      ACTIVE-REPORTS.AR-REVIVE := 'D'
    VALUE 'D','R'
      FROM-NRM := TRUE
      RESET #WRITER
      CALLNAT 'RMDELRTN' ACTIVE-REPORTS.AR-REPNAME
        ACTIVE-REPORTS.AR-REPRNB
    NONE VALUE
      ERROR-OCCURED := TRUE
  END-DECIDE
END-IF /* BLI1
*
END-SUBROUTINE /* HANDLE-ID-RECORD
*
************************************************************************
DEFINE SUBROUTINE FLUSH-LAST-BUFFER
************************************************************************
#REVIVE-DATE := *TIMX
IF REVIVE-IT
  RESET REVIVE-IT
  IF SW-STORE
    PERFORM FLUSH-BUFFER
    RESET SW-STORE
  END-IF
  PERFORM UPDATE-ACTIVE-REPORT
  PERFORM IS-ANYTHING-TO-REVIVE
END-IF
*
END-SUBROUTINE /* FLUSH-LAST-BUFFER
*
************************************************************************
DEFINE SUBROUTINE FLUSH-BUFFER
************************************************************************
IF #T = 0
  ESCAPE ROUTINE
END-IF
DECIDE FOR FIRST CONDITION
  WHEN FROM-NRM      PERFORM FLUSH-TO-DB
  WHEN NONE          ERROR-OCCURED := TRUE
END-DECIDE
RESET #T REPORT-TEXT.F-TEXT (*)
*
END-SUBROUTINE /* FLUSH-BUFFER
*
************************************************************************
DEFINE SUBROUTINE HANDLE-TEXT-RECORD
************************************************************************
ADD 1 TO #T
ADD 1 TO #REC-NO
*
SW-STORE := TRUE
*
SUBTRACT 1 FROM #RECORD-LENGTH
COMPCB-ILEN := #RECORD-LENGTH
* NOMALL-1078 INSERT 1 LINE
COMPCB-ILEN-OLD := #RECORD-LENGTH              /* For compat
IF #RECORD-LENGTH > 251
  COMPCB-ILEN := 251
* NOMALL-1078 INSERT 1 LINE
  COMPCB-ILEN-OLD := 251 /* For compat
  COMPRESS '7205' #REC-NO 'WORK-FILE 1' TO LG-MSG /*line:1:truncated
  PERFORM #RLOG
  END TRANSACTION
END-IF
*
IF NOT FROM-NRM
  CALLNAT 'R-NRMCMP' COMPCB #T-TEXT REPORT-TEXT.F-TEXT (#T)
    G-NATRP-ERC G-NATRP-ERT
* NOMALL-1078 INSERT 1
  RESET COMPCB-OLEN       /* Zero output length
  IF G-NATRP-ERC NE 0
    ESCAPE ROUTINE
  END-IF
ELSE
  IF #T-TEXT = ' '
    REPORT-TEXT.F-TEXT (#T) := H'0103'
  ELSE
    REPORT-TEXT.F-TEXT(#T) := #T-TEXT
  END-IF
END-IF
IF #T = 20
  PERFORM FLUSH-BUFFER
END-IF
*
END-SUBROUTINE /* HANDLE-TEXT-RECORD
*
************************************************************************
DEFINE SUBROUTINE FLUSH-TO-DB
************************************************************************
ANY-REVIVE := TRUE
*
REPORT-TEXT.F-SEQ     := #REC-NO
REPORT-TEXT.F-REPNAME := #K-REPNAME
REPORT-TEXT.F-REPRNB  := #K-REPRNB
REPORT-TEXT.F-OBJECT-TYPE := 'FS' /*SU2
REPORT-TEXT.F-OBJECT-TIME := *TIMX /*SU2
STORE REPORT-TEXT
END TRANSACTION
*
RESET REPORT-TEXT.F-TEXT(*)
*
END-SUBROUTINE /* FLUSH-TO-DB
*
************************************************************************
DEFINE SUBROUTINE UPDATE-ACTIVE-REPORT
************************************************************************
IF ERROR-OCCURED
  GETERR. GET ACTIVE-REPORTS #REPISN
  RESET AR-REVIVE
  UPDATE (GETERR.)
*
  COMPRESS AR-REPNAME (GETERR.) '/' AR-REPRNB (GETERR.)
    TO LG-MSG LEAVING NO
  COMPRESS '0470' LG-MSG TO LG-MSG
  PERFORM #RLOG
  END TRANSACTION
  WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
    'Error during revive of' AR-REPNAME '/' AR-REPRNB
  ESCAPE ROUTINE
END-IF
*
UPDREV. GET ACTIVE-REPORTS  #REPISN
*
AR-REVIVE := '*'
AR-REVIVE-DATE := #REVIVE-DATE
*
DECIDE FOR FIRST CONDITION
  WHEN FROM-NRM
    AR-CURRENT-LOCATION := 'D'
  WHEN NONE IGNORE /*SU6 ERROR Ü?
END-DECIDE
*
* BLI1 Calendar validated before in HANDLE-ID-RECORD
IF AR-REVIVE-RETENTION-PERIOD = ' '
  FIND REPORT WITH R-REPNAME = AR-REPNAME
    AR-REVIVE-RETENTION-PERIOD := REPORT.R-REVIVE-RETENTION
  END-FIND
END-IF
PERFORM COMPUTE-REVIVE-EXPIRATION
*
IF AR-NUMBER-OF-LINES (UPDREV.) = 9999999
  AR-NUMBER-OF-LINES := #REC-NO
END-IF
*
UPDATE (UPDREV.)
*
#AC-RRS := #ACTREP-KEY
RESET #AC-SEQNO
*
REARC. READ REPORT-CONTENTS BY AC-REP-RNB-SEQ = #AC-RRS
  IF AC-REPNAME NE #ACTREP-REPORT OR AC-REPRNB NE #ACTREP-REPRNB
    ESCAPE BOTTOM
  END-IF
  DELETE (REARC.)
  IF *COUNTER >= 50
    END OF TRANSACTION
    RESET *COUNTER
  END-IF
END-READ
*
RESET REPORT-CONTENTS
*
REPORT-CONTENTS.AC-REPNAME         := #ACTREP-REPORT
REPORT-CONTENTS.AC-REPRNB          := #ACTREP-REPRNB
REPORT-CONTENTS.AC-SEQNO           := #REC-NO
REPORT-CONTENTS.AC-FROM-LINE-N9(1) := 1
REPORT-CONTENTS.AC-TO-LINE-N9(1)   := #REC-NO
/* copy content of GDA view to local view                               e
MOVE BY NAME REPORT-CONTENTS TO REPORT-CONTENTS-LOC /*SU3 <-            e
REPORT-CONTENTS-LOC.AC-OBJECT-TYPE := 'AC'
REPORT-CONTENTS-LOC.AC-OBJECT-TIME := *TIMX
ST. STORE REPORT-CONTENTS-LOC
/* copy content of local view to GDA (just to be sure)                  e
MOVE BY NAME REPORT-CONTENTS-LOC TO REPORT-CONTENTS /*SU3 <-            e
*
PERFORM CHECK-BUNDLE
/*SU5 IF NOMVI-N-VERSION = 3 AND NOMVI-N-RELEASE >= 4
PERFORM UPDATE-MAIL-RECORDS
/*SU5 END-IF
*
COMPRESS AR-REPNAME (UPDREV.) '/'
  AR-REPRNB (UPDREV.) TO LG-MSG LEAVING NO
COMPRESS '0459' LG-MSG TO LG-MSG
PERFORM #RLOG
END TRANSACTION
IF +G-NOMEXIT-ACTIVE (8)
  PERFORM USER-EXIT-8
END-IF
*
END-SUBROUTINE /* UPDATE-ACTIVE-REPORT
*
************************************************************************
DEFINE SUBROUTINE UPDATE-MAIL-RECORDS
************************************************************************
FNDMA. FIND MAIL WITH MA-REP-RNB = #MA-REP-RNB
  IF MA-CURRENT-LOCATION = ' '
    G-NATRP-ERT := '1549'
    PERFORM XXRLOG-WRITE-LOG 'W' G-NATRP-ERT
  END-IF
  GMA. GET MAIL *ISN(FNDMA.)
  MAIL.MA-CURRENT-LOCATION := 'B'
  UPDATE (GMA.)
END-FIND
*
END-SUBROUTINE /* UPDATE-MAIL-RECORDS
*
************************************************************************
DEFINE SUBROUTINE COMPUTE-REVIVE-EXPIRATION
************************************************************************
#DATE-IN := *DATX
*
IF ACTIVE-REPORTS.AR-REVIVE-RETENTION-PERIOD = ' '
OR ACTIVE-REPORTS.AR-REVIVE-RETENTION-NUM = 0                         /*
  ACTIVE-REPORTS.AR-REVIVE-RETENTION-NUM  := 1
  ACTIVE-REPORTS.AR-REVIVE-RETENTION-UNIT := 'A'
  RESET  ACTIVE-REPORTS.AR-REVIVE-RETENTION-CALENDAR
END-IF
*
CALLNAT 'RCOMED-N' #DATE-IN ACTIVE-REPORTS.AR-REVIVE-RETENTION-PERIOD
  #DATE-OUT
*
MOVE EDITED #DATE-OUT (EM=YYYYMMDD) TO
  ACTIVE-REPORTS.AR-REVIVE-EXPIRATION
*
END-SUBROUTINE /* COMPUTE-REVIVE-EXPIRATION
*
************************************************************************
DEFINE SUBROUTINE IS-ANYTHING-TO-REVIVE
************************************************************************
IF #NATMEM NE ' ' AND #NATLIB NE ' '
  #AR-ARCHIVE-DATASET (*) := #ARCHIVE-DSNAME
  #AR-ARCHIVE-VOLSER (*)  := #VOLSER (1)
  #AR-REVIVE (1)          := 'S'
  #AR-REVIVE (2)          := 'D'
  FIND (1) ACTIVE-REPORTS WITH AR-DATASET-VOLSER-REVIVE =
      #AR-DATASET-VOLSER-REVIVE (1) OR = #AR-DATASET-VOLSER-REVIVE(2)
    IF NO RECORDS FOUND
      END-OF-PROCESSING:= TRUE
      ESCAPE ROUTINE
    END-NOREC
    NOMUDA-AR-NAME := AR-REPNAME
    NOMUDA-AR-RNB  := AR-REPRNB
    ESCAPE ROUTINE
  END-FIND
END-IF
*
IF #NVOL = 1 THRU 6  AND #VOLSER (#NVOL) NE ' '
  PERFORM FIND-NUMBER-REPORTS
  IF #NUMREP > 0
    ESCAPE ROUTINE
  END-IF
END-IF
*
REPEAT
  ADD 1 TO #NVOL
  IF #NVOL > 6
    END-OF-PROCESSING := TRUE
    ESCAPE ROUTINE
  END-IF
  IF #VOLSER (#NVOL) NE ' '
    PERFORM FIND-NUMBER-REPORTS
    IF #NUMREP > 0
      ESCAPE ROUTINE
    END-IF
  END-IF
END-REPEAT
*
END-SUBROUTINE /* IS-ANYTHING-TO-REVIVE
*
************************************************************************
DEFINE SUBROUTINE FIND-NUMBER-REPORTS
************************************************************************
#AR-ARCHIVE-DATASET (*) := #ARCHIVE-DSNAME
#AR-ARCHIVE-VOLSER (*)  := #VOLSER (#NVOL)
#AR-REVIVE (1)          := 'S'
#AR-REVIVE (2)          := 'D'
FNDRP. FIND NUMBER ACTIVE-REPORTS-LEFT
WITH AR-DATASET-VOLSER-REVIVE = #AR-DATASET-VOLSER-REVIVE (1)         /*
OR = #AR-DATASET-VOLSER-REVIVE (2)                                    /*
#NUMREP := *NUMBER (FNDRP.)
*
END-SUBROUTINE /* FIND-NUMBER-REPORTS
*
************************************************************************
/*SU7-> DEFINE SUBROUTINE LOGON-TO-ESY
************************************************************************
