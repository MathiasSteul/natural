* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    RDEFNAF
* Version   1.3
* Function  Define NAF Defaults
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* gw  94-06-27 s(999999) created
* gw  95-01-17 p(136151) cataloged
* jvd 98-09-10 p(164220) NOM141ÖNAT23
* gw  98-10-31 s(164220) M-CP-IDENT too short
* wcd 00-04-01 CE 7267   New PFkey for additional printers in RPFK---L
* xsetggr 2005-10-26 p(270950) ISN fields must be P10, not P8
* fhi     2010-09-03 NOMALL-97 Extend message line
* SU1     2016-08-01 NOMALL-1518 NOM3.5 deactivate opt.Compiler
* SU2     2020-11-10 NOMALL-2440 recat for VMONIT-L
* ----------------------------------------------------------------------
DEFINE DATA GLOBAL USING NRM-GL
LOCAL  USING RPFK---L
/*SU2 LOCAL  USING VMONIT-L
LOCAL
1 NRM-MONITOR VIEW OF NRM-MONITOR /*SU2
  2 M-TIME-SCHEDULE       (A1) /*NAF Interface active
  2 M-COPY-FILES-V141     (A26/1:20)
  2 REDEFINE M-COPY-FILES-V141
    3 M-CP-TAB            (1:20)
      4 M-CP-DBID         (N5)
      4 M-CP-FNR          (N5)
      4 M-CP-IDENT        (A16)
      4 REDEFINE M-CP-IDENT
        5 M-CP-IDENT-B    (A1/1:16)
  2 M-MONITOR-ID          (A20)
  2 M-WAIT-INCREMENT      (N3)
*
1 #ALLOWED                 (L)
1 #ARRAY                   (A16/1:5)
1 #FATHER-PROG             (A8) INIT <'RDFMEN'>
1 #FSPOOL                  (20)
  2 #FSPOOL-DBID           (N5)
  2 #FSPOOL-FNR            (N5)
1 #FUNC                    (A1)
1 #I                       (I4)
1 #ISN                     (N10)
1 #L                       (I4)
1 #LANGUAGE                (I1)
1 CV-MAP                   (C)  INIT <(AD=I CD=NE)>
1 L-HEADER                 (A78)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET G-COMMIT G-LINECOM(*)
*
#FUNC := G-C-FUNC
MAIN-LOOP. REPEAT
  FIND-LOOP. FIND NRM-MONITOR WITH M-MONITOR-ID = 'NAF'
    IF NO RECORDS FOUND /*???? SU optional ? if required, return err
      M-MONITOR-ID := 'NAF'
      STOR. STORE NRM-MONITOR /*NAF
      END TRANSACTION
      ESCAPE BOTTOM
    END-NOREC
    #ISN := *ISN (FIND-LOOP.)
    DECIDE ON FIRST VALUE OF #FUNC
      VALUE 'M'
        CALLNAT 'NARPSEC' G-USER-PROFILE 'MMO' #ALLOWED
        INCLUDE C-NALLOW
        GETREC. GET NRM-MONITOR #ISN
      VALUE 'D'
        CALLNAT 'NARPSEC' G-USER-PROFILE 'DMO' #ALLOWED
        INCLUDE C-NALLOW
        CV-MAP := (AD=IP)
      NONE IGNORE
    END-DECIDE
*
    SCREEN-LOOP. REPEAT
      IF #LANGUAGE NE *LANGUAGE
        PERFORM INIT-PFKEYS
        PERFORM SET-PFKEYS
        #LANGUAGE := *LANGUAGE
      END-IF
*
      PERFORM FLIP-DISPLAY
      CALLNAT 'N-HEADER' L-HEADER G-DATE-FORMAT 'RDEFNAF&'
      PERFORM BEFORE-INPUT
      INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT MARK *G-DIRECT-COMMAND
        USING MAP 'RDEFNAF&'
      PERFORM AFTER-INPUT
      RESET G-NATRP-ERC G-NATRP-ERT
*
      INCLUDE RPFKVA-C
      INCLUDE C-DIRECT
      INCLUDE RPFKED-C
*
      IF CV-MAP MODIFIED OR G-MAP-MODIFIED
        PERFORM VALIDATE-INPUT
        UPDATE(GETREC.)
        G-NATRP-ERC := 0032
        INCLUDE C-COMMIT
      END-IF
      INCLUDE REXDO--C
*
    END-REPEAT
  END-FIND
END-REPEAT
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-INPUT
************************************************************************
IF NOT M-TIME-SCHEDULE = 'Y' OR = 'N'
  REINPUT *1099 MARK *M-TIME-SCHEDULE ALARM
END-IF
*
FOR #I 1 20
  IF #FSPOOL-DBID (#I) NE 0 OR #FSPOOL-FNR (#I) NE 0 OR
      M-CP-DBID (#I) NE 0 OR M-CP-FNR (#I) NE 0
    DECIDE FOR FIRST CONDITION
      WHEN #FSPOOL-DBID (#I) = 0
        REINPUT *1532 MARK *#FSPOOL-DBID (#I)
      WHEN #FSPOOL-FNR  (#I) = 0
        REINPUT *1533 MARK *#FSPOOL-FNR  (#I)
      WHEN M-CP-DBID  (#I) = 0
        REINPUT *1532 MARK *M-CP-DBID  (#I)
      WHEN M-CP-FNR   (#I) = 0
        REINPUT *1533 MARK *M-CP-FNR   (#I)
      WHEN NONE IGNORE
    END-DECIDE
    COMPRESS 'FS=(' #FSPOOL-DBID (#I) ',' #FSPOOL-FNR (#I) ')'
      TO M-CP-IDENT (#I) LEAVING NO
  ELSE
    RESET  M-COPY-FILES-V141 (#I)
  END-IF
END-FOR
*
END-SUBROUTINE /* VALIDATE-INPUT
*
************************************************************************
DEFINE SUBROUTINE BEFORE-INPUT
************************************************************************
RESET #FSPOOL (*)
*
FOR #I = 1 TO 20
  IF M-CP-IDENT (#I) = MASK ('FS=('............)
    EXAMINE M-CP-IDENT (#I) FOR 'x' GIVING LENGTH IN #L
    IF #L > 0 AND M-CP-IDENT-B (#I,#L) = ')'
      SEPARATE M-CP-IDENT (#I) LEFT INTO #ARRAY (*)
        IGNORE WITH DELIMITER ' ,()'
      IF #ARRAY (2) IS (N5) AND  #ARRAY (3) IS (N5)
        #FSPOOL-DBID (#I) := VAL (#ARRAY (2))
        #FSPOOL-FNR  (#I) := VAL (#ARRAY (3))
      END-IF
    END-IF
  END-IF
END-FOR
*
END-SUBROUTINE /* BEFORE-INPUT
*
************************************************************************
DEFINE SUBROUTINE AFTER-INPUT
************************************************************************
ESCAPE ROUTINE
*
END-SUBROUTINE /* AFTER-INPUT
*
************************************************************************
DEFINE SUBROUTINE INIT-PFKEYS
************************************************************************
RESET G-PF
*
INCLUDE RPFSTD-C
INCLUDE RPFCOM-C
CALLNAT 'RPFINI-N' G-PF G-PFB
*
END-SUBROUTINE /* INIT-PFKEYS
* --------------------------------------- set pfkeys -------------------
INCLUDE RPFSET-C
*
END
