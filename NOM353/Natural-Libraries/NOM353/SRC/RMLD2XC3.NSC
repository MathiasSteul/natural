* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RMLD2XC3 - Copy code for RMLD2XML
*                                                                       ********
* Maintenance
* User ID   yyyy-mm-dd Issue       Remark
* --------------------------------------------------------------------- --------
* fhi       2013-08-19 NOMALL-86   Created.
* SU1     2021-02-17 NOMALL-2443 use of PDA RMEXP-A
************************************** data ************************************
COMPRESS &2& &1&
  TO #ID-MEMBER LEAVING NO
EXAMINE +ID (*) FOR #ID-MEMBER GIVING INDEX IN #IND
IF #IND = 0
  CALLNAT 'RMEXPGR' XXUX---P #EXPORT #TRACING #ID-MEMBER /*SU1 was ORDER
  IF #OD-ERROR-CODE NE 0
    ESCAPE MODULE
  END-IF
  IF +ID-INDEX GE *OCC(+ID)
    #IND := +ID-INDEX + 10
    EXPAND ARRAY +ID TO (1:#IND)
  END-IF
  ADD 1 TO +ID-INDEX
  +ID (+ID-INDEX) := #ID-MEMBER
END-IF
** End of Copycode RMLD2XC3 ********************************************
