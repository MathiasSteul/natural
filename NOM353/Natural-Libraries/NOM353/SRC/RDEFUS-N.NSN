* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
** RDEFUS-N
* Version    2.2.1
* Function   add NOM userid 'default' with default user profile
*            and add default folder for non-defined userid
* Parameter           current language
*
* Maintenance:
* XSETGGR 2003-08-06           created
* XSETGGR 2003-08-28 P(240465) changed
* XSETHZ  2003-09-05           changed
* xsetggr 2013-04-25 ES-104 implement new user profile value,used in NGC
* SU1     2013-09-16 NOMALL-1281 last update user+date
* fhi     2014-07-10 NOMALL-1440 Change default for filter setting
* ----------------------------------------------------------------------
DEFINE DATA
PARAMETER
1 P-USER-ID         (A8)
1 P-LANGUAGE        (I1)
1 P-PROFILE-STRING  (A100)
1 P-USER-ID-SAVE    (A8) /*SU1 in
LOCAL     USING PROF-LOC
LOCAL
1 USER VIEW OF NRM-USERS
  2 USER-ID
  2 FIRST-NAME
  2 LAST-NAME
  2 USER-PROFILE
  2 US-LAST-UPDATE /*SU1 in
  2 US-LAST-UPDATE-USER /*SU1 in
1 FOLDER VIEW OF NRM-FOLDER
  2 FO-ID
  2 FO-NAME
  2 FO-USER-ID
1 #FO-USER-FO-ID       (A10)
1 REDEFINE #FO-USER-FO-ID
  2 #FO-USER           (A8)
  2 #FO-ID             (B2)
1 #FOLDER-NAME         (A16)
1 #DEF-USER                         (A8)  CONST <'DEFAULT'>
END-DEFINE
* -------------------------------------------------------------------
COMPRESS 'IN RDEFUS-N' TO P-PROFILE-STRING
FIND (1) USER WITH USER-ID = #DEF-USER
  IF NO RECORDS FOUND
/*  IF P-USER-ID = ' '              /* XSETHZ 2003-09-05
    USER-ID    := #DEF-USER
    FIRST-NAME := 'Logical userid'
    LAST-NAME  := 'Representing default user profile'
    PROF-TYPE := 'G'            /* USER TYPE - A/G
    IF P-LANGUAGE = 2
      PROF-LANGUAGE   := '2'   /* USER LANGUAGE - 1/2
    ELSE
      PROF-LANGUAGE   := '1'
    END-IF
    PROF-EXTERNAL       := 'Y' /* LOGON TO ESY - Y/N
    PROF-REPORTS        := 'D' /* REPORT MAINT - D/M/P
    PROF-BUNDLES        := 'D' /* BUNDLES -D/M/P
    PROF-LISTS          := 'D' /* DIST. LISTS - D/M/P
    PROF-PRINTERS       := 'D' /* LOGICAL PRINTERS - D/M/P
    PROF-PHYSICAL       := 'D' /* PHYSICAL PRINTERS - D/M/P
    PROF-CALENDARS      := 'D' /* CALENDARS - D/M/P
    PROF-USERS          := 'D' /* USER MAINT - D/M/P
    PROF-CONFIRM        := 'Y' /* CONFIRM DELETE - Y/N
    PROF-AUTOCOMMIT     := 'E' /* AUTOCOMMIT - E/I
    PROF-AREPS          := 'D' /* ACTIVE REPORTS (D/M/P)
    PROF-ABUNDS         := 'D' /* ACTIVE BUNDLES - D/M/P
    PROF-PRINTOUTS      := 'D' /* PRINTOUTS - D/M/P
    PROF-ARCHIVE-ADMIN  := 'N' /* ARCHIVE ADMIN - Y/N
    PROF-DEFAULTS       := 'D' /* SYSTEM DEFAULTS - D/M
    PROF-RESTRICT-ABUN  := 'Y' /* RESTRICT ABUN.   (Y/N)
    PROF-DISPLAY-LONG-NAMES := 'N' /* DISPL. LONG NAMES (Y/N)
    PROF-EDT-PREFIX   := 'N' /* PREFIX IN BROWSE ACT REP-Y/N
    PROF-EDT-KEYS     := 'N' /* PFKEYS IN BROWSE ACT REP-Y/N
    PROF-ARCHIVE      := 'N' /* ARCHIVE - Y/N
    PROF-REVIVE       := 'N' /* REVIVE - Y/N
    PROF-FLUSH        := 'N' /* FLUSH BUNDLE - Y/N
    PROF-STARTUP      := 'N' /* START MONITOR - Y/N
    PROF-SHUTDOWN     := 'N' /* STOP MONITOR - Y/N
    PROF-ABUN-LIST-FORMAT  := '1' /* ABUN LIST FORMAT(1/2)
    PROF-DISPLAY-MONITOR   := 'N' /* DISPLAY MON-LOG (Y/N)
* xsetggr 2013-04-25 ES-104 insert next line
*   PROF-AR-FILTER-SUBSTR  := 'Y'  /* used AR filter for NGC
* fhi     2014-07-10 NOMALL-1440 line above out, below in
    PROF-AR-FILTER-SUBSTR  := 'N'  /* used AR filter for NGC
    USER-PROFILE           := PROFILE-STRING
    US-LAST-UPDATE      := *TIMX /*SU1 in
    US-LAST-UPDATE-USER := P-USER-ID-SAVE /*SU1 in
*
    STORE USER
/*  END-IF                            /* XSETHZ 2003-09-05
  END-NOREC
  P-PROFILE-STRING := USER-PROFILE
END-FIND
IF P-USER-ID > ' '
  IF PROF-LANGUAGE =  '2'
    P-LANGUAGE := 2
    #FOLDER-NAME := '#Listeneingang'
  ELSE
    P-LANGUAGE := 1
    #FOLDER-NAME := '#Inbasket'
  END-IF
  #FO-USER := P-USER-ID
  #FO-ID := 1
  FIND FOLDER  WITH FO-USER-FO-ID = #FO-USER-FO-ID
    IF NO RECORDS FOUND
      FO-USER-ID := P-USER-ID
      FO-ID      := 1
      FO-NAME    := #FOLDER-NAME
      STORE FOLDER
    END-NOREC
  END-FIND
END-IF
END
