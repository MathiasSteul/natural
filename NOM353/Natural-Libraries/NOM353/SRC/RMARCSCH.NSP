* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RMARCSCH - Schedule Tasks (Archive, Revive, Cleanup)
*            Daily cleanup is done right here
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* mrs 93-07-02 s(999999) rewritten
* mrs 93-11-04 s(182359) monitor won't close
* gw  93-11-30 s(999999) condense
* mrs 93-12-10 s(999999) use common data to reduce data base calls
* SJU 97-04-25 P(162128) CHECK IF NOMCLEAN RAN AND IF SO ONLY DO ORDERS
* jwo 97-07-07 p(163545) don't user M-TIME-SCHEDULE for task, which has
*                        to be done daily anyway.
* jwo 97-10-09 p(163166) Change date to y2k format
* gw  98-02-17 s(275206) synchronize report creation with source cleanup
*                        -> RMONITOR, NOMCLEAN, RMSRCK, NOMCLNSP
* gw  98-09-11 s(295507) daily cleanup won't start
* sju 00-03-13 s(191368) monitor multitasking
* sju 00-03-14 p(192484) no printing during cleanup - see NOMCLEAN
* sju 02-12-17 p(230197) Monitor hangs while system defaults are being
*                        modified (8.1.1/8.1.2/8.1.3/8.1.4). Use a new
*                        control record SYNCHCLN.
* sju 03-06-09 p(241253) archive dataset cleanup
* sju 04-03-03 p(250348) Automatic cleanup with daily cleanup if no
*                        schedule defined for Automatic cleanup (will
*                        only cleanup source control records and
*                        container files).
* sju 04-12-06 NOM31     Add date and time (tenths of second) to trace
* fhi     2010-05-28 NOMALL-93 Create statistics data for Optimize
* fhi     2010-09-03 NOMALL-97 Extend message line
* fhi     2010-10-12 NOMALL-97 Use trace levels, use XXRLOG
* SU1 2014-02-10 NOMALL-1344 unix - daily cleanup does not delete orders
*                            - just remove deactivated coding
* fhi     2014-03-03 NOMALL-1363 Get cat cate into trace messages
* fhi     2016-09-15 NOMALL-1621 Use +NOD-LOCAL-NODE as monitor node
* fhi     2016-11-15 NOMALL-1961 Use new task IDs
* fhi     2017-03-31 NOMALL-2009 Improve RDC handling
* SU2     2019-02-19             avoid NAT3071 in QA BS2 env.
************************************************************************
*
DEFINE DATA GLOBAL USING MONIT-GL
INDEPENDENT
1 +NOD-LOCAL-NODE  (N5)
1 +CMRDC           (A1)
************************************************************************
LOCAL USING VARCIV-L
LOCAL USING RMSETSTE
LOCAL
1 MONITOR-TASK VIEW OF NRM-ARCHIVE-TASK
  2 M-ARCHIVE-PREFIX
  2 REDEFINE M-ARCHIVE-PREFIX
    3 CLEANUP-IDENTIFIER    (A5)
    3 CLEANUP-RESCHEDULE    (L)
    3 CLEANUP-ACTIVE-NOW    (L)
    3 REPORT-PROCESSING-NOW (L)
1 ARCHIVE-TASK-AUTO VIEW OF NRM-ARCHIVE-TASK
  2 M-PLAN-ARC-TIME
1 #CURRENT-TIME             (T)
1 #START-TIME               (A4)
1 #END-TIME                 (A4)
1 #TIME-INT                 (A4) INIT <'0000'>
1 #TIME12                   (A12)
1 #ISN                      (P10)
1 #TRACING                  (L)
1 #CATDATE                  (A19)
1 #MONIT-ID                 (A16)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#MONIT-ID := F#MONITOR-TASK-ID1 (<>)
*
IF G-TRACE GE *LEVEL
  #TRACING := TRUE
  PERFORM XXCATAL-GET-CATDATE #CATDATE
  COMPRESS 'Start' *PROGRAM 'cataloged at'  #CATDATE TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  INCLUDE CMRDC
END-IF
*
ARC. FIND (5) ARCHIVE-TASK WITH M-MONITOR-ID = 'ARCHIVE' OR = 'REVIVE'
OR = 'CONDENSE' OR = 'CLEANUP' OR = #MONIT-ID                      /*SU2
/*SU2 OR = 'CONDENSE' OR = 'CLEANUP' OR M-MONITOR-ID = #MONIT-ID     /*
  IF #TRACING
    COMPRESS 'Task' M-MONITOR-ID 'scheduled for'
      ARCHIVE-TASK.M-PLAN-ARC-TIME TO G-TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END-IF
  MOVE EDITED ARCHIVE-TASK.M-PLAN-ARC-TIME (EM=YYYYMMDDHHII) TO #TIME12
  IF #TIME12 = '000001020000'
    BACKOUT TRANSACTION
    ESCAPE TOP
  END-IF
  IF ARCHIVE-TASK.M-PLAN-ARC-TIME LE *TIMX
    IF #TRACING
      COMPRESS 'Task' M-MONITOR-ID 'started' TO G-TRACE-MSG
      PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
    END-IF
    DECIDE ON FIRST M-MONITOR-ID
      VALUE 'ARCHIVE'
        CALLNAT 'RMSETSTN' /*  Indic. curr. status of monitor cyc.
          #EQU-START-ARCHIVER +NOD-LOCAL-NODE G-NATRP-DBID G-NATRP-FNR
          G-SHUTDOWN G-TASK-NUMBER
        IF G-SHUTDOWN
          ESCAPE BOTTOM (ARC.)
        END-IF
        FETCH RETURN 'RMARCJOB'  /* Submit Archive Job
      VALUE 'REVIVE'
        CALLNAT 'RMSETSTN' /*  Indic. curr. status of monitor cyc.
          #EQU-START-REVIVER +NOD-LOCAL-NODE G-NATRP-DBID G-NATRP-FNR
          G-SHUTDOWN G-TASK-NUMBER
        IF G-SHUTDOWN
          ESCAPE BOTTOM (ARC.)
        END-IF
        FETCH RETURN 'RMREVJOB'  /* submit Revive Jobs
      VALUE 'CONDENSE'
        CALLNAT 'RMSETSTN' /*  Indic. curr. status of monitor cyc.
          #EQU-START-CONDENSE +NOD-LOCAL-NODE G-NATRP-DBID G-NATRP-FNR
          G-SHUTDOWN G-TASK-NUMBER
        IF G-SHUTDOWN
          ESCAPE BOTTOM (ARC.)
        END-IF
        FETCH RETURN 'RMCDNJOB' /* Submit Condense Job
      VALUE 'CLEANUP'
        PERFORM AUTOMATIC-CLEANUP
        IF G-SHUTDOWN
          ESCAPE BOTTOM(ARC.)
        END-IF
      VALUE #MONIT-ID
        FIND (1) MONITOR-TASK WITH M-MONITOR-ID = 'SYNCHCLN'
          #ISN:= *ISN
        END-FIND
        IF NOT (MONITOR-TASK.CLEANUP-RESCHEDULE
            OR MONITOR-TASK.CLEANUP-ACTIVE-NOW)
          PERFORM DAILY-CLEANUP
          IF G-SHUTDOWN
            ESCAPE BOTTOM (ARC.)
          END-IF
          FNDAUTO. FIND ARCHIVE-TASK-AUTO WITH M-MONITOR-ID = 'CLEANUP'
            IF NO RECORDS FOUND           /* Cleanup defaults missing -
              #TIME12:= '000001020000'    /* force invocation of RMSRCK
            END-NOREC                     /* (will write a log record)
            MOVE EDITED ARCHIVE-TASK-AUTO.M-PLAN-ARC-TIME
              (EM=YYYYMMDDHHII) TO #TIME12
            IF #TIME12 = '000001020000'
              PERFORM AUTOMATIC-CLEANUP
            END-IF
          END-FIND
          IF G-SHUTDOWN
            ESCAPE BOTTOM (ARC.)
          END-IF
        END-IF
        IF #ISN NE 0
          GETSYNC. GET MONITOR-TASK #ISN
          MONITOR-TASK.CLEANUP-RESCHEDULE:= FALSE
          UPDATE (GETSYNC.)
        END-IF
      NONE  IGNORE
    END-DECIDE
*
    GET. GET ARCHIVE-TASK *ISN(ARC.)
    IF ARCHIVE-TASK.M-TIME-SCHEDULE = 'Y' OR M-MONITOR-ID = #MONIT-ID
      PERFORM GET-NEXT-PLAN-TIME
    ELSE
      RESET ARCHIVE-TASK.M-PLAN-ARC-TIME
    END-IF
    UPDATE (GET.)
    END TRANSACTION
  END-IF
*
END-FIND
IF #TRACING
  G-TRACE-MSG := 'End'
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END TRANSACTION
END-IF
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE GET-NEXT-PLAN-TIME
************************************************************************
#CURRENT-TIME := *TIMX
MOVE EDITED ARCHIVE-TASK.M-ARCHIVE-TIME (EM=HHII) TO #START-TIME
IF #START-TIME = '0000'
  #START-TIME := '0001'
END-IF
IF ARCHIVE-TASK.M-MONITOR-ID = 'ARCHIVE'
  RESET INITIAL #TIME-INT
  #END-TIME := #START-TIME
ELSE
  #END-TIME := ARCHIVE-TASK.M-ARCHIVE-TIME-END
  #TIME-INT := ARCHIVE-TASK.M-ARCHIVE-TIME-INT
END-IF
/* Scheduling routine:
CALLNAT 'RSCHED-N' #CURRENT-TIME #START-TIME #TIME-INT #END-TIME
  ARCHIVE-TASK.M-ARCHIVE-WEEK-DAYS (1:7)
  ARCHIVE-TASK.M-ARCHIVE-DAYS (1:30) ARCHIVE-TASK.M-ARCHIVE-CALENDAR
  ARCHIVE-TASK.M-ARCHIVE-BEFORE-AFTER ARCHIVE-TASK.M-PLAN-ARC-TIME
*
END-SUBROUTINE /* GET-NEXT-PLAN-TIME
*
************************************************************************
DEFINE SUBROUTINE DAILY-CLEANUP
************************************************************************
CALLNAT 'RMSETSTN' #EQU-PURGE-EXPIRED-REP +NOD-LOCAL-NODE G-NATRP-DBID
  G-NATRP-FNR G-SHUTDOWN G-TASK-NUMBER
IF G-SHUTDOWN
  ESCAPE ROUTINE
END-IF
/* Purge Report or mark Report for archiving if retention *has expired
FETCH RETURN 'RMPRGRP'
*
CALLNAT 'RMSETSTN' #EQU-PURGE-EXPIRED-BUN +NOD-LOCAL-NODE G-NATRP-DBID
  G-NATRP-FNR G-SHUTDOWN G-TASK-NUMBER
IF G-SHUTDOWN
  ESCAPE ROUTINE
END-IF
FETCH RETURN 'RMPRGBU'
*
CALLNAT 'RMSETSTN' #EQU-PURGE-EXPIRED-LOG +NOD-LOCAL-NODE G-NATRP-DBID
  G-NATRP-FNR G-SHUTDOWN G-TASK-NUMBER
IF G-SHUTDOWN
  ESCAPE ROUTINE
END-IF
FETCH RETURN 'RMPRGLOG'
*
CALLNAT 'RMSETSTN' #EQU-PURGE-EXPIRED-ARC +NOD-LOCAL-NODE G-NATRP-DBID
  G-NATRP-FNR G-SHUTDOWN G-TASK-NUMBER
IF G-SHUTDOWN
  ESCAPE ROUTINE
END-IF
FETCH RETURN 'RMPRGREV'
*
CALLNAT 'RMSETSTN' #EQU-PURGE-EXPIRED-PO +NOD-LOCAL-NODE G-NATRP-DBID
  G-NATRP-FNR G-SHUTDOWN G-TASK-NUMBER
IF G-SHUTDOWN
  ESCAPE ROUTINE
END-IF
FETCH RETURN 'RMPRGPO'
*
CALLNAT 'RMSETSTN' #EQU-PURGE-EXPIRED-ARC +NOD-LOCAL-NODE G-NATRP-DBID
  G-NATRP-FNR G-SHUTDOWN G-TASK-NUMBER
IF G-SHUTDOWN
  ESCAPE ROUTINE
END-IF
FETCH RETURN 'RMPRGARC'
FETCH RETURN 'RMCLNARC'
FETCH RETURN 'RMPRGOD'
FETCH RETURN 'NOMSTCSC'
*
END-SUBROUTINE /* DAILY-CLEANUP
*
************************************************************************
DEFINE SUBROUTINE AUTOMATIC-CLEANUP
************************************************************************
FIND (1) MONITOR-TASK WITH M-MONITOR-ID = 'SYNCHCLN'
END-FIND
IF NOT (MONITOR-TASK.CLEANUP-IDENTIFIER = 'CLEAN' AND
    MONITOR-TASK.CLEANUP-ACTIVE-NOW )
  CALLNAT 'RMSETSTN' /*  Indic. curr. status of monitor cyc.
    #EQU-ANALYSE-SOURCES +NOD-LOCAL-NODE G-NATRP-DBID G-NATRP-FNR
    G-SHUTDOWN G-TASK-NUMBER
  IF G-SHUTDOWN
    ESCAPE ROUTINE
  END-IF
  /* Check sources and create cleanup orders:
  FETCH RETURN 'RMSRCK'
END-IF
*
END-SUBROUTINE /* AUTOMATIC-CLEANUP
*
END
