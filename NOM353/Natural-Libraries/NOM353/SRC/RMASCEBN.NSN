* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RMASCEBN - Converts ASCII to EBCDIC Code and vice versa
*
* Maintenance:
* uuuuuuuu yyyy-mm-dd iTrac       Comment
* fhi      2013-07-03 NOMALL-1251 Created.
* fhi      2014-07-14 NOMALL-1430 Need for longer strings
* SU1     2015-02-27 NOMALL-1569 USR0620N (SYSEXT) => CALL 'CMULT'
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 #CONVERT-MODE   (A1)  BY VALUE
1 P-STRING        (A) DYNAMIC BY VALUE RESULT
************************************************************************
LOCAL
1 LENGTH          (B2)
1 #LEN            (I4)
1 #I              (I4)
1 #STRING         (A250)
* 1 #ASC-BLANKS   (A2) INIT <H'4020'>
* 1 #EBC-BLANKS   (A2) INIT <H'2040'>
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
/* CONVERT-MODE 'E'  --> EBCDIC -> ASCII
/* CONVERT-MODE 'A'  --> ASCII  -> EBCDIC
FOR #I = 1 TO *LENGTH(P-STRING) STEP 250
  #LEN := *LENGTH(P-STRING) - #I + 1
  IF #LEN > 250
    #LEN := 250
  END-IF
  #STRING := SUBSTR (P-STRING,#I,#LEN)
  LENGTH := #LEN
  CALL 'CMULT' #CONVERT-MODE #STRING LENGTH
  MOVE #STRING TO SUBSTR (P-STRING,#I,#LEN)
END-FOR
*
END
