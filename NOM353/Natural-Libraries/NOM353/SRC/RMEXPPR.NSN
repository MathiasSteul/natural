LOCAL
1 PR VIEW OF NRM-PRINTERS /*SU5 was RMEXPPRL
  2 P-OBJECT-TYPE       (A10)
  2 P-OBJECT-TIME       (T)
  2 P-ID                (A8)
  2 P-NAME              (A30)
  2 P-PHYSICAL-NAME     (A8)
  2 P-LOCATION          (A50)
  2 P-EXITMEM           (A8)
  2 P-EXITLIB           (A8)
  2 P-COPIES            (N3)
  2 P-PRIORITY          (N3)
  2 P-JOBCARD           (A72/1:3)
  2 P-ATTRIBUTES        (A95/1:25)
  2 REDEFINE P-ATTRIBUTES
    3 P-ATTR            (1:25)
      4 P-ATTR-IDENT    (I1)
      4 P-ATTR-LENGTH   (N2)
      4 P-ATTR-PROMPT   (N4)
      4 P-ATTR-VAR      (A16)
      4 P-ATTR-VALUE    (A72)
  2 P-CHARS             (A60)
  2 P-CLASS             (A1)
  2 P-FORM              (A4)
  2 P-WRITER            (A8)
  2 P-DESTINATION       (A8)
  2 P-FLASH             (A8)
  2 P-FCB               (A8)
  2 P-PAGEDEF           (A8)
  2 P-FORMDEF           (A8)
  2 P-DSNAME            (A44)
  2 P-MEMBER            (A8)
  2 P-VOLSER            (A6)
  2 P-DISP              (A3)
  2 P-TAPE-GENERIC      (A8)
  2 P-JOBNAME           (A72)
  2 P-LABEL             (A40/1:1)
  2 P-DCB               (A60/1:2)
  2 P-LAST-UPDATE       (T)
  2 P-LAST-UPDATE-USER  (A16)
1 WRITE-FILE VIEW OF WRITE-FILE
  2 ERROR-CODE
  2 ERROR-TEXT
*
1 #FIELD                 (A32)
1 #VALUE                 (A300)
1 #LEN                   (I4)
1 #WORK-LINE             (A250)
1 #FUNCTION              (A10)
1 #I                     (I4)
1 #J                     (I4)
1 #K                     (I4)
1 #L                     (I4)
1 #PROGRAM               (A8) INIT <*PROGRAM>
1 REDEFINE #PROGRAM
  2 FILLER               5X /*RMEXP
  2 #TYPE                (A2)
1 #KEY                   (A100)
1 #KEY-FROM              (A100)
1 #KEY-TO                (A100) INIT FULL LENGTH <H'FF'>
1 #KEY-MASK              (A25)
/*SU5 1 #KEY-LEN               (I2)
