1 #ID-MEMBER             (A) DYNAMIC
1 #EXPORT-PROG           (A8)
1 #MASK                  (A300) INIT FULL LENGTH <'P'>
1 #PRINTABLE             (A300)
1 #P-OBJECT-TIME         (A21)
1 #P-LAST-UPDATE         (A21)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
PERFORM #START
READ PR BY P-ID = #KEY-FROM THRU #KEY-TO
  #KEY := P-ID
  PERFORM HANDLE-MASK
* Get depending objects:
  INCLUDE RMLD2XC1 'P-PHYSICAL-NAME' '''RMEXPPH'''
  INCLUDE RMLD2XC3 'P-ID' '''P''' /*RMEXPGR
  COMPRESS '<PR depending="' #DEP '">' TO #WORK-LINE LEAVING NO
  PERFORM WRITE-XML
  IF #OD-LOG = 'Y'
    IF #ID SPECIFIED
      COMPRESS 'Exported: PR */' P-ID TO #TRACE-MSG
    ELSE
      COMPRESS 'Exported: PR /' P-ID TO #TRACE-MSG
    END-IF
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    END TRANSACTION
  END-IF
  MOVE EDITED PR.P-OBJECT-TIME (EM=YYYY'-'MM'-'DD'-'HH':'II':'SS'.'T)
    TO #P-OBJECT-TIME
  MOVE EDITED PR.P-LAST-UPDATE (EM=YYYY'-'MM'-'DD'-'HH':'II':'SS'.'T)
    TO #P-LAST-UPDATE
  #FIELD := 'P-OBJECT-TYPE'
  #VALUE :=  PR.P-OBJECT-TYPE
  PERFORM CONVERT-XML
  #FIELD := 'P-OBJECT-TIME'
  #VALUE :=  #P-OBJECT-TIME
  PERFORM CONVERT-XML
  #FIELD := 'P-ID'
  #VALUE :=  PR.P-ID
  PERFORM CONVERT-XML
  #FIELD := 'P-NAME'
  #VALUE :=  PR.P-NAME
  PERFORM CONVERT-XML
  #FIELD := 'P-PHYSICAL-NAME'
  #VALUE :=  PR.P-PHYSICAL-NAME
  PERFORM CONVERT-XML
  #FIELD := 'P-LOCATION'
  #VALUE :=  PR.P-LOCATION
  PERFORM CONVERT-XML
  #FIELD := 'P-EXITMEM'
  #VALUE :=  PR.P-EXITMEM
  PERFORM CONVERT-XML
  #FIELD := 'P-EXITLIB'
  #VALUE :=  PR.P-EXITLIB
  PERFORM CONVERT-XML
  #FIELD := 'P-COPIES'
  #VALUE :=  PR.P-COPIES
  MOVE LEFT #VALUE TO #VALUE
  PERFORM CONVERT-XML
  #FIELD := 'P-PRIORITY'
  #VALUE :=  PR.P-PRIORITY
  MOVE LEFT #VALUE TO #VALUE
  PERFORM CONVERT-XML
  FOR #L := 3 TO 1 STEP -1
    IF PR.P-JOBCARD (#L) NE ' '
      ESCAPE BOTTOM
    END-IF
  END-FOR
  FOR #I = 1 TO #L
    #FIELD := 'P-JOBCARD'
    #VALUE :=  PR.P-JOBCARD(#I)
    PERFORM CONVERT-XML1
  END-FOR
  FOR #L := 25 TO 1 STEP -1
    IF PR.P-ATTR-IDENT (#L) NE 0
      ESCAPE BOTTOM
    END-IF
  END-FOR
  FOR #I = 1 TO #L
    #FIELD := 'P-ATTR-IDENT'
    #VALUE :=  PR.P-ATTR-IDENT(#I)
    PERFORM CONVERT-XML1
  END-FOR
  FOR #L := 25 TO 1 STEP -1
    IF PR.P-ATTR-LENGTH (#L) NE 0
      ESCAPE BOTTOM
    END-IF
  END-FOR
  FOR #I = 1 TO #L
    #FIELD := 'P-ATTR-LENGTH'
    #VALUE :=  PR.P-ATTR-LENGTH(#I)
    MOVE LEFT #VALUE TO #VALUE
    PERFORM CONVERT-XML1
  END-FOR
  FOR #L := 25 TO 1 STEP -1
    IF PR.P-ATTR-PROMPT (#L) NE 0
      ESCAPE BOTTOM
    END-IF
  END-FOR
  FOR #I = 1 TO #L
    #FIELD := 'P-ATTR-PROMPT'
    #VALUE :=  PR.P-ATTR-PROMPT(#I)
    MOVE LEFT #VALUE TO #VALUE
    PERFORM CONVERT-XML1
  END-FOR
  FOR #L := 25 TO 1 STEP -1
    IF PR.P-ATTR-VAR (#L) NE ' '
      ESCAPE BOTTOM
    END-IF
  END-FOR
  FOR #I = 1 TO #L
    #FIELD := 'P-ATTR-VAR'
    #VALUE :=  PR.P-ATTR-VAR(#I)
    PERFORM CONVERT-XML1
  END-FOR
  FOR #L := 25 TO 1 STEP -1
    IF PR.P-ATTR-VALUE (#L) NE ' '
      ESCAPE BOTTOM
    END-IF
  END-FOR
  FOR #I = 1 TO #L
    #FIELD := 'P-ATTR-VALUE'
    #VALUE :=  PR.P-ATTR-VALUE(#I)
    PERFORM CONVERT-XML1
  END-FOR
/*SU4 #FIELD := 'P-NODE' #VALUE :=  PR.P-NODE MOVE LEFT #VALUE TO #VALUE
/*SU4  PERFORM CONVERT-XML
  #FIELD := 'P-CHARS'
  #VALUE :=  PR.P-CHARS
  PERFORM CONVERT-XML
  #FIELD := 'P-CLASS'
  #VALUE :=  PR.P-CLASS
  PERFORM CONVERT-XML
  #FIELD := 'P-FORM'
  #VALUE :=  PR.P-FORM
  PERFORM CONVERT-XML
  #FIELD := 'P-WRITER'
  #VALUE :=  PR.P-WRITER
  PERFORM CONVERT-XML
  #FIELD := 'P-DESTINATION'
  #VALUE :=  PR.P-DESTINATION
  PERFORM CONVERT-XML
  #FIELD := 'P-FLASH'
  #VALUE :=  PR.P-FLASH
  PERFORM CONVERT-XML
  #FIELD := 'P-FCB'
  #VALUE :=  PR.P-FCB
  PERFORM CONVERT-XML
  #FIELD := 'P-PAGEDEF'
  #VALUE :=  PR.P-PAGEDEF
  PERFORM CONVERT-XML
  #FIELD := 'P-FORMDEF'
  #VALUE :=  PR.P-FORMDEF
  PERFORM CONVERT-XML
  #FIELD := 'P-DSNAME'
  #VALUE :=  PR.P-DSNAME
  PERFORM CONVERT-XML
  #FIELD := 'P-MEMBER'
  #VALUE :=  PR.P-MEMBER
  PERFORM CONVERT-XML
  #FIELD := 'P-VOLSER'
  #VALUE :=  PR.P-VOLSER
  PERFORM CONVERT-XML
  #FIELD := 'P-DISP'
  #VALUE :=  PR.P-DISP
  PERFORM CONVERT-XML
  #FIELD := 'P-TAPE-GENERIC'
  #VALUE :=  PR.P-TAPE-GENERIC
  PERFORM CONVERT-XML
  #FIELD := 'P-JOBNAME'
  #VALUE :=  PR.P-JOBNAME
  PERFORM CONVERT-XML
  FOR #L := 1 TO 1 STEP -1
    IF PR.P-LABEL (#L) NE ' '
      ESCAPE BOTTOM
    END-IF
  END-FOR
  FOR #I = 1 TO #L
    #FIELD := 'P-LABEL'
    #VALUE :=  PR.P-LABEL(#I)
    PERFORM CONVERT-XML1
  END-FOR
  FOR #L := 2 TO 1 STEP -1
    IF PR.P-DCB (#L) NE ' '
      ESCAPE BOTTOM
    END-IF
  END-FOR
  FOR #I = 1 TO #L
    #FIELD := 'P-DCB'
    #VALUE :=  PR.P-DCB(#I)
    PERFORM CONVERT-XML1
  END-FOR
  #FIELD := 'P-LAST-UPDATE'
  #VALUE :=  #P-LAST-UPDATE
  PERFORM CONVERT-XML
  #FIELD := 'P-LAST-UPDATE-USER'
  #VALUE :=  PR.P-LAST-UPDATE-USER
  PERFORM CONVERT-XML
*
  PERFORM #END-OBJ
END-READ
PERFORM #END
