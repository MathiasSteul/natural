* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* C-TODAY
* jwo 1977-10-07 p(163166) Change date to y2k format
************************************************************************
*
DEFINE DATA PARAMETER
1 #DATE2      (A10)    /*OUTPUT DATE
1 #TYPE       (A1)       /*DATE TYPE
************************************************************************
LOCAL
1 #DD         (D)
1 #DATN       (A8)
1 #NEW-FORMAT (L) INIT <TRUE>
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#DATN := *DATN
MOVE EDITED #DATN  TO #DD(EM=YYYYMMDD)
IF #NEW-FORMAT EQ FALSE
  DECIDE ON EVERY VALUE OF #TYPE
    VALUE ' ','I' MOVE EDITED #DD (EM=YY'-'MM'-'DD) TO #DATE2
    VALUE 'A'     MOVE EDITED #DD (EM=MM'/'DD'/'YY) TO #DATE2
    VALUE 'E'     MOVE EDITED #DD (EM=DD'/'MM'/'YY) TO #DATE2
    VALUE 'G'     MOVE EDITED #DD (EM=DD'.'MM'.'YY) TO #DATE2
    NONE IGNORE
  END-DECIDE
  MOVE RIGHT #DATE2 TO #DATE2
ELSE
  DECIDE ON EVERY VALUE OF #TYPE
    VALUE ' ','I' MOVE EDITED #DD (EM=YYYY'-'MM'-'DD) TO #DATE2
    VALUE 'A'     MOVE EDITED #DD (EM=MM'/'DD'/'YYYY) TO #DATE2
    VALUE 'E'     MOVE EDITED #DD (EM=DD'/'MM'/'YYYY) TO #DATE2
    VALUE 'G'     MOVE EDITED #DD (EM=DD'.'MM'.'YYYY) TO #DATE2
    NONE IGNORE
  END-DECIDE
END-IF
*
END
