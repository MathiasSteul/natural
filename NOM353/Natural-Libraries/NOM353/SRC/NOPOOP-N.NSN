DEFINE DATA
PARAMETER USING ESMCNT-A
PARAMETER USING ESMINP-A
PARAMETER USING NOPOOP-A
* *****
LOCAL USING EOMPOL-P
LOCAL USING EOMMSG-P
LOCAL USING EOMPHATP
LOCAL USING RTXT---L
LOCAL USING EOMPHTYE
LOCAL USING NADA2000
LOCAL USING NAD-MSG
LOCAL USING NAD-FLD
LOCAL USING NOMODE-A
LOCAL USING RMSPL--L
* *****
LOCAL
1 PRINTOUTS VIEW OF NRM-PRINTOUTS
  2 PO-ID
  2 PO-REPNAME
  2 PO-REPRNB
  2 PO-BUNDLE
  2 PO-BUNDRNB
  2 PO-CREATED
  2 PO-SCHEDULED
  2 PO-PRINTED
  2 PO-USERID
  2 PO-ESY-USERID
  2 C*PO-ATTRIBUTES
  2 PO-ATTRIBUTES      (1:25)
  2 REDEFINE PO-ATTRIBUTES
    3 PO-ATTR          (1:25)
      4 PO-ATTR-IDENT  (I1)
      4 PO-ATTR-LENGTH (N2)
      4 PO-ATTR-PROMPT (N4)
      4 PO-ATTR-VAR    (A16)
      4 PO-ATTR-VALUE  (A72)
  2 PO-FROM-LINE
  2 PO-TO-LINE
  2 PO-LANGUAGE
  2 PO-STATUS
  2 PO-LAST-PRINTED-RECNO
  2 PO-COPIES
  2 PO-PRIORITY
  2 PO-LOGICAL
  2 PO-PHYSICAL-NAME
  2 PO-EXITLIB
  2 PO-EXITMEM
  2 PO-JCL-SKELETON
  2 PO-ESCAPE-CHAR
  2 PO-JOBCARD         (1:3)
  2 PO-JOBNAME
  2 PO-JOBNO
  2 PO-MSG
/*SU4 2 PO-OBJECT-TYPE /*SU2
/*SU4 2 PO-OBJECT-TIME /*SU2
1 PRINTER VIEW OF NRM-PRINTERS
  2 P-NAME
  2 P-VOLSER
  2 P-DSNAME
1 PH VIEW OF NRM-PHYSICAL-PRINTERS
  2 PH-LOCATION
  2 PH-PRINTER-TYPE
1 BC VIEW OF NRM-BUNDLE-CONTENTS
  2 BC-REPRNB
  2 BC-REPNAME
1 MA VIEW OF NRM-MAIL
  2 MA-FO-ID
  2 MA-USERID
1 FOLDER VIEW OF NRM-FOLDER
  2 FO-LINKED-FO-ID            (A10)
  2 REDEFINE FO-LINKED-FO-ID
    3 FO-LINKED-USERID         (A8)
    3 FO-LINKED-ID             (B2)
1 AR VIEW OF NRM-ACTIVE-REPORTS
  2 AR-MASTER-REPNAME
  2 AR-CC-TYPE
  2 AR-SPOOL-ATTRIBUTES
1 REPORTS VIEW OF NRM-REPORTS-NEW
* *****
1 #ES-CONTROL               (A250)
1 #ES-INPUT-AREA            (A253/1:3)
1 #ES-MSG-PREF              (A7) INIT <'NOM'>
1 REDEFINE #ES-MSG-PREF
  2 #ES-MSG-NOM             (A3)
  2 #ES-MSG-NR              (N4)
1 #ES-MSG-FIELD             (A32)
1  REDEFINE #ES-MSG-FIELD
  2 #ES-MSG-FIELD-NAME      (A28)
  2 #ES-MSG-FIELD-INDEX     (N4)
1 #FIX-VAR                  (A1)
1 #OPTIONS                  (A2/10)
1 #I                        (I2)
1 #J                        (I2)
1 #PO-ID                    (N7)
1 #DATE                     (T)
1 #DATE-A8                  (A8)
1 #DATE-OUT                 (A16)
1 REDEFINE #DATE-OUT
  2 #DATE-D                 (A10)
  2 #DATE-T                 (A5)
1 #STATUS-TEXT              (L)
1 #OCC-MAX                  (I2) CONST <25>
1 #USER-LIB                 (A8)
1 #LIBRARY-ID               (A8)
1 #TT                       (T)
1 #OBJECT                   (A25)
1 #BUNDLE-RNB               (A33)
1 REDEFINE #BUNDLE-RNB
  2 #BUNDLE                 (A25)
  2 #RNB                    (P11)
  2 #SEQNO                  (P3)
1 #BUNDLE-RNB-E             (A33)
1 #MA-RNB-USER              (A14)
1 REDEFINE #MA-RNB-USER
  2 #MA-RNB                 (P11)
  2 #MA-USER                (A8)
1 #AR-REPORT-RNB            (A31)
1 REDEFINE #AR-REPORT-RNB
  2 #AR-REPORT              (A25)
  2 #AR-RNB                 (P11)
1 #GR-USERID                (A8)
1 #GR-OBJECT                (A25)
1 #GRANTS                   (A1/6)
1 #GRANTED                  (L)
1 #MA-REP-RNB               (A31)
1 REDEFINE #MA-REP-RNB
  2 #MA-REP                 (A25)
  2 #MA-REPRNB              (P11)
1 #BIN-SIZE                 (I4)
1 #RUN-NUMBER               (P11)
1 #ERC                      (N4)
1 #ERT                      (A250)
1 #RECNUM                   (I4)
1 #SOURCE-EXIST             (L)
1 #A4                       (A4)
1 REDEFINE #A4
  2 #I4                     (I4)
1 #ALL-BIN                  (L)
1 #BROWSE                   (L)
1 #FO-NAME                  (A25)
1 #FO-USER-ID               (A10)
1 REDEFINE #FO-USER-ID
  2 #FO-USER                (A8)
  2 #FO-ID                  (B2)
1 #FO-ID-N                  (N5)
1 REDEFINE #FO-ID-N
  2 #FO-ID-A                (A5)
1 #REP-RNB                  (A31)
1 REDEFINE #REP-RNB
  2 #REPORT                 (A25)
  2 #REPRNB                 (P11)
1 #NATRP-ERC               (N4)                         /* HEB1
1 #NATRP-ERT               (A250)                       /* HEB1
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET ES-RC #TT
#OBJECT := ES-KEY-PARM(1)
#PO-ID := VAL(ES-KEY-PARM(2))
#ES-CONTROL := ES-CONTROL
#ES-INPUT-AREA(*) := ES-INPUT-AREA(*)
NOMOD-PARMS := ES-SELECT
#LIBRARY-ID := ES-APP-SERVER-LIBRARY
DECIDE ON FIRST VALUE OF ES-FUNCTION
  VALUE 'OP'
    DECIDE ON FIRST VALUE OF ES-EXTEND-FUNCTION
      VALUE ' '
        PERFORM READ-RECORD
      VALUE 'UPD'
        PERFORM UPDATE-RECORD
        IF ES-RC = 0
          END TRANSACTION
        END-IF
      VALUE 'MVS' /* Move printer single                /* HEB2 >
        PERFORM MOVE-PRINTOUT
        IF ES-RC = 0
          END TRANSACTION
        END-IF                                          /* HEB2 <
      VALUE 'CHK'
        PERFORM VALIDATION
        IF #ES-MSG-NR NE 0
          PERFORM GET-MSG-TXT
        END-IF
      NONE VALUE IGNORE
    END-DECIDE
  NONE VALUE IGNORE
END-DECIDE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE READ-RECORD
************************************************************************
RESET NOPO-PARMS #ES-MSG-FIELD #ES-MSG-NR
FNDPO. FIND PRINTOUTS  WITH PO-ID = #PO-ID
  IF NO RECORDS FOUND
    #ES-MSG-NR := 2115             /* Printout not exist
    #ES-MSG-FIELD-NAME := 'ID'
    ESCAPE BOTTOM (FNDPO.)
  END-NOREC
  NOPO-ID             := PO-ID
  NOPO-ATTRIBUTES-OCC := C*PO-ATTRIBUTES
  FOR #J = 1 TO NOPO-ATTRIBUTES-OCC
    NOPO-ATTR-IDENT(#J)  := PO-ATTR-IDENT(#J)
    NOPO-ATTR-LENGTH(#J) := PO-ATTR-LENGTH(#J)
    NOPO-ATTR-PROMPT(#J) := PO-ATTR-PROMPT(#J)
    NOPO-ATTR-VAR(#J)    := PO-ATTR-VAR(#J)
    NOPO-ATTR-VALUE(#J)  := PO-ATTR-VALUE(#J)
    #ES-MSG-NR := NOPO-ATTR-PROMPT(#J)
    #STATUS-TEXT := TRUE
    PERFORM GET-MSG-TXT
    NOPO-ATTR-NAME(#J) := SHORT-MSG
    RESET #STATUS-TEXT #ES-MSG-NR
  END-FOR
  RESET ES-RC #ES-MSG-NR
    #ERC #ERT #BIN-SIZE
  NOPO-OBJECT := #OBJECT
  IF PO-BUNDLE > ' '
    NOPO-RNB          := PO-BUNDRNB
    NOPO-TYPE         := 'B'
  ELSE
    NOPO-RNB          := PO-REPRNB
    NOPO-TYPE         := 'R'
  END-IF
  NOPO-USERID         := PO-USERID
  NOPO-ESY-USERID     := PO-ESY-USERID
  #DATE := PO-CREATED
  PERFORM DATE-CONVERSION
  NOPO-CREATED := #DATE-OUT
  #DATE := PO-SCHEDULED
  PERFORM DATE-CONVERSION
  NOPO-SCHEDULED := #DATE-OUT
  IF PO-STATUS NE 'E'
    #DATE := PO-PRINTED
    PERFORM DATE-CONVERSION
    NOPO-PRINTED := #DATE-OUT
  ELSE
    RESET NOPO-PRINTED
  END-IF
  NOPO-STATUS  := PO-STATUS
  PERFORM GET-STATUS-TEXT
  PERFORM CHECK-BINARY-FILES
  IF NOPO-BINARY = 'X'                              /* binary object
    PERFORM GET-BINARY-SIZE
    IF #ERC = 0
      NOPO-TOTAL-LINES := #BIN-SIZE
    ELSE
      RESET NOPO-TOTAL-LINES
    END-IF
  ELSE
    EOMPOL-FROM-LINE := PO-FROM-LINE
    EOMPOL-TO-LINE   := PO-TO-LINE
    EOMPOL-BUNDLE    := PO-BUNDLE
    EOMPOL-REPORT    := PO-REPNAME
    IF PO-BUNDLE > ' '
      EOMPOL-RNB := PO-BUNDRNB
    ELSE
      EOMPOL-RNB := PO-REPRNB
    END-IF
    CALLNAT 'EOMPOL-N' EOMPOL-PARMS
    NOPO-TOTAL-LINES := EOMPOL-TOTAL-LINES
  END-IF
  NOPO-LAST-PRINTED-RECNO := PO-LAST-PRINTED-RECNO
  NOPO-LANGUAGE           := PO-LANGUAGE
  NOPO-PRINT-COPIES       := PO-COPIES
  NOPO-PRIORITY           := PO-PRIORITY
  NOPO-LOGICAL            := PO-LOGICAL
  FIND (1) PRINTER WITH P-ID = PO-LOGICAL
    NOPO-LOGICAL-DESC := P-NAME
  END-FIND
  NOPO-PHYSICAL-NAME   := PO-PHYSICAL-NAME
  FIND (1) PH WITH PH-VTAMID = PO-PHYSICAL-NAME
    DECIDE ON FIRST VALUE OF PO-PHYSICAL-NAME
      VALUE 'TAPE'
        NOPO-LOCATION := P-VOLSER
      VALUE 'DISK'
        NOPO-LOCATION := P-DSNAME
      VALUE 'SYSPRINT'
        NOPO-LOCATION := 'MAIN SYSTEM PRINTER'
      NONE VALUE
        NOPO-LOCATION := PH.PH-LOCATION
    END-DECIDE
  END-FIND
  NOPO-EXITLIB         := PO-EXITLIB
  NOPO-EXITMEM         := PO-EXITMEM
  NOPO-JCL-SKELETON    := PO-JCL-SKELETON
  NOPO-ESCAPE-CHAR     := PO-ESCAPE-CHAR
  NOPO-JOBCARD    (*)  := PO-JOBCARD   (*)
/* for list
  IF NOPO-LAST-PRINTED-RECNO > 0
    NOPO-LINES := NOPO-LAST-PRINTED-RECNO
  ELSE
    NOPO-LINES := NOPO-TOTAL-LINES
  END-IF
  NOPO-JOBNAME         := PO-JOBNAME
  NOPO-JOBNO           := PO-JOBNO
  PERFORM GET-OPTIONS
  NOPO-OPTIONS(*) := #OPTIONS(*)
END-FIND
IF #ES-MSG-NR NE 0
  PERFORM GET-MSG-TXT
END-IF
*
END-SUBROUTINE /* READ-RECORD
*
************************************************************************
DEFINE SUBROUTINE UPDATE-RECORD
************************************************************************
FNDMOD. FIND PRINTOUTS WITH PO-ID = #PO-ID
  IF NO RECORDS FOUND
    #ES-MSG-NR := 2115
    #ES-MSG-FIELD-NAME := 'ID'
    ESCAPE BOTTOM (FNDMOD.)
  END-NOREC
  FIND (1) PH WITH PH-VTAMID = NOPO-PHYSICAL-NAME
  END-FIND
  PERFORM VALIDATION
  ES-CONTROL := #ES-CONTROL
  ES-INPUT-AREA(*) := #ES-INPUT-AREA(*)
  IF #ES-MSG-NR = 0
    GETMOD. GET PRINTOUTS *ISN(FNDMOD.)
    PO-LANGUAGE           := NOPO-LANGUAGE
    PO-COPIES             := NOPO-PRINT-COPIES        /* modifiable
    PO-PRIORITY           := NOPO-PRIORITY            /* modifiable
    PO-ATTR-VALUE(*)      := NOPO-ATTR-VALUE(*)
    PO-ESCAPE-CHAR        := NOPO-ESCAPE-CHAR         /* modifiable
    PO-JCL-SKELETON       := NOPO-JCL-SKELETON        /* modifiable
    PO-JOBCARD     (*)    := NOPO-JOBCARD     (*)     /* modifiable
/* translate attributes to upper case
    EXAMINE ##PHYS-TYPES (*) FOR PH.PH-PRINTER-TYPE GIVING INDEX #I
    IF NOT ##PHYS-TYPE-LOWER (#I)
      EXAMINE NOPO-ATTR-VAR (*) TRANSLATE INTO UPPER
      EXAMINE NOPO-ATTR-VALUE (*) TRANSLATE INTO UPPER
    END-IF
    PERFORM CHECK-BINARY-FILES
    IF NOPO-BINARY = 'X'
      PERFORM GET-BINARY-SIZE
    END-IF
    IF NOPO-LAST-PRINTED-RECNO > 0
      NOPO-LINES := NOPO-LAST-PRINTED-RECNO
    ELSE
      NOPO-LINES := NOPO-TOTAL-LINES
    END-IF
    PERFORM GET-OPTIONS
    NOPO-OPTIONS(*) := #OPTIONS(*)
/*SU5 PO-OBJECT-TYPE := 'PO' /*SU2
/*SU4 PO-OBJECT-TIME := *TIMX /*SU2
    UPDATE (GETMOD.)
  END-IF
END-FIND
IF #ES-MSG-NR NE 0
  PERFORM GET-MSG-TXT
END-IF
*
END-SUBROUTINE /* UPDATE-RECORD
*
************************************************************************
DEFINE SUBROUTINE MOVE-PRINTOUT                         /* HEB2 added
************************************************************************
FNDMVS. FIND PRINTOUTS WITH PO-ID = #PO-ID
  IF NO RECORDS FOUND
    #ES-MSG-NR := 2115
    #ES-MSG-FIELD-NAME := 'ID'
    ESCAPE BOTTOM (FNDMVS.)
  END-NOREC
  ES-CONTROL := #ES-CONTROL
  ES-INPUT-AREA(*) := #ES-INPUT-AREA(*)
  GETMVS. GET PRINTOUTS *ISN(FNDMVS.)
    PO-LOGICAL := ES-KEY-PARM(3)
    UPDATE (GETMVS.)
END-FIND
IF #ES-MSG-NR NE 0
  PERFORM GET-MSG-TXT
END-IF
*
END-SUBROUTINE /* MOVE-PRINTOUT
*
************************************************************************
DEFINE SUBROUTINE VALIDATION /* Check Special Printer Attributes
************************************************************************
RESET #STATUS-TEXT
FIND PH WITH PH-VTAMID = NOPO-PHYSICAL-NAME
END-FIND
EOMPHAT-ATTR-IDENT  (*) := NOPO-ATTR-IDENT (*)
EOMPHAT-ATTR-LENGTH (*) := NOPO-ATTR-LENGTH(*)
EOMPHAT-ATTR-PROMPT (*) := NOPO-ATTR-LENGTH(*)
EOMPHAT-ATTR-VAR    (*) := NOPO-ATTR-VAR   (*)
EOMPHAT-ATTR-DEFAULT(*) := NOPO-ATTR-VALUE (*)
CALLNAT 'EOMPHATN' PH.PH-PRINTER-TYPE       /*the same as in printer def
  #OCC-MAX EOMPHAT-ATTRIBUTES(*) EOMMSG-PARMS
IF EOMMSG-NR NE 0
  #ES-MSG-NR := 0125   /* attribute has incorect value
  #ES-MSG-FIELD-NAME := 'ATTR'
  #ES-MSG-FIELD-INDEX := EOMMSG-IND1
  ESCAPE ROUTINE
END-IF
FOR #I 1 25
  IF NOPO-ATTR-VAR (#I) = ' '
    ESCAPE TOP
  END-IF
  IF NOPO-ATTR-VAR     (#I) = 'RECFM'
    #FIX-VAR := NOPO-ATTR-VALUE (#I)
  END-IF
  IF NOPO-ATTR-VAR     (#I) = 'WKF'
    IF #FIX-VAR = 'V'
      NOPO-ATTR-VALUE (#I) := '01'
    ELSE
      NOPO-ATTR-VALUE (#I) := '02'
    END-IF
  END-IF
END-FOR
/* as in physical printer definition
COMPRESS #LIBRARY-ID 'U' TO #USER-LIB LEAVING NO
IF PH.PH-PRINTER-TYPE =##PHYS-VTAM OR=##PHYS-CMASPOOL OR=##PHYS-NAF
OR=##PHYS-UNIXLP OR=##PHYS-NATUNIX OR=##PHYS-EMAIL OR=##PHYS-WRTSPOOL /*
OR=##PHYS-DISKUNIX                                                    /*
  DECIDE FOR EVERY CONDITION
    WHEN NOPO-JCL-SKELETON > ' '
      #ES-MSG-NR := 0184      /* skeleton not need for this printer type
      #ES-MSG-FIELD-NAME := 'JCL-SKELETON'
      ESCAPE ROUTINE
    WHEN NOPO-ESCAPE-CHAR > ' '
      #ES-MSG-NR := 0185      /* Escape char not necessary
      #ES-MSG-FIELD-NAME := 'ESCAPE-CHAR'
    WHEN ANY
      ESCAPE ROUTINE
    WHEN NONE IGNORE
  END-DECIDE
ELSE
  IF NOPO-JCL-SKELETON > ' '
    ES-KEY-PARM(1) := #USER-LIB
    ES-KEY-PARM(2) := NOPO-JCL-SKELETON
    CALLNAT 'NOSFEX-N' ES-CONTROL ES-INPUT
    IF ES-RC NE 0
      #ES-MSG-NR := 0117             /* 'Skeleton does not exist'
      #ES-MSG-FIELD-NAME := 'JCL-SKELETON'
      ESCAPE ROUTINE
    END-IF
  ELSE
    #ES-MSG-NR := 0127            /* skeleton required
    #ES-MSG-FIELD := 'JCL-SKELETON'
    ESCAPE ROUTINE
  END-IF
  IF NOPO-ESCAPE-CHAR = ' ' OR = MASK (A) OR = MASK (N)
    #ES-MSG-NR := 0115               /* 'Invalid escape char'
    #ES-MSG-FIELD-NAME := 'ESCAPE-CHAR'
    ESCAPE ROUTINE
  END-IF
END-IF
*
END-SUBROUTINE /* VALIDATION
*
************************************************************************
DEFINE SUBROUTINE CHECK-BINARY-FILES
************************************************************************
RESET #AR-REPORT-RNB #BUNDLE-RNB NOPO-BINARY #SPOOL-ATTRIBUTES #ALL-BIN
IF PO-REPNAME NE ' '
  #AR-REPORT  := PO-REPNAME
  #AR-RNB     := PO-REPRNB
  FIND AR WITH AR-REPORT-RNB = #AR-REPORT-RNB
    IF AR-CC-TYPE = 0005       /* binary
      NOPO-BINARY := 'X'       /* mark binary objects
      #SPOOL-ATTRIBUTES := AR-SPOOL-ATTRIBUTES
    END-IF
  END-FIND
ELSE
  #ALL-BIN := TRUE
  #BUNDLE  := PO-BUNDLE
  #RNB     := PO-BUNDRNB
  #SEQNO   := 999
  #BUNDLE-RNB-E := #BUNDLE-RNB
  RESET #SEQNO
  FNDBC. FIND BC WITH BC-BUNDLE-RNB = #BUNDLE-RNB THRU #BUNDLE-RNB-E
    #AR-REPORT  := BC-REPNAME
    #AR-RNB     := BC-REPRNB
    FIND AR WITH AR-REPORT-RNB = #AR-REPORT-RNB
      IF AR-CC-TYPE NE 0005      /* binary
        RESET NOPO-BINARY #ALL-BIN
      ELSE
        NOPO-BINARY := 'X'
        ESCAPE BOTTOM(FNDBC.)    /* raya    2013-03-03 nomall-1233 in
      END-IF
    END-FIND
  END-FIND
END-IF
*
END-SUBROUTINE /* CHECK-BINARY-FILES
*
************************************************************************
DEFINE SUBROUTINE GET-BINARY-SIZE
************************************************************************
RESET #BIN-SIZE #ERC #ERT #RECNUM
IF NOPO-TYPE = 'B'
  PERFORM BIN-SIZE
ELSE
  IF NOT (#SPOOL-DI-SIZE = #I4 OR = 0)
*   #BIN-SIZE := #SPOOL-DI-SIZE / 1024 + 1
* fhi     2015-05-18 NOMALL-1552 line above out, below in
/*SU2 #BIN-SIZE := (#SPOOL-DI-SIZE / 1024 + 1) * 3 / 4
    #BIN-SIZE := (#SPOOL-DI-SIZE / 1024) * 3 / 4 + 1 /*SU2
  ELSE
    PERFORM BIN-SIZE
  END-IF
END-IF
*
END-SUBROUTINE /* GET-BINARY-SIZE
*
************************************************************************
DEFINE SUBROUTINE BIN-SIZE
************************************************************************
#RUN-NUMBER := NOPO-RNB
CALLNAT 'RBINSZ-N' NOPO-OBJECT #RUN-NUMBER NOPO-TYPE #RECNUM
  #BIN-SIZE #ERC #ERT
IF #BIN-SIZE NE 0 AND #ERC = 0
  IF NOPO-TYPE = 'R'
    #SPOOL-DI-SIZE := #BIN-SIZE
  END-IF
  #BIN-SIZE := #BIN-SIZE / 1024 + 1
END-IF
*
END-SUBROUTINE /* BIN-SIZE
*
************************************************************************
DEFINE SUBROUTINE DATE-CONVERSION
************************************************************************
IF #DATE NE #TT
  MOVE EDITED #DATE (EM=YYYYMMDD) TO #DATE-A8
  MOVE EDITED #DATE (EM=HH':'II) TO #DATE-T
  CALLNAT 'NODATF-N' #DATE-A8 #DATE-D ES-DATE-FORMAT
ELSE
  RESET #DATE-OUT
END-IF
*
END-SUBROUTINE /* DATE-CONVERSION
*
************************************************************************
DEFINE SUBROUTINE GET-STATUS-TEXT
************************************************************************
DECIDE ON FIRST VALUE OF PRINTOUTS.PO-STATUS
  VALUE 'R' #ES-MSG-NR := ##TXT-READY-TO-PRINT
  VALUE 'X' #ES-MSG-NR := ##TXT-EXTERNAL-OK
  VALUE 'H' #ES-MSG-NR := ##TXT-HOLD
  VALUE 'C' #ES-MSG-NR := ##TXT-CONFIRMATION-REQUIRED
  VALUE 'S' #ES-MSG-NR := ##TXT-PRINTER-STOPPED
  VALUE 'T'
    IF PRINTOUTS.PO-MSG = MASK(NNNN) AND PRINTOUTS.PO-MSG IS (N4)
      #ES-MSG-NR := VAL (PRINTOUTS.PO-MSG)
    ELSE
      #ES-MSG-NR := ##TXT-PRINTER-IS-BUSY
    END-IF
  VALUE 'A'
    IF PRINTOUTS.PO-MSG = MASK(NNNN)
      #ES-MSG-NR := VAL(PRINTOUTS.PO-MSG)
    END-IF
  VALUE 'P'
    IF PRINTOUTS.PO-MSG = MASK(NNNN) AND PRINTOUTS.PO-MSG IS (N4)
      #ES-MSG-NR := VAL (PRINTOUTS.PO-MSG)
    ELSE
      #ES-MSG-NR := ##TXT-SENT-TO-PRINTER
    END-IF
  VALUE 'D'
    IF PO-MSG NE ' '   /* leave msg from bundle print exit
      RESET #ES-MSG-NR
      NOPO-MSG := PRINTOUTS.PO-MSG
    ELSE
      #ES-MSG-NR := ##TXT-PRINTED-SUCCESSFULLY
    END-IF
  VALUE 'F'
    IF PRINTOUTS.PO-MSG = MASK(NNNN) AND PRINTOUTS.PO-MSG IS (N4)
      #ES-MSG-NR := VAL(PRINTOUTS.PO-MSG)
    ELSE
      NOPO-MSG := PRINTOUTS.PO-MSG
    END-IF
  VALUE 'E'
    IF PRINTOUTS.PO-MSG = MASK(NNNN) AND PRINTOUTS.PO-MSG IS (N4)
      #ES-MSG-NR := VAL(PRINTOUTS.PO-MSG)
    ELSE
      NOPO-MSG := PRINTOUTS.PO-MSG
    END-IF
  ANY VALUE
    IF #ES-MSG-NR NE 0               /* instead
      #STATUS-TEXT := TRUE
      PERFORM GET-MSG-TXT
      NOPO-MSG := SHORT-MSG
      EXAMINE NOPO-MSG FOR #ES-MSG-PREF DELETE
    END-IF
  NONE VALUE IGNORE
END-DECIDE
RESET #STATUS-TEXT #ES-MSG-NR
*
END-SUBROUTINE /* GET-STATUS-TEXT
*
************************************************************************
DEFINE SUBROUTINE GET-OPTIONS
************************************************************************
RESET #OPTIONS(*)
      #NATRP-ERC #NATRP-ERT                             /* HEB1
IF NOT (NOPO-STATUS = 'H' OR = 'R')
  #OPTIONS(1) := 'OP'
END-IF
IF NOPO-TYPE = 'B' OR NOPO-STATUS NE 'E'
  #OPTIONS(2) := 'RE'
END-IF
IF NOPO-TYPE =  'R'
  #OPTIONS(3) := 'LB'
  CALLNAT 'NOSRCK-N' PO-REPNAME PO-REPRNB #SOURCE-EXIST
          #NATRP-ERC #NATRP-ERT ES-USER (AD=O)          /* HEB1
          ES-APP-SERVER-LIBRARY (AD=O)                  /* HEB1
  IF #NATRP-ERC NE 0                                    /* HEB1 >
    ES-RC := 1
    ES-MSG-NR := #NATRP-ERC
    ES-MSG-TXT := #NATRP-ERT
    ESCAPE MODULE
  END-IF                                                /* HEB1 <
*
  IF NOT #SOURCE-EXIST
    #OPTIONS(4) := 'BB'
  END-IF
  IF NOPO-BINARY = 'X' AND NOPO-LINES = 0
    #OPTIONS(5) := 'BB'
  END-IF
ELSE
  #OPTIONS(3) := 'BB'
  #BUNDLE-RNB.#BUNDLE := PO-BUNDLE
  #BUNDLE-RNB.#RNB := PO-BUNDRNB
  #BUNDLE-RNB.#SEQNO := 999
  #BUNDLE-RNB-E := #BUNDLE-RNB
  RESET #BUNDLE-RNB.#SEQNO
  FNDBC1. FIND BC WITH BC-BUNDLE-RNB = #BUNDLE-RNB THRU #BUNDLE-RNB-E
    IF NO RECORDS FOUND
      #OPTIONS(4) := 'LB'
      ESCAPE BOTTOM(FNDBC1.)
    END-NOREC
    IF ES-USER-TYPE NE 'A'
      #MA-USER := ES-USER
      #MA-RNB  := BC-REPRNB
      #MA-REP  := BC-REPNAME
      #MA-REPRNB := BC-REPRNB
      FMA. FIND NUMBER MA WITH MA-RNB-USER = #MA-RNB-USER
        AND MA-REP-RNB = #MA-REP-RNB
      IF *NUMBER(FMA.) = 0
        #GR-OBJECT := BC-REPNAME
        RP. FIND NUMBER REPORTS WITH R-REPNAME = BC-REPNAME
        IF *NUMBER(RP.) = 0
          #AR-REPORT := BC-REPNAME
          #AR-RNB    := BC-REPRNB
          FIND AR WITH AR-REPORT-RNB = #AR-REPORT-RNB
            #GR-OBJECT := AR-MASTER-REPNAME
          END-FIND
        END-IF
        CALLNAT 'NOGROU-N' 'R' #GR-OBJECT ES-USER #GR-USERID #GRANTS(*)
*       IF NOT (#GRANTS(1:4) = 'Y')
* fhi     2016-01-20 NOMALL-1465 line above out, below in
        IF #GRANTS(1) NE 'Y' AND #GRANTS(4) NE 'Y'
          #GRANTED := FALSE
        ELSE
          #GRANTED := TRUE
          ESCAPE BOTTOM(FNDBC1.)
        END-IF
      ELSE
        #GRANTED := TRUE
        ESCAPE BOTTOM(FNDBC1.)
      END-IF
    END-IF
  END-FIND
  IF ES-USER-TYPE NE 'A' AND NOT #GRANTED
    #OPTIONS(5) := 'LB'
  END-IF
END-IF
IF NOPO-STATUS = 'H'
  #OPTIONS(6) := 'HL'
ELSE
  #OPTIONS(7) := 'RL'
END-IF
*
PERFORM CHECK-FOLDER-GRANTS
/*IF NOT #BROWSE                                 /* CF1 ->
/*  #OPTIONS(8) := 'BB'
/*END-IF                                         /* CF1 <-
*
END-SUBROUTINE /* GET-OPTIONS
*
************************************************************************
DEFINE SUBROUTINE CHECK-FOLDER-GRANTS
************************************************************************
RESET #BROWSE
IF NOPO-TYPE = 'B' OR ES-USER-TYPE = 'A'
  ESCAPE ROUTINE
END-IF
*
#REPORT := PO-REPNAME
#REPRNB := PO-REPRNB
MA1. FIND MA WITH MA-REP-RNB = #REP-RNB
  RESET #GRANTS(*) #GR-USERID
  DECIDE FOR FIRST CONDITION
/* mailed to es-user  own folder
    WHEN MA-USERID = ES-USER  AND MA-FO-ID = 0001
      #BROWSE := TRUE
/* mailed to es-user , to linked folder
    WHEN MA-USERID = ES-USER  AND MA-FO-ID NE 0001
      #FO-ID   := MA-FO-ID
      #FO-USER := MA-USERID
      FIND FOLDER WITH FO-USER-FO-ID = #FO-USER-ID
        #FO-ID-N := FO-LINKED-ID
        COMPRESS FO-LINKED-USERID #FO-ID-A TO #FO-NAME LEAVING NO
        CALLNAT 'NOGROU-N' 'F' #FO-NAME ES-USER #GR-USERID #GRANTS(*)
*       IF NOT (#GRANTS(1:4) = 'Y')
* fhi     2016-01-20 NOMALL-1465 line above out, below in
        IF #GRANTS(1) NE 'Y' AND #GRANTS(4) NE 'Y'
          #BROWSE := FALSE
        ELSE
          #BROWSE := TRUE
        END-IF
      END-FIND
/* mailed not to es-user , but contains in linked folder
    WHEN MA-USERID NE ES-USER  AND MA-FO-ID = 0001
      #FO-ID-N := MA-FO-ID
      COMPRESS MA-USERID #FO-ID-A TO #FO-NAME LEAVING NO
      CALLNAT 'NOGROU-N' 'F' #FO-NAME ES-USER #GR-USERID #GRANTS(*)
*     IF NOT (#GRANTS(1:4) = 'Y')
* fhi     2016-01-20 NOMALL-1465 line above out, below in
      IF #GRANTS(1) NE 'Y' AND #GRANTS(4) NE 'Y'
        #BROWSE := FALSE
      ELSE
        #BROWSE := TRUE
      END-IF
    WHEN NONE IGNORE
  END-DECIDE
  IF #BROWSE
    ESCAPE BOTTOM(MA1.)
  END-IF
END-FIND
IF NOT #BROWSE                                   /* CF1 ->
  #OPTIONS(8) := 'BB'
END-IF                                           /* CF1 <-
*
END-SUBROUTINE /* CHECK-FOLDER-GRANTS
*
/*SU5 DEFINE SUBROUTINE CHECK-SOURCE
*
************************************************************************
DEFINE SUBROUTINE GET-MSG-TXT
************************************************************************
RESET SHORT-MSG LONG-MSG(*)
VERSION := 0
NADA2000.OBJECT-KIND := 'U'
NADA2000.ERROR-NUMBER := #ES-MSG-NR
NADA2000.OPT-INSERT-DYN := FALSE
NADA2000.OPT-LANGUAGE := ES-LANGUAGE
NADA2000.LIBRARY := #LIBRARY-ID         /*'NOM221'
CALLNAT 'NATA2000' NADA2000 NATA2000.EXTENDED-PARMS NAD-MSG NAD-FLD
IF NOT #STATUS-TEXT
  ES-MSG-NR    := #ES-MSG-NR
  ES-MSG-TXT   := SHORT-MSG
  EXAMINE ES-MSG-TXT FOR #ES-MSG-PREF DELETE
  EXAMINE ES-MSG-TXT FOR ':1:' REPLACE ' '
  EXAMINE ES-MSG-TXT FOR ':2:' REPLACE ' '
  ES-MSG-FIELD := #ES-MSG-FIELD
  ES-RC := 1
END-IF
*
END-SUBROUTINE /* GET-MSG-TXT
**--------------------------------------------------------------------
END
