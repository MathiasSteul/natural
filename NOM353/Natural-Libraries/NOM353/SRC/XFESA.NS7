* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
************************************************************************
* Function  Check if not is ESA (ESM Adapter node)
*           Invoke via: F#ESA (<node>)
*
* Maintenance
* uuuuuu  yyyy-mm-dd iTrac       Remark
* SU11    2021-10-12 ES-31134    Created
* ----------------------------------------------------------------------
*
DEFINE FUNCTION F#ESA  RETURNS #IS-ESA (L)
  DEFINE DATA PARAMETER
  1 #NODE (N5) BY VALUE
************************************************************************
  LOCAL
  1 SYSTEM-INFO VIEW OF SYSTEM-INFO
    2 MODE (A8)
    2 ERROR-CODE
    2 ERROR-TEXT
*
* *****
  END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
SI. FIND SYSTEM-INFO WITH NODE = #NODE
  IF ERROR-CODE > 0
    PRINT *DAT4I *TIME(AL=8) 'node:' #NODE ERROR-CODE ERROR-TEXT
  END-IF
  IF MODE = 'ADAPTER' /* =ESA(ESM Adapter
    #IS-ESA := TRUE
  END-IF
END-FIND
*
END-FUNCTION /*F#ESA
*
END
