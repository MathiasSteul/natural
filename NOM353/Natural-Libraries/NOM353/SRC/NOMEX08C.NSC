* NOMEX08C - Copycode to invoke NOMEX008 with status function
*
* Maintenance
* jwo 97-11-13 p(167263) created
* ----------------------------------------------------------------------
RESET NOMEX008-PARMS (1) NOMEX008-ERROR-CODE NOMEX008-FROMLINE
      NOMEX008-TOLINE NOMEX008-RECORD-LENGTH NOMEX008-NODE
*
NOMEX008-FUNCTION := NOMEX008-FCT-GET-STATUS
NOMEX008-REPNAME  := ACTIVE-REPORT.AR-REPNAME
NOMEX008-REPRNB   := ACTIVE-REPORT.AR-REPRNB
NOMEX008-MAXREC   := ACTIVE-REPORT.AR-NUMBER-OF-LINES
NOMEX008-NODE     := G-MONITOR-NODE
NOMEX008-USER     := G-USERID
NOMEX008-USER-TYPE:= G-USER-TYPE
*
CALLNAT 'NOMEX008' NOMEX008-PARMS(*)
** End of CC NOMEX08C **************************************************
