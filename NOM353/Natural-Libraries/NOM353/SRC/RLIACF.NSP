        5 #T-USER-ID       (A8)
        5 #T-FO-ID         (B2)
        5 #T-INV-TIME      (P13)
      4 #T-RNB             (P11)
    3 REDEFINE #T-KEY
      4 #T-SOURCE          (A16)
      4 #T-SENDER          (A16)
      4 #T-TIM-INV         (P13)
      4 #T-AR-ACTIVE       (A1)
    3 #L-KEY               (A42)
    3 REDEFINE #L-KEY
      4 #L-FOLDER          (A10)
      4 #L-REPNAME         (A25)
      4 #L-TIME-INV        (P13)
    3 REDEFINE #L-KEY
      4 #L-KEY2            (A17)
      4 REDEFINE #L-KEY2
        5 #L-USER-ID       (A8)
        5 #L-FO-ID         (B2)
        5 #L-INV-TIME      (P13)
      4 #L-RNB             (P11)
    3 REDEFINE #L-KEY
