END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
PERFORM RMGTRACO-GET-SETTINGS #TRACING
DEFINE WINDOW WARNING
*
#PROG := *PROGRAM
PERFORM XXSECURITY-CHECK #PROG G-C-OBJNAME #ALLOWED
INCLUDE C-NALLOW
*
CALLNAT 'NARPSEC' G-USER-PROFILE 'MAC' #UPDATE
CALLNAT 'NARPSEC' G-USER-PROFILE 'PAC' #DELETE
CALLNAT 'NARPSEC' G-USER-PROFILE 'ARC' #ARCHIVE
CALLNAT 'NARPSEC' G-USER-PROFILE 'REV' #REVIVE
*
RESET  G-C-OBJNAME
G-C-OBJTYPE := 'AR'
*
*
PERFORM INIT-TEXT
#USERID := *USER
FIND USERS WITH USER-ID = #USERID
END-FIND
IF PROF-AR-SORT = ' '
  PROF-AR-SORT := 'N'
END-IF
*
#PANEL := 2
INPUT #S-USER-ID #S-FO-ID #PANEL #S-KEYWORD (*) #S-AND /*8 SU6
#O-REPNAME := #S-REPNAME
#PAGE := 1
PERFORM INITIALISATION
GET-SCREEN := TRUE
#DEF-LOC := #S-LOCATION
DECIDE FOR FIRST CONDITION
  WHEN  #S-SOURCE-SENDER NE ' '
    #START-SOURCE  := #F-SOURCE(1)
    #START-SENDER  := #F-SENDER(1)
    #START-TIM-INV := #F-TIM-INV(1)
  WHEN (#S-REPNAME = ' ' OR = '*') OR PROF-AR-SORT = 'D'
    #START-USER-ID := #F-USER-ID(1)
    #START-FO-ID   := #F-FO-ID(1)
    #START-INV-TIME := #F-INV-TIME(1)
  WHEN PROF-AR-SORT NE 'D' AND NOT (#S-REPNAME = ' ' OR = '*')
    #START-TIME-INV := #F-TIME-INV(1)
    #START-REPNAME  := #F-REPNAME(1)
    #START-FOLDER   := #F-FOLDER(1)
  WHEN NONE IGNORE
END-DECIDE
IF #PANEL = 0
  #PANEL := 2
END-IF
/*SU6 #L-KEYWORD := #S-KEYWORD
/*SU6 EXAMINE #L-KEYWORD '*' GIVING POSITION IN #K-LEN IF #K-LEN > 0
/*SU6 RESET #L-KEYWORD-V (#K-LEN:15) SUBTRACT 1 FROM #K-LEN END-IF
FOR #I-KY=1 TO 4 /*SU6
  CALLNAT 'SELALPHA' #S-KEYWORD (#I-KY) #F-KY (#I-KY) #T-KY(#I-KY) #L-15
END-FOR
IF #S-EXPDATE NE ' '
  CALLNAT 'IODATE-N' 'M' 'L' #S-EXPDATE #L-EXPDATE G-DATE-FORMAT
    #ERROR-CODE #ERROR-TEXT
  IF #ERROR-CODE NE 0
    #S-EXPDATE := #L-EXPDATE := ' '
  ELSE
    #O-EXPDATE := #L-EXPDATE
  END-IF
END-IF
DECIDE FOR EVERY CONDITION
  WHEN #S-REPNAME = ' ' AND +G-RLIACF-SEL-REPNAME NE ' '
    #S-REPNAME := +G-RLIACF-SEL-REPNAME
    #O-REPNAME := #S-REPNAME
  WHEN #S-ARCHIVE-FLAG = ' '
      AND +G-RLIACF-SEL-ARC-FLAG NE ' '
    #S-ARCHIVE-FLAG := +G-RLIACF-SEL-ARC-FLAG
    #O-ARCHIVE-FLAG := #S-ARCHIVE-FLAG
    #PANEL := 3
  WHEN #S-REVIVE-FLAG = ' '
      AND +G-RLIACF-SEL-REV-FLAG NE ' '
    #S-REVIVE-FLAG := +G-RLIACF-SEL-REV-FLAG
    #O-REVIVE-FLAG := #S-REVIVE-FLAG
    #PANEL := 3
  WHEN ANY
    PERFORM INITIALISATION
    GET-SCREEN := TRUE
  WHEN NONE
    IGNORE
END-DECIDE
* --------------------------------------- main -------------------------
MAIN. REPEAT
  UNTIL END-OF-PROCESSING
  IF GET-SCREEN
    PERFORM GET-SCREEN
    RESET GET-SCREEN NEW-SEARCH
  END-IF
  PERFORM SCREEN-IO
END-REPEAT
INCLUDE C-ESCAPE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE GET-SCREEN
************************************************************************
#PREV-RNB(*):= L-RNB(*)
RESET #I L-SCR (*)
IF #PAGE > #MAXAP
  #MAXAP := #PAGE
END-IF
RESET #SCAN-RECORDS
/*SU6 #SCAN-TIME := *TIMX
DECIDE FOR FIRST CONDITION
  WHEN #S-SOURCE-SENDER NE ' '
    PERFORM GET-SCREEN-OPO-REPORTS
  WHEN (#S-REPNAME = ' ' OR = '*') OR PROF-AR-SORT = 'D'
    PERFORM GET-SCREEN-FOLDER-TIME
  WHEN NOT (#S-REPNAME = ' ' OR = '*') AND PROF-AR-SORT NE 'D'
    PERFORM GET-SCREEN-FOLDER-REP-TIME
  WHEN NONE IGNORE
END-DECIDE
*
END-SUBROUTINE /* GET-SCREEN
*
************************************************************************
DEFINE SUBROUTINE GET-SCREEN-OPO-REPORTS
************************************************************************
GET-SCREEN-OPO. REPEAT
  RDAR. READ ACTIVE-REPORT BY AR-SOURCE-SENDER-TIME-INV = #F-KEY (#PAGE)
    #L-SOURCE  := AR-SOURCE
    #L-SENDER  := AR-SENDER
    #L-TIM-INV := AR-PROCESS-TIME-INV
    IF  #S-SOURCE-SENDER > ' ' AND AR-SOURCE > #T-SOURCE
      ESCAPE BOTTOM (RDAR.)
    END-IF
    IF #I >= #NOFLINES
      ESCAPE BOTTOM (GET-SCREEN-OPO.)
    END-IF
    SELECTED := TRUE
    PERFORM CHECK-MAIL
    IF #MAILED
      PERFORM SELECT-RECORD
      IF SELECTED
        ADD 1 TO #I
        PERFORM DATA-TO-SCREEN
      END-IF
    END-IF
  END-READ
  END-OF-DATA := TRUE
  ESCAPE BOTTOM (GET-SCREEN-OPO.)
END-REPEAT
*
END-SUBROUTINE /* GET-SCREEN-OPO-REPORTS
*
************************************************************************
DEFINE SUBROUTINE CHECK-MAIL
************************************************************************
#MAILED := TRUE
#MA-USER := #S-USER-ID
#MA-RNB  := ACTIVE-REPORT.AR-REPRNB
*
FDMA. FIND MAIL WITH MA-REP-RNB = ACTIVE-REPORT.AR-REPORT-RNB
AND MA-RNB-USER = #MA-RNB-USER                                        /*
  IF NO RECORDS FOUND
    RESET #MAILED
    ESCAPE BOTTOM(FDMA.)
  END-NOREC
  IF MA-USERID NE #S-USER-ID AND MA-FO-ID NE #S-FO-ID
    RESET #MAILED
  END-IF
END-FIND
*
END-SUBROUTINE /* CHECK-MAIL
*
************************************************************************
DEFINE SUBROUTINE GET-SCREEN-FOLDER-TIME
************************************************************************
RESET #L-KEY #L-TIME-INV #L-INV-TIME #L-TIM-INV #L-RNB
*
GET-SCREEN. REPEAT
  REAMA. READ MAIL BY MA-FOLDER-TIME = #F-KEY (#PAGE)
    PERFORM #WAIT /*SU6
    IF MA-INV-TIME = #F-INV-TIME(#PAGE) AND MA-REPRNB < #F-RNB(#PAGE)
      ESCAPE TOP
    END-IF
    #L-USER-ID  := #S-USER-ID
    #L-FO-ID    := MA-FO-ID
    #L-INV-TIME := MA-INV-TIME
    #L-RNB      := MA-REPRNB
    IF MA-USERID NE #S-USER-ID OR MA-FO-ID NE #S-FO-ID
    OR MA-INV-TIME > #T-INV-TIME                                      /*
      ESCAPE BOTTOM (REAMA.)
    END-IF
    IF #I >= #NOFLINES
      ESCAPE BOTTOM (GET-SCREEN.)
    END-IF
    #AR-REPNAME := MA-REPNAME
    #AR-RNB     := MA-REPRNB
    FNDAR. FIND ACTIVE-REPORT WITH AR-REPORT-RNB = #AR-REPNAME-RNB
      IF NO RECORDS FOUND
        ENTER
      END-NOREC
      SELECTED := TRUE
      PERFORM SELECT-RECORD
      IF SELECTED
        ADD 1 TO #I
        PERFORM DATA-TO-SCREEN
      END-IF
    END-FIND
  END-READ
  END-OF-DATA := TRUE
  ESCAPE BOTTOM (GET-SCREEN.)
END-REPEAT
*
END-SUBROUTINE /* GET-SCREEN-FOLDER-TIME
*
************************************************************************
DEFINE SUBROUTINE GET-SCREEN-FOLDER-REP-TIME
************************************************************************
RESET #L-KEY #L-TIME-INV #L-INV-TIME #L-TIM-INV #L-RNB
#FROM-KEY := #F-KEY (#PAGE)
END-DATA := FALSE
GET-SCREEN-REP. REPEAT
  REAMARP. READ MAIL BY MA-FOLDER-REP-TIME = #FROM-KEY
    AT END OF DATA
      END-DATA := TRUE
    END-ENDDATA
    PERFORM #WAIT /*SU6
    IF MA-INV-TIME = #F-TIME-INV(#PAGE)
      IF MA-REPRNB = #PREV-RNB(*)
        ESCAPE TOP
      END-IF
    END-IF
    #L-USER-ID  := #S-USER-ID
    #L-FO-ID    := MA-FO-ID
    #L-REPNAME  := MA-REPNAME
    #L-TIME-INV := MA-INV-TIME
    IF MA-USERID NE #S-USER-ID OR MA-FO-ID NE #S-FO-ID OR
        MA-REPNAME > #T-REPNAME
      END-DATA := TRUE
      ESCAPE BOTTOM (REAMARP.)
    END-IF
    IF #L-TIME-INV > #T-TIME-INV
      #FROM-REPNAME := #L-REPNAME
      #FROM-TIME-INV := #CONST-INV-TIME
      ESCAPE BOTTOM (REAMARP.) IMMEDIATE
    END-IF
    IF #L-TIME-INV < #S-TIME-INV
      ESCAPE TOP
    END-IF
    IF #I >= #NOFLINES
      ESCAPE BOTTOM (GET-SCREEN-REP.)
    END-IF
    #AR-REPNAME := MA-REPNAME
    #AR-RNB     := MA-REPRNB
    FNDARRP. FIND ACTIVE-REPORT WITH AR-REPORT-RNB = #AR-REPNAME-RNB
      IF NO RECORDS FOUND
        ENTER
      END-NOREC
      SELECTED := TRUE
      PERFORM SELECT-RECORD
      IF SELECTED
        ADD 1 TO #I
        PERFORM DATA-TO-SCREEN
      END-IF
    END-FIND
  END-READ
  IF *COUNTER (REAMARP.) = 0 OR END-DATA
    END-OF-DATA := TRUE
    ESCAPE BOTTOM (GET-SCREEN-REP.)
  END-IF
END-REPEAT
*
END-SUBROUTINE /* GET-SCREEN-FOLDER-REP-TIME
*
************************************************************************
DEFINE SUBROUTINE SELECT-RECORD
************************************************************************
DECIDE FOR FIRST CONDITION
  WHEN (ACTIVE-REPORT.AR-REPNAME = ' ')
  OR   (#S-REPNAME NE ' '                                             /*
  AND NOT ACTIVE-REPORT.AR-REPNAME = #S-REPNAME-F THRU #S-REPNAME-T)  /*
  OR  NOT(#S-ARCHIVE-FLAG =' ' OR= ACTIVE-REPORT.AR-ARCHIVE)          /*
  OR  NOT(#S-REVIVE-FLAG =' ' OR= ACTIVE-REPORT.AR-REVIVE)            /*
  OR  NOT(#S-LOCATION =' ' OR='B' OR='*'                              /*
  OR= ACTIVE-REPORT.AR-CURRENT-LOCATION)                              /*
  OR  (#S-LOCATION = 'B'                                              /*
  AND NOT(ACTIVE-REPORT.AR-CURRENT-LOCATION ='S' OR='D'))  /*SU4 OR='C')
  OR  (#S-EXPDATE NE ' ' AND AR-EXPIRATION > #S-EXPDATE)              /*
  OR  (#S-SOURCE-SENDER > ' ' AND (AR-SOURCE > #T-SOURCE              /*
      OR NOT(AR-SENDER=#SENDER-F THRU #T-SENDER)))                        /*)
    SELECTED := FALSE
  WHEN #F-KY (*) NE ' '
    CALLNAT 'N-KY1' AR-KEYWORDS(*) #F-KY (*) #T-KY (*) #S-AND /*SU5
      SELECTED
  WHEN NONE
    IGNORE
END-DECIDE
*
END-SUBROUTINE /* SELECT-RECORD
*
************************************************************************
DEFINE SUBROUTINE SCREEN-IO
************************************************************************
IF #I < #NOFLINES
  CV-MARK (#I+1:#NOFLINES) := (AD=DP)
  CV-LINE (#I+1:#NOFLINES) := (AD=D)
END-IF
RESET END-OF-DISPLAY
REPEAT
  CALLNAT 'N-HEADER' L-HEADER G-DATE-FORMAT 'RLIACFM&' /*SU5
  IF #LANGUAGE NE *LANGUAGE
    #LANGUAGE := *LANGUAGE
    CALLNAT 'ROTINI-N' ##EQO-ACTIVE-REPORT G-OBJ-TYPE G-OTB
    PERFORM INIT-LINECOM
    PERFORM PF-KEYS
    RESET #FLIP-LINES (*)
  END-IF
  INCLUDE RMVHLP-C
  IF #FLIP-LINES (1) = ' '
    CALLNAT 'RFLIPG-N' G-LC #FLIP-LINES (*)
  END-IF
  G-LINECOM (*) := #FLIP-LINES (*)
  PERFORM SET-PFKEYS
  SET CONTROL 'M21'
  DECIDE FOR FIRST CONDITION
    WHEN G-NATRP-ERC NE 0              IGNORE
    WHEN END-OF-DATA AND #PAGE > 1     G-NATRP-ERC := 12 /*bot
    WHEN END-OF-DATA AND #PAGE = 1     G-NATRP-ERC := 14 /*all
    WHEN NOT END-OF-DATA AND #PAGE = 1 G-NATRP-ERC := 11 /*top
    WHEN NONE                          G-NATRP-ERC := 13 /* more
  END-DECIDE
  PERFORM FLIP-DISPLAY
  RESET #WARNING
  DECIDE ON FIRST VALUE OF #PANEL
    VALUE 3
      IF G-DISPLAY-LONG-NAMES
        INPUT WITH TEXT *G-NATRP-ERC, G-NATRP-ERT MARK *G-DIRECT-COMMAND
          USING MAP 'RLIACF3&'
      ELSE
        INPUT WITH TEXT *G-NATRP-ERC, G-NATRP-ERT MARK *G-DIRECT-COMMAND
          USING MAP 'RLIACF2&'
      END-IF
    VALUE 4
      IF G-DISPLAY-LONG-NAMES
        INPUT WITH TEXT *G-NATRP-ERC, G-NATRP-ERT MARK *G-DIRECT-COMMAND
          USING MAP 'RLIACF4&'
      ELSE
        INPUT WITH TEXT *G-NATRP-ERC, G-NATRP-ERT MARK *G-DIRECT-COMMAND
          USING MAP 'RLIACF5&'
      END-IF
    VALUE 5
      IF G-DISPLAY-LONG-NAMES
        INPUT WITH TEXT *G-NATRP-ERC, G-NATRP-ERT MARK *G-DIRECT-COMMAND
          USING MAP 'RLIACF7&'
      ELSE
        INPUT WITH TEXT *G-NATRP-ERC, G-NATRP-ERT MARK *G-DIRECT-COMMAND
          USING MAP 'RLIACF6&'
      END-IF
    NONE VALUE
      IF *MACHINE-CLASS NE "MAINFRAME"
        SET CONTROL 'WB'
      END-IF
      IF G-DISPLAY-LONG-NAMES
        INPUT WITH TEXT *G-NATRP-ERC, G-NATRP-ERT MARK *G-DIRECT-COMMAND
          USING MAP 'RLIACFL&'
      ELSE
        INPUT WITH TEXT *G-NATRP-ERC, G-NATRP-ERT MARK *G-DIRECT-COMMAND
          USING MAP 'RLIACFM&'
      END-IF
  END-DECIDE
  RESET G-NATRP-ERC G-NATRP-ERT
  PERFORM COMMAND-PF-KEY
  UNTIL END-OF-DISPLAY
END-REPEAT
*
END-SUBROUTINE /* SCREEN-IO
*
************************************************************************
DEFINE SUBROUTINE DATA-TO-SCREEN
************************************************************************
RESET #BIN-SIZE
IF #I > #NOFLINES
  ESCAPE ROUTINE
END-IF
IF ACTIVE-REPORT.AR-USERID = G-USERID OR G-USER-TYPE = 'A'
  L-OWNER (#I) := TRUE
ELSE
  RESET L-OWNER (#I)
END-IF
*
L-REPORT (#I) := ACTIVE-REPORT.AR-REPNAME
L-RNB    (#I) := ACTIVE-REPORT.AR-REPRNB
IF ACTIVE-REPORT.AR-DESC = ' '
  PERFORM READ-DESCRIPTION
END-IF
IF NOT (ACTIVE-REPORT.AR-SOURCE > ' ' )
AND NOT ( ACTIVE-REPORT.AR-SENDER > ' ' )                             /*
  RESET L-SOURCE-SENDER(#I)
ELSE
  COMPRESS AR-SOURCE '/' AR-SENDER TO L-SOURCE-SENDER (#I) LEAVING NO
END-IF
*
DECIDE ON FIRST MAIL.MA-STATUS
  VALUE 'C' L-CONFIRM (#I) := #LAN-TXT (1)
  VALUE 'P' L-CONFIRM (#I) := #LAN-TXT (2)
  NONE VALUE IGNORE
END-DECIDE
*
L-DESC      (#I) := ACTIVE-REPORT.AR-DESC
L-SOURCE-ID (#I) := ACTIVE-REPORT.AR-SOURCE-ID
L-ARCHIVE   (#I) := ACTIVE-REPORT.AR-ARCHIVE
L-REVIVE    (#I) := ACTIVE-REPORT.AR-REVIVE
L-LOC       (#I) := ACTIVE-REPORT.AR-CURRENT-LOCATION
*
IF ACTIVE-REPORT.AR-CC-TYPE = BINARY
  L-BIN(#I) := TRUE
  #SPOOL-ATTRIBUTES := AR-SPOOL-ATTRIBUTES
  IF NOT (#SPOOL-DI-SIZE = #I4 OR = 0)
    #BIN-SIZE := #SPOOL-DI-SIZE * 3 / 4 + 1 /*SU2 - '+ 1' added
  END-IF
  IF #BIN-SIZE > 0
    #BIN-SIZE := #BIN-SIZE / 1024 + 1
    COMPRESS #BIN-SIZE 'K' TO L-LINES(#I) LEAVING NO
  ELSE
    L-LINES(#I) := '--K'
  END-IF
ELSE
  L-LINES (#I) := ACTIVE-REPORT.AR-NUMBER-OF-LINES
END-IF
*
RESET #DATE-A10
#TIME-P13 := #CONST-INV-TIME - MAIL.MA-INV-TIME-P13
#TIME := #TIME-P13
MOVE EDITED #TIME (EM=HH':'II) TO L-MAIL-TIME (#I)
MOVE EDITED #TIME (EM=YYYYMMDD) TO #DATE
CALLNAT 'IODATE-N' 'M' 'S' #DATE #DATE-A10 G-DATE-FORMAT
  #ERROR-CODE #ERROR-TEXT
*
IF #ERROR-CODE = 0
  L-MAIL-DATE (#I) := #DATE-A10
END-IF
*
RESET #DATE-A10
MOVE EDITED ACTIVE-REPORT.AR-PROCESS-TIME (EM=HH':'II)
  TO L-CREATION-TIME (#I)
MOVE EDITED ACTIVE-REPORT.AR-PROCESS-TIME (EM=YYYYMMDD) TO #DATE
CALLNAT 'IODATE-N' 'M' 'S' #DATE #DATE-A10 G-DATE-FORMAT
  #ERROR-CODE #ERROR-TEXT
*
IF #ERROR-CODE = 0
  L-CREATION-DATE (#I) := #DATE-A10
END-IF
*
RESET #DATE-A10 #ERROR-CODE #ERROR-TEXT
CALLNAT 'IODATE-N' 'M' 'S' ACTIVE-REPORT.AR-EXPIRATION #DATE-A10
  G-DATE-FORMAT #ERROR-CODE #ERROR-TEXT
IF #ERROR-CODE = 0
  L-EXPIRATION-DATE (#I) := #DATE-A10
END-IF
IF +G-NOMEXIT-ACTIVE (8)
  PERFORM USER-EXIT-8
END-IF
*
L-OPTION(#I,*) := #OPTIONS(*)
IF L-OWNER(#I)
  L-OPTION(#I,*) := 'Y'
ELSE
  PERFORM CHECK-OTHER-FOLDERS
  #FOLDER-USER := FO-USER-ID /* #G-C-FOLDER FOR DELAR
  #FOLDER-ID   := FO-ID
END-IF
*
END-SUBROUTINE /* DATA-TO-SCREEN
*
************************************************************************
DEFINE SUBROUTINE INIT-LINECOM
************************************************************************
DECIDE FOR FIRST CONDITION
  WHEN #S-USER-ID = G-USERID
    G-LC-IDENT (01) := ##EQU-PRINT
    G-LC-IDENT (02) := ##EQU-BROWSE
    G-LC-IDENT (03) := ##EQU-FILE-AREPORT
    G-LC-IDENT (04) := ##EQU-DELETE
    G-LC-IDENT (05) := ##EQU-MODIFY
    G-LC-IDENT (06) := ##EQU-DISPLAY
    G-LC-IDENT (07) := ##EQU-ARCHIVE
    G-LC-IDENT (08) := ##EQU-REVIVE
    G-LC-IDENT (09) := ##EQU-DISTRIBUTE
    G-LC-IDENT (10) := ##EQU-CONFIRM-PRINT
    G-LC-IDENT (11) := ##EQU-USERS
    G-LC-IDENT (12) := ##EQU-BUNDLE
    G-LC-IDENT (13) := ##EQU-XREF-BUNDLES
    G-LC-IDENT (14) := ##EQU-DISPLAY-DEFINITION
    G-LC-IDENT (15) := ##EQU-SPOOL-ATTR
    G-LC-NUM               := 15
  WHEN #S-USER-ID NE G-USERID
    G-LC-IDENT (01) := ##EQU-PRINT
    G-LC-IDENT (02) := ##EQU-BROWSE
    G-LC-IDENT (03) := ##EQU-FILE-AREPORT
    G-LC-IDENT (04) := ##EQU-DELETE
    G-LC-IDENT (05) := ##EQU-MODIFY
    G-LC-IDENT (06) := ##EQU-DISPLAY
    G-LC-IDENT (07) := ##EQU-ARCHIVE
    G-LC-IDENT (08) := ##EQU-REVIVE
    G-LC-IDENT (09) := ##EQU-USERS
    G-LC-IDENT (10) := ##EQU-BUNDLE
    G-LC-IDENT (11) := ##EQU-XREF-BUNDLES
    G-LC-IDENT (12) := ##EQU-DISPLAY-DEFINITION
    G-LC-IDENT (13) := ##EQU-SPOOL-ATTR
    G-LC-NUM               := 13
  WHEN NONE IGNORE
END-DECIDE
*
CALLNAT 'RLCINI-N' G-OBJ-TYPE G-LC G-LCB
*
END-SUBROUTINE /* INIT-LINECOM
*
************************************************************************
DEFINE SUBROUTINE PF-KEYS
************************************************************************
PERFORM INIT-PFKEYS
PERFORM SET-PFKEYS
*
END-SUBROUTINE /* PF-KEYS
*
************************************************************************
DEFINE SUBROUTINE INIT-SELECTION-KEYS
************************************************************************
IF #S-SOURCE-SENDER > ' '
  EXAMINE #S-SOURCE-SENDER FOR '/' GIVING POSITION IN #N
  IF #N = 0
    #SOURCE-F := SUBSTR(#S-SOURCE-SENDER,1,16)
    RESET #SENDER-F
  ELSE
    IF #N = 1
      RESET #SOURCE-F
    ELSE
      #K := #N - 1
      #SOURCE-F := SUBSTR(#S-SOURCE-SENDER,1,#K)
    END-IF
    ADD 1 TO #N
    #SENDER-F := SUBSTR(#S-SOURCE-SENDER,#N,16)
  END-IF
*
  IF #SOURCE-F NE SCAN '*'
    #F-SOURCE(1) := #SOURCE-F
    IF #SOURCE-F = ' '
      #T-SOURCE := H'FF'
    ELSE
      #T-SOURCE := #SOURCE-F
    END-IF
  ELSE
    EXAMINE #SOURCE-F FOR '*' DELETE
    #F-SOURCE (1) := #SOURCE-F
    COMPRESS #SOURCE-F H'FF' TO #T-SOURCE LEAVING NO
  END-IF
*
  IF #SENDER-F NE SCAN '*'
    IF #SENDER-F = ' '
      #T-SENDER := H'FF'
    ELSE
      #T-SENDER := #SENDER-F
    END-IF
    RESET #F-SENDER(1)
  ELSE
    EXAMINE #SENDER-F FOR '*' DELETE
    #F-SENDER (1) := #SENDER-F
    COMPRESS #SENDER-F H'FF' TO #T-SENDER LEAVING NO
  END-IF
*
  #F-TIM-INV(1)  := #CONST-INV-TIME
  RESET #T-TIM-INV
  #START-SOURCE  := #SOURCE-F
  #START-SENDER  := #SENDER-F
  #START-TIM-INV := #CONST-INV-TIME
ELSE
  #LEN := 25
  CALLNAT 'SELALPHA' #S-REPNAME #S-REPNAME-F #S-REPNAME-T #LEN
*
  #F-USER-ID (1) := #S-USER-ID
  #F-FO-ID   (1) := #S-FO-ID
  #START-USER-ID := #S-USER-ID
  #START-FO-ID   := #S-FO-ID
  IF (#S-REPNAME = ' ' OR = '*') OR PROF-AR-SORT = 'D'
    RESET  #F-INV-TIME (1) #START-INV-TIME #F-RNB(1)
    IF NOT (#S-MAILED = ' ' OR = '*')
      #F-INV-TIME (1) := #CONST-INV-TIME - #S-MAILED-T-P
      #START-INV-TIME := #CONST-INV-TIME - #S-MAILED-T-P
    END-IF
  ELSE
    RESET #F-TIME-INV (1) #START-TIME-INV
    IF NOT (#S-MAILED = ' ' OR = '*')
      #F-TIME-INV (1) := #CONST-INV-TIME - #S-MAILED-T-P
      #START-TIME-INV := #CONST-INV-TIME - #S-MAILED-T-P
    END-IF
    #S-TIME-INV    := #F-TIME-INV (1)
    #F-REPNAME (1) := #S-REPNAME-F
    #F-FOLDER  (1) := #START-FOLDER
    #START-REPNAME := #S-REPNAME-F
  END-IF
*
  #T-USER-ID := #S-USER-ID
  #T-FO-ID   := #S-FO-ID
  IF (#S-REPNAME = ' ' OR = '*') OR PROF-AR-SORT = 'D'
    #T-INV-TIME :=                 #CONST-INV-TIME
    #T-RNB := 99999999999
    IF NOT (#S-MAILED = ' ' OR = '*')
      #T-INV-TIME := #CONST-INV-TIME - #S-MAILED-F-P
    END-IF
  ELSE
    #T-TIME-INV :=                 #CONST-INV-TIME
    IF NOT (#S-MAILED = ' ' OR = '*')
      #T-TIME-INV := #CONST-INV-TIME - #S-MAILED-F-P
    END-IF
    #T-REPNAME := #S-REPNAME-T
  END-IF
END-IF
*
END-SUBROUTINE /* INIT-SELECTION-KEYS
*
************************************************************************
DEFINE SUBROUTINE COMMAND-PF-KEY
************************************************************************
IF G-DIRECT-COMMAND = ' '
  PERFORM CHECK-PF-KEY
END-IF
DECIDE ON FIRST VALUE OF G-DIRECT-COMMAND             /* test local
  VALUE 'HELP'   REINPUT USING HELP                   /* commands
  VALUE 'EXIT'   END-OF-PROCESSING := END-OF-DISPLAY := TRUE /*ret fathe
  VALUE 'FLIP'   PERFORM FLIP-HANDLE
  VALUE 'FOLLOW' PERFORM FOLLOW-MONITOR
  VALUE 'MENU'   /*ret menu
    END-OF-PROCESSING := END-OF-DISPLAY := TRUE
    INCLUDE C-MENU
  VALUE 'LEFT'
    IF #PANEL > 1
      SUBTRACT 1 FROM #PANEL
    END-IF
  VALUE 'RIGHT'
    IF #PANEL < 5
      ADD 1 TO #PANEL
    END-IF
  VALUE 'EXT'
    IF G-SUPPORT-LONG-NAMES
      IF G-DISPLAY-LONG-NAMES
        G-DISPLAY-LONG-NAMES := FALSE
      ELSE
        G-DISPLAY-LONG-NAMES := TRUE
      END-IF
    END-IF
  VALUE 'UP'
    PERFORM CHECK-MODIFICATIONS
    IF #PAGE > 1 AND NOT NEW-SEARCH
      SUBTRACT 1 FROM #PAGE
      END-OF-DISPLAY := GET-SCREEN := TRUE
      END-OF-DATA    := FALSE
    END-IF
    IF #PAGE = 1 AND NOT NEW-SEARCH
      #MAXAP := #PAGE := 1 /*#page=1 in buffer->exec TOP + empty buffer
      RESET L-SCR(*) #F-KEYTAB(*) #F-RNB(*)
      DECIDE FOR FIRST CONDITION
        WHEN #S-SOURCE-SENDER NE ' '
          #F-SOURCE(1)  := #START-SOURCE
          #F-SENDER(1)  := #START-SENDER
          #F-TIM-INV(1) := #START-TIM-INV
        WHEN (#S-REPNAME = ' ' OR = '*') OR PROF-AR-SORT = 'D'
          #F-USER-ID (1) := #START-USER-ID
          #F-FO-ID (1)   := #START-FO-ID
          #F-INV-TIME(1) := #START-INV-TIME
        WHEN NOT (#S-REPNAME = ' ' OR = '*') AND PROF-AR-SORT NE 'D'
          #F-FOLDER(1)   := #START-FOLDER
          #F-REPNAME(1)  := #START-REPNAME
          #F-TIME-INV(1) := #START-TIME-INV
        WHEN NONE IGNORE
      END-DECIDE
      END-OF-DISPLAY := GET-SCREEN := TRUE
      END-OF-DATA := FALSE
    END-IF
  VALUE 'DOWN'
    PERFORM CHECK-MODIFICATIONS
    IF NOT END-OF-DATA AND NOT NEW-SEARCH
      ADD 1 TO #PAGE
      IF #PAGE > #NOFPAGES
        #PAGE := #NOFPAGES
        #F-KEY (1:#NOFPAGES - 1) := #F-KEY (2:#NOFPAGES)
      END-IF
      #F-KEY (#PAGE) := #L-KEY
      END-OF-DISPLAY := GET-SCREEN := TRUE
      END-OF-DATA    := FALSE
    END-IF
  VALUE 'TOP'
    PERFORM CHECK-MODIFICATIONS
    #MAXAP := #PAGE := 1
    #F-KEY(1):= #START-KEY
    GET-SCREEN := END-OF-DISPLAY := TRUE
    END-OF-DATA := FALSE
  VALUE 'BOT'
    PERFORM CHECK-MODIFICATIONS
    IF NOT NEW-SEARCH
      #PAGE := #MAXAP
      GET-SCREEN := END-OF-DISPLAY := TRUE
      END-OF-DATA := FALSE
    END-IF
  VALUE ' '
    PERFORM CHECK-MODIFICATIONS
    IF NOT NEW-SEARCH AND #PAGE = 1 AND #S-FO-ID = 1
      GET-SCREEN := END-OF-DISPLAY := TRUE
      END-OF-DATA := FALSE
    END-IF
  ANY            RESET G-DIRECT-COMMAND
  NONE           PERFORM EXECUTE-DIRECT-COMMAND
END-DECIDE
*
END-SUBROUTINE /* COMMAND-PF-KEY
*
************************************************************************
DEFINE SUBROUTINE CHECK-PF-KEY
************************************************************************
G-PF-KEY := *PF-KEY
EXAMINE G-PF-KEY FOR 'PF' REPLACE ' '
MOVE LEFT G-PF-KEY TO G-PF-KEY
IF G-PF-KEY IS (N4)
  G-PF-IND := VAL (G-PF-KEY)
  G-DIRECT-COMMAND := G-PF-CODE (G-PF-IND)
ELSE
  G-PF-FUNC := *PF-KEY
END-IF
*
END-SUBROUTINE /* CHECK-PF-KEY
*
************************************************************************
DEFINE SUBROUTINE EXECUTE-DIRECT-COMMAND
************************************************************************
MOVE LEFT G-DIRECT-COMMAND TO G-DIRECT-COMMAND
IF G-DIRECT-COMMAND IS (N2.1) AND G-DIRECT-COMMAND NE '.'
  COMPRESS '>' G-DIRECT-COMMAND TO G-DIRECT-COMMAND LEAVING NO
END-IF
FETCH RETURN 'NRMCPR'
SET CONTROL 'WMB'
DECIDE ON FIRST VALUE OF G-NATRP-ERC
  VALUE 0,5,419,420 IGNORE
  VALUE 9999
    RESET G-NATRP-ERC
    END-OF-DISPLAY := END-OF-PROCESSING := TRUE
  VALUE 9998        IGNORE
  VALUE 9997        RESET G-NATRP-ERC
  NONE              ESCAPE ROUTINE
END-DECIDE
*
END-SUBROUTINE /* EXECUTE-DIRECT-COMMAND
*
************************************************************************
DEFINE SUBROUTINE CHECK-MODIFICATIONS
************************************************************************
IF #S-REPNAME = '*'
  RESET #S-REPNAME
END-IF
INIT-SELECTION := FALSE
*
DECIDE FOR EVERY CONDITION
  WHEN #O-REPNAME NE #S-REPNAME
    #O-REPNAME := #S-REPNAME
    +G-RLIACF-SEL-REPNAME := #S-REPNAME
    INIT-SELECTION := TRUE
  WHEN #O-MAILED NE #S-MAILED
    #O-MAILED := #S-MAILED
    #DATE11 := #S-MAILED
    PERFORM INIT-DAT-KEYS
    IF #ERROR-CODE NE 0
      REINPUT *#ERROR-CODE, #ERROR-TEXT
    END-IF
    #O-MAILED      := #DATE11
    #S-MAILED      := #DATE11
    #S-MAILED-F    := #DATE-F
    #S-MAILED-F-P  := #S-MAILED-F
    #S-MAILED-T    := #DATE-T
    #S-MAILED-T-P  := #S-MAILED-T
    INIT-SELECTION := TRUE
  WHEN #O-ARCHIVE-FLAG NE #S-ARCHIVE-FLAG
    #O-ARCHIVE-FLAG := #S-ARCHIVE-FLAG
    +G-RLIACF-SEL-ARC-FLAG := #S-ARCHIVE-FLAG
  WHEN #O-REVIVE-FLAG NE #S-REVIVE-FLAG
    #O-REVIVE-FLAG := #S-REVIVE-FLAG
    +G-RLIACF-SEL-REV-FLAG := #S-REVIVE-FLAG
  WHEN #O-LOCATION NE #S-LOCATION
      AND #S-LOCATION NE #DEF-LOC
    #O-LOCATION := #S-LOCATION
    +G-RLIACF-SEL-LOCATION := #S-LOCATION
  WHEN #O-EXPDATE NE #L-EXPDATE
    IF #L-EXPDATE EQ ' ' OR #L-EXPDATE EQ '*'
      RESET #L-EXPDATE #S-EXPDATE #O-EXPDATE
    ELSE
      RESET #ERROR-CODE #ERROR-TEXT
* can use #S-EXPDATE safely as of now, IODATE-N doesn't change value
* of this field if error code is returned
      CALLNAT 'IODATE-N' 'V' 'L' #S-EXPDATE #L-EXPDATE G-DATE-FORMAT
        #ERROR-CODE #ERROR-TEXT
      IF #ERROR-CODE NE 0
        REINPUT *#ERROR-CODE, #ERROR-TEXT
      ELSE
        #O-EXPDATE := #L-EXPDATE
      END-IF
    END-IF
  WHEN  CV-SOURCE MODIFIED
    INIT-SELECTION := TRUE
  WHEN ANY
    IF INIT-SELECTION
      PERFORM INIT-SELECTION-KEYS
    END-IF
    #PAGE := #MAXAP := 1
    NEW-SEARCH := END-OF-DISPLAY := GET-SCREEN := TRUE
    END-OF-DATA := FALSE
  WHEN NONE
    PERFORM LINE-COMMANDS
END-DECIDE
*
END-SUBROUTINE /* CHECK-MODIFICATIONS
*
************************************************************************
DEFINE SUBROUTINE INITIALISATION
************************************************************************
DECIDE FOR EVERY CONDITION
  WHEN NOT END-OF-PROCESSING
    INCLUDE CVIDEO
    G-FLIP-STATUS := 'P'
    PERFORM INIT-SELECTION-KEYS
  WHEN NOT END-OF-PROCESSING
    PERFORM READ-FOLDER
  WHEN NONE IGNORE
END-DECIDE
*
END-SUBROUTINE /* INITIALISATION
*
************************************************************************
DEFINE SUBROUTINE READ-FOLDER
************************************************************************
#FO-USER-ID := #S-USER-ID
#FO-ID      := #S-FO-ID
FNDFO. FIND FOLDER WITH FO-USER-FO-ID = #FO-USER-FO-ID
  IF NO RECORDS FOUND
    END-OF-PROCESSING := TRUE
    ESCAPE BOTTOM (FNDFO.)
  END-NOREC
  #FOLDER := FO-NAME
  IF FO-LINKED-FO-ID NE ' '
    #S-USER-ID := FO-LINKED-USER-ID
    #S-FO-ID   := FO-LINKED-ID
    FIND LINKED-FOLDER WITH FO-USER-FO-ID = FOLDER.FO-LINKED-FO-ID
      #DEF-LOC := LINKED-FOLDER.FO-DEFAULT-LOCATION
    END-FIND
  ELSE
    #DEF-LOC := FOLDER.FO-DEFAULT-LOCATION
  END-IF
  IF G-USER-TYPE NE 'A'
    #FO-ID-N := #S-FO-ID
    COMPRESS #S-USER-ID #FO-ID-A TO #FO-NAME LEAVING NO
    #GR-USERID := G-USERID
    CALLNAT 'RGRANT-N' #GR-USERID 'F' #FO-NAME #GRANTED #OPTIONS(*)
  END-IF
END-FIND
#S-LOCATION := #DEF-LOC
*
END-SUBROUTINE /* READ-FOLDER
*
************************************************************************
DEFINE SUBROUTINE READ-DESCRIPTION
************************************************************************
FNDR. FIND REPORT WITH R-REPNAME = ACTIVE-REPORT.AR-REPNAME
  IF NO RECORDS FOUND
    ENTER
  END-NOREC
  ACTIVE-REPORT.AR-DESC := R-DESC
END-FIND
*
END-SUBROUTINE /* READ-DESCRIPTION
*
************************************************************************
DEFINE SUBROUTINE INIT-PFKEYS
************************************************************************
INCLUDE RPFSTD-C
INCLUDE RPFBRW-C
INCLUDE RPFLR--C
INCLUDE RPFEXT-C
CALLNAT 'RPFINI-N' G-PF G-PFB
*
END-SUBROUTINE /* INIT-PFKEYS
*
************************************************************************
DEFINE SUBROUTINE LINE-COMMANDS
************************************************************************
INCLUDE RLCMTI-C
* validate Line Commands
RESET I
FOR I 1 TO #NOFLINES
  IF L-IDENT (I) = ##EQU-CONFIRM-PRINT OR = ##EQU-DISTRIBUTE
  OR= ##EQU-BROWSE OR= ##EQU-BUNDLE OR= ##EQU-PRINT OR= ##EQU-ARCHIVE /*
    PERFORM CHECK-SOURCE
  END-IF
END-FOR
INCLUDE C-CHKLC
*
FOR I 1 TO #NOFLINES
  DECIDE ON FIRST VALUE OF L-IDENT (I)
    VALUE ##EQU-BROWSE
      IF L-BIN(I)
        REINPUT *725  MARK *L-MARK(I) ALARM
      END-IF
    VALUE ##EQU-BUNDLE
      IF NOT(L-LOC(I) ='D' OR='S') /*SU4 OR='C')
        REINPUT *0426 MARK *L-MARK(I) ALARM
      END-IF
    VALUE ##EQU-PRINT
      IF #TRACING
        #TRACE-MSG := 'Start Print Function'
        PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
        END TRANSACTION
      END-IF
      IF L-BIN(I) AND NOT #WARNING AND #SPOOL-DI-FILETYPE NE 'prn'
        #WARNING := TRUE
        INPUT WINDOW='WARNING' USING MAP 'RLIACFW&'
        #WIN-PFKEY := *PF-KEY
        IF #TRACING
          COMPRESS 'Got Windows PF Key:' #WIN-PFKEY TO #TRACE-MSG
          PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
          END TRANSACTION
        END-IF
        DECIDE ON FIRST VALUE OF #WIN-PFKEY
          VALUE 'PF3'
            RESET L-IDENT (I) L-MARK (I)
            G-NATRP-ERC := 428 /* Report not queued for printing.
          VALUE 'PF5'
            IGNORE
          NONE
            REINPUT ' '
        END-DECIDE
      END-IF
    NONE  IGNORE
  END-DECIDE
END-FOR
*
FOR #J = 1 TO #NOFLINES
  DECIDE ON FIRST VALUE OF L-IDENT (#J)
    VALUE ##EQU-BROWSE
      RESET L-MARK (#J) L-IDENT (#J)
      G-C-REPORT := L-REPORT (#J)
      G-C-REPRNB := L-RNB(#J)
      FETCH RETURN 'RDISRP' G-C-REPORT G-C-REPRNB
    VALUE ##EQU-DELETE
      GET-SCREEN := TRUE
      RESET L-MARK (#J) L-IDENT (#J)
      G-C-REPORT := L-REPORT (#J)
      G-C-REPRNB := L-RNB(#J)
      IF NOT L-OWNER(#J)
        G-C-FOLDER   := #G-C-FOLDER
      END-IF
      FETCH RETURN 'RDELAR'
      END-OF-DISPLAY := TRUE
    VALUE ##EQU-DISPLAY
      RESET L-MARK (#J) L-IDENT (#J)
      G-C-REPORT := L-REPORT (#J)
      G-C-REPRNB := L-RNB(#J)
      G-C-FUNC := 'D'
      GET-SCREEN := TRUE
      FETCH RETURN 'RDEFAR'
    VALUE ##EQU-MODIFY
      RESET L-MARK (#J) L-IDENT (#J)
      G-C-REPORT := L-REPORT (#J)
      G-C-REPRNB := L-RNB(#J)
      G-C-FUNC := 'M'
      GET-SCREEN:=TRUE
      FETCH RETURN 'RDEFAR'
    VALUE ##EQU-PRINT
      RESET L-MARK (#J) L-IDENT (#J)
      G-C-REPORT := L-REPORT (#J)
      G-C-REPRNB := L-RNB(#J)
      IF #TRACING
        COMPRESS 'Calling RPRTAR with:' L-REPORT (#J) '/' L-RNB (#J)
          TO #TRACE-MSG
        PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
        END TRANSACTION
      END-IF
      FETCH RETURN 'RPRTAR'
    VALUE ##EQU-ARCHIVE
      GET-SCREEN := TRUE
      RESET L-MARK (#J) L-IDENT (#J)
      G-C-REPORT := L-REPORT (#J)
      G-C-REPRNB := L-RNB(#J)
      FETCH RETURN 'RARCAR'
      END-OF-DISPLAY := TRUE
    VALUE ##EQU-REVIVE
      GET-SCREEN := TRUE
      RESET L-MARK (#J) L-IDENT (#J)
      G-C-REPORT := L-REPORT (#J)
      G-C-REPRNB := L-RNB(#J)
      FETCH RETURN 'RREVAR'
      END-OF-DISPLAY := TRUE
    VALUE ##EQU-FILE-AREPORT
      GET-SCREEN := TRUE
      RESET L-MARK (#J) L-IDENT (#J)
      FETCH RETURN 'RFILAR' #S-USER-ID L-REPORT (#J) L-RNB (#J)
    VALUE ##EQU-DISTRIBUTE
      RESET L-MARK (#J) L-IDENT (#J)
      G-C-REPORT := L-REPORT (#J)
      G-C-REPRNB := L-RNB(#J)
      PERFORM DISTRIBUTE-REPORT
    VALUE ##EQU-BUNDLE
      RESET L-MARK (#J) L-IDENT (#J)
      G-C-REPORT := L-REPORT (#J)
      G-C-REPRNB := L-RNB(#J)
      PERFORM BUNDLE-REPORT
    VALUE ##EQU-USERS
      RESET L-MARK (#J) L-IDENT (#J)
      G-C-REPORT := L-REPORT (#J)
      G-C-REPRNB := L-RNB(#J)
      FETCH RETURN 'RXRFRU'
    VALUE ##EQU-XREF-BUNDLES
      RESET L-MARK (#J) L-IDENT (#J)
      G-C-REPORT := L-REPORT (#J)
      G-C-REPRNB := L-RNB(#J)
      FETCH RETURN 'RXRPBU'
    VALUE ##EQU-CONFIRM-PRINT
      GET-SCREEN := TRUE
      RESET L-MARK (#J) L-IDENT (#J)
      G-C-REPORT := L-REPORT (#J)
      G-C-REPRNB := L-RNB(#J)
      FETCH RETURN 'RCONFPRT'
    VALUE ##EQU-DISPLAY-DEFINITION
      RESET L-MARK (#J) L-IDENT (#J)
      G-C-FUNC  := 'D'
      G-C-REPORT := L-REPORT (#J)
      G-FATHER-PROG := *PROGRAM
      FETCH RETURN 'RDEFRP'
    VALUE ##EQU-SPOOL-ATTR
      RESET L-MARK (#J) L-IDENT (#J)
      G-C-REPORT := L-REPORT (#J)
      G-C-REPRNB := L-RNB(#J)
      G-C-FUNC := 'S'
      FETCH RETURN 'RDEFAR'
    NONE VALUE
      IGNORE
  END-DECIDE
END-FOR
*
END-SUBROUTINE /* LINE-COMMANDS
*
************************************************************************
DEFINE SUBROUTINE CHECK-OTHER-FOLDERS
************************************************************************
* If function on Active Report performed from linked folder, it makes
* sense to check - does the same active report contains in any of user's
* own folders:#Inbasket/another own not linked folder/folder linked to
* own folder.
* Then function is allowed from current folder , too.
* Deletion stiil done: if not user own Active Report and user is non-
* admin user - delete only mail record
*
IF NOT(L-OPTION (#I,*) NE 'Y')        /* owner folder grants
  ESCAPE ROUTINE
END-IF
*
RESET #GR-OPTION(*)
#AR-REPNAME := L-REPORT(#I)
#AR-RNB     := L-RNB(#I)
#MA-RNB     := L-RNB(#I)
#MA-USER    := G-USERID
*
MA. FIND MAIL WITH MA-REP-RNB = #AR-REPNAME-RNB AND
    MA-RNB-USER = #MA-RNB-USER
*
  #FO-ID      := MA-FO-ID
  #FO-USER-ID := MA-USERID
  IF #FO-ID = 1
    L-OPTION(#I,*) := 'Y'
    ESCAPE BOTTOM(MA.)
  END-IF
  RFO. FIND FOLDER WITH FO-USER-FO-ID = #FO-USER-FO-ID
    IF FO-LINKED-FO-ID = ' '
      #FO-ID-N := FO-ID
      COMPRESS FO-USER-ID #FO-ID-A TO #FO-NAME LEAVING NO
    ELSE
      #FO-ID-N := FO-LINKED-ID
      COMPRESS FO-LINKED-USER-ID #FO-ID-A TO #FO-NAME LEAVING NO
    END-IF
    #GR-USERID := G-USERID
    CALLNAT 'RGRANT-N' #GR-USERID 'F' #FO-NAME #GRANTED #GR-OPTION(*)
    IF #GRANTED
      IF NOT(#GR-OPTION(*) NE 'Y')
        L-OPTION(#I,*) := #GR-OPTION(*)
        ESCAPE BOTTOM(MA.)
      END-IF
    END-IF
  END-FIND
END-FIND
*
END-SUBROUTINE /* CHECK-OTHER-FOLDERS
*
************************************************************************
DEFINE SUBROUTINE INIT-TEXT
************************************************************************
#LAN-IDENT (1) := ##TXT-CONFIRM-PRINT
#LAN-IDENT (2) := ##TXT-CONFIRMED-PRINT
FOR J = 1 TO #NOT
  IF #LAN-IDENT (J) NE 0
    CALLNAT 'RLTINI-N' #LAN-IDENT (J) #LAN-TXT   (J) G-TXB
  END-IF
END-FOR
*
END-SUBROUTINE /* INIT-TEXT
*
************************************************************************
DEFINE SUBROUTINE CHECK-SOURCE
************************************************************************
RESET #ERROR-CODE #ERROR-TEXT SOURCE-EXIST
*
IF L-LOC (I) = 'A'
* REINPUT *0426 MARK *L-MARK(I) ALARM                /* BLI NOMALL-1829
  REINPUT *0441 MARK *L-MARK(I) ALARM                /* BLI NOMALL-1829
END-IF
*
IF L-SOURCE-ID (I) = 0 OR (L-REVIVE (I) = '*' AND L-LOC(I) = 'D')
  ESCAPE ROUTINE
END-IF
*
IF G-USE-OWNER
  #AR-REPNAME := L-REPORT (I)
  #AR-RNB     := L-RNB (I)
  FIND ACTIVE-REPORT-OWNER WITH AR-REPORT-RNB = #AR-REPNAME-RNB
    IF AR-USERID NE G-NPR-USERID-CURRENT
      FIND NRM-SOURCE WITH SR-ID = L-SOURCE-ID (I)
      END-FIND
      IF NRM-SOURCE.SR-TYPE NE NOM-DATA-BASE
        #SAVE-NPR-USERID := G-NPR-USERID
        G-NPR-USERID := AR-USERID
        PERFORM LOGON-TO-ESY
        IF G-NATRP-ERC NE 0
          G-NPR-USERID := #SAVE-NPR-USERID
          ESCAPE ROUTINE
        END-IF
        RESET G-NATRP-ERC G-NATRP-ERT
        G-NPR-USERID := #SAVE-NPR-USERID
      END-IF
    END-IF
  END-FIND
END-IF
*
CALLNAT 'RMSRCK-N' #ERROR-CODE #ERROR-TEXT L-SOURCE-ID (I) SOURCE-EXIST
IF #ERROR-CODE NE 0
  REINPUT *#ERROR-CODE, #ERROR-TEXT MARK *L-MARK(I) ALARM
END-IF
IF NOT SOURCE-EXIST
  REINPUT *0426 MARK *L-MARK(I) ALARM
END-IF
*
END-SUBROUTINE /* CHECK-SOURCE
*
************************************************************************
DEFINE SUBROUTINE INIT-DAT-KEYS
************************************************************************
RESET #ERROR-CODE #ERROR-TEXT
IF #DATE11 = '*' OR = ' '
  RESET #DATE-F
  MOVE EDITED '20901231235959' TO #DATE-T (EM=YYYYMMDDHHIISS)
  ESCAPE ROUTINE
END-IF
IF NOT #DATE11-1 = '=' OR = '<' OR = '>'
  COMPRESS '=' #DATE11 TO #DATE11 LEAVING NO
END-IF
*
CALLNAT 'IODATE-N' 'V' 'A' #DATE8 #DATE11-2 G-DATE-FORMAT
  #ERROR-CODE #ERROR-TEXT
IF #ERROR-CODE NE 0
  ESCAPE ROUTINE
END-IF
*
DECIDE FOR FIRST CONDITION
  WHEN #DATE11-1 = '='
    COMPRESS #DATE8 '000000' TO #DATE14 LEAVING NO
    MOVE EDITED #DATE14 TO #DATE-F   (EM=YYYYMMDDHHIISS)
    COMPRESS #DATE8 '235959' TO #DATE14 LEAVING NO
    MOVE EDITED #DATE14 TO #DATE-T   (EM=YYYYMMDDHHIISS)
  WHEN #DATE11-1 = '>'
    COMPRESS #DATE8 '000000' TO #DATE14 LEAVING NO
    MOVE EDITED #DATE14 TO #DATE-F  (EM=YYYYMMDDHHIISS)
    MOVE EDITED '20901231235959' TO #DATE-T (EM=YYYYMMDDHHIISS)
  WHEN #DATE11-1 = '<'
    RESET #DATE-F
    COMPRESS #DATE8 '235959' TO #DATE14 LEAVING NO
    MOVE EDITED #DATE14 TO #DATE-T  (EM=YYYYMMDDHHIISS)
  WHEN NONE
    IGNORE
END-DECIDE
*
END-SUBROUTINE /* INIT-DAT-KEYS
*
************************************************************************
DEFINE SUBROUTINE USER-EXIT-8
************************************************************************
INCLUDE NOMEX08C                  /* invoke exit
*
IF NOMEX008-ERROR-CODE EQ 0
  L-CONFIRM (#I) := NOMEX008-MESSAGE
ELSE
  COMPRESS 'E:' NOMEX008-ERROR-CODE TO L-CONFIRM (#I)
END-IF
*
END-SUBROUTINE /* USER-EXIT-8
*
