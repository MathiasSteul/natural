* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Program   SETMADIO
* Function  gets the old value of MADIO and sets a new one
* Version   1
*
* Maintenance:
* uid yy-mm-dd s(999999) ...
* mwi 96-10-24 s(242610) created
* ----------------------------------------------------------------------
DEFINE DATA
PARAMETER
1 P-NEWVAL (B2)  /* in
1 P-OLDVAL (B2)  /* out
LOCAL
1 #FNC     (B1)
1 #UB-PARM (A32)
1 REDEFINE #UB-PARM
  2 #UB-PARM-CMD (A1)
  2 #UB-PARM-VAL (B2)
1 #RESP   (N4)
END-DEFINE
#FNC := 28;
#UB-PARM-CMD := 'G'
CALLNAT 'NAT00040' #FNC #UB-PARM #RESP
P-OLDVAL := #UB-PARM-VAL
#UB-PARM-CMD := 'S';
#UB-PARM-VAL := P-NEWVAL
CALLNAT 'NAT00040' #FNC #UB-PARM #RESP
END
