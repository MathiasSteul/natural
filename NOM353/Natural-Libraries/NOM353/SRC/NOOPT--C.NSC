* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* NOOPT--C
*
* Function: copycode to check grants for allow/disallow functions for
*           NGC
*
* Maintenance:
* xsetggr 2012-09-28 NOMALL-89 create
* CF1     2017-01-31 NOMALL-1990 Add depending object types
* --------------------------------------------------------------------
IF ES-USER-TYPE NE 'A'
  DECIDE FOR EVERY CONDITION
    WHEN #GRANTS(1) NE 'Y' AND #GRANTS(3) NE 'Y'
         I := I + 1
         #NEW-OPTIONS(I) := 'DL'
    WHEN NOT (#GRANTS(1:3) = 'Y')
         DECIDE ON FIRST VALUE OF ES-OBJECT
           VALUE 'PR', 'RP'
             I := I + 1
             #NEW-OPTIONS(I) := 'OP'
             I := I + 1
             #NEW-OPTIONS(I) := 'RN'
             I := I + 1
             #NEW-OPTIONS(I) := 'CP'
           VALUE 'AB'
             I := I + 1
             #NEW-OPTIONS(I) := 'OP'
             I := I + 1
             #NEW-OPTIONS(I) := 'PB'
             I := I + 1
             #NEW-OPTIONS(I) := 'CL'
             I := I + 1
             #NEW-OPTIONS(I) := 'AR'
             I := I + 1
             #NEW-OPTIONS(I) := 'RV'
/*           VALUE 'BN'                /* CF1
           VALUE 'BN', 'BR'            /* CF1
             I := I + 1
             #NEW-OPTIONS(I) := 'OP'
             I := I + 1
             #NEW-OPTIONS(I) := 'RN'
             I := I + 1
             #NEW-OPTIONS(I) := 'CP'
             I := I + 1
             #NEW-OPTIONS(I) := 'AB'
/*           VALUE 'DL'                /* CF1
           VALUE 'DL', 'MB'            /* CF1
             I := I + 1
             #NEW-OPTIONS(I) := 'OP'
             I := I + 1
             #NEW-OPTIONS(I) := 'RN'
             I := I + 1
             #NEW-OPTIONS(I) := 'AM'
           VALUE 'FO'
             I := I + 1
             #NEW-OPTIONS(I) := 'OP'
             I := I + 1
             #NEW-OPTIONS(I) := 'RN'
             I := I + 1
             #NEW-OPTIONS(I) := 'CP'
             I := I + 1
             #NEW-OPTIONS(I) := 'LN'
           NONE VALUE IGNORE
         END-DECIDE
    WHEN NOT (#GRANTS(1:4) = 'Y' )
             I := I + 1
             #NEW-OPTIONS(I) := 'DS'
*   WHEN NOT (#GRANTS(*) = 'Y')   /* not granted
*            I := I + 1
*            #NEW-OPTIONS(I) := 'LU'
    WHEN NONE IGNORE
  END-DECIDE
  CALLNAT 'NOOPT--N' #NEW-OPTIONS(*) #OPTIONS(*)
END-IF
* --------------------------------------------------------------------
