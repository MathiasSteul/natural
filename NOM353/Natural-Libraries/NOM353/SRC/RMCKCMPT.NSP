* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
*********************************************************************
* RMCKCMPT:  Test for correct compression routine NOMCOMPR          *
*            Writes 2 16k buffers, test NOMCOMPR with large buffers *
*                                                                   *
*            Test routine that calls RMCKMPR                        *
*                                                                   *
* fhi / SAG, 05/2014
*                                                                   *
* Maintenance:                                                      *
* userid  yyyy-mm-dd NOMALL      Comment                            *
* ----------------------------------------------------------------- *
* fhi     2014-05-21 NOMALL-1415 created.
*********************************************************************
*
DEFINE DATA
*
LOCAL
*
1 #CMPR-ERC                  (N4)
*                                   0: OK
*                                   1: not found
*                                   2: wrong version
*                                   3: compression failed
1 #CMPR-ERT                  (A250)
1 #TRACE                     (I1)   INIT <0>
*
*
END-DEFINE
FORMAT LS=131
*
CALLNAT 'RMCKCMPR' #CMPR-ERC #CMPR-ERT #TRACE
WRITE 'Check of compression routine executed. RMCKCMPR reports:' /
  '=' #CMPR-ERC /
  '=' #CMPR-ERT (AL=130)
*
END
