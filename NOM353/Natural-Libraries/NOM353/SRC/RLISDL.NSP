/*SU2 OPTIONS MCG=OFF
*
#ADD-PROGRAM := 'RDEFDL'
G-C-OBJTYPE := 'L'           /* xsetggr 2012-09-19 NOMALL-89 in
RESET CV-SLIST
/*SU1 INCLUDE CSTARTLS
INCLUDE CVIDEO
*
RESET G-COMMIT
CALLNAT 'NARPSEC' G-USER-PROFILE 'DDL' #ALLOWED
INCLUDE C-NALLOW
*
CALLNAT 'NARPSEC' G-USER-PROFILE 'MDL' #UPDATE
CALLNAT 'NARPSEC' G-USER-PROFILE 'PDL' #DELETE
*
#NEWVAL := TRUE
IF *DATA > 0
  INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT MARK *G-DIRECT-COMMAND
    USING MAP 'RLISDLM&'
END-IF
IF #S-LIST = ' ' AND #S-AUTHORIZATION = ' '
  #S-LIST          := +G-RLISDL-SEL-LIST
  #S-AUTHORIZATION := +G-RLISDL-SEL-AUTHORIZATION
ELSE
  +G-RLISDL-SEL-LIST          := #S-LIST
  +G-RLISDL-SEL-AUTHORIZATION := #S-AUTHORIZATION
END-IF
IF G-USER-TYPE = 'G' AND #S-LIST = ' '
  #S-AUTHORIZATION := G-USERID
END-IF
MAIN-LOOP. REPEAT
  IF #LANGUAGE NE *LANGUAGE
    CALLNAT 'ROTINI-N' ##EQO-LIST G-OBJ-TYPE G-OTB
    PERFORM INIT-PFKEYS
    PERFORM INIT-LINECOM
    #LANGUAGE := *LANGUAGE
  END-IF
  PERFORM SET-PFKEYS
  INCLUDE RMVHLP-C
*
  PERFORM GET-SCREEN
  RESET GET-SCREEN
*
  INCLUDE C-TOPBOT
*
  CALLNAT 'RFLIPG-N' G-LC G-LINECOM (*)
  PERFORM FLIP-DISPLAY
  SET CONTROL 'WB'
  CALLNAT 'N-HEADER' L-HEADER G-DATE-FORMAT 'RLISDLM&'
  INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT MARK *G-DIRECT-COMMAND
    USING MAP 'RLISDLM&'
  INCLUDE RPFKVA-C
  RESET G-NATRP-ERC G-NATRP-ERT #BROWSE-FLAGS
  INCLUDE C-DIRECT
  INCLUDE C-LOCCMD
  INCLUDE RPFKEX-C
  PERFORM LINE-COMMANDS
*
  IF CV-SELECTION(*) MODIFIED
    #NEWVAL := TRUE
    +G-RLISDL-SEL-LIST          := #S-LIST
    +G-RLISDL-SEL-AUTHORIZATION := #S-AUTHORIZATION
  END-IF
END-REPEAT
