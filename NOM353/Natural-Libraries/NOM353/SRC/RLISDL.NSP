************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE GET-SCREEN
************************************************************************
RESET L-MARK(*) L-IDENT (*)
IF #S-AUTHORIZATION = ' ' OR = '*' OR = 'ADMIN'
  PERFORM READ-ALL-LIST
ELSE
  PERFORM READ-GRANTED-LIST
END-IF
*
END-SUBROUTINE /* GET-SCREEN
*
************************************************************************
DEFINE SUBROUTINE READ-ALL-LIST
************************************************************************
DECIDE FOR EVERY  CONDITION
  WHEN #NEWVAL
    RESET #PAGES(*) #MAXP #MAXAP
    PERFORM INIT-SELECTION-KEYS
    #PAGES(1) := #START-KEY
    #CP := 1
    #MAXAP := 1
  WHEN #BOT
    #HP := #NOFPAGES / 2.
    #I := 0
    READ DISTRIBUTION-LIST BY D-LIST-NAME STARTING FROM #PAGES(1)
        ENDING AT     #S-LIST-T
      #I := #I + 1
      IF #I = 16
        IF #CP = #NOFPAGES
          #PAGES(#HP - 1 : #NOFPAGES - 1) := #PAGES(#HP : #NOFPAGES)
          RESET #PAGES(#CP)
          #CP := #CP - 1
        END-IF
        #CP := #CP + 1
        #PAGES(#CP) := D-LIST-NAME
        #I := 1
      END-IF
    END-READ
    #MAXAP := #CP
    #CP := 1
    #CP := #MAXAP
  WHEN #TOP
    #CP := 1
    INCLUDE C-FORWRD
  WHEN #BACKWARD
    IF #CP < 2
      IGNORE
    ELSE
      IF #SCROLL-AMOUNT < 1
        #SCROLL-AMOUNT := 1
      END-IF
      SUBTRACT #SCROLL-AMOUNT FROM #CP
      IF #CP < 1
        #CP := 1
      END-IF
    END-IF
  WHEN GET-SCREEN IGNORE
  WHEN NONE ESCAPE ROUTINE
END-DECIDE
*
IF #CP >= #MAXAP
  #MAXAP := #CP
END-IF
*
#RSTART := #PAGES(#CP)
RESET I L-SCREEN(*) #END-OF-DATA
CV-MARK(*) := (AD=P CD=BL)
*
READ-LOOP. READ DISTRIBUTION-LIST BY D-LIST-NAME = #RSTART
    ENDING AT #S-LIST-T
  AT START OF DATA
    #PAGES(#CP) := #TOPKEY := D-LIST-NAME
  END-START
*
  DISPLAY-IT := TRUE
  RESET GRANTED                  /* xsetggr 2012-09-19 NOMALL-89 in
  IF G-USER-TYPE = 'A'
    GRANTED := TRUE
    GRANTS.GR-OPTION(*) := 'Y'
    GRANTS.GR-USERID := 'ADMIN'
  ELSE
    GRANTS.GR-USERID             := G-USERID
    GRANTS.GR-OBJECT-NAME := D-LIST-NAME
    CALLNAT 'RGRANT-N' GRANTS.GR-USERID 'L' GRANTS.GR-OBJECT-NAME
      GRANTED GRANTS.GR-OPTION(*)
  END-IF
*
  REJECT
  IF NOT DISPLAY-IT OR NOT GRANTED
    ADD 1 TO I
    IF I > #NOFLINES
      #LAST-KEY := D-LIST-NAME
      ESCAPE ROUTINE
    END-IF
    IF I = 1
      #PAGES(#CP) := D-LIST-NAME
    END-IF
    RESET CV-MARK(I)
    #ISN := *ISN (READ-LOOP.)
    PERFORM DATA-TO-SCREEN
*
  END-READ
  #END-OF-DATA := TRUE
  #MAXP := #CP
*
  END-SUBROUTINE /* READ-ALL-LIST
*
************************************************************************
DEFINE SUBROUTINE READ-GRANTED-LIST
************************************************************************
DECIDE FOR EVERY  CONDITION
  WHEN #NEWVAL
    RESET #PAGES(*) #MAXP #MAXAP
    PERFORM INIT-SELECTION-KEYS
    #PAGES(1) := #START-KEY
    #CP := 1
    #HP := #NOFPAGES / 2.
    #I := 0
    READ GRANTS BY GR-SUPER STARTING FROM #PAGES (1)
      #I := #I +1
      IF #I = 16
        IF #CP = #NOFPAGES
          #PAGES(#HP - 1 : #NOFPAGES - 1) := #PAGES(#HP : #NOFPAGES)
          RESET #PAGES(#CP)
          #CP := #CP - 1
        END-IF
        #CP := #CP + 1
        #PAGES(#CP) := D-LIST-NAME
        #I := 1
      END-IF
    END-READ
    #MAXAP := #CP
    #CP:=1
  WHEN #BOT
    #CP := #MAXAP
  WHEN #TOP
    #CP := 1
*
    INCLUDE C-FORWRD
  WHEN #BACKWARD
    IF #CP < 2
      IGNORE
    ELSE
      IF #SCROLL-AMOUNT < 1
        #SCROLL-AMOUNT := 1
      END-IF
      SUBTRACT #SCROLL-AMOUNT FROM #CP
      IF #CP < 1
        #CP := 1
      END-IF
    END-IF
  WHEN GET-SCREEN IGNORE
  WHEN NONE ESCAPE ROUTINE
END-DECIDE
*
IF #CP >= #MAXAP
  #MAXAP := #CP
END-IF
*
RESET I L-SCREEN(*) #END-OF-DATA
CV-MARK(*) := (AD=P CD=BL)
* xsetggr 2003-08-11 p(240465) insert line
#RSTART := #PAGES(#CP)
*
READ-LOOP-GRANT.
READ GRANTS BY GR-SUPER STARTING FROM #RSTART
  IF GR-OBJECT-TYPE NE #T-TYPE OR GR-USERID NE #T-USERID    OR
      GR-OBJECT-NAME > #T-OBJECT-NAME
    ESCAPE BOTTOM (READ-LOOP-GRANT.)
  END-IF
  FIND-LOOP.
  FIND DISTRIBUTION-LIST WITH D-LIST-NAME = GRANTS.GR-OBJECT-NAME
*
    IF G-USER-TYPE = 'A'
      GRANTED := TRUE
      GRANTS.GR-OPTION(*) := 'Y'
    END-IF
*
    ADD 1 TO I
*
    IF I > #NOFLINES
      #L-TYPE := GRANTS.GR-OBJECT-TYPE
      #L-USERID := GRANTS.GR-USERID
      #L-OBJECT-NAME := D-LIST-NAME
      ESCAPE ROUTINE
    END-IF
    IF I = 1
      #F-TYPE (#CP) := GRANTS.GR-OBJECT-TYPE
      #F-USERID (#CP) := GRANTS.GR-USERID
      #F-OBJECT-NAME (#CP) := D-LIST-NAME
      #TOPKEY := #PAGES(#CP)
    END-IF
*
    RESET CV-MARK(I)
    #ISN := *ISN (READ-LOOP.)
    PERFORM DATA-TO-SCREEN
*
  END-FIND
END-READ
#END-OF-DATA := TRUE
#MAXP := #CP
*
END-SUBROUTINE /* READ-GRANTED-LIST
*
************************************************************************
DEFINE SUBROUTINE DATA-TO-SCREEN
************************************************************************
L-NAME(I) := DISTRIBUTION-LIST.D-LIST-NAME
L-DESC(I) := DISTRIBUTION-LIST.D-LIST-DESC
L-MEMBERS(I) := DISTRIBUTION-LIST.C*D-USER-LIST
FIND-PART.
FIND NUMBER LISTS WITH D-USER-LIST = L-NAME(I)
IF *NUMBER(FIND-PART.) > 0
  L-PART(I) := '*'
ELSE
  RESET L-PART(I)
END-IF
L-ISN(I) := #ISN
L-OPTION(I,1:6) := GRANTS.GR-OPTION(1:6)
L-AUTHORIZATION (I) := GRANTS.GR-USERID
RESET CV-MARK(I)
*
END-SUBROUTINE /* DATA-TO-SCREEN
*
************************************************************************
DEFINE SUBROUTINE LINE-COMMANDS
************************************************************************
IF L-MARK(*) = '.'
  END TRANSACTION
  INCLUDE C-ESCAPE
END-IF
INCLUDE RLCMTI-C
* --- VALIDATE LINE COMMANDS
INCLUDE C-CHKLC            /* xsetggr 2012-09-19 NOMALL-89 in
* ---- DELETE FUNCTION
FOR I 1 TO #NOFLINES
  IF L-IDENT (I) = ##EQU-DELETE
    G-C-LIST := L-NAME(I)
    GET-SCREEN := TRUE
    FETCH RETURN 'RDELDL'
  END-IF
END-FOR
* --- OTHER LINE COMMANDS
FOR I 1 TO #NOFLINES
  DECIDE ON FIRST VALUE OF L-IDENT (I)
    VALUE ##EQU-LOG
      G-C-LIST :=        L-NAME(I)
      FETCH RETURN 'RLISLG' 'LM' G-C-LIST
    VALUE ##EQU-LIST-MEMBERS
      PERFORM COMMIT-WORK
      G-C-LIST          := L-NAME(I)
      G-C-FUNC := 'V'
      FETCH RETURN 'RLISDM'
      GET-SCREEN := TRUE
    VALUE ##EQU-AUTHORIZE
      PERFORM COMMIT-WORK
      G-C-OBJNAME := L-NAME(I)
      G-FATHER-PROG := *PROGRAM
      G-C-OBJTYPE := 'L'
      G-C-GRANTS(1:6) := L-OPTION(I,1:6)
      FETCH RETURN 'RLISGR'
    VALUE ##EQU-MODIFY
      PERFORM COMMIT-WORK
      G-C-LIST := L-NAME(I)
      G-FATHER-PROG := *PROGRAM
      G-C-FUNC := 'M'
      FETCH RETURN 'RDEFDL'
      GET-SCREEN := TRUE
    VALUE ##EQU-ADD
      PERFORM COMMIT-WORK
      G-C-LIST := L-NAME(I)
      G-FATHER-PROG := *PROGRAM
      FETCH RETURN 'RADDLM'
      GET-SCREEN := TRUE
    VALUE ##EQU-RENAME
      G-C-LIST :=        L-NAME(I)
      FETCH RETURN 'RRENDL'
      GET-SCREEN := TRUE
    VALUE ##EQU-XREF
      G-C-LIST :=        L-NAME(I)
      FETCH RETURN 'RXRFDL'
    NONE VALUE IGNORE
  END-DECIDE        /* (0320)
END-FOR           /* (0298)
*
END-SUBROUTINE /* LINE-COMMANDS
*
************************************************************************
DEFINE SUBROUTINE INIT-SELECTION-KEYS
************************************************************************
PERFORM VALIDATE-SELECTION-KEYS
#LEN := 8
CALLNAT 'SELALPHA' #S-LIST #S-LIST-F  #S-LIST-T #LEN
#START-KEY := #S-LIST-F
IF #S-AUTHORIZATION NE ' '
  #S-USERID                 := #S-AUTHORIZATION
  #T-USERID                 := #S-AUTHORIZATION
  #S-USERID                 := #S-AUTHORIZATION
  #T-USERID                 := #S-AUTHORIZATION
  #S-TYPE                   := 'L'
  #S-OBJECT-NAME            := #S-LIST-F
  #T-TYPE                   := 'L'
  #T-OBJECT-NAME            := #S-LIST-T
END-IF
*
END-SUBROUTINE /* INIT-SELECTION-KEYS
*
************************************************************************
DEFINE SUBROUTINE INIT-LINECOM
************************************************************************
G-LC-IDENT (01) := ##EQU-MODIFY
G-LC-IDENT (02) := ##EQU-DELETE
G-LC-IDENT (03) := ##EQU-RENAME
G-LC-IDENT (04) := ##EQU-AUTHORIZE
G-LC-IDENT (05) := ##EQU-LOG
G-LC-IDENT (06) := ##EQU-ADD
G-LC-IDENT (07) := ##EQU-LIST-MEMBERS
G-LC-IDENT (08) := ##EQU-XREF
G-LC-NUM               := 8
CALLNAT 'RLCINI-N' G-OBJ-TYPE G-LC G-LCB
*
END-SUBROUTINE
*
************************************************************************
DEFINE SUBROUTINE INIT-PFKEYS
************************************************************************
INCLUDE RPFSTD-C
INCLUDE RPFADD-C
INCLUDE RPFBRW-C
CALLNAT 'RPFINI-N' G-PF G-PFB
*
END-SUBROUTINE
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-SELECTION-KEYS
************************************************************************
DECIDE FOR FIRST CONDITION
  WHEN G-USER-TYPE = 'A' AND #S-AUTHORIZATION = 'ADMIN'
    RESET #S-AUTHORIZATION
  WHEN #S-AUTHORIZATION = '*' OR = ' '
    RESET #S-AUTHORIZATION
  WHEN #S-AUTHORIZATION = G-USERID
    IGNORE
  WHEN #S-AUTHORIZATION = 'PUBLIC'
    IGNORE
  WHEN NONE
    IF G-USER-TYPE NE 'A'
      FNDL. FIND NUMBER LIST WITH D-LIST-NAME = #S-AUTHORIZATION
        AND D-USER-LIST = G-USERID
      IF *NUMBER (FNDL.) = 0
        REINPUT *0911 MARK *#S-AUTHORIZATION ALARM
      END-IF
    END-IF
END-DECIDE
*
END-SUBROUTINE /* VALIDATE-SELECTION-KEYS
*
INCLUDE RPFSET-C
*
END
