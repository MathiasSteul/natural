* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* NOLCFF1N - NOM API Folder Maintenance - Functions: AR exist
*
* Maintenance:
* XSETGGR 2008-02-08 created
* xsetggr 2008-02-16 get-msg-txt
* XSETHZ  2008-07-23 p(307577) use full name of ES-APP-SERVER-LIBRARY
* xsetggr 2010-07-07 NOMALL-833 correct browsable location flag
* xsetggr 2010-09-20 NOMALL-870 backouted NOMALL-833 changes
* XSETHZ  2010-12-15 NOMALL-907
* xsetggr 2011-07-07 NOMALL-1025 prevent NAT1305 for counters
* XSETHZ  2011-10-27 NOMALL-1069 optimization (created from NOLCFF-N)
* XSETHZ  2012-01-03 NOMALL-1098 Unix spool
* XSETHZ  2013-02-14 ES-1499 (new descriptors in NRM-MAIL)
* RAYA    2013-09-12 NOMALL-1278 new superdescriptor for filtering mails
* SU1     2018-02-13 NOMALL-1823 NOM 3.5: remove CONNECT
* fhi     2019-05-13 NOMALL-2272 Correct evaluation of time inverted
* ----------------------------------------------------------------------
DEFINE DATA
PARAMETER USING ESMCNT-A
PARAMETER USING ESMINP-A
************************************************************************
LOCAL USING NOARSL-A
LOCAL USING NADA2000
LOCAL USING NAD-MSG
LOCAL USING NAD-FLD
LOCAL USING CONST-L
LOCAL
1 FO VIEW OF NRM-FOLDER
  2 FO-ID
  2 FO-NAME
  2 FO-LINKED-FO-ID
  2 FO-USER-ID
1 LINKED-FO VIEW OF NRM-FOLDER
  2 FO-ID
  2 FO-USER-ID
  2 FO-NAME
  2 FO-LINKED-FO-ID
  2 REDEFINE FO-LINKED-FO-ID
    3 FO-LINKED-USER-ID  (A8)
    3 FO-LINKED-ID       (B2)
1 MA VIEW OF NRM-MAIL
  2 MA-REPNAME
  2 MA-REPRNB
  2 MA-USERID
  2 MA-FO-ID
  2 MA-CURRENT-LOCATION
1 ACTIVE-REPORTS VIEW OF NRM-ACTIVE-REPORTS
  2 AR-CURRENT-LOCATION
  2 AR-REPNAME
  2 AR-REPRNB
  2 AR-SENDER
  2 AR-KEYWORDS (6)
  2 AR-PROCESS-TIME
  2 AR-EXPIRATION
  2 AR-ARCHIVE
  2 AR-REVIVE
1 #FO-USER-NAME      (A24)
1 REDEFINE #FO-USER-NAME
  2 #FO-USERID       (A8)
  2 #FO-NAME         (A16)
1 #MA-FOLDER-PROCESS-TIME    (A17)
1 REDEFINE #MA-FOLDER-PROCESS-TIME
  2 #MA-USERID       (A8)
  2 #MA-FO-ID        (B2)
  2 #MA-PROCESS-TIME-INV     (P13)
1 #AR-REP-RNB        (A31)
1 REDEFINE #AR-REP-RNB
  2 #AR-REPNAME      (A25)
  2 #AR-REPRNB       (P11)
1 #L                 (I4)
1 #K                 (I4)
1 #ES-MSG-PREF       (A7) INIT <'NOM'>
1 REDEFINE #ES-MSG-PREF
  2 #ES-MSG-NOM      (A3)
  2 #ES-MSG-NR       (N4)
1 #MA-FOLDER-PROCESS-TIME-E  (A17)
1 #MAILED            (L)
1 #S-USER-FO-ID      (A10)
1 REDEFINE #S-USER-FO-ID
  2 #S-USER          (A8)
  2 #S-FO-ID         (B2)
1 #MA-FOLDER-REP     (A41)
1 REDEFINE #MA-FOLDER-REP
  2 #MA-USERID-R     (A8)
  2 #MA-FO-ID-R      (B2)
  2 #MA-REPNAME      (A25)
  2 #MA-REPR         (P11)
1 #MA-FOLDER-REP-E   (A41)
1 #ISN-SET           (A16)
1 #NUMBER-IN-SET     (I4)
1 #START-IN-SET      (I4)
1 #F-DATE-C          (T)
1 REDEFINE #F-DATE-C
  2 #F-DATE-C-P      (P13)
1 #T-DATE-C          (T)
1 REDEFINE #T-DATE-C
  2 #T-DATE-C-P      (P13)
1 #DATE-14           (A14)
1 #SOURCE-F          (A17)
1 #SOURCE-T          (A17)
1 #SENDER-F          (A17)
1 #SENDER-T          (A17)
1 #SELECTED          (L)
1 #TIMEOUT           (T)
1 #IA (I4)
1 #ID (I4)
1 #IS (I4)
1 #IT (I4)
1 #IN (I4)
1 #NA (I4)
1 #ND (I4)
1 #NS (I4)
1 #NT (I4)
1 #NN (I4)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
IF ES-CLIENT-TIMEOUT > 10 AND ES-CLIENT-TIMEOUT < 9999
  #TIMEOUT := *TIMX + (ES-CLIENT-TIMEOUT - 10) * 10
END-IF
ES-EOF := 'X'
RESET ES-RC
#NOARSL := ES-SELECT
* PRINT *PROGRAM *LINE 'HEB-KY' 'Start' / '=' #NOARSL  /* HEB-TEMP
COMPRESS ES-USER *PROGRAM TO #ISN-SET LEAVING NO
IF #SETNAME = 'SETNAME'
  #START-IN-SET := #START-ISN
  PERFORM CHECK-AR
  ES-SELECT := #NOARSL
  ESCAPE ROUTINE
END-IF
#FO-USERID := ES-USER
#FO-NAME   := ES-KEY-PARM(1)
IF #FO-NAME = '#Inbasket' OR = '#Listeneingang'
  #S-USER := #FO-USERID
  #S-FO-ID := 1
  FIND FO WITH FO-USER-FO-ID = #S-USER-FO-ID
    #FO-NAME := FO.FO-NAME
  END-FIND
END-IF
FIND FO WITH FO-USER-NAME = #FO-USER-NAME
  IF NO RECORDS FOUND
    ES-MSG-NR := 0352           /* folder not defined
    PERFORM GET-MSG-TXT
    ESCAPE ROUTINE
  END-NOREC
  LINKED-FO.FO-ID           := FO.FO-ID
  LINKED-FO.FO-USER-ID      := FO.FO-USER-ID
  LINKED-FO.FO-LINKED-FO-ID := FO.FO-LINKED-FO-ID
  IF LINKED-FO.FO-LINKED-FO-ID = ' '
    PERFORM CHECK-MAIL
  END-IF
  R. REPEAT WHILE LINKED-FO.FO-LINKED-FO-ID NE ' '
    #S-USER  := LINKED-FO.FO-LINKED-USER-ID
    #S-FO-ID := LINKED-FO.FO-LINKED-ID
    FIND LINKED-FO WITH FO-USER-FO-ID = #S-USER-FO-ID
      IF NO RECORDS FOUND
        ESCAPE BOTTOM (R.)
      END-NOREC
      IF LINKED-FO.FO-LINKED-FO-ID = ' '
        PERFORM CHECK-MAIL
      END-IF
    END-FIND
  END-REPEAT
  ES-SELECT := #NOARSL
END-FIND
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE CHECK-MAIL
************************************************************************
RESET #MAILED
#MA-USERID   := LINKED-FO.FO-USER-ID
#MA-FO-ID    := LINKED-FO.FO-ID
#MA-USERID-R := LINKED-FO.FO-USER-ID
#MA-FO-ID-R  := LINKED-FO.FO-ID
IF #CREAT-DATE-FROM = ' '
  #T-DATE-C-P := #CONST-INV-TIME
ELSE
  IF #CREAT-TIME-FROM = ' '
    COMPRESS #CREAT-DATE-FROM '000000' TO #DATE-14 LEAVING NO
  ELSE
    COMPRESS #CREAT-DATE-FROM SUBSTRING(#CREAT-TIME-FROM,1,4) '00'
      TO #DATE-14 LEAVING NO
  END-IF
  MOVE EDITED #DATE-14 TO #T-DATE-C(EM=YYYYMMDDHHIISS)
  #T-DATE-C-P := #CONST-INV-TIME - #T-DATE-C-P
END-IF
IF #CREAT-DATE-TO = ' '
  #F-DATE-C-P := 0
ELSE
  IF #CREAT-TIME-TO = ' '
    COMPRESS #CREAT-DATE-TO '000000' TO #DATE-14 LEAVING NO
  ELSE
    COMPRESS #CREAT-DATE-TO SUBSTRING(#CREAT-TIME-TO,1,4) '59'
      TO #DATE-14 LEAVING NO
  END-IF
  MOVE EDITED #DATE-14 TO #F-DATE-C(EM=YYYYMMDDHHIISS)
  #F-DATE-C-P := #CONST-INV-TIME - #F-DATE-C-P
END-IF
#MA-PROCESS-TIME-INV := #T-DATE-C-P
#MA-FOLDER-PROCESS-TIME-E := #MA-FOLDER-PROCESS-TIME
#MA-PROCESS-TIME-INV := #F-DATE-C-P
EXAMINE #NOARSL.#REPNAME FOR '*' DELETE
IF #NOARSL.#POSTFIX NE 'Y'
  COMPRESS #NOARSL.#REPNAME H'FF' TO #MA-REPNAME LEAVING NO
  #MA-FOLDER-REP-E := #MA-FOLDER-REP
  #MA-REPNAME := #NOARSL.#REPNAME
ELSE
  #MA-REPNAME := H'FF'
  #MA-FOLDER-REP-E := #MA-FOLDER-REP
  #MA-REPNAME := ' '
END-IF
/*
IF #MA-REPNAME NE ' ' OR #MA-REPNAME =  ' ' AND
    #CREAT-DATE-FROM = ' ' AND #CREAT-DATE-TO = ' '
  FN1. FIND NUMBER MA
    WITH MA-FOLDER-REP-RNB = #MA-FOLDER-REP THRU #MA-FOLDER-REP-E
    RETAIN AS #ISN-SET
  #NUMBER-IN-SET := *NUMBER (FN1.)
END-IF
IF (#CREAT-DATE-FROM NE ' ' OR #CREAT-DATE-TO NE ' ')
  IF #NUMBER-IN-SET > 0
    FN2. FIND NUMBER MA WITH MA-FOLDER-PROCESS-TIME =
      #MA-FOLDER-PROCESS-TIME THRU #MA-FOLDER-PROCESS-TIME-E
      AND #ISN-SET
      RETAIN AS #ISN-SET
    #NUMBER-IN-SET := *NUMBER (FN2.)
  ELSE
    FN3. FIND NUMBER MA WITH MA-FOLDER-PROCESS-TIME =
      #MA-FOLDER-PROCESS-TIME THRU #MA-FOLDER-PROCESS-TIME-E
      RETAIN AS #ISN-SET
    #NUMBER-IN-SET := *NUMBER (FN3.)
  END-IF
END-IF
#SETNAME := 'SETNAME'
#START-ISN := 0
#AR-NUMBER := #NUMBER-IN-SET
ES-SELECT := #NOARSL
#START-IN-SET := 0
PERFORM CHECK-AR
*
END-SUBROUTINE /* CHECK-MAIL
*
************************************************************************
DEFINE SUBROUTINE CHECK-AR
************************************************************************
#SETNAME := 'SETNAME'
IF #START-IN-SET = 0
  #AR-EXIST(*) := '1'
  #AR-EXIST(6) := ' '
END-IF
IF #CREAT-DATE-FROM = ' '
  MOVE EDITED '19000101000000' TO #F-DATE-C(EM=YYYYMMDDHHIISS)
ELSE
  IF #CREAT-TIME-FROM = ' '
    COMPRESS #CREAT-DATE-FROM '000000' TO #DATE-14 LEAVING NO
  ELSE
    COMPRESS #CREAT-DATE-FROM SUBSTRING(#CREAT-TIME-FROM,1,4) '00'
      TO #DATE-14 LEAVING NO
  END-IF
  MOVE EDITED #DATE-14 TO #F-DATE-C(EM=YYYYMMDDHHIISS)
END-IF
IF #CREAT-DATE-TO = ' '
  MOVE EDITED '20991231235959' TO #T-DATE-C(EM=YYYYMMDDHHIISS)
ELSE
  IF #CREAT-TIME-TO = ' '
    COMPRESS #CREAT-DATE-TO '235959' TO #DATE-14 LEAVING NO
  ELSE
    COMPRESS #CREAT-DATE-TO SUBSTRING(#CREAT-TIME-TO,1,4) '59'
      TO #DATE-14 LEAVING NO
  END-IF
  MOVE EDITED #DATE-14 TO #T-DATE-C(EM=YYYYMMDDHHIISS)
END-IF
EXAMINE #NOARSL.#KEYWORD FOR '*' DELETE
EXAMINE #NOARSL.#SOURCE FOR '*' DELETE
EXAMINE #NOARSL.#SENDER FOR '*' DELETE
COMPRESS #NOARSL.#SOURCE H'00' TO #SOURCE-F LEAVING NO
COMPRESS #NOARSL.#SOURCE H'FF' TO #SOURCE-T LEAVING NO
COMPRESS #NOARSL.#SENDER H'00' TO #SENDER-F LEAVING NO
COMPRESS #NOARSL.#SENDER H'FF' TO #SENDER-T LEAVING NO
F. FIND MA WITH #ISN-SET STARTING WITH ISN = #START-IN-SET
  #START-ISN := *ISN(F.)
  #AR-REPNAME := MA-REPNAME
  #AR-REPRNB  := MA-REPRNB
  FNDAR. FIND ACTIVE-REPORTS WITH AR-REPORT-RNB = #AR-REP-RNB
    PERFORM SELECT-RECORD
    IF #SELECTED
      DECIDE ON FIRST VALUE OF MA-CURRENT-LOCATION
        VALUE 'A' ADD 1 TO #NA
        VALUE 'D' ADD 1 TO #ND
        VALUE 'S' ADD 1 TO #NS
        VALUE ' ' ADD 1 TO #NT
        NONE      ADD 1 TO #NN
      END-DECIDE
      DECIDE ON FIRST VALUE OF AR-CURRENT-LOCATION
        VALUE  'A'
          #AR-EXIST(2) := '0'
          #IA := #IA + 1
        VALUE  'D'
          #AR-EXIST(4) := '0'
          #ID := #ID + 1
        VALUE  'S'
          #AR-EXIST(5) := '0'
          #IS := #IS + 1
        VALUE  ' '
          #IT := #IT + 1
        NONE VALUE /* IGNORE
          #IN := #IN + 1
      END-DECIDE
      IF #AR-EXIST(4:6) = '0'
        #AR-EXIST(3) := '0'
      END-IF
      IF #AR-EXIST(2:6) = '0'
        #AR-EXIST(1) := '0'
      END-IF
    END-IF
  END-FIND
  IF *MACHINE-CLASS = 'MAINFRAME' AND SUBSTR(#AR-EXIST-6,1,5) = 'X0000'
  OR *MACHINE-CLASS NE 'MAINFRAME' AND SUBSTR(#AR-EXIST-6,1,5) = 'X0000'
    #START-ISN := 0
    ES-NUMBER  := *COUNTER(F.)
    RELEASE SET #ISN-SET
    ES-SELECT := #NOARSL
    ESCAPE ROUTINE
  END-IF
  IF *TIMX > #TIMEOUT
    ES-NUMBER  := *COUNTER(F.)
    ES-EOF     := ' '
    ES-SELECT := #NOARSL
    ESCAPE ROUTINE
  END-IF
END-FIND
#START-ISN := 0
ES-NUMBER  := *COUNTER(F.)
RELEASE SET #ISN-SET
ES-SELECT := #NOARSL
COMPRESS ES-MSG-TXT #IA #ID #IS #IT #IN #NA #ND #NS #NT #NN
  TO ES-MSG-TXT
*
END-SUBROUTINE /* CHECK-AR
*
************************************************************************
DEFINE SUBROUTINE SELECT-RECORD
************************************************************************
#SELECTED := TRUE
DECIDE FOR EVERY CONDITION
  WHEN #NOARSL.#SENDER NE ' ' AND
      NOT (ACTIVE-REPORTS.AR-SENDER = #SENDER-F THRU #SENDER-T)
    #SELECTED := FALSE
    ESCAPE ROUTINE
  WHEN #NOARSL.#KEYWORD NE ' '
    #SELECTED := FALSE
    EXAMINE #NOARSL.#KEYWORD FOR H'00' GIVING LENGTH #L
    FOR #K = 1 TO 6
      IF SUBSTRING(ACTIVE-REPORTS.AR-KEYWORDS(#K),1,#L)
          = #NOARSL.#KEYWORD
        #SELECTED := TRUE
        ESCAPE BOTTOM
      END-IF
    END-FOR
    IF NOT #SELECTED
      ESCAPE ROUTINE
    END-IF
  WHEN NOT (ACTIVE-REPORTS.AR-PROCESS-TIME = #F-DATE-C THRU #T-DATE-C)
    #SELECTED := FALSE
    ESCAPE ROUTINE
  WHEN #NOARSL.#POSTFIX = 'Y' AND #NOARSL.#REPNAME NE ' ' AND
      ACTIVE-REPORTS.AR-REPNAME NE SCAN #NOARSL.#REPNAME
    #SELECTED := FALSE
    ESCAPE ROUTINE
  WHEN #NOARSL.#EXPIR-DATE NE ' ' AND
      ACTIVE-REPORTS.AR-EXPIRATION NE #NOARSL.#EXPIR-DATE
    #SELECTED := FALSE
    ESCAPE ROUTINE
  WHEN #NOARSL.#ARCHIVE NE ' ' AND
      #NOARSL.#ARCHIVE NE ACTIVE-REPORTS.AR-ARCHIVE
    #SELECTED := FALSE
    ESCAPE ROUTINE
  WHEN #NOARSL.#REVIVE NE ' ' AND
      #NOARSL.#REVIVE NE ACTIVE-REPORTS.AR-REVIVE
    #SELECTED := FALSE
    ESCAPE ROUTINE
  WHEN #NOARSL.#LOCATION NE ' ' AND
      #NOARSL.#LOCATION NE ACTIVE-REPORTS.AR-CURRENT-LOCATION
    #SELECTED := FALSE
  WHEN NONE IGNORE
END-DECIDE
*
END-SUBROUTINE /* SELECT-RECORD
*
************************************************************************
DEFINE SUBROUTINE GET-MSG-TXT
************************************************************************
RESET SHORT-MSG LONG-MSG(*)
VERSION := 0
NADA2000.OBJECT-KIND := 'U'
NADA2000.ERROR-NUMBER := ES-MSG-NR
NADA2000.OPT-INSERT-DYN := FALSE
NADA2000.OPT-LANGUAGE := ES-LANGUAGE
NADA2000.LIBRARY := ES-APP-SERVER-LIBRARY
CALLNAT 'NATA2000' NADA2000 NATA2000.EXTENDED-PARMS NAD-MSG NAD-FLD
ES-MSG-TXT   := SHORT-MSG
EXAMINE ES-MSG-TXT FOR #ES-MSG-PREF DELETE
ES-RC := 1
*
END-SUBROUTINE /* SELECT-RECORD
*
************************************************************************
ON ERROR
************************************************************************
  ES-RC := 1
  COMPRESS *PROGRAM 'Error' *ERROR-NR 'in line' *ERROR-LINE
    TO ES-MSG-TXT
  ESCAPE ROUTINE
*
END-ERROR
*
END
