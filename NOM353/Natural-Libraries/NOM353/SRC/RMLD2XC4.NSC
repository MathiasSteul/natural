* <Natural Source Header
* RMLD2XC4 - Copy code for RMLD2XML with object type NO
*                                                                       ********
* Maintenance
* User ID   yyyy-mm-dd Issue       Remark
* --------------------------------------------------------------------- --------
* fhi       2019-02-21 NOMALL-2215 Created.
* SU1     2020-11-10 NOMALL-2440 split DDM -> NRM-MF-NODES
* SU2     2021-02-17 NOMALL-2443 use of PDA RMEXP-A
************************************** data ************************************
#EXPORT-PROG := &2&
FIND MF-NODE WITH MF-INTERNAL-NODE-ID = &1&
  COMPRESS SUBSTR(#EXPORT-PROG,6,2) MF-MONITOR-ID
    TO #ID-MEMBER LEAVING NO
  EXAMINE +ID(*) FOR #ID-MEMBER GIVING INDEX #IND
  IF #IND = 0
    CALLNAT &2& XXUX---P #EXPORT #TRACING MF-MONITOR-ID /*SU2 was ORDER
    IF #OD-ERROR-CODE NE 0
      ESCAPE MODULE
    END-IF
    IF +ID-INDEX GE *OCC(+ID)
      #IND := +ID-INDEX + 10
      EXPAND ARRAY +ID TO (1:#IND)
    END-IF
    ADD 1 TO +ID-INDEX
    +ID (+ID-INDEX) := #ID-MEMBER
  END-IF
END-FIND
** End of Copycode RMLD2XC4 ********************************************
