* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    XXRANDOM
* Function  Calculate a random number between 0 and 1 (exclusive)
*
* Maintenance
* uuu    yyyy-mm-dd s(999999) ...
* fhi    2007-01-31 created
* fhi    2010-11-12 NOMALL-856 renamed  RANDOM to this one.
* ----------------------------------------------------------------------
*
DEFINE DATA PARAMETER
1 RANDOM             (F8) /* OUTPUT only
*
INDEPENDENT
1 +SEED              (F8)
*
LOCAL
1  #TIM-A            (A8)
1  REDEFINE #TIM-A
  2  #TIM-FILLER     (A4)
  2  #TIM-B          (B4)
1 #LOG               (F8)
*
END-DEFINE
* --------------------------------------- main -------------------------
REPEAT UNTIL +SEED NE 0
  #TIM-A    := *TIMESTMP
  +SEED     := #TIM-B
  #LOG      := LOG(+SEED) / LOG(10)
  #LOG      := INT(#LOG)    /* round it
  #LOG      := #LOG + 1     /* number of digits of +SEED
  +SEED     := +SEED / (10 ** #LOG)
END-REPEAT
+SEED   := +SEED * 997 /* last prime number before 1000
+SEED   := FRAC(+SEED) /* must be between 0 and 1
+SEED   := ABS(+SEED)  /* must be between 0 and 1
RANDOM  := +SEED
END
* --------------------------------------- end --------------------------
