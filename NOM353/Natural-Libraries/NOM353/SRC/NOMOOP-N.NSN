DEFINE DATA
PARAMETER USING ESMCNT-A
PARAMETER USING ESMINP-A
PARAMETER USING NOMOOP-A
************************************************************************
/*SU6 LOCAL USING VMONIT-L
/*SU6 LOCAL USING VMONITUL
LOCAL USING VUSARC-L
LOCAL USING NOUSUP-L
LOCAL USING SATVI--A
LOCAL USING EDIT-CB
LOCAL USING NOMVER-A
LOCAL USING NOMVI-2A
*
LOCAL
1 NRM-MONITOR VIEW OF NRM-MONITOR /*SU6 was VMONIT-L
  2 M-TIME-SCHEDULE       (A1) /*SU6 ???? not used in Monitor record     ÜÜ
  2 M-WAIT-CURRENT        (P9)
  2 M-MONITOR-ID          (A20)
  2 M-USE-OWNER           (A1)
  2 M-SUPPORT-LONG-NAMES  (A1)
  2 M-STATUS              (A1)
  2 M-NATRPT-DBID-N5      (N5)
  2 M-NATRPT-FNR-N5       (N5)
  2 M-DATE-FORMAT         (A1)
  2 M-LAST-ARCHIVE-NO     (N4)
  2 M-ARCHIVE-PREFIX      (A30)
  2 M-RETENTION-PERIOD    (N4)
  2 M-LOG-RETENTION       (A5)
  2 M-LOG-TYPES           (A1/1:10)
  2 M-BUNDLE-RETENTION    (N4)
  2 M-ARCHIVE-RETENTION   (A5)
  2 M-DEFAULT-PRINTER     (A8)
  2 M-REPORT-DEFAULTS     (A253)
  2 M-BUNDLE-DEFAULTS     (A250)
  2 M-USER-DEFAULTS       (A100)
  2 M-PO-RETENTION        (A5)
  2 M-PO-TYPES            (A1/1:3)
  2 M-JOBCARD             (A72/1:3)
  2 M-DEFAULT-JOBCARD     (A80)
  2 M-USER-AUTODEF        (A1)
1 MF-NODE VIEW OF NRM-MF-NODES /*SU6 was VMONITUL
  2 MF-SPOOL-TYPE         (A8)
  2 MF-SYSTEM-TYPE        (A8)
  2 MF-MONITOR-NODE       (N5)
  2 MF-TEMP-CLASS         (A4)
  2 MF-PRINT-CLASS        (A1)
  2 MF-CLASSES            (A1/1:20)
  2 MF-JES3-OUTPUT-CLASSES(A1/1:20)
  2 MF-BS2-DEST           (A8/1:4)
  2 MF-ERR-CLASS          (A1)
1 US VIEW OF NRM-USERS
  2 USER-PROFILE
1 SYSTEM-INFO  VIEW OF SYSTEM-INFO
  2 ERROR-CODE
  2 SYSTEM-TYPE
  2 SYSTEM-RELEASE
  2 SPOOL-TYPE
  2 SYSTEM-ID
  2 ESY-VERSION
* *****
1 #DATE-P                 (P13)
1 #USERARC-ID             (A10)   INIT <'USERARC01'>
1 #USERARC-ID-E           (A10)   INIT <'USERARC09'>
1 #I                      (I2)
1 #LIB                    (A8)
1 #BUNDLE-DEFAULTS        (A250)
1 REDEFINE #BUNDLE-DEFAULTS
  2 #BUNDDEF
    3 B-CHAR-FIELDS1      (A40)
    3 B-FLUSH-TIME        (T)
    3 REDEFINE B-FLUSH-TIME
      4 B-FLUSH-TIME-A    (A7)
    3 B-CHAR-FIELDS2      (A197)
1 #T1                     (T)
1 P-ERC                   (N4)
1 P-ERT                   (A250)
1 #DATE-A8                (A8)
1 #NATDATE                (D)
1 P-VERSION-A10           (A10)
1 REDEFINE P-VERSION-A10
  2 #VER                  (N2)
  2 #REL                  (N2)
  2 #SM                   (N2)
1 #CHARTAB                (A36)  CONST /* from ESMAVC-N SU7 ->
  <'0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ'>
1 #I3                     (I1) /*SU7 <-
1 #MF                     (L) /*SU8
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
IF *MACHINE-CLASS = 'MAINFRAME' /*SU8
  #MF := TRUE
END-IF
#LIB := ES-APP-SERVER-LIBRARY
IF #LIB = ' '
  CALLNAT 'RGETLIB' #LIB /* will give tests a better result...
END-IF
ES-RC := 0
DECIDE ON FIRST VALUE OF ES-ORIG-FUNCTION
  VALUE 'OP'
    IF ES-EXTEND-FUNCTION = 'UPD'
      PERFORM UPD-MON-RECORD
    ELSE
      PERFORM READ-RECORD
    END-IF
  NONE VALUE IGNORE
END-DECIDE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE READ-RECORD
************************************************************************
RESET NOMO-PARMS
NRM-MONITOR.M-MONITOR-ID := F#MONITOR-TASK-ID1 (<>)
FNDR. FIND NRM-MONITOR WITH M-MONITOR-ID = NRM-MONITOR.M-MONITOR-ID
  IF NO RECORDS FOUND
    ES-RC := 1
    ES-MSG-NR := 0491
    ES-MSG-TXT := 'Monitor record not found'
    ESCAPE ROUTINE
  END-NOREC
  NOMO-MONITOR-ID             := M-MONITOR-ID
  NOMO-TIME-SCHEDULE          := M-TIME-SCHEDULE /*SU6 ????
  NOMO-WAIT-CURRENT           := M-WAIT-CURRENT
  NOMO-USE-OWNER              := M-USE-OWNER
  NOMO-STATUS                 := M-STATUS
  NOMO-DATE-FORMAT            := M-DATE-FORMAT
  NOMO-NATRPT-DBID            := M-NATRPT-DBID-N5
  NOMO-NATRPT-FNR             := M-NATRPT-FNR-N5
  NOMO-SUPPORT-LONG-NAMES     := M-SUPPORT-LONG-NAMES
  NOMO-LAST-ARCHIVE-NO        := M-LAST-ARCHIVE-NO
  NOMO-ARCHIVE-PREFIX         := M-ARCHIVE-PREFIX
  NOMO-RETENTION-PERIOD       := M-RETENTION-PERIOD
  NOMO-LOG-RETENTION          := M-LOG-RETENTION
  NOMO-LOG-TYPES(*)           := M-LOG-TYPES(*)
  NOMO-USER-AUTODEF           := M-USER-AUTODEF
  NOMO-BUNDLE-RETENTION       := M-BUNDLE-RETENTION
/*SU6 ->  NOMO-BS2-DEST(*)            := M-BS2-DEST(*)
/*/* Prevent sending non-printable chars via RPC      /* CF2 ->
/*EXAMINE FULL VALUE OF NOMO-BS2-DEST (*)
/*        FOR FULL VALUE OF H'FFFFFFFFFFFFFFFF'
/*SU6 <-  REPLACE WITH '        '                     /* CF2 <-
  NOMO-ARCHIVE-RETENTION      := M-ARCHIVE-RETENTION
  NOMO-DEFAULT-PRINTER        := M-DEFAULT-PRINTER
  NOMO-REPORT-DEFAULTS        := M-REPORT-DEFAULTS
  NOMO-BUNDLE-DEFAULTS        := M-BUNDLE-DEFAULTS
  #BUNDLE-DEFAULTS := M-BUNDLE-DEFAULTS
  IF B-FLUSH-TIME-A = ' '
    RESET NOMOB-FLUSH-TIME-T NOMOB-FLUSH-TIME-N B-FLUSH-TIME
    M-BUNDLE-DEFAULTS := #BUNDLE-DEFAULTS
    UPDATE(FNDR.)
    END TRANSACTION
  ELSE
    #DATE-P := NOMOB-FLUSH-TIME-T
    NOMOB-FLUSH-TIME-N := #DATE-P
  END-IF
  /* Prevent sending non-printable chars via RPC      /* CF2 ->
  /* (Redefine NOMOB-FLUSH-TIME-T (T) with NOMOB-FLUSH-TIME-A (A7) )
  RESET NOMOB-FLUSH-TIME-A                            /* CF2 <-
  NOMO-USER-DEFAULTS   := M-USER-DEFAULTS
  NOMO-PO-RETENTION    := M-PO-RETENTION
  NOMO-PO-TYPES(*)     := M-PO-TYPES(*)
  NOMO-JOBCARD(*)      := M-JOBCARD(*)
  NOMO-DEFAULT-JOBCARD := M-DEFAULT-JOBCARD
/*SU6 NOMO-ERROR-CLASS     := M-ERR-CLASS
END-FIND
IF #MF
  READ(1) MF-NODE BY MF-TYPE-ID = 'MR-' /*SU6 IF .. ESCAPE ????
    NOMO-SPOOL-TYPE             := MF-SPOOL-TYPE
    NOMO-SYSTEM-TYPE            := MF-SYSTEM-TYPE
    NOMO-MONITOR-NODE           := MF-MONITOR-NODE
    NOMO-TEMP-CLASS             := MF-TEMP-CLASS
    NOMO-PRINT-CLASS            := MF-PRINT-CLASS
    NOMO-CLASSES(*)             := MF-CLASSES(*)
    NOMO-JES3-OUTPUT-CLASSES(*) := MF-JES3-OUTPUT-CLASSES(*)
    NOMO-ERROR-CLASS            := MF-ERR-CLASS /*SU6 ->
    NOMO-BS2-DEST(*)            := MF-BS2-DEST(*)
    /* Prevent sending non-printable chars via RPC      /* CF2 ->
    EXAMINE FULL VALUE NOMO-BS2-DEST (*)
      FOR FULL VALUE OF H'FFFFFFFFFFFFFFFF'
      REPLACE WITH '        '                     /* CF2 <- /*SU6 <-
  END-READ
ELSE /*LUW SU8
  NOMO-SYSTEM-TYPE := *OS
END-IF
RESET #I
FNDUSAR. FIND NRM-USER-DEFINED-ARCHIVE WITH
    M-MONITOR-ID = #USERARC-ID THRU #USERARC-ID-E
  ADD 1 TO #I
  NOMO-USERARC-TYPE(#I) := M-USERARC-NUMBER
  NOMO-USERARC-NAME(#I) := M-USERARC-NAME
END-FIND
FNDUS. FIND US WITH USER-ID = ES-USER
  IF NO RECORDS FOUND
    IF NOMO-USER-AUTODEF = 'P' OR = 'Y'
      FNDUSD. FIND US WITH USER-ID = 'DEFAULT'
        IF NO RECORDS FOUND
          ES-RC := 1
          ES-MSG-NR := 0002
          ES-MSG-TXT := 'User not found'
          ESCAPE ROUTINE
        END-NOREC
      END-FIND
    ELSE
      ES-RC := 1
      ES-MSG-NR := 0002
      ES-MSG-TXT := 'User not found'
      ESCAPE ROUTINE
    END-IF
  END-NOREC
  PROFILE-STRING := USER-PROFILE
  NOMO-CONFIRM := PROF-CONFIRM
  NOMO-PRINTER := PROF-PRINTER
  NOMO-RESTRICT-ABUN := PROF-RESTRICT-ABUN
  NOMO-AR-FILTER-SUBSTR := PROF-AR-FILTER-SUBSTR
  IF PROF-TYPE = 'A'
    NOMO-ARCHIVE := NOMO-REVIVE := NOMO-FLUSH := 'Y'
    NOMO-EDIT-SEPARATORS  := 'Y'                    /* CF1
  ELSE
    NOMO-ARCHIVE := PROF-ARCHIVE
    NOMO-REVIVE  := PROF-REVIVE
    NOMO-FLUSH   := PROF-FLUSH
    NOMO-EDIT-SEPARATORS := PROF-EDIT-SEPARATORS   /* CF1
  END-IF
END-FIND
NOMVER-PRODUCTNAME := 'EOM'
CALLNAT 'PRDVER-N' NOMVER-PARMS P-ERC P-ERT
#VER := NOMVER-VERSION
#REL := NOMVER-RELEASE
#SM  := NOMVER-SP
CALLNAT 'ESMAVC-N' 'C' P-VERSION-A10 P-ERC ES-CONTROL
* ATTENTION: for NOMVER-CF max. is 9 ÜÜ
/*SU7 COMPRESS ES-APPLICATION-VERSION-A3 NOMVER-CF
#I3 := NOMVER-CF + 1 /*SU7
COMPRESS ES-APPLICATION-VERSION-A3 SUBSTR(#CHARTAB,#I3,1) /*SU7
  TO NOMO-VERSION LEAVING NO
#DATE-A8 := NOMVER-DATE
IF #DATE-A8 IS (D)
  MOVE EDITED #DATE-A8 TO #NATDATE (EM=YYYYMMDD)
  MOVE EDITED #NATDATE (EM=YYYYMMDD) TO NOMO-VERSION-DATE
ELSE
  RESET #NATDATE NOMO-VERSION-DATE
END-IF
CALLNAT 'NOMVI-2N' NOMVI
NOMO-NOMVI-N10 := NOMVI-N
CALLNAT 'SATVI-2N' SATVI
#VER := SATVI-VERSION
#REL := SATVI-RELEASE
#SM  := SATVI-SMLEVEL
CALLNAT 'ESMAVC-N' 'C' P-VERSION-A10 P-ERC ES-CONTROL
* ATTENTION: for SATVI-SERVICE-PACK max. is 9 ÜÜ
COMPRESS ES-APPLICATION-VERSION-A3 SATVI-SERVICE-PACK
  TO NOMO-SAT-VERSION LEAVING NO
IF SATVI-SP-DATE = MASK(YYYYMMDD)
  NOMO-SAT-VERSION-DATE := SATVI-SP-DATE
END-IF
ED-REQUEST := 'GETV'
CALL 'EDITOR' EDIT-CB
EXAMINE ED-MEMBER FOR 'V' DELETE
IF ED-ERRNUM = 0
  NOMO-EDITOR-DATE := ED-DATE
  NOMO-EDITOR      := ED-MEMBER
  DECIDE FOR FIRST CONDITION
    WHEN ED-DATE = MASK(YY'-'MM'-'DD)
      MOVE EDITED ED-DATE TO #T1 (EM=YY-MM-DD)
      CALLNAT 'DATTCA-N' #T1     /* ADAPT CENTURY
      MOVE EDITED #T1 (EM=YYYYMMDD) TO NOMO-EDITOR-DATE
    WHEN ED-DATE = MASK(DD'/'MM'/'YY)
      MOVE EDITED ED-DATE TO #T1 (EM=DD/MM/YY)
      CALLNAT 'DATTCA-N' #T1
      MOVE EDITED #T1 (EM=YYYYMMDD) TO NOMO-EDITOR-DATE
    WHEN NONE IGNORE
  END-DECIDE
END-IF
COMPRESS *TPSYS *OPSYS TO NOMO-OP-SYSTEM
IF MF-MONITOR-NODE NE 0
  FIND (1) SYSTEM-INFO WITH NODE = MF-MONITOR-NODE
    IF ERROR-CODE = 0
      NOMO-ESY-VERSION := SYSTEM-INFO.ESY-VERSION
      COMPRESS *TPSYS SYSTEM-ID SYSTEM-TYPE SYSTEM-RELEASE SPOOL-TYPE
        TO NOMO-OP-SYSTEM
    END-IF
  END-FIND
END-IF
NOMO-NAT-VERSION    := *NATVERS
NOMO-NAT-VERSION-SP := *PATCH-LEVEL
NOMO-SERVER-TYPE    := *SERVER-TYPE
NOMO-MACHINE-CLASS  := *MACHINE-CLASS
*
END-SUBROUTINE /* READ-RECORD
*
************************************************************************
DEFINE SUBROUTINE UPD-MON-RECORD
************************************************************************
NRM-MONITOR.M-MONITOR-ID := F#MONITOR-TASK-ID1 (<>)
FNDU. FIND NRM-MONITOR WITH M-MONITOR-ID = NRM-MONITOR.M-MONITOR-ID
  IF NO RECORDS FOUND
    ES-RC := 1
    ES-MSG-NR := 0491
    ES-MSG-TXT := 'Monitor record not found'
    ESCAPE BOTTOM (FNDU.)
  END-NOREC
  M-DATE-FORMAT   := NOMO-DATE-FORMAT
  M-LOG-TYPES (*) := NOMO-LOG-TYPES(*)
  M-USER-AUTODEF  := NOMO-USER-AUTODEF
  UPDATE (FNDU.)
  END TRANSACTION
  RESET ES-RC
END-FIND
*
END-SUBROUTINE /* UPD-MON-RECORD
*
END
