DEFINE DATA PARAMETER
1 #FIELD-NAME     (A65)
************************************************************************
LOCAL
1 F               (P2)
1 #FIELD          (A65)
1 REDEFINE #FIELD
  2 #F            (A1/1:65)
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#FIELD := #FIELD-NAME
EXAMINE #FIELD FOR '.' GIVING POSITION F
IF F > 0
  RESET #F (1:F)
  MOVE LEFT #FIELD TO #FIELD
END-IF
*
DECIDE ON FIRST #FIELD
  VALUE 'M-TIME-SCHEDULE'    INPUT USING MAP 'HCMPACT&'
  VALUE 'M-VERSION'          INPUT USING MAP 'HCMPVER&'
  VALUE 'M-DEFAULT-PRINTER'  INPUT USING MAP 'HCMPTMP&'
  VALUE 'M-COPY-IDENT'       INPUT USING MAP 'HCMPDES&'
  VALUE 'M-CP-DBID'          INPUT USING MAP 'HCMPDB-&'
  VALUE 'M-CP-FNR'           INPUT USING MAP 'HCMPFNR&'
  VALUE 'M-WAIT-INCREMENT'   INPUT USING MAP 'HCMPTL-&'
  VALUE 'M-BATCH-MODULE'     INPUT USING MAP 'HCMPVR2&'
  NONE                       IGNORE
END-DECIDE
*
END
