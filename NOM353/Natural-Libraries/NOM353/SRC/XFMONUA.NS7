DEFINE FUNCTION F#MONITOR-USER-AUTODEF RETURNS DEF-USER (A1)
  DEFINE DATA
  LOCAL
  1 MONITOR VIEW OF NRM-MONITOR
    2 M-USER-AUTODEF
  1 #MONIT-ID  (A16)
*
  END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#MONIT-ID := F#MONITOR-TASK-ID1 (<>)
FIND MONITOR WITH M-MONITOR-ID = #MONIT-ID
  DEF-USER := M-USER-AUTODEF /*'P'/'Y'/'N'
END-FIND
*
END-FUNCTION /*F#MONITOR-USER-AUTODEF
*
END
