DEFINE DATA PARAMETER
/* >Natural Source Header 000000
/* :Mode S
/* :CP
/* <Natural Source Header
*   XXUXMR-P -MULTIPLE RECORDS                 FOR XXUXMR-N /XXUX---N
*     FOR NPR UNIX ACCESS
*
*   Maintenance
*   ?? P300605
*   ??    NOMALL-1903
* ***********************************************************************
1 XXUXMR-P
  2 MR-P-FUNCTION (A1) /* IN
*   'A' APPEND
*   'G' GET  AT POSITION
  2 MR-P-BUFFER-FORMAT (A1) /* IN
*   3 LENGTH BYTE=3 DIGITS
*   LENGTH BYTE VARIABLE
  2 MR-P-RC (I4) /* OUT, RETURNCODE
*   0 OK
*   1 APPEN D: NO SPACE FOR RECORDS
*   1 GET:     NO MORE RECORDS
*   2 INVAL ID POSITION
*   101 INV ALID BUFFER FORMAT
  2 MR-P-POSITION (I4) /* MOD
*   BEFORE  APPEND: NO MEANING
*   AFTER   APPEND:
*     NEXT  FREE POSITION IN BUFFER
*   BEFORE  GET:
*     POS.  OF A LENGTH FIELD
*   AFTER   GET:
*     NEXT  POS. OF A LENGTH FIELD
  2 MR-P-RECORD (A250) /* IN APPEND
  2 MR-P-BUFFER-TYPE (A1) /* P300605 in
  2 MR-P-BUFFER (A) DYNAMIC /* NOMALL-1903 WAS 9700
* **End of PDA XXUXMR-P *************************************************
END-DEFINE
