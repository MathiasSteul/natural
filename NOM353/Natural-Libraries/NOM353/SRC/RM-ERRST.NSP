* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RM-ERRST  error transaction for sub tasks
*
* MAINTENANCE:
* jvd 1997-10-10  p(163166)  Y2C on dates
* jvd 1998-09-10  p(164220)  NOM141ÖNAT23
* fhi 2000-08-22  QA01       Use Natural RDC utility
* LP  2005-03-15  USE RDC UTILITY ONLY IF *MACHINE-CLASS='MAINFRAME'
* fhi     2016-12-21 NOMALL-1961 Use new task IDs
* fhi     2017-01-06 NOMALL-1621 Call RDCDISIO, too.
* SU1     2021-04-16 NOMALL-2454 recat RMTASK-P to avoid NAT1305
* ----------------------------------------------------------------------
DEFINE DATA GLOBAL USING MONIT-GL
LOCAL USING RLOG-L
LOCAL USING RMTASK-P          /* NOMALL-1961 fhi in
LOCAL
1 #ERR-NR(N5)
1 #ERR-LINE(N4)
1 #ERR-TYPE(A1)
1 #ERR-PROGRAM(A8)
1 #ERR-LEVEL(N2)
1 #ERL(P12)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
IF *DATA > 0
  INPUT #ERR-NR #ERR-LINE #ERR-TYPE #ERR-PROGRAM #ERR-LEVEL
END-IF
*
DECIDE ON FIRST VALUE OF #ERR-NR
  VALUE 3009,3145
    WRITE NOTITLE *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
      'ERROR NUMBER' #ERR-NR   'IN LINE ' #ERR-LINE   #ERR-PROGRAM
  NONE VALUE
    BACKOUT TRANSACTION
    LG-CODE   := 'ME'
    RMTASK-P.FUNCTION       := 'L'
    RMTASK-P.SUBTASK-NUMBER := 1
    CALLNAT 'RMTASKID' RMTASK-P
    LG-USERID               := RMTASK-P.TASK-ID
    COMPRESS '0009' #ERR-NR #ERR-PROGRAM TO LG-MSG
    COMPRESS LG-MSG '/' #ERR-LINE TO LG-MSG LEAVING NO
    CALLNAT 'RLOG' PL-PARMS
    END TRANSACTION
END-DECIDE
IF *MACHINE-CLASS = 'MAINFRAME'
  CALL 'CMRDC' 'P' /* stop RDC statistics
  FETCH RETURN 'RMRDCDSP' /* show Natural RDC statistics
  FETCH RETURN 'RDCDISIO' /* NOMALL-1621 fhi in
END-IF
*
TERMINATE
*
END
