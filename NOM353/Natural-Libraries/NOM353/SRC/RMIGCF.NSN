* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RMIGCF
* Function:  confirm overwriting of object to be migrated
* xsiszha 2000-08-02 (CE7461) Extend Report and Bundle Names
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 #OBJECT-OUT     (A25)
1 REDEFINE #OBJECT-OUT
  2 #OBJECT-OUT-A (A1/25)
1 #OBJECT-TYPE    (A1)
1 #LONG-NAMES     (L)
1 #CONFIRMED      (L)
************************************************************************
LOCAL
1 #OBJECT-IN      (A25)
1 REDEFINE #OBJECT-IN
  2 #OBJECT-IN-A  (A1/25)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET #OBJECT-IN #CONFIRMED
DECIDE ON FIRST VALUE OF #OBJECT-TYPE
  VALUE 'R'
    IF #LONG-NAMES
      SET CONTROL 'WC07L62B10/09F'
    ELSE
      SET CONTROL 'WC07L54B10/13F'
      #OBJECT-OUT-A(18) := H'FA'
      #OBJECT-IN-A(18) := H'FA'
    END-IF
  VALUE 'B'
    IF #LONG-NAMES
      SET CONTROL 'WC07L62B10/09F'
    ELSE
      SET CONTROL 'WC07L45B10/17F'
      #OBJECT-OUT-A(9) := H'FA'
      #OBJECT-IN-A(9) := H'FA'
    END-IF
  VALUE 'U','L','P','C'
    SET CONTROL 'WC07L45B10/17F'
    #OBJECT-OUT-A(9) := H'FA'
    #OBJECT-IN-A(9) := H'FA'
  VALUE 'F'
    SET CONTROL 'WC07L54B10/13F'
    #OBJECT-OUT-A(17) := H'FA'
    #OBJECT-IN-A(17) := H'FA'
  NONE VALUE
    SET CONTROL 'WC07L62B10/09F'
END-DECIDE
SET CONTROL 'M3'
INPUT USING MAP 'RMIGCFM&'
IF *PF-KEY = 'PF3'
  SET CONTROL 'WB'
  ESCAPE ROUTINE
END-IF
IF #OBJECT-IN = #OBJECT-OUT
  #CONFIRMED := TRUE
ELSE
  REINPUT *4 ALARM
END-IF
SET CONTROL 'WB'
*
END
