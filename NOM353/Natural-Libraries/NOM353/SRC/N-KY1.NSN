* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* N-KY1 - check report names against keywords
*
* Maintenance
* SU1     2023-06-13 ES-33831    created: KY 1 -> 4 + AND/OR
************************************************************************
*
DEFINE DATA
PARAMETER
1 #KY        (A25/*) BY VALUE
1 #F-KY      (A25/1:4)
1 #T-KY      (A25/1:4)
1 #S-AND     (L)
1 #SELECTED  (L)
************************************************************************
LOCAL
1 #I         (I2)
1 #I1        (I2)
1 #FOUND     (I1/1:4) /*#F-KY
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET #SELECTED
#F1. FOR #I1=1 TO *OCC(#F-KY) /*entered KY
  IF #F-KY (#I1) = ' '
    ESCAPE TOP
  END-IF
  #FOUND (#I1) := 1 /*filled - must be found
  #F2. FOR #I=1 TO *OCC(#KY) /*defined KY (AR)
    IF #KY (#I) = ' '
      ESCAPE TOP
    END-IF
    IF #KY (#I) = #F-KY (#I1) THRU #T-KY (#I1) /*ok
      IF #S-AND
        #FOUND (#I1) := 2 /*one found
        ESCAPE BOTTOM (#F2.)
      END-IF
      #SELECTED := TRUE /* OR: one ok - all ok
      ESCAPE MODULE
    END-IF
  END-FOR /*(#F2.)
  IF #S-AND AND #FOUND (#I1) = 1 /* AND: one not ok -> all not ok
    ESCAPE MODULE
  END-IF
END-FOR /*(#F1.)
IF #S-AND /*AND NOT (#FOUND (*) = 1)
  #SELECTED := TRUE /* AND: all ok
END-IF
*
END
