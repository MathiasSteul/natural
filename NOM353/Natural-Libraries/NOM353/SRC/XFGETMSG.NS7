* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* XFGETMSG -  Return message for an error message number
*   Invoke via:
*     F#GETMSG (<EOMMSG-NR>)
*     F#GETMSG (<EOMMSG-NR, 'abc'>)
*     F#GETMSG (<EOMMSG-NR, EOMMSG-TOKEN(1:V)>)
*     F#GETMSG (<EOMMSG-NR, EOMMSG-TOKEN(1:V), LANGUAGE>)
*     F#GETMSG (<EOMMSG-NR, 1X, LANGUAGE>)
* ----------------------------------------------------------------------
* Maintenance
* -----------
* uuuuuu  yyyy-mm-dd iTrac       Remark
* SU      2018-04-06             Created
* SU1     2019-08-08 NOMALL-2318 handle Nat MSG
* SU2     2021-08-20 NOMALL-2467 SATMS01N(A65)->XXGMSG-N(itrac for uqac)
* ----------------------------------------------------------------------
*
DEFINE FUNCTION F#GETMSG RETURNS #MSG (A) DYNAMIC
  DEFINE DATA PARAMETER
  1 #ERR-NR      (N4) BY VALUE RESULT /*negative value means NAT
  1 #ERR-DYN     (A/*) DYNAMIC BY VALUE OPTIONAL
  1 #LANG        (I1) BY VALUE OPTIONAL
  1 #LIB         (A8) OPTIONAL
************************************************************************
  LOCAL USING XXGMSG-A
  LOCAL
  1 #I        (I2)
  1 #LANGUAGE (I1) INIT <*LANGUAGE>
* ÜÜ NAT LUW requires INDEPENDENT below LOCAl ÜÜÜ
  INDEPENDENT
  1 +NOM-LIBRARY (A8)
* *****
  END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
IF +NOM-LIBRARY = ' ' /*performance
  CALLNAT 'RGETLIB' +NOM-LIBRARY
END-IF
*
IF #LANG SPECIFIED
  #LANGUAGE := #LANG
END-IF
IF #ERR-DYN SPECIFIED
  FOR #I=1 TO *OCC(#ERR-DYN)
    IF #I > *OCC(#XX-MSG-DYNA)
      ESCAPE BOTTOM
    END-IF
    #XX-MSG-DYNA (#I) := #ERR-DYN (#I)
  END-FOR
END-IF
#XX-ERROR-CODE := #ERR-NR
/* ABS(#ERR-NR) /*otherwise 'NAT341L'
IF #LIB SPECIFIED AND #LIB NE ' '
  #XX-ERROR-APPL := #LIB
ELSE
  #XX-ERROR-APPL := +NOM-LIBRARY
END-IF
CALLNAT 'XXGMSG-N' #XX-GMSG-PARMS #LANGUAGE
#MSG := #XX-SHORT-TEXT
*
END-FUNCTION /*F#GETMSG
*
END
