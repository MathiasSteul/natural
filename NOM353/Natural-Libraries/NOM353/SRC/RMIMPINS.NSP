*
************************************************************************
* Main line
************************************************************************
*
SET KEY ALL
INPUT 'Overwrite records (Y/N)?                   ' #REPL (AD=MILT)   /
  'Write trace (Y/N)?                         ' #TRACE (AD=MILT)     //
  'New environment:'                                                  /
  'New Container DB number or 0 for no change:' #CONT-DB (AD=MILT)    /
  'New Container file number or 0             ' #CONT-FNR (AD=MILT)   /
  'New node number or 0                       ' #NODE  (AD=MILT)
*
IF *DEVICE NE 'BATCH' AND *PF-KEY NE 'ENTR'
  ESCAPE ROUTINE
END-IF
*
RMSETTIM.FUNCTION := 'S'
PERFORM RMSETTIM-SETTIME RMSETTIM
#MSG := 'Start of XML import.'
PERFORM XXRLOG-WRITE-LOG 'W' #MSG
PERFORM XXCATAL-GET-CATDATE #CATDATE
COMPRESS *PROGRAM 'cataloged at'  #CATDATE TO #MSG
PERFORM XXRLOG-WRITE-LOG 'W' #MSG
END TRANSACTION
RESET #MSG
/* DEFINE WORK FILE 1 'D:ÖESMÖNOM-EXPORTÖrmimport.xml' TYPE "UNFORMATTED"     /* PC ONLY
DEFINE WORK FILE 1 TYPE 'UNFORMATTED'                                 /* MF ONLY
FORMAT LS=133
MOVE ENCODED H'0A' CODEPAGE 'UTF-8' TO LINEFEED CODEPAGE *CODEPAGE
IF #TRACE   = 'Y'
  #TRACING := TRUE
END-IF
INCLUDE CMRDC                  /* NOMALL-2009 fhi in
NOMVER-PRODUCTNAME := 'EOM'
CALLNAT 'NOMVER-N' NOMVER-PARMS
COMPRESS 'NOM' NOMVER-VERSION '.' NOMVER-RELEASE '.' NOMVER-SP '.'
  NOMVER-CF TO #NOMVER LEAVING NO
/*
/* Read the xml file
/*
READ WORK FILE 1 #RECORD
END-WORK
CLOSE WORK 1
*
MOVE ENCODED #RECORD CODEPAGE "UTF-8" TO #XML
/*
/* Parse everything
/*
INCLUDE XXPARS-C '#XML' /* XML file to be parsed
  '#XPATH'                /* XPATH to repesent element...
  'XML_PARSER_XPATH_TYPE'           /* Type of callback
  '#VALUE'              /* Content of founld element
  'XML_PARSER_CONTENT_IS_EMPTY'     /* Is TRUE if element is empty
  'XML_PARSER_ERROR_TEXT'           /* error Message
  'XML_PARSER_RESPONSE'             /* Error NR; 0 = OK
  '#TAG'
/*
IF #MSG NE ' '
  PERFORM XXRLOG-WRITE-LOG 'W' #MSG
  END TRANSACTION
  #ERROR := TRUE
END-IF
RMSETTIM.FUNCTION := 'G'
PERFORM RMSETTIM-SETTIME RMSETTIM
PERFORM XXRLOG-WRITE-LOG 'W' RMSETTIM.MSG
END TRANSACTION
IF #ERROR
  #MSG := 'Aborting processing.'
ELSE
  #MSG := 'End of processing.'
END-IF
PERFORM XXRLOG-WRITE-LOG 'W' #MSG
END TRANSACTION
PERFORM WRITE-SUMMARY /*SU5
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE CALLBACK
************************************************************************
IF #TRACING
  COMPRESS #XPATH TO #MSG
  PERFORM XXRLOG-WRITE-LOG '-' #MSG
  MOVE EDITED #TAG (EM=H(10)) TO #HEX
  COMPRESS 'Got from xml: tag '''  #TAG ''' ''' #HEX ''''
    TO #MSG LEAVING NO
  PERFORM XXRLOG-WRITE-LOG 'T' #MSG
  MOVE EDITED #VALUE (EM=H(10)) TO #HEX
  COMPRESS '............value '''  #VALUE ''' ''' #HEX ''''
    TO #MSG LEAVING NO
  PERFORM XXRLOG-WRITE-LOG 'T' #MSG
  END TRANSACTION
  RESET #MSG
END-IF
DECIDE ON FIRST VALUE OF XML_PARSER_XPATH_TYPE
  VALUE 'T'
    EXAMINE #TAG TRANSLATE INTO UPPER
    IF #FIRST
      RESET #FIRST
      IF #TAG NE 'NOM-EXPORT'
        #MSG := 'Missing opening tag. No NOM Export File. Exiting.'
        ESCAPE ROUTINE /* (PARSE.)
      END-IF
    END-IF
    RESET #PORTION
    DECIDE ON EVERY VALUE OF #TAG
      VALUE ' '
        IF #VALUE = ' '
          ESCAPE ROUTINE
        END-IF
      VALUES 'BR','BU','CA','DL','FO', 'GR','PH','PR','RP','US','UX'
        COMPRESS 'NOM-EXPORT/' #TAG TO #PATH LEAVING NO
        IF #XPATH NE #PATH
          #MSG := 'Error in export file nesting. No view name. Exiting.'
          ESCAPE ROUTINE /*  (PARSE.)
        END-IF
        IF #TRACING
          COMPRESS 'Accepted XML path' #XPATH TO #MSG
          PERFORM XXRLOG-WRITE-LOG 'T' #MSG
          END TRANSACTION
          RESET #MSG
        END-IF
        COMPRESS 'RMIMP' #TAG TO #IMPORT-PROG LEAVING NO
        #XML-VIEW := #TAG
        RESET #KEY
      VALUE 'PORTION'
        COMPRESS 'NOM-EXPORT/' #XML-VIEW '/' #TAG-CURRENT '/PORTION'
          TO #PATH LEAVING NO
        IF #XPATH NE #PATH
          #MSG := 'Error in export file nesting. Wrong portion. Exiting.'
          ESCAPE ROUTINE /* (PARSE.)
        END-IF
        IF #TRACING
          COMPRESS 'Accepted XML path' #XPATH TO #MSG
          PERFORM XXRLOG-WRITE-LOG 'T' #MSG
          END TRANSACTION
          RESET #MSG
        END-IF
        #PORTION := TRUE
        IF #TRACING
          COMPRESS 'Field portion detected.' #XPATH TO #MSG
          PERFORM XXRLOG-WRITE-LOG 'T' #MSG
          END TRANSACTION
          RESET #MSG
        END-IF
      VALUE 'VALUE'
        COMPRESS 'NOM-EXPORT/' #XML-VIEW '/' #TAG-CURRENT '/VALUE'
          TO #PATH LEAVING NO
        IF #XPATH NE #PATH
          #MSG := 'Error in export file nesting. Wrong value. Exiting.'
          ESCAPE ROUTINE /* (PARSE.)
        END-IF
        IF #TRACING
          COMPRESS 'Accepted XML path' #XPATH TO #MSG
          PERFORM XXRLOG-WRITE-LOG 'T' #MSG
          END TRANSACTION
          RESET #MSG
        END-IF
      NONE
        #TAG-CURRENT := #TAG
        EXAMINE #TAG-CURRENT FOR ' ' GIVING LENGTH IN #TAG-LENGTH
    END-DECIDE
    ESCAPE ROUTINE
  VALUE XML_PARSER_ATSIGN
    IF #TAG = 'version' AND #NOMVER < #VALUE
      COMPRESS 'Import version' #NOMVER
        'too low. Use at least product version. Exiting.' #VALUE
        TO #MSG
      ESCAPE ROUTINE /* (PARSE.)
    END-IF
    ESCAPE ROUTINE
  VALUE '$'
    DECIDE FOR EVERY CONDITION
      WHEN #VALUE = LINEFEED
        IF #TRACING
          #MSG := 'Ignoring linefeed.'
          PERFORM XXRLOG-WRITE-LOG 'T' #MSG
          END TRANSACTION
          RESET #MSG
        END-IF
        ESCAPE ROUTINE
      WHEN #TAG-CURRENT = 'P-NODE' OR = 'R-NODE' AND #NODE NE 0
        #VALUE := #NODE
        MOVE LEFT #VALUE TO #VALUE
        IF #TRACING
          COMPRESS 'Setting node' #VALUE 'for' #TAG-CURRENT TO #MSG
          PERFORM XXRLOG-WRITE-LOG 'T' #MSG
          END TRANSACTION
          RESET #MSG
        END-IF
      WHEN #TAG-CURRENT = 'UX-NODE-CONTAINER-DB' AND #CONT-DB NE 0
        #VALUE := #CONT-DB
        MOVE LEFT #VALUE TO #VALUE
        IF #TRACING
          COMPRESS 'Setting DBID' #VALUE 'for' #TAG-CURRENT TO #MSG
          PERFORM XXRLOG-WRITE-LOG 'T' #MSG
          END TRANSACTION
          RESET #MSG
        END-IF
      WHEN #TAG-CURRENT = 'UX-NODE-CONTAINER-FNR' AND #CONT-FNR NE 0
        #VALUE := #CONT-FNR
        MOVE LEFT #VALUE TO #VALUE
        IF #TRACING
          COMPRESS 'Setting FNR' #VALUE 'for' #TAG-CURRENT TO #MSG
          PERFORM XXRLOG-WRITE-LOG 'T' #MSG
          END TRANSACTION
          RESET #MSG
        END-IF
      WHEN #PORTION AND #VALUE-CURRENT = ' ' /* first portion
        #VALUE-CURRENT := #VALUE
        ESCAPE ROUTINE
      WHEN #VALUE-CURRENT NE ' '   /* second portion
        MOVE #VALUE TO SUBSTR(#VALUE-CURRENT,151)
      WHEN #KEY = ' '
        #KEY := #VALUE-CURRENT := #VALUE
      WHEN NONE
        #VALUE-CURRENT := #VALUE
    END-DECIDE
  VALUE '/'
    DECIDE ON FIRST VALUE OF #TAG
      VALUE #XML-VIEW
        #SAVE := TRUE
        PERFORM CALL-IT
      VALUE 'NOM-EXPORT'
        IF #TRACING
          #MSG := 'End of XML Export file detected.'
          PERFORM XXRLOG-WRITE-LOG 'T' #MSG
          END TRANSACTION
          RESET #MSG
        END-IF
        ESCAPE ROUTINE /* (PARSE.)
      NONE
        IGNORE
    END-DECIDE
    ESCAPE ROUTINE
  VALUE XML_PARSER_PROCESSING
    ESCAPE ROUTINE
  NONE IGNORE
END-DECIDE
*
RESET #SAVE
PERFORM CALL-IT
#TAG-OLD := #TAG-CURRENT
RESET #VALUE-CURRENT
*
END-SUBROUTINE /* CALLBACK
*
************************************************************************
DEFINE SUBROUTINE PARSER_ERROR /*used in XXPARS-C
************************************************************************
#ERROR := TRUE
COMPRESS '0005 Parser error' XML_PARSER_RESPONSE XML_PARSER_ERROR_TEXT
  TO #MSG
PERFORM XXRLOG-WRITE-LOG 'W' #MSG
END TRANSACTION
*
END-SUBROUTINE /*PARSER_ERROR
*
************************************************************************
ON ERROR
************************************************************************
  BACKOUT TRANSACTION
  CALLNAT 'C-NATERN' #MSG 'W'
END-ERROR
*
INCLUDE RMIMP-C /*CALL-IT SU4
*
END
