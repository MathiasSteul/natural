* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
************************************************************************
* Subprogram N-LF158
* Version    3.5
* Function   Set/Get LFILE 158 - NOM trigger container file
* ----------------------------------------------------------------------
* Maintenance
* -----------
* user    yyyy-mm-dd iTrac       Remark
* SU      2018-08-08 NOMALL-2133 Created
************************************************************************
*
DEFINE DATA
PARAMETER
1 #DBID-NEW          (N5) OPTIONAL /*if specified, new DBID
1 #FNR-NEW           (N5) OPTIONAL /* "
1 #DBID-OLD          (N5) OPTIONAL /*if specified,filled with old val
1 #FNR-OLD           (N5) OPTIONAL /* "
1 #NATRP-ERC         (I4) BY VALUE RESULT
1 #NATRP-ERT         (A) DYNAMIC BY VALUE RESULT
************************************************************************
LOCAL USING SATFNC3E
LOCAL USING SATLF02P
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET #NATRP-ERC #NATRP-ERT
IF #DBID-OLD SPECIFIED /*remember old values
  SATLF-FUNCTION := 'GET'
  PERFORM CALL-IT
  #DBID-OLD := SATLF-DBID-N5
  #FNR-OLD  := SATLF-FNR-N5
END-IF
IF #DBID-NEW SPECIFIED /*Set new values:
  SATLF-DBID-N5 := #DBID-NEW
  SATLF-FNR-N5  := #FNR-NEW
  SATLF-FUNCTION := 'SET'
  PERFORM CALL-IT
END-IF
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE CALL-IT
************************************************************************
SATLF-LFILE    := 158
SATLF-SATVERS  := 21
CALLNAT SAT-GET-SET-LFILE SATLF-SATVERS SATLF-PARMS (*)
#NATRP-ERC := SATLF-ERROR-CODE
#NATRP-ERT := SATLF-ERROR-TEXT
IF #NATRP-ERC NE 0
  PRINT NOTITLE NOHDR (AD=L) *PROGRAM *TIMX(EM=YYYY'-'MM'-'DD' 'HH':'II)
    '--> Error NOM Sys2 File: func=' SATLF-FUNCTION 'dbid/fnr='
    SATLF-DBID-N5 SATLF-FNR-N5 / #NATRP-ERC #NATRP-ERT
  ESCAPE MODULE /*N-LF158
END-IF
*
END-SUBROUTINE /*CALL-IT
*
END
