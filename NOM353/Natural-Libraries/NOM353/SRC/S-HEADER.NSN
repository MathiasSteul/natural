* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* S-HEADER
*
* jwo 1977-10-07 p(163166) Change date to y2k format
************************************************************************
*
DEFINE DATA PARAMETER
1 MAIN-LINE(A78)
1 REDEFINE MAIN-LINE
  2 #FIL3(A1)
  2 #NOW(A8)
  2 #FIL4(A1)
  2 FILLER1(A12)
  2 #HEADER(A35)
  2 #FIL2(A10)
  2 #FIL5(A1)
  2 #TODAY(A10)
1 DATE-FORMAT(A1)
1 MAP-NAME(A8)
************************************************************************
LOCAL
1 #LANGUAGE (A1)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#FIL3 := #FIL5 := '<'
#FIL4 := '>'
#LANGUAGE := *LANGUAGE
CALLNAT 'C-TODAY' #TODAY DATE-FORMAT
#NOW := *TIME
#HEADER := '***** NATURAL SPOOLER MANAGER *****'
*
END
