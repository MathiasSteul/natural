* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* NORPTF-N -NOM API Transfer Reports to target environment
* Input keys: ES-KEY-PARM(1) - transfer parms
*
* Maintenance:
* XSETGGR 2005-01-26 created
* fhi     2007-07-12 NOM3202   C-NATERR changed, NAD23006 is obsolete.
* XSETHZ  2008-07-23 p(307577) use full name of ES-APP-SERVER-LIBRARY
* xsetggr 2008-10-30 p(309496) err msg if target env not initialized
* XSETHZ  2009-02-02 P(311768) new NORPSL-A
* xsetggr 2012-08-16 NOMALL-1145 correct header
* CF1     2014-11-12 NOMALL-1528 Improve error stability
* SU1     2020-04-01 NOMALL-2379 recat:VREP---L mod:Unix files A26-> A50
* SU2     2021-01-08 NOMALL-2443 attr. "with Sep.Pages"(NOMALL-2085
* SU3     2021-06-08 NOMALL-2454 remove short DBID/FNR/NODE vars
* ------------------------------------------------------------------
DEFINE DATA
PARAMETER USING ESMCNT-A
PARAMETER USING ESMINP-A
PARAMETER USING ESMWORKA
PARAMETER USING NOXXTF-A
************************************************************************
LOCAL USING NOXXTF-L
LOCAL USING NORPSL-A
LOCAL USING VREP---L     /* nrm-reports
LOCAL USING VTREP--L     /* nrm-migrate-reports
LOCAL USING NADA2000
LOCAL USING NAD-MSG
LOCAL USING NAD-FLD
LOCAL                                                      /* CF1 +
1 NAT23008-PARA
  2 LFILE-NR           (B1)
  2 FUNCTION           (A1)     /* 'S'=Set, 'R'=Reset
  2 DBID               (B2)
  2 FNR                (B2)
  2 PASSWORD           (A8)
  2 CIPHER             (A8)
  2 VSAM-NAME          (A8)
  2 DB-TYPE            (A1)
  2 LFILE-IS-SET       (L)
  2 RET_CODE           (I4)                               /* CF1 -
1 REPORT-DISTRIBUTION VIEW OF NRM-REP-TARGET
  2 RD-REPNAME
  2 RD-TARGET-ID
  2 C*RD-LAYOUT
  2 RD-LAYOUT               (1:10)
    3 RD-FROM               (P3)
    3 RD-TO                 (P3)
  2 RD-HEADLINES
1 MIGRATE-REPORT-DISTRIBUTION VIEW OF NRM-MIGRATE-REP-TARGET
  2 RD-REPNAME
  2 RD-TARGET-ID
  2 C*RD-LAYOUT
  2 RD-LAYOUT               (1:10)
    3 RD-FROM               (P3)
    3 RD-TO                 (P3)
  2 RD-HEADLINES
1 MIGRATE-PRINTERS VIEW OF NRM-MIGRATE-PRINTERS
1 MIGRATE-USERS VIEW OF NRM-MIGRATE-USERS
1 MIGRATE-DISTRIBUTION-LIST VIEW OF NRM-MIGRATE-DISTRIBUTION-LIST
1 MIGRATE-USERARC VIEW OF NRM-MIGRATE-USER-DEFINED-ARCHIVE
1 MIGRATE-GRANTS VIEW OF NRM-MIGRATE-GRANTS
  2 GR-USERID
  2 GR-OBJECT-TYPE
  2 GR-OBJECT-NAME
  2 C*GR-OPTION
  2 GR-OPTION               (6)
1 #LFILE-FIELDS
  2 #LFILE-OLDDBID          (N5)             /*  old DBID
  2 #LFILE-OLDFILE          (N5)             /*  old File-Number
  2 #LFILE-NEWDBID          (N5)             /*  new DBID
  2 #LFILE-NEWFILE          (N5)             /*  new File-Number
1 #GR-SUPER                 (A34)
1 REDEFINE #GR-SUPER
  2 #GR-TYPE                (A1)
  2 #GR-USERID              (A8)
  2 #GR-OBJECT              (A25)
1 #I2                       (I4)
1 #I                        (I4)
1 #IMAX                     (I4)
1 #REPORT-S                 (A25)
1 #REPORT-E                 (A25)
1 #GRANT-USER               (A8)
1 #GRANTS                   (A1/6)
1 #ES-MSG-PREF              (A7) INIT <'NOM'>
1 REDEFINE #ES-MSG-PREF
  2 #ES-MSG-NOM             (A3)
  2 #ES-MSG-NR              (N4)
1 #ES-MSG-FIELD             (A32)
1 REDEFINE #ES-MSG-FIELD
  2 #ES-MSG-FIELD-NAME      (A28)
  2 #ES-MSG-FIELD-INDEX     (N4)
1 #ES-MSG-TXT               (A58)
1 #PRINTER-ID               (A8)
1 #USERARC-ID               (A10)  INIT <'USERARC00'>
1 REDEFINE #USERARC-ID
  2 #USERARC-ID-CONSTANT    (A8)
  2 #USERARC-ID-NUMBER      (N1)
1 #EXIST                    (L)
1 #MESSAGE                  (A250)                         /* CF1 +
1 #MSG-TEXT                 (A79)
1 #ERRORNUMBER              (N4)
1 #LANGCODE                 (I1)
1 #RESPCODE                 (N1)
1 #FUNC                     (A1)
1 #LFILE                    (N5) INIT<158>                 /* CF1 -
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
************************************************************************
ON ERROR
************************************************************************
  ES-RC := 1
  #ERRORNUMBER := *ERROR-NR
  CALLNAT 'NAT00020' #ERRORNUMBER #LANGCODE #MSG-TEXT #RESPCODE
  IF #RESPCODE NE 0
    COMPRESS *PROGRAM 'ERROR' *ERROR-NR *ERROR-LINE TO ES-MSG-TXT
  ELSE
    COMPRESS #ERRORNUMBER #MSG-TEXT TO ES-MSG-TXT
  END-IF                                                        /* CF1 -
  ESCAPE ROUTINE
*
END-ERROR
* ------------------------------------------------------------------
RESET ES-RC
#NORPSL := ES-SELECT
NOTF-PARM-1 := ES-KEY-PARM(1)
/*
/* Verify input parameters and switch LFILE 158 to target values
PERFORM SET-LOGICAL-FILE
IF #ES-MSG-NR NE 0
  PERFORM GET-MSG-TXT
  ES-RC := 1
  ES-MSG-FIELD := #ES-MSG-FIELD
  COMPRESS '<#ERRORNUMBER' #ERRORNUMBER ':' #MESSAGE '>' TO ES-WORK
ELSE /* Check appropriate objects and perform copy
  PERFORM LIST
  RESET #ES-MSG-NR
  /* Switch LFILE 158 back to former values
  PERFORM SWITCH-BACK-LFILE
  IF #ES-MSG-NR NE 0
    PERFORM GET-MSG-TXT
    ES-RC := 2
  END-IF
END-IF                                                     /* CF1 -
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE LIST
************************************************************************
RESET ES-NUMBER ES-OPTION-COUNT ES-STARTINDEX ES-SORTKEY ES-SORTORDER
  ES-EXPAND NOTF2-LIST(*)
ES-EOF := 'X'
#IMAX := 265
ES-FIELD-COUNT := 2
EXAMINE #NORPSL.#NAME FOR '*' DELETE
EXAMINE #NORPSL.#TYPE FOR '*' DELETE
EXAMINE #NORPSL.#NAME FOR '*' DELETE
COMPRESS #NORPSL.#NAME H'FF' TO #REPORT-E LEAVING NO
IF ES-NEXT-KEY-PARM(1) > #NORPSL.#NAME
  #REPORT-S := ES-NEXT-KEY-PARM(1)
ELSE
  #REPORT-S := #NORPSL.#NAME
  ES-STARTINDEX := 1
  #ES-MSG-NR := 6100
  PERFORM GET-MSG-TXT              /* Report
  NOTF2-HEADER(1) := LONG-MSG(1)
  #ES-MSG-NR := 6102
  PERFORM GET-MSG-TXT              /* message
  NOTF2-HEADER(2) := LONG-MSG(13)
END-IF
R. READ REPORTS WITH R-REPNAME = #REPORT-S ENDING AT #REPORT-E
  IF R-REPNAME > #REPORT-E
    ESCAPE BOTTOM(R.)
  END-IF
  RESET #GRANTS(*)
  IF NOT (#NORPSL.#AUTH = ' ' OR = '*' OR = 'ADMIN')
    CALLNAT 'NOGROU-N' 'R' R-REPNAME #NORPSL.#AUTH #GRANT-USER
      #GRANTS(*)
  ELSE
    #GRANTS(*) := 'Y'
  END-IF
  ACCEPT IF R-REPNAME NE 'NOM-CONTROL-REC' AND
    (#NORPSL.#TYPE = ' ' OR R-TYPE = #NORPSL.#TYPE) AND
    #GRANTS(1:4) = 'Y'
  PERFORM CHECK-RELATED-OBJECTS
  DECIDE FOR EVERY CONDITION
    WHEN #ES-MSG-NR NE 0
      PERFORM DATA-TO-LIST
    WHEN #EXIST AND NOTF-OWERWR NE 'Y'
      #ES-MSG-NR := 8855
      PERFORM DATA-TO-LIST
    WHEN #ES-MSG-NR = 0
      PERFORM COPY-REPORT
    WHEN NONE IGNORE
  END-DECIDE
END-READ
*
END-SUBROUTINE /* LIST
*
************************************************************************
DEFINE SUBROUTINE DATA-TO-LIST
************************************************************************
ADD 1 TO #I2
IF #I2 > #IMAX
  ES-NEXT-KEY-PARM(1) := REPORTS.R-REPNAME
  ES-NUMBER := #IMAX
  RESET ES-EOF
  ESCAPE BOTTOM
END-IF
DECIDE FOR EVERY CONDITION
  WHEN #ES-MSG-NR NE 0
    PERFORM GET-MSG-TXT
    NOTF2-MSG(#I2) := ES-MSG-TXT       /* err msg
  WHEN #EXIST AND NOTF-OWERWR NE 'Y'
    #ES-MSG-NR := 8855                   /* exist
    PERFORM GET-MSG-TXT
    NOTF2-MSG(#I2) := SHORT-MSG
  WHEN ANY
    NOTF2-OBJECT(#I2) := REPORTS.R-REPNAME
  WHEN NONE IGNORE
END-DECIDE
ES-NUMBER := #I2
*
END-SUBROUTINE /* DATA-TO-LIST
*
************************************************************************
DEFINE SUBROUTINE SET-LOGICAL-FILE                         /* CF1 +
************************************************************************
DECIDE FOR FIRST CONDITION
  WHEN NOTF-DBID-TO < 1
    #ES-MSG-NR := 0635                      /* Invalid DBID
    #ES-MSG-FIELD-NAME := 'DBID-TO'
  WHEN NOTF-FNR-TO < 1
    #ES-MSG-NR :=0636                       /* Invalid FNR
    #ES-MSG-FIELD-NAME := 'FNR-TO'
  WHEN NOTF-FNR-TO  = NOTF-FNR-FROM AND
      NOTF-DBID-TO = NOTF-DBID-FROM
    #ES-MSG-NR := 4004   /* Source and Target env must be different
    #ES-MSG-FIELD-NAME := 'DBID-TO'
  WHEN NONE
    /*
    /* Verify if NOM DBID/FNR are valid
    #FUNC := 'S'
    #LFILE-NEWDBID := NOTF-DBID-TO
    #LFILE-NEWFILE := NOTF-FNR-TO
    CALLNAT 'XXVNOM-N' #FUNC #LFILE #LFILE-NEWDBID #LFILE-NEWFILE
      #LFILE-OLDDBID #LFILE-OLDFILE #MESSAGE #ERRORNUMBER
    IF #ERRORNUMBER NE 0
      #ES-MSG-NR := 4005        /* Specified File is not a NOM-File
      #ES-MSG-FIELD-NAME := 'DBID-TO'
      IF #ERRORNUMBER = 3 OR= 4  /* LFILE was switched
        PERFORM SWITCH-BACK-LFILE
      END-IF
    ELSE
      CALLNAT 'RMIGCHKU' ES-USER #ES-MSG-NR
      IF #ES-MSG-NR NE 0
        #ES-MSG-TXT := ES-USER
        PERFORM SWITCH-BACK-LFILE
      END-IF
    END-IF
END-DECIDE
*
END-SUBROUTINE /* SET-LOGICAL-FILE
*
************************************************************************
DEFINE SUBROUTINE SWITCH-BACK-LFILE
************************************************************************
IF *MACHINE-CLASS NE 'PC'
  /*
  /* Set LFILE to former values (OLD...)
  IF #LFILE-OLDDBID = 0 AND #LFILE-OLDFILE = 0
    NAT23008-PARA.FUNCTION := 'R'    /* Reset LFILE
  ELSE
    NAT23008-PARA.FUNCTION := 'S'    /* Set back to former values
  END-IF
  /*
  NAT23008-PARA.LFILE-NR := 158
  NAT23008-PARA.DBID     := #LFILE-OLDDBID
  NAT23008-PARA.FNR      := #LFILE-OLDFILE
  CALLNAT 'NAT23008' NAT23008-PARA
  /*
  IF NAT23008-PARA.RET_CODE NE 0
    COMPRESS 'NAT23008 response code:' NAT23008-PARA.RET_CODE
      TO #MESSAGE
    #ES-MSG-NR := 4008       /* Refresh LFile error occured
    #ES-MSG-TXT := NAT23008-PARA.RET_CODE
  END-IF
END-IF
*
END-SUBROUTINE /* SWITCH-BACK-LFILE
*
************************************************************************
DEFINE SUBROUTINE CHECK-RELATED-OBJECTS
************************************************************************
RESET #ES-MSG-NR
DECIDE FOR EVERY CONDITION
  WHEN #ES-MSG-NR = 0
    RESET #ES-MSG-TXT
    FORU. FOR #I = 1 TO REPORTS.C*R-NATRPT-DIST
      FNDU. FIND NUMBER MIGRATE-USERS
      WITH USER-ID = REPORTS.R-NATRPT-DIST (#I)                       /*
      IF *NUMBER (FNDU.) = 0
        FNDDL. FIND NUMBER MIGRATE-DISTRIBUTION-LIST
        WITH D-LIST-NAME = REPORTS.R-NATRPT-DIST (#I)                 /*
        IF *NUMBER (FNDDL.) = 0
          #ES-MSG-NR := 2133
          /* User :1: from "distr to'not defined in target env
          #ES-MSG-TXT := REPORTS.R-NATRPT-DIST(#I)
          ESCAPE BOTTOM(FORU.)
        END-IF
      END-IF
    END-FOR
  WHEN #ES-MSG-NR = 0
    RESET #ES-MSG-TXT
    FORP. FOR #I = 1 TO REPORTS.C*R-PRINTERS
      #PRINTER-ID := REPORTS.R-PRINTERS(#I)
      IF NOT(#PRINTER-ID = ' ' OR = 'DUMMY')
        FNDP. FIND NUMBER MIGRATE-PRINTERS WITH P-ID = #PRINTER-ID
        IF *NUMBER (FNDP.) = 0
          RESET #ES-MSG-TXT
          #ES-MSG-NR := 2130 /* Printer :1: not defined in target DB
          #ES-MSG-TXT := #PRINTER-ID
          ESCAPE BOTTOM(FORP.)
        END-IF
      END-IF
    END-FOR
  WHEN #ES-MSG-NR = 0
    RESET #ES-MSG-TXT
    IF REPORTS.R-ARCHIVE-TYPE GT 0
      #USERARC-ID-NUMBER := REPORTS.R-ARCHIVE-TYPE
      FIND NUMBER MIGRATE-USERARC WITH M-MONITOR-ID = #USERARC-ID
      IF *NUMBER = 0
        RESET #ES-MSG-TXT
        #ES-MSG-NR := 2134 /* Archive type :1: not defined in target env
        #ES-MSG-TXT := #USERARC-ID-NUMBER
      END-IF
    END-IF
  WHEN NONE IGNORE
END-DECIDE
/* check report existance in target environment
FT. FIND NUMBER MIGRATE-REPORTS WITH R-REPNAME = REPORTS.R-REPNAME
IF *NUMBER (FT.) > 0
  #EXIST := TRUE
ELSE
  RESET #EXIST
END-IF
*
END-SUBROUTINE /* CHECK-RELATED-OBJECTS
*
************************************************************************
DEFINE SUBROUTINE COPY-REPORT
************************************************************************
FNDT. FIND MIGRATE-REPORTS WITH R-REPNAME = REPORTS.R-REPNAME
  IF NO RECORDS FOUND
    ENTER
  END-NOREC
  MOVE BY NAME REPORTS TO MIGRATE-REPORTS
  IF *NUMBER (FNDT.) = 0
    STORE MIGRATE-REPORTS
  ELSE
    IF NOTF-OWERWR = 'Y'
      UPDATE (FNDT.)
    ELSE
      BACKOUT TRANSACTION
      ESCAPE BOTTOM(FNDT.)
    END-IF
  END-IF
/* copy user layout
  FNDD. FIND MIGRATE-REPORT-DISTRIBUTION WITH
      RD-REPNAME = REPORTS.R-REPNAME
    DELETE
  END-FIND
  END TRANSACTION
  SKIP 1
  FNDDC. FIND REPORT-DISTRIBUTION WITH RD-REPNAME = REPORTS.R-REPNAME
    MOVE BY NAME REPORT-DISTRIBUTION TO MIGRATE-REPORT-DISTRIBUTION
    IF *NUMBER(FNDDC.) = 0
      STORE MIGRATE-REPORT-DISTRIBUTION
    END-IF
  END-FIND
/* add grants to migrated report
  #GR-TYPE   := 'R'
  #GR-USERID := ES-USER
  #GR-OBJECT := REPORTS.R-REPNAME
  FNDG. FIND MIGRATE-GRANTS WITH GR-SUPER = #GR-SUPER
    IF NO RECORDS FOUND
      MIGRATE-GRANTS.GR-USERID := ES-USER
      MIGRATE-GRANTS.GR-OBJECT-TYPE := 'R'
      MIGRATE-GRANTS.GR-OBJECT-NAME := REPORTS.R-REPNAME
    END-NOREC
    MIGRATE-GRANTS.GR-OPTION(*) := 'Y'
    IF *NUMBER (FNDG.) = 0
      STORE MIGRATE-GRANTS
    ELSE
      UPDATE
    END-IF
  END-FIND
END-FIND
END TRANSACTION
*
END-SUBROUTINE /* CHECK-RELATED-OBJECTS
*
************************************************************************
DEFINE SUBROUTINE GET-MSG-TXT
************************************************************************
RESET SHORT-MSG LONG-MSG(*)
VERSION := 0
NADA2000.OBJECT-KIND := 'U'
NADA2000.ERROR-NUMBER := #ES-MSG-NR
NADA2000.OPT-INSERT-DYN := FALSE
NADA2000.OPT-LANGUAGE := ES-LANGUAGE
NADA2000.LIBRARY := ES-APP-SERVER-LIBRARY
CALLNAT 'NATA2000' NADA2000 NATA2000.EXTENDED-PARMS NAD-MSG NAD-FLD
ES-MSG-TXT := SHORT-MSG
ES-MSG-NR  := #ES-MSG-NR
EXAMINE ES-MSG-TXT FOR #ES-MSG-PREF DELETE
EXAMINE ES-MSG-TXT FOR ':1:' REPLACE #ES-MSG-TXT
*
END-SUBROUTINE /* GET-MSG-TXT
*
END
