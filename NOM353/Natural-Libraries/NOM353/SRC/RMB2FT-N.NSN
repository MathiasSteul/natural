* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RMB2FT-N - Extract file token (pubset, userid, filename) from a given
*           full qualified BS2000 dsname
* Note         A BS2000 File name consits of a pubset, userid and
*              filename token. (:PPPP:$UUUUUUUU.<filename>).
*              <filename>                  max. 41
*              <UUUUUUUU>                  max. 8
*              <PPPP>                      max. 4
*              :PPPP:$UUUUUUUU.<filename>  max. 54
* Interface:
*     FULL-DSNAME (A54)   input    ":ppp:$uuuu.dddddddddd"
*     DSNAME      (A54)   output   "ddddddddddd"
*     PUBSET      (A8)    output   ":ppp:"
*     USERID      (A10)   output   "$uuuu."
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* mrs 95-10-10 s(999999) created
* SU1     2024-04-29 NOM 36      remove unused
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 RMB2FT-FULL-DSNAME         (A54)
1 RMB2FT-DSNAME              (A54)
1 RMB2FT-PUBSET              (A8)
1 RMB2FT-USERID              (A10)
************************************************************************
LOCAL
1 #DSNAME-LENGTH             (I4) CONST <54>
/*SU1 1 #CAT-MAX-LENGTH            (I4) CONST <41>
1 #DSNAME                    (A54)
1 REDEFINE #DSNAME
  2 #DS                      (A1/1:#DSNAME-LENGTH)
1 #FOUND                     (I4)
1 #PUBSET                    (A8)
1 REDEFINE #PUBSET
  2 #PS                      (A1/1:8)
1 #USERID                    (A10)
1 REDEFINE #USERID
  2 #US                      (A1/1:10)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#DSNAME := RMB2FT-FULL-DSNAME
*
EXAMINE #DSNAME FOR '$' GIVING POSITION #FOUND
IF #FOUND > 1
  SUBTRACT 1 FROM #FOUND
  #PS (1:#FOUND) := #DS (1:#FOUND)
  RESET #DS (1:#FOUND)
  MOVE LEFT #DSNAME TO #DSNAME
END-IF
*
EXAMINE #DSNAME FOR '.' GIVING POSITION #FOUND
IF #FOUND > 0
  #US (1:#FOUND) := #DS (1:#FOUND)
  RESET #DS (1:#FOUND)
  MOVE LEFT #DSNAME TO #DSNAME
END-IF
*
RMB2FT-PUBSET := #PUBSET
RMB2FT-USERID := #USERID
RMB2FT-DSNAME := #DSNAME
*
END
