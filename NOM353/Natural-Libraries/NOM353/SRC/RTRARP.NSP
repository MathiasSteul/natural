1 #O-NODE                  (N5)
*
1 L-TEMP-REP-RNBR-SEQ      (A35) INIT <'#T-00000000000-0000'>
1 REDEFINE L-TEMP-REP-RNBR-SEQ
  2 L-TEMP-REPNAME         (A25)
  2 REDEFINE L-TEMP-REPNAME
    3 L-TEMP-FIL1          (A3)
    3 L-TEMP-RNB           (N11)
    3 L-TEMP-FIL2          (A1)
    3 L-TEMP-COUNT         (N4)
    3 L-TEMP-INSL          (A1)
    3 L-TEMP-FIL3          (A1)
  2 L-TEMP-RNBR            (P11)
  2 L-TEMP-SEQ             (B4)
1 S-TEMP-REP-RNBR-SEQ      (A35) INIT <'#T-00000000000-0000'>
1 REDEFINE S-TEMP-REP-RNBR-SEQ
  2 S-TEMP-REPNAME         (A25)
  2 REDEFINE S-TEMP-REPNAME
    3 S-TEMP-FIL1          (A3)
    3 S-TEMP-RNB           (N11)
    3 S-TEMP-FIL2          (A1)
    3 S-TEMP-COUNT         (N4)
    3 S-TEMP-INSL          (A1)
    3 S-TEMP-FIL3          (A1)
  2 S-TEMP-RNBR            (P7)
  2 S-TEMP-SEQ             (B4)
*
1 L-PARMS
  2 L-REPNAME              (A25)
  2 L-NODE                 (N5)
  2 L-CLASS                (A1)
  2 L-DSNAME               (A54)
  2 L-SYSOUT-PARMS
    3 L-JOB-NUMBER         (N7)
    3 L-JOB-TYPE           (A2)
    3 L-DATA-SET           (N5)
    3 L-DATASET-KEY        (N7)
    3 L-JOBNAME            (A8)
