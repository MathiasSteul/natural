    3 L-TO-LINE            (N9)
*
  2 L-OTHER
    3 L-TRACE              (P2)  INIT <1>
    3 L-REP-RNBR           (P11)
    3 L-MAXREC             (N7)
    3 OK                   (L)
    3 FILTER-BY-NAT        (L)
    3 FILTER-BY-ASM        (L)
    3 L-SOURCE-ISN         (P10)
    3 L-SOURCE-ID          (P10)
*
1 L-SCREEN (1:#NOFLINES)
  2 L-MARK                 (A2)
  2 L-IDENT                (I2)
  2 CV-MARK                (C)
