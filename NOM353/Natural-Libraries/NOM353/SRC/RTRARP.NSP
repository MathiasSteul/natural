  2 RECORD-LENGTH
  2 RECORD /*not used, but must defined to get HEX fields filled
  2 RECORD-HEX1
  2 RECORD-HEX2
  2 RECORD-HEX3
  2 SEGMENT-LENGTH
  2 SEGMENT-NUMBER
1 READ-FILE-ESA VIEW OF READ-FILE /*without HEX Ü SU8
  2 ERROR-CODE
  2 ERROR-TEXT
  2 RECORD-NUMBER
  2 RECORD-LENGTH
  2 RECORD
  2 SEGMENT-LENGTH
  2 SEGMENT-NUMBER
1 SYSOUT VIEW OF READ-SPOOL
  2 ERROR-CODE
  2 ERROR-TEXT
  2 RECORD-NUMBER
  2 RECORD-LENGTH
  2 RECORD /*not used, but must defined to get HEX fields filled
  2 RECORD-HEX1
  2 RECORD-HEX2
  2 RECORD-HEX3
1 SYSTEM-INFO VIEW OF SYSTEM-INFO
  2 ERROR-CODE
  2 ERROR-TEXT
  2 SPOOL-TYPE
  2 SYSTEM-TYPE /*SU7
1 SOURCE VIEW OF NRM-SOURCE
  2 SR-ID
  2 SR-TYPE
  2 SR-ATTRIBUTES-IDENT
  2 SR-CC-TYPE
  2 SR-REMOTE-CODEPAGE
  2 SR-RECORD-LENGTH
  2 SR-NUMBER-OF-LINES
  2 SR-OBJECT-TYPE
  2 SR-OBJECT-TIME
* *****
1 #NATLIB                  (A8)
1 #S                       (P4)
1 #I                       (P2)
1 #IL                      (P2)
1 #J                       (P2)
1 #T                       (P3)
1 #NOFLINES                (I2) CONST <11>
1 #O-DSNAME                (A54) INIT LENGTH 17 <H'00'>
1 #O-REPNAME               (A25) INIT FULL LENGTH <H'00'>
1 #M-REPNAME               (A25)
1 REDEFINE #M-REPNAME
  2 #M-REPNAME-17          (A17)
  2 #M-REPNAME-R           (A8)
