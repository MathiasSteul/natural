/*SU10 LOCAL USING RMPWRL-P
LOCAL USING P-UEXIT
LOCAL USING SAT00009
*
LOCAL
1 TEMP-REPORT-CONTENTS VIEW OF NRM-REPORT-CONTENTS
  2 AC-REPNAME
  2 AC-REPRNB
  2 AC-SEQNO
  2 C*AC-INSERTED-LINE
1 REPORT-CONTENTS VIEW OF NRM-REPORT-CONTENTS
  2 AC-REPNAME
  2 AC-REPRNB
  2 AC-SEQNO
  2 AC-INSERTED-LINE       (1:10)
  2 AC-CONTENTS-N9
    3 AC-FROM-LINE-N9      (1:99)
    3 AC-TO-LINE-N9        (1:99)
  2 AC-OBJECT-TYPE
  2 AC-OBJECT-TIME
1 READ-FILE VIEW OF READ-FILE
  2 ERROR-CODE
  2 ERROR-TEXT
