* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RPFKEX-C       EXECUTE LOCAL COMMANDS
*
* MAINTENANCE:
* ----------------------------------------------------------------------
INCLUDE RPFKVA-C
G-C-FUNC := 'L'
DECIDE ON FIRST VALUE OF G-PF-FUNC
  VALUE 'HELP' REINPUT USING HELP
  VALUE 'ADD'
    IF NOT #UPDATE
      REINPUT *0020 ALARM
    END-IF
    PERFORM COMMIT-WORK
    G-C-FUNC := 'A'
    FETCH RETURN #ADD-PROGRAM
    GET-SCREEN := TRUE
  VALUE 'EXIT'
    INCLUDE C-ESCAPE
  VALUE 'FLIP'
    PERFORM FLIP-HANDLE
  VALUE 'TOP'    #TOP := TRUE
  VALUE 'UP'     #BACKWARD := TRUE
  VALUE 'DOWN'   #FORWARD := TRUE
  VALUE 'ACTIVE','MASTER'  PERFORM COMMIT-WORK FETCH #ACT-MAST
  VALUE 'REFRESH' #NEWVAL := TRUE
  VALUE 'MENU'
    INCLUDE C-MENU
  VALUE 'FOLLOW'
    PERFORM FOLLOW-MONITOR    /* RHANMOS
    ESCAPE TOP
  NONE VALUE IGNORE
END-DECIDE
