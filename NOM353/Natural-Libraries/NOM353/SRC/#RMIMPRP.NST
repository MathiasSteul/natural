DEFINE SUBROUTINE CHECK-MONITOR-ID
************************************************************************
#M-MONITOR-ID    := #VALUE-CURRENT
#NO. FIND MF-NODE WITH MF-MONITOR-ID = #M-MONITOR-ID
  #VALUE-CURRENT := MF-INTERNAL-NODE-ID
END-FIND
IF *NUMBER (#NO.) = 0 /*SU7
  PRINT (AD=L) 'NOM0005 Import: Node' #M-MONITOR-ID 'does not exist.'
END-IF
*
END-SUBROUTINE /* CHECK-MONITOR-ID
*
