* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    NOMPRL1N
* Function  Printer List API
* Version   1.3.5
*
* Maintenance:
* uuu yy-mm-dd s(999999) ....
* mrs 97-04-25 p(162129) created
* jvd 98-09-10 p(164220) NAT23ÖNOM141
* xsiszha 2000-08-07 (CE7461) Extend Report and Bundle Names
* fhi     2000-08-24 QA03     Use NAT23006 for error values
* sju 02-08-13 p(227525) NOMVERS=2 returns physical printer
* xsetggr 2007-05-18 p(289847) restore NOM lfile when error occurs
* fhi     2007-07-12 NOM3202   C-NATERR changed, NAD23006 is obsolete.
* xsetggr 2008-08-11 p(300323) add steplibs
* xsetggr 2008-12-05 p(300323) change adding of steplibs
* xsetggr 2009-02-10 P300323   delete steplib handling, get EOM-LIBRARY
*                              by RGETLIB
* fhi     2009-02-27 P300323 Rename RGETSTEP to NOMGSTEP delivered in SYSTEM
* fhi     2010-09-21 NOMALL-97 Use no more C-NATERR but C-NATERN instead
* raya    2012-02-07 NOMALL-1096 error-text a250 in NPMPRL-P stow only
* SU1     2014-11-12 NOMALL-1527 getting rid of coding for old versions
* SU2     2014-11-17 NOMALL-1527 deactivate SU1 -it is interface version
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER USING NOMPRL-P
*
LOCAL USING SATFNC3E
LOCAL USING SATLF02P
*
LOCAL
1 PRINTERS VIEW OF NRM-PRINTERS
  2 P-ID
  2 P-NAME
  2 P-PHYSICAL-NAME
1 USERS VIEW OF NRM-USERS
  2 USER-ID
  2 USER-PROFILE
*
1 #PRINTER-F                 (A25)
1 #PRINTER-S                 (A25)
1 #PRINTER-T                 (A25)
1 #LEN                       (N3)
*
1 #LFILE-CHANGED             (L)
1 #NOM-DBID                  (N5)
1 #NOM-FNR                   (N5)
1 #MAX-ENTRIES               (N2) CONST <15>
1 #OBJECT-NAME               (A25)
1 #GRANT-OPTIONS             (A1/1:6)
1 #USER-TYPE                 (A1)
1 #USER-ID                   (A8)
1 GRANTED                    (L)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET NOMPRL-ERROR-CODE NOMPRL-ERROR-TEXT NOMPRL-NUM-ENTRIES
*
DECIDE FOR EVERY CONDITION
  WHEN NOMPRL-NOM-FNR NE 0 AND NOMPRL-NOM-DBID NE 0
    PERFORM GET-NOM-LFILE
    PERFORM SET-NOM-LFILE
    #LFILE-CHANGED := TRUE
  WHEN SATLF-ERROR-CODE = 0
    PERFORM READ-USER-INFO
  WHEN NOMPRL-ERROR-CODE = 0
    PERFORM SELECT-PRINTER
  WHEN #LFILE-CHANGED
    PERFORM SET-OLD-NOM-LFILE
  WHEN NONE
    IGNORE
END-DECIDE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE GET-NOM-LFILE
************************************************************************
SATLF-LFILE    := 206
SATLF-FUNCTION := 'GET'
CALLNAT SAT-GET-SET-LFILE SATLF-SATVERS SATLF-PARMS (*)
#NOM-DBID := SATLF-DBID-N5
#NOM-FNR  := SATLF-FNR-N5
*
END-SUBROUTINE /* GET-NOM-LFILE
*
************************************************************************
DEFINE SUBROUTINE SET-LFILE
************************************************************************
SATLF-LFILE    := 206
SATLF-FUNCTION := 'SET'
CALLNAT SAT-GET-SET-LFILE SATLF-SATVERS SATLF-PARMS (*)
*
END-SUBROUTINE /* OBJECT-MAINTENANCE
*
************************************************************************
DEFINE SUBROUTINE SET-NOM-LFILE
************************************************************************
SATLF-DBID-N5 := NOMPRL-NOM-DBID
SATLF-FNR-N5  := NOMPRL-NOM-FNR
PERFORM SET-LFILE
*
END-SUBROUTINE /* SET-NOM-LFILE
*
************************************************************************
DEFINE SUBROUTINE SET-OLD-NOM-LFILE
************************************************************************
SATLF-DBID-N5 := #NOM-DBID
SATLF-FNR-N5  := #NOM-FNR
*
PERFORM SET-LFILE
*
END-SUBROUTINE /* SET-OLD-NOM-LFILE
*
************************************************************************
DEFINE SUBROUTINE SELECT-PRINTER
************************************************************************
PERFORM INIT-SELECTION-KEYS
*
RESET NOMPRL-PRINTER-NEXT NOMPRL-NUM-ENTRIES NOMPRL-PRINTER-TAB (*)
*
REA. READ PRINTERS BY P-ID = #PRINTER-F THRU #PRINTER-T
  RESET GRANTED
  IF #USER-TYPE = 'A'
    MOVE TRUE TO GRANTED
  ELSE
    #OBJECT-NAME := P-ID
    #USER-ID            := USERS.USER-ID
    CALLNAT 'RGRANT-N' #USER-ID 'P' #OBJECT-NAME GRANTED
      #GRANT-OPTIONS (*)
  END-IF
*
  IF NOT GRANTED
    ESCAPE TOP
  END-IF
*
  NOMPRL-NUM-ENTRIES := NOMPRL-NUM-ENTRIES + 1
  IF NOMPRL-NUM-ENTRIES > #MAX-ENTRIES
    NOMPRL-PRINTER-NEXT := P-ID
    NOMPRL-NUM-ENTRIES := #MAX-ENTRIES
    ESCAPE BOTTOM (REA.)
  END-IF
*
  IF NOMPRL-NOMVERS = 02
    NOMPRL-PRINTER-2       (NOMPRL-NUM-ENTRIES):= P-ID
    NOMPRL-DESCRIPTION-2   (NOMPRL-NUM-ENTRIES):= P-NAME
    NOMPRL-PHYSICAL-PRINTER(NOMPRL-NUM-ENTRIES):= P-PHYSICAL-NAME
  ELSE
    NOMPRL-PRINTER     (NOMPRL-NUM-ENTRIES) := P-ID
    NOMPRL-DESCRIPTION (NOMPRL-NUM-ENTRIES) := P-NAME
  END-IF
*
END-READ
*
END-SUBROUTINE /* SELECT-PRINTER
*
************************************************************************
DEFINE SUBROUTINE INIT-SELECTION-KEYS
************************************************************************
#PRINTER-S := NOMPRL-PRINTER-SELECTION
IF NOMPRL-PRINTER-SELECTION NE SCAN '*'
  COMPRESS #PRINTER-S '*' TO #PRINTER-S LEAVING NO
END-IF
*
#LEN := 8
CALLNAT 'SELALPHA' #PRINTER-S #PRINTER-F #PRINTER-T #LEN
*
IF NOMPRL-PRINTER-NEXT NE ' '
  #PRINTER-F := NOMPRL-PRINTER-NEXT
END-IF
*
END-SUBROUTINE /* INIT-SELECTION-KEYS
*
************************************************************************
DEFINE SUBROUTINE READ-USER-INFO
************************************************************************
IF NOMPRL-USER-ID = ' '
  NOMPRL-USER-ID := *USER
END-IF
*
FNDUS. FIND USERS WITH USER-ID = NOMPRL-USER-ID
  IF NO RECORDS FOUND
    NOMPRL-ERROR-CODE := 0602
    IF *LANGUAGE = 2
      NOMPRL-ERROR-TEXT := 'Benutzer oder Liste ist nicht definiert'
    ELSE
      NOMPRL-ERROR-TEXT := 'User or list not defined'
    END-IF
    ESCAPE BOTTOM (FNDUS.)
  END-NOREC
*
  #USER-TYPE := SUBSTRING (USER-PROFILE, 1, 1)
*
END-FIND
*
END-SUBROUTINE /* READ-USER-INFO
*
************************************************************************
ON ERROR
************************************************************************
  IF #LFILE-CHANGED
    PERFORM SET-OLD-NOM-LFILE
  END-IF
  IF *ERROR-NR = 82
    WRITE *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II':'SS'.'T)
      'Missing NOM steplibs' //
      'Please call NOM steplib routine NOMGSTEP before call of NOM API.'
  END-IF
  NOMPRL-ERROR-CODE := 21
  CALLNAT 'C-NATERN' NOMPRL-ERROR-TEXT
  ESCAPE ROUTINE
END-ERROR
*
END
