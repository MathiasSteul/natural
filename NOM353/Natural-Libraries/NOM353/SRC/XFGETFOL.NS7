* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
************************************************************************
* Function  Return next free folder ID for an user
*           Invoke via: F#GETFOL (<USER-ID>)
*
* Maintenance
* uuuuuu  yyyy-mm-dd iTrac       Remark
* SU      2021-08-18 NOMALL-2457 Created
* ----------------------------------------------------------------------
*
DEFINE FUNCTION F#GETFOL RETURNS #FO-ID (I4)
  DEFINE DATA PARAMETER
  1 #USER-ID                   (A8) BY VALUE
************************************************************************
  LOCAL
  1 NEW-FO VIEW OF NRM-FOLDER
    2 FO-USER-FO-ID
    2 REDEFINE FO-USER-FO-ID
      3 FO-USER                (A8)
      3 FO-NEWID               (B2)
*
  1 #S-USER-FO-ID              (A10)
  1 REDEFINE #S-USER-FO-ID
    2 #S-USER                  (A8)
    2 #S-FO-ID                 (B2)
  1 #E-USER-FO-ID              (A10)
  1 REDEFINE #E-USER-FO-ID
    2 #E-USER                  (A8)
    2 #E-FO-ID                 (B2)
* *****
  END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET #S-FO-ID
#E-USER := #S-USER := #USER-ID
#E-FO-ID := H'FFFF'
HISTOGRAM NEW-FO FOR FO-USER-FO-ID FROM #S-USER-FO-ID
    THRU #E-USER-FO-ID
  #FO-ID := FO-NEWID
END-HISTOGRAM
IF #FO-ID < 100
  #FO-ID := 100
END-IF
ADD 1 TO #FO-ID
*
END-FUNCTION /*F#GETFOL
*
END
