DEFINE DATA LOCAL
/* >Natural Source Header 000000
/* :Mode S
/* :CP
/* <Natural Source Header
*   RMSPL5-L- Spool attribute        definition
*   CONVERSION 5BYTE JOBNUMBER TO N7
*
*   Maintenance
*   uuu yy-mm-dd s(999999) ...
*   mrs 95-02-07 s(217959) power spoo       ledpages and user information added
*   mrs 95-03-31 s(220063) bs2 spool-      bs2-orig-dsname added
*   MRS 95-05-30 S(225794) BS2 CLASS       addeD
*   JWO 97-09-09 S(165177) ADD TRIGGE       RINFO TO SPOOL-ATTRIBUTES
*   JVD 98-09-14 P(164220) NOM141
*   gw  98-10-31 s(999999) NAF dbid /       fnr compatibility
*   gw  98-11-03 s(300070) spool-jes-      dsno N5 instead of N3
*   NOM3107 SUPPORT 7 BYTE JOBNUMBRS
*   xsetggr 2007-05-14 NOM3201                 Support 5 byte node number
*   XSETGGR 2009-08-13 P319465                 CORRECT NOM3201
*   XSETGGR 2009-10-09 P320826       CORRECT IFEMPTY POWER SEGMENTS
*   SU1     2024-03-07 ES-34613      NOM 3.6:  Remove power
*   ---------------------------------      -----------------------------------
*   Spool Attributes
*   ---------------------------------      -----------------------------------
1 #SPOOL-ATTR-5 (A250)
1 REDEFINE #SPOOL-ATTR-5
  2 #SPOOL5-TYPE (I2)
  2 #SPOOL5-ATTRIB (A248)
*   ---------------------------------      -----------------------------------
*   JES
*   ---------------------------------      -----------------------------------
  2 REDEFINE #SPOOL5-ATTRIB
    3 #SPOOL5-JES-NODE (N3)
    3 #SPOOL5-JES-JOB-NAME (A10)
    3 #SPOOL5-JES-JOB-NUMBER (N5)
    3 #SPOOL5-JES-DSTYPE (A2)
    3 #SPOOL5-JES-DSNO-OLD (N3)
    3 #SPOOL5-JES-DATASET-KEY (N7)
    3 #SPOOL5-JES-GROUP-ID (A20)
    3 #SPOOL5-JES-PROCNAME (A8)
    3 #SPOOL5-JES-STEPNAME (A8)
    3 #SPOOL5-JES-DDNAME (A8)
    3 #SPOOL5-JES-CHARS (A20)
    3 #SPOOL5-JES-FCB (A4)
    3 #SPOOL5-JES-FLASH (A4)
    3 #SPOOL5-JES-FORM (A8)
    3 #SPOOL5-JES-FORMDEF (A8)
    3 #SPOOL5-JES-PAGEDEF (A8)
    3 #SPOOL5-JES-TRC (A3)
    3 #SPOOL5-JES-RECFM (A3)
    3 #SPOOL5-JES-COPIES (N3)
    3 #SPOOL5-JES-UCS (A4)
    3 #SPOOL5-JES-BURST (A3)
    3 #SPOOL5-JES-COMPACT (A8)
    3 #SPOOL5-JES-LINECT (N3)
    3 #SPOOL5-JES-DESTINATION (A8)
    3 #SPOOL5-JES-TRIGGER-DSNAME (A44)
    3 #SPOOL5-JES-DSNO (N5)
* **SU1 POWER: #SPOOL5-POWER-..
* **End of LDA RMSPL5-L *************************************************
END-DEFINE
