* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    NOMPR02N
* Function  Logical printer maintenance API
* Version 2.1.1
*
* Maintenance:
* uuu yy-mm-dd s(999999) ....
* xsiszha  2000-05-30 s(CE7760) created
* fhi      2000-08-24 QA03      Use NAT23006 for error values
* xsetggr  2005-01-20 p(261181) use right library to get err msg
* xsetggr  2005-03-30 nom31
* xsetggr 2005-06-30 p(265613) evaluate eom-def-user
* xsetggr 2007-05-18 p(289847) restore NOM lfile when error occurs
* fhi     2007-07-12 NOM3202   C-NATERR changed, NAD23006 is obsolete.
* xsetggr 2008-08-11 p(300323) add steplibs
* xsetggr 2008-12-05 p(300323) change adding of steplibs
* xsetggr 2009-02-10 P300323   delete steplib handling, get EOM-LIBRARY
*                              by RGETLIB
* fhi     2009-02-27 P300323 Rename RGETSTEP to NOMGSTEP delivered in SYSTEM
* fhi     2010-09-21 NOMALL-97 Use no more C-NATERR but C-NATERN instead
* raya    2012-02-07 NOMALL-1096 error-text a250 not 70 stow only
* SU1     2014-06-10 NOMALL-1281 show last update user+date
* SU2     2018-04-06 NOMALL-1961 Use new task IDs
* ----------------------------------------------------------------------
DEFINE DATA
PARAMETER USING NOMPR--P
*
LOCAL USING NOMPR--E
LOCAL USING EOM----P
LOCAL USING EOM----E
LOCAL USING EOMPRM-P
LOCAL USING EOMPRM-E
LOCAL USING EOMMSG-P
LOCAL USING SATFNC3E
LOCAL USING SATLF02P
LOCAL
1 #LFILE-CHANGED             (L)
1 #NOM-DBID                  (N5)
1 #NOM-FNR                   (N5)
1 #I                         (I4)
1 #J                         (I4)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET NOMPR-ERROR-CODE NOMPR-ERROR-TEXT
*
DECIDE FOR EVERY CONDITION
  WHEN NOMPR-NOM-FNR NE 0 AND NOMPR-NOM-DBID NE 0
    PERFORM GET-NOM-LFILE
    PERFORM SET-NOM-LFILE
    #LFILE-CHANGED := TRUE
  WHEN SATLF-ERROR-CODE = 0
    PERFORM LOGICAL-PRINTER-MAINTENANCE
  WHEN #LFILE-CHANGED
    PERFORM SET-OLD-NOM-LFILE
  WHEN NONE
    IGNORE
END-DECIDE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE GET-NOM-LFILE
************************************************************************
SATLF-LFILE    := 206
SATLF-FUNCTION := 'GET'
CALLNAT SAT-GET-SET-LFILE SATLF-SATVERS SATLF-PARMS (*)
#NOM-DBID := SATLF-DBID-N5
#NOM-FNR  := SATLF-FNR-N5
*
END-SUBROUTINE /* GET-NOM-LFILE
*
************************************************************************
DEFINE SUBROUTINE SET-LFILE
************************************************************************
SATLF-LFILE    := 206
SATLF-FUNCTION := 'SET'
CALLNAT SAT-GET-SET-LFILE SATLF-SATVERS SATLF-PARMS (*)
*
END-SUBROUTINE /* SET-LFILE
*
************************************************************************
DEFINE SUBROUTINE SET-NOM-LFILE
************************************************************************
SATLF-DBID-N5 := NOMPR-NOM-DBID
SATLF-FNR-N5  := NOMPR-NOM-FNR
PERFORM SET-LFILE
*
END-SUBROUTINE /* SET-NOM-LFILE
*
************************************************************************
DEFINE SUBROUTINE SET-OLD-NOM-LFILE
************************************************************************
SATLF-DBID-N5 := #NOM-DBID
SATLF-FNR-N5  := #NOM-FNR
PERFORM SET-LFILE
*
END-SUBROUTINE /* SET-OLD-NOM-LFILE
*
************************************************************************
DEFINE SUBROUTINE CALL-INTERNAL-API
************************************************************************
RESET EOMMSG-PARMS
CALLNAT 'EOMPRM-N' EOM-PARMS EOMPRM-PARMS EOMMSG-PARMS
IF EOMMSG-NR NE 0
  NOMPR-ERROR-CODE := EOMMSG-NR
  IF EOMMSG-TEXT = ' ' /*SU2
    NOMPR-ERROR-TEXT := F#GETMSG (<NOMPR-ERROR-CODE, EOMMSG-TOKEN(1:3)>)
  ELSE
    NOMPR-ERROR-TEXT := EOMMSG-TEXT
  END-IF
END-IF
*
END-SUBROUTINE /* CALL-INTERNAL-API
*
************************************************************************
DEFINE SUBROUTINE LOGICAL-PRINTER-MAINTENANCE
************************************************************************
RESET EOM-LOGGING EOM-LOG-TYPES (*)
EOMPRM-I-ATTRIBUTE-TYPE := NOMPR-ATTRIBUTE-TYPE
EOMPRM-I-TARGET-DBID    := NOMPR-NOM-DBID
EOMPRM-I-TARGET-FNR     := NOMPR-NOM-FNR
EOMPRM-I-NAME           := NOMPR-PRINTER-ID
EOMPRM-I-NEWNAME        := NOMPR-PRINTER-NEWID
IF NOT (NOMPR-LANGUAGE = 1 OR = 2)
  EOM-LANGUAGE := *LANGUAGE
ELSE
  EOM-LANGUAGE := NOMPR-LANGUAGE
END-IF
EOM-USER         := NOMPR-USER-ID
EOM-VERSION      := NOMPR-NOMVERS
EOM-LOG-TYPES(1) := NOMPR-LOG-TYP
EOM-FUNCTION     := NOMPR-FUNCTION
EOMPRM-ATTR (*)  := NOMPR-ATTR (*)
CALLNAT 'RGETLIB' EOM-LIBRARY
COMPRESS EOM-LIBRARY 'U' TO EOM-USER-LIBRARY LEAVING NO
EOM-DEF-USER := F#MONITOR-USER-AUTODEF (<>) /*SU2
*
IF NOMPR-FUNCTION = NOMPR-FCT-MODIFY AND
    NOMPR-ATTRIBUTE-TYPE = PRINTER-SPECIAL-ATTRIBUTES
  EOM-FUNCTION := EOM-READHOLD
  PERFORM CALL-INTERNAL-API
  IF EOMMSG-NR = 0
    PERFORM MODIFY-SPECIAL-ATTRIBUTES
    EOM-FUNCTION := EOM-MODIFY
  END-IF
END-IF
*
IF EOMMSG-NR = 0
  PERFORM CALL-INTERNAL-API
END-IF
*
IF EOMMSG-NR = 0
  IF NOMPR-FUNCTION = NOMPR-FCT-READ OR = NOMPR-FCT-READ-NEXT
      OR = NOMPR-FCT-READ-HOLD OR = NOMPR-FCT-READ-HOLD-NEXT
    NOMPR-ATTR (*) := EOMPRM-ATTR (*)
    NOMPR-PRINTER-ID := EOMPRM-I-NAME
    NOMPR-EOF := EOMPRM-EOF
  END-IF
*
  IF NOMPR-FUNCTION = NOMPR-FCT-ADD
    IF EOMMSG-NR = 0
      PERFORM MODIFY-SPECIAL-ATTRIBUTES
      IF NOMPR-ERROR-CODE = 0
        EOM-FUNCTION := EOM-MODIFY
        PERFORM CALL-INTERNAL-API
        IF EOMMSG-NR NE 0
          EOM-FUNCTION := EOM-BACKOUT
          PERFORM CALL-INTERNAL-API
        END-IF
      ELSE
        EOM-FUNCTION := EOM-BACKOUT
        PERFORM CALL-INTERNAL-API
      END-IF
    END-IF
  END-IF
END-IF
*
END-SUBROUTINE /* LOGICAL-PRINTER-MAINTENANCE
*
************************************************************************
DEFINE SUBROUTINE MODIFY-SPECIAL-ATTRIBUTES
************************************************************************
FOR #I 1 25
  IF EOMPRM-ATTR-VAR (*) = NOMPR-ATTR-VAR (#I)
    EXAMINE FULL EOMPRM-ATTR-VAR (*) FOR FULL NOMPR-ATTR-VAR (#I)
      GIVING INDEX #J
    IF #J NE 0
      EOMPRM-ATTR-VALUE (#J) := NOMPR-ATTR-VALUE (#I)
    END-IF
  ELSE
    IF NOMPR-ATTR-VAR (#I) NE ' '
      NOMPR-ERROR-CODE := 126 /*Attribute :1: invalid.
      NOMPR-ERROR-TEXT :=F#GETMSG(<NOMPR-ERROR-CODE,NOMPR-ATTR-VAR(#I)>)
      ESCAPE ROUTINE
    END-IF
  END-IF
END-FOR
*
END-SUBROUTINE /* MODIFY-SPECIAL-ATTRIBUTES
*
************************************************************************
ON ERROR
************************************************************************
  IF #LFILE-CHANGED
    PERFORM SET-OLD-NOM-LFILE
  END-IF
  IF *ERROR-NR = 3009 OR = 3145
    NOMPR-ERROR-CODE := *ERROR-NR
  ELSE
    IF *ERROR-NR = 82
      WRITE *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II':'SS'.'T)
        'Missing NOM steplibs' //
      'Please call NOM steplib routine NOMGSTEP before call of NOM API.'
    END-IF
    NOMPR-ERROR-CODE := 21
    CALLNAT 'C-NATERN' EOMMSG-TOKEN(1)
  END-IF
  NOMPR-ERROR-TEXT := F#GETMSG (<NOMPR-ERROR-CODE, EOMMSG-TOKEN(1:3)>)
  ESCAPE ROUTINE
END-ERROR
*
END
