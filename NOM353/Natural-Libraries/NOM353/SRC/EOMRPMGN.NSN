* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    EOMRPMGN
* Version   1.3
* Function  DB Interface EOM Object Report (general attributes)
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* mrs 93-05-21           created
* jvd 97-07-08 p(163579) separator page length truncation
*                        re-cat as EOMRPM-P change
* wcd 00-04-01 CE 7267   re-cat as changes made to EOMRPM-P
* xsethz   2000-05-30 s(CE7760) READ-NEXT, READ-HOLD-NEXT added
* fhi      2000-08-24 QA03      Use NAT23006 for error values
* sju 02-04-23 NOM221    Archive type
* fhi     2007-07-12 NOM3202   C-NATERR changed, NAD23006 is obsolete.
* splildav 2009-06-11 P318149  Do not allowed report type to be 'C'
* xsetggr 2010-11-16  NOMALL-879 init create-definition value
* fhi     2013-08-29 FHI285    Enhance error message 406
* SU1     2013-11-22 NOMALL-1288 correct FHI285 for msg 406
* SU2     2014-06-02 NOMALL-1281 show last update user+date
* SU3     2014-07-10 NOMALL-1281 correct SU2 (use correct fields)
* fhi     2014-08-26 NOMALL-1475 Recat for new field 'FORMATTER'
* fhi     2016-09-30 NOMALL-1620 Add fields REMOTE-NODE-ID / CODEPAGE
* fhi     2016-11-15 NOMALL-1961 Use new task IDs
* fhi     2017-01-17 NOMALL-1620 Extend changes of 2016-09-30
* fhi     2018-03-13 NOMALL-1918 Correct multinode behavior, no tags
* SU4     2018-07-30             allow empty codepage(deact. NOMALL-1918
* fhi     2018-10-29 NOMALL-2125 Use codepage at identification only
* SU5     2020-04-27 NOMALL-2349 remove unused
* SU6     2020-11-10 NOMALL-2440 split DDM -> NRM-MF-NODES
* ----------------------------------------------------------------------
DEFINE DATA
PARAMETER
1 EOM-FUNCTION           (I2)
PARAMETER USING EOMRPM-P
PARAMETER USING EOMMSG-P
************************************************************************
LOCAL USING EOM----E
LOCAL USING VDEFRP-L
LOCAL
1 REPORT VIEW OF NRM-REPORTS-NEW
  2 R-REPNAME
  2 R-MASTER-REPNAME
  2 R-TYPE
  2 R-DESC
  2 R-USERID
  2 R-STORE-NATRPT
  2 R-KEYWORDS           (1:3)
  2 R-RETENTION-ACTION
  2 R-RETENTION-PERIOD
  2 REDEFINE R-RETENTION-PERIOD
    3 R-RET-NUMBER       (N3)
    3 R-RET-FACTOR       (A1)
    3 R-RET-CALENDAR     (A8)
  2 R-ARCHIVE
  2 R-ARCHIVE-RETENTION
  2 R-REVIVE-RETENTION
  2 REDEFINE R-REVIVE-RETENTION
    3 R-REV-NUMBER       (N3)
    3 R-REV-FACTOR       (A1)
    3 R-REV-CALENDAR     (A8)
  2 R-ARCHIVE-TYPE
  2 R-LAST-UPDATE /*SU3
  2 R-LAST-UPDATE-USER /*SU3
  2 R-INTERNAL-NODE-ID               /* NOMALL-1620 fhi in
  2 R-REMOTE-CODEPAGE              /* NOMALL-1620 fhi in
1 REPORT-VALUES VIEW OF NRM-REPORTS-NEW
  2 R-SEPMEM
  2 REDEFINE R-SEPMEM
    3 R-SEP-START        (A8)
    3 R-SEP-END          (A8)
  2 R-SEPNO
  2 R-PRINT-JOBCARD      (1:3)
  2 R-CREATE-DEFINITION            /* xsetggr 2010-11-16 NOMALL-879 in
* -----------------------------local variables--------------------------
1 #ARCHIVE-RETENTION     (A5)
1 REDEFINE #ARCHIVE-RETENTION
  2 #ARET                (A1/1:5)
1 L                      (P2)
1 #ISN                   (P10)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
DECIDE ON FIRST EOM-FUNCTION
  VALUE EOM-INIT
    PERFORM INIT-GENERAL-ATTRIBUTES
  VALUE EOM-READ, EOM-READ-NEXT, EOM-READHOLD, EOM-READHOLD-NEXT
    PERFORM READ-GENERAL-ATTRIBUTES
  VALUE EOM-ADD, EOM-MODIFY
    PERFORM MODIFY-GENERAL-ATTRIBUTES
  NONE  IGNORE
END-DECIDE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE INIT-GENERAL-ATTRIBUTES
************************************************************************
RESET EOMRPM-GENERAL-ATTRIBUTES
EOMRPM-REPORT-TYPE := 'M'
PERFORM READ-REPORT-DEFAULTS
EOMRPM-ARCHIVE              := REPORT-DEFAULTS.R-ARCHIVE
EOMRPM-STORE-IN-DIRECTORY-FILE := REPORT-DEFAULTS.R-STORE-NATRPT
EOMRPM-RET-ACTION           := REPORT-DEFAULTS.R-RETENTION-ACTION
EOMRPM-RET-NUMBER           := REPORT-DEFAULTS.R-RETENTION-NUM
EOMRPM-RET-FACTOR           := REPORT-DEFAULTS.R-RETENTION-UNIT
EOMRPM-RET-CALENDAR         := REPORT-DEFAULTS.R-RETENTION-CALENDAR
*
END-SUBROUTINE /* INIT-GENERAL-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE READ-REPORT-DEFAULTS
************************************************************************
M-MONITOR-ID := F#MONITOR-TASK-ID1 (<>)
FNDDEF. FIND REPORT-DEFAULTS WITH M-MONITOR-ID = M-MONITOR-ID
END-FIND
*
END-SUBROUTINE /* READ-REPORT-DEFAULTS
*
************************************************************************
DEFINE SUBROUTINE READ-GENERAL-ATTRIBUTES
************************************************************************
FNDRP. FIND REPORT WITH R-REPNAME = EOMRPM-I-NAME
  IF NO RECORDS FOUND
    EOMMSG-NR := 0406
    COMPRESS EOMRPM-I-NAME ' (' *PROGRAM ',' *LINE ')'
      TO EOMMSG-TOKEN(1) LEAVING NO
    ESCAPE BOTTOM (FNDRP.)
  END-NOREC
*
  EOMRPM-REPORT-TYPE             := R-TYPE
  EOMRPM-DESC                    := R-DESC
  EOMRPM-KEYWORDS (*)            := R-KEYWORDS (*)
  EOMRPM-MASTER-REPORT           := R-MASTER-REPNAME
  EOMRPM-MASTER-OWNER            := R-USERID
  EOMRPM-STORE-IN-DIRECTORY-FILE := R-STORE-NATRPT
  EOMRPM-LAST-UPDATE-USER        := R-LAST-UPDATE-USER /*SU3
  EOMRPM-LAST-UPDATE             := R-LAST-UPDATE /*SU3
  EOMRPM-RET-ACTION              := R-RETENTION-ACTION
  EOMRPM-RET-NUMBER              := R-RET-NUMBER
  EOMRPM-RET-FACTOR              := R-RET-FACTOR
  EOMRPM-RET-CALENDAR            := R-RET-CALENDAR
  EOMRPM-REV-NUMBER              := R-REV-NUMBER
  EOMRPM-REV-FACTOR              := R-REV-FACTOR
  EOMRPM-REV-CALENDAR            := R-REV-CALENDAR
* fhi     2017-01-17 NOMALL-1620 start insertion
  EOMRPM-INTERNAL-NODE-ID        := R-INTERNAL-NODE-ID
* EOMRPM-REMOTE-CODEPAGE         := R-REMOTE-CODEPAGE /* NOMALL-2125 out
/*SU4 IF EOMRPM-REMOTE-CODEPAGE = ' ' /*fhi 2018-03-13 NOMALL-1918
/*SU4    EOMRPM-REMOTE-CODEPAGE := +NOD-CURRENT-CODEPAGE END-IF
  IF R-ARCHIVE-RETENTION = ' '
    RESET EOMRPM-ARC-NUMBER EOMRPM-ARC-FACTOR
  ELSE
    #ARCHIVE-RETENTION := R-ARCHIVE-RETENTION
    IF #ARCHIVE-RETENTION IS (N4)
      EOMRPM-ARC-FACTOR := 'D'
    ELSE
      EXAMINE #ARCHIVE-RETENTION FOR 'X' GIVING LENGTH  L
      EOMRPM-ARC-FACTOR := #ARET (L)
      RESET  #ARET (L)
    END-IF
    IF #ARCHIVE-RETENTION IS (N4)
      EOMRPM-ARC-NUMBER := VAL (#ARCHIVE-RETENTION)
    ELSE
      RESET  EOMRPM-ARC-NUMBER
    END-IF
  END-IF
  EOMRPM-ARCHIVE := R-ARCHIVE
  EOMRPM-ARCHIVE-TYPE := R-ARCHIVE-TYPE
  IF EOMRPM-ARCHIVE-TYPE = '0'
    RESET EOMRPM-ARCHIVE-TYPE
  END-IF
*
  IF EOM-FUNCTION = EOM-READHOLD OR = EOM-READHOLD-NEXT
    UPD. GET REPORT *ISN (FNDRP.)
    IF R-REPNAME NE R-REPNAME
      UPDATE (UPD.)
    END-IF
  END-IF
*
END-FIND
*
END-SUBROUTINE /* READ-GENERAL-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE MODIFY-GENERAL-ATTRIBUTES
************************************************************************
FNDMOD. FIND REPORT WITH R-REPNAME = EOMRPM-I-NAME
  IF NO RECORDS FOUND
    ENTER
  END-NOREC
*
  DECIDE FOR FIRST CONDITION
    WHEN EOM-FUNCTION = EOM-ADD AND *NUMBER (FNDMOD.) = 0
      R-REPNAME := EOMRPM-I-NAME
    WHEN EOM-FUNCTION = EOM-ADD AND *NUMBER (FNDMOD.) > 0
      EOMMSG-NR := 0304
      ESCAPE BOTTOM (FNDMOD.)
    WHEN EOM-FUNCTION = EOM-MODIFY AND *NUMBER (FNDMOD.) = 0
      EOMMSG-NR := 0406
      COMPRESS EOMRPM-I-NAME ' (' *PROGRAM ',' *LINE ')'
        TO EOMMSG-TOKEN(1) LEAVING NO
      ESCAPE BOTTOM (FNDMOD.)
    WHEN NONE IGNORE
  END-DECIDE
*
  IF R-TYPE = 'M' OR = 'S' OR = 'D' AND EOMRPM-REPORT-TYPE = 'C'
    EOMMSG-NR := 1101
    EOMMSG-FIELD-NAME := 'EOMRPM-REPORT-TYPE'
    ESCAPE BOTTOM (FNDMOD.)
  END-IF
*
  IF *NUMBER > 0
    GETMOD. GET REPORT *ISN (FNDMOD.)
  END-IF
*
  R-TYPE             := EOMRPM-REPORT-TYPE
  R-DESC             := EOMRPM-DESC
  R-KEYWORDS (*)     := EOMRPM-KEYWORDS (*)
  R-USERID           := EOMRPM-MASTER-OWNER
  R-STORE-NATRPT     := EOMRPM-STORE-IN-DIRECTORY-FILE
  R-LAST-UPDATE-USER := EOMRPM-LAST-UPDATE-USER  /*SU3
  R-LAST-UPDATE      := EOMRPM-LAST-UPDATE       /*SU3
*
  R-RETENTION-ACTION := EOMRPM-RET-ACTION
  R-RET-NUMBER       := EOMRPM-RET-NUMBER
  R-RET-FACTOR       := EOMRPM-RET-FACTOR
  R-RET-CALENDAR     := EOMRPM-RET-CALENDAR
* fhi     2016-09-30 NOMALL-1620 start insertion
  R-INTERNAL-NODE-ID := EOMRPM-INTERNAL-NODE-ID
* R-REMOTE-CODEPAGE  := EOMRPM-REMOTE-CODEPAGE /* NOMALL-2125 fhi out
/*SU4 IF R-REMOTE-CODEPAGE = ' ' /*fhi 2018-03-13 NOMALL-1918
/*SU4    R-REMOTE-CODEPAGE := +NOD-CURRENT-CODEPAGE END-IF
* fhi     2016-09-30 NOMALL-1620 end   insertion
  IF EOMRPM-ARC-NUMBER = 0 AND EOMRPM-ARC-FACTOR = ' '
    RESET R-ARCHIVE-RETENTION
  ELSE
    COMPRESS EOMRPM-ARC-NUMBER EOMRPM-ARC-FACTOR
      TO R-ARCHIVE-RETENTION LEAVING NO
  END-IF
  R-ARCHIVE := EOMRPM-ARCHIVE
  IF EOMRPM-ARCHIVE-TYPE IS (N1)
    R-ARCHIVE-TYPE := VAL(EOMRPM-ARCHIVE-TYPE)
  ELSE
    IF EOMRPM-ARCHIVE-TYPE = ' '
      RESET R-ARCHIVE-TYPE
    END-IF
  END-IF
*
  R-REV-NUMBER   := EOMRPM-REV-NUMBER
  R-REV-FACTOR   := EOMRPM-REV-FACTOR
  R-REV-CALENDAR := EOMRPM-REV-CALENDAR
*
  IF *NUMBER (FNDMOD.) = 0
    STORP. STORE REPORT
    #ISN := *ISN (STORP.)
    PERFORM INIT-OTHER-DEFAULTS
  ELSE
    UPDATE (GETMOD.)
  END-IF
*
END-FIND
*
END-SUBROUTINE /* MODIFY-GENERAL-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE INIT-OTHER-DEFAULTS  /* xsetggr 2010-11-16 change name
************************************************************************
PERFORM READ-REPORT-DEFAULTS
GETPR. GET REPORT-VALUES #ISN
REPORT-VALUES.R-SEP-START         := REPORT-DEFAULTS.R-SEPSTART
REPORT-VALUES.R-SEP-END           := REPORT-DEFAULTS.R-SEPEND
REPORT-VALUES.R-SEPNO             := REPORT-DEFAULTS.R-SEPNO
REPORT-VALUES.R-PRINT-JOBCARD(1:3):=REPORT-DEFAULTS.R-PRINT-JOBCARD(1:3)
REPORT-VALUES.R-CREATE-DEFINITION := REPORT-DEFAULTS.R-CREATE-DEFINITION
UPDATE (GETPR.)
*
END-SUBROUTINE /* INIT-OTHER-DEFAULTS
* --------------------------------------- on error ---------------------
INCLUDE C-EOMERR
*
END
