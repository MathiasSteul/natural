* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* --------------------------------------------------------------------
** Subprogram  NOUXLS-N
** Version    2.2.1
** Function   NOM API Unix node List
**
** Maintenance:
** XSETHZ  2002-03-17   created
** XSETGGR 2002-06-07   rename subroutine
** fhi     2002-10-30   fhi101    switch on optimizer compiler
* SU1     2016-07-29 NOMALL-1518 NOM3.5 deactivate opt.Compiler
* SU2     2020-12-01 NOMALL-2440 del. UX-EMAIL-RECIPIENTS
** --------------------------------------------------------------------
DEFINE DATA
PARAMETER USING ESMCNT-A
PARAMETER USING ESMINP-A
PARAMETER USING ESMWORKA
PARAMETER USING NOUXLS-A
* *****
LOCAL     USING VUXDEF-L
LOCAL
1 #I2             (I4)
1 #IMAX           (I4)
1 #NODE-NAME-S    (A16)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET ES-RC ES-NUMBER ES-SORTKEY ES-SORTORDER ES-STARTINDEX
ES-OPTION-COUNT := 0
DECIDE ON FIRST VALUE OF ES-FUNCTION
  VALUE 'LS1'
    #IMAX := 1581
    ES-FIELD-COUNT := 1
    NOUXLN-FIELD-LENGTH(1) := 16
  VALUE 'LS2'
    #IMAX := 25
    ES-FIELD-COUNT := 38
    NOUXLA-FIELD-LENGTH(1) := 16
    NOUXLA-FIELD-LENGTH(2) := 50
    NOUXLA-FIELD-LENGTH(3) := 8
    NOUXLA-FIELD-LENGTH(4) := 32
    NOUXLA-FIELD-LENGTH(5) := 8
    NOUXLA-FIELD-LENGTH(6) := 1
    NOUXLA-FIELD-LENGTH(7) := 2
    NOUXLA-FIELD-LENGTH(8) := 70
    NOUXLA-FIELD-LENGTH(9:18) := 70
    NOUXLA-FIELD-LENGTH(19:28) := 5
    NOUXLA-FIELD-LENGTH(29:38) := 5
  NONE VALUE IGNORE
END-DECIDE
ES-EOF := 'X'
RESET ES-NUMBER
IF ES-NEXT-KEY-PARM(1) NE ' '
  #NODE-NAME-S := ES-NEXT-KEY-PARM(1)
ELSE
  #NODE-NAME-S := H'00'
END-IF
PERFORM READ-UX
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
***********************************************************************
DEFINE SUBROUTINE READ-UX
***********************************************************************
READ UX-NODES WITH UX-NODE-NAME = #NODE-NAME-S
  PERFORM DATA-TO-PDA
END-READ
*
END-SUBROUTINE /* READ-UX
*
**********************************************************************
DEFINE SUBROUTINE DATA-TO-PDA
***********************************************************************
ADD 1 TO #I2
IF #I2 > #IMAX
  ES-NEXT-KEY-PARM(1) := UX-NODE-NAME
  ES-NUMBER := #IMAX
  RESET ES-EOF
  ESCAPE BOTTOM
END-IF
DECIDE ON FIRST VALUE OF ES-FUNCTION
  VALUE 'LS1'
    NOUXLN-NODE-NAME(#I2) := UX-NODE-NAME
  VALUE 'LS2'
    NOUXLA-NODE-NAME         (#I2)      := UX-NODE-NAME
    NOUXLA-NODE-DESCRIPTION  (#I2)      := UX-NODE-DESCRIPTION
    NOUXLA-NODE-USERID       (#I2)      := UX-NODE-USERID
    NOUXLA-NODE-PASSWORD     (#I2)      := UX-NODE-PASSWORD
    NOUXLA-NODE-GROUP        (#I2)      := UX-NODE-GROUP
    NOUXLA-NODE-SUSPEND      (#I2)      := UX-NODE-SUSPEND
    NOUXLA-NODE-TIMEOUT      (#I2)      := UX-NODE-TIMEOUT
    NOUXLA-NODE-TEMPDIR      (#I2)      := UX-NODE-TEMPDIR
    NOUXLA-NODE-PATH         (#I2,1:10) := UX-NODE-PATH(1:10)
    NOUXLA-NODE-CONTAINER-DB (#I2,1:10) := UX-NODE-CONTAINER-DB(1:10)
    NOUXLA-NODE-CONTAINER-FNR(#I2,1:10) := UX-NODE-CONTAINER-FNR(1:10)
  ANY
    ES-NUMBER := #I2
  NONE IGNORE
END-DECIDE
*
END-SUBROUTINE /*DATA-TO-PDA
*
END
