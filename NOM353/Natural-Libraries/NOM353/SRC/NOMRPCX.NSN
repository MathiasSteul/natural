LOCAL USING RMTASK-E
LOCAL USING NADA2000
LOCAL USING NAD-MSG
LOCAL USING NAD-FLD
*
LOCAL /* VIEWS
1 QUEUE-ENTRY VIEW OF NRM-NOMPUT-QUEUE
  2 NP-STATUS
  2 NP-TYPE
  2 NP-ATTRIBUTES-IDENT
  2 NP-SPOOL-ATTRIBUTES
  2 NP-SPOOL-ATTRIBUTES-EXTENDED (1:120)
  2 NP-CC-TYPE
  2 NP-RECORD-LENGTH
  2 NP-NUMBER-OF-LINES
1 CONTAINER VIEW OF NRM-SOURCE-TEXT
  2 ST-TYPE
  2 ST-ID
  2 ST-IDENT
  2 ST-LINE-START
  2 ST-LINE-END
  2 ST-TEXT                (1:66)
  2 REDEFINE ST-TEXT
    3 ST-B-LOB-CH          (A1/1:16381)
  2 REDEFINE ST-TEXT
    3 #ST-TEXT-BUFFER-LOB  (A16381)    /* 251 * 66
  2 REDEFINE ST-TEXT
    3 ST-BUFFER-PREFIX     (A3)
    3 ST-BUFFER-LENGTH-X   (B4)
1 AR VIEW OF NRM-ACTIVE-REPORTS
  2 AR-REPNAME
  2 AR-REPRNB
  2 AR-SPOOL-ATTR-EXTENDED (1:120)
  2 AR-ARCHIVE
  2 AR-REVIVE
  2 AR-SOURCE
  2 AR-SENDER
1 PO VIEW OF NRM-PRINTOUTS
  2 PO-STATUS
* *****
1 #NSMCOMP-CB              (B40)
1 REDEFINE #NSMCOMP-CB
  2 #NSMCOMP-COMMAND       (A1)
  2 #NSMCOMP-CODE          (B1)
  2 #NSMCOMP-INLENGTH-OLD  (B1)
  2 #NSMCOMP-OUTLENGTH-OLD (B1)
  2 #NSMCOMP-INLENGTH      (B2)
  2 #NSMCOMP-OUTLENGTH     (B2)
*
1 #NSMCOMP-RC              (B2)
1 #NSMCOMP-WORK            (B4)
1 #NSMCOMP-LINE            (A251)
1 #NSMCOMP-BUFFER-LENGTH   (B4)
1 #TAG                     (A250)
1 #TAG-CURRENT             (A250)
1 #TAG-GROUP               (A250)
1 #VALUE                   (A) DYNAMIC
1 #VALUE-GROUP             (A250)
1 #VALUE-GROUP-COMPARE     (A250)
1 #RC                      (N4)
1 #MSG                     (A250)
1 #XML-PREFIX              (A100)
1 #XML                     (A)   DYNAMIC
1 #XML-TEMP                (A)   DYNAMIC
1 #FILTER                  (B126)
1 REDEFINE #FILTER
  2 #FILTER-TABLE          (B2/63)
1 #NP-QUEUE                (A67)
1 REDEFINE #NP-QUEUE
  2 #NP-STATUS             (I2)
  2 #NP-TYPE               (I2)
  2 #NP-IDENT              (A63)
1 #STRING                  (A251)
1 #STRING2                 (A251)
1 #POS-ABS                 (I4)
1 #POS-END                 (I4)
1 #POS-LEN                 (I4)
1 #POS-REPNAME             (I2)
1 #POS                     (I4)
1 #LEN                     (I4)
1 #MAX                     (I2)
1 #LFILE-PASSWD            (A8)
1 #LFILE-CIPHER            (A8)
1 #LFILE-RC                (I4)
1 #ST-PARMS
  2 #ST-ID                 (P10)
  2 #ST-RC                 (N4)
  2 #ST-ERRTXT             (A250)
1 #LFILE-158               (N5) CONST <158>
1 #NOMGSTEP-FUNCT          (A1)  INIT<'*'>
1 #NOMGSTEP-RC             (N4)
1 #I                       (I4)
1 #J                       (I4)
1 #K                       (I4)
1 #L                       (I4)
1 #CR                      (A2)  CONST <H'0D0A'>
1 #TAB                     (A2)  CONST <H'09'>
1 #WAITTIME                (I02) INIT <1>
1 #LANGUAGE                (N2)
1 #TRACE-MSG               (A250)
1 #TRACING                 (L)
1 #FROM                    (P10)
1 #TO                      (P10)
1 #IN-BUFFER               (L)
1 #AR-REPORT-RNB           (A31)
1 REDEFINE #AR-REPORT-RNB
  2 #AR-REPNAME            (A25)
  2 #AR-REPRNB             (P11)
1 #AR-SOURCE-SENDER-TIME-INV(A40)
1 REDEFINE #AR-SOURCE-SENDER-TIME-INV
  2 #SOURCE                (A16)
  2 #SENDER                (A16)
  2 #TIME-INV              (P13)
  2 #AR-ACTIVE             (A1)
1 #AR-SPOOL-ATTR-EXTENDED  (A30000)
1 #USER                    (A8)
1 #SENDER-LOW              (A8)
1 #NATPARMS                (A) DYNAMIC
1 #NATPARMS-OK             (L)
1 #BLANKS                  (A4) CONST <'&&&&'>
1 #REPNAMES                (A25/100)
1 #REPRNBS                 (P11/100)
1 #FF                      (A1) CONST <H'0C'>
1 #DELIM                   (A2)
1 #DELIM-A                 (A4)
1 #NODELIM                 (L)
1 #FORMFEED                (L)
1 #FORMFEED-OLD            (L)
1 #FORMFEED-FLAG           (L)
1 #RECORD-D                (A) DYNAMIC
1 #RECORD-E                (A) DYNAMIC
1 #LINEFEEDS               (A2)
1 #BEGIN                   (A30)
1 #INPUT-DATA              (A75)
1 #HEXHIGH                 (A75)
1 #HEXLOW                  (A75)
1 #RULER                   (A75)
1 #RULER-OFFSET            (I4)
1 #ERC                     (N4)
1 #ERT                     (A250)
1 #LINE-TOTAL              (I4)
1 #LASTSTEP                (I4)
1 #CATDATE                 (A19)
1 #FILEID                  (A250)
1 #LASTMSG                 (L)
1 #TAG-TAB       /*tags to be ignored for metadata
  2 ##RPC_USER             (A10) CONST <'rpc_user' >
  2 ##RPC_SERVER           (A10) CONST <'rpc_server'>
  2 ##EXX_SERVER           (A10) CONST <'exx_server'>
  2 ##EXX_USER             (A10) CONST <'exx_user' >
  2 ##NAT_LIB              (A10) CONST <'nat_lib'  >
1 REDEFINE #TAG-TAB
  2 ##TAGS                 (A10/1:5)
1 #DELI                    (A1)
1 #I1                      (I2)
1 #A20                     (A20)
1 #A250                    (A250)
*
1 XXCHCKCP-PARMS
  2 CP-FUNCTION                      (A1)
*   '#' Get number from name
*   'N' Get name from number
  2 CP-NUMBER                        (A5)
  2 CP-NAME                          (A30)
  2 CP-DESCRIPTION                   (A1)
  2 CP-ERC                           (N4)
1 ##SPOOL-DI-PATH                    (A70)
1 ##SPOOL-DI-FILENAME                (A50)
1 ##SPOOL-DI-FILETYPE                (A50)
1 #LINE                              (I2)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
OPTIONS TQMARK=OFF
COMPRESS '<?xml version="1.0" encoding="' *CODEPAGE '"?>'
  TO #XML-PREFIX LEAVING NO
CALLNAT 'NOMGSTEP' #NOMGSTEP-FUNCT #NOMGSTEP-RC
RESET NOMRPC-RC NOMRPC-ERROR-TEXT #XX-GMSG-PARMS #FILTER-TABLE (*)
FORMAT LS=133
#USER  := *USER
EXAMINE #USER AND TRANSLATE INTO LOWER
IF *MACHINE-CLASS = 'MAINFRAME' AND NOMRPC-INPUT-FORMAT = 'T'
  COMPRESS H'0A' H'25' TO #LINEFEEDS LEAVING NO
ELSE
  #LINEFEEDS := H'0A'
END-IF
EXPAND ARRAY B64-TEXT-ARRAY TO (1:1)
CALLNAT 'RGETLIB' #XX-ERROR-APPL /*
IF NOMRPC-TRACE-LEVEL > '3'
  #TRACING := TRUE
END-IF
IF NOMRPC-TRACE-LEVEL > '0'
  PERFORM XXCATAL-GET-CATDATE #CATDATE
  COMPRESS *PROGRAM 'cataloged at' #CATDATE TO #TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
  END TRANSACTION
END-IF
*
RESET CONTAINER
CONTAINER.ST-LINE-START := 1
CONTAINER.ST-TEXT (1)   := H'000000'
#NSMCOMP-BUFFER-LENGTH  := 16381 - 7
#NSMCOMP-CODE           := 'N'  /* 'N' - NEW PARM LIST
#NSMCOMP-COMMAND        := 'C'
*
COMPRESS 'Start of function' NOMRPC-FUNCTION TO #MSG
PERFORM WRITE-TRACE
DECIDE ON EVERY VALUE OF NOMRPC-FUNCTION
  VALUE 'OPEN'
    IF  #FUNCTION-OLD NE ' '
      NOMRPC-RC := 9163
      NOMRPC-ERROR-TEXT := NOMRPC-FUNCTION
      #LINE             := *LINE
      PERFORM EXIT
    END-IF
    RESET #RECORD-NUMBER #SOURCE-TEXT-ID
    RESET #NATPARMS-OK #NATPARMS
    RESET +MAXLEN
    REDUCE DYNAMIC +VALUE-OLD           TO 0
    REDUCE DYNAMIC #NATPARMS            TO 0
    REDUCE DYNAMIC #SPOOL-ATTR-EXTENDED TO 0
    IF NOMRPC-TRACE-LEVEL > '0'
      #TRACE-MSG := 'Got container DB/FNR at OPEN:'
      PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
      COMPRESS 'Container-DB:' NOMRPC-CONTAINER-DB '- FNR:'
        NOMRPC-CONTAINER-FNR 'line:' *LINE TO #TRACE-MSG
      PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
      END TRANSACTION
    END-IF
    IF NOMRPC-CONTAINER-DB IS (N5)
      #CONTAINER-DB := VAL(NOMRPC-CONTAINER-DB)
    END-IF
    IF NOMRPC-CONTAINER-FNR IS (N5)
      #CONTAINER-FNR := VAL(NOMRPC-CONTAINER-FNR)
    END-IF
* *****
  VALUES 'PUT','CLOSE'
    IF NOT (#FUNCTION-OLD ='OPEN' OR= 'PUT')
      NOMRPC-RC := 9163
      NOMRPC-ERROR-TEXT := NOMRPC-FUNCTION
      #LINE             := *LINE
      PERFORM EXIT
    END-IF
    REDUCE DYNAMIC #RECORD-E TO 0
    REDUCE DYNAMIC #RECORD-D TO 0
    IF #CONTAINER-DB = 0
        AND NOMRPC-CONTAINER-DB IS (N5)
      #CONTAINER-DB := VAL(NOMRPC-CONTAINER-DB)
    END-IF
    IF #CONTAINER-FNR = 0 AND NOMRPC-CONTAINER-FNR IS (N5)
      #CONTAINER-FNR := VAL(NOMRPC-CONTAINER-FNR)
    END-IF
    IF NOMRPC-TRACE-LEVEL > '0'
      #TRACE-MSG := 'Got container DB/FNR at PUT:'
      PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
      COMPRESS 'Container-DB:' NOMRPC-CONTAINER-DB '- FNR:'
        NOMRPC-CONTAINER-FNR 'line:' *LINE TO #TRACE-MSG
      PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
      END TRANSACTION
    END-IF
  VALUE 'CLOSE'
    IF +VALUE-OLD NE ' '
      #RECORD-E := +VALUE-OLD
      IF NOMRPC-TRACE-LEVEL > '3'
        #TRACE-MSG :=  'Text record at close created:'
        PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
        #TRACE-MSG := #RECORD-E
        PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
        END TRANSACTION
      END-IF
      PERFORM COMPRESS-INTO-BUFFER
      IF NOMRPC-RC NE 0
        ESCAPE ROUTINE
      END-IF
      PERFORM STORE-RECORD
    END-IF
    REDUCE DYNAMIC +VALUE-OLD TO 0
    PERFORM WRITE-TRIGGER
    RESET #FUNCTION-OLD #RECORD-NUMBER
    REDUCE DYNAMIC #RECORD-E TO 0
    REDUCE DYNAMIC #RECORD-D TO 0
    COMPRESS 'Function' NOMRPC-FUNCTION 'finished.' TO #MSG
    PERFORM WRITE-TRACE
    PERFORM BLANK-WORK
    ESCAPE ROUTINE /* don't parse anything.
* *****
  VALUES 'CANCEL','LIST','METADATA'
    IGNORE /* for later processing
* *****
  NONE
    NOMRPC-RC := 9164
    NOMRPC-ERROR-TEXT := NOMRPC-FUNCTION
    #LINE             := *LINE
    PERFORM EXIT
END-DECIDE
IF NOMRPC-DATA = ' '
  NOMRPC-RC := 9165
  #LINE := *LINE
  PERFORM EXIT
END-IF
RESIZE DYNAMIC VARIABLE #XML TO 0
/* The folowing EXAMINEs delete the BOM of a file
/* See: https://de.wikipedia.org/wiki/Byte_Order_Mark
EXAMINE NOMRPC-DATA FOR H'0000FEFF' AND DELETE FIRST
EXAMINE NOMRPC-DATA FOR H'FFFE0000' AND DELETE FIRST
EXAMINE NOMRPC-DATA FOR H'EFBBBF'   AND DELETE FIRST
EXAMINE NOMRPC-DATA FOR H'FEFF'     AND DELETE FIRST
EXAMINE NOMRPC-DATA FOR H'FFFE'     AND DELETE FIRST
IF NOMRPC-DATA = SCAN('<?xml') OR = SCAN('<? xml')
  #XML := NOMRPC-DATA
ELSE
  COMPRESS #XML-PREFIX NOMRPC-DATA TO #XML LEAVING NO
END-IF
*
* Cleanup the data if client passes garbage
* -----------------------------------------
*
* Only text:
*
IF NOMRPC-INPUT-FORMAT = 'T' OR = 'X' /*Handle portions of buffers
  PORTION. FOR #POS-ABS = 1 TO *LENGTH (#XML)
    EXAMINE SUBSTR(#XML,#POS-ABS) FOR '</data>' GIVING POSITION #POS-END
    IF #POS-END = 0
      ESCAPE BOTTOM (PORTION.)
    END-IF
    #POS-END := #POS-END + #POS-ABS
    EXAMINE SUBSTR(#XML,#POS-END) FOR '<data>' GIVING POSITION #POS-LEN
    IF #POS-LEN = 0
      ESCAPE BOTTOM (PORTION.)
    END-IF
    #POS     := #POS-END - 2
    #POS-ABS := #POS-END + #POS-LEN + 5
    IF NOMRPC-TRACE-LEVEL > '3'
      COMPRESS 'Skipping </data><data> at' #POS-ABS ':' #POS
        TO #TRACE-MSG
      PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
      END TRANSACTION
    END-IF
    DECIDE FOR FIRST CONDITION
      WHEN #POS < 1 AND #POS-ABS LE *LENGTH(#XML)
        #XML := SUBSTR(#XML,#POS-ABS)         /* skip "</data><data>"
      WHEN #POS LE *LENGTH(#XML) AND #POS-ABS > *LENGTH(#XML)
        #XML := SUBSTR(#XML,1,#POS)           /* skip "</data><data>"
      WHEN NONE                               /* skip "</data><data>"
        COMPRESS SUBSTR(#XML,1,#POS) SUBSTR(#XML,#POS-ABS)
          TO #XML LEAVING NO
    END-DECIDE
  END-FOR
END-IF
IF NOMRPC-TRACE-LEVEL > '2'
  COMPRESS 'Got input format' NOMRPC-INPUT-FORMAT 'at' *LINE
    TO #TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
  END TRANSACTION
END-IF
IF NOMRPC-INPUT-FORMAT = 'T'
  ENCODE. /* Normalize data tags before parsing
  FOR #POS-ABS = 1 TO *LENGTH(#XML)
    EXAMINE SUBSTR(#XML,#POS-ABS) FOR '</' GIVING POSITION #LEN
    IF #LEN = 0
      ESCAPE BOTTOM (ENCODE.)
    END-IF
    #LEN        := #LEN - 1
    EXAMINE DIRECTION BACKWARD SUBSTR(#XML,#POS-ABS,#LEN) FOR '>'
      GIVING POSITION #POS
    IF #POS = 0
      #POS-ABS := #POS-ABS + #LEN
      ESCAPE TOP
    END-IF
    #POS-END   := #POS-ABS + #POS - 6
    IF #POS-END < 1
        OR SUBSTR (#XML,#POS-END,6) NE '<data>' /* filter data tags
      #POS-ABS := #POS-ABS + #LEN
      ESCAPE TOP
    END-IF
    #POS-ABS   := #POS-ABS + #POS
    #LEN       := #LEN     - #POS
    IF #LEN < 1
      IF NOMRPC-TRACE-LEVEL > '3'
        COMPRESS 'Escaping at line' *LINE TO #TRACE-MSG
        PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
        END TRANSACTION
      END-IF
      ESCAPE TOP
    END-IF
    REDUCE DYNAMIC #VALUE TO 0
    IF NOMRPC-TRACE-LEVEL > '3'
      COMPRESS 'Normalizing tag' SUBSTR(#XML,#POS-ABS,#LEN)
        TO #TRACE-MSG
      PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
      END TRANSACTION
    END-IF
    EXAMINE FULL SUBSTR(#XML,#POS-ABS,#LEN)
      FOR FULL ' ' REPLACE WITH '_'
    #VALUE     := SUBSTR(#XML,#POS-ABS,#LEN)
    CALLNAT 'XXCPAGE' 'E' #VALUE #ERC #ERT 2X #TRACING
    IF #ERC NE 0
      NOMRPC-RC := #ERC
      #LINE     := *LINE
      PERFORM EXIT
    END-IF
    IF #TRACING
      END TRANSACTION
    END-IF
    RESET #ERC #ERT
    #POS       := #POS-ABS - 1
    ADD #LEN TO #POS-ABS
    COMPRESS SUBSTR(#XML,1,#POS) #VALUE
      SUBSTR(#XML,#POS-ABS) TO #XML LEAVING NO
    #POS-ABS   := #POS + *LENGTH(#VALUE) + 1
  END-FOR
  IF NOMRPC-TRACE-LEVEL > '3'
    COMPRESS 'Normalized string:' TO #TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    REP. REPEAT
      PERFORM XXHEXPRT #INPUT-DATA #HEXHIGH #HEXLOW #RULER
        #RULER-OFFSET TRUE #XML 75
      IF #RULER-OFFSET = -1
        ESCAPE BOTTOM (REP.)
      END-IF
      PERFORM XXRLOG-WRITE-LOG 'T' #INPUT-DATA
      PERFORM XXRLOG-WRITE-LOG 'T' #HEXHIGH
      PERFORM XXRLOG-WRITE-LOG 'T' #HEXLOW
      PERFORM XXRLOG-WRITE-LOG 'T' #RULER
      END TRANSACTION
    END-REPEAT
  END-IF
END-IF
IF NOMRPC-TRACE-LEVEL > '0'
  #BEGIN := NOMRPC-DATA
  COMPRESS 'Got codepage:' NOMRPC-CODEPAGE '- to codepage:' *CODEPAGE
    '- with data:' #BEGIN TO #TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
  END TRANSACTION
END-IF
*
* Now parse the data
* ------------------
PARSE XML #XML INTO NAME #TAG VALUE #VALUE
  DECIDE ON FIRST VALUE OF *PARSE-TYPE
    VALUE 'T'
      EXAMINE #TAG TRANSLATE INTO LOWER
      #TAG-CURRENT := #TAG
      ESCAPE TOP
    VALUE '$'
      IGNORE
    VALUE '§'
      DECIDE ON FIRST VALUE OF #TAG
        VALUE 'repname'  NOMRPC-REPNAME := #VALUE
        VALUE 'reprnb'   NOMRPC-RNB     := #VALUE
        VALUE 'source'   NOMRPC-SOURCE  := #VALUE
        VALUE 'poid'     NOMRPC-PO-ID   := #VALUE
        VALUE 'rpc_user' NOMRPC-USER    := #VALUE
        VALUE 'sender'
          #SENDER-LOW := NOMRPC-SENDER  := #VALUE
          EXAMINE #SENDER-LOW AND TRANSLATE INTO LOWER
        ANY /*trace
          IF NOMRPC-TRACE-LEVEL > '3'
            COMPRESS 'Filled' #TAG 'with value:'
              #VALUE TO #TRACE-MSG LEAVING NO
            PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
            END TRANSACTION
          END-IF
        NONE IGNORE
      END-DECIDE
    NONE
      ESCAPE TOP
  END-DECIDE
  IF NOMRPC-TRACE-LEVEL > '2'
    COMPRESS 'Got tag:' #TAG-CURRENT 'with value:'
      #VALUE TO #TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    END TRANSACTION
  END-IF
  DECIDE ON EVERY VALUE OF NOMRPC-FUNCTION
    VALUE 'OPEN'
      DECIDE ON FIRST VALUE OF #TAG-CURRENT
        VALUE 'db'
          IF #VALUE IS (N5)
            #CONTAINER-DB := VAL(#VALUE)
          END-IF
        VALUE 'fnr'
          IF #VALUE IS (N5)
            #CONTAINER-FNR := VAL(#VALUE)
          END-IF
        VALUE 'encoding'
          NOMRPC-CODEPAGE := #VALUE
          #LINE           := *LINE
          PERFORM CHECK-CODEPAGE
        NONE IGNORE
      END-DECIDE
    VALUES 'OPEN','PUT'
      DECIDE ON FIRST VALUE OF #TAG-CURRENT
        VALUE 'data'
          DECIDE ON FIRST VALUE OF NOMRPC-INPUT-FORMAT
            VALUE 'X' PERFORM HANDLE-DATA-FORMAT-X
            VALUE 'T' PERFORM HANDLE-DATA-FORMAT-T
            ANY
              PERFORM HANDLE-DATA-FORMAT-XT_2
              IF NOMRPC-RC NE 0
                ESCAPE ROUTINE
              END-IF
            NONE      PERFORM HANDLE-DATA-FORMAT-NOT-TX
          END-DECIDE
        VALUE 'multi_data' /*do not ADD-TO-META
          IGNORE
        VALUE 'db' /*do not ADD-TO-META
          IF #VALUE IS (N5) AND NOT #LFILE-USED
            #CONTAINER-DB := VAL(#VALUE)
          END-IF
        VALUE 'fnr' /*do not ADD-TO-META
          IF #VALUE IS (N5) AND NOT #LFILE-USED
            #CONTAINER-FNR := VAL(#VALUE)
          END-IF
        VALUE 'codepage'
          NOMRPC-CODEPAGE := #VALUE
          #LINE           := *LINE
          PERFORM CHECK-CODEPAGE
          PERFORM ADD-TO-META
        NONE
          PERFORM ADD-TO-META
      END-DECIDE
      IF #NATPARMS NE ' '
        IF NOMRPC-TRACE-LEVEL > '2'
          COMPRESS '#NATPARMS:' #NATPARMS TO #TRACE-MSG LEAVING NO
          PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
          END TRANSACTION
        END-IF
        IF #SPOOL-ATTR-EXTENDED NE ' '
          COMPRESS #SPOOL-ATTR-EXTENDED ';' #NATPARMS
            TO #SPOOL-ATTR-EXTENDED LEAVING NO
        ELSE
          #SPOOL-ATTR-EXTENDED := #NATPARMS
        END-IF
        REDUCE DYNAMIC #NATPARMS TO 0
      END-IF
************************************************************************
*   VALUE 'CLOSE' already done above...
    VALUE 'LIST'
      DECIDE ON FIRST VALUE OF #TAG-CURRENT
        VALUE 'source'
          NOMRPC-SOURCE := #VALUE
        VALUE 'sender'
          NOMRPC-SENDER := #VALUE
          #SENDER-LOW := NOMRPC-SENDER
          EXAMINE #SENDER-LOW AND TRANSLATE INTO LOWER
        NONE IGNORE
      END-DECIDE
      IF NOMRPC-SENDER NE ' ' AND NOMRPC-SOURCE NE ' '
        CALLNAT 'OOPOFF-N' NOMRPC-PARMS NOMRPC-INPUT-PARMS
        PERFORM LIST-TO-XML
        COMPRESS 'Function' NOMRPC-FUNCTION 'finished.' TO #MSG
        PERFORM WRITE-TRACE
        #LINE := *LINE
        PERFORM EXIT
      END-IF
************************************************************************
    VALUES 'CANCEL','METADATA'
      DECIDE ON FIRST VALUE OF #TAG-CURRENT
        VALUE 'repname'  NOMRPC-REPNAME := #VALUE
        VALUE 'reprnb'   NOMRPC-RNB     := #VALUE
        VALUE 'source'   NOMRPC-SOURCE  := #VALUE
        VALUE 'poid'     NOMRPC-PO-ID   := #VALUE
        VALUE 'sender'
          #SENDER-LOW := NOMRPC-SENDER := #VALUE
          EXAMINE #SENDER-LOW AND TRANSLATE INTO LOWER
        NONE IGNORE
      END-DECIDE
************************************************************************
    VALUE 'CANCEL'
      IF #TAG-CURRENT = 'rpc_user'
        NOMRPC-USER := #VALUE
      END-IF
      IF NOT(NOMRPC-REPNAME = ' ' OR NOMRPC-RNB = ' '
      OR NOMRPC-SOURCE = ' ' OR NOMRPC-SENDER = ' ')                  /*
        PERFORM HANDLE-CANCEL
      END-IF
************************************************************************
    VALUE 'METADATA'
      IF NOT (NOMRPC-REPNAME=' ' OR NOMRPC-RNB=' ' OR NOMRPC-PO-ID=' ')
        CALLNAT 'OOPOFF-N' NOMRPC-PARMS NOMRPC-INPUT-PARMS
        PERFORM METADATA-TO-XML
        COMPRESS 'Function' NOMRPC-FUNCTION 'finished.' TO #MSG
        PERFORM WRITE-TRACE
        #LINE := *LINE
        PERFORM EXIT
      END-IF
************************************************************************
    NONE
      NOMRPC-RC := 9164
      NOMRPC-ERROR-TEXT := NOMRPC-FUNCTION
      #LINE             := *LINE
      PERFORM EXIT
  END-DECIDE
END-PARSE
IF #RECORD-D NE ' '
  PERFORM COMPRESS-INTO-BUFFER
  IF NOMRPC-RC NE 0
    ESCAPE ROUTINE
  END-IF
END-IF
IF #IN-BUFFER
  PERFORM STORE-RECORD
END-IF
RESET NOMRPC-RC NOMRPC-ERROR-TEXT
#FUNCTION-OLD := NOMRPC-FUNCTION
COMPRESS 'Function' NOMRPC-FUNCTION 'finished.' TO #MSG
PERFORM WRITE-TRACE
PERFORM BLANK-WORK
END TRANSACTION
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE SET-LFILE
************************************************************************
REPEAT
  BACKOUT TRANSACTION
  RESET #LFILE-RC NOMRPC-RC NOMRPC-ERROR-TEXT
  CALLNAT 'SETNRMLN' #CONTAINER-DB #CONTAINER-FNR #LFILE-158
    #LFILE-PASSWD #LFILE-CIPHER #LFILE-RC
  DECIDE ON EVERY VALUE OF #LFILE-RC
    VALUE 0
      IF NOMRPC-TRACE-LEVEL > '0' AND NOT #LFILE-USED
        COMPRESS 'Using DB' #CONTAINER-DB 'FNR' #CONTAINER-FNR
          'as container file.' TO #TRACE-MSG
        PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
        END TRANSACTION
      END-IF
      #LFILE-USED := TRUE
    VALUE 3009
      BACKOUT TRANSACTION
      CALLNAT 'NAT00031' #WAITTIME
      ADD 1 TO #WAITTIME
      NOMRPC-RC := 1536 /* Error :1: setting Lfile :2:
      COMPRESS #LFILE-RC #LFILE-158 TO NOMRPC-ERROR-TEXT LEAVING NO
    NONE
      NOMRPC-RC := 1536 /* Error :1: setting Lfile :2:
      COMPRESS #LFILE-RC #LFILE-158 TO NOMRPC-ERROR-TEXT LEAVING NO
  END-DECIDE
  UNTIL #LFILE-RC NE 3009 OR #WAITTIME > 10
END-REPEAT
IF NOMRPC-RC NE 0
  PERFORM WRITE-TRACE
  #LINE := *LINE
  PERFORM WRITE-LOG
  ESCAPE ROUTINE
END-IF
*
END-SUBROUTINE /* SET-LFILE
*
************************************************************************
DEFINE SUBROUTINE CHECK-CODEPAGE
************************************************************************
IF NOMRPC-CODEPAGE NE ' '
  SEPARATE NOMRPC-CODEPAGE INTO NOMRPC-CODEPAGE
    WITH DELIMITER ';' IGNORE /* Got a codepage from NOP
  IF NOMRPC-CODEPAGE = MASK ('NNNNN')
    CP-FUNCTION := 'N'
    CP-NUMBER   := NOMRPC-CODEPAGE
    CALLNAT 'XXCHCKCP' XXCHCKCP-PARMS
    IF CP-ERC = 0 OR = 4
      NOMRPC-CODEPAGE := CP-NAME
      IF NOMRPC-TRACE-LEVEL > '2'
        IF NOMRPC-CODEPAGE NE CP-NAME
          COMPRESS 'Codepage changed to:' NOMRPC-CODEPAGE TO #TRACE-MSG
          PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
        ELSE
          COMPRESS 'Valid codepage found:' NOMRPC-CODEPAGE TO #TRACE-MSG
          PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
        END-IF
      END-IF
    ELSE
      IF NOMRPC-TRACE-LEVEL > '0'
        COMPRESS 'Codepage number' CP-NUMBER 'not found' TO #TRACE-MSG
        PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
      END-IF
      NOMRPC-RC := 9170
      COMPRESS CP-NUMBER #LINE TO NOMRPC-ERROR-TEXT
      PERFORM EXIT
    END-IF
  ELSE
    CP-FUNCTION := '#'
    CP-NAME     := NOMRPC-CODEPAGE
    CALLNAT 'XXCHCKCP' XXCHCKCP-PARMS
    IF CP-ERC = 0 OR = 4
      NOMRPC-CODEPAGE := CP-NAME
      IF NOMRPC-TRACE-LEVEL > '2'
        IF NOMRPC-CODEPAGE NE CP-NAME
          COMPRESS 'Codepage changed to:' NOMRPC-CODEPAGE TO #TRACE-MSG
          PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
        ELSE
          COMPRESS 'Valid codepage found:' NOMRPC-CODEPAGE TO #TRACE-MSG
          PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
        END-IF
      END-IF
    ELSE
      IF NOMRPC-TRACE-LEVEL > '0'
        COMPRESS 'Codepage' CP-NAME 'not found.' TO #TRACE-MSG
        PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
      END-IF
      NOMRPC-RC := 9170
      COMPRESS CP-NAME #LINE TO NOMRPC-ERROR-TEXT
      PERFORM EXIT
    END-IF
  END-IF
ELSE
  IF NOMRPC-TRACE-LEVEL > '0'
    #TRACE-MSG := 'Codepage is empty'
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
  END-IF
END-IF
IF NOMRPC-TRACE-LEVEL > '0'
  END TRANSACTION
END-IF
*
END-SUBROUTINE /* CHECK-CODEPAGE
*
************************************************************************
DEFINE SUBROUTINE COMPRESS-INTO-BUFFER
************************************************************************
PERFORM SET-LFILE
IF NOMRPC-RC NE 0
  ESCAPE ROUTINE
END-IF
*
ADD 1 TO #RECORD-NUMBER
IF #SOURCE-TEXT-ID < 1
  PERFORM GET-SOURCE-TEXT-ID
END-IF
CONTAINER.ST-TYPE := DIRECT-INPUT
CONTAINER.ST-ID   := #SOURCE-TEXT-ID
DECIDE ON EVERY VALUE OF NOMRPC-INPUT-FORMAT
  VALUE 'T'
    EXAMINE #RECORD-E FOR '_' REPLACE WITH FULL ' '
    EXAMINE #RECORD-E FOR '&nbsp;' REPLACE WITH '_'
  VALUES 'T','X'
    IF #FORMFEED
      COMPRESS '1' #RECORD-E TO #NSMCOMP-LINE LEAVING NO
    ELSE
      COMPRESS FULL ' ' #RECORD-E TO #NSMCOMP-LINE LEAVING NO
    END-IF
  NONE
    #NSMCOMP-LINE := #RECORD-E
END-DECIDE
EXAMINE #NSMCOMP-LINE FOR ' ' GIVING LENGTH #LEN
#NSMCOMP-INLENGTH := #LEN
#NSMCOMP-INLENGTH-OLD := #LEN    /* for compat
*
REPEAT
  INCLUDE C-NSMCMP '#ST-TEXT-BUFFER-LOB'
  IF NOMRPC-TRACE-LEVEL > '3'
    ADD 1 TO #LINE-TOTAL
    COMPRESS 'Compressed into buffer line:' #LINE-TOTAL TO #TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    #TRACE-MSG := #NSMCOMP-LINE
    PERFORM XXHEXPRT #TRACE-MSG #HEXHIGH #HEXLOW #RULER 1X TRUE
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' #HEXHIGH
    PERFORM XXRLOG-WRITE-LOG 'T' #HEXLOW
    PERFORM XXRLOG-WRITE-LOG 'T' #RULER
    END TRANSACTION
  END-IF
  DECIDE ON FIRST #NSMCOMP-RC
    VALUE 0
      IF NOT #IN-BUFFER
        CONTAINER.ST-LINE-START := #RECORD-NUMBER
      END-IF
      CONTAINER.ST-LINE-END     := #RECORD-NUMBER
      #IN-BUFFER := TRUE
      ESCAPE BOTTOM
    VALUE 4
      PERFORM STORE-RECORD
      RESET CONTAINER.ST-LINE-END CONTAINER.ST-TEXT (*)
      CONTAINER.ST-TEXT (1) := H'000000'
      RESET #IN-BUFFER
    NONE
      NOMRPC-RC := 0005
      COMPRESS 'Compress-error' #NSMCOMP-RC 'occured'
        TO NOMRPC-ERROR-TEXT
      ESCAPE BOTTOM
  END-DECIDE
END-REPEAT
IF NOMRPC-TRACE-LEVEL > '3' AND #RECORD-E NE ' '
  #TRACE-MSG :=  'Record created:'
  PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
  #TRACE-MSG :=  #RECORD-E
  PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
  END TRANSACTION
END-IF
*
END-SUBROUTINE /* COMPRESS-INTO-BUFFER
*
************************************************************************
DEFINE SUBROUTINE WRITE-TRIGGER
************************************************************************
IF #RECORD-NUMBER = 0 /* nothing happened or everything in error.
  ESCAPE ROUTINE
END-IF
PERFORM SET-LFILE
IF NOMRPC-RC NE 0
  ESCAPE ROUTINE
END-IF
*
PERFORM SET-ATTRIBUTES
*
#NP-STATUS  := 2  /* 'closed'
#NP-TYPE    := DIRECT-INPUT
#NP-IDENT   := #SOURCE-ATTRIBUTES
*
FNDQ. FIND QUEUE-ENTRY WITH NP-QUEUE = #NP-QUEUE
  IF NO RECORDS FOUND
    ENTER
  END-NOREC
  QUEUE-ENTRY.NP-STATUS           := #NP-STATUS
  QUEUE-ENTRY.NP-TYPE             := DIRECT-INPUT
  QUEUE-ENTRY.NP-ATTRIBUTES-IDENT := #SOURCE-ATTRIBUTES
  QUEUE-ENTRY.NP-SPOOL-ATTRIBUTES := #SPOOL-ATTRIBUTES
  QUEUE-ENTRY.NP-CC-TYPE          := #DI-CC-TYPE
  QUEUE-ENTRY.NP-RECORD-LENGTH    := 248
  IF +MAXLEN > 250
    COMPRESS '7205 >' ##SPOOL-DI-FILENAME TO #TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'W' #TRACE-MSG
    #TRACE-MSG := '7233'
    PERFORM XXRLOG-WRITE-LOG 'W' #TRACE-MSG
    END TRANSACTION /* Only warning. Proceed with everything.
  END-IF
  IF +MAXLEN > 0 AND +MAXLEN <= 250
    QUEUE-ENTRY.NP-RECORD-LENGTH  := +MAXLEN
  END-IF
  QUEUE-ENTRY.NP-NUMBER-OF-LINES  := #RECORD-NUMBER
*
  PERFORM REMOVE-TAGS
  #LEN := *LENGTH(#SPOOL-ATTR-EXTENDED)
  FOR #I = 1 TO 120
    #POS-ABS := (#I - 1) * 250 + 1       /* absolute position of chunk
    IF #POS-ABS > #LEN
      ESCAPE BOTTOM                      /* That's it
    END-IF
    #POS-END := (#I - 1) * 250 + 250    /* absolute end position of chunk
    IF #POS-END > #LEN
      #POS-LEN := #LEN - #POS-ABS + 1    /* correct length of substring
    ELSE
      #POS-LEN := 250                    /* take the full chunk
    END-IF
    MOVE SUBSTR(#SPOOL-ATTR-EXTENDED,#POS-ABS,#POS-LEN)
      TO QUEUE-ENTRY.NP-SPOOL-ATTRIBUTES-EXTENDED (#I)
  END-FOR
*
  IF *NUMBER (FNDQ.) = 0
    STORE QUEUE-ENTRY
  ELSE
    UPDATE
  END-IF
  END TRANSACTION
END-FIND
NOMWK-TASK-TYPE := EQU-CP-SRCE-BEGIN
CALLNAT 'NOMWK01N' NOMWK-NOMVERS NOMWK-PARMS (*)
*
END-SUBROUTINE /* WRITE-TRIGGER
*
************************************************************************
DEFINE SUBROUTINE SET-ATTRIBUTES
************************************************************************
RESET #SPOOL-ATTRIBUTES #SOURCE-ATTRIBUTES #SPOOL-DI-ST-ID
*
#SPOOL-TYPE              := DIRECT-INPUT
#SPOOL-DI-CONTAINER-DBID := #CONTAINER-DB
#SPOOL-DI-CONTAINER-FNR  := #CONTAINER-FNR
#SPOOL-DI-ST-ID          := #SOURCE-TEXT-ID
*
EXAMINE #SPOOL-ATTR-EXTENDED FOR 'rpc_user=' GIVING POSITION #POS-ABS
IF #POS-ABS NE 0
  SEPARATE SUBSTR(#SPOOL-ATTR-EXTENDED,#POS-ABS) INTO #STRING
    IGNORE WITH DELIMITER ';'
  SEPARATE #STRING INTO #STRING2 #STRING2
  IGNORE WITH DELIMITER '='
  #SPOOL-DI-USERID := #STRING2
  #DI-RPC-USER := #SPOOL-DI-USERID
  EXAMINE #SPOOL-DI-USERID TRANSLATE INTO UPPER
END-IF
*
EXAMINE #SPOOL-ATTR-EXTENDED FOR 'rpc_server=' GIVING POSITION #POS-ABS
IF #POS-ABS NE 0
  SEPARATE SUBSTR(#SPOOL-ATTR-EXTENDED,#POS-ABS) INTO #STRING
    IGNORE WITH DELIMITER ';'
  SEPARATE #STRING INTO #STRING2 #STRING2
  IGNORE WITH DELIMITER '='
  #SPOOL-DI-RPC-SERVER := #STRING2
END-IF
*
EXAMINE #SPOOL-ATTR-EXTENDED FOR 'filename=' GIVING POSITION #POS-ABS
IF #POS-ABS NE 0
  SEPARATE SUBSTR(#SPOOL-ATTR-EXTENDED,#POS-ABS) INTO #STRING
    IGNORE WITH DELIMITER ';'
  SEPARATE #STRING INTO #STRING2 #STRING2 IGNORE WITH DELIMITER '='
  RESET XXHASH-PARMS
  XXHASH-PARMS.P-FUNCTION  := 'S' /*long -> short/store
  XXHASH-PARMS.P-LONG-NAME := #STRING2
  XXHASH-PARMS.P-NAME-MAX  := 26 /*26 because #DI-FILENAME(A26)
  PERFORM XXHASH XXHASH-PARMS
  END TRANSACTION
  IF XXHASH-PARMS.P-RC = 0 /*what happens in else case ??
    #STRING2 := XXHASH-PARMS.P-SHORT-NAME
  END-IF
  #DI-FILENAME := #SPOOL-DI-FILENAME := #STRING2 /*(A26)=(A50)=(A50)
END-IF
*
EXAMINE #SPOOL-ATTR-EXTENDED FOR 'filetype=' GIVING POSITION #POS-ABS
IF #POS-ABS NE 0
  SEPARATE SUBSTR(#SPOOL-ATTR-EXTENDED,#POS-ABS) INTO #STRING
    IGNORE WITH DELIMITER ';'
* SEPARATE #STRING INTO #DI-FILETYPE #DI-FILETYPE
  SEPARATE #STRING INTO #STRING2 #STRING2
  IGNORE WITH DELIMITER '='
  #DI-FILETYPE := #STRING2
  #SPOOL-DI-FILETYPE := #DI-FILETYPE
END-IF
IF #SPOOL-DI-FILENAME = ' '
  COMPRESS 'printout-' #SPOOL-DI-USERID TO #DI-FILENAME LEAVING NO
  #SPOOL-DI-FILENAME := #DI-FILENAME /* for real printer
END-IF
IF #SPOOL-DI-FILETYPE = ' '
  #DI-FILETYPE := #SPOOL-DI-FILETYPE:='prn' /*Can be printed to real prt
END-IF
*
EXAMINE #SPOOL-ATTR-EXTENDED FOR 'path=' GIVING POSITION #POS-ABS
IF #POS-ABS NE 0
  SEPARATE SUBSTR(#SPOOL-ATTR-EXTENDED,#POS-ABS) INTO #STRING
    IGNORE WITH DELIMITER ';'
  SEPARATE #STRING INTO #STRING2 #STRING2 IGNORE WITH DELIMITER '='
  EXAMINE #STRING2 FOR ' ' GIVING LENGTH #I
  IF #I > 70 /*#SPOOL-DI-PATH
    RESET XXHASH-PARMS
    XXHASH-PARMS.P-FUNCTION  := 'S' /*long -> short/store
    XXHASH-PARMS.P-LONG-NAME := #STRING2
    PERFORM XXHASH XXHASH-PARMS
    END TRANSACTION
    IF XXHASH-PARMS.P-RC = 0 /*what happens in else case ??
      #STRING2 := XXHASH-PARMS.P-SHORT-NAME
    END-IF
  END-IF
  #SPOOL-DI-PATH := #STRING2
END-IF
RESET #FILEID #RC
* Just warning, do not override file name:
##SPOOL-DI-PATH     := #SPOOL-DI-PATH
##SPOOL-DI-FILENAME := #SPOOL-DI-FILENAME
##SPOOL-DI-FILETYPE := #SPOOL-DI-FILETYPE
PERFORM XXCHKFN-CHECK-FILENAME #FILEID #RC
  ##SPOOL-DI-PATH ##SPOOL-DI-FILENAME ##SPOOL-DI-FILETYPE
IF #RC > 1
  COMPRESS 'File-ID invalid: ' #FILEID TO #TRACE-MSG LEAVING NO
  PERFORM XXRLOG-WRITE-LOG 'W' #TRACE-MSG
  END TRANSACTION /* Only warning. Proceed with everything.
END-IF
COMPRESS *DATI '-' *TIME TO #DI-TIMESTMP LEAVING NO
IF NOMRPC-INPUT-FORMAT = 'T' OR = 'X'
  #DI-CC-TYPE := ASA-CODE
ELSE
  #DI-CC-TYPE := BINARY
END-IF
*
IF NOMRPC-TRACE-LEVEL > '0'
  COMPRESS 'Using File-ID: ' #SPOOL-DI-PATH '/' #SPOOL-DI-FILENAME '.'
    #SPOOL-DI-FILETYPE TO #TRACE-MSG LEAVING NO
  PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
  END TRANSACTION
END-IF
*
END-SUBROUTINE /* SET-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE ADD-TO-META
************************************************************************
IF #VALUE = ' '
  ESCAPE ROUTINE
END-IF
IF NOMRPC-INPUT-FORMAT = 'X'
  CALLNAT 'XXCPAGE' 'E' #VALUE #ERC #ERT 2X #TRACING /* normalize it
ELSE
  CALLNAT 'XXCPAGE' 'E' #VALUE #ERC #ERT /* nomrmalize it
    NOMRPC-CODEPAGE 1X #TRACING
END-IF
IF #ERC NE 0
  NOMRPC-RC := #ERC
  #LINE     := *LINE
  PERFORM EXIT
END-IF
CALLNAT 'XXCPAGE' 'D' #VALUE #ERC #ERT 2X #TRACING
IF #ERC NE 0
  NOMRPC-RC := #ERC
  #LINE     := *LINE
  PERFORM EXIT
END-IF
IF #TRACING
  END TRANSACTION
END-IF
* Avoid duplicate entries:
COMPRESS #TAG-CURRENT '=' TO #A250 LEAVING NO
IF #SPOOL-ATTR-EXTENDED = SCAN #A250
  ESCAPE ROUTINE
END-IF
IF #SPOOL-ATTR-EXTENDED NE ' '
  COMPRESS #SPOOL-ATTR-EXTENDED ';' #TAG-CURRENT '=' #VALUE
    TO #SPOOL-ATTR-EXTENDED LEAVING NO
ELSE
  COMPRESS #TAG-CURRENT '=' #VALUE TO #SPOOL-ATTR-EXTENDED LEAVING NO
END-IF
*
END-SUBROUTINE /* ADD-TO-META
*
************************************************************************
DEFINE SUBROUTINE GET-SOURCE-TEXT-ID
************************************************************************
CALLNAT 'RMSTID-N' #ST-PARMS
IF #ST-RC NE 0
  NOMRPC-RC         := 5
  NOMRPC-ERROR-TEXT :=  #ST-ERRTXT
  CALLNAT 'RSUBMSGN' NOMRPC-ERROR-TEXT
  PERFORM WRITE-TRACE
  #LINE := *LINE
  PERFORM WRITE-LOG
  ESCAPE MODULE        /* nothing todo here anymore..                   .
END-IF
#SOURCE-TEXT-ID := #ST-ID
*
END-SUBROUTINE /* GET-SOURCE-TEXT-ID
*
************************************************************************
DEFINE SUBROUTINE METADATA-TO-XML
************************************************************************
RESET #XML-TEMP
RESIZE DYNAMIC VARIABLE #XML-TEMP TO 0
#XML-TEMP := NOMRPC-DATA
PERFORM HIDE-TAGS #XML-TEMP
RESET NOMRPC-DATA
RESIZE DYNAMIC VARIABLE NOMRPC-DATA TO 0
COMPRESS '<metadata>' #CR TO NOMRPC-DATA
COMPRESS NOMRPC-DATA #TAB '<doc repname="' NOMRPC-REPNAME '" reprnb="'
  NOMRPC-RNB '" poid="' NOMRPC-PO-ID '" >' #CR TO NOMRPC-DATA LEAVING NO
IF #XML-TEMP NE ' '
  COMPRESS NOMRPC-DATA #TAB #TAB  '<properties_all>'
    #XML-TEMP '</properties_all>' #CR TO NOMRPC-DATA LEAVING NO
END-IF
COMPRESS NOMRPC-DATA #TAB '</doc>' #CR '</metadata>' #CR
  TO NOMRPC-DATA LEAVING NO
*
END-SUBROUTINE /* METADATA-TO-XML
*
************************************************************************
DEFINE SUBROUTINE LIST-TO-XML
************************************************************************
OOPOLS-LIST-A := NOMRPC-DATA
RESET NOMRPC-DATA
RESIZE DYNAMIC VARIABLE NOMRPC-DATA TO 0
COMPRESS '<list>' #CR TO NOMRPC-DATA LEAVING NO
FOR #I = 1 TO *OCC(OOPOLS-REPNAME)
  IF OOPOLS-REPNAME (#I) = ' '
    ESCAPE BOTTOM
  END-IF
  COMPRESS NOMRPC-DATA #TAB    '<doc repname="'
    OOPOLS-REPNAME (#I) '" reprnb="' OOPOLS-REPRNB  (#I) '" poid="'
    OOPOLS-ID (#I) '" >' #CR TO NOMRPC-DATA LEAVING NO
  DECIDE FOR EVERY CONDITION
    WHEN OOPOLS-FILENAME-TYPE (#I) NE ' '
      SEPARATE OOPOLS-FILENAME-TYPE (#I) INTO #STRING
        REMAINDER #STRING2 WITH DELIMITER '.'
      XXHASH-PARMS.P-FUNCTION  := 'L' /*short -> long
      XXHASH-PARMS.P-SHORT-NAME := #STRING
      PERFORM XXHASH XXHASH-PARMS
      COMPRESS NOMRPC-DATA #TAB #TAB  '<name>' XXHASH-PARMS.P-LONG-NAME
        '.' #STRING2 '</name>' #CR TO NOMRPC-DATA LEAVING NO
    WHEN OOPOLS-STATUS (#I) NE ' '
      COMPRESS NOMRPC-DATA #TAB #TAB  '<status>'
        OOPOLS-STATUS (#I) '</status>' #CR TO NOMRPC-DATA LEAVING NO
    WHEN OOPOLS-OWNER (#I) NE ' '
      COMPRESS NOMRPC-DATA #TAB #TAB  '<owner>'
        OOPOLS-OWNER (#I) '</owner>' #CR TO NOMRPC-DATA LEAVING NO
    WHEN OOPOLS-LINES (#I) NE ' '
      COMPRESS NOMRPC-DATA #TAB #TAB  '<lines>'
        OOPOLS-LINES (#I) '</lines>' #CR TO NOMRPC-DATA LEAVING NO
    WHEN OOPOLS-BYTES (#I) NE ' '
      COMPRESS NOMRPC-DATA #TAB #TAB  '<kbytes>'
        OOPOLS-BYTES (#I) '</kbytes>' #CR TO NOMRPC-DATA LEAVING NO
    WHEN OOPOLS-TIME (#I) NE ' '
      COMPRESS NOMRPC-DATA #TAB #TAB  '<sent>'
        OOPOLS-TIME (#I) '</sent>' #CR TO NOMRPC-DATA LEAVING NO
    WHEN OOPOLS-SPOOL-ATTR-EXTENDED (#I) NE ' '
      PERFORM DELETE-TAG OOPOLS-SPOOL-ATTR-EXTENDED (#I) 'exx_'
      PERFORM DELETE-TAG OOPOLS-SPOOL-ATTR-EXTENDED (#I) 'rpc_'
      PERFORM DELETE-TAG OOPOLS-SPOOL-ATTR-EXTENDED (#I) 'nat_'
      PERFORM DELETE-TAG OOPOLS-SPOOL-ATTR-EXTENDED (#I) 'source='
      PERFORM DELETE-TAG OOPOLS-SPOOL-ATTR-EXTENDED (#I) 'sender='
      PERFORM DELETE-TAG OOPOLS-SPOOL-ATTR-EXTENDED (#I) 'domain='
      PERFORM DELETE-TAG OOPOLS-SPOOL-ATTR-EXTENDED (#I) 'filename='
      PERFORM DELETE-TAG OOPOLS-SPOOL-ATTR-EXTENDED (#I) 'filetype='
      PERFORM DELETE-TAG OOPOLS-SPOOL-ATTR-EXTENDED (#I) 'title='
      PERFORM DELETE-TAG OOPOLS-SPOOL-ATTR-EXTENDED (#I) 'titel='
      PERFORM HIDE-TAGS  OOPOLS-SPOOL-ATTR-EXTENDED (#I)
      COMPRESS NOMRPC-DATA #TAB #TAB  '<properties>'
        OOPOLS-SPOOL-ATTR-EXTENDED (#I) '</properties>'  #CR
        TO NOMRPC-DATA LEAVING NO
    WHEN NONE IGNORE
  END-DECIDE
  FOR #J = 1 TO 10
    IF OOPOLS-DISABLED-CMD (#I,#J) = ' '
      ESCAPE BOTTOM
    END-IF
    COMPRESS NOMRPC-DATA #TAB #TAB '<disabled-cmd>'
      OOPOLS-DISABLED-CMD (#I,#J)    '</disabled-cmd>'   #CR
      TO NOMRPC-DATA LEAVING NO
  END-FOR
  COMPRESS NOMRPC-DATA #TAB '</doc>' #CR TO NOMRPC-DATA LEAVING NO
END-FOR
COMPRESS NOMRPC-DATA '</list>' #CR TO NOMRPC-DATA LEAVING NO
*
END-SUBROUTINE /* LIST-TO-XML
*
************************************************************************
DEFINE SUBROUTINE EXIT
************************************************************************
PERFORM WRITE-TRACE
PERFORM WRITE-LOG
PERFORM BLANK-WORK
ESCAPE MODULE
*
END-SUBROUTINE /* EXIT
*
************************************************************************
DEFINE SUBROUTINE WRITE-LOG
************************************************************************
IF NOMRPC-RC = 0 OR (NOMRPC-RC =5 AND NOMRPC-ERROR-TEXT =' ' OR ='0005')
  ESCAPE ROUTINE
END-IF
LG-CODE := 'MO'
DECIDE ON FIRST VALUE OF NOMRPC-RC
  VALUES 5,21
    EXAMINE #SPOOL-ATTR-EXTENDED FOR 'rpc_user=' GIVING POSITION #POS-ABS
    IF #POS-ABS NE 0
      SEPARATE SUBSTR(#SPOOL-ATTR-EXTENDED,#POS-ABS) INTO #STRING
        IGNORE WITH DELIMITER ';'
      SEPARATE #STRING INTO #SPOOL-DI-USERID #SPOOL-DI-USERID
      IGNORE WITH DELIMITER '='
    END-IF
*
    LG-MSG := NOMRPC-ERROR-TEXT
    LG-USERID := #SPOOL-DI-USERID
  VALUE 9166
    COMPRESS '9166' #LINE NOMRPC-ERROR-TEXT TO LG-MSG
  VALUE 9168
    LG-MSG := NOMRPC-ERROR-TEXT :=  #ERT
    PERFORM GET-TEXT
  NONE VALUE
    COMPRESS '5 Error 'NOMRPC-RC 'occurred during XML parsing' TO LG-MSG
END-DECIDE
PERFORM NOMCHCKP-CHECK-PROG 'RLOG' #RC
IF #RC = 0
  CALLNAT 'RLOG' PL-PARMS
  END TRANSACTION
END-IF
*
END-SUBROUTINE /* WRITE-LOG
*
************************************************************************
DEFINE SUBROUTINE BLANK-WORK
************************************************************************
EXAMINE #FUNCTION-OLD FOR ' ' GIVING LENGTH #LEN
IF #LEN < 8
  ADD 1 TO #LEN
  RESET #FUNCT-TAB(#LEN:8)
END-IF
#LEN := *LENGTH (#RECORD-D)
IF #LEN < 251
  ADD 1 TO #LEN
  RESET #RECORD-TAB(#LEN:251)
END-IF
END TRANSACTION
*
END-SUBROUTINE /* BLANK-WORK
*
************************************************************************
DEFINE SUBROUTINE GET-TEXT
************************************************************************
IF NOMRPC-LANGUAGE-A IS (N2) AND *LANGUAGE NE NOMRPC-LANGUAGE
  #LANGUAGE := *LANGUAGE
  *LANGUAGE := NOMRPC-LANGUAGE
END-IF
#XX-ERROR-CODE := NOMRPC-RC
SEPARATE NOMRPC-ERROR-TEXT INTO #XX-MSG-DYNA (*) IGNORE
  WITH DELIMITER ' '
CALLNAT 'XXGMSG-N' #XX-GMSG-PARMS
NOMRPC-ERROR-TEXT := #XX-SHORT-TEXT
IF #LANGUAGE > 0
  *LANGUAGE := #LANGUAGE
END-IF
*
END-SUBROUTINE /* GET-TEXT
*
************************************************************************
DEFINE SUBROUTINE WRITE-TRACE
************************************************************************
IF NOMRPC-RC > 0 AND NOMRPC-RC NE 9166
    AND NOMRPC-RC NE 21     /* Natural error
    AND NOMRPC-RC NE 5      /* (from 'RMSTID-N')
  PERFORM GET-TEXT
  PERFORM XXRLOG-WRITE-LOG 'W' NOMRPC-ERROR-TEXT
  END TRANSACTION
  ESCAPE ROUTINE
END-IF
DECIDE ON EVERY VALUE OF NOMRPC-TRACE-LEVEL
  VALUES '2','3','4'
    #L := *LENGTH (#SPOOL-ATTR-EXTENDED)
    IF #L > 115
      #L := 115
    END-IF
    IF #L > 0
      COMPRESS 'METADATA:' SUBSTR(#SPOOL-ATTR-EXTENDED,1,#L)
        TO #TRACE-MSG LEAVING NO
      PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
      END TRANSACTION
    END-IF
  VALUE '3'
    #TRACE-MSG :=  #MSG
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    END TRANSACTION
    IF NOMRPC-DATA NE ' '
        AND #MSG NE SCAN('finished')
      #L := *LENGTH (NOMRPC-DATA)
      IF #L > 50
        #L := 50
      END-IF
      IF #L > 0
        COMPRESS 'INPUT-DATA (Length 50):' SUBSTR(NOMRPC-DATA,1,#L)
          TO #TRACE-MSG LEAVING NO
        PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
        END TRANSACTION
      END-IF
    END-IF
    IF NOMRPC-RC > 0 AND NOMRPC-RC < 10000
      COMPRESS 'Aborting function' NOMRPC-FUNCTION
        TO #TRACE-MSG LEAVING NO
      PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
      END TRANSACTION
    END-IF
  VALUE '4'
    COMPRESS 'Got NOMRPC-parameters:' TO #TRACE-MSG LEAVING NO
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    COMPRESS 'function:' NOMRPC-FUNCTION
      '- rc:'        NOMRPC-RC '- trc:'       NOMRPC-TRACE-LEVEL
      '- format'     NOMRPC-INPUT-FORMAT '- DB' NOMRPC-CONTAINER-DB
      '- FNR'        NOMRPC-CONTAINER-FNR '- lang:'      NOMRPC-LANGUAGE
      '- eof: -->'   NOMRPC-EOF           '<--'
      '- CP:'        NOMRPC-CODEPAGE '- #fct-old:'  #FUNCTION-OLD
      '- #DB:'       #CONTAINER-DB '- #FNR:'      #CONTAINER-FNR
      '- rec-no:'    #RECORD-NUMBER '- ST-ID:'     #SOURCE-TEXT-ID
      TO #TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    END TRANSACTION
    #TRACE-MSG :=  #MSG
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    COMPRESS 'Input-format:' NOMRPC-INPUT-FORMAT TO #TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    COMPRESS 'EOF? -->'  NOMRPC-EOF '<--' TO #TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    END TRANSACTION
    IF NOMRPC-WORK NE ' ' AND #MSG NE SCAN('finished')
      #TRACE-MSG := 'WORK:'
      PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
      EXAMINE NOMRPC-WORK FOR ' ' GIVING LENGTH #L
      FOR #J = 1 TO #L STEP 100
        IF SUBSTR(NOMRPC-WORK,#J) NE ' '
          IF #L - #J  > 99
            #K := 100
          ELSE
            #K := #L - #J + 1
          END-IF
          IF #K > 0
            #TRACE-MSG := SUBSTR(NOMRPC-WORK,#J,#K)
            PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
            END TRANSACTION
          END-IF
        END-IF
      END-FOR
    END-IF
    IF NOMRPC-DATA NE ' ' AND #MSG NE SCAN('finished')
      #TRACE-MSG := 'INPUT-DATA:'
      PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
      REP2. REPEAT
        PERFORM XXHEXPRT #INPUT-DATA #HEXHIGH #HEXLOW #RULER
          #RULER-OFFSET TRUE NOMRPC-DATA 75
        IF #RULER-OFFSET = -1
          ESCAPE BOTTOM (REP2.)
        END-IF
        PERFORM XXRLOG-WRITE-LOG 'T' #INPUT-DATA
        PERFORM XXRLOG-WRITE-LOG 'T' #HEXHIGH
        PERFORM XXRLOG-WRITE-LOG 'T' #HEXLOW
        PERFORM XXRLOG-WRITE-LOG 'T' #RULER
        END TRANSACTION
      END-REPEAT
    END-IF
    IF NOMRPC-RC > 0 AND NOMRPC-RC < 10000
      COMPRESS 'Aborting function' NOMRPC-FUNCTION
        TO #TRACE-MSG LEAVING NO
      PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
      END TRANSACTION
    END-IF
  NONE
    ESCAPE ROUTINE
END-DECIDE
*
END-SUBROUTINE /* WRITE-TRACE
*
************************************************************************
DEFINE SUBROUTINE STORE-RECORD
************************************************************************
IF NOMRPC-TRACE-LEVEL > '3'
  #TRACE-MSG := 'Resulting buffer:'
  PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
  EXAMINE #ST-TEXT-BUFFER-LOB FOR ' ' GIVING LENGTH IN #LEN
  FORTR. FOR #I = 1 TO 300 STEP 75
    IF #I > #LEN
      ESCAPE BOTTOM (FORTR.)
    END-IF
    #TRACE-MSG := SUBSTR(#ST-TEXT-BUFFER-LOB,#I,75)
    PERFORM XXHEXPRT #TRACE-MSG #HEXHIGH #HEXLOW #RULER 1X TRUE
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' #HEXHIGH
    PERFORM XXRLOG-WRITE-LOG 'T' #HEXLOW
    PERFORM XXRLOG-WRITE-LOG 'T' #RULER
    END TRANSACTION
  END-FOR
END-IF
*** Erase 'tail end' of buffer
IF CONTAINER.ST-BUFFER-LENGTH-X < #NSMCOMP-BUFFER-LENGTH
  #FROM := CONTAINER.ST-BUFFER-LENGTH-X
  ADD 4 TO #FROM /* Include 'v34' prefix
  #TO := #NSMCOMP-BUFFER-LENGTH
  IF #FROM LE #TO
    RESET CONTAINER.ST-B-LOB-CH (#FROM : #TO)
  END-IF
END-IF
STORE CONTAINER
END TRANSACTION
*
END-SUBROUTINE /*STORE-RECORD
*
************************************************************************
DEFINE SUBROUTINE HANDLE-DATA-FORMAT-NOT-TX
************************************************************************
B64-FUNCTION      := 'AB'
B64-TEXT-ARRAY(1) := #VALUE
IF NOMRPC-TRACE-LEVEL > '2'
  COMPRESS 'To be checked:' #VALUE TO #TRACE-MSG LEAVING NO
  PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
  END TRANSACTION
END-IF
CALLNAT 'RMBAS64N' B64-PARMS 1X NOMRPC-TRACE-LEVEL
IF B64-RC NE 0
  NOMRPC-RC := 9166
  COMPRESS *LINE B64-ERRTXT TO NOMRPC-ERROR-TEXT
  #LINE     := *LINE
  PERFORM EXIT
END-IF
IF NOT #NATPARMS-OK
  #NATPARMS-OK := TRUE
  SEPARATE B64-B INTO #NATPARMS REMAINDER B64-B WITH DELIMITERS H'0C'
  IF *MACHINE-CLASS = 'MAINFRAME'
    CALLNAT 'RMASCEBN' 'A' #NATPARMS
  END-IF
  IF NOMRPC-TRACE-LEVEL > '2'
    COMPRESS 'NATPARMS:' #NATPARMS TO #TRACE-MSG LEAVING NO
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    END TRANSACTION
  END-IF
  EXAMINE #NATPARMS AND TRANSLATE INTO LOWER
  IF #NATPARMS NE MASK ('profile=')
    REDUCE DYNAMIC #NATPARMS TO 0
  ELSE
    EXAMINE B64-B FOR ' ' GIVING LENGTH #LEN
    DIVIDE 4 INTO #LEN REMAINDER #LEN
    #LEN := 3 - #LEN
    COMPRESS SUBSTR(#BLANKS,1,#LEN)   /* Get length
      H'0C' B64-B TO B64-B LEAVING NO /* as multiple of 4
    EXAMINE B64-B FOR '&' REPLACE WITH ' '
    B64-FUNCTION      := 'BA'
    CALLNAT 'RMBAS64N' B64-PARMS 248 NOMRPC-TRACE-LEVEL
    IF B64-RC NE 0
      NOMRPC-RC := 9166
      COMPRESS *LINE B64-ERRTXT TO NOMRPC-ERROR-TEXT
      #LINE     := *LINE
      PERFORM EXIT
    END-IF
    #VALUE := B64-TEXT-ARRAY(1)
    IF NOMRPC-TRACE-LEVEL > '2'
      COMPRESS 'Reduced value:' #VALUE TO #TRACE-MSG LEAVING NO
      PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
      END TRANSACTION
    END-IF
  END-IF
END-IF
#RECORD-E := #VALUE
PERFORM COMPRESS-INTO-BUFFER
*
END-SUBROUTINE /* HANDLE-DATA-FORMAT-NOT-TX
*
************************************************************************
DEFINE SUBROUTINE HANDLE-DATA-FORMAT-X
************************************************************************
EXPAND ARRAY B64-TEXT-ARRAY TO (1:1)
B64-FUNCTION := 'AB'
B64-BRACKET  := 'F'
#LASTSTEP :=  *LENGTH (#VALUE) - 251
IF #LASTSTEP < 0
  #LASTSTEP := *LENGTH (#VALUE)
  RESET B64-BRACKET /* only one step
END-IF
FOR #I = 1 TO *LENGTH (#VALUE) STEP 251
  IF #I > #LASTSTEP
    B64-BRACKET := 'L'
  END-IF
  B64-TEXT-ARRAY(1) := SUBSTR(#VALUE,#I)
  CALLNAT 'RMBAS64N' B64-PARMS 1X NOMRPC-TRACE-LEVEL
  IF B64-RC NE 0
    NOMRPC-RC := 9166
    COMPRESS *LINE B64-ERRTXT TO NOMRPC-ERROR-TEXT
    #LINE     := *LINE
    PERFORM EXIT
  END-IF
  B64-BRACKET := 'M'
END-FOR
RESIZE DYNAMIC VARIABLE #VALUE TO 0
#VALUE := B64-B
IF NOMRPC-CODEPAGE  NE ' '
  IF NOMRPC-TRACE-LEVEL > '2'
    COMPRESS 'At' *LINE 'got value' #VALUE TO #TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    END TRANSACTION
  END-IF
  PERFORM CHECK-CODEPAGE
  CALLNAT 'XXMVENC' #VALUE 1X NOMRPC-CODEPAGE #VALUE 2X #ERC #ERT
  IF #ERC NE 0
    #LINE := *LINE
    PERFORM LOG-ENC-ERROR
    IF #ERC = 3413 OR = -3413
      RESET #ERC #ERT
    END-IF
  END-IF
  IF NOMRPC-TRACE-LEVEL > '2'
    COMPRESS 'Encoded with RC' #ERC
      'CP' NOMRPC-CODEPAGE 'to' #VALUE TO #TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    END TRANSACTION
  END-IF
  IF #ERC NE 0 AND #ERC NE 3413
    NOMRPC-RC         := 9168
    COMPRESS '(RC:' #ERC ')' TO #ERT LEAVING NO
    COMPRESS '9168' NOMRPC-CODEPAGE #ERT TO #ERT
    #LINE             := *LINE
    PERFORM EXIT
  END-IF
END-IF
CALLNAT 'XXCPAGE' 'E' #VALUE #ERC #ERT 2X #TRACING
IF #ERC NE 0
  NOMRPC-RC := #ERC
  #LINE     := *LINE
  PERFORM EXIT
END-IF
CALLNAT 'XXCPAGE' 'D' #VALUE #ERC #ERT 2X #TRACING
IF #ERC NE 0
  NOMRPC-RC := #ERC
  #LINE     := *LINE
  PERFORM EXIT
END-IF
*
END-SUBROUTINE /* HANDLE-DATA-FORMAT-X
*
************************************************************************
DEFINE SUBROUTINE HANDLE-DATA-FORMAT-T
************************************************************************
CALLNAT 'XXCPAGE' 'E' #VALUE #ERC #ERT /* normalize it
  NOMRPC-CODEPAGE 1X #TRACING
IF #ERC NE 0
  NOMRPC-RC := #ERC
  #LINE     := *LINE
  PERFORM EXIT
END-IF
CALLNAT 'XXCPAGE' 'D' #VALUE #ERC #ERT 2X #TRACING
IF #ERC NE 0
  NOMRPC-RC := #ERC
  #LINE     := *LINE
  PERFORM EXIT
END-IF
*
END-SUBROUTINE /* HANDLE-DATA-FORMAT-T
*
************************************************************************
DEFINE SUBROUTINE HANDLE-DATA-FORMAT-XT_2
************************************************************************
IF #TRACING
  END TRANSACTION
END-IF
IF NOT #NATPARMS-OK
  #NATPARMS-OK := TRUE
  SEPARATE #VALUE INTO #NATPARMS REMAINDER B64-B
    WITH DELIMITERS H'0C'
  EXAMINE #NATPARMS AND TRANSLATE INTO LOWER
  IF #NATPARMS NE MASK ('profile=')
    REDUCE DYNAMIC #NATPARMS TO 0
  ELSE
    IF NOMRPC-TRACE-LEVEL > '2'
      COMPRESS 'NATPARMS:' #NATPARMS TO #TRACE-MSG LEAVING NO
      PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
      END TRANSACTION
    END-IF
    EXAMINE #NATPARMS FOR 'codepage=' GIVING POSITION #POS
    IF #POS NE 0
      SEPARATE SUBSTR(#NATPARMS,#POS)
        INTO NOMRPC-CODEPAGE IGNORE WITH DELIMITER ';'
      SEPARATE NOMRPC-CODEPAGE
        INTO NOMRPC-CODEPAGE NOMRPC-CODEPAGE
      IGNORE WITH DELIMITER '='
    END-IF
    COMPRESS H'0C' B64-B TO #VALUE LEAVING NO
  END-IF
END-IF
#POS := 0
DECIDE ON EVERY VALUE OF #POS
  VALUE 0
    #DELIM := H'0D0A' /* Windows Linefeed
    EXAMINE #VALUE FOR #DELIM GIVING POSITION #POS
  VALUE 0
    #DELIM := H'0D'   /* Apple Linefeed
    EXAMINE #VALUE FOR #DELIM GIVING POSITION #POS
  VALUE 0
    IF *MACHINE-CLASS = 'MAINFRAME'
      #DELIM := H'25'   /* MF    Linefeed
      EXAMINE #VALUE FOR #DELIM GIVING POSITION #POS
    END-IF
  VALUE 0
    #DELIM := H'0A'   /* Unix  Linefeed is default.
  NONE
    IGNORE
END-DECIDE
IF NOMRPC-TRACE-LEVEL > '3'
  MOVE EDITED #DELIM (EM=HH) TO #DELIM-A
  COMPRESS 'Line-end character found:' #DELIM-A
    '- 1st Position in data tag:' #POS TO #TRACE-MSG LEAVING NO
  PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
  END TRANSACTION
END-IF
IF #DELIM NE H'0A'
  EXAMINE #VALUE FOR #DELIM REPLACE H'0A'
END-IF
EXAMINE DIRECTION BACKWARD #VALUE FOR H'0A'
  GIVING POSITION #POS LENGTH #LEN
IF #POS NE #LEN /* no delimiter at the end
  #NODELIM := TRUE
ELSE
  #NODELIM := FALSE
END-IF
IF +VALUE-OLD NE ' '
  COMPRESS FULL +VALUE-OLD #VALUE INTO #VALUE LEAVING NO
END-IF
REDUCE DYNAMIC +VALUE-OLD TO 0
REPEAT
  UNTIL #VALUE = ' '
  IF NOMRPC-TRACE-LEVEL > '3'
    #TRACE-MSG := 'Separating buffer...'
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    #TRACE-MSG := #VALUE
    PERFORM XXHEXPRT #TRACE-MSG #HEXHIGH #HEXLOW #RULER 1X TRUE
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' #HEXHIGH
    PERFORM XXRLOG-WRITE-LOG 'T' #HEXLOW
    PERFORM XXRLOG-WRITE-LOG 'T' #RULER
  END-IF
  REDUCE DYNAMIC #RECORD-D TO 0
  SEPARATE #VALUE INTO #RECORD-D REMAINDER #VALUE
    WITH  DELIMITERS #LINEFEEDS
  IF NOMRPC-TRACE-LEVEL > '3'
    #TRACE-MSG := '...into line:'
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    #TRACE-MSG := #RECORD-D
    PERFORM XXHEXPRT #TRACE-MSG #HEXHIGH #HEXLOW #RULER 1X TRUE
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' #HEXHIGH
    PERFORM XXRLOG-WRITE-LOG 'T' #HEXLOW
    PERFORM XXRLOG-WRITE-LOG 'T' #RULER
    END TRANSACTION
  END-IF
  RESET #FORMFEED #FORMFEED-OLD #FORMFEED-FLAG
  REPEAT
    SEPARATE #RECORD-D INTO #RECORD-E REMAINDER #RECORD-D
      WITH DELIMITER #FF
    IF NOMRPC-TRACE-LEVEL > '3'
      #TRACE-MSG := 'Separated for formfeed:'
      PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
      #TRACE-MSG := #RECORD-E
      PERFORM XXHEXPRT #TRACE-MSG #HEXHIGH #HEXLOW #RULER 1X TRUE
      PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
      PERFORM XXRLOG-WRITE-LOG 'T' #HEXHIGH
      PERFORM XXRLOG-WRITE-LOG 'T' #HEXLOW
      PERFORM XXRLOG-WRITE-LOG 'T' #RULER
      END TRANSACTION
    END-IF
    #FORMFEED := #FORMFEED-OLD
    IF #RECORD-D NE ' '
      #FORMFEED-OLD := TRUE
    ELSE
      #FORMFEED-OLD := FALSE
    END-IF
    IF NOT #FORMFEED-FLAG AND #FORMFEED-OLD
        AND #RECORD-E = ' '
      #FORMFEED-FLAG := TRUE
      ESCAPE TOP /* first formfeed before first record
    END-IF
    #FORMFEED-FLAG := TRUE
    #LEN := *LENGTH(#RECORD-E)
    IF #LEN > +MAXLEN
      +MAXLEN := #LEN + 2
      IF #TRACING
        COMPRESS '+MAXLEN set to' +MAXLEN TO #TRACE-MSG
        PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
        IF #LEN > 80
          COMPRESS 'Found long record of length' #LEN TO #TRACE-MSG
          PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
          #TRACE-MSG := 'Check #RECORD-E:'
          PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
          REP3. REPEAT
            PERFORM XXHEXPRT #INPUT-DATA #HEXHIGH #HEXLOW #RULER
              #RULER-OFFSET TRUE #RECORD-E 75
            IF #RULER-OFFSET = -1
              ESCAPE BOTTOM (REP3.)
            END-IF
            PERFORM XXRLOG-WRITE-LOG 'T' #INPUT-DATA
            PERFORM XXRLOG-WRITE-LOG 'T' #HEXHIGH
            PERFORM XXRLOG-WRITE-LOG 'T' #HEXLOW
            PERFORM XXRLOG-WRITE-LOG 'T' #RULER
            END TRANSACTION
          END-REPEAT
          END TRANSACTION
        END-IF
      END-IF
    END-IF
    IF #LEN > 0 AND #NODELIM = TRUE AND #VALUE = ' '
      +VALUE-OLD := SUBSTR (#RECORD-E,1,#LEN)
    ELSE
      RESET +VALUE-OLD
      PERFORM COMPRESS-INTO-BUFFER
      IF NOMRPC-RC NE 0
        ESCAPE ROUTINE
      END-IF
    END-IF
    UNTIL #RECORD-D = ' '
  END-REPEAT
END-REPEAT
REDUCE DYNAMIC #RECORD-E TO 0
REDUCE DYNAMIC #RECORD-D TO 0
*
END-SUBROUTINE /* HANDLE-DATA-FORMAT-XT_2
*
************************************************************************
DEFINE SUBROUTINE HANDLE-CANCEL
************************************************************************
#AR-REPNAME   := NOMRPC-REPNAME
IF NOMRPC-RNB IS (P11)
  #AR-REPRNB := VAL(NOMRPC-RNB)
ELSE
  RESET #AR-REPRNB
END-IF
RESET #POS
FIND (1) AR WITH AR-REPORT-RNB = #AR-REPORT-RNB
  COMPRESS AR-SPOOL-ATTR-EXTENDED (*)
    TO #AR-SPOOL-ATTR-EXTENDED LEAVING NO
  EXAMINE #AR-SPOOL-ATTR-EXTENDED FOR 'canceltag=' GIVING POSITION #POS
END-FIND
IF #POS = 0
  PERFORM CHECK-CANCEL
  CALLNAT 'OOPOFF-N' NOMRPC-PARMS NOMRPC-INPUT-PARMS
ELSE
  RESET #REPNAMES (*) #REPRNBS (*) #POS-REPNAME #MAX
  SEPARATE SUBSTR(#AR-SPOOL-ATTR-EXTENDED,#POS)
    INTO #TAG-GROUP IGNORE WITH DELIMITERS ';'
  SEPARATE #TAG-GROUP
    INTO #TAG-GROUP #TAG-GROUP IGNORE WITH DELIMITERS '='
  EXAMINE #TAG-GROUP AND TRANSLATE INTO LOWER
  EXAMINE #AR-SPOOL-ATTR-EXTENDED FOR #TAG-GROUP
    GIVING POSITION #POS
  IF #POS = 0
    PERFORM CHECK-CANCEL
    CALLNAT 'OOPOFF-N' NOMRPC-PARMS NOMRPC-INPUT-PARMS
  ELSE
    SEPARATE SUBSTR(#AR-SPOOL-ATTR-EXTENDED,#POS)
      INTO #VALUE-GROUP IGNORE WITH DELIMITERS ';'
    NOMRPC-ERROR-TEXT := #VALUE-GROUP /* no error, only tag
    SEPARATE #VALUE-GROUP
      INTO #VALUE-GROUP #VALUE-GROUP IGNORE WITH DELIMITERS '='
    #SOURCE := NOMRPC-SOURCE
    #SENDER := NOMRPC-SENDER
    RESET #TIME-INV #AR-ACTIVE
    CHSENDER. READ AR BY AR-SOURCE-SENDER-TIME-INV
        STARTING FROM #AR-SOURCE-SENDER-TIME-INV
      IF AR-SOURCE NE #SOURCE OR AR-SENDER NE #SENDER
        ESCAPE BOTTOM (CHSENDER.)
      END-IF
      #AR-REPNAME := AR-REPNAME
      #AR-REPRNB  := AR-REPRNB
      FIND PO WITH PO-REPORT-RNB = #AR-REPORT-RNB
        IF PO-STATUS NE 'R'      /* ready to print
            AND PO-STATUS NE 'H' /* printout held
            AND PO-STATUS NE 'S' /* printer stopped
          NOMRPC-RC := 511
          RESET NOMRPC-ERROR-TEXT
          #LINE     := *LINE
          PERFORM EXIT
        END-IF
      END-FIND
    END-READ
    NOMRPC-RC := 515
    PERFORM GET-TEXT
    PERFORM XXRLOG-WRITE-LOG 'W' NOMRPC-ERROR-TEXT
    END TRANSACTION
    RESET NOMRPC-RC NOMRPC-ERROR-TEXT
    RDSENDER. READ AR BY AR-SOURCE-SENDER-TIME-INV
        STARTING FROM #AR-SOURCE-SENDER-TIME-INV
      IF AR-SOURCE NE #SOURCE OR AR-SENDER NE #SENDER
        ESCAPE BOTTOM (RDSENDER.)
      END-IF
      COMPRESS AR-SPOOL-ATTR-EXTENDED (*)
        TO #AR-SPOOL-ATTR-EXTENDED LEAVING NO
      EXAMINE #AR-SPOOL-ATTR-EXTENDED FOR #TAG-GROUP
        GIVING POSITION #POS
      IF #POS = 0 OR AR-ARCHIVE NE ' ' OR AR-REVIVE NE ' '
        ESCAPE TOP
      END-IF
      SEPARATE SUBSTR(#AR-SPOOL-ATTR-EXTENDED,#POS)
        INTO #VALUE-GROUP-COMPARE IGNORE WITH DELIMITERS ';'
      SEPARATE #VALUE-GROUP-COMPARE
        INTO #VALUE-GROUP-COMPARE #VALUE-GROUP-COMPARE
      IGNORE WITH DELIMITERS '='
      IF #VALUE-GROUP NE #VALUE-GROUP-COMPARE
        ESCAPE TOP
      END-IF
      EXAMINE #REPNAMES (*) FOR AR-REPNAME
        GIVING INDEX #POS-REPNAME
      IF #POS-REPNAME NE 0
        IF #REPRNBS (#POS-REPNAME) = AR-REPRNB
          ESCAPE TOP
        END-IF
      END-IF
      IF #MAX < 100
        #MAX := #MAX + 1
        #REPNAMES (#MAX) := AR-REPNAME
        #REPRNBS  (#MAX) := AR-REPRNB
      END-IF
      NOMRPC-REPNAME := AR-REPNAME
      NOMRPC-RNB     := AR-REPRNB
      CALLNAT 'OOPOFF-N' NOMRPC-PARMS NOMRPC-INPUT-PARMS
    END-READ
  END-IF
END-IF
COMPRESS 'Function' NOMRPC-FUNCTION 'finished.' TO #MSG
PERFORM WRITE-TRACE
#LINE := *LINE
PERFORM EXIT
*
END-SUBROUTINE /* HANDLE-CANCEL
*
************************************************************************
DEFINE SUBROUTINE CHECK-CANCEL
************************************************************************
#AR-REPNAME := NOMRPC-REPNAME
IF NOMRPC-RNB IS (P11)
  #AR-REPRNB  := VAL(NOMRPC-RNB)
ELSE
  RESET #AR-REPRNB
END-IF
FIND PO WITH PO-REPORT-RNB = #AR-REPORT-RNB
  IF PO-STATUS NE 'R'      /* ready to print
      AND PO-STATUS NE 'H' /* printout held
      AND PO-STATUS NE 'S' /* printer stopped
    NOMRPC-RC := 511
    RESET NOMRPC-ERROR-TEXT
    #LINE     := *LINE
    PERFORM EXIT
  END-IF
END-FIND
END-SUBROUTINE /* CHECK-CANCEL
*
************************************************************************
DEFINE SUBROUTINE REMOVE-TAGS
************************************************************************
FOR #I1 = 1 TO *OCC(##TAGS)
  COMPRESS ##TAGS (#I1) '=' TO #A20 LEAVING NO
  EXAMINE #SPOOL-ATTR-EXTENDED FOR #A20 GIVING POSITION #POS-ABS
  IF #POS-ABS = 0
    ESCAPE TOP
  END-IF
  SEPARATE SUBSTR(#SPOOL-ATTR-EXTENDED,#POS-ABS) INTO #STRING #DELI
  IGNORE WITH RETAINED DELIMITER ';'
  DECIDE FOR FIRST CONDITION
    WHEN #POS-ABS = 1 AND #DELI = ' ' /*only tag
      IGNORE
    WHEN #DELI = ' ' /*last tag
      COMPRESS ';' #STRING TO #STRING  LEAVING NO /*last one
    WHEN NONE
      COMPRESS #STRING ';' TO #STRING  LEAVING NO
  END-DECIDE
  EXAMINE #SPOOL-ATTR-EXTENDED FOR #STRING DELETE
    GIVING NUMBER #POS-ABS
END-FOR
*
END-SUBROUTINE /* REMOVE-TAGS
*
********************************************************************************
DEFINE SUBROUTINE LOG-ENC-ERROR
********************************************************************************
DECIDE FOR EVERY CONDITION
  WHEN #TRACING
    COMPRESS 'XXMVENC returned' #ERC #ERT
      TO #TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
  WHEN #ERC = 9170
    COMPRESS '5' #ERT #LINE TO #ERT
    PERFORM XXRLOG-WRITE-LOG 'W' #ERT
    ESCAPE ROUTINE
  WHEN #ERC NE 0
    NOMRPC-RC         := #ERC
    NOMRPC-ERROR-TEXT := #ERT
* Get error text:
    NATA2000.VERSION        := 0
    NADA2000.ERROR-NUMBER   := ABS(#ERC)
    NADA2000.OPT-INSERT-DYN := TRUE
    NADA2000.OBJECT-KIND    := 'N' /*NAT /'U'ser
    NADA2000.LIBRARY        := ' ' /* #LIBRARY-ID
    NADA2000.OPT-LANGUAGE := 1 /*NAT LUW only english
    CALLNAT 'NATA2000' NADA2000 NATA2000.EXTENDED-PARMS NAD-MSG NAD-FLD
    MOVE EDITED NADA2000.ERROR-NUMBER (EM=9999) TO #TRACE-MSG
    COMPRESS 'NAT' #TRACE-MSG TO #TRACE-MSG LEAVING NO
    COMPRESS #TRACE-MSG SHORT-MSG TO #TRACE-MSG
    COMPRESS #TRACE-MSG #LINE TO #TRACE-MSG
    DECIDE ON FIRST VALUE OF #ERC
      VALUE 3413
        EXAMINE #TRACE-MSG FOR 'H'' ''' REPLACE WITH 'line'
        EXAMINE #TRACE-MSG FOR 'H''Subprogram''' REPLACE WITH 'line'
      NONE
        IGNORE
    END-DECIDE
    PERFORM XXRLOG-WRITE-LOG 'W' #TRACE-MSG
  WHEN #ERC = 3413
    #TRACE-MSG := '7233'
    PERFORM XXRLOG-WRITE-LOG 'W' #TRACE-MSG
    END TRANSACTION /* Only warning. Proceed with everything.
  WHEN #ERC = 0 OR = 3413
    RESET #ERC NOMRPC-RC NOMRPC-ERROR-TEXT
  WHEN NONE
    IGNORE
END-DECIDE
*
END-SUBROUTINE /* LOG-ENC-ERROR
*
************************************************************************
ON ERROR
************************************************************************
  NOMRPC-RC := 21 /* Natural error
  CALLNAT 'C-NATERN' NOMRPC-ERROR-TEXT 'W' #XML #LASTMSG
  COMPRESS 'NOM0021' NOMRPC-ERROR-TEXT TO NOMRPC-ERROR-TEXT
  PERFORM WRITE-TRACE
  END TRANSACTION
  NOMRPC-RC := 7137
  ESCAPE ROUTINE
*
END-ERROR
*
END
