G-PF-IDENT (09) := ##PFN-QUERY
G-PF-CODE  (09) := ##PFK-QUERY
IF G-SUPPORT-LONG-NAMES
  G-PF-IDENT (21) := ##PFN-DISPLAY-LONG-NAMES
  G-PF-CODE  (21) := ##PFK-DISPLAY-LONG-NAMES
ELSE
  G-PF-IDENT (21) := ##PFN-QUERY
  G-PF-CODE  (21) := ##PFN-QUERY
END-IF
