* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* NOXXEXNN - NOM API : Object exist (for all objects)
*
* XSETHZ  2005-02-10   created
* XSETHZ  2011-02-15 NOMALL-951
* CF1     2017-12-06 NOMALL-2062 Define new objects for NOM35
* CF2     2018-06-19 NOMALL-2062 - label corrected
************************************************************************
DEFINE DATA
PARAMETER USING ESMCNT-A
PARAMETER USING ESMINP-A
************************************************************************
LOCAL
1 RP VIEW OF NRM-REPORTS-NEW
1 BN VIEW OF NRM-BUNDLES
1 PR VIEW OF NRM-PRINTERS
1 DL VIEW OF NRM-DISTRIBUTION-LIST
1 FO VIEW OF NRM-FOLDER
1 AB VIEW OF NRM-ACTIVE-BUNDLES
1 PO VIEW OF NRM-PRINTOUTS
1 US VIEW OF NRM-USERS
1 CA VIEW OF NRM-CALENDARS
1 PH VIEW OF NRM-PHYSICAL-PRINTERS
1 DA VIEW OF NRM-USER-DEFINED-ARCHIVE
1 D3 VIEW OF NRM-MONITOR
1 DU VIEW OF NRM-UX-NODES
1 EM VIEW OF NRM-EMAIL-EVENTS
* *****
1 #OBJECT-EXIST-VALUE (A253)
1 REDEFINE #OBJECT-EXIST-VALUE
  2 #OBJECT-CODES     (A2/80)
  2 #OBJECT-EXIST     (A80)
  2 REDEFINE #OBJECT-EXIST
    3 #OBJECT-EXIST-A (A1/80)
1 #FO-USER-NAME       (A24)
1 REDEFINE #FO-USER-NAME
  2 #FO-USER          (A8)
  2 #FO-NAME          (A16)
1 #FO-USER-NAME-E     (A24)
1 #I                  (I4)
  /*                                                     /* CF1 ->
1 #EVENT-ID-E (A18)    INIT<'E-'>
1 REDEFINE #EVENT-ID-E
  2 #EV-PFX-E  (A2)
  2 #EV-NAME-E  (A16)
1 #EVENT-ID-S (A18)    INIT<'E-'>
1 REDEFINE #EVENT-ID-S
  2 #EV-PFX-S  (A2)
  2 #EV-NAME-S  (A16)
    /*                                                     /* CF1 <-
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#OBJECT-EXIST-VALUE := ES-KEY
FNRP. FIND NUMBER RP WITH R-REPNAME = H'00' THRU H'FF'
IF *NUMBER(FNRP.) > 0
  EXAMINE #OBJECT-CODES(*) FOR 'RP' GIVING INDEX #I
  #OBJECT-EXIST-A(#I) := '0'
END-IF
FNBN. FIND NUMBER BN WITH B-BUNDLE = H'00' THRU H'FF'
IF *NUMBER(FNBN.) > 0
  EXAMINE #OBJECT-CODES(*) FOR 'BN' GIVING INDEX #I
  #OBJECT-EXIST-A(#I) := '0'
END-IF
FNPR. FIND NUMBER PR WITH P-ID = H'00' THRU H'FF'
IF *NUMBER(FNPR.) > 0
  EXAMINE #OBJECT-CODES(*) FOR 'PR' GIVING INDEX #I
  #OBJECT-EXIST-A(#I) := '0'
END-IF
FNDL. FIND NUMBER DL WITH D-LIST-NAME = H'00' THRU H'FF'
IF *NUMBER(FNDL.) > 0
  EXAMINE #OBJECT-CODES(*) FOR 'DL' GIVING INDEX #I
  #OBJECT-EXIST-A(#I) := '0'
END-IF
#FO-USER-NAME := ES-USER
#FO-NAME := H'FF'
#FO-USER-NAME-E := #FO-USER-NAME
#FO-NAME := H'00'
FNFO. FIND NUMBER FO
  WITH FO-USER-NAME = #FO-USER-NAME THRU #FO-USER-NAME-E
IF *NUMBER(FNFO.) > 0
  EXAMINE #OBJECT-CODES(*) FOR 'FO' GIVING INDEX #I
  #OBJECT-EXIST-A(#I) := '0'
END-IF
FNAB. FIND NUMBER AB WITH AB-BUNDLE-RNB = H'00' THRU H'FF'
IF *NUMBER(FNAB.) > 0
  EXAMINE #OBJECT-CODES(*) FOR 'AB' GIVING INDEX #I
  #OBJECT-EXIST-A(#I) := '0'
END-IF
FNPO. FIND NUMBER PO WITH PO-ID = 0 THRU 9999999
IF *NUMBER(FNPO.) > 0
  EXAMINE #OBJECT-CODES(*) FOR 'PO' GIVING INDEX #I
  #OBJECT-EXIST-A(#I) := '0'
END-IF
FNUS. FIND NUMBER US WITH USER-ID = H'00' THRU H'FF'
IF *NUMBER(FNUS.) > 0
  EXAMINE #OBJECT-CODES(*) FOR 'US' GIVING INDEX #I
  #OBJECT-EXIST-A(#I) := '0'
END-IF
FNCA. FIND NUMBER CA WITH CA-CALENDAR-ID = H'00' THRU H'FF'
IF *NUMBER(FNCA.) > 0
  EXAMINE #OBJECT-CODES(*) FOR 'CA' GIVING INDEX #I
  #OBJECT-EXIST-A(#I) := '0'
END-IF
FNPH. FIND NUMBER PH WITH PH-VTAMID = H'00' THRU H'FF'
IF *NUMBER(FNPH.) > 0
  EXAMINE #OBJECT-CODES(*) FOR 'PH' GIVING INDEX #I
  #OBJECT-EXIST-A(#I) := '0'
END-IF
FNDA. FIND NUMBER DA WITH M-MONITOR-ID = 'USERARC01' THRU 'USERARC09'
IF *NUMBER(FNDA.) > 0
  EXAMINE #OBJECT-CODES(*) FOR 'DA' GIVING INDEX #I
  #OBJECT-EXIST-A(#I) := '0'
END-IF
FND3. FIND NUMBER D3 WITH M-MONITOR-ID = 'NOMUSR001' THRU 'NOMUSR999'
IF *NUMBER(FND3.) > 0
  EXAMINE #OBJECT-CODES(*) FOR 'D3' GIVING INDEX #I
  #OBJECT-EXIST-A(#I) := '0'
END-IF
FNDU. FIND NUMBER DU WITH UX-NODE-NAME = H'00' THRU H'FF'
IF *NUMBER(FNDU.) > 0
  EXAMINE #OBJECT-CODES(*) FOR 'DU' GIVING INDEX #I
  #OBJECT-EXIST-A(#I) := '0'
END-IF
EXAMINE #OBJECT-CODES(*) FOR 'MT' GIVING INDEX #I
#OBJECT-EXIST-A(#I) := '0'
EXAMINE #OBJECT-CODES(*) FOR 'AR' GIVING INDEX #I
#OBJECT-EXIST-A(#I) := '0'
EXAMINE #OBJECT-CODES(*) FOR 'AD' GIVING INDEX #I
#OBJECT-EXIST-A(#I) := '0'
EXAMINE #OBJECT-CODES(*) FOR 'RD' GIVING INDEX #I
#OBJECT-EXIST-A(#I) := '0'
EXAMINE #OBJECT-CODES(*) FOR 'VS' GIVING INDEX #I
#OBJECT-EXIST-A(#I) := '0'
EXAMINE #OBJECT-CODES(*) FOR 'LK' GIVING INDEX #I
#OBJECT-EXIST-A(#I) := '0'
EXAMINE #OBJECT-CODES(*) FOR 'MT' GIVING INDEX #I
#OBJECT-EXIST-A(#I) := '0'
EXAMINE #OBJECT-CODES(*) FOR 'MM' GIVING INDEX #I
#OBJECT-EXIST-A(#I) := '0'
/*                                                         /* CF1 ->
#EV-NAME-S := H'00'
#EV-NAME-E := H'FF'
FNEV. FIND NUMBER EM WITH EM-MONITOR-ID = #EVENT-ID-S THRU #EVENT-ID-E
IF *NUMBER(FNEV.) > 0                                /* CF2
  EXAMINE #OBJECT-CODES(*) FOR 'EV' GIVING INDEX #I
  #OBJECT-EXIST-A(#I) := '0'
END-IF
/*                                                         /* CF1 <-
EXAMINE #OBJECT-EXIST FOR ' ' REPLACE '1'
ES-KEY := #OBJECT-EXIST-VALUE
*
END
