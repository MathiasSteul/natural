* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Program     RMUPDSTN
* Function    Update file NRM-MAIL - fill field MA-CURRENT-LOCATION
* Version     3.4
*
* Maintenance:
* uuuuuuu yyyy-mm-dd p(999999) ...
* xsetggr 2012-10-17 ES-104 created
* xsetggr 2013-03-14 ES-104 corrected
* SU1     2014-11-17 NOMALL-1450 fill fields for Adabas Vista
* SU2     2016-01-20 NOMALL-1802 do not update Adabas Vista fields
* ----------------------------------------------------------------------
DEFINE DATA
PARAMETER
1 P-ISN           (P10)
1 P-ERC           (N4)
* *****
LOCAL
1 MA VIEW OF NRM-MAIL
  2 MA-CURRENT-LOCATION
/*SU2 2 MA-OBJECT-TYPE /*SU1
/*SU2 2 MA-OBJECT-TIME /*SU1
1 AR VIEW OF NRM-ACTIVE-REPORTS
  2 AR-CURRENT-LOCATION
  2 AR-REPNAME
  2 AR-REPRNB
1 #MA-REPRNB      (A31)
1 REDEFINE #MA-REPRNB
  2 #MA-REPNAME   (A25)
  2 #MA-RNB       (P11)
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
GET AR P-ISN
#MA-REPNAME := AR-REPNAME
#MA-RNB     := AR-REPRNB
*
FNDMA. FIND MA WITH MA-REP-RNB = #MA-REPRNB
  IF NO RECORDS FOUND
    P-ERC := 5
    ESCAPE BOTTOM (FNDMA.)
  END-NOREC
  GETMA. GET MA *ISN(FNDMA.)
  IF AR-CURRENT-LOCATION = 'A'
    MA-CURRENT-LOCATION := 'A'
  ELSE
    MA-CURRENT-LOCATION := 'B'
  END-IF
/*SU2 MA-OBJECT-TYPE := 'MA' /*SU1
/*SU2 MA-OBJECT-TIME := *TIMX /*SU1
  UPDATE (GETMA.)
END-FIND
* --------------------------------------------------------------------
END
