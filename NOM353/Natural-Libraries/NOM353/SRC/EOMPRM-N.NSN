* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* EOMPRM-N - Maintenance of EOM Object >>> Logical Printer <<<
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* gw  93-05-24 s(999999) created
* mrs 93-11-15 s(999999) old version saved, various modifications
* sju 95-09-27 s(229945) delete function
* gw  96-11-08 s(257242) alllow name to begin with any printable char
* gw  96-02-05 s(261425) set work file to 1 if RECFM 0 'V' or = 'v'
* xsethz  2000-05-30 s(CE7760) READ-NEXT, READ-HOLD-NEXT added
* xsethz  2000-07-27 (CE7461) Extend Report and Bundle Names
* xsetoba 2001-09-28 p(208443)Printer Exit Member selection
* sju 02-12-04 p(231473) Honour steplib settings for printer exit
* sju 03-05-22 p(240729) Restrict usage
* xsetggr 2003-08-08 p(240465) correct CE7553 solution
* sju     2004-04-22 p(250355) correct handling of recfm
* xsetggr 2005-06-30 p(265613) read default user profile for security
*                           check when automatic user definition allowed
* xsetggr 2007-10-05 p(297910) honored default recfm=vba, if recfm = ' '
* xsetggr 2007-10-25 NRT2185   default values for UNIXLP printers
* xsetggr 2008-11-28 P311915   default printers DEFAULTA - DEFAULTZ
* xsetggr 2008-12-20 P300323   use EOM-USER-LIBRARY for exist control
* xsetggr 2009-09-01 P314431   allow NATUNIX printers only on unix
*                             systems, UNIXLP printers only on mainframe
* fhi     2010-09-03 NOMALL-97 Extend message line
* xsetggr 2010-11-03 NOMALL-865 restow due to changes in EOMPHTYE
* fhi     2011-01-11 NOMALL-936 Member name into message 1079
* xsetggr 2011-09-12 NOMALL-1058 use pda EOM----P when call EOMPRMGN
* SU1     2014-06-10 NOMALL-1281 show last update user+date
* ----------------------------------------------------------------------
DEFINE DATA
PARAMETER USING EOM----P
PARAMETER USING EOMPRM-P
PARAMETER USING EOMMSG-P
************************************************************************
LOCAL     USING EOMPRM-E
LOCAL     USING EOM----E
LOCAL     USING EOMGRM-P
LOCAL     USING RLOG-L
LOCAL     USING EOMPHM-P
LOCAL     USING EOMPHTYE
*
LOCAL
1 USERS VIEW OF NRM-USERS
  2 USER-PROFILE
  2 REDEFINE USER-PROFILE
    3 PROF-TYPE (A1)
1 PRINTER VIEW OF NRM-PRINTERS
  2 P-ID
1 #NOF                       (I2) CONST <4>
1 #FUNCTION                  (A1/1:#NOF) INIT <'O','P','M','D'>
1 #SECURITY-OPTION           (A3)
1 ALLOWED                    (L)
1 #I                         (I2)
1 #GRANTS                    (A1/1:6)
1 #USER-ID                   (A8)
1 #FIX-VAR                   (A1)
1 #OBJ-NAME                  (A25)
1 OT                         (I2)
1 OJ                         (I2)
1 #SAVE-EOM-FUNCTION         (I2)
1 #SAVE-USER-TYPE            (A1)
1 #NEXT-PRINTER              (A8)
1 REDEFINE #NEXT-PRINTER
  2 #NEXT-PRINTER-7          (A7)
  2 #NEXT-PRINTER-1          (I1)
1 #ERC                       (N4)
1 #ERT                       (A250)
1 #MEMBER-TYPE               (A8)
1 #J                         (I2)
1 #K                         (I2)
1 #LRECL                     (A5)
1 REDEFINE #LRECL
  2 #LRECL-A1                (A1/5)
1 #LRECL-N                   (N5)
1 #P-ID-E                    (A8)
1 #P-ID                      (A8)  INIT <'DEFAULT'>
1 REDEFINE #P-ID
  2 #P-ID-1                  (A7)
  2 #P-ID-2                  (A1)
1 #PRINTER-TYPE              (A8)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET EOMMSG-PARMS
*
PERFORM SECURITY-CHECK
IF EOMMSG-NR NE 0 OR EOMPRM-EOF = 'X'
  ESCAPE ROUTINE
END-IF
*
PERFORM LOGGING-CHECK
*
IF EOM-FUNCTION NE EOM-SECURITY-CHECK
  EOMPRM-I-CHECK-FUNCTION := EOM-FUNCTION
  PERFORM FUNCTION-SECURITY
  IF EOMMSG-NR NE 0
    ESCAPE ROUTINE
  END-IF
END-IF
*
DECIDE ON FIRST EOM-FUNCTION
  VALUE EOM-SECURITY-CHECK  PERFORM FUNCTION-SECURITY
  VALUE EOM-ADD, EOM-MODIFY PERFORM MODIFY-PRINTER-ATTRIBUTES
  VALUE EOM-DELETE          PERFORM DELETE-PRINTER-DEFINITION
  VALUE EOM-READ, EOM-READHOLD, EOM-READ-NEXT, EOM-READHOLD-NEXT
    PERFORM READ-PRINTER-ATTRIBUTES
  VALUE EOM-COMMIT
    RESET EOM-LOG-FUNCTION EOM-LOG-OBJECT-NAME
    END OF TRANSACTION
  VALUE EOM-BACKOUT
    RESET EOM-LOG-FUNCTION EOM-LOG-OBJECT-NAME
    BACKOUT TRANSACTION
  VALUE EOM-COPY, EOM-RENAME, EOM-INIT
    IGNORE
  NONE VALUE
    EOMMSG-NR := 2600
END-DECIDE
*
IF EOM-LOG AND EOMMSG-NR = 0
  PERFORM WRITE-LOG-RECORD
END-IF
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE SECURITY-CHECK
************************************************************************
IF EOM-OBJTYP NE 'P'
  IF EOM-USER = ' ' AND EOM-USER-TYPE NE 'A'
    EOMMSG-NR := 48
    EOMMSG-FIELD-NAME := 'EOM-USER'
    ESCAPE ROUTINE
  END-IF
  IF EOM-USER-TYPE NE 'A'
    FNDUS. FIND USERS WITH USER-ID = EOM-USER
      IF NO RECORDS FOUND
        IF EOM-DEF-USER NE 'Y'
          EOMMSG-NR := 2
          EOMMSG-TOKEN(1) := EOM-USER
          EOMMSG-FIELD-NAME := 'EOM-USER'
          ESCAPE ROUTINE
        ELSE
          FIND USERS WITH USER-ID = 'DEFAULT'
            EOM-USER-PROFILE := USER-PROFILE
            EOM-USER-TYPE := PROF-TYPE
          END-FIND
          ESCAPE BOTTOM(FNDUS.)
        END-IF
      END-NOREC
      EOM-USER-PROFILE := USER-PROFILE
      EOM-USER-TYPE := PROF-TYPE
    END-FIND
  END-IF
  EOM-OBJTYP := 'P'
  RESET  EOM-OBJECT-NAME
  IF EOM-USER-TYPE = 'A'
    EOM-OBJTYP-SECURITY (*) := 'Y'
  ELSE
    EOM-OBJTYP-SECURITY (*) := 'N'
    FOR #I = 2 TO 4
      COMPRESS #FUNCTION (#I) 'PR' TO #SECURITY-OPTION LEAVING NO
      RESET ALLOWED
      CALLNAT 'NARPSEC' EOM-USER-PROFILE #SECURITY-OPTION ALLOWED  /*SEC
      IF ALLOWED
        EOM-OBJTYP-SECURITY (#I:6) := 'Y'
        ESCAPE BOTTOM
      END-IF
    END-FOR
  END-IF
END-IF
*
IF NOT (EOM-OBJTYP-SECURITY (*) = 'Y')
  EOMMSG-NR := 0020
  ESCAPE ROUTINE
END-IF
*
IF EOM-FUNCTION = EOM-INIT OR = EOM-ADD
  EOM-OBJECT-NAME := EOMPRM-I-NAME
  EOM-OBJECT-SECURITY (*) := EOM-OBJTYP-SECURITY (*)
  IF EOM-OBJTYP-SECURITY (2) = 'Y' OR EOM-OBJTYP-SECURITY (3) = 'Y'
    EOM-OBJECT-SECURITY (1) := 'Y'
  ELSE
    EOM-OBJECT-SECURITY (1) := 'N'
  END-IF
END-IF
*
RESET EOMPRM-EOF
IF EOM-FUNCTION = EOM-READ-NEXT OR = EOM-READHOLD-NEXT
  IF EOM-FUNCTION=EOM-READ-NEXT AND NOT (EOM-OBJTYP-SECURITY(1:4)='Y')
  OR EOM-FUNCTION=EOM-READHOLD-NEXT                                   /*
  AND NOT(EOM-OBJTYP-SECURITY(1:3)='Y')                               /*
    EOMMSG-NR := 0020
    ESCAPE ROUTINE
  END-IF
  RESET EOM-OBJECT-NAME EOMPRM-EOF
  EOMPRM-EOF := 'X'
  #NEXT-PRINTER := EOMPRM-I-NAME
  ADD 1 TO #NEXT-PRINTER-1
  READ PRINTER WITH P-ID = #NEXT-PRINTER
    IF EOM-USER-TYPE = 'A'
      EOM-OBJECT-SECURITY (*) := 'Y'
      RESET EOMPRM-EOF
    ELSE
      #USER-ID := EOM-USER
      #OBJ-NAME := P-ID
      CALLNAT 'RGRANT-N'  /*  GET USER ACCESS LEVEL ON AN OBJECT
        #USER-ID EOM-OBJTYP #OBJ-NAME ALLOWED #GRANTS (*)
      IF ALLOWED AND
          (EOM-FUNCTION = EOM-READ-NEXT AND #GRANTS(1:4) = 'Y' OR
          EOM-FUNCTION = EOM-READHOLD-NEXT AND #GRANTS(1:3) = 'Y')
        EOM-OBJECT-SECURITY (1)          := #GRANTS (1)     /* owner
        EOM-OBJECT-SECURITY (2)          := #GRANTS (3)     /* purge
        EOM-OBJECT-SECURITY (3)          := #GRANTS (2)     /* modify
        EOM-OBJECT-SECURITY (4:6) := #GRANTS (4:6)          /* display
        RESET EOMPRM-EOF
      END-IF
    END-IF
    IF EOMPRM-EOF = ' '
      EOM-OBJECT-NAME := EOMPRM-I-NAME := P-ID
      ESCAPE BOTTOM
    END-IF
  END-READ
END-IF
IF EOM-OBJECT-NAME NE EOMPRM-I-NAME AND EOMPRM-EOF = ' '
  EOM-OBJECT-NAME := EOMPRM-I-NAME
  IF EOM-USER-TYPE = 'A'
    EOM-OBJECT-SECURITY (*) := 'Y'
  ELSE
    EOM-OBJECT-SECURITY (*) := 'N'
    #USER-ID := EOM-USER
    #OBJ-NAME := EOMPRM-I-NAME
    CALLNAT 'RGRANT-N'   /*  GET USER ACCESS LEVEL ON AN OBJECT
      #USER-ID EOM-OBJTYP #OBJ-NAME ALLOWED #GRANTS (*)
    EOM-OBJECT-SECURITY (1)   := #GRANTS (1)     /* owner
    EOM-OBJECT-SECURITY (2)   := #GRANTS (3)     /* purge
    EOM-OBJECT-SECURITY (3)   := #GRANTS (2)     /* modify
    EOM-OBJECT-SECURITY (4:6) := #GRANTS (4:6)   /* display ...
  END-IF
END-IF
*
IF NOT (EOM-OBJECT-SECURITY (*) = 'Y') AND EOMPRM-EOF = ' '
  EOMMSG-NR := 0020
END-IF
*
END-SUBROUTINE /* SECURITY-CHECK
*
************************************************************************
DEFINE SUBROUTINE FUNCTION-SECURITY
************************************************************************
EXAMINE EOM-OBJECT-SECURITY (*) FOR 'Y' GIVING INDEX IN OJ
EXAMINE EOM-OBJTYP-SECURITY (*) FOR 'Y' GIVING INDEX IN OT
*
DECIDE ON FIRST EOM-FUNCTION
  VALUE EOM-SECURITY-CHECK, EOM-COMMIT, EOM-BACKOUT
    IGNORE
  VALUE EOM-ADD, EOM-READHOLD, EOM-READHOLD-NEXT, EOM-MODIFY, EOM-INIT,
      EOM-COPY, EOM-RENAME
    IF OJ > 3 OR OT > 3
      EOMMSG-NR := 0020
    END-IF
  VALUE EOM-READ, EOM-READ-NEXT
    IF OJ > 4 OR OT > 4
      EOMMSG-NR := 0020
    END-IF
  VALUE EOM-DELETE
    IF OJ > 2 OR OT > 2
      EOMMSG-NR := 0020
    END-IF
  NONE VALUE
    EOMMSG-NR := 2600
END-DECIDE
*
END-SUBROUTINE /* FUNCTION-SECURITY
*
************************************************************************
DEFINE SUBROUTINE LOGGING-CHECK
************************************************************************
IF EOM-LOG-OBJTYP = 'P'
  ESCAPE ROUTINE
END-IF
RESET  EOM-LOGGING
EOM-LOG-OBJTYP := 'P'
IF EOM-LOG-TYPES (*) = 'P'
  EOM-LOG := TRUE
END-IF
*
END-SUBROUTINE /* LOGGING-CHECK
*
************************************************************************
DEFINE SUBROUTINE WRITE-LOG-RECORD
************************************************************************
IF EOM-LOG-FUNCTION = EOM-FUNCTION AND EOM-LOG-OBJECT-NAME=EOMPRM-I-NAME
  ESCAPE ROUTINE
END-IF
*
DECIDE ON FIRST EOM-FUNCTION
  VALUE EOM-ADD
    COMPRESS '2510' EOMPRM-I-NAME TO LG-MSG
    EOM-LOG-FUNCTION := EOM-FUNCTION
    RESET  EOM-LOG-OBJECT-NAME
  VALUE EOM-MODIFY
    COMPRESS '2511' EOMPRM-I-NAME TO LG-MSG
    EOM-LOG-FUNCTION    := EOM-FUNCTION
    EOM-LOG-OBJECT-NAME := EOMPRM-I-NAME
  VALUE EOM-DELETE
    COMPRESS '2512' EOMPRM-I-NAME TO LG-MSG
    EOM-LOG-FUNCTION := EOM-FUNCTION
    RESET  EOM-LOG-OBJECT-NAME
  VALUE EOM-RENAME
    COMPRESS '2513' EOMPRM-I-NAME EOMPRM-I-NEWNAME TO LG-MSG
    EOM-LOG-FUNCTION := EOM-FUNCTION
    RESET  EOM-LOG-OBJECT-NAME
  VALUE EOM-COPY
    COMPRESS '2514' EOMPRM-I-NAME EOMPRM-I-NEWNAME TO LG-MSG
    EOM-LOG-FUNCTION := EOM-FUNCTION
    RESET  EOM-LOG-OBJECT-NAME
  ANY VALUE
    IF EOM-USER = MASK ('NOMPR'NN'N')
      LG-USERID := *USER
    ELSE
      LG-USERID := EOM-USER
    END-IF
    LG-CODE        := 'PM'
    LG-OBJECT-NAME := EOMPRM-I-NAME
    CALLNAT 'RLOG' PL-PARMS   /* Write a record to the log
  NONE VALUE IGNORE
END-DECIDE
*
END-SUBROUTINE /* WRITE-LOG-RECORD
*
************************************************************************
DEFINE SUBROUTINE READ-PRINTER-ATTRIBUTES
************************************************************************
PERFORM VALIDATE-KEY
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
PERFORM PRINTER-ATTRIBUTE-INTERFACE
*
END-SUBROUTINE
*
************************************************************************
DEFINE SUBROUTINE MODIFY-PRINTER-ATTRIBUTES
************************************************************************
PERFORM VALIDATION
IF EOMMSG-NR NE 0 AND EOMMSG-NR NE 1079
  ESCAPE ROUTINE
END-IF
PERFORM PRINTER-ATTRIBUTE-INTERFACE
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
IF EOM-FUNCTION = EOM-ADD
  IF EOM-USER NE MASK ('NOMPR'NN'N')
    EOMGRM-I-NAME := EOMPRM-I-NAME
    EOMGRM-I-TYPE := 'P'
    EOMGRM-I-USER := EOM-USER
    EOMGRM-I-DEF-USER := EOM-DEF-USER
    EOMGRM-OPTION (*) := 'Y'
    CALLNAT 'EOMGRM-N' EOM-ADD EOMGRM-PARMS EOMMSG-PARMS /*Mnt Grant
    IF EOMMSG-NR NE 0
      ESCAPE ROUTINE
    END-IF
  END-IF
  EOMGRM-I-NAME := EOMPRM-I-NAME
  EOMGRM-I-TYPE := 'P'
  EOMGRM-I-USER := 'PUBLIC'
  IF EOM-USER = MASK ('NOMPR'NN'N')
    EOMGRM-OPTION (*) := 'Y'
  ELSE
    EOMGRM-OPTION (1:3) := 'N'
    EOMGRM-OPTION (4)   := 'Y'
    EOMGRM-OPTION (5:6) := 'N'
  END-IF
  CALLNAT 'EOMGRM-N' EOM-ADD EOMGRM-PARMS EOMMSG-PARMS /*Mnt Grant
END-IF
*
END-SUBROUTINE /* MODIFY-PRINTER-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE VALIDATION
************************************************************************
DECIDE ON FIRST EOMPRM-I-ATTRIBUTE-TYPE
  VALUE PRINTER-GENERAL-ATTRIBUTES
    PERFORM VALIDATE-GENERAL-ATTRIBUTES
  VALUE PRINTER-SPECIAL-ATTRIBUTES
    PERFORM VALIDATE-SPECIAL-ATTRIBUTES
  NONE  IGNORE
END-DECIDE
*
END-SUBROUTINE /* VALIDATION
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-KEY
************************************************************************
IF EOMPRM-I-NAME = ' '
  EOMMSG-NR := 0106
  ESCAPE ROUTINE
END-IF
MOVE LEFT JUSTIFIED EOMPRM-I-NAME TO EOMPRM-I-NAME
*
IF EOMPRM-I-NAME NE MASK (P.......)
  EOMMSG-NR := 0019
  ESCAPE ROUTINE
END-IF
*
END-SUBROUTINE /* VALIDATE-KEY
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-GENERAL-ATTRIBUTES
************************************************************************
PERFORM VALIDATE-KEY
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
IF EOM-FUNCTION = EOM-ADD
  #P-ID-2 := 'Z'
  #P-ID-E := #P-ID
  #P-ID-2 := 'A'
  IF EOMPRM-I-NAME = #P-ID THRU #P-ID-E
    EOMMSG-NR := 0166
    ESCAPE ROUTINE
  END-IF
END-IF
IF EOMPRM-PHYSICAL-NAME = ' '
  EOMMSG-NR := 0105
  EOMMSG-FIELD-NAME := 'EOMPRM-PHYSICAL-NAME'
  ESCAPE ROUTINE
END-IF
PERFORM READ-PHYSICAL-PRINTER
IF EOMMSG-NR NE 0
  IF EOMMSG-NR = 119
    EOMMSG-NR := 0108
    EOMMSG-FIELD-NAME := 'EOMPRM-PHYSICAL-NAME'
  END-IF
  ESCAPE ROUTINE
END-IF
IF *MACHINE-CLASS = 'MAINFRAME'
  IF #PRINTER-TYPE = ##PHYS-NATUNIX
    EOMMSG-NR := 0130
    EOMMSG-FIELD-NAME := 'EOMPRM-PHYSICAL-NAME'
    ESCAPE ROUTINE
  END-IF
ELSE
  IF NOT (#PRINTER-TYPE = ##PHYS-NATUNIX OR = ##PHYS-DISKUNIX)
    EOMMSG-NR := 0131
    EOMMSG-FIELD-NAME := 'EOMPRM-PHYSICAL-NAME'
    ESCAPE ROUTINE
  END-IF
END-IF
*
IF EOMPRM-EXITMEM NE ' ' OR EOMPRM-EXITLIB NE ' '
  IF EOMPRM-EXITLIB = ' '
    EOMPRM-EXITLIB := EOM-USER-LIBRARY
  END-IF
  #MEMBER-TYPE:= 'PRTEXIT '
  CALLNAT 'N-LISMEM' EOMPRM-EXITLIB EOMPRM-EXITMEM #MEMBER-TYPE #ERC #ERT
  IF #ERC NE 0
    IF #ERC = 1070
      RESET EOMPRM-EXITLIB EOMPRM-EXITMEM
    ELSE
      EOMMSG-FIELD-NAME := 'EOMPRM-EXITMEM'
      EOMMSG-NR := 1079
      EOMMSG-TEXT := EOMPRM-EXITMEM /* NOMALL-936 in
    END-IF
  END-IF
END-IF
IF NOT EOMPRM-RESTRICTED = ' ' OR = 'Y' OR = 'N'
  EOMMSG-FIELD-NAME := 'EOMPRM-RESTRICTED'
  EOMMSG-NR := 1099
END-IF
*
END-SUBROUTINE /* VALIDATE-GENERAL-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-SPECIAL-ATTRIBUTES
************************************************************************
PERFORM READ-PHYSICAL-PRINTER
* Check Special Printer Attributes:
CALLNAT 'EOMPHATN' EOMPHM-PRINTER-TYPE EOMPHM-ATTRIBUTES-OCC-MAX
  EOMPRM-ATTRIBUTES (*) EOMMSG-PARMS
*
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
*
FOR #I 1 25
  IF EOMPRM-ATTR-VAR (#I) = ' '
    ESCAPE TOP
  END-IF
  IF EOMPRM-ATTR-VAR     (#I) = 'DCB1' OR = 'DCB2'
    EXAMINE EOMPRM-ATTR-VALUE(#I) FOR 'RECFM' GIVING POSITION IN #J
    IF #J GT 0
      #J:= #J + 6
      MOVE SUBSTRING (EOMPRM-ATTR-VALUE(#I),#J,1) TO #FIX-VAR
    END-IF
  END-IF
  IF EOMPRM-ATTR-VAR (#I) = 'RECFM' AND EOMPRM-ATTR-VALUE(#I) NE ' '
    #FIX-VAR := EOMPRM-ATTR-VALUE (#I)
  END-IF
  IF EOMPRM-ATTR-VAR     (#I) = 'WKF'
    IF #FIX-VAR = 'V' OR = 'v' OR = ' '
      EOMPRM-ATTR-VALUE (#I) := '01'
    ELSE
      EOMPRM-ATTR-VALUE (#I) := '02'
    END-IF
  END-IF
END-FOR
IF NOT #FIX-VAR = 'V' OR = 'v' OR = ' '
  EXAMINE EOMPRM-ATTR-VAR(*) FOR 'LRECL' GIVING INDEX IN #I
  IF #I GT 0
    #LRECL:= EOMPRM-ATTR-VALUE(#I)
  END-IF
  IF #LRECL = ' '
    EXAMINE EOMPRM-ATTR-VAR(*) FOR 'DCB1' GIVING INDEX IN #I
    IF #I GT 0
      EXAMINE EOMPRM-ATTR-VALUE(#I) FOR 'LRECL=' GIVING POSITION IN #J
      IF #J GT 0
        #J:= #J + 6
        #K:= 73 - #J
        IF #K GT 5
          #K:= 5
        END-IF
        MOVE SUBSTRING (EOMPRM-ATTR-VALUE(#I), #J, #K) TO #LRECL
        FOR #K = 1 TO 5
          IF NOT #LRECL-A1(#K) IS (N1)
            RESET #LRECL-A1(#K)
          END-IF
        END-FOR
      END-IF
    END-IF
    IF #LRECL = ' '
      EXAMINE EOMPRM-ATTR-VAR(*) FOR 'DCB2' GIVING INDEX IN #I
      IF #I GT 0
        EXAMINE EOMPRM-ATTR-VALUE(#I) FOR 'LRECL=' GIVING POSITION IN #J
        IF #J GT 0
          #J:= #J + 6
          #K:= 73 - #J
          IF #K GT 5
            #K:= 5
          END-IF
          MOVE SUBSTRING (EOMPRM-ATTR-VALUE(#I), #J, #K) TO #LRECL
          FOR #K = 1 TO 5
            IF NOT #LRECL-A1(#K) IS (N1)
              RESET #LRECL-A1(#K)
            END-IF
          END-FOR
        END-IF
      END-IF
    END-IF
  END-IF
  IF #LRECL NE ' ' AND #LRECL IS (N5)
    #LRECL-N:= VAL(#LRECL)
    IF #LRECL-N GT 0 AND #LRECL-N LT 251
      EOMMSG-NR:= 0107
    END-IF
  END-IF
END-IF
*
END-SUBROUTINE /* VALIDATE-SPECIAL-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE DELETE-PRINTER-DEFINITION
************************************************************************
IF NOT(EOM-OBJTYP-SECURITY (1) = 'Y' OR EOM-OBJTYP-SECURITY (2) = 'Y')
  OR NOT(EOM-OBJECT-SECURITY (1) = 'Y' OR EOM-OBJECT-SECURITY (2) = 'Y')
  EOMMSG-NR := 0020
  ESCAPE ROUTINE
END-IF
/* DB Interface EOM Object Logical Printer <general attributes>:
CALLNAT 'EOMPRMGN' EOM-PARMS EOMPRM-PARMS EOMMSG-PARMS
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
EOMGRM-I-NAME := EOMPRM-I-NAME
EOMGRM-I-TYPE := 'P'
RESET   EOMGRM-I-USER EOMGRM-I-AUTO-COMMIT
CALLNAT 'EOMGRM-N' EOM-DELETE-ALL EOMGRM-PARMS EOMMSG-PARMS  /*Mnt Grant
*
END-SUBROUTINE /* DELETE-PRINTER-DEFINITION
*
************************************************************************
DEFINE SUBROUTINE PRINTER-ATTRIBUTE-INTERFACE
************************************************************************
IF EOMPRM-I-ATTRIBUTE-TYPE = PRINTER-GENERAL-ATTRIBUTES
    OR= PRINTER-SPECIAL-ATTRIBUTES
  /* DB Interface EOM Object Logical Printer <general attributes>:
  CALLNAT 'EOMPRMGN' EOM-PARMS EOMPRM-PARMS EOMMSG-PARMS
END-IF
*
END-SUBROUTINE /* PRINTER-ATTRIBUTE-INTERFACE
*
************************************************************************
DEFINE SUBROUTINE READ-PHYSICAL-PRINTER
************************************************************************
RESET #PRINTER-TYPE
#SAVE-EOM-FUNCTION      := EOM-FUNCTION
EOM-FUNCTION            := EOM-READ
#SAVE-USER-TYPE         := EOM-USER-TYPE
EOM-USER-TYPE           := 'A'
EOMPHM-I-TARGET-DBID    := EOMPRM-I-TARGET-DBID
EOMPHM-I-TARGET-FNR     := EOMPRM-I-TARGET-FNR
EOMPHM-I-ID             := EOMPRM-PHYSICAL-NAME
EOMPHM-I-ATTRIBUTE-TYPE := PRINTER-GENERAL-ATTRIBUTES
*
CALLNAT 'EOMPHM-N' EOM-PARMS EOMPHM-PARMS EOMMSG-PARMS /*Mnt Ph. Pr
#PRINTER-TYPE := EOMPHM-PRINTER-TYPE
EOM-FUNCTION  := #SAVE-EOM-FUNCTION
EOM-USER-TYPE := #SAVE-USER-TYPE
*
END-SUBROUTINE /* READ-PHYSICAL-PRINTER
*
END
