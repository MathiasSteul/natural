* MAP2: MAP PROFILES *****************************        410***********
* .TTAAAMMOO   D I D I N D I D I        ?_)^&:+(                       *
* 019055        N0 NUCN             X        01 SYSPROF NLH          1 *
************************************************************************
INPUT          (     IP=OFF                                           /*
                                                                       )
 021T 'AutoCommit Flag'(I)
/
/
 001T 'When adding or updating objects the physical update'
/
 001T 'may be performed at different stages.'
/
 001T 'The update may be performed implicitly immediately'
/
 001T 'after any modification has been done.'
/
 001T 'In such cases you will not be able to backout the'
/
 001T 'modifications by the undo function key (PF6).'
/
/
 001T 'Or the update may be perfomed explicitly. Either'
/
 001T 'by pressing the PF5(do) key while in a screen , or'
/
 001T 'when leaving a screen with any pending modifications.'
/
 001T 'When leaving a screen you''ll be prompted to confirm'
/
 001T 'update of pending modifications.'
/
/
 007T 'E.'(I)
 010T 'Explicit commit(PF5 or prompt)'
/
 007T 'I.'(I)
 010T 'Implicit commit(automatic)'
/
/
 023T 'Select'(I)
 030T '=>'
 033T #CODE  (AD=MDLT'_' ) /*.99U001 A001 .
* MAP2: VALIDATION *****************************************************
RULEVAR F00#CODE
INCDIC                                 ;
IF NOT (& = 'I' OR = 'E')
REINPUT 'ENTER ''I'' OR ''E'''
ALARM
END-IF
SET CONTROL 'Q'
* MAP2: END OF MAP *****************************************************
END
