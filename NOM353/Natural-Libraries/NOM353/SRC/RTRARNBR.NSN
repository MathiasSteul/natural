* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
*  RTRARNBR   trace - define a report-number for trace-processing
*
* MRS     1991-06-18 created
* xsetggr 2007-09-04 NOM3201 Support P11 format run numbers
* SU1     2021-07-26 NOMALL-2480 restruct
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 P-RNB  (P11)
************************************************************************
LOCAL
1 CONTROL-RECORD VIEW OF NRM-REPORTS-NEW
  2 R-REPNAME
  2 R-LASTRNB
  2 R-IDENT-WRITER
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
FNDC. FIND CONTROL-RECORD WITH R-REPNAME = 'NOM-CONTROL-REC'
  IF NO RECORDS FOUND
    CONTROL-RECORD.R-LASTRNB := 10000
    CONTROL-RECORD.R-REPNAME := 'NOM-CONTROL-REC'
    CONTROL-RECORD.R-IDENT-WRITER := 'DUMMY'
    STORE CONTROL-RECORD
    ESCAPE BOTTOM
  END-NOREC
  ADD 1 TO R-LASTRNB
  P-RNB := R-LASTRNB
  UPDATE (FNDC.)
END-FIND
END OF TRANSACTION
*
END
