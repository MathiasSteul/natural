* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    RDEFUSR
* Version   1.3
* Function  Define NOM User-Interface Defaults
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* gw  94-11-25 s(999999) created
* jvd 98-09-10 p(164220) NOM141ÖNAT23
* gw  98-10-27 s(999999) reinput cursor position
* wcd 00-04-01 CE 7267   New PFkey for additional printers in RPFK---L
* fhi 02-10-30 fhi101    switch on optimizer compiler
* xsetggr 2005-10-26 p(270950) ISN fields must be P10, not P8
* fhi     2010-09-03 NOMALL-97 Extend message line
* Splildav   2011-02-17 NOMALL-31 Ask user for interface number
* SU1     2016-08-01 NOMALL-1518 NOM3.5 deactivate opt.Compiler
* SU2     2020-11-10 NOMALL-2440 split DDM -> NRM-MF-NODES
* ----------------------------------------------------------------------
*
DEFINE DATA GLOBAL USING NRM-GL
LOCAL USING RPFK---L
LOCAL USING RDEFUSRL
LOCAL
1 #FILE-PROMPT       (A19)
1 #FILE-OFFSET       (N3)
1 #FILE-LENGTH       (N3)
1 #ALLOWED           (L)
1 #FATHER-PROG       (A8) INIT <'RDFMEN'>
1 CV-MAP             (C) INIT < (AD=I CD=NE)>
1 #ISN               (N10)
1 L-HEADER           (A78)
1 #FUNC              (A1)
1 #LANGUAGE          (I1)
1 #MARK              (I4)
1 #MARK-IDENT        (I4) CONST <6>
1 #PANEL             (I2)
1 #PANEL-IDENT       (I2) INIT <0001>
1 #PANEL-ATTR        (I2) INIT <0002>
1 #I                 (I4)
1 #J                 (I4)
1 #J1                (N3)
1 #INTERFACE-ID      (A9)
1 #INTMSG            (A10)
1 #EXIT (L)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
DEFINE WINDOW DAVE SIZE 23 *40 TITLE #INTMSG
*
RESET G-COMMIT G-LINECOM(*)
#PANEL := #PANEL-IDENT
IF *DATA = 1
  INPUT NRM-MONITOR.M-MONITOR-ID
ELSE
  PERFORM ADD-INTERFACE
END-IF
*
#FUNC := G-C-FUNC
IF #EXIT
  ESCAPE MODULE
END-IF
MAIN-LOOP. REPEAT
  FIND-LOOP. FIND NRM-MONITOR WITH M-MONITOR-ID=NRM-MONITOR.M-MONITOR-ID
    IF NO RECORDS FOUND
      ESCAPE BOTTOM (MAIN-LOOP.)
    END-NOREC
*
    #NOMUSR-TYPE (1:4)  := 'P'  /* Primary selection
    #NOMUSR-TYPE (5)    := 'S'  /* Secondary Selection
    #NOMUSR-TYPE (6:20) := 'A'  /* Attributes
    #FILE-PROMPT := #NOMUSR-PROMPT (5)
    #FILE-OFFSET := #NOMUSR-OFFSET (5)
    #FILE-LENGTH := #NOMUSR-LENGTH (5)
    #ISN := *ISN
    DECIDE ON FIRST VALUE OF #FUNC
      VALUE 'M' , ' ' , 'A'
        CALLNAT 'NARPSEC' G-USER-PROFILE 'MMO' #ALLOWED
        INCLUDE C-NALLOW
        GETREC. GET NRM-MONITOR #ISN
      VALUE 'D'
        CALLNAT 'NARPSEC' G-USER-PROFILE 'DMO' #ALLOWED
        INCLUDE C-NALLOW
        CV-MAP := (AD=IP)
      NONE VALUE
        IGNORE
    END-DECIDE
*
    SCREEN-LOOP. REPEAT
      IF #LANGUAGE NE *LANGUAGE
        PERFORM INIT-PFKEYS
        PERFORM SET-PFKEYS
        #LANGUAGE := *LANGUAGE
      END-IF
*
      PERFORM FLIP-DISPLAY
      CALLNAT 'N-HEADER' L-HEADER G-DATE-FORMAT 'DUMMY   '
      PERFORM BEFORE-INPUT
*
      DECIDE ON FIRST VALUE #PANEL
        VALUE #PANEL-IDENT
          INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
            MARK *G-DIRECT-COMMAND USING MAP 'RDEFUSR&'
        VALUE #PANEL-ATTR
          INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
            MARK *G-DIRECT-COMMAND USING MAP 'RDEFUSA&'
        NONE IGNORE
      END-DECIDE
*
      PERFORM AFTER-INPUT
      RESET G-NATRP-ERC G-NATRP-ERT
*
      INCLUDE RPFKVA-C
      INCLUDE C-DIRECT
      INCLUDE RPFKED-C
*
      IF CV-MAP MODIFIED OR G-MAP-MODIFIED
        PERFORM VALIDATE-INPUT
        #NOMUSR-TYPE   (5) := 'S'
        #NOMUSR-PROMPT (5) := #FILE-PROMPT
        #NOMUSR-OFFSET (5) := #FILE-OFFSET
        #NOMUSR-LENGTH (5) := #FILE-LENGTH
        UPDATE(GETREC.)
        G-NATRP-ERC := 0032
        INCLUDE C-COMMIT
      END-IF
      INCLUDE REXDO--C
*
      DECIDE ON FIRST VALUE G-PF-FUNC
        VALUE ##PFK-ATTRIBUTES
          #PANEL := #PANEL-ATTR
          RESET #LANGUAGE
        VALUE ##PFK-IDENT
          #PANEL := #PANEL-IDENT
          RESET #LANGUAGE
        NONE IGNORE
      END-DECIDE
*
    END-REPEAT
  END-FIND
END-REPEAT
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE ADD-INTERFACE
************************************************************************
RESET NRM-MONITOR
#J := 99
READ NRM-MONITOR BY M-MONITOR-ID = 'NOMUSR100'
  IF M-MONITOR-ID NE MASK ('NOMUSR')
    ESCAPE BOTTOM
  END-IF
  #I := #NOMUSR-INTERFACE - #J
  IF #I > 1
    #NOMUSR-INTERFACE := #J
    ESCAPE BOTTOM
  END-IF
  #J := #NOMUSR-INTERFACE
END-READ
*
ADD 1 TO #J
*
#J1 := #J
SET WINDOW 'DAVE'
SET KEY PF3 PF15
#INTMSG := 'Enter number'
INPUT 'Interface number to add' (I) #J1 (AD=M) ///
  'PF3  = Exit' (I)
IF *PF-KEY = 'PF3' OR = 'PF15'
  #EXIT := TRUE
  ESCAPE BOTTOM
END-IF
IF #J NE #J1           /* User changed interface number
  #J := #J1
  /* Check if interface number exists
  COMPRESS 'NOMUSR' #J1 TO #INTERFACE-ID LEAVING NO
  FIND NRM-MONITOR WITH M-MONITOR-ID = #INTERFACE-ID
    IF NO RECORD FOUND
      ESCAPE BOTTOM
    END-NOREC
    RESET #J
    #INTMSG := 'Interface number already exists'
    REINPUT  'Interface number already exists'  (AD=I)
  END-FIND
END-IF
SET WINDOW OFF
RESET NRM-MONITOR
NRM-MONITOR.M-MONITOR-ID        := 'NOMUSR'
NRM-MONITOR.#NOMUSR-INTERFACE   := #J
NRM-MONITOR.#NOMUSR-TYPE (1:4)  := 'P'
NRM-MONITOR.#NOMUSR-TYPE (5)    := 'S'
NRM-MONITOR.#NOMUSR-TYPE (6:20) := 'A'
COMPRESS 'NOM User-Spool Interface' #NOMUSR-INTERFACE TO NRM-MONITOR.M-VERSION
STORE NRM-MONITOR /*NOMUSR
END TRANSACTION
*
END-SUBROUTINE /* ADD-INTERFACE
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-INPUT
************************************************************************
IF NOT M-TIME-SCHEDULE = 'Y' OR = 'N'
  REINPUT *1099 MARK *M-TIME-SCHEDULE ALARM
END-IF
*
DECIDE FOR FIRST CONDITION
  WHEN M-VERSION = ' '
    REINPUT *9209 MARK *M-VERSION
  WHEN M-NATRPT-DBID-N5 = 0
    REINPUT *9207 MARK *M-NATRPT-DBID-N5
  WHEN M-NATRPT-FNR-N5  = 0
    REINPUT *9208 MARK *M-NATRPT-FNR-N5
  WHEN NOT #NOMUSR-PROMPT (1:4) NE ' '
    REINPUT *9201 MARK #MARK-IDENT
  WHEN NONE
    IGNORE
END-DECIDE
*
FOR #I 1 4
  IF #NOMUSR-PROMPT  (#I) NE ' ' OR #NOMUSR-OFFSET  (#I) NE 0   OR
      #NOMUSR-LENGTH  (#I) NE 0   OR #NOMUSR-ORDER   (#I) NE 0   OR
      #NOMUSR-GENERIC (#I) NE ' '
*
    DECIDE FOR FIRST CONDITION
      WHEN #NOMUSR-PROMPT (#I) = ' '
        #MARK := (#I - 1) * 5 + #MARK-IDENT
        REINPUT *9201 MARK #MARK
      WHEN #NOMUSR-PROMPT (#I) NE MASK (NNNN)
        #MARK := (#I - 1) * 5 + #MARK-IDENT
        REINPUT *9202 MARK #MARK
      WHEN #NOMUSR-OFFSET (#I) = 0
        #MARK := (#I - 1) * 5 + #MARK-IDENT + 1
        REINPUT *9203 MARK #MARK
      WHEN #NOMUSR-LENGTH (#I) = 0
        #MARK := (#I - 1) * 5 + #MARK-IDENT + 2
        REINPUT *9204 MARK #MARK
      WHEN #NOMUSR-LENGTH (#I) > 8
        #MARK := (#I - 1) * 5 + #MARK-IDENT + 2
        REINPUT *9210 MARK #MARK
      WHEN NOT #NOMUSR-ORDER (#I) = 1 THRU 4
        #MARK := (#I - 1) * 5 + #MARK-IDENT + 3
        REINPUT *9205 MARK #MARK
      WHEN NOT #NOMUSR-GENERIC (#I) = 'Y' OR = 'N'
        #MARK := (#I - 1) * 5 + #MARK-IDENT + 4
        REINPUT *9206 MARK #MARK
      WHEN NONE
        IGNORE
    END-DECIDE
  END-IF
END-FOR
*
DECIDE FOR FIRST CONDITION
  WHEN #FILE-PROMPT = ' '
    REINPUT *9201 MARK *#FILE-PROMPT
  WHEN #FILE-OFFSET = 0
    REINPUT *9203 MARK *#FILE-OFFSET
  WHEN #FILE-LENGTH = 0
    REINPUT *9204 MARK *#FILE-LENGTH
  WHEN NONE
    IGNORE
END-DECIDE
*
END-SUBROUTINE /* VALIDATE-INPUT
*
************************************************************************
DEFINE SUBROUTINE BEFORE-INPUT
************************************************************************
ESCAPE ROUTINE
*
END-SUBROUTINE /* BEFORE-INPUT
*
************************************************************************
DEFINE SUBROUTINE AFTER-INPUT
************************************************************************
ESCAPE ROUTINE
*
END-SUBROUTINE /* AFTER-INPUT
*
************************************************************************
DEFINE SUBROUTINE INIT-PFKEYS
************************************************************************
RESET G-PF
*
INCLUDE RPFSTD-C
INCLUDE RPFCOM-C
DECIDE ON FIRST VALUE #PANEL
  VALUE #PANEL-IDENT
    INCLUDE RPFATT-C
  VALUE #PANEL-ATTR
    INCLUDE RPFIDN-C
  NONE  IGNORE
END-DECIDE
*
CALLNAT 'RPFINI-N' G-PF G-PFB
*
END-SUBROUTINE /* INIT-PFKEYS
*
INCLUDE RPFSET-C /*SUBROUTINE SET-PFKEYS
*
END
