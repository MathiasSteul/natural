* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
************************************************************************
* Member    N-HEAD2
* Version   3.4.3
* Function  generate string for 'last modified from/at'(left justified):
*   <i>Modified by<i> SU, 2014-03-26 14:22
*   <i>Geaendert von<i>SU, 2014-03-05 10:06
*   Usage: INPUT (AD=O) #MOD-OUT (AD=I DY=<D#) /*<i> means intensified
*
* Maintenance
* uuuuuuu yyyy-mm-dd Issue
* SU      2014-03-04 NOMALL-1281 created
* SU1     2014-03-31 avoid display if version LE 342
* SU2     2014-06-02 avoid error, if date is invalid
* SU3     2018-12-19 version check removed
************************************************************************
*
DEFINE DATA PARAMETER
1 #MOD-USER          (A16)  BY VALUE RESULT /*in
1 REDEFINE #MOD-USER
  2 #MOD-USER_A8     (A8)
1 #MOD-DATE          (T)   /*in
1 REDEFINE #MOD-DATE
  2 #MOD-DATE_P13    (P13) /*SU2
1 #MOD-OUT           (A40) BY VALUE RESULT /*out
1 DATE-FORMAT        (A1)
* *****
/*SU3 LOCAL USING NOMVI-2A /*SU1
LOCAL
1 #A_A10             (A10)
1 #A_A8              (A8)
1 #D-ON              (A1) CONST <H'01'> /*dark on
/*SU3 1 #D-OFF             (A1) CONST <H'02'> /*dark off
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET #MOD-OUT
/*SU3-> CALLNAT 'NOMVI-2N' NOMVI /*SU1 ->
/* IF (NOMVI-VERSION = 3 AND NOMVI-RELEASE = 4 AND NOMVI-SP LE 2)
/* OR (NOMVI-VERSION =3 AND NOMVI-RELEASE < 4) OR (NOMVI-VERSION < 3)
/*SU3<-  ESCAPE ROUTINE /*SU1 <- END-IF
IF #MOD-DATE_P13 NE MASK(NNNNNNNNNNNNZ) OR #MOD-DATE = 0 /*SU2
AND #MOD-USER = ' ' /*SU2                                              .
  ESCAPE ROUTINE
END-IF
IF *LANGUAGE = 2
  #MOD-OUT := 'Geaendert von'
ELSE
  #MOD-OUT := 'Modified by'
END-IF
DECIDE ON EVERY VALUE OF DATE-FORMAT
  VALUE 'A','B'
    MOVE EDITED #MOD-DATE (EM=MM'/'DD'/'YYYY) TO #A_A10
  VALUE 'E','F'
    MOVE EDITED #MOD-DATE (EM=DD'/'MM'/'YYYY) TO #A_A10
  VALUE 'G','H'
    MOVE EDITED #MOD-DATE (EM=DD'.'MM'.'YYYY) TO #A_A10
  NONE /* ' ','I','J'
    MOVE EDITED #MOD-DATE (EM=YYYY'-'MM'-'DD) TO #A_A10
END-DECIDE
MOVE EDITED #MOD-DATE (EM=HH':'II) TO #A_A8 /*':'SS
COMPRESS #MOD-OUT #D-ON #MOD-USER_A8 ',' #D-ON #A_A10 #D-ON #A_A8
  TO #MOD-OUT LEAVING NO
MOVE RIGHT #MOD-OUT TO #MOD-OUT
*
END
