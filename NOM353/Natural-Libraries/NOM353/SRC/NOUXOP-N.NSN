* <Natural Source Header
** -----------------------------------------------------------------
** Subprogram  NOUXOP-N
** Version    2.2.1
** Function   NOM Read Unix node
**
** Maintenance:
** XSETHZ  2002-03-17   created
** fhi     2013-08-29 FHI285    Enhance error message 406
* SU1     2020-12-01 NOMALL-2440 del. UX-EMAIL-RECIPIENTS
** ------------------------------------------------------------------
DEFINE DATA
PARAMETER USING ESMCNT-A
PARAMETER USING ESMINP-A
PARAMETER USING NOUXOP-A
************************************************************************
LOCAL     USING VUXDEF-L
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
ES-RC := 0
DECIDE ON FIRST VALUE OF ES-ORIG-FUNCTION
  VALUE 'OP'
    PERFORM READ-RECORD
  NONE VALUE IGNORE
END-DECIDE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE READ-RECORD
************************************************************************
RESET NOUX-PARMS
FNDR. FIND UX-NODES WITH UX-NODE-NAME = ES-KEY-PARM(1)
  IF NO RECORDS FOUND
    ES-RC := 1
    ES-MSG-NR := 2028
    ES-MSG-TXT := 'Unix node not found'
    ESCAPE BOTTOM (FNDR.)
  END-NOREC
  NOUX-NODE-NAME                := UX-NODE-NAME
  NOUX-NODE-DESCRIPTION         := UX-NODE-DESCRIPTION
  NOUX-NODE-USERID              := UX-NODE-USERID
  NOUX-NODE-PASSWORD            := UX-NODE-PASSWORD
  NOUX-NODE-GROUP := UX-NODE-GROUP
  NOUX-NODE-SUSPEND             := UX-NODE-SUSPEND
  NOUX-NODE-TIMEOUT             := UX-NODE-TIMEOUT
  NOUX-NODE-TEMPDIR             := UX-NODE-TEMPDIR
  NOUX-NODE-PATH         (1:10) := UX-NODE-PATH(1:10)
  NOUX-NODE-CONTAINER-DB (1:10) := UX-NODE-CONTAINER-DB(1:10)
  NOUX-NODE-CONTAINER-FNR(1:10) := UX-NODE-CONTAINER-FNR(1:10)
END-FIND
*
END-SUBROUTINE /* READ-RECORD
*
END
