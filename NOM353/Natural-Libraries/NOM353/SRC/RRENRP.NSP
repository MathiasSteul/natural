* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    RRENRP
* Version   1.3
* Function  Rename a Report
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* mrs 93-06-10           rewritten
* jvd 97-07-08 p(163579) Separator page truncation
*                        re-cat as changes made to EOMRPM-P
* wcd 00-04-01 CE 7267   re-cat as changes made to EOMRPM-E, EOMRPM-P
* xsiszha 2000-08-15 (CE7461) Extend Report and Bundle Names
* xsetggr 2003-08-19 p(240465) accept non-defined userid
* xsetggr 2012-09-21 NOMALL-89 implement external security check subrout
* ----------------------------------------------------------------------
DEFINE DATA GLOBAL USING NRM-GL
* -----------------------------LDA's------------------------------------
LOCAL USING EOM----E
LOCAL USING EOM----P
LOCAL USING EOMRPM-E
LOCAL USING EOMRPM-P
LOCAL USING EOMMSG-P
LOCAL
1 #FATHER-PROG        (A8) INIT <'RLISRP'>
1 #F-REPORT           (A25)
1 REDEFINE #F-REPORT
  2 #F-REPORT-17      (A17)
  2 #F-REPORT-R       (A8)
1 #T-REPORT           (A25)
1 REDEFINE #T-REPORT
  2 #T-REPORT-17      (A17)
  2 #T-REPORT-R       (A8)
1 USERS VIEW OF NRM-USERS
1 #PROG               (A8)
1 #ALLOWED            (L)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
DEFINE WINDOW RENAME-WINDOW SIZE 11*55 BASE 07/20 CONTROL WINDOW
*
* security check
* xsetggr 2012-09-21 NOMALL-89 insert next 3 lines
#PROG := *PROGRAM
PERFORM XXSECURITY-CHECK #PROG G-C-REPORT #ALLOWED
INCLUDE C-NALLOW
*
EOMRPM-I-NAME    := G-C-REPORT
EOM-USER-PROFILE := G-USER-PROFILE
EOM-USER         := G-USERID
EOM-USER-TYPE    := G-USER-TYPE
FIND (1) USERS WITH USER-ID = G-USERID
  IF NO RECORDS FOUND
    EOM-DEF-USER := 'Y'
  END-NOREC
END-FIND
EOM-LANGUAGE := *LANGUAGE
*
RESET EOM-LOGGING                          /* ????????????????
IF G-LOG-REP                                /* ????????????????
  EOM-LOG-TYPES (1) := 'R'                 /* ????????????????
END-IF                                      /* ????????????????
*
EOM-FUNCTION := EOM-READ
EOMRPM-I-ATTRIBUTE-TYPE := REPORT-GENERAL-ATTRIBUTES
CALLNAT 'EOMRPM-N' EOM-PARMS EOMRPM-PARMS EOMMSG-PARMS
IF EOMMSG-NR NE 0
  G-NATRP-ERC := EOMMSG-NR
  G-NATRP-ERT := EOMMSG-TOKEN (1)
  INCLUDE C-ESCAPE
END-IF
*
EOM-FUNCTION := EOM-SECURITY-CHECK
EOMRPM-I-CHECK-FUNCTION := EOM-RENAME
CALLNAT 'EOMRPM-N' EOM-PARMS EOMRPM-PARMS EOMMSG-PARMS
IF EOMMSG-NR NE 0
  G-NATRP-ERC := EOMMSG-NR
  G-NATRP-ERT := EOMMSG-TOKEN (1)
  INCLUDE C-ESCAPE
END-IF
*
SET KEY PF3 = PGM
*
REPEAT
  #F-REPORT := EOMRPM-I-NAME
  RESET #T-REPORT
  IF NOT G-DISPLAY-LONG-NAMES
    #F-REPORT-R := H'FA'
    #T-REPORT-R := H'FA'
  END-IF
  SET CONTROL 'MT'
  INPUT WINDOW = 'RENAME-WINDOW' WITH TEXT *G-NATRP-ERC, G-NATRP-ERT
    USING MAP 'RRENRPM&'
  RESET G-NATRP-ERC G-NATRP-ERT
  IF *PF-KEY = 'PF3'
    SET CONTROL 'WB'
    INCLUDE C-ESCAPE
  END-IF
*
  IF G-DISPLAY-LONG-NAMES
    EOMRPM-I-NEWNAME := #T-REPORT
  ELSE
    EOMRPM-I-NEWNAME := #T-REPORT-17
  END-IF
  RESET  EOMMSG-PARMS
  EOM-FUNCTION := EOM-RENAME
  CALLNAT 'EOMRPM-N' EOM-PARMS EOMRPM-PARMS EOMMSG-PARMS
  IF EOMMSG-NR = 0
    END OF TRANSACTION
  ELSE
    BACKOUT TRANSACTION
    G-NATRP-ERC := EOMMSG-NR
    G-NATRP-ERT := EOMMSG-TOKEN (1)
  END-IF
*
  UNTIL EOMMSG-NR = 0
END-REPEAT
*
END
