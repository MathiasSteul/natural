* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    SHOWSTCK
* Version   3.2
* Function  Show Natural Stack for test reasons
*
* Maintenance
* uuuuuu yyyy-mm-dd P999999 Comment
* fhi    2009-03-16 P296314 created
* ----------------------------------------------------------------------
DEFINE DATA LOCAL
01 FUNCTION (A1)
01 NUM      (I4)
01 DATA     (A32)
01 TYPE     (A8)
01 #I       (P3)
01 #ENTRIES (I4)
END-DEFINE
* --------------------------------------------- main -------------------
CALLNAT 'NAT41013' 'N' NUM DATA     /* Get the number of stack entries
#ENTRIES := NUM
FOR #I = 1 TO #ENTRIES
  NUM := #I
  CALLNAT  'NAT41013' 'T' NUM DATA  /* Get the type of the ith entry
  TYPE := DATA
  NUM := #I
  CALLNAT  'NAT41013' 'R' NUM DATA  /* Get the ith entry (1st 32 bytes)
  DISPLAY #I TYPE DATA
END-FOR
* --------------------------------------------- end --------------------
END
