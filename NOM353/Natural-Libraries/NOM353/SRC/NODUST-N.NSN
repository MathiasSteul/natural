* <Natural Source Header
* -------------------------------------------------------------------
* Subprogram  NODUST-N
* Version     3.1
* Function    get status text of unix node
*
* Maintenance:
* XSETGGR 2005-01-03   P(999999) created
* fhi     2005-10-14   P(266530) Recompiled, XXUX---P changed.
* xsetggr 2006-03-06   add parameter - language
* fhi     2007-03-26   FHI212    XXUX---N rewritten
* XSETHZ  2008-12-08   P309612  set error messsage text
* XSETHZ  2008-12-08   P309612  new parameter
* fhi     2010-09-03 NOMALL-97 Extend message line
* xsetggr 2012-03-11 NOMALL-1099 use interface to call RLOG from NGC
* fhi     2012-04-03 NOMALL-1119 Recataloged due to changes of XXUX---P
* fhi     2012-04-17 NOMALL-1245 Change suspend field to new values.
* fhi     2014-08-29 NOMALL-1454 Recataloged due to changes of XXUX---P
* fhi     2016-11-15 NOMALL-1961 Use new task IDs
* SU1     2016-11-25 NOMALL-1620(NOM3.5) force status check
* fhi     2018-04-25 NOMALL-1918 Severe errors: Set suspend to 'E'
* BLI     2018-07-20 NOMALL-2088 error handling
* BLI     2019-05-06 NOMALL-2261 Recataloged due to changes of XXUX---P
* SU2     2020-12-01 NOMALL-2440 del. UX-EMAIL-RECIPIENTS
* SU3     2021-04-16 NOMALL-2454 recat RMTASK-P to avoid NAT1305
* -------------------------------------------------------------------
DEFINE DATA
PARAMETER
1 #NODE-NAME    (A16)           /* in
1 #LIBRARY-ID   (A8)            /* in
1 #LANGUAGE     (N2)            /* in
1 #SYSTEM       (A9)            /* out
1 #STATUS       (A8)            /* out
1 #ES-MSG-NR    (N4)            /* out
1 #MSG-LONG     (A250) BY VALUE RESULT /* out /*SU1
* *****
LOCAL USING VUXDEF-L
LOCAL USING XXUX---P
LOCAL USING NADA2000
LOCAL USING NAD-MSG
LOCAL USING NAD-FLD
LOCAL USING RLOG-L
LOCAL USING RMTASK-P       /* NOMALL-1961 fhi in
LOCAL
1 #USER-LIB         (A8)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET #STATUS #ES-MSG-NR #MSG-LONG
#SYSTEM := 'Unix'
COMPRESS #LIBRARY-ID 'U' TO #USER-LIB LEAVING NO
FNDUX. FIND UX-NODES WITH UX-NODE-NAME = #NODE-NAME
  IF NO RECORDS FOUND
    ESCAPE BOTTOM(FNDUX.)
  END-NOREC
  IF NOT (UX-NODES.UX-NODE-SUSPEND ='Y' OR='D' OR='M' OR='L'
  OR='S' OR='E')                                                      /*
    P-FUNCTION := 'INFO'
    P-NODE-NAME       := UX-NODE-NAME
    P-USERID          := UX-NODE-USERID
    P-CIPHER-PASSWORD := UX-NODE-PASSWORD
    P-GROUP           := UX-NODE-GROUP
    P-NODE-SUSPEND    := UX-NODE-SUSPEND
    RESET  P-PASSWORD P-ERC
    CALLNAT 'XXUX---N' XXUX---P
    RESET #ES-MSG-NR
*   PRINT (AD=L) 'Node:' UX-NODE-NAME '=' P-OPSYS '=' P-STATUS
*     '=' P-ERC '=' P-ERT
    DECIDE FOR FIRST CONDITION
      WHEN P-ERC = 0
        #SYSTEM := P-OPSYS /* node active
        #ES-MSG-NR := 2030 /* active
* SAT1115 SendMessage abend - ACI :1:
      WHEN P-ERC =5 AND P-ERT=SCAN 'SAT1115'   /* NOMALL-2088 ->
        #ES-MSG-NR := 2031 /* inactive
      WHEN P-ERC NE 0
        #ES-MSG-NR := 2051 /* error
        MOVE EDITED P-ERC (EM=9999) TO #MSG-LONG
        COMPRESS 'E' #MSG-LONG TO #MSG-LONG LEAVING NO
        COMPRESS #MSG-LONG P-ERT TO #MSG-LONG  /* NOMALL-2088 <-
      WHEN NONE IGNORE
    END-DECIDE
  ELSE
    DECIDE ON FIRST VALUE OF UX-NODES.UX-NODE-SUSPEND
      VALUE 'D'     #ES-MSG-NR := 2047 /* DEACTIVATED
      VALUE 'E'     #ES-MSG-NR := 2051 /* error /* NOMALL-1918 fhi in
      VALUE 'M','L' #ES-MSG-NR := 2049 /* Monitor
      NONE          #ES-MSG-NR := 2032 /* suspend
    END-DECIDE
  END-IF
  IF #ES-MSG-NR NE 0
    PERFORM GET-MSG-TXT
    #STATUS := SHORT-MSG
  END-IF
  IF #MSG-LONG = ' '
    #MSG-LONG := P-ERT
  END-IF
END-FIND
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE GET-MSG-TXT
************************************************************************
RESET SHORT-MSG LONG-MSG(*)
VERSION := 0
NADA2000.OBJECT-KIND    := 'U'
NADA2000.ERROR-NUMBER   := #ES-MSG-NR
NADA2000.OPT-INSERT-DYN := FALSE
NADA2000.OPT-LANGUAGE   := #LANGUAGE
NADA2000.LIBRARY        := #LIBRARY-ID
CALLNAT 'NATA2000' NADA2000 NATA2000.EXTENDED-PARMS NAD-MSG NAD-FLD
*
END-SUBROUTINE /* GET-MSG-TXT
*
************************************************************************
DEFINE SUBROUTINE WRITE-LOG-MSG
************************************************************************
DECIDE ON FIRST VALUE OF P-ERC
  VALUE 5
    LG-MSG := SUBSTR (P-ERT,6,65)
  VALUE 1114
    LG-MSG := P-ERT
  NONE VALUE
    COMPRESS P-ERC P-ERT TO LG-MSG
END-DECIDE
RMTASK-P.FUNCTION       := 'L'
RMTASK-P.SUBTASK-NUMBER := 1
CALLNAT 'RMTASKID' RMTASK-P
LG-USERID := RMTASK-P.TASK-ID
LG-CODE := 'MO'
CALLNAT 'NOLG---N' PL-PARMS #USER-LIB
END OF TRANSACTION
*
END-SUBROUTINE /* WRITE-LOG-MSG
*
END
