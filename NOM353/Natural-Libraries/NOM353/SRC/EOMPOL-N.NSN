* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* EOMPOL-N
* Return total number of lines printed
*
* Maintenance
* uuu     yyyy-mm-dd s(999999) ...
* gw      1996-10-18           created
* XSETGGR 2007-07-05 nom3201 Support P11 format run numbers
* raya    2012-02-01 NOMALL-1096 error-text a250 in EOMPOL-P stow only
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER USING EOMPOL-P
************************************************************************
LOCAL  USING  SUPER-L
LOCAL
1 ACTIVE-REPORT VIEW OF NRM-ACTIVE-REPORTS
  2 AR-NUMBER-OF-LINES
1 ACTIVE-BUNDLE VIEW OF NRM-ACTIVE-BUNDLES
  2 AB-NUMBER-OF-LINES
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
DECIDE FOR FIRST CONDITION
  WHEN EOMPOL-FROM-LINE = 0 AND EOMPOL-TO-LINE = 0
    IF EOMPOL-BUNDLE = ' '
      #AR-REPNAME := EOMPOL-REPORT
      #AR-REPRNB  := EOMPOL-RNB
      FIND ACTIVE-REPORT WITH AR-REPORT-RNB = #AR-REPORT-RNB
        IF NO
          ENTER
        END-NOREC
        EOMPOL-TOTAL-LINES := AR-NUMBER-OF-LINES
      END-FIND
    ELSE
      #AB-BUNDLE  := EOMPOL-BUNDLE
      #AB-BUNDRNB := EOMPOL-RNB
      FIND ACTIVE-BUNDLE WITH AB-BUNDLE-RNB = #AB-BUNDLE-RNB
        IF NO
          ENTER
        END-NOREC
        EOMPOL-TOTAL-LINES := AB-NUMBER-OF-LINES
      END-FIND
    END-IF
  WHEN EOMPOL-FROM-LINE = 0
    EOMPOL-TOTAL-LINES := EOMPOL-TO-LINE
  WHEN NONE
    EOMPOL-TOTAL-LINES := EOMPOL-TO-LINE - EOMPOL-FROM-LINE + 1
END-DECIDE
*
END
