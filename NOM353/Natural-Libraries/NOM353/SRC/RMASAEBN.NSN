* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RMASAEBN - Converts ASA to EBCDIC Code
*
* Maintenance:
* uuu yy-mm-dd s(999999) ....
* gw  94-05-06           created
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER USING RMASAEBP
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET P-PRINT-NUMBER
*
DECIDE FOR FIRST CONDITION
  WHEN P-BRACKET = 'F'
    RESET P-PREV-RECORD
    PERFORM HANDLE-NORMAL-RECORD
  WHEN P-BRACKET = 'L'
    PERFORM HANDLE-NORMAL-RECORD
    PERFORM HANDLE-LAST-RECORD
  WHEN NONE
    PERFORM HANDLE-NORMAL-RECORD
END-DECIDE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE HANDLE-NORMAL-RECORD
************************************************************************
DECIDE ON FIRST P-REC-CC
  VALUE '1'  P-PREV-CC := H'81'  /*skip to Chan.  1  immediate
  VALUE '2'  P-PREV-CC := H'82'  /*skip to Chan.  2  immediate
  VALUE '3'  P-PREV-CC := H'83'  /*skip to Chan.  3  immediate
  VALUE '4'  P-PREV-CC := H'84'  /*skip to Chan.  4  immediate
  VALUE '5'  P-PREV-CC := H'85'  /*skip to Chan.  5  immediate
  VALUE '6'  P-PREV-CC := H'86'  /*skip to Chan.  6  immediate
  VALUE '7'  P-PREV-CC := H'87'  /*skip to Chan.  7  immediate
  VALUE '8'  P-PREV-CC := H'88'  /*skip to Chan.  8  immediate
  VALUE '9'  P-PREV-CC := H'89'  /*skip to Chan.  9  immediate
  VALUE 'A'  P-PREV-CC := H'8A'  /*skip to Chan. 10  immediate
  VALUE 'B'  P-PREV-CC := H'8B'  /*skip to Chan. 11  immediate
  VALUE 'C'  P-PREV-CC := H'8C'  /*skip to Chan. 12  immediate
  VALUE '+'  P-PREV-CC := H'00'  /*no operation      immediate
  VALUE ' '  P-PREV-CC := H'01'  /*space 1 Line      immediate
  VALUE '0'  P-PREV-CC := H'02'  /*space 2 Lines     immediate
  VALUE '-'  P-PREV-CC := H'03'  /*space 3 Lines     immediate
  NONE       P-PREV-CC := H'01'  /*space 1 Line      immediate
END-DECIDE
*
ADD 1 TO P-PRINT-NUMBER
P-PRINT-RECORD (P-PRINT-NUMBER) := P-PREV-RECORD
P-PREV-RECORD         := P-RECORD
*
END-SUBROUTINE /* HANDLE-NORMAL-RECORD
*
************************************************************************
DEFINE SUBROUTINE HANDLE-LAST-RECORD
************************************************************************
P-REC-CC := H'00'
ADD 1 TO P-PRINT-NUMBER
P-PRINT-RECORD (P-PRINT-NUMBER) := P-RECORD
*
END-SUBROUTINE /* HANDLE-LAST-RECORD
*
END
