* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
** -----------------------------------------------------------------
** Subprogram  NOUSUP-N
** Version    2.2.1
** Function   NOM API User Profile Maintenance
**
** Maintenance:
** XSETHZ  2002-01-28   created
** fhi     2013-08-29 FHI285    Enhance error message 406
** ------------------------------------------------------------------
DEFINE DATA
PARAMETER USING ESMCNT-A
PARAMETER USING ESMINP-A
PARAMETER USING NOUSUP-A
************************************************************************
LOCAL
1 US VIEW OF NRM-USERS
  2 USER-ID
  2 LAST-NAME
  2 FIRST-NAME
  2 USER-PROFILE
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
ES-RC := 1
DECIDE FOR FIRST CONDITION
  WHEN ES-FUNCTION = 'UP' AND ES-EXTEND-FUNCTION = ' '
    PERFORM READ-RECORD
  WHEN ES-FUNCTION = 'UP' AND ES-EXTEND-FUNCTION = 'UPD'
    PERFORM UPDATE-RECORD
    IF ES-RC = 0
      END TRANSACTION
    END-IF
  WHEN NONE IGNORE
END-DECIDE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE READ-RECORD
************************************************************************
RESET NOUSP-PARMS
FNDR. FIND US WITH USER-ID = ES-KEY-PARM(1)
  IF NO RECORDS FOUND
    ES-MSG-NR := 0002
    ES-MSG-TXT := 'User not found'
    ESCAPE BOTTOM (FNDR.)
  END-NOREC
  NOUSP-ID := USER-ID
  NOUSP-PROFILE := USER-PROFILE
  NOUSP-LAST-NAME := LAST-NAME
  NOUSP-FIRST-NAME := FIRST-NAME
  RESET ES-RC
END-FIND
*
END-SUBROUTINE /* READ-RECORD
*
************************************************************************
DEFINE SUBROUTINE UPDATE-RECORD
************************************************************************
ES-RC := 1
FNDU. FIND US WITH USER-ID = ES-KEY-PARM(1)
  IF NO RECORDS FOUND
    ES-MSG-NR := 0002
    ES-MSG-TXT := 'User not found'
    ESCAPE BOTTOM (FNDU.)
  END-NOREC
  GETU. GET US *ISN(FNDU.)
  USER-PROFILE := NOUSP-PROFILE
  UPDATE (GETU.)
  RESET ES-RC
END-FIND
*
END-SUBROUTINE /* UPDATE-RECORD
*
END
