*
************************************************************************
* Main line
************************************************************************
*
FORMAT PS=60 LS=133
*
IF G-TRACE < 2
  CALLNAT 'NOMGSTEP' '*' G-NATRP-ERC
ELSE
  CALLNAT 'NOMGSTEP' '*' G-NATRP-ERC G-TRACE
END-IF
*
G-LG-USERID := G-MONITOR-ID := #_REVIVE
RESET G-NATRP-ERC
*
COMPCB-OP:='D'
COMPCB-CHAR:='N'                             /* 'N' - New parm list
*
INPUT (IP=OFF) G-NPR-USERID G-MONITOR-NODE #ARCHIVE-DSNAME #NOMEX008
  #USERARC-NUMBER G-TRACE
*
IF *MACHINE-CLASS NE 'MAINFRAME'
  FETCH 'RJREVUX' G-NPR-USERID G-MONITOR-NODE #ARCHIVE-DSNAME
    #NOMEX008 #USERARC-NUMBER
END-IF
INPUT (IP=OFF) #VOLSER (1:12)                /* NOMALL-1422 bli was 6
*
EXAMINE #VOLSER (*) FOR '*' REPLACE ' '
IF G-TRACE > 0
  COMPRESS 'Running with trace level' G-TRACE TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END TRANSACTION
END-IF
*
RESET RACTLF-LOGGING
RACTLF-ERROR-LOGGING:= TRUE
RACTLF-LOG-USERID := G-MONITOR-ID
RACTLF-LOG-CODE   := 'MO'
RACTLF-LFILE-1    := 91
RACTLF-LFILE-2    := 206
CALLNAT 'RACTLF-N' RACTLF-PARMS
IF RACTLF-ERROR-CODE NE 0
  WRITE NOTITLE NOHDR *PROGRAM *TIMX(EM=YYYY'-'MM'-'DD' 'HH':'II)
    RACTLF-ERROR-CODE RACTLF-ERROR-TEXT
  WRITE NOTITLE NOHDR *PROGRAM *TIMX(EM=YYYY'-'MM'-'DD' 'HH':'II)
    'Dbid1:' RACTLF-DBID-1 'Fnr1:' RACTLF-FNR-1
  WRITE NOTITLE NOHDR *PROGRAM *TIMX(EM=YYYY'-'MM'-'DD' 'HH':'II)
    'Dbid2:' RACTLF-DBID-2 'Fnr2:' RACTLF-FNR-2
  TERMINATE 50
END-IF
IF #NOMEX008 = 'Y'
  +G-NOMEXIT-ACTIVE(8) := TRUE
END-IF
*
G-NPR-CURRENT-USERID := G-NPR-USERID
*
CALLNAT 'SATLGFVN' SATLGV-PARMS
IF SATLGV-RC NE 0
  WRITE NOTITLE NOHDR *PROGRAM *TIMX(EM=YYYY'-'MM'-'DD' 'HH':'II)
    SATLGV-ERROR-TEXT
  IF SATLGV-LOG-DBID NE 0 OR SATLGV-LOG-FNR NE 0
    WRITE NOTITLE NOHDR *PROGRAM *TIMX(EM=YYYY'-'MM'-'DD' 'HH':'II)
      'Dbid:' SATLGV-LOG-DBID 'Fnr:' SATLGV-LOG-FNR
  END-IF
  TERMINATE 50
END-IF
*
IF #USERARC-NUMBER GT 0
  FIND NRM-USER-DEFINED-ARCHIVE WITH M-MONITOR-ID = #USERARC-ID
    IF NO RECORDS FOUND
      COMPRESS '0458' 'Revive' #USERARC-ID TO LG-MSG /*userDef. archive
      PERFORM #RLOG
      END TRANSACTION
      WRITE NOTITLE NOHDR *PROGRAM *TIMX(EM=YYYY'-'MM'-'DD' 'HH':'II)
        'User defined archive' #USERARC-ID 'not defined'
      TERMINATE 50
    END-NOREC
    #NATLIB:= M-USERARC-EXITLIB
    #NATMEM:= M-USERARC-EXITMEM
    IF #NATLIB NE ' ' AND #NATMEM NE ' '
      PERFORM ADD-STEPLIB
      NOMUDA-API-VERSION     := 02
      NOMUDA-FUNCTION        := 'R'
      NOMUDA-DATA-SET-NAME-1 := #ARCHIVE-DSNAME
      NOMUDA-ARCHIVE-NAME    := M-USERARC-NAME
      NOMUDA-ARCHIVE-NUMBER  := #USERARC-NUMBER
      NOMUDA-ESY-USERID      := G-NPR-USERID
      NOMUDA-ESY-NODE        := G-MONITOR-NODE
    END-IF
  END-FIND
END-IF
*
PERFORM CHECK-NAT_LIB_MEM
*
LG-MSG := '0443' /*Reviver started
PERFORM #RLOG
END TRANSACTION
CALLNAT 'N-ESYLG' 1X G-MONITOR-NODE G-NPR-CURRENT-USERID #CALLER
  G-NATRP-ERC G-NATRP-ERT 1X 'x' /*err:terminate
*
PERFORM IS-ANYTHING-TO-REVIVE
*
IF NOT END-OF-PROCESSING
  PERFORM REVIVE-ACTIVE-REPORTS
  IF #ERR-TEXT > ' '
    WRITE NOTITLE NOHDR *PROGRAM *TIMX(EM=YYYY'-'MM'-'DD' 'HH':'II)
      'Error finding archive file' #ARCHIVE-DSNAME
    WRITE NOTITLE NOHDR *PROGRAM *TIMX(EM=YYYY'-'MM'-'DD' 'HH':'II)
      #ERR-TEXT
    RESET #ERR-TEXT
    ESCAPE ROUTINE
  END-IF
END-IF
*
IF ANY-REVIVE
  LG-MSG := '0444' /* reviver ended succesfully
ELSE
  LG-MSG := '0445' /* reviver ended - nothing to revive
END-IF
PERFORM #RLOG
END TRANSACTION
WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
  'Reviver terminated normally'
TERMINATE 0
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE REVIVE-ACTIVE-REPORTS
************************************************************************
PERFORM GET-MONITOR-DEFINITION
*
RESET SW-I-REC SW-STORE REVIVE-IT #T #SEQNO ERROR-OCCURED REPORT-TEXT
*
DECIDE FOR FIRST CONDITION
  WHEN #NATMEM NE ' ' AND #NATLIB NE ' '
    REPEAT
      CALLNAT #NATMEM NOMUDA-API-VERSION NOMUDA-PARMS(*)
      IF NOMUDA-RC NE 0
        WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
          'Error:' NOMUDA-RC 'from' #NATMEM / NOMUDA-RT
        ERROR-OCCURED:= TRUE
        TERMINATE 50
      END-IF
      #TEXT-RECORD:= NOMUDA-RECORD
      #RECORD-LENGTH:= NOMUDA-RECORD-LENGTH
      IF NOMUDA-END-OF-DATA = 'YES'
        RESET #TEXT-RECORD NOMUDA-END-OF-DATA
        #T-RECORD-TYPE:= 'I'
      END-IF
      DECIDE ON FIRST VALUE OF #T-RECORD-TYPE
        VALUE 'I'
          PERFORM HANDLE-ID-RECORD
          IF END-OF-PROCESSING
            ESCAPE ROUTINE
          END-IF
        VALUE 'T'
          IF NOT REVIVE-IT OR ERROR-OCCURED
            ESCAPE TOP
          END-IF
          PERFORM HANDLE-TEXT-RECORD
        NONE VALUE
          IGNORE
      END-DECIDE
    END-REPEAT
    IF #STEPLIB-ADDED
      PERFORM REMOVE-STEPLIB
    END-IF
*
  WHEN NONE
    READ WORK FILE 1 #TEXT-RECORD GIVING LENGTH #RECORD-LENGTH
      DECIDE ON FIRST VALUE OF #T-RECORD-TYPE
        VALUE 'I'
          PERFORM HANDLE-ID-RECORD
          IF END-OF-PROCESSING
            ESCAPE ROUTINE
          END-IF
        VALUE 'T'
          IF NOT REVIVE-IT OR ERROR-OCCURED
            ESCAPE TOP
          END-IF
          PERFORM HANDLE-TEXT-RECORD
        NONE VALUE
          IGNORE
      END-DECIDE
*
    END-WORK
END-DECIDE
PERFORM FLUSH-LAST-BUFFER
*
END-SUBROUTINE /* REVIVE-ACTIVE-REPORTS
*
************************************************************************
DEFINE SUBROUTINE HANDLE-ID-RECORD
************************************************************************
IF G-TRACE > 99
  COMPRESS 'Got ID record of length' #RECORD-LENGTH TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
PERFORM FLUSH-LAST-BUFFER
IF END-OF-PROCESSING
  ESCAPE ROUTINE
END-IF
*
RESET ERROR-OCCURED
*
#ID-RECORD := #TEXT-RECORD
DECIDE FOR FIRST CONDITION
/* repname a25,reprnb p7,jobnumber n5,node n3
  WHEN #RECORD-LENGTH = 133 THRU 140      /* NOM311 format archive
    #ACTREP-REPORT:= #REPNAME1 /* jobname (n5)
    #ACTREP-REPRNB:= #REPRNB1
/* repname a25,reprnb p7,jobnumber n7,node n3
  WHEN #RECORD-LENGTH = 141 THRU 142 /* jobname (n7)
    #ACTREP-REPORT:= #REPNAME2
    #ACTREP-REPRNB:= #REPRNB2
/* repname a25,reprnb p11,jobnumber n7,node n5
  WHEN #RECORD-LENGTH > 142              /* NOM32 format archive
    IF G-TRACE > 99
      PERFORM XXHEXPRT #ID-RECORD #HEXHIGH #HEXLOW #RULER
      WRITE NOTITLE NOHDR 'ID-Record:'/
        #ID-RECORD (AL=130) / #HEXHIGH (AL=130) /
        #HEXLOW (AL=130) / #RULER (AL=130) //
      #ID-RECORD := #TEXT-RECORD /* NOMALL-1632: #ID-RECORD changed
    END-IF
    #ACTREP-REPORT:= #REPNAME /* rnb(p11), node (n5)
    #ACTREP-REPRNB:= #REPRNB
/* repname a17,reprnb p7,jobnumber n5,node n3
  WHEN #RECORD-LENGTH LE 132           /* repname (a17) - nom211 format
    #ACTREP-REPORT:= #REPNAME3
    #ACTREP-REPRNB:= #REPRNB3
  WHEN NONE IGNORE
END-DECIDE
FIND-ACT. FIND ACTIVE-REPORTS WITH AR-REPORT-RNB = #ACTREP-KEY
WHERE AR-REVIVE ='D' OR='S'                                           /*
  IF NO RECORDS FOUND
    IF G-TRACE > 99
      COMPRESS NUMERIC 'No active reports found with key' #ACTREP-REPORT
        #ACTREP-REPRNB TO G-TRACE-MSG  /* BLI1
      PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
    END-IF
    REVIVE-IT := FALSE
    ESCAPE BOTTOM
  END-NOREC
  REVIVE-IT := TRUE
  RESET #REC-NO
  #REPISN := *ISN (FIND-ACT.)
  #K-REPNAME := #MA-REPNAME := #ACTREP-REPORT
  #K-REPRNB := #MA-REPRNB := #ACTREP-REPRNB
  IF G-TRACE > 99
    COMPRESS 'Got report to revive:' #K-REPNAME #K-REPRNB TO G-TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END-IF
END-FIND
*
IF NOT REVIVE-IT
  IF G-TRACE > 99
    COMPRESS 'REVIVE-IT is false.' TO G-TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END-IF
  ESCAPE ROUTINE
END-IF
*
RESET G-NATRP-ERC FROM-SWITCHES
*
* BLI1 validate Calendar start
IF NOT ERROR-OCCURED
  IF AR-REVIVE-RETENTION-PERIOD = ' '
    FIND REPORT WITH R-REPNAME = AR-REPNAME
      AR-REVIVE-RETENTION-PERIOD := REPORT.R-REVIVE-RETENTION
    END-FIND
    IF AR-RETENTION-NUM > 0 AND AR-RETENTION-UNIT = 'W'
      IF AR-RETENTION-CALENDAR = ' '
        ERROR-OCCURED := TRUE
        COMPRESS AR-REPNAME  '/' AR-REPRNB
          TO LG-MSG LEAVING NO
        COMPRESS '2010' LG-MSG TO LG-MSG
        PERFORM #RLOG
        END TRANSACTION
        WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
          'Enter calendar for' AR-REPNAME '/' AR-REPRNB
      ELSE
        CALLNAT 'RCHKCA' AR-RETENTION-CALENDAR EXIST
        IF NOT EXIST
          ERROR-OCCURED := TRUE
          COMPRESS AR-REPNAME  '/' AR-REPRNB
            TO LG-MSG LEAVING NO
          COMPRESS '2004' LG-MSG TO LG-MSG
          PERFORM #RLOG
          END TRANSACTION
        WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
            'Calendar' AR-RETENTION-CALENDAR 'does not exist.'
        END-IF
      END-IF
    END-IF
  END-IF
END-IF
*
IF NOT ERROR-OCCURED  /* BLI1 end
  DECIDE ON EVERY VALUE OF ACTIVE-REPORTS.AR-REVIVE
    VALUE 'S'
      IF G-MONITOR-NODE = 0
        RESET FROM-SPOOL
        ACTIVE-REPORTS.AR-REVIVE := 'D'
      ELSE
        FROM-SPOOL := TRUE
        PERFORM FILL-REVIVE-TO-SPOOL-FIELDS
      END-IF
    VALUE 'D','R'
      FROM-NRM := TRUE
      RESET #WRITER
      CALLNAT 'RMDELRTN' ACTIVE-REPORTS.AR-REPNAME
        ACTIVE-REPORTS.AR-REPRNB
    NONE VALUE
      ERROR-OCCURED := TRUE
  END-DECIDE
END-IF /* BLI1
*
*
END-SUBROUTINE /* HANDLE-ID-RECORD
*
************************************************************************
DEFINE SUBROUTINE FLUSH-LAST-BUFFER
************************************************************************
#REVIVE-DATE := *TIMX
*
IF G-TRACE > 99
  COMPRESS 'Flushing last buffer.' TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
IF REVIVE-IT
  IF G-TRACE > 99
    COMPRESS 'REVIVE-IT is true.' TO G-TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END-IF
  RESET REVIVE-IT
  IF SW-STORE
    IF G-TRACE > 99
      COMPRESS 'SW-STORE is true.' TO G-TRACE-MSG
      PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
    END-IF
    PERFORM FLUSH-BUFFER
    IF FROM-SPOOL
      PERFORM CLOSE-SPOOL
    END-IF
    RESET SW-STORE
  END-IF
  PERFORM UPDATE-ACTIVE-REPORT
  PERFORM UPDATE-MAIL-RECORDS
  PERFORM IS-ANYTHING-TO-REVIVE
END-IF
*
END-SUBROUTINE /* FLUSH-LAST-BUFFER
*
************************************************************************
DEFINE SUBROUTINE FLUSH-BUFFER
************************************************************************
IF G-TRACE > 99
  COMPRESS 'Flushing buffer. #T =' #T TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
IF #T = 0
  ESCAPE ROUTINE
END-IF
*
DECIDE FOR FIRST CONDITION
  WHEN FROM-SPOOL    PERFORM FLUSH-TO-SPOOL
  WHEN FROM-NRM      PERFORM FLUSH-TO-DB
  WHEN NONE          ERROR-OCCURED := TRUE
END-DECIDE
*
RESET #T REPORT-TEXT.F-TEXT (*)
*
END-SUBROUTINE /* FLUSH-BUFFER
*
************************************************************************
DEFINE SUBROUTINE HANDLE-TEXT-RECORD
************************************************************************
ADD 1 TO #T
ADD 1 TO #REC-NO
SW-STORE := TRUE
SUBTRACT 1 FROM #RECORD-LENGTH
COMPCB-ILEN := #RECORD-LENGTH
* NOMALL-1078 INSERT 1
COMPCB-ILEN-OLD := #RECORD-LENGTH           /* For compat
IF #RECORD-LENGTH > 251
  COMPCB-ILEN := 251
  COMPCB-ILEN-OLD := 251 /* For compat
  COMPRESS '7205' #REC-NO 'WORK-FILE 1' TO LG-MSG
  PERFORM #RLOG
  END TRANSACTION
END-IF
*
IF NOT FROM-NRM
  CALLNAT 'R-NRMCMP' COMPCB #T-TEXT REPORT-TEXT.F-TEXT (#T)
    G-NATRP-ERC G-NATRP-ERT
  RESET COMPCB-OLEN       /* Zero output length
  IF G-NATRP-ERC NE 0
    ESCAPE ROUTINE
  END-IF
ELSE
  IF #T-TEXT = ' '
    REPORT-TEXT.F-TEXT (#T) := H'0103'
  ELSE
    REPORT-TEXT.F-TEXT(#T) := #T-TEXT
  END-IF
END-IF
IF #T = 20
  PERFORM FLUSH-BUFFER
END-IF
*
END-SUBROUTINE /* HANDLE-TEXT-RECORD
*
************************************************************************
DEFINE SUBROUTINE FLUSH-TO-DB
************************************************************************
ANY-REVIVE := TRUE
*
REPORT-TEXT.F-SEQ     := #REC-NO
REPORT-TEXT.F-REPNAME := #K-REPNAME
REPORT-TEXT.F-REPRNB  := #K-REPRNB
*
F-OBJECT-TYPE := 'FS'
F-OBJECT-TIME := *TIMX
STORE REPORT-TEXT
END TRANSACTION
*
RESET REPORT-TEXT.F-TEXT(*)
*
END-SUBROUTINE /* FLUSH-TO-DB
*
************************************************************************
DEFINE SUBROUTINE FLUSH-TO-SPOOL
************************************************************************
ANY-REVIVE := TRUE
*
FOR K 1 TO #T
  G-PRINT-RECORD := REPORT-TEXT.F-TEXT (K)
  PERFORM WRITE-TO-SPOOL
END-FOR
*
END-SUBROUTINE /* FLUSH-TO-SPOOL
*
************************************************************************
DEFINE SUBROUTINE WRITE-TO-SPOOL
************************************************************************
IF #REV-RECORD-LENGTH > 250
  #REV-RECORD-LENGTH := 250
END-IF
*
DECIDE ON FIRST #REV-SOURCE-TYPE
  VALUE JES2, JES3
    FIND WRITE-SPOOL WITH NODE = #REV-NODE AND CLASS = #REV-CLASS
    AND PROGRAM = #REV-JES-WRITER AND CONTROL = #REV-CONTROL          /*
    AND RECORD  = REPORT-TEXT.F-TEXT (K)                              /*
    AND RECORD-LENGTH = #REV-RECORD-LENGTH AND HOLD    = 'YES'        /*
      IF WRITE-SPOOL.ERROR-CODE > 0
        PRINT NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
          'Error writing to spool Node=' #REV-NODE 'class=' #REV-CLASS
          'program=' #REV-JES-WRITER 'control=' #REV-CONTROL
          'record=' REPORT-TEXT.F-TEXT (K)
          'record-length=' #REV-RECORD-LENGTH 'hold=''YES'''
        WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
          WRITE-SPOOL.ERROR-CODE WRITE-SPOOL.ERROR-TEXT
        ERROR-OCCURED := TRUE
      END-IF
    END-FIND
/*SU11 VALUE POWER
  VALUE SEQUENTIAL-FILE-BS2
    FIND WRITE-FILE WITH NODE = #REV-NODE AND DSNAME = #REV-BS2-DSNAME
    AND RECORD=REPORT-TEXT.F-TEXT(K)                                  /*
    AND RECORD-LENGTH=#REV-RECORD-LENGTH                              /*
      IF WRITE-FILE.ERROR-CODE NE 0
        IF SYSTEM-MESSAGE-CODE NE ' '
          COMPRESS ERROR-PREFIX '(' SYSTEM-MESSAGE-CODE ')' ERROR-TXT
            TO WRITE-FILE.ERROR-TEXT LEAVING NO
        END-IF
        WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
          'error writing file' #REV-BS2-DSNAME
        WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
          WRITE-FILE.ERROR-TEXT
        ERROR-OCCURED := TRUE
      END-IF
    END-FIND
  NONE VALUE
    IGNORE
END-DECIDE
*
END-SUBROUTINE /* WRITE-TO-SPOOL
*
************************************************************************
DEFINE SUBROUTINE CLOSE-SPOOL
************************************************************************
IF #REV-SOURCE-TYPE = SEQUENTIAL-FILE-BS2
  PERFORM CLOSE-SEQ-FILE
ELSE
  PERFORM CLOSE-SPOOL-FILE
END-IF
*
END-SUBROUTINE /* CLOSE-SPOOL
*
************************************************************************
DEFINE SUBROUTINE CLOSE-SEQ-FILE
************************************************************************
CLSSEQ. FIND (1) WRITE-FILE WITH NODE     = #REV-NODE
AND DSNAME   = #REV-BS2-DSNAME AND FUNCTION = 'CLOSE'                 /*
  IF WRITE-FILE.ERROR-CODE NE 0
    IF SYSTEM-MESSAGE-CODE NE ' '
      COMPRESS ERROR-PREFIX '(' SYSTEM-MESSAGE-CODE ')' ERROR-TXT
        TO WRITE-FILE.ERROR-TEXT LEAVING NO
    END-IF
    WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
      'error closing file' #REV-BS2-DSNAME
    WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
      WRITE-FILE.ERROR-TEXT
    ERROR-OCCURED := TRUE
    ESCAPE ROUTINE
  END-IF
END-FIND
*
FNDCMP. FIND FILE-MAINTENANCE WITH NODE     = #REV-NODE
AND DSNAME   = #REV-BS2-DSNAME AND FUNCTION = 'COMPRESS'              /*
  IF FILE-MAINTENANCE.ERROR-CODE NE 0
    IF SYSTEM-MESSAGE-CODE NE ' '
      COMPRESS ERROR-PREFIX '(' SYSTEM-MESSAGE-CODE ')' ERROR-TXT
        TO FILE-MAINTENANCE.ERROR-TEXT LEAVING NO
    END-IF
    WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
      'error compressing file' #REV-BS2-DSNAME
    WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
      FILE-MAINTENANCE.ERROR-TEXT
  END-IF
  PERFORM GET-REPORT-LOCATION-FBS2
END-FIND
*
END-SUBROUTINE /* CLOSE-SEQ-FILE
*
************************************************************************
DEFINE SUBROUTINE CLOSE-SPOOL-FILE
************************************************************************
CLSSPL. FIND (1) WRITE-SPOOL WITH NODE = #REV-NODE AND FUNCTION ='CLOSE'
  IF WRITE-SPOOL.ERROR-CODE > 0
    PRINT NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
      'Error during Close of Spool File. Node=' #REV-NODE
    WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
      WRITE-SPOOL.ERROR-CODE WRITE-SPOOL.ERROR-TEXT
    ERROR-OCCURED := TRUE
    ESCAPE BOTTOM
  END-IF
  #REV-JOB-NUMBER := WRITE-SPOOL.JOB-NUMBER
  DECIDE ON FIRST #REV-SOURCE-TYPE
    VALUE JES2, JES3
      PERFORM GET-XCOM-JOB-NUMBER
      IF NOT ERROR-OCCURED
        PERFORM GET-REPORT-LOCATION-JES
      END-IF
/*SU11  VALUE POWER PERFORM GET-REPORT-LOCATION-POWER
    NONE VALUE
      ERROR-OCCURED := TRUE
  END-DECIDE
END-FIND
*
END-SUBROUTINE /* CLOSE-SPOOL-FILE
*
************************************************************************
DEFINE SUBROUTINE GET-MONITOR-DEFINITION
************************************************************************
/*SU9 #MONITOR-ID := F#MONITOR-TASK-ID1 (<>)
/*SU9 FIND MF-NODE WITH MF-MONITOR-ID = #MONITOR-ID /* BLI 2018-03-20
FIND MF-NODE WITH MF-TYPE-ID = 'MR-'-H'00' THRU 'MR-'-H'FF' /*SU9
  IF NO RECORDS FOUND
    WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
      'Environment Definitions not found'
    STOP
  END-NOREC
/*SU9  G-MONITOR-NODE := MF-MONITOR-NODE/*given via parameter/input
  G-TEMP-CLASS   := MF-TEMP-CLASS
END-FIND
*
END-SUBROUTINE /* GET-MONITOR-DEFINITION
*
************************************************************************
DEFINE SUBROUTINE UPDATE-ACTIVE-REPORT
************************************************************************
IF ERROR-OCCURED
  GETERR. GET ACTIVE-REPORTS #REPISN
  RESET AR-REVIVE
  UPDATE (GETERR.)
  COMPRESS AR-REPNAME (GETERR.) '/' AR-REPRNB (GETERR.)
    TO LG-MSG LEAVING NO
  COMPRESS '0470' LG-MSG TO LG-MSG
  PERFORM #RLOG
  END TRANSACTION
  WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
    'Error during revive of' AR-REPNAME '/' AR-REPRNB
  ESCAPE ROUTINE
END-IF
*
IF FROM-SPOOL
  PERFORM STORE-SOURCE-RECORD
END-IF
*
UPDREV. GET ACTIVE-REPORTS  #REPISN
AR-REVIVE := '*'
AR-REVIVE-DATE := #REVIVE-DATE
DECIDE FOR FIRST CONDITION
  WHEN FROM-SPOOL
    AR-CURRENT-LOCATION := 'S'
    ACTIVE-REPORTS.AR-SOURCE-ID := SOURCE.SR-ID
  WHEN FROM-NRM
    AR-CURRENT-LOCATION := 'D'
  WHEN NONE IGNORE
END-DECIDE
*
* BLI1 Calendar validated before in HANDLE-ID-RECORD
IF AR-REVIVE-RETENTION-PERIOD = ' '
  FIND REPORT WITH R-REPNAME = AR-REPNAME
    AR-REVIVE-RETENTION-PERIOD := REPORT.R-REVIVE-RETENTION
  END-FIND
END-IF
PERFORM COMPUTE-REVIVE-EXPIRATION
*
IF AR-NUMBER-OF-LINES (UPDREV.) = 9999999
  AR-NUMBER-OF-LINES := #REC-NO
END-IF
*
UPDATE (UPDREV.)
*
#AC-RRS := #ACTREP-KEY
RESET #AC-SEQNO
*
REARC. READ REPORT-CONTENTS BY AC-REP-RNB-SEQ = #AC-RRS
  IF AC-REPNAME NE #ACTREP-REPORT OR AC-REPRNB NE #ACTREP-REPRNB
    ESCAPE BOTTOM
  END-IF
  DELETE (REARC.)
  IF *COUNTER >= 50
    END OF TRANSACTION
    RESET *COUNTER
  END-IF
END-READ
*
RESET REPORT-CONTENTS
REPORT-CONTENTS.AC-REPNAME         := #ACTREP-REPORT
REPORT-CONTENTS.AC-REPRNB          := #ACTREP-REPRNB
REPORT-CONTENTS.AC-SEQNO           := #REC-NO
REPORT-CONTENTS.AC-FROM-LINE-N9(1) := 1
REPORT-CONTENTS.AC-TO-LINE-N9(1)   := #REC-NO
/* copy content of GDA view to local view
MOVE BY NAME REPORT-CONTENTS TO REPORT-CONTENTS-LOC
REPORT-CONTENTS-LOC.AC-OBJECT-TYPE     := 'AC'
REPORT-CONTENTS-LOC.AC-OBJECT-TIME     := *TIMX
ST. STORE REPORT-CONTENTS-LOC
/* copy content of local view to GDA (just to be sure)
MOVE BY NAME REPORT-CONTENTS-LOC TO REPORT-CONTENTS
*
PERFORM CHECK-BUNDLE
COMPRESS AR-REPNAME (UPDREV.) '/' AR-REPRNB (UPDREV.)
  TO LG-MSG LEAVING NO
COMPRESS '0459' LG-MSG TO LG-MSG
PERFORM #RLOG
END TRANSACTION
IF +G-NOMEXIT-ACTIVE (8)
  PERFORM USER-EXIT-8
END-IF
*
END-SUBROUTINE /* UPDATE-ACTIVE-REPORT
*
************************************************************************
DEFINE SUBROUTINE UPDATE-MAIL-RECORDS
************************************************************************
RESET #MAIL-CNT
FNDMA. FIND MAIL WITH MA-REP-RNB = #MA-REP-RNB
  IF NO RECORDS FOUND
    ESCAPE BOTTOM (FNDMA.)
  END-NOREC
*
  IF MA-CURRENT-LOCATION = ' '
    G-NATRP-ERT := '1549'
    PERFORM XXRLOG-WRITE-LOG 'W' G-NATRP-ERT
  END-IF
  ADD 1 TO #MAIL-CNT
/*SU6   IF #LOCATION = 'A' MA-CURRENT-LOCATION := #LOCATION ELSE
  MA-CURRENT-LOCATION := 'B' /*always browsable Ü
/*SU6   END-IF
  UPDATE
  IF #MAIL-CNT > 50
    END TRANSACTION
    RESET #MAIL-CNT
  END-IF
END-FIND
IF #MAIL-CNT > 0
  END TRANSACTION
  RESET #MAIL-CNT
END-IF
*
END-SUBROUTINE /* UPDATE-MAIL-RECORDS
*
************************************************************************
DEFINE SUBROUTINE COMPUTE-REVIVE-EXPIRATION
************************************************************************
#DATE-IN := *DATX
*
IF ACTIVE-REPORTS.AR-REVIVE-RETENTION-PERIOD = ' '
OR ACTIVE-REPORTS.AR-REVIVE-RETENTION-NUM = 0                         /*
  ACTIVE-REPORTS.AR-REVIVE-RETENTION-NUM  := 1
  ACTIVE-REPORTS.AR-REVIVE-RETENTION-UNIT := 'A'
  RESET  ACTIVE-REPORTS.AR-REVIVE-RETENTION-CALENDAR
END-IF
*
CALLNAT 'RCOMED-N' #DATE-IN ACTIVE-REPORTS.AR-REVIVE-RETENTION-PERIOD
  #DATE-OUT
*
MOVE EDITED #DATE-OUT (EM=YYYYMMDD) TO
  ACTIVE-REPORTS.AR-REVIVE-EXPIRATION
*
END-SUBROUTINE /* COMPUTE-REVIVE-EXPIRATION
*
************************************************************************
DEFINE SUBROUTINE FILL-REVIVE-TO-SPOOL-FIELDS
************************************************************************
#SPOOL-ATTRIBUTES := ACTIVE-REPORTS.AR-SPOOL-ATTRIBUTES
CALLNAT 'RMSPL7-N' #SPOOL-ATTRIBUTES #SPOOL-TYPE
*
DECIDE ON FIRST ACTIVE-REPORTS.AR-CC-TYPE
  VALUE ASA-CODE      #REV-CONTROL := 'A'
  VALUE MACHINE-CODE  #REV-CONTROL := 'M'
  NONE                RESET #REV-CONTROL
END-DECIDE
*
#REV-RECORD-LENGTH := ACTIVE-REPORTS.AR-RECORD-LENGTH
#REV-CLASS         := G-TEMP-CLASS
WRITE 'Revive class ....:' #REV-CLASS
*
DECIDE ON FIRST #SPOOL-TYPE
  VALUE JES2, JES3  #REV-NODE := #SPOOL-JES-NODE
/*SU11  VALUE POWER       #REV-NODE := #SPOOL-POWER-NODE
  NONE              #REV-NODE := G-MONITOR-NODE
END-DECIDE
WRITE 'Revive node .....:' #REV-NODE
*
IF #REV-NODE NE 0
  FNDSY. FIND (1) SYSTEM-INFO WITH NODE = #REV-NODE
    IF SYSTEM-INFO.ERROR-CODE NE 0
      WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
        'Error writing to spool Node=' #REV-NODE
      WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
        SYSTEM-INFO.ERROR-CODE SYSTEM-INFO.ERROR-TEXT
      ERROR-OCCURED := TRUE
      ESCAPE ROUTINE
    END-IF
    G-MONITOR-JOBNAME := JOBNAME (FNDSY.)
    DECIDE FOR EVERY CONDITION
      WHEN SYSTEM-INFO.SPOOL-TYPE = SCAN 'JES2'
        #REV-SOURCE-TYPE := JES2
      WHEN SYSTEM-INFO.SPOOL-TYPE = SCAN 'JES3'
        #REV-SOURCE-TYPE := JES3
      WHEN SYSTEM-INFO.SPOOL-TYPE = SCAN 'JES'
        MOVE EDITED ACTIVE-REPORTS.AR-REPRNB (EM=9999999) TO #WRITER-RNB
        #WRITER-FIL := 'W'
        #REVIVE-DATE := *TIMX
        #REV-JES-WRITER := #WRITER
/*SU11 WHEN SYSTEM-INFO.SPOOL-TYPE = SCAN 'POWR'
      WHEN SYSTEM-INFO.SYSTEM-TYPE = SCAN 'BS2'
        #REV-SOURCE-TYPE := SEQUENTIAL-FILE-BS2
        PERFORM FILL-BS2000-SPOOL-FIELDS
      WHEN NONE
        IGNORE
    END-DECIDE
*
  END-FIND
ELSE
  SYSTEM-INFO.SYSTEM-TYPE := *OPSYS
  SYSTEM-INFO.SPOOL-TYPE  := 'UNIX'
END-IF
*
END-SUBROUTINE /* FILL-REVIVE-TO-SPOOL-FIELDS
*
************************************************************************
DEFINE SUBROUTINE GET-REPORT-LOCATION-JES
************************************************************************
RESET #REV-REC-COUNT
SPOOL-FILE. FIND SPOOL-FILES WITH NODE = #REV-NODE AND WRITER = #WRITER
AND JOB-NUMBER = #REV-JOB-NUMBER AND JOB-NAME = G-MONITOR-JOBNAME     /*
  IF NO RECORDS FOUND
    WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
      'Error searching spool file, file not found'
    ERROR-OCCURED := TRUE
    ESCAPE ROUTINE
  END-NOREC
  IF SPOOL-FILES.ERROR-CODE NE 0
    PRINT NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
      'Error searching spool file. Node=' #REV-NODE 'writer=' #WRITER
      'job-number=' #REV-JOB-NUMBER 'job-name=' G-MONITOR-JOBNAME
    WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
      SPOOL-FILES.ERROR-CODE SPOOL-FILES.ERROR-TEXT
    ERROR-OCCURED := TRUE
    ESCAPE ROUTINE
  END-IF
  FIND RCOUNT WITH NODE = SPOOL-FILES.NODE AND TYPE = SPOOL-FILES.TYPE
  AND JOB-NAME     = SPOOL-FILES.JOB-NAME                             /*
  AND JOB-NUMBER   = SPOOL-FILES.JOB-NUMBER                           /*
  AND DATA-SET     = SPOOL-FILES.DATA-SET                             /*
  AND DATA-SET-KEY = SPOOL-FILES.DATA-SET-KEY                         /*
  AND RECORD-NUMBER > SPOOL-FILES.RECORD-COUNT                        /*
    IF RCOUNT.ERROR-CODE NE 0
      WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
        SPOOL-FILES.ERROR-CODE SPOOL-FILES.ERROR-TEXT
      PRINT NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
        'Error searching spool file. Node=' SPOOL-FILES.NODE
        'type=' SPOOL-FILES.TYPE 'job-name=' SPOOL-FILES.JOB-NAME
        'job-number=' SPOOL-FILES.JOB-NUMBER
        'data-set=' SPOOL-FILES.DATA-SET
        'data-set-key=' SPOOL-FILES.DATA-SET-KEY
        'record-number >' SPOOL-FILES.RECORD-COUNT
      ERROR-OCCURED := TRUE
      ESCAPE ROUTINE
    END-IF
  END-FIND
  IF RCOUNT.RECORD-NUMBER > SPOOL-FILES.RECORD-COUNT
    SPOOL-FILES.RECORD-COUNT := RCOUNT.RECORD-NUMBER
  END-IF
  IF SPOOL-FILE.RECORD-COUNT LT #REV-REC-COUNT
    ESCAPE TOP
  END-IF
  #REV-REC-COUNT:= SPOOL-FILE.RECORD-COUNT
  RESET #SOURCE-ATTRIBUTES
  #JES-NODE         := SPOOL-FILE.NODE
  #JES-JOB-NAME     := SPOOL-FILE.JOB-NAME
  #JES-JOB-NUMBER   := ABS(SPOOL-FILE.JOB-NUMBER)
  #JES-TYPE         := SPOOL-FILE.TYPE
  #JES-DATA-SET-KEY := ABS(SPOOL-FILE.DATA-SET-KEY)
  #JES-DATA-SET     := SPOOL-FILE.DATA-SET
  #JES-PROCNAME     := SPOOL-FILE.PROCNAME
  #JES-STEPNAME     := SPOOL-FILE.STEPNAME
  #JES-DDNAME       := SPOOL-FILE.DDNAME
*
  SOURCE.SR-ATTRIBUTES-IDENT := #SOURCE-ATTRIBUTES
  IF SYSTEM-INFO.SPOOL-TYPE = SCAN 'JES3'
    SOURCE.SR-TYPE := JES3
  ELSE
    SOURCE.SR-TYPE := JES2
  END-IF
  SOURCE.SR-RECORD-LENGTH   := ACTIVE-REPORTS.AR-RECORD-LENGTH
  SOURCE.SR-NUMBER-OF-LINES := SPOOL-FILE.RECORD-COUNT
  SOURCE.SR-CC-TYPE         := ACTIVE-REPORTS.AR-CC-TYPE
END-FIND
*
END-SUBROUTINE /* GET-REPORT-LOCATION-JES
/*SU11 DEFINE SUBROUTINE GET-REPORT-LOCATION-POWER
*
************************************************************************
DEFINE SUBROUTINE STORE-SOURCE-RECORD
************************************************************************
REPEAT
  CALLNAT 'RMSRID-N' SOURCE.SR-ID G-NATRP-ERC G-NATRP-ERT
  UNTIL G-NATRP-ERC NE 3145
END-REPEAT
*
IF G-NATRP-ERC NE 0
  ERROR-OCCURED := TRUE
  ESCAPE ROUTINE
END-IF
*
SOURCE.SR-CONTROL-FLAG := 'X'
RMTASK-P.FUNCTION       := 'L'
RMTASK-P.SUBTASK-NUMBER := 1
CALLNAT 'RMTASKID' RMTASK-P
SOURCE.SR-MONITOR-ID   := RMTASK-P.TASK-ID
SOURCE.SR-OBJECT-TYPE  := 'SR'
SOURCE.SR-OBJECT-TIME  := *TIMX
STORE SOURCE
*
END-SUBROUTINE /* STORE-SOURCE-RECORD
*
************************************************************************
DEFINE SUBROUTINE IS-ANYTHING-TO-REVIVE
************************************************************************
IF #NATMEM NE ' ' AND #NATLIB NE ' '
  IF G-TRACE > 99   /* BLI1
   COMPRESS 'Any UDA to revive? #NATMEM ' #NATMEM 'and #NATLIB ' #NATLIB
      TO G-TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END-IF
  #AR-ARCHIVE-DATASET (*) := #ARCHIVE-DSNAME
  #AR-ARCHIVE-VOLSER (*)  := #VOLSER (1)
  #AR-REVIVE (1)          := 'S'
  #AR-REVIVE (2)          := 'D'
  FIND (1) ACTIVE-REPORTS WITH AR-DATASET-VOLSER-REVIVE
  = #AR-DATASET-VOLSER-REVIVE (1) OR = #AR-DATASET-VOLSER-REVIVE (2)  /*
    IF NO RECORDS FOUND
      END-OF-PROCESSING:= TRUE
      IF G-TRACE > 99
        COMPRESS 'No reports found. End of processing is true in line'
          *LINE TO G-TRACE-MSG
        PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
      END-IF
      ESCAPE ROUTINE
    END-NOREC
* set variable bits of  parms
    NOMUDA-AR-NAME:= AR-REPNAME
    NOMUDA-AR-RNB:= AR-REPRNB
    ESCAPE ROUTINE
  END-FIND
END-IF
*
IF #NVOL = 1 THRU 12 AND                           /* BLI NOMALL-1422
    #VOLSER (#NVOL) NE ' '
  PERFORM FIND-NUMBER-REPORTS
  IF #NUMREP > 0
    ESCAPE ROUTINE
  END-IF
END-IF
*
REPEAT
  ADD 1 TO #NVOL
  IF #NVOL > 12                                   /* BLI NOMALL-1422
    END-OF-PROCESSING := TRUE
    ESCAPE ROUTINE
  END-IF
  IF #VOLSER (#NVOL) NE ' '
    PERFORM FIND-NUMBER-REPORTS
    IF #NUMREP > 0
      ESCAPE ROUTINE
    END-IF
  END-IF
END-REPEAT
*
END-SUBROUTINE /* IS-ANYTHING-TO-REVIVE
*
************************************************************************
DEFINE SUBROUTINE FIND-NUMBER-REPORTS
************************************************************************
#AR-ARCHIVE-DATASET (*) := #ARCHIVE-DSNAME
#AR-ARCHIVE-VOLSER (*)  := #VOLSER (#NVOL)
#AR-REVIVE (1)          := 'S'
#AR-REVIVE (2)          := 'D'
IF G-TRACE > 99
  COMPRESS 'Searching reports with VOLSER' #VOLSER (#NVOL) '#NVOL:'
    #NVOL 'Key:' TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  WRITE #AR-DATASET-VOLSER-REVIVE (1)
END-IF
FNDRP. FIND NUMBER ACTIVE-REPORTS-LEFT
WITH AR-DATASET-VOLSER-REVIVE = #AR-DATASET-VOLSER-REVIVE (1)         /*
OR = #AR-DATASET-VOLSER-REVIVE (2)                                    /*
#NUMREP := *NUMBER (FNDRP.)
IF G-TRACE > 99
  COMPRESS 'Number of reports found:' #NUMREP 'in line' *LINE
    TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
*
END-SUBROUTINE /* FIND-NUMBER-REPORTS
*
************************************************************************
DEFINE SUBROUTINE GET-XCOM-JOB-NUMBER
************************************************************************
AJ. FIND ACTIVE-JOBS WITH NODE =#REV-NODE AND JOB-NAME=G-MONITOR-JOBNAME
  IF ACTIVE-JOBS.ERROR-CODE NE 0
    ERROR-OCCURED := TRUE
    PRINT NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
      'Error in Active Jobs' ACTIVE-JOBS.ERROR-CODE
      ACTIVE-JOBS.ERROR-TEXT
    ESCAPE ROUTINE
  END-IF
*
  #REV-JOB-NUMBER := JOB-NUMBER (AJ.)
  WRITE 'Revive job number:' #REV-JOB-NUMBER
END-FIND
*
END-SUBROUTINE /* GET-XCOM-JOB-NUMBER
*
************************************************************************
DEFINE SUBROUTINE FILL-BS2000-SPOOL-FIELDS
************************************************************************
#TEMP-DSNAME := #SPOOL-BS2-DSNAME                 /* original name
*
EXAMINE #TD(2:54) FOR ':' GIVING INDEX IN #TI
IF #TI > 0
  #TEMP-CATID := SUBSTR(#TEMP-DSNAME,1,#TI)
  RESET #TD(1:#TI)
  #BS2-CATID-LENGTH := #TI                      /* BLI NOMALL-1801
  MOVE LEFT #TEMP-DSNAME TO #TEMP-DSNAME
END-IF
*
IF #TD (1) = '$'
  EXAMINE #TEMP-DSNAME FOR '.' GIVING POSITION IN #TI
  IF #TI > 0
    #TI2 := #TI - 2
    IF SUBSTR(#TEMP-DSNAME,2,#TI2) NE #SPOOL-BS2-USER-ID
      RESET #TEMP-CATID #BS2-CATID-LENGTH    /* BLI NOMALL-1801 start
    END-IF
    RESET #TD (1:#TI)
    MOVE LEFT #TEMP-DSNAME TO #TEMP-DSNAME
    EXAMINE #SPOOL-BS2-USER-ID FOR 'x'
      GIVING LENGTH IN #BS2-USER-LENGTH
    ADD 2 TO #BS2-USER-LENGTH                  /* $USER.
  END-IF
END-IF
*
EXAMINE #TEMP-DSNAME FOR '(' GIVING POSITION IN #TI
IF #TI > 0                       /* ( means probably LMS name
  REPEAT UNTIL #TI = 0 OR #TD (#TI) = '('
    SUBTRACT 1 FROM #TI
  END-REPEAT
  IF #TI = 0
    #TEMP-DSNAME := 'NOM.REV'
  ELSE
    RESET #TD (#TI:54)
  END-IF
END-IF
*
EXAMINE #TEMP-DSNAME FOR 'x' GIVING LENGTH IN #TI
#BS2-NAME-LENGTH := #TI
*
* 'append' run number
#BS2-NAME-RNB-N11 := ACTIVE-REPORTS.AR-REPRNB
COMPRESS '.R' #BS2-NAME-RNB-N11 TO #BS2-REVNAME-END LEAVING NO
EXAMINE #BS2-REVNAME-END FOR 'x' GIVING LENGTH IN #BS2-REVRNB-LENGTH
*
* Note: usually a name length of 41 is valid. However there were ESY5799
* (internal error) with it. Due to that we use 40 as maximum length.
IF (#BS2-NAME-LENGTH + #BS2-REVRNB-LENGTH LE 40)
AND (#BS2-CATID-LENGTH + #BS2-USER-LENGTH + #BS2-NAME-LENGTH          /*
+ #BS2-REVRNB-LENGTH LE 54)                                           /*
  COMPRESS #TEMP-CATID '$' #SPOOL-BS2-USER-ID '.' #TEMP-DSNAME
    #BS2-REVNAME-END TO #TEMP-DSNAME LEAVING NO
ELSE
* name too long with run number - put it at the 'valid' end
  COMPRESS #TEMP-CATID '$' #SPOOL-BS2-USER-ID '.' #TEMP-DSNAME
    TO #TEMP-DSNAME LEAVING NO
  #TI := #BS2-REVRNB-LENGTH
  IF #BS2-NAME-LENGTH + #BS2-REVRNB-LENGTH GT 40
    #TI2 := #BS2-CATID-LENGTH + #BS2-USER-LENGTH + 40 - #TI
    IF #TI2 + #TI GT 54     /* with catid and user still too long
      #TI2 := 54 - #TI
    END-IF
  ELSE                                  /* GT 54
    #TI2 := 54 - #TI
  END-IF
  IF #TD (#TI2) NE '.'      /* don't append '.Rnn' behind another '.'
    ADD 1 TO #TI2
  END-IF
  RESET #TD (#TI2:54)                   /* clear the end
  MOVE SUBSTR(#BS2-REVNAME-END,1,#TI)   /* '.Rnn' at the end
    TO SUBSTR(#TEMP-DSNAME,#TI2,#TI)
END-IF
#REV-BS2-DSNAME := #TEMP-DSNAME         /* now set #REV-BS2-DSNAME
#REPLACE-YN := #YES                     /* BLI NOMALL-1801 end
*
PERFORM ALLOCATE-BS2000-FILE
*
END-SUBROUTINE /* FILL-BS2000-SPOOL-FIELDS
*
************************************************************************
DEFINE SUBROUTINE ALLOCATE-BS2000-FILE
************************************************************************
IF #SPOOL-TYPE = SEQUENTIAL-FILE-BS2
  IF #SPOOL-BS2-BLKSIZE = 0
    #REV-BS2-BLKSIZE := 1
  ELSE
    #REV-BS2-BLKSIZE := #SPOOL-BS2-BLKSIZE / 2048
  END-IF
  #REV-BS2-SECONDARY := #SPOOL-BS2-SECONDARY
  DECIDE FOR FIRST CONDITION
    WHEN #SPOOL-BS2-RECFM = SCAN 'V' #REV-BS2-RECFORM := 'V'
    WHEN #SPOOL-BS2-RECFM = SCAN 'U' #REV-BS2-RECFORM := 'U'
    WHEN NONE                        #REV-BS2-RECFORM := 'F'
  END-DECIDE
ELSE
  #REV-BS2-BLKSIZE := 1
  #REV-BS2-SECONDARY := 120
  #REV-BS2-RECFORM := 'F'
END-IF
*
DECIDE ON FIRST ACTIVE-REPORTS.AR-CC-TYPE
  VALUE ASA-CODE
    COMPRESS #REV-BS2-RECFORM 'A' TO #REV-BS2-RECFORM LEAVING NO
  VALUE BS2000-CC
    COMPRESS #REV-BS2-RECFORM 'M' TO #REV-BS2-RECFORM LEAVING NO
  NONE VALUE
    COMPRESS #REV-BS2-RECFORM 'N' TO #REV-BS2-RECFORM LEAVING NO
END-DECIDE
*
#L := ACTIVE-REPORTS.AR-NUMBER-OF-LINES
IF ACTIVE-REPORTS.AR-RECORD-LENGTH = 1 THRU 251
  #S := ACTIVE-REPORTS.AR-RECORD-LENGTH
ELSE
  #S := 251
END-IF
*
IF #REV-BS2-RECFORM  = SCAN 'V'
  RESET #REV-BS2-RECSIZE
  #S := #S * 0.8
ELSE
  #REV-BS2-RECSIZE := ACTIVE-REPORTS.AR-RECORD-LENGTH
END-IF
*
#B := #SPOOL-BS2-BLKSIZE
*
#MIN-PRIMARY := #REV-BS2-BLKSIZE * 2
IF #MIN-PRIMARY < 3
  #MIN-PRIMARY := 3
END-IF
#REV-BS2-PRIMARY := (#L * #S / #B + 1) * #B / 2048
IF #REV-BS2-PRIMARY < #MIN-PRIMARY
  #REV-BS2-PRIMARY := #MIN-PRIMARY
END-IF
*
** FNDAL. FIND FILE-ALLOCATE WITH NODE = #REV-NODE AND REPLACE = 'YES'
FNDAL. FIND FILE-ALLOCATE WITH NODE = #REV-NODE
AND REPLACE = #REPLACE-YN                  /* BLI NOMALL-1801         /*
AND DSNAME = #REV-BS2-DSNAME AND RECFM = #REV-BS2-RECFORM             /*
AND LRECL = #REV-BS2-RECSIZE AND DSORG = 'SAM'                        /*
AND BLKSIZE = #REV-BS2-BLKSIZE AND ALLOCATION-TYPE      = 'PAM'       /*
AND PRIMARY-ALLOCATION   = #REV-BS2-PRIMARY                           /*
AND SECONDARY-ALLOCATION = #REV-BS2-SECONDARY                         /*
  IF FILE-ALLOCATE.ERROR-CODE NE 0
    IF SYSTEM-MESSAGE-CODE NE ' '
      COMPRESS ERROR-PREFIX '(' SYSTEM-MESSAGE-CODE ')' ERROR-TXT
        TO FILE-ALLOCATE.ERROR-TEXT LEAVING NO
    END-IF
    WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
      'error allocating file' #REV-BS2-DSNAME
    WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
      FILE-ALLOCATE.ERROR-TEXT
    PRINT NOTITLE NOHDR (AD=L) *PROGRAM /*SU6
      *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
      'NODE:' #REV-NODE 'REPLACE:' #REPLACE-YN
      'RECFM:' #REV-BS2-RECFORM 'LRECL:' #REV-BS2-RECSIZE
      'BLKSIZE:' #REV-BS2-BLKSIZE 'PRIMARY:' #REV-BS2-PRIMARY
      'SECONDARY:' #REV-BS2-SECONDARY
    ERROR-OCCURED := TRUE
  END-IF
*
END-FIND
*
END-SUBROUTINE /* ALLOCATE-BS2000-FILE
*
************************************************************************
DEFINE SUBROUTINE GET-REPORT-LOCATION-FBS2
************************************************************************
RESET #SOURCE-ATTRIBUTES
*
#FBS2-NODE    := #REV-NODE
#FBS2-DSNAME  := #REV-BS2-DSNAME
#FBS2-RECSIZE := ACTIVE-REPORTS.AR-RECORD-LENGTH
#FBS2-BLKSIZE := #REV-BS2-BLKSIZE * 2048
#FBS2-RECFM   := #REV-BS2-RECFORM
*
SOURCE.SR-ATTRIBUTES-IDENT := #SOURCE-ATTRIBUTES
SOURCE.SR-TYPE             := SEQUENTIAL-FILE-BS2
SOURCE.SR-RECORD-LENGTH    := ACTIVE-REPORTS.AR-RECORD-LENGTH
SOURCE.SR-NUMBER-OF-LINES  := ACTIVE-REPORTS.AR-NUMBER-OF-LINES
SOURCE.SR-CC-TYPE          := ACTIVE-REPORTS.AR-CC-TYPE
*
END-SUBROUTINE /* GET-REPORT-LOCATION-FBS2
*
************************************************************************
DEFINE SUBROUTINE CHECK-BUNDLE
************************************************************************
#BC-REPNAME:= #ACTREP-REPORT
#BC-REPRNB:= #ACTREP-REPRNB
RESET #ALREADY-BUNDLED #REVIVE-TO-BUNDLE #BC-ISN
FIND BUNDLE-CONTENTS WITH BC-REPORT-RNB = #BC-REPORT-RNB
  IF BC-BUNDRNB = 0
    G-REPORT      := #ACTREP-REPORT
    G-REPRNB      := #ACTREP-REPRNB
    G-FATHER-PROG := *PROGRAM
    PERFORM SEND-TO-BUNDLE 1X /*RMCRTBUN /no RMEX-SPOOL-ATTR..
  END-IF
END-FIND
*
END-SUBROUTINE /* CHECK-BUNDLE
*
************************************************************************
DEFINE SUBROUTINE USER-EXIT-8
************************************************************************
RESET NOMEX008-PARMS (1) NOMEX008-ERROR-CODE NOMEX008-FROMLINE
  NOMEX008-TOLINE NOMEX008-RECORD-LENGTH NOMEX008-NODE
NOMEX008-FUNCTION := NOMEX008-FCT-REVIVE
NOMEX008-REPNAME  := AR-REPNAME (UPDREV.)
NOMEX008-REPRNB   := AR-REPRNB (UPDREV.)
IF G-TRACE > 1
  RMSETTIM.FUNCTION := 'S'
  PERFORM RMSETTIM-SETTIME RMSETTIM
END-IF
CALLNAT 'NOMEX008' NOMEX008-PARMS(*)
IF G-TRACE > 1
  RMSETTIM.FUNCTION := 'G'
  PERFORM XXRLOG-WRITE-LOG 'T' RMSETTIM.MSG
  END TRANSACTION
END-IF
*
END-SUBROUTINE /* USER-EXIT-8
*
INCLUDE RJ-C ''' ''' /*ON ERROR
*
END
