* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* MIGPRT - Add new special attributes for predefined printers                    >
*          to get all printer parameters if some have been added
*          (Template: EOMPHMDN)
*
* Maintenance
* uuuuuuu yyyy-mm-dd Issue
* fhi     2010-07-21 NOMALL-838   Created from template EOMPHMDN
* xsetggr 2010-11-03 NOMALL-865   add printer type ##PHYS-WRTSPOOL
* xsetggr 2012-02-21 NOMALL-1110  correct MIGPRT-C for WRTSPOOL printers
* xsetggr 2012-09-03 NOMALL-1194  implement NOMPRBS2
* fhi     2013-05-08 NOMALL-1214 Introducing new migration flags
* fhi     2013-05-24 NOMALL-1260 Change CMA Spool to CA Spool on interf
*                                No tags, only literals changed
* SU1     2013-06-05 NOMALL-1262 remove OS2PM,HPSPOOL,WINPM,WINPM32
*                                -> delete logical and physical printers
* fhi     2013-10-24 NOMALL-1292 Call MIG33PR first.
* fhi     2014-08-26 NOMALL-1475 Recat for new field 'FORMATTER'
* SU2     2014-11-20 NOMALL-1529 correct log. printer (MIGPRBSC)+writes
* fhi     2015-10-12 NOMALL-1742 NISNHQ with 4000 entries exhausted.
* fhi     2016-11-15 NOMALL-1961 Use new task IDs
* SU3     2017-10-09 NOMALL-1823 NOM 3.5: remove CONNECT,ECL,XML
* fhi     2019-01-25 NOMALL-2212 Honour first installation
* SU4     2019-02-01 NOMALL-2224 remove HPSPOOL(wrong in 3.4)+
*                                check type(not name)
* SU5     2024-03-07 ES-34613    NOM 3.6 Remove power / BS2
* ------------------- --------------------------------------------------
*
DEFINE DATA
LOCAL USING EOMPHTYE
LOCAL USING EOMPHVRE
LOCAL
1 PH VIEW OF NRM-PHYSICAL-PRINTERS
  2 PH-VTAMID
  2 PH-PRINTER-TYPE
  2 PH-PRINT-PGM
  2 PH-ATTRIBUTES             (25)
  2 REDEFINE PH-ATTRIBUTES
    3 PH-ATTR                 (25)
      4 PH-ATTR-IDENT         (I1)
      4 PH-ATTR-L-P-V         (A22)
      4 REDEFINE PH-ATTR-L-P-V
        5 PH-ATTR-LENGTH      (N2)
        5 REDEFINE PH-ATTR-LENGTH
          6 PH-ATTR-LENGTH-A  (A2)
        5 PH-ATTR-PROMPT      (N4)
        5 REDEFINE PH-ATTR-PROMPT
          6 PH-ATTR-PROMPT-A  (A4)
        5 PH-ATTR-VAR         (A16)
      4 PH-ATTR-DEFAULT       (A72)
1 PR VIEW OF NRM-PRINTERS
  2 P-ID
  2 P-NAME
  2 P-PHYSICAL-NAME
  2 P-ATTRIBUTES              (25)
  2  REDEFINE P-ATTRIBUTES
    3 P-ATTR                  (25)
      4 P-ATTR-IDENT          (I1)
      4 P-ATTR-LENGTH         (N2)
      4 REDEFINE P-ATTR-LENGTH
        5 P-ATTR-LENGTH-A     (A2)
      4 P-ATTR-PROMPT         (N4)
      4 REDEFINE P-ATTR-PROMPT
        5 P-ATTR-PROMPT-A     (A4)
      4 P-ATTR-VAR            (A16)
      4 P-ATTR-VALUE          (A72)
1 MONITOR VIEW OF NRM-MONITOR
  2 M-MONITOR-ID
  2 M-VERSION
  2 REDEFINE M-VERSION
    3 M-VERS-VERSION-N        (N2)
    3 M-VERS-RELEASE-N        (N2)
    3 M-VERS-SP-N             (N2)
    3 M-VERS-CF-N             (N4)
    3 M-VERS-MIGRATION-IN-PROGRESS (A1) /* NOMALL-1214 was (L)
    3 M-VERS-DATE             (A8)
    3 M-VERS-NO-OF-MIG-PROGS  (N2)
    3 M-VERS-MIGRATION-COMPL  (A1/10)
1 #PH-ATTR-EXAM               (A95/25)
1 REDEFINE #PH-ATTR-EXAM
  2 #PH-EXAM (25)
    3 #PH-ATTR-IDENT          (I1)
    3 #PH-FILLER              (A6)
    3 #PH-ATTR-VAR            (A16)
1 #P-ATTR-EXAM                (A95/25)
1  REDEFINE #P-ATTR-EXAM
  2 #P-EXAM                   (25)
    3 #P-ATTR-IDENT           (I1)
    3 #P-FILLER               (A6)
    3 #P-ATTR-VAR             (A16)
1 #I                          (I2)
1 #J                          (I2)
1 #K                          (I2)
1 #L                          (I2)
1 #SEARCH                     (A16/25)
1 #CHANGED                    (L)
1 #CASPOOL                    (L)
1 #ENDTRANS                   (I1)
1 #VARS                       (I2)
1 #CORR-IDENT                 (L)
1 #ATTR-EXAM                  (A95/25)
1 REDEFINE #ATTR-EXAM
  2 #ATTR (25)
    3 #ATTR-IDENT             (I1)
    3 #ATTR-LEN-PROMPT        (N6)
    3 #ATTR-VAR               (A16)
    3 #ATTR-VALUE             (A72)
1 #REMOVED
  2 ##PHYS-WINPM              (A8) CONST <'WINPM'>
  2 ##PHYS-OS2PM              (A8) CONST <'OS2PM'>
  2 ##PHYS-WINPM32            (A8) CONST <'WINPM32'>
  2 ##PHYS-CON-NECT           (A8) CONST <'CON-NECT'>
  2 ##PHYS-ECL                (A8) CONST <'ECL'>
  2 ##PHYS-XML                (A8) CONST <'XML'>
  2 ##PHYS-HPSPOOL            (A8) CONST <'HPSPOOL'> /*SU4
  2 ##PHYS-SYSPRPWR           (A8) CONST <'SYSPRPWR'> /*SU5
  2 ##PHYS-TAPEVSE            (A8) CONST <'TAPEVSE'> /*SU5
  2 ##PHYS-SYSPRBS2           (A8) CONST <'SYSPRBS2'> /*SU5
1 REDEFINE #REMOVED
  2 #REMOVED-TAB              (A8/1:10) /*SU5 was 7
*
1 #MONITOR-ID                 (A20)
1 #FOUND                      (L)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
MONITOR.M-MONITOR-ID := F#MONITOR-TASK-ID1 (<>)
FIND MONITOR WITH M-MONITOR-ID = MONITOR.M-MONITOR-ID
  IF M-VERS-MIGRATION-IN-PROGRESS NE 'Y'
    BACKOUT TRANSACTION
    WRITE / 'No migration started yet. Run MIGSTART first.' /
    ESCAPE ROUTINE
  END-IF
  M-VERS-MIGRATION-COMPL (2) := 'N' /* migration in progress
  UPDATE
  END TRANSACTION
END-FIND
WRITE *TIMX (EM=YYYY'-'MM'-'DD' 'HH:II:SS) *PROGRAM 'started.'
/* Check physical printers for additional or changed parameters
READ PH BY PH-VTAMID
  RESET #CHANGED #CASPOOL #ATTR(*) #CORR-IDENT
  #PH-ATTR-VAR (*) := PH-ATTR-VAR (*)
  EXAMINE #PH-ATTR-VAR (*) AND TRANSLATE INTO UPPER
  DECIDE ON FIRST VALUE OF PH-PRINTER-TYPE
/*SU5  VALUE ##PHYS-SYSPR-PWR INCLUDE MIGPRT-C '#POWER' '#PWR'
    VALUE ##PHYS-SYSPR-JES
      INCLUDE MIGPRT-C '#JES' '#JES'
    VALUE ##PHYS-VTAM
      INCLUDE MIGPRT-C '#VTAM' '#VTAM'
/*SU5  VALUE ##PHYS-TAPE-VSE INCLUDE MIGPRT-C '#TAPEVSE' '#TAPEVSE'
    VALUE ##PHYS-TAPE-MVS
      INCLUDE MIGPRT-C '#TAPEMVS' '#TAPEMVS'
    VALUE ##PHYS-DISK-MVS
      INCLUDE MIGPRT-C '#DISKMVS' '#DISKMVS'
    VALUE ##PHYS-NAF
      INCLUDE MIGPRT-C '#NAF' '#NAF'
    VALUE ##PHYS-CMASPOOL,'CMASPOOL'
      IF PH-PRINTER-TYPE NE ##PHYS-CMASPOOL
        PH-PRINTER-TYPE := ##PHYS-CMASPOOL
        #CASPOOL        := TRUE
      END-IF
      INCLUDE MIGPRT-C '#CMA' '#CMA'
/*SU5 IF *OPSYS = MASK('BS2') #ATTR-EXAM (*) := PH-ATTRIBUTES(*)
/*SU5 INCLUDE MIGPRBSC '#CMA' END-IF
    VALUE ##PHYS-UNIXLP
      INCLUDE MIGPRT-C '#UNIXLP' '#UNIXLP'
    VALUE ##PHYS-NATUNIX
      INCLUDE MIGPRT-C '#NATUNIX' '#NATUNIX'
      IF PH-PRINT-PGM NE 'RMPRNAT'
        #CHANGED     := TRUE
        PH-PRINT-PGM := 'RMPRNAT'
      END-IF
    VALUE ##PHYS-DISKUNIX
      INCLUDE MIGPRT-C '#DISKUNIX' '#DISKUNIX'
      IF PH-PRINT-PGM NE 'RMPRDSK'
        #CHANGED     := TRUE
        PH-PRINT-PGM := 'RMPRDSK'
      END-IF
/*SU5 VALUE ##PHYS-BS2 INCLUDE MIGPRT-C '#BS2' '#BS2'
/*SU5 IF *OPSYS = MASK('BS2') #ATTR-EXAM (*) := PH-ATTRIBUTES(*)
/*SU5 INCLUDE MIGPRBSC '#BS2' END-IF
    VALUE ##PHYS-EMAIL
      INCLUDE MIGPRT-C '#EMAIL' '#EMAIL'
    VALUE ##PHYS-WRTSPOOL
      INCLUDE MIGPRT-C '#WRTSPL' '#WRTSPL'
      IF PH-PRINT-PGM NE 'RMPRWSP'
        #CHANGED     := TRUE
        PH-PRINT-PGM := 'RMPRWSP'
      END-IF
    NONE
      IGNORE
  END-DECIDE
  IF #CHANGED OR #CORR-IDENT OR #CASPOOL
    IF #CORR-IDENT
      PH-ATTRIBUTES(*) := #ATTR-EXAM(*)
    END-IF
    CALLNAT 'EOMPHSRN' PH-ATTRIBUTES (*)
    UPDATE
    PRINT *TIMX (EM=YYYY'-'MM'-'DD' 'HH:II:SS) 'physical printer'
      PH-VTAMID 'changed' #CORR-IDENT (EM=' '/'(ident)')
      '(' PH-PRINTER-TYPE ')'
  END-IF
  ADD 1 TO #ENDTRANS
  IF #ENDTRANS > 49
    END TRANSACTION
    RESET #ENDTRANS
  END-IF
END-READ
END TRANSACTION
RESET #ENDTRANS
/* Check logical printers for additional or changed parameters
PR1. READ PR BY P-ID
  RESET #CORR-IDENT #CHANGED
  FINDPH. FIND PH WITH PH-VTAMID = P-PHYSICAL-NAME
    IF #REMOVED-TAB (*) = PH.PH-PRINTER-TYPE
      PR-DEL. GET PR *ISN (PR1.)
      DELETE (PR-DEL.) /*delete removed logical printers
      PRINT *TIMX (EM=YYYY'-'MM'-'DD' 'HH:II:SS) 'printer' P-ID
        'deleted (' PH-VTAMID ',' PH.PH-PRINTER-TYPE ')'
      ESCAPE BOTTOM (FINDPH.)
    END-IF
/*SU5 -> IF *OPSYS = MASK('BS2')
/* DECIDE ON FIRST VALUE OF PH.PH-PRINTER-TYPE VALUE ##PHYS-CMASPOOL
/* #ATTR-EXAM(*) := P-ATTRIBUTES(*) INCLUDE MIGPRBSC '#CMA'
/* VALUE ##PHYS-BS2 #ATTR-EXAM(*) := P-ATTRIBUTES(*)
/*SU5 <- INCLUDE MIGPRBSC '#BS2' NONE VALUE IGNORE END-DECIDE END-IF
    #P-ATTR-VAR  (*) := P-ATTR-VAR  (*)
    #PH-ATTR-VAR (*) := PH-ATTR-VAR (*)
    EXAMINE #P-ATTR-VAR  (*) AND TRANSLATE INTO UPPER
    EXAMINE #PH-ATTR-VAR (*) AND TRANSLATE INTO UPPER
/* Delete parameters no more needed or renamed
    FOR2. FOR #I = 1 TO 24
      IF #P-ATTR-VAR (#I) = " "
        ESCAPE BOTTOM (FOR2.)
      END-IF
      #J := #I + 1
      EXAMINE FULL #PH-ATTR-VAR (*) FOR FULL #P-ATTR-VAR (#I)
        GIVING INDEX IN #K
      IF #K = 0
        P-ATTRIBUTES (#I:24) := P-ATTRIBUTES (#J:25)
        RESET P-ATTRIBUTES (25)
        #P-ATTR-VAR (*)      := P-ATTR-VAR (*)
        EXAMINE #P-ATTR-VAR (*) AND TRANSLATE INTO UPPER
        #I                   := #I - 1
        #CHANGED             := TRUE
      END-IF
    END-FOR
*
/* Add new parameters or parameters renamed
    FOR #I = 1 TO 25
      IF PH-ATTR-IDENT (#I) = 0 OR = 32 OR = 64 /* blank
        ESCAPE BOTTOM
      END-IF
      EXAMINE FULL #P-ATTR-VAR (*) FOR FULL #PH-ATTR-VAR (#I)
        GIVING INDEX IN #J
      IF #J = 0                            /* parameter not found
        FOR #K = 1 TO 25
          IF P-ATTR-IDENT (#K) = 0 OR = 32 OR = 64 /* blank
            ESCAPE BOTTOM
          END-IF
        END-FOR
        IF #K > 25
          ESCAPE BOTTOM (FINDPH.)
        END-IF
        #CHANGED := TRUE
        P-ATTR-IDENT  (#K)   := #K
        P-ATTR-LENGTH (#K)   := PH-ATTR-LENGTH  (#I)
        P-ATTR-PROMPT (#K)   := PH-ATTR-PROMPT  (#I)
        P-ATTR-VAR    (#K)   := PH-ATTR-VAR     (#I)
        P-ATTR-VALUE  (#K)   := PH-ATTR-DEFAULT (#I)
        #P-ATTR-VAR  (*) := P-ATTR-VAR  (*)
        EXAMINE #P-ATTR-VAR  (*) AND TRANSLATE INTO UPPER
      ELSE                                 /* parameter changed?
        IF P-ATTR-LENGTH-A (#J) NE PH-ATTR-LENGTH-A (#I)
          #CHANGED := TRUE
          P-ATTR-LENGTH (#J) := PH-ATTR-LENGTH (#I)
          #P-ATTR-VAR  (*)   := P-ATTR-VAR  (*)
          EXAMINE #P-ATTR-VAR  (*) AND TRANSLATE INTO UPPER
        END-IF
        IF P-ATTR-PROMPT-A (#J) NE PH-ATTR-PROMPT-A (#I)
          #CHANGED := TRUE
          P-ATTR-PROMPT (#J) := PH-ATTR-PROMPT (#I)
          #P-ATTR-VAR  (*)   := P-ATTR-VAR  (*)
          EXAMINE #P-ATTR-VAR  (*) AND TRANSLATE INTO UPPER
        END-IF
      END-IF
    END-FOR
  END-FIND
  IF *NUMBER (FINDPH.) = 0
    PRINT (AD=L) *TIMX (EM=YYYY'-'MM'-'DD' 'HH:II:SS) *PROGRAM *LINE
      'physical printer' P-PHYSICAL-NAME 'not found for logical printer'
      P-ID
  END-IF
  IF #CHANGED OR #CORR-IDENT
    IF #CORR-IDENT
      P-ATTRIBUTES(*) := #ATTR-EXAM(*)
    END-IF
    CALLNAT 'EOMPHSRN' P-ATTRIBUTES (*)
    UPDATE
    PRINT *TIMX (EM=YYYY'-'MM'-'DD' 'HH:II:SS) 'printer' P-ID
      'changed' #CORR-IDENT (EM=' '/'ident')
      '(' PH-VTAMID ',' PH.PH-PRINTER-TYPE ')'
  END-IF
  ADD 1 TO #ENDTRANS
  IF #ENDTRANS > 49
    END TRANSACTION
    RESET #ENDTRANS
  END-IF
END-READ
END TRANSACTION
* *****
* Delete removed physical printers:
* *****
PH1. READ PH BY PH-VTAMID
  IF #REMOVED-TAB (*) = PH-PRINTER-TYPE /*SU4 was PH1.PH-VTAMID
    PH-DEL. GET PH *ISN (PH1.)
    DELETE (PH-DEL.)
    PRINT *TIMX (EM=YYYY'-'MM'-'DD' 'HH:II:SS) 'physical printer'
      PH-VTAMID 'deleted (' PH.PH-PRINTER-TYPE ')'
  END-IF
END-READ
END TRANSACTION
*
INCLUDE MIG----C 'SET-VALUES' 'MONITOR'
END TRANSACTION
WRITE *TIMX (EM=YYYY'-'MM'-'DD' 'HH:II:SS) *PROGRAM 'finished.'
*
************************************************************************
* Subroutines
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE SET-VALUES /* called by MIG----C
************************************************************************
M-VERS-MIGRATION-COMPL (2) := 'Y' /* migration finished
*
END-SUBROUTINE /* SET-VALUES
*
END
