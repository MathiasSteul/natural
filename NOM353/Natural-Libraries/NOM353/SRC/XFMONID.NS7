* ----------------------------------------------------------------------
* Version   3.5
* Function  find monitor record: return task-id for number 1
*           format: NOMnnnnnmmmmm-01 n=DBID m=FNR
* Usage:
*  M-MONITOR-ID := F#MONITOR-TASK-ID1 (<>)
*  FIND NRM-MONITOR WITH M-MONITOR-ID = M-MONITOR-ID
* ----------------------------------------------------------------------
* Maintenance
* -----------
* uuuuuu  yyyy-mm-dd iTrac       Remark
* SU      2018-05-25             Created
* ----------------------------------------------------------------------
*
DEFINE FUNCTION F#MONITOR-TASK-ID1 RETURNS #TASK-ID (A16)
  DEFINE DATA
  LOCAL USING RMTASK-P   /*SU1
  END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RMTASK-P.FUNCTION       := 'S'
RMTASK-P.SUBTASK-NUMBER := 1
CALLNAT 'RMTASKID' RMTASK-P
#TASK-ID := RMTASK-P.TASK-ID
*
END-FUNCTION /*F#MONITOR-TASK-ID1
*
END
