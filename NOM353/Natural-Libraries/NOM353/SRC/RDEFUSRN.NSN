* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RDEFUSRN - NOM User-Spool Interface Field Help
*
* Maintenance
* UUU YY-MM-DD Sagsis Desciption
* --- -------- ------ --------------------------------------------------
* gw  95-01-03        created
* mrs 95-07-05 999999 time limit added
* gw  98-10-27 (164220) m-natrpt-dbid-n5, m-natrpt-fnr-n5
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 #FIELD-NAME     (A65)
************************************************************************
LOCAL
1 F               (P2)
1 #FIELD          (A65)
1 REDEFINE #FIELD
  2 #F            (A1/1:65)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#FIELD := #FIELD-NAME
EXAMINE #FIELD FOR '.' GIVING POSITION F
IF F > 0
  RESET #F (1:F)
  MOVE LEFT #FIELD TO #FIELD
END-IF
*
DECIDE ON FIRST #FIELD
  VALUE 'M-TIME-SCHEDULE'    INPUT USING MAP 'HUSPACT&'
  VALUE 'M-VERSION'          INPUT USING MAP 'HUSPDES&'
  VALUE 'M-NATRPT-DBID-N5'   INPUT USING MAP 'HUSPDB-&'
  VALUE 'M-NATRPT-FNR-N5'    INPUT USING MAP 'HUSPFNR&'
  VALUE '#FILE-PROMPT'       INPUT USING MAP 'HUSPPRO&'
  VALUE '#FILE-OFFSET'       INPUT USING MAP 'HUSPOFF&'
  VALUE '#FILE-LENGTH'       INPUT USING MAP 'HUSPLEN&'
  VALUE '#FILE-VAR'          INPUT USING MAP 'HUSPVAR&'
  VALUE '#NOMUSR-PROMPT'     INPUT USING MAP 'HUSPPRO&'
  VALUE '#NOMUSR-OFFSET'     INPUT USING MAP 'HUSPOFF&'
  VALUE '#NOMUSR-LENGTH'     INPUT USING MAP 'HUSPLEN&'
  VALUE '#NOMUSR-VAR'        INPUT USING MAP 'HUSPVAR&'
  VALUE '#NOMUSR-ORDER'      INPUT USING MAP 'HUSPORD&'
  VALUE '#NOMUSR-GENERIC'    INPUT USING MAP 'HUSPGEN&'
  VALUE 'M-WAIT-INCREMENT'   INPUT USING MAP 'HUSPTL-&'
  NONE                       IGNORE
END-DECIDE
*
END
