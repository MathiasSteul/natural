* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* INSTALL - Installation Program
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* mrs 93-08-10           clean up
* gw  93-09-29 s(999999) set control 'L'
* mrs 94-03-02 s(999999) BS2
* gw  94-06-07 s(999999) new profile settings
* mrs 94-06-14 s(999999) assign g-system-type g-spool-type
* fhi 99-12-06 S(189715) Get steplibs if NSC not active
* wcd 00-04-01 CE 7267   New PFkey for additional printers in RPFK---L
* XSISWS 2000-06-08  CE 7592  re-cat new profile added VUSERS-L
* xsisgg 2000-07-05 p(195864) add SYSEXT as steplib if NSC is not active
* fhi    2000-07-26 QA01      add SYSNOMS steplib if NSC is not active
* xsethz  2000-08-04 (CE7461) Extend Report and Bundle Names
* xsetggr 01-12-19 p(209875) add missing steplibs if NSC not active
* fhi 03-07-23 p(242064) Unify steplib concatentation
* fhi 03-12-17 p(248647) NAT0954 (0c7) in NOMOO-P
* fhi 05-06-23 p(266530) Monitor must be NPR Mainframe independent
* xsetggr 05-06-30 p(248647) correct solution
* fhi     07-05-30 P297047   Replace RSTEPLIB, old comments deleted
* fhi     08-03-26 fhi249    Replace NOMVER-P with NOMVER-A
* xsetggr 2008-06-17 p(292680) sinhronize version of existing monitor
*                              record
* fhi     2009-01-20 P313495 menu 8.6 does not run under Unix
* XSETHZ  2009-02-04 P307593 Replace NOMVER-N with PRDVER-N
* XSETHZ  2009-02-04 P307593 Add Version date
* fhi     2009-02-27 P300323 Rename RGETSTEP->NOMGSTEP(SYSTEM
* splildav 2009-12-27        Different map for Unix
* fhi     2010-09-03 NOMALL-97 Extend message line
* bli     2012-09-19 NOMALL-94 Introduce 2-digit versions
* fhi     2013-05-08 NOMALL-1214 Introduce new migration flags
* SU1     2013-09-16 NOMALL-1281 last update user+date for user
* SU2     2014-06-02 NOMALL-1281 last update user+date for Report
* fhi     2016-01-22 NOMALL-1812 Show all parameter screens for checkng
* fhi     2016-02-01 NOMALL-1812 same
* fhi     2016-08-18 NOMALL-1621 Introduce Multinode Feature
* fhi     2016-11-15 NOMALL-1961 Use new task IDs
* fhi     2017-05-04 NOMALL-1961 same
* fhi     2018-03-14 NOMALL-1918 Integrate subprogram CRELOC and del. it
* SU3     2018-09-25         M-INTERNAL-NODE-ID -> M-INTERNAL-EMAIL-NODE
* SU4     2018-11-01 NOMALL-2114 avoid NAT0934 in RMGTRACE
* fhi     2019-01-23 NOMALL-2212 Honour first installation on Unix
* fhi     2019-02-20 NOMALL-2234 Set monitor tasks with STORE NRM-MONIT.
* fhi     2019-03-11 NOMALL-2248 INSTALL does not fill version info
* SU5     2019-10-15 NOMALL-2329 allow entering ESY user (NOMMON)
* SU6     2020-03-20 NOMALL-2396 unix:no check of NPR node (avoid 641
* SU7     2020-08-28 NOMALL-2430 fill NPR user in node
* SU8     2020-11-10 NOMALL-2440 split DDM -> NRM-MF-NODES
* SU9     2021-04-06 NOMALL-2444 PF1=help
* SU10    2021-04-07 NOMALL-2455 store node in N-NODEMF
* SU11    2021-04-16 NOMALL-2454 recat RMTASK-P to avoid NAT1305
*         +                      recat for VMONIT-L M-NATRPT-DBID/-FNR
* SU12    2021-07-12 NOMALL-2477 add MSGs
* BLI     2021-09-20 NOMALL-2477 QE wishes to remove the PRINTs
* SU13    2024-03-07 ES-34613    NOM 3.6 Remove power / BS2
* ----------------------------------------------------------------------
DEFINE DATA GLOBAL USING NRM-GL
LOCAL USING VUSERS-L
LOCAL USING VMONIT-L /*NRM-MONITOR
LOCAL USING RPFK---L
LOCAL USING RTXT---L
LOCAL USING NOMVER-A
LOCAL USING RMTASK-P
*
LOCAL
1 SYSTEM-INFO VIEW OF SYSTEM-INFO
  2 NODE
  2 PRODUCT-NAME
  2 SYSTEM-TYPE
  2 SPOOL-TYPE
  2 ERROR-CODE
  2 ERROR-TEXT
1 FOLDER VIEW OF NRM-FOLDER
  2 FO-ID
  2 FO-NAME
  2 FO-USER-ID
1 CONTROL-RECORD VIEW OF NRM-REPORTS-NEW
  2 R-REPNAME
  2 R-LASTRNB
  2 R-IDENT-WRITER
  2 R-LAST-UPDATE
  2 R-LAST-UPDATE-USER
1 REPRT VIEW OF NRM-REPORTS-NEW
  2 R-REPNAME
  2 R-USERID
*
1 #ADMIN                     (A8)
1 L-HEADER                   (A78)
1 #START                     (A25)
1 #END                       (A25)
1 END-OF-PROCESSING          (L)
1 CV-IN                      (C)
1 #FO-USER-FO-ID             (A10)
1 REDEFINE #FO-USER-FO-ID
  2 #FO-USER                 (A8)
  2 #FO-ID                   (B2)
1 #FOLDER-NAME               (A70)
1 #BUNDLE-DEFAULTS           (A250)
1 REDEFINE #BUNDLE-DEFAULTS
  2 #BUNDDEF
    3 B-CHAR-FIELDS1         (A40)
    3 B-FLUSH-TIME           (T)
    3 REDEFINE B-FLUSH-TIME
      4 B-FLUSH-TIME-A       (A7)
    3 B-CHAR-FIELDS2         (A197)
1 #M-VERSION                 (A20)
1 REDEFINE #M-VERSION
  2 #VERSION-N               (N2)
  2 #RELEASE-N               (N2)
  2 #SP-N                    (N2)
  2 #CF-N                    (N4)
  2 #MIGRATION-IN-PROGRESS   (A1)
  2 #VERSION-DATE            (A8)
1 P-ERC                      (N4)
1 P-ERT                      (A250)
1 #TRACING                   (L)    INIT <FALSE>
* Set tracing if it should run as a 'trace version'
1 #TRACE-MSG                 (A250)
1 #MF                        (L)
1 #FOUND                     (L)
1 #NPR-USERID                (A8) INIT <'NOMMON'> /*default /*SU7
1 #PROGRAM                   (A8) INIT <*PROGRAM>
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
FORMAT AD=L
SET CONTROL 'L'
RESET G-NATRP-ERC G-NATRP-ERT
CALLNAT 'NOMGSTEP' '*' G-NATRP-ERC
IF *MACHINE-CLASS = 'MAINFRAME'
  #MF := TRUE
  G-MONITOR-NODE := 148 /*default
ELSE
  G-MONITOR-NODE := 0
END-IF
G-LANGUAGE := *LANGUAGE
*
IF #MF
  #ADMIN := 'DBA'
ELSE /*UNIX
  #ADMIN := 'SAG'
END-IF
*
PERFORM INIT-PFKEYS
PERFORM SET-PFKEYS
*
PERFORM SCREEN-IO
IF NOT END-OF-PROCESSING
  CV-IN := (AD=DP)
  PERFORM SYSTEM-INFORMATION
  PERFORM SCREEN-IO
END-IF
*
IF G-NATRP-ERC NE 0 OR END-OF-PROCESSING
  STOP
END-IF
*
PERFORM STORE-MONITOR-RECORD /*use INTERNAL-NODE-ID
IF #MF
  CALLNAT 'N-NODEMF' SYSTEM-INFO.PRODUCT-NAME SYSTEM-INFO.SYSTEM-TYPE
    SYSTEM-INFO.SPOOL-TYPE #NPR-USERID #PROGRAM #TRACING
    G-MONITOR-NODE /*SU10
/* ELSE PERFORM STORE-UX-NODE /*SU ????
END-IF
CALLNAT 'RMSWNODE' 'L' 1 0 0 #TRACING #FOUND
IF NOT #MF AND NOT #FOUND
  FETCH RETURN 'RDEFUX' 'A' 'ÜFORCEÜ'
  CALLNAT 'RMSWNODE' 'L' 1 0 0 #TRACING
END-IF
FETCH RETURN 'MIGEND'
#TRACE-MSG := 'Running MIGEND to set correct version information'
PERFORM XXRLOG-WRITE-LOG 'W' #TRACE-MSG
PERFORM STORE-USER
PERFORM STORE-CONTROL-RECORD
PERFORM MODIFY-EXAMPLES
PERFORM MODIFY-DEFINITIONS
/* BLI NOMALL-2477 comment PRINTs
** PRINT NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
**  'NOM Installation successfully executed. Press Enter to continue.'
*
FETCH 'MENU'
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE SCREEN-IO
************************************************************************
CALLNAT 'N-HEADER' L-HEADER 'G' 'INSTL1M1'
*
REPEAT
  INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT USING MAP 'INSTL1M&'
  IF NOT #MF /*SU6
    G-MONITOR-NODE := 0
  END-IF
  DECIDE ON FIRST *PF-KEY
    VALUE 'PF1' /*SU9
      REINPUT USING HELP
    VALUE 'PF3'
      END-OF-PROCESSING := TRUE
      ESCAPE BOTTOM
    VALUE 'ENTR'
      IF #MF AND NOT G-MONITOR-NODE = 1 THRU 65535 /*SU6
        REINPUT WITH TEXT *641 MARK *G-MONITOR-NODE
        /*NOM0641 Enter a node number between 1 and 65535.
      END-IF
      IF #NPR-USERID = ' '
        REINPUT WITH TEXT *2020 MARK *#NPR-USERID
        /*NOM2020 Please enter field.
      END-IF
      ESCAPE BOTTOM
    NONE VALUE
      IGNORE
  END-DECIDE
END-REPEAT
*
END-SUBROUTINE /* SCREEN-IO
*
************************************************************************
DEFINE SUBROUTINE STORE-MONITOR-RECORD
************************************************************************
RMTASK-P.TASK-ID := F#MONITOR-TASK-ID1 (<>)
MONITOR. FIND NRM-MONITOR WITH M-MONITOR-ID = RMTASK-P.TASK-ID
  IF NO RECORDS FOUND /*store it (only place ÜÜ)
    ENTER
  END-NOREC
  MONITOR.M-MONITOR-ID             := RMTASK-P.TASK-ID
/*SU8  MONITOR.M-MONITOR-NODE           := G-MONITOR-NODE
/*SU8  MONITOR.M-PRODUCT-NAME           := SYSTEM-INFO.PRODUCT-NAME
  IF MONITOR.M-MONITOR-TASKS = ' '
  OR='000000000000000000000000000000000000'                           /*
    MONITOR.M-MONITOR-TASKS := '001001000000000000000000000000001001'
  END-IF
/*SU8  EXAMINE M-PRODUCT-NAME FOR 'OSD' REPLACE WITH 'BS2000'
  G-NATRP-DBID := M-NATRPT-DBID-N5 := RMTASK-P.NOM-DBID
  G-NATRP-FNR  := M-NATRPT-FNR-N5  := RMTASK-P.NOM-FNR
  DECIDE FOR EVERY CONDITION
    WHEN M-WAIT-MINIMUM = 0     M-WAIT-MINIMUM := 1
    WHEN M-WAIT-MAXIMUM = 0     M-WAIT-MAXIMUM := 300
    WHEN M-WAIT-INCREMENT = 0   M-WAIT-INCREMENT := 5
    WHEN M-PRT-TASK-NO = 0      M-PRT-TASK-NO := 2
    WHEN NOT #MF                M-BATCH-MODULE := 'UNIX'
    WHEN M-LAST-ACTIVE-CK = ' ' RESET M-LAST-ACTIVE
    WHEN M-ARCHIVE-TIME-CK =' ' RESET M-ARCHIVE-TIME
    WHEN NONE IGNORE
  END-DECIDE
  #BUNDLE-DEFAULTS := M-BUNDLE-DEFAULTS
  IF B-FLUSH-TIME-A = ' '
    RESET B-FLUSH-TIME
    M-BUNDLE-DEFAULTS := #BUNDLE-DEFAULTS
  END-IF
*
  NOMVER-PRODUCTNAME := 'EOM'
  CALLNAT 'PRDVER-N' NOMVER-PARMS P-ERC P-ERT
  #VERSION-N := NOMVER-VERSION
  #RELEASE-N := NOMVER-RELEASE
  #SP-N      := NOMVER-SP
  #CF-N      := NOMVER-CF
  #VERSION-DATE := NOMVER-DATE
  M-VERSION := #M-VERSION
  IF *NUMBER (MONITOR.) = 0
    STORE NRM-MONITOR
    #TRACE-MSG := 'added:' /*SU12
  ELSE
    UPDATE (MONITOR.)
    #TRACE-MSG := 'updated:' /*SU12
  END-IF
  COMPRESS 'Monitor Defaults' #TRACE-MSG 'DBID:' M-NATRPT-DBID-N5
    'FNR:' M-NATRPT-FNR-N5 TO #TRACE-MSG /*SU12
/* BLI NOMALL-2477 comment PRINTs
**  PRINT NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
**    #TRACE-MSG /*SU12
*
  END TRANSACTION
*
END-FIND
*
END-SUBROUTINE /* STORE-MONITOR-RECORD
*
************************************************************************
DEFINE SUBROUTINE MODIFY-DEFINITIONS
************************************************************************
G-C-FUNC   := 'M'
G-C-USERID := #ADMIN
*
FETCH RETURN 'RDEFUS'
FETCH RETURN 'RDEFMO'
FETCH RETURN 'RDEFSY'
FETCH RETURN 'RDEFAV'
FETCH RETURN 'RDEFRV'
FETCH RETURN 'RDEFCL'
*
END-SUBROUTINE /* MODIFY-DEFINITIONS
*
************************************************************************
DEFINE SUBROUTINE MODIFY-EXAMPLES
************************************************************************
#START := #END := 'UEX-'
EXAMINE FULL VALUE OF #START FOR ' ' REPLACE WITH H'00'
EXAMINE FULL VALUE OF #END   FOR ' ' REPLACE WITH H'FF'
*
READ REPRT BY R-REPNAME = #START ENDING AT #END
  R-USERID := #ADMIN
  UPDATE
END-READ
END OF TRANSACTION
*
END-SUBROUTINE /* MODIFY-EXAMPLES
*
************************************************************************
DEFINE SUBROUTINE STORE-USER
************************************************************************
CALLNAT 'RLTINI-N' ##TXT-INBASKET #FOLDER-NAME G-TXB
FNDUS. FIND USERS WITH USER-ID = #ADMIN
  IF NO RECORDS FOUND
    USERS.USER-ID  := #ADMIN
    PROF-REPORTS   := PROF-BUNDLES := PROF-PRINTERS := PROF-AREPS := 'P'
    PROF-ABUNDS  := PROF-LISTS := PROF-CALENDARS := PROF-PHYSICAL := 'P'
    PROF-PRINTOUTS := PROF-USERS := 'P'
    PROF-ARCHIVE := PROF-REVIVE := PROF-FLUSH := PROF-ARCHIVE-ADMIN:='Y'
    PROF-STARTUP  := PROF-SHUTDOWN := PROF-EDT-PREFIX := 'Y'
    PROF-EDT-KEYS := PROF-EXTERNAL := 'Y'
    PROF-TYPE           := 'A'
    PROF-DEFAULTS       := 'M'
    PROF-AUTOCOMMIT     := 'E'
    PROF-LANGUAGE       := *LANGUAGE
    PROF-CONFIRM        := 'N'
    G-USER-PROFILE      := USERS.USER-PROFILE
    US-LAST-UPDATE      := *TIMX
    US-LAST-UPDATE-USER := G-USERID
    STORE USERS
    END TRANSACTION
/* BLI NOMALL-2477 comment PRINTs
**  PRINT NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
**    'User' #ADMIN 'added.' /*SU12
  END-NOREC
*
  G-USER-PROFILE := USERS.USER-PROFILE
  #FO-USER := #ADMIN
  #FO-ID   := 1
  FNDFO. FIND FOLDER WITH FO-USER-FO-ID = #FO-USER-FO-ID
    IF NO RECORDS FOUND
      FO-USER-ID := #ADMIN
      FO-ID      := 1
      FO-NAME    := #FOLDER-NAME
      STORE FOLDER
/* BLI NOMALL-2477 comment PRINTs
**    PRINT NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
**      'Folder' #FOLDER-NAME 'added for user' #ADMIN /*SU12
    END-NOREC
  END-FIND
*
END-FIND
*
END-SUBROUTINE /* STORE-USER
*
************************************************************************
DEFINE SUBROUTINE SYSTEM-INFORMATION
************************************************************************
IF G-MONITOR-NODE NE 0
  FNDSY. FIND SYSTEM-INFO WITH NODE = G-MONITOR-NODE
    IF ERROR-CODE NE 0
      G-NATRP-ERC := 0005
      G-NATRP-ERT := ERROR-TEXT
      ESCAPE BOTTOM (FNDSY.)
    END-IF
    EXAMINE FULL VALUE OF SYSTEM-TYPE FOR H'00' REPLACE WITH ' '
    EXAMINE FULL VALUE OF SPOOL-TYPE  FOR H'00' REPLACE WITH ' '
/*SU13 IF SYSTEM-TYPE = SCAN 'BS2' SPOOL-TYPE := SYSTEM-TYPE END-IF
    G-MONITOR-NODE := NODE
    IF SPOOL-TYPE = SCAN 'POWR' OR= SCAN 'BS2' /*SU13
      G-NATRP-ERC := 4501 /*Invalid Spool Type: :1:
      COMPRESS SPOOL-TYPE '(' SYSTEM-TYPE
        ' not supported since NOM 3.6)' TO G-NATRP-ERT LEAVING NO
      ESCAPE BOTTOM (FNDSY.)
    END-IF
/*SU13  IF NOT(SYSTEM-TYPE = SCAN 'DOS' OR = SCAN 'VSE' OR = SCAN 'MVS'
/*SU13    OR = SCAN 'MSP' OR = SCAN 'BS2')
    IF NOT(SYSTEM-TYPE =SCAN 'MVS' OR=SCAN 'MSP') /*SU13
      G-NATRP-ERC := 4500 /*Invalid System type.
      G-NATRP-ERT := SYSTEM-TYPE
      ESCAPE BOTTOM (FNDSY.)
    END-IF
    IF NOT(SPOOL-TYPE = SCAN 'JES2' OR= SCAN 'JES3') /*SU13
      G-NATRP-ERC := 4501 /*Invalid Spool Type: :1:
      G-NATRP-ERT := SYSTEM-TYPE
    END-IF
  END-FIND
ELSE
  SYSTEM-INFO.SYSTEM-TYPE := *OPSYS
  SYSTEM-INFO.SPOOL-TYPE  := 'UNIX'
END-IF
G-SYSTEM-TYPE := SYSTEM-INFO.SYSTEM-TYPE
G-SPOOL-TYPE  := SYSTEM-INFO.SPOOL-TYPE
*
END-SUBROUTINE /* SYSTEM-INFORMATION
*
************************************************************************
DEFINE SUBROUTINE STORE-CONTROL-RECORD
************************************************************************
FNDCT. FIND CONTROL-RECORD WITH R-REPNAME = 'NOM-CONTROL-REC'
  IF NO RECORDS FOUND
    CONTROL-RECORD.R-REPNAME          := 'NOM-CONTROL-REC'
    CONTROL-RECORD.R-LASTRNB          := 10000
    CONTROL-RECORD.R-IDENT-WRITER     := 'DUMMY'
    CONTROL-RECORD.R-LAST-UPDATE      := *TIMX
    CONTROL-RECORD.R-LAST-UPDATE-USER := G-USERID
    STORE CONTROL-RECORD
  END-NOREC
END-FIND
END OF TRANSACTION
*
END-SUBROUTINE /* STORE-CONTROL-RECORD
*
************************************************************************
DEFINE SUBROUTINE INIT-PFKEYS
************************************************************************
G-PF-IDENT (01) := ##PFN-HELP /*SU9
G-PF-IDENT (03) := ##PFN-EXIT
G-PF-CODE  (03) := ##PFK-EXIT
G-PF-IDENT (15) := ##PFN-EXIT
G-PF-CODE  (15) := ##PFK-EXIT
CALLNAT 'RPFINI-N' G-PF G-PFB
*
END-SUBROUTINE /* INIT-PFKEYS
*
INCLUDE RPFSET-C  /* set pfkeys
*
END
