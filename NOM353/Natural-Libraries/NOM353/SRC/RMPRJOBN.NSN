* <Natural Source Header
* Member       RMPRJOBN
* Version      1.3
* Function     Get printer attributes and replace current settings
*
* Creation and Maintenance History
* uuu yy-mm-dd s(999999) ...
* gw  93-11-12           created
* gw  95-12-20           various attributes added
* jvd 99-05-26 p(182583) recat due to changed  EOMPHVRE
* xsiszha  2000-05-30 s(CE7760)
* sju     2003-05-20 p(240452) restow for changed EOMPHVRE
* SPLIAR 2009-03-02 p(308277) recat due to changed  EOMPHVRE
* SPLIAR 2009-08-27 p(308277) recat due to changed  EOMPHVRE
* Splildav 2009-09-30 P(317741) RESTOW FOR CHANGED EOMPHVRE
* fhi     2010-09-03 NOMALL-97 Extend message line
* xsetggr 2011-01-24 NOMALL-865 restow due to changes in EOMPHVRE
* ----------------------------------------------------------------------
*
DEFINE DATA PARAMETER USING  RMJBST-P
PARAMETER
1 #PRINTER                           (A8)
1 #CURRENT-CHARACTERISTICS           (A253/1:2)
1 REDEFINE  #CURRENT-CHARACTERISTICS
  2 #BURST                           (A1)
  2 #CHARS                           (A26)
  2 #CKPTLINE                        (A5)
  2 #CKPTPAGE                        (A5)
  2 #CKPTSEC                         (A5)
  2 #CLASS                           (A1)
  2 #COMPACT                         (A8)
  2 #DATACK                          (A7)
  2 #DCB1                            (A60)
  2 #DCB2                            (A60)
  2 #DEST                            (A17)
  2 #FCB                             (A4)
  2 #FLASH                           (A10)
  2 #FORMDEF                         (A6)
  2 #FORMS                           (A8)
  2 #INDEX                           (A2)
  2 #LINDEX                          (A2)
  2 #LRECL                           (A6)
  2 #MODIFY                          (A4)
  2 #PAGEDEF                         (A6)
  2 #PRMODE                          (A8)
  2 #RECFM                           (A5)
  2 #TRC                             (A3)
  2 #UCS                             (A4)
1 RMPRJOB-ERC                        (N4)
1 RMPRJOB-ERT                        (A250)
* *****
LOCAL USING EOMPRM-P
LOCAL USING EOMMSG-P
LOCAL USING EOM----P
LOCAL USING EOM----E
LOCAL USING EOMPRM-E
LOCAL USING EOMPHVRE
LOCAL
1 #I                                 (I4)
1 #T                                 (I4)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
PERFORM READ-PRINTER
*
FOR #I 1 #JES-VARS
  EXAMINE RMJBST-VAR (*) FOR EOMPRM-ATTR-VAR (#I) GIVING INDEX #T
  IF #T NE 0
    RMJBST-TEXT (#T) := EOMPRM-ATTR-VALUE (#I)
  END-IF
END-FOR
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE READ-PRINTER
************************************************************************
RESET EOMMSG-PARMS
EOM-FUNCTION            := EOM-READ
EOMPRM-I-NAME           := #PRINTER
EOM-USER-TYPE           := 'A'
EOM-USER                := *USER
EOMPRM-I-ATTRIBUTE-TYPE := PRINTER-SPECIAL-ATTRIBUTES
CALLNAT 'EOMPRM-N' EOM-PARMS EOMPRM-PARMS EOMMSG-PARMS /*Mnt Log.Printer
*
IF EOMMSG-NR NE 0
  RMPRJOB-ERC := EOMMSG-NR
  RMPRJOB-ERT := EOMMSG-TOKEN (1)
  ESCAPE ROUTINE
END-IF
*
END-SUBROUTINE /* READ-PRINTER
*
END
