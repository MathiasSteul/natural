* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* PROGRAM  : RRENUDA
* FUNCTION : Rename User Defined Archive
*
* Maintenance
* uuu yy-mm-dd p(......) Description
* ----------------------------------------------------------------------
DEFINE DATA GLOBAL USING NRM-GL
LOCAL USING ROT----L
LOCAL USING VUSARC-L
LOCAL
1 #NEWNAME    (A8)
1 #OLDNAME    (A8)
1 #MONITOR-ID (A10)
1 I           (I2)
END-DEFINE
INPUT #MONITOR-ID #OLDNAME
CALLNAT 'ROTINI-N' ##EQO-ARCHIVE-TYPE
                   G-OBJ-TYPE
                   G-OTB
*
SET KEY PF3
*
SET CONTROL 'WC11L45B06/25F'
SET CONTROL 'MT'
INPUT USING MAP 'RRENUDM&'
IF *PF-KEY = 'PF3'
   ESCAPE ROUTINE
END-IF
*
IF #NEWNAME = ' '
   REINPUT *2000
           ALARM
END-IF
*
FIND NRM-USER-DEFINED-ARCHIVE WITH M-MONITOR-ID = 'USERARC01'
     THRU 'USERARC99'
  IF M-MONITOR-ID = #MONITOR-ID
    ESCAPE TOP
  END-IF
  IF M-USERARC-NAME = #NEWNAME
    REINPUT *0033, G-OBJ-TYPE
             ALARM
  END-IF
END-FIND
*
FIND NRM-USER-DEFINED-ARCHIVE WITH M-MONITOR-ID = #MONITOR-ID
  MOVE #NEWNAME TO M-USERARC-NAME
  UPDATE
END-FIND
END TRANSACTION
END
