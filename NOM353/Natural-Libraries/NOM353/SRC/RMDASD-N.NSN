* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Version   1.3
* Function  Return values needed for archive job
*
* Maintenance
* uuu     yyyy-mm-dd s(999999) ...
* gw      1993-11-25           created
* gw      1994-04-20 s(999999) NAT0924 perform error-routine
* xsetggr 2007-05-04 NOM3201   restow due changes in rmdasd-p
* ----------------------------------------------------------------------
*
DEFINE DATA
PARAMETER USING RMDASD-P
************************************************************************
LOCAL
1 #DEVICE-CHANGE                       (L)
/*SU 2019-02-05 1 #EXTENT-SIZE                         (N9)
1 #FOUND                               (L)
1 #LIMIT                               (N4)
1 #CURRENT                             (N4)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET RMDASD-ERC
IF RMDASD-GDG = 'Y'
  PERFORM GDG-HANDLING
  IF RMDASD-ERC NE 0
    ESCAPE ROUTINE
  END-IF
END-IF
*
PERFORM GET-BEST-VOLSERS
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE GDG-HANDLING
************************************************************************
EXAMINE RMDASD-ARCHIVE-PREFIX FOR '(+1)' DELETE
CALLNAT 'RCHKGDGN' RMDASD-NODE RMDASD-GENERIC-NAME RMDASD-ARCHIVE-PREFIX
  #FOUND #DEVICE-CHANGE #LIMIT #CURRENT /*SU1 RMDASD-VOLSERS (*)
  RMDASD-ERC RMDASD-ERT
IF RMDASD-ERC NE 0
  ESCAPE ROUTINE
END-IF
IF RMDASD-LAST-ARCHIVE-NO <= #LIMIT
  RMDASD-LAST-ARCHIVE-NO := #LIMIT + 1
END-IF
COMPRESS RMDASD-ARCHIVE-PREFIX '.G' RMDASD-LAST-ARCHIVE-NO-A4 'V00'
  TO RMDASD-FULLDSNAME LEAVING NO
*
END-SUBROUTINE /* GDG-HANDLING
*
************************************************************************
DEFINE SUBROUTINE GET-BEST-VOLSERS
************************************************************************
CALLNAT 'RMSPACEN' RMDASD-NODE RMDASD-GENERIC-NAME RMDASD-VOLSERS (1:6)
  RMDASD-VOLSER-STRING RMDASD-SPACE-STRING
  RMDASD-ERC RMDASD-ERT
*
END-SUBROUTINE /* GET-BEST-VOLSERS
*
END
