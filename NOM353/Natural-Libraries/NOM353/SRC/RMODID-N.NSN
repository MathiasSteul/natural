* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    RMODID-N
* Function  Issue unique Order ID
* Version   1.3
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* mrs 93-01-27           created
* sju 04-11-29 nom31     restow for changed NRM-ORDER
* fhi     2010-09-03 NOMALL-97 Extend message line
* ---------------------------------------------------------------------
DEFINE DATA PARAMETER
1 P-ID                    (P10)
1 P-ERC                   (N4)
1 P-ERT                   (A250)
************************************************************************
LOCAL
1 ORDER VIEW OF NRM-ORDER
  2 OD-ID
  2 OD-PARAMETER          (1:1)
  2 REDEFINE OD-PARAMETER
    3 OD-LAST-ID          (P10)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET P-ERC P-ERT
FNDOD. FIND ORDER WITH OD-ID = 9999999999
  IF NO RECORDS FOUND
    OD-ID := 9999999999
    RESET  OD-LAST-ID
  END-NOREC
*
  ADD 1 TO OD-LAST-ID
  P-ID := OD-LAST-ID
*
  IF *NUMBER (FNDOD.) = 0
    STORE ORDER
  ELSE
    UPDATE
  END-IF
*
END-FIND
END OF TRANSACTION
*
************************************************************************
ON ERROR
************************************************************************
  IF *ERROR-NR = 3145
    P-ERC := *ERROR-NR
  ELSE
    P-ERC := 0021
    COMPRESS *ERROR-NR '/' *PROGRAM '/' *ERROR-LINE TO P-ERT LEAVING NO
  END-IF
  ESCAPE ROUTINE
END-ERROR
*
END
