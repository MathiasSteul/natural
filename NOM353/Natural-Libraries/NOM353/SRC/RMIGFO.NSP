* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RMIGFO
* Function:  copy folders of selected user fromt source to target
*                           environment
* Maintenance
* xsetggr 2011-01-31 NOMALL-851 created
* xsetggr 2011-02-24 NOMALL-851 correced
* XSETHZ  2011-04-15 NOMALL-958 corrected
* xsetggr 2011-04-18 NOMALL-851 corrected
* xsetggr 2011-07-27 NOMALL-1031 corrections
* SU1     2013-01-31 unused      Deactivate unused data areas
* SU2     2015-03-30 NOMALL-1598 avoid NAT3061 inv.search buf(LFILE 158)
* ----------------------------------------------------------------------
DEFINE DATA GLOBAL USING NRM-GL
LOCAL USING RLC----L
LOCAL USING RPFK---L
LOCAL USING ROT----L
LOCAL USING RTXT---L
*
LOCAL
1 MIGRATE-REPORTS VIEW OF NRM-MIGRATE-REPORTS /*SU1 in
1 FOLDER VIEW OF NRM-FOLDER
  2 FO-USER-NAME
  2 FO-ID
  2 FO-NAME
  2 FO-DESC
  2 FO-LINKED-FO-ID
1 MIGRATE-FOLDER VIEW OF NRM-MIGRATE-FOLDER
1 US VIEW OF NRM-USERS
1 MIGRATE-USERS VIEW OF NRM-MIGRATE-USERS
*
1 LFILE               (L)
1 #LFILE-RC           (I4)               /*  error-code
1 #LFILE-OLDDBID      (P5)               /*  old DBID
1 #LFILE-OLDFILE      (P5)               /*  old File-Number
1 #LFILE-NEWDBID      (P5)               /*  new DBID
1 #LFILE-NEWFILE      (P5)               /*  new File-Number
*
1 #XREF
  2 #XREF-USER-FOLDER   (A24)
  2 REDEFINE #XREF-USER-FOLDER
    3 #XREF-USER        (A8)
    3 #XREF-NAME        (A16)
  2 #XREF-LINKED
    3 #XREF-LINKED-USER (A8)
    3 #XREF-LINKED-NAME (A16)
    3 #XREF-LINKED-MSG  (A4)
*
1 #FATHER-PROG          (A8)   INIT <'RTRANS'>
1 #I                    (P2)
1 #J                    (P2)
1 #NOFLINES             (I2)   CONST <12>
1 L-SCREEN              (1:#NOFLINES)
  2 L-IDENT             (I2)
  2 L-MARK              (A2)
  2 CV-MARK             (C)
  2 L-FOLDER            (A16)
  2 L-DESC              (A50)
  2 L-ID                (B2)
  2 L-ISN               (P10)
  2 L-LINKED            (A10)
  2 L-EXIST             (A4)
  2 EXIST               (L)
  2 L-MSG               (A7)
1 L-HEADER              (A78)
*
1 CV-TO                 (C)          INIT <(AD=I)>
1 CV-LINES              (C)
1 CV-SELECTION          (C/1:1)
1 REDEFINE CV-SELECTION
  2 CV-SREP             (C)
*
1 #FROM-DB              (P5)
1 #FROM-FILE            (P5)
1 #OLD-DB               (P5)   INIT <999>
1 #OLD-FILE             (P5)   INIT <999>
*
1 CONFIRMED             (L)
1 COPIED                (L)
1 END-OF-PROCESSING     (L)
1 END-OF-DISPLAY        (L)
1 END-OF-DATA           (L)
1 NEW-SEARCH            (L)
*
1 #CF-OBJECT            (A16)
1 #O-NAME               (A25)
1 #S-NAME               (A25) INIT <'*'>
1 #NAME                 (A25)
1 #O-USERID             (A8)
1 #USERID               (A8)
1 #F-NAME               (A25)
1 #T-NAME               (A25)
1 #PAGE                 (P2)  INIT <1>
1 #NOFPAGES             (I2)  CONST <20>
1 #F-USER-NAME          (A24/1:#NOFPAGES)
1 #T-USER-NAME          (A24)
1 #LEN                  (N3)
*
1 F                     (P2)
1 I                     (P2)
1 #LANGUAGE             (I1)
1 #LAN-TAB            (1:5)
  2 #LAN-IDENT        (I2)
  2 #LAN-TEXT         (A70)
1 #ERC                (N4)
1 #COPY-AUTH            (A1) INIT <'N'>
1 #FO-USER-NAME         (A24)
1 REDEFINE #FO-USER-NAME
  2 #FO-USER            (A8)
  2 #FO-NAME            (A16)
1 #FO-USER-ID           (A10)
1 REDEFINE #FO-USER-ID
  2 #FO-USERID          (A8)
  2 #FO-ID              (B2)
1 #FO-NR                (N5)
1 REDEFINE #FO-NR
  2 #FO-NR-A            (A5)
1 #GR-NAME              (A25)
1 #FOLDER               (A25)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
PERFORM INITIALISATION
MAIN. REPEAT
  UNTIL END-OF-PROCESSING
  RESET #I
  RESET INITIAL NEW-SEARCH END-OF-DATA
  REA. READ FOLDER WITH FO-USER-NAME = #F-USER-NAME (#PAGE)
      THRU #T-USER-NAME
    IF #I = #NOFLINES
      PERFORM SCREEN-IO
      IF END-OF-PROCESSING OR NEW-SEARCH
        ESCAPE BOTTOM (REA.)
      END-IF
    END-IF
    ADD 1 TO #I
    PERFORM FOLDER-TO-SCREEN
  END-READ
  IF #I > 0 OR *COUNTER (REA.) = 0
    END-OF-DATA := TRUE
    PERFORM SCREEN-IO
  END-IF
END-REPEAT
PERFORM REFRESH-LFILE
FETCH #FATHER-PROG
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE SCREEN-IO
************************************************************************
IF #I < #NOFLINES
  CV-MARK (#I+1:#NOFLINES) := (AD=DP)
END-IF
CALLNAT 'N-HEADER' L-HEADER G-DATE-FORMAT 'RCTPUSM&'
RESET END-OF-DISPLAY
PERFORM REFRESH-LFILE
REPEAT
  IF #LANGUAGE NE *LANGUAGE
    #LANGUAGE := *LANGUAGE
    CALLNAT 'ROTINI-N' ##EQO-FOLDER G-OBJ-TYPE G-OTB
    PERFORM INIT-LINECOM
    PERFORM PF-KEYS
    INCLUDE RMVHLP-C
    PERFORM INIT-TEXT
    NEW-SEARCH := TRUE
    ESCAPE BOTTOM
  END-IF
  SET CONTROL 'M21'
  DECIDE FOR FIRST CONDITION
    WHEN G-NATRP-ERC NE 0
      IGNORE
    WHEN END-OF-DATA AND #PAGE > 1
      G-NATRP-ERC := 12                   /* bottom of data
    WHEN END-OF-DATA AND #PAGE = 1
      G-NATRP-ERC := 14                   /* all
    WHEN NOT END-OF-DATA AND #PAGE = 1
      G-NATRP-ERC := 11                   /* top of data
    WHEN NONE
      G-NATRP-ERC := 13                   /* more
  END-DECIDE
  PERFORM FLIP-DISPLAY
  INPUT WITH TEXT *G-NATRP-ERC, G-NATRP-ERT MARK *G-DIRECT-COMMAND
    USING MAP 'RMIGFOM&'
*    validation of input values
  IF NOT (#COPY-AUTH = ' ' OR = 'Y' OR = 'N')
    REINPUT *1099 MARK *#COPY-AUTH
  END-IF
  IF #USERID NE G-USERID
    DECIDE FOR FIRST CONDITION
      WHEN #USERID = SCAN '*'         /* user selection
        CALLNAT 'RSELUS1N' #USERID
      WHEN #USERID = ' '
        #USERID := G-USERID
      WHEN NONE
        #US. FIND NUMBER US WITH USER-ID = #USERID
        IF *NUMBER (#US.) = 0
          REINPUT *0002 , #USERID MARK *#USERID
        END-IF
    END-DECIDE
  END-IF
*
  RESET G-NATRP-ERC G-NATRP-ERT
  PERFORM COMMAND-PF-KEY
  UNTIL END-OF-DISPLAY
END-REPEAT
RESET #I L-SCREEN (*)
IF NOT END-OF-PROCESSING
  PERFORM SET-LFILE
END-IF
*
END-SUBROUTINE /* SCREEN-IO
*
************************************************************************
DEFINE SUBROUTINE FOLDER-TO-SCREEN
************************************************************************
L-FOLDER      (#I) := FOLDER.FO-NAME
L-DESC        (#I) := FOLDER.FO-DESC
L-ID          (#I) := FOLDER.FO-ID
L-ISN         (#I) := *ISN (REA.)
L-MSG         (#I) := ' '
L-LINKED      (#I) := FOLDER.FO-LINKED-FO-ID
CV-MARK       (#I) := (AD=I)
/* XSETHZ  2011-04-15 NOMALL-958  --->
#FO-USER-NAME := FOLDER.FO-USER-NAME
IF #FO-NAME = '#Inbasket' OR = '#Listeneingang'
  #FO-NAME := '#Inbasket'
  FT1. FIND NUMBER MIGRATE-FOLDER WITH FO-USER-NAME = #FO-USER-NAME
  IF *NUMBER(FT1.) = 0
    #FO-NAME := '#Listeneingang'
    FT2. FIND NUMBER MIGRATE-FOLDER WITH FO-USER-NAME = #FO-USER-NAME
    IF *NUMBER(FT2.) = 0
      #FO-USER-NAME := FOLDER.FO-USER-NAME
    END-IF
  END-IF
END-IF
FNDF.
/*FIND NUMBER MIGRATE-FOLDER WITH FO-USER-NAME = FOLDER.FO-USER-NAME
FIND NUMBER MIGRATE-FOLDER WITH FO-USER-NAME = #FO-USER-NAME
/* XSETHZ  2011-04-15 NOMALL-958  <---
IF *NUMBER (FNDF.) > 0
  L-EXIST (#I) := #LAN-TEXT (1)
  EXIST          (#I) := TRUE
ELSE
  L-EXIST (#I) := #LAN-TEXT (2)
END-IF
*
END-SUBROUTINE /* FOLDER-TO-SCREEN
*
************************************************************************
DEFINE SUBROUTINE INIT-LINECOM
************************************************************************
G-LC-IDENT (01) := ##EQU-COPY
G-LC-IDENT (02) := ##EQU-XREF                   /* linked folders
G-LC-IDENT (03) := ##EQU-AUTHORIZE
G-LC-NUM               := 3
CALLNAT 'RLCINI-N' G-OBJ-TYPE G-LC G-LCB
CALLNAT 'RFLIPG-N' G-LC G-LINECOM (*)
*
END-SUBROUTINE /* INIT-LINECOM
*
************************************************************************
DEFINE SUBROUTINE PF-KEYS
************************************************************************
PERFORM INIT-PFKEYS
PERFORM SET-PFKEYS
*
END-SUBROUTINE /* PF-KEYS
*
************************************************************************
DEFINE SUBROUTINE COMMAND-PF-KEY
************************************************************************
IF G-DIRECT-COMMAND = ' '
  PERFORM CHECK-PF-KEY
END-IF
DECIDE ON FIRST VALUE OF G-DIRECT-COMMAND             /* test local
  VALUE 'HELP'   REINPUT USING HELP                   /* commands
  VALUE 'EXIT'   END-OF-PROCESSING := TRUE            /* return to
    END-OF-DISPLAY           := TRUE     /* father-prog
  VALUE 'MENU'   END-OF-PROCESSING := TRUE            /* return to
    END-OF-DISPLAY           := TRUE     /* menu
  VALUE 'FLIP'   PERFORM FLIP-HANDLE
  VALUE 'UP'     PERFORM CHECK-MODIFICATIONS
    IF #PAGE > 1 AND NOT NEW-SEARCH AND NOT COPIED
      SUBTRACT 1 FROM #PAGE
      END-OF-DATA := FALSE
      END-OF-DISPLAY := NEW-SEARCH := TRUE
    END-IF
  VALUE 'DOWN'   PERFORM CHECK-MODIFICATIONS
    IF NOT END-OF-DATA AND NOT NEW-SEARCH AND NOT COPIED
      ADD 1 TO #PAGE
      IF #PAGE > #NOFPAGES
        #PAGE := #NOFPAGES
        #F-USER-NAME (1:19) := #F-USER-NAME (2:20)
      END-IF
      #F-USER-NAME (#PAGE) := FOLDER.FO-USER-NAME
      END-OF-DISPLAY           := TRUE
    END-IF
  VALUE 'FOLLOW' PERFORM FOLLOW-MONITOR
  VALUE ' '      PERFORM CHECK-MODIFICATIONS
  ANY            RESET G-DIRECT-COMMAND
  NONE           PERFORM EXECUTE-DIRECT-COMMAND
END-DECIDE
*
END-SUBROUTINE /* COMMAND-PF-KEY
*
************************************************************************
DEFINE SUBROUTINE CHECK-PF-KEY
************************************************************************
G-PF-KEY := *PF-KEY
EXAMINE G-PF-KEY FOR 'PF' REPLACE ' '
MOVE LEFT G-PF-KEY TO G-PF-KEY
IF G-PF-KEY IS (N4)
  G-PF-IND := VAL (G-PF-KEY)
  G-DIRECT-COMMAND := G-PF-CODE (G-PF-IND)
ELSE
  G-PF-FUNC := *PF-KEY
END-IF
*
END-SUBROUTINE /* CHECK-PF-KEY
*
************************************************************************
DEFINE SUBROUTINE EXECUTE-DIRECT-COMMAND
************************************************************************
MOVE LEFT G-DIRECT-COMMAND TO G-DIRECT-COMMAND
IF G-DIRECT-COMMAND IS (N2.1) AND G-DIRECT-COMMAND NE '.'
  COMPRESS '>' G-DIRECT-COMMAND INTO G-DIRECT-COMMAND LEAVING NO
END-IF
FETCH RETURN 'NRMCPR'
SET CONTROL 'WMB'
DECIDE ON FIRST VALUE OF G-NATRP-ERC
  VALUE 0,5,419,420 IGNORE
  VALUE 9999        RESET G-NATRP-ERC
    END-OF-DISPLAY    := END-OF-PROCESSING := TRUE
  VALUE 9998        IGNORE
  VALUE 9997        RESET G-NATRP-ERC
  NONE              REINPUT *G-NATRP-ERC,G-NATRP-ERT
      MARK *G-DIRECT-COMMAND ALARM
END-DECIDE
*
END-SUBROUTINE /* EXECUTE-DIRECT-COMMAND
*
************************************************************************
DEFINE SUBROUTINE CHECK-MODIFICATIONS
************************************************************************
DECIDE FOR EVERY CONDITION
  WHEN #O-NAME NE #S-NAME
    PERFORM INIT-SELECTION-KEYS
    #O-NAME := #S-NAME
  WHEN #O-USERID NE #USERID
    PERFORM INIT-SELECTION-KEYS
    #O-USERID := #USERID
  WHEN #OLD-DB NE G-TARGET-DBID OR #OLD-FILE NE G-TARGET-FNR
    PERFORM CHANGE-LOGICAL-FILE
    #OLD-DB := G-TARGET-DBID
    #OLD-FILE := G-TARGET-FNR
  WHEN ANY
    RESET INITIAL #PAGE
    NEW-SEARCH            := TRUE
    END-OF-DISPLAY := TRUE
  WHEN NONE
    COPIED := FALSE
    RESET L-IDENT (*)
    INCLUDE RLCMTI-C
    FOR #J = 1 TO #I
      DECIDE ON FIRST VALUE OF L-IDENT (#J)
        VALUE ##EQU-COPY   RESET L-MARK (#J)
          IF G-CONFIRM AND EXIST (#J)
            RESET CONFIRMED
            #CF-OBJECT := L-FOLDER (#J)
            CALLNAT 'RMIGCFF' #CF-OBJECT CONFIRMED
          ELSE
            CONFIRMED := TRUE
          END-IF
          IF CONFIRMED
            PERFORM SET-LFILE /*SU2
            FNDUS. FIND NUMBER MIGRATE-USERS WITH USER-ID = #USERID
            IF *NUMBER(FNDUS.) = 0
              REINPUT *4032 ,#USERID  MARK *#USERID
            END-IF
            PERFORM MIGRATION
            PERFORM REFRESH-LFILE /*SU2
          END-IF
          IF G-NATRP-ERC NE 0
            ESCAPE BOTTOM
          END-IF
        VALUE ##EQU-XREF
          RESET  #XREF L-MARK(#J)
          #XREF-USER := #USERID
          #XREF-NAME := L-FOLDER(#J)
          PERFORM SET-LFILE
          CALLNAT 'RMIGFOXR' G-NATRP-ERC #XREF #LAN-TEXT (*)
          PERFORM REFRESH-LFILE
          IF G-NATRP-ERC = 0
            SET CONTROL 'WMFL50C18B04/12'
            INPUT USING MAP 'RMIGFOW&'
            SET CONTROL 'WMB'
          ELSE
            G-NATRP-ERT := #XREF-NAME
          END-IF
        VALUE ##EQU-AUTHORIZE RESET L-MARK(#J)
          PERFORM FIND-AUTH-FOLDER-NAME
          G-FATHER-PROG:= *PROGRAM
          G-C-OBJTYPE:= 'F'
          G-C-OBJNAME:= #GR-NAME
          G-C-USERID := #USERID
          FETCH RETURN 'RLISGR'
        NONE IGNORE
      END-DECIDE
    END-FOR
END-DECIDE
*
END-SUBROUTINE /* CHECK-MODIFICATIONS
*
************************************************************************
DEFINE SUBROUTINE INIT-SELECTION-KEYS
************************************************************************
RESET #FO-USER-NAME #F-NAME #T-NAME
#FO-USER := #USERID
#NAME    := #S-NAME
#LEN := 16
CALLNAT 'SELALPHA' #NAME #F-NAME #T-NAME #LEN
*
#FO-NAME := #F-NAME
#F-USER-NAME(1) := #FO-USER-NAME
*
#FO-NAME := #T-NAME
#T-USER-NAME := #FO-USER-NAME
*
END-SUBROUTINE /* INIT-SELECTION-KEYS
*
************************************************************************
DEFINE SUBROUTINE FIND-AUTH-FOLDER-NAME
************************************************************************
RESET #GR-NAME #FO-USER-ID #FO-NR
IF L-LINKED(#J) > ' '
  #FO-USER-ID := L-LINKED(#J)
  #FO-NR := #FO-ID
  COMPRESS #FO-USERID #FO-NR-A TO #GR-NAME LEAVING NO
ELSE
  #FO-NR := L-ID(#J)
  COMPRESS #USERID #FO-NR-A INTO #GR-NAME  LEAVING NO
END-IF
*
END-SUBROUTINE /* FIND-AUTH-FOLDER-NAME
*
************************************************************************
DEFINE SUBROUTINE CHANGE-LOGICAL-FILE
************************************************************************
DECIDE FOR FIRST CONDITION
  WHEN G-TARGET-DBID < 1
    REINPUT *0635 MARK *G-TARGET-DBID  /* reinput valid dbid
  WHEN G-TARGET-FNR < 1
    REINPUT *0636 MARK *G-TARGET-FNR   /* reinput file-number
  WHEN G-TARGET-FNR  = #FROM-FILE AND
      G-TARGET-DBID = #FROM-DB
    REINPUT *4004 MARK *G-TARGET-DBID  /* same environment
  WHEN NONE
    PERFORM SET-LFILE
    FNDC.
    FIND NUMBER MIGRATE-REPORTS
      WITH R-REPNAME = 'NOM-CONTROL-REC'
    IF *NUMBER (FNDC.) = 0
      PERFORM REFRESH-LFILE
      REINPUT *4005 MARK *G-TARGET-DBID
    END-IF
    CALLNAT 'RMIGCHKU' G-USERID #ERC
    IF #ERC NE 0
      PERFORM REFRESH-LFILE
    END-IF
    DECIDE ON FIRST VALUE OF #ERC
      VALUE 4032
        REINPUT *4032,G-USERID MARK *G-TARGET-DBID
      VALUE 4033
        REINPUT *4033,G-USERID MARK *G-TARGET-DBID
      NONE VALUE IGNORE
    END-DECIDE
END-DECIDE
*
END-SUBROUTINE /* CHANGE-LOGICAL-FILE
*
************************************************************************
DEFINE SUBROUTINE SET-LFILE
************************************************************************
IF NOT LFILE
  IF G-TARGET-FNR > 0
    #LFILE-NEWDBID := G-TARGET-DBID
    #LFILE-NEWFILE := G-TARGET-FNR
    CALLNAT 'RMIGSFIL' #LFILE-RC #LFILE-NEWDBID #LFILE-NEWFILE
    IF #LFILE-RC NE 0
      G-NATRP-ERC := 4007
      G-NATRP-ERT := #LFILE-RC
    ELSE
      LFILE := TRUE
    END-IF
  END-IF
END-IF
*
END-SUBROUTINE /* SET-LFILE
*
************************************************************************
DEFINE SUBROUTINE REFRESH-LFILE
************************************************************************
IF LFILE
  RESET #LFILE-RC
  CALLNAT 'RMIGSFIL' #LFILE-RC #LFILE-OLDDBID #LFILE-OLDFILE
  IF #LFILE-RC NE 0
    G-NATRP-ERC := 4008
    G-NATRP-ERT := #LFILE-RC
  ELSE
    LFILE := FALSE
  END-IF
END-IF
*
END-SUBROUTINE /* REFRESH-LFILE
*
************************************************************************
DEFINE SUBROUTINE GET-LFILE
************************************************************************
RESET #LFILE-RC
CALLNAT 'RMIGGFIL' #LFILE-RC #LFILE-OLDDBID #LFILE-OLDFILE
IF #LFILE-RC NE 0
  G-NATRP-ERC := 4006
  G-NATRP-ERT := #LFILE-RC
END-IF
*
END-SUBROUTINE /* GET-LFILE
*
************************************************************************
DEFINE SUBROUTINE INITIALISATION
************************************************************************
IF G-USER-TYPE NE 'A'
  G-NATRP-ERC := 0020
  #FATHER-PROG := 'RMENU'
  END-OF-PROCESSING := TRUE
END-IF
*
IF G-C-USERID > ' '
  #USERID := G-C-USERID /* set previous user when returning from RLISGR
ELSE
  #USERID  := G-USERID                    /* at start list own folder
END-IF
*
DECIDE FOR EVERY CONDITION
  WHEN NOT END-OF-PROCESSING
    INCLUDE CVIDEO
    G-FLIP-STATUS := 'P'
    #FROM-DB      := G-NATRP-DBID
    #FROM-FILE    := G-NATRP-FNR
    END-OF-DATA   := TRUE
  WHEN NOT END-OF-PROCESSING
  PERFORM GET-LFILE                            /* get physical DBID,File
    IF #LFILE-RC NE 0                            /* of logical file 186
      END-OF-PROCESSING := TRUE
    END-IF
  WHEN NOT END-OF-PROCESSING
    IF G-NATRP-ERC = 0
      G-NATRP-ERC := 4036            /* please enter target & user
    END-IF
    PERFORM SCREEN-IO
  WHEN NONE
    IGNORE
END-DECIDE
*
END-SUBROUTINE /* INITIALISATION
*
************************************************************************
DEFINE SUBROUTINE MIGRATION
************************************************************************
PERFORM SET-LFILE
#FO-NR   := L-ID(#J)
#FOLDER  := L-FOLDER(#J)
G-C-USERID := #USERID
CALLNAT 'RMIGFOCO' G-NATRP-ERC G-C-USERID L-ID(#J) #FOLDER #COPY-AUTH
PERFORM REFRESH-LFILE
DECIDE FOR FIRST CONDITION
  WHEN G-NATRP-ERC NE 0
    L-MSG (#J) := #LAN-TEXT (3)
    G-NATRP-ERT := #FOLDER
  WHEN EXIST (#J)
    L-MSG (#J) := #LAN-TEXT (5)
  WHEN NONE
    L-MSG (#J) := #LAN-TEXT (4)
    EXIST (#J) := TRUE
    L-EXIST (#J) := #LAN-TEXT (1)
END-DECIDE
COPIED := TRUE
*
END-SUBROUTINE /* MIGRATION
*
************************************************************************
DEFINE SUBROUTINE INIT-TEXT
************************************************************************
#LAN-IDENT (1) := ##TXT-YES
#LAN-IDENT (2) := ##TXT-NO
#LAN-IDENT (3) := ##TXT-ERROR
#LAN-IDENT (4) := ##TXT-COPIED
#LAN-IDENT (5) := ##TXT-REPLACED
*
FOR I = 1 TO 5
  CALLNAT 'RLTINI-N' #LAN-IDENT (I) #LAN-TEXT  (I) G-TXB
END-FOR
*
END-SUBROUTINE /* INIT-TEXT
*
************************************************************************
DEFINE SUBROUTINE INIT-PFKEYS
************************************************************************
INCLUDE RPFSTD-C
INCLUDE RPFBRW-C
CALLNAT 'RPFINI-N' G-PF G-PFB
*
END-SUBROUTINE /* INIT-PFKEYS
*
************************************************************************
ON ERROR
************************************************************************
  BACKOUT TRANSACTION
  IF LFILE
    CALLNAT 'RMIGSFIL' #LFILE-RC #LFILE-OLDDBID #LFILE-OLDFILE
    LFILE := FALSE
  END-IF
  DECIDE ON FIRST *ERROR-NR
    VALUE 3017   G-NATRP-ERC := 4001
* xsetggr 2011-07-27 NOMALL-1031 insert next line
      G-NATRP-ERT := *ERROR-NR
    VALUE 3148   G-NATRP-ERC := 4001
* xsetggr 2011-07-27 NOMALL-1031 insert next line
      G-NATRP-ERT := *ERROR-NR
    VALUE 3061   G-NATRP-ERC := 4005
*   ANY          FETCH 'RMIGUS'
* xsetggr 2011-07-27 NOMALL-1031 insert next line
    ANY          FETCH 'RMIGFO'
    NONE         IGNORE
  END-DECIDE
END-ERROR
*
INCLUDE RPFSET-C /* set-pfkeys
*
END
