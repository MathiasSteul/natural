* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* **********************************************************************
* MEMBER       NOM_MASK
* Version      1.3
*
* Function  :  Compare a key to see if it mataches its mask
*              this program should be used with NOM__KEY
*
* xsethz  2000-07-31 (CE7461) new parameter string
* Parameters:  LENGTH 72 BYTES
*      1-17  = Masked Key format
*     17-34  = Key to be compared
*        35  = 'Y' if matached ok.
*        36  = Mask character.
*
* xsethz  2000-07-31 (CE7461) end
**Parameters:  LENGTH 72 BYTES
**     1-17  = Masked Key format
**    17-34  = Key to be compared
**       35  = 'Y' if matached ok.
**       36  = Mask character.
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* JVD 97-11-20 p(167575) CREATED
* xsethz  2000-07-31 (CE7461) Extend Report and Bundle Names
* --------------------------------------------------------------------
DEFINE DATA PARAMETER
1 #PARAM              (A52)
1 REDEFINE #PARAM
  2 #PARM-MASK        (A25)
  2 REDEFINE #PARM-MASK
    3 #PARM-MASKI     (A1/25)
  2 #PARM-KEY         (A25)
  2 REDEFINE #PARM-KEY
    3 #PARM-KEYI      (A1/25)
  2 #PARM-RESULT      (A1)
  2 #PARM-MASK-C      (A1)
************************************************************************
LOCAL
1 #OK          (A1) INIT <'Y'>
1 #FAILED      (A1) INIT <'N'>
1 #IND         (N2) INIT <25>
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET #PARM-RESULT
REPEAT UNTIL #IND < 1
  IF #PARM-MASKI(#IND) NE #PARM-MASK-C
    IF #PARM-MASKI(#IND) =  #PARM-KEYI(#IND) /* Matched
      #PARM-RESULT := #OK
    ELSE
      #PARM-RESULT := #FAILED
      ESCAPE BOTTOM
    END-IF
  END-IF
  SUBTRACT 1 FROM #IND
END-REPEAT
*
END
