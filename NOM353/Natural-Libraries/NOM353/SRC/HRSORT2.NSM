DEFINE DATA PARAMETER
1 #CODE (A001)
END-DEFINE
FORMAT PS=015 LS=051 ZP=OFF SG=OFF KD=OFF IP=OFF
* MAP2: MAP PROFILES *****************************        410***********
* .TTAAAMMOO   D I D I N D I D I        ?_)^&:+(   00000               *
* 015050        N0NNUCN             X        01 SYSPROF NLH          1 *
************************************************************************
INPUT          (     IP=OFF                                           /*
                                                                       )
 004T 'Sort Flag fuer selektierte Aktive Reports'(I)
/
/
 001T 'Dieses Flag wirkt, wenn aktive Reports in Fach'
/
 001T 'nach Report-Name selektiert wurden.'
/
 001T 'Es sind 2 Werte moeglich:'
/
/
 008T 'D'(I)
 011T 'Active Reports werden in die Liste'
/
 011T 'nach Datum/Uhrzeit sortiert.'
/
/
 008T 'N'(I)
 011T 'Active Reports werden in die Liste'
/
 011T 'nach Report-Name'
 029T 'sortiert'
/
 011T '(Defaultwert).'
/
/
 009T 'Auswahl'(I)
 017T '=>'
 021T #CODE  (AD=MILT'_' ) /*.99U001 A001 .
/
* MAP2: VALIDATION *****************************************************
RULEVAR F00#CODE
INCDIC                                 ;
IF NOT (& = 'D' OR = 'N')
REINPUT *682
ALARM
END-IF
SET CONTROL 'Q'
* MAP2: END OF MAP *****************************************************
END
