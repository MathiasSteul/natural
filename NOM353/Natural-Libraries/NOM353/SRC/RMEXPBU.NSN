DEFINE DATA
PARAMETER USING XXUX---P
PARAMETER USING RMEXP-A
PARAMETER
1 #TRACING               (L)
1 #ID                    (A250) BY VALUE OPTIONAL
/***********************************************************************
INDEPENDENT
1 +ID                    (A/*) DYNAMIC
1 +ID-INDEX              (I2)
/***********************************************************************
/*SU4 LOCAL USING RMEXPBUL
LOCAL USING RMBAS64P
LOCAL USING VUXDEF-L
/*SU2 LOCAL USING VMONITUL /* NOMALL-2215 fhi in
LOCAL USING N-41002L /*SU1
/***********************************************************************
LOCAL
1 BU VIEW OF NRM-BUNDLES /*SU4 was RMEXPBUL
  2 B-OBJECT-TYPE        (A10)
  2 B-OBJECT-TIME        (T)
  2 B-BUNDLE             (A25)
  2 B-MASTER-REPNAME     (A25)
  2 B-BUNDRNB            (P11)
  2 B-USERID             (A8)
  2 B-DESC               (A50)
  2 B-COORDINATOR-ID     (A8)
  2 B-BUNDLE-STATUS      (A2)
  2 B-HOLD               (A1)
  2 B-SEPNO              (P3)
  2 B-SEPMEM             (A16)
  2 B-PRINT-LIST         (A11/1:20)
  2 B-PRINT-JOBCARD      (A72/1:3)
  2 B-FLUSH-TIME         (T)
  2 B-FLUSH-EVENTS
    3 B-FLUSH-REPORTS    (A25/1:191)
  2 B-LAST-MODIFIED      (T)
  2 B-MODIFIED-BY        (A8)
  2 B-FLAG-REPSEP        (A1)
  2 B-FLAG-PAGENO        (A1)
