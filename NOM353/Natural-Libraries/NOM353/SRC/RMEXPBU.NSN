*
************************************************************************
* Main line
************************************************************************
*
PERFORM #START
READ BU BY B-BUNDLE = #KEY-FROM THRU #KEY-TO
  #KEY := B-BUNDLE
  PERFORM HANDLE-MASK
* Get depending objects:
  INCLUDE RMLD2XC2 '20' 'B-PRINT-LIST' '''RMEXPPR'''
  INCLUDE RMLD2XC1 'B-FLUSH-CALENDAR' '''RMEXPCA'''
  INCLUDE RMLD2XC3 'B-BUNDLE' '''B''' /*RMEXPGR
  COMPRESS '<BU depending="' #DEP '">' TO #WORK-LINE LEAVING NO
  PERFORM WRITE-XML
  IF #OD-LOG = 'Y'
    IF #ID SPECIFIED
      COMPRESS 'Exported: BU */' B-BUNDLE TO #TRACE-MSG
    ELSE
      COMPRESS 'Exported: BU /' B-BUNDLE TO #TRACE-MSG
    END-IF
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    END TRANSACTION
  END-IF
  MOVE EDITED BU.B-OBJECT-TIME (EM=YYYY'-'MM'-'DD'-'HH':'II':'SS'.'T)
    TO #B-OBJECT-TIME
  MOVE EDITED BU.B-FLUSH-TIME (EM=YYYY'-'MM'-'DD'-'HH':'II':'SS'.'T)
    TO #B-FLUSH-TIME
  MOVE EDITED BU.B-LAST-MODIFIED (EM=YYYY'-'MM'-'DD'-'HH':'II':'SS'.'T)
    TO #B-LAST-MODIFIED
  MOVE EDITED BU.B-LAST-UPDATE (EM=YYYY'-'MM'-'DD'-'HH':'II':'SS'.'T)
    TO #B-LAST-UPDATE
  #FIELD := 'B-OBJECT-TYPE'
  #VALUE :=  BU.B-OBJECT-TYPE
  PERFORM CONVERT-XML
  #FIELD := 'B-OBJECT-TIME'
  #VALUE :=  #B-OBJECT-TIME
  PERFORM CONVERT-XML
  #FIELD := 'B-BUNDLE'
  #VALUE :=  BU.B-BUNDLE
  PERFORM CONVERT-XML
  #FIELD := 'B-MASTER-REPNAME'
  #VALUE :=  BU.B-MASTER-REPNAME
  PERFORM CONVERT-XML
  #FIELD := 'B-BUNDRNB'
  #VALUE :=  BU.B-BUNDRNB
  MOVE LEFT #VALUE TO #VALUE
  PERFORM CONVERT-XML
  #FIELD := 'B-USERID'
  #VALUE :=  BU.B-USERID
  PERFORM CONVERT-XML
  #FIELD := 'B-DESC'
  #VALUE :=  BU.B-DESC
  PERFORM CONVERT-XML
  #FIELD := 'B-COORDINATOR-ID'
  #VALUE :=  BU.B-COORDINATOR-ID
  PERFORM CONVERT-XML
  #FIELD := 'B-BUNDLE-STATUS'
  #VALUE :=  BU.B-BUNDLE-STATUS
  PERFORM CONVERT-XML
  #FIELD := 'B-HOLD'
  #VALUE :=  BU.B-HOLD
  PERFORM CONVERT-XML
  #FIELD := 'B-SEPNO'
  #VALUE :=  BU.B-SEPNO
  MOVE LEFT #VALUE TO #VALUE
  PERFORM CONVERT-XML
  #FIELD := 'B-SEPMEM'
  #VALUE :=  BU.B-SEPMEM
  PERFORM CONVERT-XML
  FOR #L := 20 TO 1 STEP -1
    IF BU.B-PRINT-LIST (#L) NE ' '
      ESCAPE BOTTOM
    END-IF
  END-FOR
  FOR #I = 1 TO #L
    #FIELD := 'B-PRINT-LIST'
    #VALUE :=  BU.B-PRINT-LIST(#I)
    PERFORM CONVERT-XML1
  END-FOR
  FOR #L := 3 TO 1 STEP -1
    IF BU.B-PRINT-JOBCARD (#L) NE ' '
      ESCAPE BOTTOM
    END-IF
  END-FOR
  FOR #I = 1 TO #L
    #FIELD := 'B-PRINT-JOBCARD'
    #VALUE :=  BU.B-PRINT-JOBCARD(#I)
    PERFORM CONVERT-XML1
  END-FOR
  #FIELD := 'B-FLUSH-TIME'
  #VALUE :=  #B-FLUSH-TIME
  PERFORM CONVERT-XML
  FOR #L := 191 TO 1 STEP -1
    IF BU.B-FLUSH-REPORTS (#L) NE ' '
      ESCAPE BOTTOM
    END-IF
  END-FOR
  FOR #I = 1 TO #L
    #FIELD := 'B-FLUSH-REPORTS'
    #VALUE :=  BU.B-FLUSH-REPORTS(#I)
    PERFORM CONVERT-XML1
  END-FOR
  #FIELD := 'B-LAST-MODIFIED'
  #VALUE :=  #B-LAST-MODIFIED
  PERFORM CONVERT-XML
  #FIELD := 'B-MODIFIED-BY'
  #VALUE :=  BU.B-MODIFIED-BY
  PERFORM CONVERT-XML
  #FIELD := 'B-FLAG-REPSEP'
  #VALUE :=  BU.B-FLAG-REPSEP
  PERFORM CONVERT-XML
  #FIELD := 'B-FLAG-PAGENO'
  #VALUE :=  BU.B-FLAG-PAGENO
  PERFORM CONVERT-XML
  #FIELD := 'B-RETENTION-ACTION'
  #VALUE :=  BU.B-RETENTION-ACTION
  PERFORM CONVERT-XML
  #FIELD := 'B-RETENTION-PERIOD'
  #VALUE :=  BU.B-RETENTION-PERIOD
  PERFORM CONVERT-XML
  #FIELD := 'B-RETENTION-PERIOD-PURGE'
  #VALUE :=  BU.B-RETENTION-PERIOD-PURGE
  PERFORM CONVERT-XML
  #FIELD := 'B-FLUSH-UNTIL'
  #VALUE :=  BU.B-FLUSH-UNTIL
  MOVE LEFT #VALUE TO #VALUE
  PERFORM CONVERT-XML
  #FIELD := 'B-FLUSH-INTERVAL'
  #VALUE :=  BU.B-FLUSH-INTERVAL
  MOVE LEFT #VALUE TO #VALUE
  PERFORM CONVERT-XML
  #FIELD := 'B-FLUSH-LINES'
  #VALUE :=  BU.B-FLUSH-LINES
  MOVE LEFT #VALUE TO #VALUE
  PERFORM CONVERT-XML
  FOR #L := 31 TO 1 STEP -1
    IF BU.B-FLUSH-DAYS (#L) NE ' '
      ESCAPE BOTTOM
    END-IF
  END-FOR
  FOR #I = 1 TO #L
    #FIELD := 'B-FLUSH-DAYS'
    #VALUE :=  BU.B-FLUSH-DAYS(#I)
    PERFORM CONVERT-XML1
  END-FOR
  FOR #L := 7 TO 1 STEP -1
    IF BU.B-FLUSH-WEEK-DAYS (#L) NE ' '
      ESCAPE BOTTOM
    END-IF
  END-FOR
  FOR #I = 1 TO #L
    #FIELD := 'B-FLUSH-WEEK-DAYS'
    #VALUE :=  BU.B-FLUSH-WEEK-DAYS(#I)
    PERFORM CONVERT-XML1
  END-FOR
  #FIELD := 'B-FLUSH-CALENDAR'
  #VALUE :=  BU.B-FLUSH-CALENDAR
  PERFORM CONVERT-XML
  #FIELD := 'B-FLUSH-BEFORE-AFTER'
  #VALUE :=  BU.B-FLUSH-BEFORE-AFTER
  PERFORM CONVERT-XML
  #FIELD := 'B-FLUSH-START'
  #VALUE :=  BU.B-FLUSH-START
  PERFORM CONVERT-XML
  #FIELD := 'B-FLUSH-END'
  #VALUE :=  BU.B-FLUSH-END
  PERFORM CONVERT-XML
  #FIELD := 'B-FLUSH-INT'
  #VALUE :=  BU.B-FLUSH-INT
  PERFORM CONVERT-XML
  #FIELD := 'B-FLUSH-TIME-SCHEDULE'
  #VALUE :=  BU.B-FLUSH-TIME-SCHEDULE
  PERFORM CONVERT-XML
  #FIELD := 'B-JOBNAME'
  #VALUE :=  BU.B-JOBNAME
  PERFORM CONVERT-XML
  #FIELD := 'B-CONTROL-EXITLIB'
  #VALUE :=  BU.B-CONTROL-EXITLIB
  PERFORM CONVERT-XML
  #FIELD := 'B-CONTROL-EXITMEM'
  #VALUE :=  BU.B-CONTROL-EXITMEM
  PERFORM CONVERT-XML
  #FIELD := 'B-LAST-UPDATE'
  #VALUE :=  #B-LAST-UPDATE
  PERFORM CONVERT-XML
  #FIELD := 'B-LAST-UPDATE-USER'
  #VALUE :=  BU.B-LAST-UPDATE-USER
  PERFORM CONVERT-XML
*
  PERFORM #END-OBJ
END-READ
PERFORM #END
