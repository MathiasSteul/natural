  2 B-CONTROL-EXITLIB    (A8)
  2 B-CONTROL-EXITMEM    (A8)
  2 B-LAST-UPDATE        (T)
  2 B-LAST-UPDATE-USER   (A16)
1 WRITE-FILE VIEW OF WRITE-FILE
  2 ERROR-CODE
  2 ERROR-TEXT
*
1 #FIELD                 (A32)
1 #VALUE                 (A300)
1 #LEN                   (I4)
1 #WORK-LINE             (A250)
1 #FUNCTION              (A10)
