* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
*********************************************************************************
***                            RGETLIB                                        ***
***   Return active NOM library: Monitor ID that was active within last day   ***
***                                                                           ***
***   fhi/SAG 02/2009; 08/2011                                                ***
*********************************************************************************
* MAINTENANCE:
* User ID yyyy-mm-dd Mark      Comment
* fhi     2009-04-14 P315875   Return value even if no database access possible
* fhi     2011-08-10 NOMALL-1049 Calculate library correctly, rewritten ossible
* fhi     2015-08-26 NOMALL-1706 Backout NOMALL-1506                    ossible
* SU1     2018-04-09             NOM 3.5: performance: use AIV
*********************************************************************************
DEFINE DATA
PARAMETER
1 LIBRARY               (A8)
************************************************************************
INDEPENDENT
1 +NOM-LIBRARY (A8) /*see XFGETMSG SU1
* *****
LOCAL
1 NOMCHCKP-PARMS
  2 MODULE              (A8)    INIT <'RMINIT'>
  2 ERC                 (N4)
  2 ERT                 (A250)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
IF +NOM-LIBRARY NE ' ' /*SU1
  LIBRARY := +NOM-LIBRARY
  ESCAPE MODULE /*RGETLIB
END-IF
PERFORM NOMCHCKP-CHECK-PROG NOMCHCKP-PARMS LIBRARY
IF LIBRARY = ' ' OR ERC NE 0
*   OR LIBRARY NE MASK('SYS') /* NOMALL-1506 fhi in, NOMALL-1706 out
  LIBRARY := *LIBRARY-ID
END-IF
*
************************************************************************
ON ERROR
************************************************************************
  LIBRARY := *LIBRARY-ID
  ESCAPE ROUTINE
*
END-ERROR
*
END
