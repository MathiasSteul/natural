#EXPORT-PROG := &2&
COMPRESS SUBSTR(#EXPORT-PROG,6,2) &1& TO #ID-MEMBER LEAVING NO
EXAMINE +ID(*) FOR #ID-MEMBER GIVING INDEX #IND
IF #IND = 0
  CALLNAT &2& XXUX---P #EXPORT #TRACING &1& /*SU1 was ORDER
  IF #OD-ERROR-CODE NE 0
    ESCAPE MODULE
  END-IF
  IF +ID-INDEX GE *OCC(+ID)
    #IND := +ID-INDEX + 10
    EXPAND ARRAY +ID TO (1:#IND)
  END-IF
  ADD 1 TO +ID-INDEX
  +ID (+ID-INDEX) := #ID-MEMBER
END-IF
** End of Copycode RMLD2XC1 ********************************************
