* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RMSPL7-N - Convert job numbers  from 5 digit to 7 digit format
*            Convert node numbers from 3 digit to 5 digit format
*
* Creation and Maintenance History
* uuu     yyyy-mm-dd s(999999) ...
* fhi     2005-04-21 s(999999) created from RMSR7--N
* fhi     2006-07-10 s(281684) ASA characters disappear at printout time
* xsetggr 2007-05-14 NOM3201   add converting node numbers from 3 digit
*                              to 5 digit format
* fhi     2007-07-12 NOM3202   C-NATERR changed, NAD23006 is obsolete.
* xsetggr 2008-05-05 p(304350) restow due to changes in RMSPL--L
* fhi     2009-08-07 P319465   Wrong conversion for new node numbers
* xsetggr 2009-08-13 P319465   use RMSPL5-L first, then RMSPL3-L
* fhi     2009-08-17 P319465   Analyzed and rewritten, without tags.
* xsetggr 2009-10-09 P320826   correct if Power segments field is blank
* fhi     2010-09-03 NOMALL-97 Extend message line
* fhi     2010-09-21 NOMALL-97 Use no more C-NATERR but C-NATERN instead
* SU1     2024-03-07 ES-34613    NOM 3.6 Remove power
* ----------------------------------------------------------------------
*
DEFINE DATA PARAMETER
1 SPOOL-ATTRIBUTES     (A250)
1 P-SPOOLTYPE          (I2)
************************************************************************
LOCAL USING RMSR---E
LOCAL USING RMSPL--L
LOCAL USING RMSPL3-L
LOCAL USING RMSPL5-L
LOCAL
1 P-ERC                (N4)
1 P-ERT                (A250)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#SPOOL-ATTR-3 := #SPOOL-ATTR-5 := #SPOOL-ATTRIBUTES := SPOOL-ATTRIBUTES
DECIDE ON FIRST VALUE OF P-SPOOLTYPE
/*SU1  VALUE POWER
  VALUE JES2,JES3
    IF #SPOOL-JES-NODE-A NE MASK(NNNNN)     /* IF equal, NOM 3.2 format
      RESET #SPOOL-ATTRIBUTES
      IF #SPOOL3-JES-JOB-NUMBER-A NE MASK(NNNNNNN)    /* NOM 2.2 format
        #SPOOL-TYPE               := #SPOOL5-TYPE
        #SPOOL-JES-NODE           := #SPOOL5-JES-NODE
        #SPOOL-JES-JOB-NAME       := #SPOOL5-JES-JOB-NAME
        #SPOOL-JES-JOB-NUMBER     := #SPOOL5-JES-JOB-NUMBER
        #SPOOL-JES-DSTYPE         := #SPOOL5-JES-DSTYPE
        #SPOOL-JES-DSNO-OLD       := #SPOOL5-JES-DSNO-OLD
        #SPOOL-JES-DATASET-KEY    := #SPOOL5-JES-DATASET-KEY
        #SPOOL-JES-GROUP-ID       := #SPOOL5-JES-GROUP-ID
        #SPOOL-JES-PROCNAME       := #SPOOL5-JES-PROCNAME
        #SPOOL-JES-STEPNAME       := #SPOOL5-JES-STEPNAME
        #SPOOL-JES-DDNAME         := #SPOOL5-JES-DDNAME
        #SPOOL-JES-CHARS          := #SPOOL5-JES-CHARS
        #SPOOL-JES-FCB            := #SPOOL5-JES-FCB
        #SPOOL-JES-FLASH          := #SPOOL5-JES-FLASH
        #SPOOL-JES-FORM           := #SPOOL5-JES-FORM
        #SPOOL-JES-FORMDEF        := #SPOOL5-JES-FORMDEF
        #SPOOL-JES-PAGEDEF        := #SPOOL5-JES-PAGEDEF
        #SPOOL-JES-TRC            := #SPOOL5-JES-TRC
        #SPOOL-JES-RECFM          := #SPOOL5-JES-RECFM
        #SPOOL-JES-COPIES         := #SPOOL5-JES-COPIES
        #SPOOL-JES-UCS            := #SPOOL5-JES-UCS
        #SPOOL-JES-BURST          := #SPOOL5-JES-BURST
        #SPOOL-JES-COMPACT        := #SPOOL5-JES-COMPACT
        #SPOOL-JES-LINECT         := #SPOOL5-JES-LINECT
        #SPOOL-JES-DESTINATION    := #SPOOL5-JES-DESTINATION
        #SPOOL-JES-TRIGGER-DSNAME := #SPOOL5-JES-TRIGGER-DSNAME
        #SPOOL-JES-DSNO := #SPOOL5-JES-DSNO
      ELSE  /* NOM 3.1 format
        #SPOOL-TYPE := #SPOOL3-TYPE
        #SPOOL-JES-NODE := #SPOOL3-JES-NODE
        #SPOOL-JES-JOB-NAME       := #SPOOL3-JES-JOB-NAME
        #SPOOL-JES-JOB-NUMBER     := #SPOOL3-JES-JOB-NUMBER
        #SPOOL-JES-DSTYPE         := #SPOOL3-JES-DSTYPE
        #SPOOL-JES-DSNO-OLD       := #SPOOL3-JES-DSNO-OLD
        #SPOOL-JES-DATASET-KEY    := #SPOOL3-JES-DATASET-KEY
        #SPOOL-JES-GROUP-ID       := #SPOOL3-JES-GROUP-ID
        #SPOOL-JES-PROCNAME       := #SPOOL3-JES-PROCNAME
        #SPOOL-JES-STEPNAME       := #SPOOL3-JES-STEPNAME
        #SPOOL-JES-DDNAME         := #SPOOL3-JES-DDNAME
        #SPOOL-JES-CHARS          := #SPOOL3-JES-CHARS
        #SPOOL-JES-FCB            := #SPOOL3-JES-FCB
        #SPOOL-JES-FLASH          := #SPOOL3-JES-FLASH
        #SPOOL-JES-FORM           := #SPOOL3-JES-FORM
        #SPOOL-JES-FORMDEF        := #SPOOL3-JES-FORMDEF
        #SPOOL-JES-PAGEDEF        := #SPOOL3-JES-PAGEDEF
        #SPOOL-JES-TRC            := #SPOOL3-JES-TRC
        #SPOOL-JES-RECFM          := #SPOOL3-JES-RECFM
        #SPOOL-JES-COPIES         := #SPOOL3-JES-COPIES
        #SPOOL-JES-UCS            := #SPOOL3-JES-UCS
        #SPOOL-JES-BURST          := #SPOOL3-JES-BURST
        #SPOOL-JES-COMPACT        := #SPOOL3-JES-COMPACT
        #SPOOL-JES-LINECT         := #SPOOL3-JES-LINECT
        #SPOOL-JES-DESTINATION    := #SPOOL3-JES-DESTINATION
        #SPOOL-JES-TRIGGER-DSNAME := #SPOOL3-JES-TRIGGER-DSNAME
        #SPOOL-JES-DSNO           := #SPOOL3-JES-DSNO
      END-IF
    END-IF
  VALUE SEQUENTIAL-FILE-BS2
    IF #SPOOL-BS2-NODE-A NE MASK(NNNNN)
      RESET #SPOOL-ATTRIBUTES
      #SPOOL-TYPE                  := #SPOOL3-TYPE
      #SPOOL-BS2-NODE              := #SPOOL3-BS2-NODE
      #SPOOL-BS2-JOB-NAME          := #SPOOL3-BS2-JOB-NAME
      #SPOOL-BS2-USER-ID           := #SPOOL3-BS2-USER-ID
      #SPOOL-BS2-JOB-ID            := #SPOOL3-BS2-JOB-ID
      #SPOOL-BS2-ORIGINATOR-JOB-ID := #SPOOL3-BS2-ORIGINATOR-JOB-ID
      #SPOOL-BS2-COPIES            := #SPOOL3-BS2-COPIES
      #SPOOL-BS2-FORM              := #SPOOL3-BS2-FORM
      #SPOOL-BS2-CHARS             := #SPOOL3-BS2-CHARS
      #SPOOL-BS2-DSNAME            := #SPOOL3-BS2-DSNAME
      #SPOOL-BS2-CONTROL-OPTION    := #SPOOL3-BS2-CONTROL-OPTION
      #SPOOL-BS2-DESTINATION       := #SPOOL3-BS2-DESTINATION
      #SPOOL-BS2-DEVICE            := #SPOOL3-BS2-DEVICE
      #SPOOL-BS2-ROTATION          := #SPOOL3-BS2-ROTATION
      #SPOOL-BS2-DIA               := #SPOOL3-BS2-DIA
      #SPOOL-BS2-SIZE              := #SPOOL3-BS2-SIZE
      #SPOOL-BS2-RECFM             := #SPOOL3-BS2-RECFM
      #SPOOL-BS2-RECSIZE           := #SPOOL3-BS2-RECSIZE
      #SPOOL-BS2-BLKSIZE           := #SPOOL3-BS2-BLKSIZE
      #SPOOL-BS2-SECONDARY         := #SPOOL3-BS2-SECONDARY
      #SPOOL-BS2-ORIG-DSNAME       := #SPOOL3-BS2-ORIG-DSNAME
      #SPOOL-BS2-CLASS             := #SPOOL3-BS2-CLASS
    END-IF
  ANY
    SPOOL-ATTRIBUTES := #SPOOL-ATTRIBUTES
  NONE
    IGNORE
END-DECIDE
*
************************************************************************
ON ERROR
************************************************************************
  P-ERC := 0021
  CALLNAT 'C-NATERN' P-ERT
  ESCAPE ROUTINE
*
END-ERROR
*
END
