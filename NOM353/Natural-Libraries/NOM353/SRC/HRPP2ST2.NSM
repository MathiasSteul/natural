INPUT          (     IP=OFF                                           /*
                                                                       )
 019T '- Standard Separation 2 Zeichenkette -'(YEI)
/
/
 001T 'Geben Sie eine Zeichenkette an, nach der gesucht werden soll. Wird die'(TU)
/
 001T 'Zeichenkette auf einer Seite gefunden, so wird der Suffix bestimmt (bei'(TU)
/
 001T 'einem Wechsel des Suffixinhaltes wird ein neuer Report geoeffnet). Wird'(TU)
/
 001T 'die Zeichenkette auf der Seite nicht gefunden, so wird die Seite dem zur'(TU)
/
 001T 'Zeit geoeffneten Report hinzugefuegt. Ist kein Report geoeffnet, so wird'(TU)
/
 001T 'sie verworfen.'(TU)
/
/
 001T 'Ist in'(TU)
 008T '''in'(YEI)
 012T 'Zeile'' nichts angegeben, kann die Zeichenkette in einer'(TU)
/
 001T 'beliebigen Zeile der Seite vorkommen.'(TU)
/
/
 001T 'Die Zeichenkette kann'(TU)
 023T '*'(YEI)
 025T 'und/oder'(TU)
 034T '%'(YEI)
 036T 'beinhalten, wobei'(TU)
 054T '*'(YEI)
 056T 'fuer eine beliebige'(TU)
/
 001T 'Zeichkette und'(TU)
 016T '%'(YEI)
 018T 'fuer ein beliebiges Zeichen steht.'(TU)
/
 001T 'Beispiel:'(TU)
 015T '*Zeichenkette%Zeichenkette*'(YEI)
/
/
 001T 'Beachten: NOM bietet jetzt auch volle Unterstuetzung von NATURAL Masken.'(TU)
/
 011T 'Somit ist'(TU)
 021T '*'(YEI)
 023T 'nicht nur Wildcard, sondern kann auch Zeichen sein.'(TU)
/
 001T 'Beispiel:'(TU)
 015T 'MASK(*''Zeichenkette''*''*** ''NNN'' ***''*''Zeichenkette''*)'(YEI)
