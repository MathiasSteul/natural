* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    RLISLM2
* Version   1.4.1
* Function  List Monitor log
*             1. Period (Date and Time input)
*             2. A search function to search for text message
*               for a given value.
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* jvd 99-03-26 p(180784) created new
* jvd 99-09-08 p(186337) Correct the TOP command and search string.
* fhi 00-01-28 p(190228) Get rid of rlislm0* maps (intermediate dialog)
* sju 00-02-02 p(191681) Correct date validation.
* sju 00-03-28 p(191368) Monitor multitasking
* wcd 00-04-01 CE 7267   New PFkey for additional printers in RPFK---L
* xsiszha 2000-08-15 (CE7461) Extend Report and Bundle Names
* sju 00-11-14 s(999999) SAT logging
* fhi 01-02-13 p(191228) DLOG function works although disallowed
* sju 05-05-23 s(265380) print the whole of the TO minute
* xsetggr 2005-10-26 p(270950) ISN fields must be P10, not P8
* xsetggr 2008-05-03 p(303852) use SATLGR2P/N
* xsetggr 2009-01-27 P303852   adapt to unix environment
* fhi     2009-03-23 P315387   Message truncated.
* fhi     2010-09-03 NOMALL-97 Extend message line
* xsetggr 2011-09-02 NOMALL-1018 call RSUBMSGN to get msg from syserr
* raya    2011-11-24 NOMALL-1080 avoid err 1342
* xsetggr 2012-02-02 NOMALL-1100 extract text of msgs - not depends on
*                                the form they are written in log
* raya    2012-11-20 NOMALL-1209 avoid error 5 duplicat
* raya    2013-06-19 NOMALL-1259 use SATLGR3P/N
* fhi     2014-08-27 NOMALL-1454 correct messages
* fhi     2014-09-04 NOMALL-1454 same
* SU1     2015-01-26 NOMALL-1388 avoid S0C7/(SAT-288:SATLGR3P changed)
* fhi     2016-11-15 NOMALL-1961 Use new task IDs
* fhi     2017-01-04 NOMALL-1913 Use microseconds for logging
* fhi     2017-10-05 NOMALL-2040 Avoid loop and wrong sequence
* fhi     2018-04-12 NOMALL-1913 Show microseconds
* BLI     2020-01-24 NOMALL-2337 Show logs from user TASKnn
* SU2     2021-04-16 NOMALL-2454 recat RMTASK-P to avoid NAT1305
* ----------------------------------------------------------------------
DEFINE DATA GLOBAL USING  NRM-GL
LOCAL USING RLC----L
LOCAL USING RPFK---L
LOCAL USING ROT----L
LOCAL USING SATLGR4P     /* NOMALL-1913 fhi was SATLGR3P
LOCAL USING SATLG01E
LOCAL USING RMTASK-P     /* NOMALL-1961 fhi in
LOCAL
*
1 #FROM-D                 (A12)
1 REDEFINE #FROM-D
  2 #FROM-DATE            (A8)
  2 REDEFINE #FROM-DATE
    3 #FROM-YYYY          (A4)
    3 #FROM-MM            (A2)
    3 #FROM-DD            (A2)
  2 #FROM-TIME            (A4)
  2 REDEFINE #FROM-TIME
    3 #FROM-HH            (A2)
    3 #FROM-II            (A2)
*
1 #TO-D                   (A12)
1 REDEFINE #TO-D
  2 #TO-DATE              (A8)
  2 REDEFINE #TO-DATE
    3 #TO-YYYY            (A4)
    3 #TO-MM              (A2)
    3 #TO-DD              (A2)
  2 #TO-TIME              (A4)
  2 REDEFINE #TO-TIME
    3 #TO-HH              (A2)
    3 #TO-II              (A2)
*
1 #FROM                   (T)
1 #TO                     (T)
1 REDEFINE #TO
  2 #TO-P                 (P12)
1 #CHK-FROM-D             (A12)
1 #CHK-TO-D               (A12)
1 #PANEL                  (I1) INIT <1>
1 #OBJECT-TYPE            (A32)
1 #FATHER-PROG            (A8) INIT <'RHANMO'>
1 #NOFLINES               (P2) INIT <015 >
1 #NOFPAGES               (P3) CONST <0100 >
1 #END-OF-DATA            (L)
1 #DATE-CHANGE            (L)
1 #SEARCH-CHANGE          (L)
1 #FIRST-GET              (L)
1 #CP                     (P3)
1 #MAXP                   (P3)
1 #MAXAP                  (P3)
1 #NEWVAL                 (L)
1 #BACKWARD               (L)
1 #FORWARD                (L)
1 #TOP                    (L)
1 #BOT                    (L)
1 GET-SCREEN              (L)
1 #LAST-KEY               (A16) /* NOMALL-2040 was (A13)
1 REDEFINE #LAST-KEY
  2 #LK-TIME              (T)
  2 #LK-MICROSEC          (P5)  /* NOMALL-2040 fhi in
  2 #LK-ISN               (P10)
1 #PAGES1                 (A16/#NOFPAGES)
1 REDEFINE #PAGES1
  2 #PAGES2               (1:#NOFPAGES)
    3 #PK-TIME            (T)
    3 #PK-MICROSEC        (P5)  /* NOMALL-2040 fhi in
    3 #PK-ISN             (P10)
1 #I2                     (N5)
1 L-HEADER                (A78)
1 L-SCREEN                (15)
  2 #L-MSG                (A65)
  2 #L-USERID             (A8)
  2 #L-DATE               (A8)
  2 #L-TIME               (A10)
  2 #L-TIME-ZONE          (A5) /* NOMALL-1913 fhi in
  2 L-ISN                 (P10)
1 L-LCMD                  (15)
  2 L-MARK                (A2)
  2 L-IDENT               (I2)
  2 CV-MARK               (C)
1 I                       (N5)
1 #SCROLL-AMOUNT          (N3)
1 F                       (P2)
1 #LANGUAGE               (I1)
1 #ADMIN                  (L)
1 #START                  (L)
1 #STOP                   (L)
1 #SEARCH-STRING          (A25)
1 #CHK-SEARCH-STRING      (A25)
1 #SEARCH-CNT             (P3)
1 #MESSAGE-TEXT           (A250)
1 #FORMATED-DATE          (A10)
1 REDEFINE #FORMATED-DATE
  2 #S-FORMATED-DATE      (A8)
1 #ERROR-CODE             (N4)
1 #ERROR-TEXT             (A250)
1 #DLOG                   (L)
1 #ERN                    (N4)   /* NOMALL-1454 fhi in
1 #ERC                    (A250)
1 #STRING                 (A250)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
CALLNAT 'NARPSEC' G-USER-PROFILE 'ADM' #ADMIN
CALLNAT 'NARPSEC' G-USER-PROFILE 'STA' #START
CALLNAT 'NARPSEC' G-USER-PROFILE 'STP' #STOP
CALLNAT 'NARPSEC' G-USER-PROFILE 'DLO' #DLOG
IF NOT (#ADMIN OR #START OR #STOP OR #DLOG)
  G-NATRP-ERC := 0020
  FETCH 'RMENU'
END-IF
COMPRESS '     NOM-Monitor -' H'01' INTO #OBJECT-TYPE
RESET G-LINECOM (*)
G-LINECOM (1) := '<DE#Delete>'
#NEWVAL := #FIRST-GET := TRUE
MOVE EDITED *TIMX(EM=YYYYMMDDHHII) TO #FROM-D
MOVE EDITED *TIMX(EM=YYYYMMDDHHII) TO #TO-D
#FROM-TIME := '0001'
#TO-TIME   := '2359'
#CHK-FROM-D := #FROM-D
#CHK-TO-D   := #TO-D
MOVE EDITED #FROM-D TO #FROM (EM=YYYYMMDDHHII)
MOVE EDITED #TO-D   TO #TO   (EM=YYYYMMDDHHII)
ADD 599 TO #TO-P
SATLGR-PRODUCT          := 'NOM'
SATLGR-LANGUAGE         := *LANGUAGE
SATLGR-SEARCH-KEY       := SATLG-ENV-TIME
SATLGR-ACCESS-TYPE      := SATLG-READ
SATLGR-NUMBER-OF-RECORDS:= 20
*
MAIN-LOOP. REPEAT
  RESET L-MARK(*)
  IF #LANGUAGE NE *LANGUAGE
    #LANGUAGE := *LANGUAGE
    SATLGR-LANGUAGE:= #LANGUAGE
    CALLNAT 'ROTINI-N' ##EQO-LOG-RECORD G-OBJ-TYPE G-OTB
    PERFORM INIT-LINECOM
    PERFORM INIT-PFKEYS
    GET-SCREEN := TRUE
  END-IF
  PERFORM SET-PFKEYS
  INCLUDE RMVHLP-C
  PERFORM GET-SCREEN
  CALLNAT 'N-HEADER' L-HEADER G-DATE-FORMAT 'RLISLGM1'
  INCLUDE C-TOPBOT
  PERFORM FLIP-DISPLAY
  SET CONTROL 'WB'
  IF #PANEL = 1
    INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT MARK *G-DIRECT-COMMAND
      USING MAP 'RLISLM2&'
  ELSE
    INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT MARK *G-DIRECT-COMMAND
      USING MAP 'RLISLM3&'
  END-IF
  INCLUDE RPFKVA-C
  RESET G-NATRP-ERC G-NATRP-ERT
  RESET #FORWARD #BACKWARD #NEWVAL G-NATRP-ERT G-NATRP-ERC
  INCLUDE C-DIRECT
  RESET #SCROLL-AMOUNT
  INCLUDE C-LOCCMD
*
  DECIDE ON FIRST VALUE OF G-PF-FUNC
    VALUE 'HELP'
      REINPUT USING HELP
    VALUE 'EXIT'
      PERFORM COMMIT-WORK
      FETCH #FATHER-PROG
    VALUE 'FLIP'
      PERFORM FLIP-HANDLE
    VALUE 'UP'
      #BACKWARD := TRUE
    VALUE 'DOWN'
      #FORWARD := TRUE
    VALUE 'RIGHT'
      IF #PANEL = 1
        #PANEL := 2
      END-IF
    VALUE 'LEFT'
      IF #PANEL = 2
        #PANEL := 1
      END-IF
    VALUE 'MENU'
      INCLUDE C-MENU
    VALUE 'ENTR'
      IGNORE
    NONE VALUE
      IGNORE
  END-DECIDE
  PERFORM LINE-COMMANDS
END-REPEAT
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE GET-SCREEN
************************************************************************
RESET G-NATRP-ERT #DATE-CHANGE #SEARCH-CHANGE
*
DECIDE FOR FIRST CONDITION
  WHEN #FROM-D NE #CHK-FROM-D
    #DATE-CHANGE := TRUE
  WHEN #TO-D NE #CHK-TO-D
    #DATE-CHANGE := TRUE
  WHEN #SEARCH-STRING NE #CHK-SEARCH-STRING
    #SEARCH-CHANGE := TRUE
  WHEN NONE
    IGNORE
END-DECIDE
*
DECIDE FOR EVERY  CONDITION
  WHEN #NEWVAL OR #TOP OR #DATE-CHANGE OR #SEARCH-CHANGE
    RESET  #PAGES1 (*) #MAXP #MAXAP #PK-TIME(1) #PK-ISN(1)
      #PK-MICROSEC(1)       /* NOMALL-2040 fhi in
    MOVE EDITED #FROM-D TO #PK-TIME(1) (EM=YYYYMMDDHHII)
    RESET #PK-MICROSEC(1) /* NOMALL-2040 fhi in
    #CP := #MAXAP := 1
    #CHK-SEARCH-STRING := #SEARCH-STRING
    IF #DATE-CHANGE
      PERFORM INPUT-CHECK
      MOVE EDITED #FROM-D TO #PK-TIME(1) (EM=YYYYMMDDHHII)
      RESET #PK-MICROSEC(1) /* NOMALL-2040 fhi in
      MOVE EDITED #TO-D   TO #TO       (EM=YYYYMMDDHHII)
      ADD 599 TO #TO-P
      #CHK-FROM-D := #FROM-D
      #CHK-TO-D   := #TO-D
    END-IF
    RESET #NEWVAL
  WHEN #BOT
    #CP := #MAXAP
    RESET #BOT
  WHEN #TOP OR #SEARCH-CHANGE
    MOVE EDITED #FROM-D TO #PK-TIME(1) (EM=YYYYMMDDHHII)
    RESET #PK-MICROSEC(1) /* NOMALL-2040 fhi in
    MOVE EDITED #TO-D   TO #TO       (EM=YYYYMMDDHHII)
    ADD 599 TO #TO-P
    RESET #TOP
  WHEN #FORWARD
    IF #END-OF-DATA
      ESCAPE ROUTINE
    END-IF
    IF #CP = #NOFPAGES
      #PAGES1(1:#NOFPAGES - 1) := #PAGES1(2:#NOFPAGES)
      RESET #PAGES1(#CP)
      #PAGES1(#CP) := #LAST-KEY
    ELSE
      IF #SCROLL-AMOUNT < 1
        #SCROLL-AMOUNT := 1
      END-IF
      IF #CP + #SCROLL-AMOUNT <= #MAXAP
        #CP := #CP + #SCROLL-AMOUNT
      ELSE
        IF #SCROLL-AMOUNT > 1
          #CP := #MAXAP
        ELSE
          ADD 1 TO #CP
        END-IF
      END-IF
      IF #CP > #MAXAP
        #PAGES1(#CP) := #LAST-KEY
      END-IF
    END-IF
  WHEN #BACKWARD
    IF #CP < 2
      IGNORE
    ELSE
      IF #SCROLL-AMOUNT < 1
        #SCROLL-AMOUNT := 1
      END-IF
      SUBTRACT #SCROLL-AMOUNT FROM #CP
      IF #CP < 1
        #CP := 1
      END-IF
    END-IF
  WHEN GET-SCREEN
    IGNORE
  WHEN NONE
    ESCAPE ROUTINE
END-DECIDE
*
IF #CP >= #MAXAP
  #MAXAP := #CP
END-IF
IF #FIRST-GET
  MOVE EDITED #FROM-D TO SATLGR-START-TIME (EM=YYYYMMDDHHII)
  MOVE EDITED #TO-D TO SATLGR-END-TIME (EM=YYYYMMDDHHII)
  RESET SATLGR-START-ISN
  #FIRST-GET := FALSE
ELSE
  SATLGR-START-TIME      := #PK-TIME(#CP)
  SATLGR-START-MICROSEC2 := #PK-MICROSEC(#CP) /* NOMALL-2040 fhi in
  SATLGR-START-ISN       := #PK-ISN(#CP)
END-IF
CV-MARK (*) := (AD=P)
RESET I L-SCREEN (*) #END-OF-DATA
*
RESET I
READ-LOOP. REPEAT
  CALLNAT 'SATLGR4N' SATLGR-PARMS
  FOR #I2 = 1 TO SATLGR-NUMBER-OF-RECORDS
    IF #I2 GT SATLGR-RECORDS-FOUND
        OR SATLGR-TIME(#I2) GT #TO
      #END-OF-DATA:= TRUE
      ESCAPE BOTTOM(READ-LOOP.)
    END-IF
    RMTASK-P.FUNCTION       := 'L'
    RMTASK-P.SUBTASK-NUMBER := 1
    CALLNAT 'RMTASKID' RMTASK-P
    IF SATLGR-NOM-TYPE(#I2) = 'MO' OR = 'A1' OR = 'R1'
    OR SATLGR-EXEC-USERID(#I2) = 'MONITOR' OR = RMTASK-P.TASK-ID      /*
**      OR = MASK('NOM'NN) /* BLI NOMALL-2337 out, below in
    OR = MASK('TASK'NN)                                               /*
      ADD 1 TO I
      #L-USERID(I):= SATLGR-EXEC-USERID(#I2)
      L-ISN(I)    := SATLGR-ISN(#I2)
      PERFORM PREPARE-MESSAGE
*
      IF #SEARCH-STRING NE '  '
        EXAMINE #MESSAGE-TEXT FOR #SEARCH-STRING NUMBER #SEARCH-CNT
        IF #SEARCH-CNT = 0
          RESET #L-MSG (I) #L-USERID (I)
          SUBTRACT 1 FROM I
          ESCAPE TOP
        END-IF
      END-IF
*
      #L-MSG (I) := #MESSAGE-TEXT
      MOVE EDITED SATLGR-TIME(#I2) (EM=HH':'II':'SS'.'T) TO #L-TIME(I)
      MOVE EDITED SATLGR-TIME(#I2) (EM=YYYYMMDD) TO #L-DATE(I)
      MOVE SATLGR-TIME-ZONE(I)                   TO #L-TIME-ZONE(I)
      CALLNAT 'IODATE-N' 'M' 'S' #L-DATE(I) #FORMATED-DATE
        G-DATE-FORMAT #ERROR-CODE #ERROR-TEXT
      IF #ERROR-CODE = 0
        #L-DATE(I) := #S-FORMATED-DATE
      END-IF
      RESET CV-MARK(I)
      IF I = #NOFLINES
        ESCAPE BOTTOM(READ-LOOP.)
      END-IF
    END-IF
  END-FOR
  SATLGR-START-TIME := SATLGR-TIME(SATLGR-NUMBER-OF-RECORDS)
  SATLGR-START-ISN  := SATLGR-ISN(SATLGR-NUMBER-OF-RECORDS)
END-REPEAT
IF NOT #END-OF-DATA
  IF #I2 GT SATLGR-NUMBER-OF-RECORDS
    #I2:= SATLGR-NUMBER-OF-RECORDS
  END-IF
  #LK-TIME     := SATLGR-TIME(#I2)
  #LK-MICROSEC := SATLGR-MICROSEC(#I2)
  #LK-ISN      := SATLGR-ISN(#I2)
ELSE
  #MAXP := #CP
END-IF
*
END-SUBROUTINE /* GET-SCREEN
*
************************************************************************
DEFINE SUBROUTINE PREPARE-MESSAGE
************************************************************************
RESET #ERN
SEPARATE SATLGR-MESSAGE(#I2) INTO #ERC
  REMAINDER #STRING WITH DELIMITER ' '
DECIDE FOR FIRST CONDITION
  WHEN #ERC IS (N4)
    #ERN := VAL(#ERC)
    MOVE EDITED #ERN (EM=9999) TO #ERC
  WHEN SATLGR-MESSAGE(#I2) = MASK ('NOM'NNNN' ')
    #ERC    := SUBSTR(SATLGR-MESSAGE(#I2),4,4)
    #ERN    := VAL(#ERC)
    SATLGR-MESSAGE(#I2) := SUBSTR(SATLGR-MESSAGE(#I2),4)
  WHEN NONE
    IGNORE
END-DECIDE
#MESSAGE-TEXT := SATLGR-MESSAGE(#I2)
CALLNAT 'RSUBMSGN' #MESSAGE-TEXT
*
END-SUBROUTINE /* PREPARE-MESSAGE
*
************************************************************************
DEFINE SUBROUTINE LINE-COMMANDS
************************************************************************
RESET L-IDENT (*)
INCLUDE RLCMTI-C
FOR I 1 TO #NOFLINES
  IF L-IDENT (I) = ##EQU-INFO
    FETCH RETURN 'RINFLO' L-ISN (I)
  END-IF
END-FOR
*
END-SUBROUTINE /* LINE-COMMANDS
*
************************************************************************
DEFINE SUBROUTINE INIT-LINECOM
************************************************************************
G-LC-IDENT (01) := ##EQU-INFO
G-LC-NUM        := 1
CALLNAT 'RLCINI-N' G-OBJ-TYPE G-LC G-LCB
CALLNAT 'RFLIPG-N' G-LC G-LINECOM (*)
*
END-SUBROUTINE /* INIT-LINECOM
*
************************************************************************
DEFINE SUBROUTINE INIT-PFKEYS
************************************************************************
INCLUDE RPFSTD-C
INCLUDE RPFBRW-C
INCLUDE RPFLR--C
CALLNAT 'RPFINI-N' G-PF G-PFB
*
END-SUBROUTINE /* INIT-PFKEYS
*
************************************************************************
DEFINE SUBROUTINE INPUT-CHECK
************************************************************************
DECIDE FOR FIRST CONDITION
  WHEN #FROM-DATE NE MASK(YYYYMMDD) OR #FROM-DATE = ' '
    REINPUT *0633 MARK *#FROM-D
  WHEN #FROM-HH > '23' OR #FROM-HH = ' '
    REINPUT *0051 MARK *#FROM-D.#FROM-TIME
  WHEN #FROM-II >  '59' OR #FROM-II = ' '
    REINPUT *0051 MARK *#FROM-D.#FROM-TIME
  WHEN #TO-DATE NE MASK(YYYYMMDD) OR #TO-DATE = ' '
    REINPUT *0633 MARK *#TO-D
  WHEN #TO-HH > '23' OR #TO-HH = ' '
    REINPUT *0051 MARK *#TO-D.#TO-TIME
  WHEN #TO-II >  '59' OR #TO-II = ' '
    REINPUT *0051 MARK *#TO-D.#TO-TIME
  WHEN NONE
    MOVE EDITED #FROM-D TO #FROM (EM=YYYYMMDDHHII)
    MOVE EDITED #TO-D   TO #TO   (EM=YYYYMMDDHHII)
    ADD 599 TO #TO-P
END-DECIDE
*
MOVE EDITED #FROM-D TO #PK-TIME(1) (EM=YYYYMMDDHHII)
RESET #PK-MICROSEC(1) /* NOMALL-2040 fhi in
MOVE EDITED #TO-D   TO #TO         (EM=YYYYMMDDHHII)
ADD 599 TO #TO-P
#CHK-FROM-D := #FROM-D
#CHK-TO-D   := #TO-D
*
END-SUBROUTINE /* INPUT-CHECK
*
INCLUDE RPFSET-C
*
END
