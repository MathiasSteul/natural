* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    NOMARCID
* Function  Set new  archive number
*
* Maintenance
* SU      2019-05-17 NOMALL-2277 created
* ---------------------------------------------------------------------
DEFINE DATA
LOCAL USING CONST-L
LOCAL
1 NRM-MONITOR VIEW OF NRM-MONITOR
  2 M-LAST-ARCHIVE-NO (N4) /*Internal counter fo
1 #LAST-NO            (N4)
1 #TITLE              (A35) CONST <'NOMARCID: Set last archive number'>
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
SET KEY ALL
SET KEY PF3 NAMED 'exit'
FORMAT KD=ON
*
MON-ARC. FIND NRM-MONITOR WITH M-MONITOR-ID = #_ARCHIVE
  #LAST-NO := M-LAST-ARCHIVE-NO
  INPUT (AD=MILT'_' IP=OFF)
    *TIME(AL=8 AD=OD) #TITLE (AD=OI) 72T *DATI (AD=OD)
    /  9X '-'(61)
    // 'last archive number ..' #LAST-NO (SG=OFF) '(0 thru 9999)'
  IF *PF-KEY = 'PF3' OR #LAST-NO = M-LAST-ARCHIVE-NO
    PRINT (AD=L) #TITLE '- not changed.'
    ESCAPE ROUTINE
  END-IF
  IF NOT (#LAST-NO = 0 THRU 9999)
    REINPUT 'Enter value from 0 thru 9999.'
  END-IF
  UPD. GET NRM-MONITOR *ISN (MON-ARC.)
  M-LAST-ARCHIVE-NO := #LAST-NO
  UPDATE(UPD.)
  END TRANSACTION
END-FIND
IF *NUMBER (MON-ARC.) = 0
  PRINT (AD=L) *PROGRAM 'NOM control record for' #_ARCHIVE 'missing.'
  *ERROR := 999 /* NAT0999 internal error
END-IF
*
END
