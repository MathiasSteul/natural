* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* NOABLS-N - EOM API Active Bundle List
*
* Maintenance:
* XSETGGR 2002-05-22 created
* XSETGGR 2002-06-06 fixed some errors
* XSETGGR 2002-07-19 add bundle run number to list items
* XSETGGR 2002-10-04 changes
* XSETGGR 2002-10-25 changes
* XSETGGR 2002-10-29 change assigning of numeric fields
* XSETGGR 2002-11-14 use new parameter ES-APP-SERVER-LIBRARY
* XSETGGR 2002-11-19 add options
* XSETGGR 2002-11-26 check grants for non-administrator users
* XSETGGR 2002-12-19 check granted reports in bundle
* XSETGGR 2003-01-14 changes
* UKSJU   2003-01-31 p(231843) - run number wraparound
* XSETGGR 2003-03-04 p(222810)-only open bundles can be updated
* HH      2004-08-25 FORMATTING T CHANGED;
* XSETGGR 2005-05-12 correct use of time variables
* XSETGGR 2007-03-30 new profile value for prof-archive and prof-revive
* xsetggr 2007-05-23 p(294774) chsnge date/time format in lists
* xsetggr 2007-05-23 NOM3201   Support P11 format run numbers
* XSETHZ  2008-07-23 p(307577) use full name of ES-APP-SERVER-LIBRARY
* fhi     2008-07-24 P307319   restow due to changes
*                              in DDM NRM-BUNDLE-CONTENTS
* xsetggr 2011-07-28 NOMALL-982 increase format of numbre of reports
* xsetggr 2012-04-23 NOMALL-1136 corrections of using grants
* xsetggr 2012-09-28 NOMALL-89 implement standard authorization cehck
* SU1     2013-01-31 unused      Deactivate unused data areas
* CF1     2015-12-14 NOMALL-1794 Suppress sending header texts
* CF2     2016-10-20 NOMALL-1939 Send message code to expand on client
* CF3     2019-08-13 NOMALL-2319 Correct granting + improve performance
* SU2     2024-04-30 NOM 36      remove unused
* ----------------------------------------------------------------------
DEFINE DATA
PARAMETER USING ESMCNT-A
PARAMETER USING ESMINP-A
PARAMETER USING ESMWORKA
PARAMETER USING NOABLS-A
************************************************************************
LOCAL USING NOABSL-A
LOCAL USING MAXITIML
LOCAL USING ESMCONSL
LOCAL USING NADA2000
LOCAL USING NAD-MSG
LOCAL USING NAD-FLD
LOCAL USING NOUSUP-L
LOCAL
1 ACTIVE-BUNDLES VIEW OF NRM-ACTIVE-BUNDLES
  2 AB-BUNDLE
  2 AB-OPEN-TIME
  2 AB-COORDINATOR-ID
  2 AB-STATUS
  2 AB-FLUSH-TIME
  2 AB-BUNDRNB
  2 AB-BUNDRNB-INV
  2 C*AB-PRINT-LIST
1 BUNDLE-CONTENTS VIEW OF NRM-BUNDLE-CONTENTS
/*SU2  2 BC-REPRNB 2 BC-REPNAME
1 BUNDLES VIEW OF NRM-BUNDLES
  2 B-DESC
1 USERS VIEW OF NRM-USERS
  2 USER-PROFILE
/*SU2 1 MAIL VIEW OF NRM-MAIL 1 REPORTS VIEW OF NRM-REPORTS-NEW
/*SU2 1 ACTIVE-REPORTS VIEW OF NRM-ACTIVE-REPORTS 2 AR-MASTER-REPNAME
* *****
1 #I2                    (I4)
1 #IMAX                  (I4)
1 #MSG-NR                (N4) INIT <6110>
1 #BUNDLE-E              (A25)
1 #COORD-E               (A8)
1 #AB-BUNDLE-RNB         (A31)
1 REDEFINE #AB-BUNDLE-RNB
  2 #AB-BUNDLE           (A25)
  2 #AB-RNB              (P11)
1 #GR-USERID             (A8)
/*SU2 1 #GR-OBJECT (A25) 1 #GRANTS-BC (A1/6)
1 #AB-OPENTIME-BUNDLE    (A32)
1 REDEFINE    #AB-OPENTIME-BUNDLE
  2 #AB-TIME             (T)
  2 #AB-NAME             (A25)
1 #AB-BUNDLE-STATUS      (A27)
1 REDEFINE #AB-BUNDLE-STATUS
  2 #AB-BUNDNAME         (A25)
  2 #AB-STATUS           (A2)
1 #BC-SUPER-E            (A39)
1 #BC-SUPER              (A41)
1 REDEFINE #BC-SUPER
  2 #BC-BUNDLE           (A25)
  2 #BC-BUNDRNB          (P11)
  2 #BC-GROUP            (A8)
  2 #BC-SEQNO            (P3)
1 #OPENT                 (T)
**    1 REDEFINE #OPENT
1 #OPENP                 (P12)
1 #I                     (I2)
1 #BUNDLE-SELECTED       (L)
1 #SELECT-RECORD         (L)
1 #OPTIONS               (A2/1:10)
1 #NUMREP                (I4)
1 #TT                    (T)
1 #BUNDRNB-A             (A11)
1 REDEFINE #BUNDRNB-A
  2 #BUNDRNB-N           (N11)
1 #NEW-OPTIONS           (A2/1:8)
1 #GRANTS                (A1/1:6)
/*SU2 1 #MA-RNB-USER (A14) 1 REDEFINE #MA-RNB-USER
/*SU2  2 #MA-RNB  (P11) 2 #MA-USER (A8)
/*SU2 1 #AR-REPORT-RNB  (A31) 1 REDEFINE #AR-REPORT-RNB
/*SU2 2 #AR-REPORT  (A25) 2 #AR-RNB              (P11)
1 #GRANTED               (L)
/*SU2 1 #MA-REP-RNB            (A31) 1 REDEFINE #MA-REP-RNB
/*SU2  2 #MA-REP              (A25) 2 #MA-REPRNB           (P11)
1 #AB-TIME-P             (P13)
1 #ARC-REV               (A3)
1 REDEFINE #ARC-REV
  2 #ARC-REV-A           (A1/3)
1 #J                     (N1)
1 I                      (I2)
1 P-ERC                  (N4)      /* CF1
1 P-VERSION-A10          (A10)     /* CF1
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET ES-RC ES-NUMBER ES-STARTINDEX ES-SORTKEY ES-SORTORDER #TT
/* Get client version number                          /* CF1
CALLNAT 'ESMAVC-N' 'N' P-VERSION-A10 P-ERC ES-CONTROL /* CF1
ES-EOF := 'X'
#NOABSL := ES-SELECT
IF NOT (#NOABSL.#BUNDLE = ' ' OR #NOABSL.#BUNDLE = '*')
  #BUNDLE-SELECTED := TRUE
ELSE
  #BUNDLE-SELECTED := FALSE
END-IF
EXAMINE #NOABSL.#BUNDLE FOR '*' DELETE
EXAMINE #NOABSL.#COORD FOR '*' DELETE
COMPRESS #NOABSL.#BUNDLE H'FF' TO #BUNDLE-E LEAVING NO
COMPRESS #NOABSL.#COORD H'FF' TO #COORD-E LEAVING NO
IF ES-EXPAND = 'E'
  #IMAX := 443
  ES-FIELD-COUNT := 1
  ES-OPTION-COUNT := 10
  NOABEX-FIELD-LENGTH(1) := 37
  PERFORM READ-ALL-BUNDLES
ELSE
  DECIDE ON FIRST VALUE OF ES-FUNCTION
    VALUE 'LS'
      #IMAX := 160
      ES-FIELD-COUNT := 9
      NOABLS-FIELD-LENGTH(1) := 25
      NOABLS-FIELD-LENGTH(2) := 911
      NOABLS-FIELD-LENGTH(3) := 1
      NOABLS-FIELD-LENGTH(4) := 908
      NOABLS-FIELD-LENGTH(5) := 8
      NOABLS-FIELD-LENGTH(6) := 812
      NOABLS-FIELD-LENGTH(7) := 812
      NOABLS-FIELD-LENGTH(8) := 10
      NOABLS-FIELD-LENGTH(9) := 50
/* Client versions GT 3.4.3.4 support the new feature.
      IF P-VERSION-A10 LE '0304030004'                      /* CF1 -
        ES-STARTINDEX := 2
      END-IF                                                /* CF1
      ES-OPTION-COUNT := 10
      PERFORM READ-ALL-BUNDLES
    VALUE 'LS1'
      #IMAX := 702
      ES-FIELD-COUNT := 2
      NOABLS-FIELD-LENGTH(1) := 25
      NOABLS-FIELD-LENGTH(2) := 11
      PERFORM READ-OPENED-BUNDLES
    NONE VALUE IGNORE
  END-DECIDE
END-IF
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE READ-ALL-BUNDLES
************************************************************************
IF #BUNDLE-SELECTED
  PERFORM READ-BY-BUNDLE-RNB-INV
ELSE
  PERFORM READ-BY-OPENTIME-BUNDLE
END-IF
*
END-SUBROUTINE /* READ-ALL-BUNDLES
*
************************************************************************
DEFINE SUBROUTINE READ-HEADER
************************************************************************
PERFORM GET-TXT
RESET NOABLS-HEADER(1)
NOABLS-HEADER(1) := LONG-MSG(1)
FOR #I = 2 TO ES-FIELD-COUNT
  COMPRESS NOABLS-HEADER(1) C-HEADER-DELIMITER LONG-MSG(#I)
    TO NOABLS-HEADER(1) LEAVING NO
END-FOR
*
END-SUBROUTINE /* READ-HEADER
*
************************************************************************
DEFINE SUBROUTINE READ-BY-OPENTIME-BUNDLE
************************************************************************
ES-SORTKEY := 5
ES-SORTORDER := 1
IF ES-NEXT-KEY-PARM(1) > ' '
  #AB-TIME-P  := VAL(ES-NEXT-KEY-PARM(1))
  #AB-TIME    := #AB-TIME-P
  #AB-NAME    := ES-NEXT-KEY-PARM(2)
ELSE
  PERFORM READ-PROFILE
  IF ES-EXPAND NE 'E'
/* Suppress sending list header texts, to enable the  /* CF1 +
/* client side using its own texts with German Umlaute
/* Client versions GT 3.4.3.4 support this feature.
    IF P-VERSION-A10 LE '0304030004'                      /* CF1 -
      #I2 := 1
      PERFORM READ-HEADER
    END-IF                                                /* CF1
  END-IF
  RESET #AB-TIME-P #AB-TIME
  #AB-NAME := #NOABSL.#BUNDLE
END-IF
RD. READ ACTIVE-BUNDLES WITH AB-OPENTIME-BUNDLE = #AB-OPENTIME-BUNDLE
  PERFORM SELECT-RECORD
  ACCEPT IF #SELECT-RECORD
  PERFORM DATA-TO-PDA
END-READ
*
END-SUBROUTINE /* READ-BY-OPENTIME-BUNDLE
*
************************************************************************
DEFINE SUBROUTINE READ-BY-BUNDLE-RNB-INV
************************************************************************
ES-SORTKEY   := 1
ES-SORTORDER := 1
IF ES-NEXT-KEY-PARM(1) > ' '
  #AB-BUNDLE := ES-NEXT-KEY-PARM(1)
  #AB-RNB    := VAL(ES-NEXT-KEY-PARM(2))
ELSE
  PERFORM READ-PROFILE
  IF ES-EXPAND NE 'E'
/* Suppress sending list header texts, to enable the  /* CF1 +
/* client side using its own texts with German Umlaute
/* Client versions GT 3.4.3.4 support this feature.
    IF P-VERSION-A10 LE '0304030004'                      /* CF1 -
      #I2 := 1
      PERFORM READ-HEADER
    END-IF                                                /* CF1
  END-IF
  #AB-BUNDLE := #NOABSL.#BUNDLE
  RESET #AB-RNB
END-IF
RD1. READ ACTIVE-BUNDLES WITH AB-BUNDLE-RNB-INV  STARTING FROM
    #AB-BUNDLE-RNB
  RESET #OPTIONS(*) #NEW-OPTIONS(*)
  PERFORM SELECT-RECORD
  ACCEPT IF #SELECT-RECORD
  PERFORM DATA-TO-PDA
END-READ
*
END-SUBROUTINE /* READ-BY-BUNDLE-RNB-INV
*
************************************************************************
DEFINE SUBROUTINE READ-PROFILE
************************************************************************
FIND USERS WITH USER-ID = ES-USER
  PROFILE-STRING := USER-PROFILE
  ES-NEXT-KEY-PARM(5) := PROF-FLUSH
  ES-NEXT-KEY-PARM(4) := PROF-RESTRICT-ABUN
END-FIND
IF ES-USER-TYPE NE 'A'
  COMPRESS PROF-ARCHIVE C-PARM-DELIMITER PROF-REVIVE TO
    ES-NEXT-KEY-PARM(3) LEAVING NO
END-IF
*
END-SUBROUTINE /* READ-PROFILE
*
************************************************************************
DEFINE SUBROUTINE READ-OPENED-BUNDLES
************************************************************************
#AB-BUNDNAME := ES-NEXT-KEY-PARM(1)
#AB-STATUS  := 'O'
IF ES-NEXT-KEY-PARM(1) = ' '
  PERFORM READ-PROFILE
END-IF
RDS. READ ACTIVE-BUNDLES WITH AB-BUNDLE-STATUS = #AB-BUNDLE-STATUS
  REJECT IF AB-STATUS NE 'O'
  IF ES-USER-TYPE NE 'A' AND ES-NEXT-KEY-PARM(4) = 'Y'
    CALLNAT 'NOGROU-N' 'B' AB-BUNDLE ES-USER #GR-USERID #GRANTS(*)
    ACCEPT IF #GR-USERID > ' '
  END-IF
  PERFORM DATA-TO-PDA
END-READ
*
END-SUBROUTINE /* READ-OPENED-BUNDLES
*
************************************************************************
DEFINE SUBROUTINE DATA-TO-PDA
************************************************************************
RESET #OPTIONS(*) #NEW-OPTIONS(*)
ADD 1 TO #I2
IF #I2 > #IMAX
  IF ES-FUNCTION = 'LS1'
    ES-NEXT-KEY-PARM(1) := ACTIVE-BUNDLES.AB-BUNDLE
  ELSE
    IF #BUNDLE-SELECTED
      ES-NEXT-KEY-PARM(1) := ACTIVE-BUNDLES.AB-BUNDLE
      #BUNDRNB-N          := ACTIVE-BUNDLES.AB-BUNDRNB-INV
      ES-NEXT-KEY-PARM(2) := #BUNDRNB-A
    ELSE
      #OPENT := ACTIVE-BUNDLES.AB-OPEN-TIME
      #OPENP := ACTIVE-BUNDLES.AB-OPEN-TIME
      ES-NEXT-KEY-PARM(1) := #OPENP
      ES-NEXT-KEY-PARM(2) := ACTIVE-BUNDLES.AB-BUNDLE
    END-IF
  END-IF
  ES-NUMBER := #IMAX
  RESET ES-EOF
  ESCAPE BOTTOM
ELSE
  IF ES-EXPAND = 'E'
    COMPRESS ACTIVE-BUNDLES.AB-BUNDLE C-PARM-DELIMITER
      ACTIVE-BUNDLES.AB-BUNDRNB TO NOABEX-BUNDRNB(#I2) LEAVING NO
    PERFORM GET-OPTIONS
    NOABEX-OPTIONS(#I2,*) := #OPTIONS(*)
  ELSE
    DECIDE ON FIRST VALUE OF ES-FUNCTION
      VALUE 'LS'
        NOABLS-BUNDLE(#I2)  := ACTIVE-BUNDLES.AB-BUNDLE
        NOABLS-BUNDRNB(#I2) := ACTIVE-BUNDLES.AB-BUNDRNB
        MOVE RIGHT JUSTIFIED NOABLS-BUNDRNB(#I2) TO
          NOABLS-BUNDRNB(#I2)
        NOABLS-STATUS(#I2)  := ACTIVE-BUNDLES.AB-STATUS
        NOABLS-COORDINATOR-ID (#I2) := ACTIVE-BUNDLES.AB-COORDINATOR-ID
        #OPENT := ACTIVE-BUNDLES.AB-OPEN-TIME
        #OPENP := ACTIVE-BUNDLES.AB-OPEN-TIME
        #OPENP := #MAX-INV-TIME - #OPENP
        MOVE #OPENP TO #OPENT
        IF #OPENT NE #TT
          MOVE EDITED #OPENT (EM=YYYYMMDDHHII) TO NOABLS-OPEN-TIME(#I2)
        ELSE
          RESET NOABLS-OPEN-TIME(#I2)
        END-IF
        IF ACTIVE-BUNDLES.AB-FLUSH-TIME NE #TT
          MOVE EDITED ACTIVE-BUNDLES.AB-FLUSH-TIME (EM=YYYYMMDDHHII)
            TO NOABLS-CLOSE-TIME(#I2)
        ELSE
          RESET NOABLS-CLOSE-TIME(#I2)
        END-IF
        FNDB. FIND BUNDLES WITH B-BUNDLE = AB-BUNDLE
          NOABLS-DESC (#I2) := BUNDLES.B-DESC
        END-FIND
        IF C*AB-PRINT-LIST = 0
          #MSG-NR := 8801
/* Send message key to be expanded on the client side /* CF2 +
/* (prevents cut off messages from here).
/* Client versions GT 3.4.3.8 support this feature.
          IF P-VERSION-A10 LE '0304030008'                      /* CF2 -
            PERFORM GET-TXT
            NOABLS-MESSAGE(#I2) := SHORT-MSG
          ELSE                                                  /* CF2 +
            NOABLS-MESSAGE(#I2) := #MSG-NR
          END-IF                                                /* CF2 -
        ELSE
          RESET NOABLS-MESSAGE(#I2)
        END-IF
        PERFORM GET-OPTIONS
        NOABLS-NUM-REP(#I2) := #NUMREP
        MOVE RIGHT JUSTIFIED NOABLS-NUM-REP(#I2) TO NOABLS-NUM-REP(#I2)
        NOABLS-OPTIONS(#I2,*) := #OPTIONS(*)
      VALUE 'LS1'
        NOABLI-BUNDLE(#I2)  := ACTIVE-BUNDLES.AB-BUNDLE
        NOABLI-BUNDRNB(#I2) := ACTIVE-BUNDLES.AB-BUNDRNB
      NONE VALUE IGNORE
    END-DECIDE
  END-IF
  ES-NUMBER := #I2
END-IF
*
END-SUBROUTINE /* DATA-TO-PDA
*
************************************************************************
DEFINE SUBROUTINE GET-OPTIONS
************************************************************************
RESET #OPTIONS(*) #NUMREP #GRANTED #ARC-REV #J #NEW-OPTIONS(*) I
#BC-BUNDLE  := ACTIVE-BUNDLES.AB-BUNDLE
#BC-BUNDRNB := ACTIVE-BUNDLES.AB-BUNDRNB
#BC-SEQNO   := 999
MOVE ALL H'FF' TO #BC-GROUP
#BC-SUPER-E := #BC-SUPER
RESET #BC-SEQNO #BC-GROUP
FNDBC. FIND NUMBER BUNDLE-CONTENTS
WITH BC-BUNDLE-RNB-GROUP-SEQNO = #BC-SUPER THRU #BC-SUPER-E           /*
IF *NUMBER (FNDBC.) = 0
  #OPTIONS(1) := 'LB'
  #OPTIONS(2) := 'SS'
END-IF
#NUMREP := *NUMBER(FNDBC.)                                 /* CF3
IF ACTIVE-BUNDLES.AB-STATUS NE 'O'
  #OPTIONS(3) := 'CL'
END-IF
IF ACTIVE-BUNDLES.AB-STATUS = 'E'
  #OPTIONS(4) := 'PB'
END-IF
IF ACTIVE-BUNDLES.AB-STATUS NE 'O'
  #OPTIONS(5) := 'OP'
END-IF
IF ES-USER-TYPE NE 'A'
  #ARC-REV := ES-NEXT-KEY-PARM(3)
  EXAMINE #ARC-REV-A(*) FOR C-PARM-DELIMITER GIVING INDEX #J
  IF #J = 2 AND #ARC-REV-A(#J - 1) NE 'Y' AND #ARC-REV-A(#J - 1) NE 'M'
    #OPTIONS(6) := 'AR'
  END-IF
  IF (#J =1 OR=2) AND #ARC-REV-A(#J + 1) NE 'Y'
  AND #ARC-REV-A(#J + 1) NE 'M'                                       /*
    #OPTIONS(7) := 'RV'
  END-IF
END-IF
INCLUDE NOOPT--C
IF  ES-USER-TYPE NE 'A'
  IF #GRANTS(*) = 'Y'
    RESET #NEW-OPTIONS(*)
    IF ES-USER-TYPE NE 'A' AND ES-NEXT-KEY-PARM(5) NE 'Y' /* prof-flush
      #NEW-OPTIONS(1) := 'CL'
      #NEW-OPTIONS(2) := 'PB'
      CALLNAT 'NOOPT--N' #NEW-OPTIONS(*) #OPTIONS(*)
    END-IF
  ELSE
    #OPTIONS(1) := 'DS'
    #OPTIONS(2) := 'DL'
    #OPTIONS(3) := 'OP'
    #OPTIONS(4) := 'AR'
    #OPTIONS(5) := 'RV'
    #OPTIONS(6) := 'LB'                                    /* CF3 ->
    #OPTIONS(7) := 'SS'
    #OPTIONS(8) := 'IN'                                    /* CF3 <-
  END-IF
END-IF
*
END-SUBROUTINE /* GET-OPTIONS
*
************************************************************************
DEFINE SUBROUTINE SELECT-RECORD
************************************************************************
RESET #GRANTS(*)
#SELECT-RECORD := TRUE
DECIDE FOR EVERY CONDITION
  WHEN ES-USER-TYPE NE 'A'
    CALLNAT 'NOGROU-N' 'B' AB-BUNDLE ES-USER #GR-USERID #GRANTS(*)
    IF #GR-USERID = ' ' AND ES-NEXT-KEY-PARM(4) = 'Y'
      #SELECT-RECORD := FALSE
      ESCAPE ROUTINE
    END-IF
  WHEN NOT (#NOABSL.#BUNDLE = ' ' OR =  '*')
    IF NOT(AB-BUNDLE = #NOABSL.#BUNDLE THRU #BUNDLE-E)
      #SELECT-RECORD := FALSE
      ESCAPE ROUTINE
    END-IF
  WHEN NOT(#NOABSL.#COORD = ' ' OR = '*')
    IF NOT(AB-COORDINATOR-ID = #NOABSL.#COORD THRU #COORD-E)
      #SELECT-RECORD := FALSE
      ESCAPE ROUTINE
    END-IF
  WHEN NOT (#NOABSL.#STATUS = ' ' OR = '*')
    IF AB-STATUS NE #NOABSL.#STATUS
      #SELECT-RECORD := FALSE
    END-IF
  WHEN NONE IGNORE
END-DECIDE
*
END-SUBROUTINE /* SELECT-RECORD
*
************************************************************************
DEFINE SUBROUTINE GET-TXT
************************************************************************
RESET SHORT-MSG LONG-MSG(*)
NADA2000.OBJECT-KIND    := 'U'
NADA2000.ERROR-NUMBER   := #MSG-NR
NADA2000.OPT-INSERT-DYN := FALSE
NADA2000.OPT-LANGUAGE   := ES-LANGUAGE
NADA2000.LIBRARY        := ES-APP-SERVER-LIBRARY
CALLNAT 'NATA2000' NADA2000 NATA2000.EXTENDED-PARMS NAD-MSG NAD-FLD
*
END-SUBROUTINE /* GET-TXT
*
END
