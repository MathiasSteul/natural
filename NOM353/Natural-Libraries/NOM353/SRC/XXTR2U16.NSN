* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* ----------------------------------------------------------------------
* Member    XXTR2U16
* Function  Converts an alpha string to Unicode using user transl. table
*           Checks for valid Natural user code page
* Version   3.5
*
* This module was created to be able to process Siemens codepages EDF*
* These codepages are not part of the ICU codepage system.
* In some environments the user might want to use individual codepages.
*
* NOM uses this translation routine to convert a single byte codepage to
* UTF-16, the internal Natural Unicode format, using a text member.
* The corresponding table must be stored in SYSNOMU. An example can be
* found in SYSNOMS(TBUSER). All user table names must begin with 'TB'.
* Tables for internal use (XXCPAGA) are in SYSNOM and must not be
* changed. They are accessed with function 'I'.
*
* For details see 'ideas' folder, file XXTR2U16-Siemens-Codepages.pdf
*
* Maintenance:
* uuuuuuuu yyyy-mm-dd   iTrac       Comment
* fhi      2018-03-21   NOMALL-1918 Created
* fhi      2018-05-08   NOMALL-1918 Rewritten
* fhi      2018-11-23   NOMALL-1918 Honor user code pages in Natural
* SU1     2019-07-17 NOMALL-2297 performance
* ----------------------------------------------------------------------
DEFINE DATA
PARAMETER
1 FUNCTION           (A1)                          /* C(onvert), T(est)
/*                                                 /* I(nternal)
1 CP-MEMBER          (A8)   BY VALUE               /* CP table of STRING
1 B-STRING           (B500) BY VALUE RESULT OPTIONAL
1 REDEFINE B-STRING
  2 B-STRING-ARRAY   (B1/500)
1 U-STRING           (U)    DYNAMIC BY VALUE RESULT OPTIONAL
1 ERC                (N4)   BY VALUE RESULT        /* message number
*                   <0 = Natural error
*                    0 = User CP (TB* member) found
*                    1 = User CP not found
*                    5 = User code page name > 8 characters
*                 91xx = User Table (TB* member) problem in FNAT
1 ERT                (A250) BY VALUE RESULT        /* message number
************************************************************************
INDEPENDENT
1 +CP-MEMBER         (A8)   /* remember to avoid filling table too often
1 +U-TABLE           (U1/256)
1 REDEFINE +U-TABLE
  2 #U-VALUES        (I2/256)
************************************************************************
LOCAL
1 #NAT42002
  2 P-DYN-PART     (A253/9)
  2 P-OCCU         (I2)
  2 P-ERROR-NUMBER (I4)
  2 P-RESPONSE     (I4)
1 NADA1100
  2 OBJECT-KEY
    3 DBID           (N5)
    3 FNR            (N5)
    3 PASSWORD       (A8)
    3 CIPHERCODE     (N8)
    3 OBJECT-CLASS   (I1)
    3 LIBRARY        (A8)
    3 OBJECT-NAME    (A32)
    3 OBJECT-TYPE    (A2)
    3 OBJECT-KIND    (A1)
      /*
  2 INPUTS
    3 OPT-ACCESS     (A1)
    3 OPT-ET         (L)
    3 OPT-REPLACE    (A1)
    3 OPT-LINE-NUM   (A1)
    3 OPT-STEPLIBS   (L)
    3 OPT-REDEF-DIR  (L)
    3 OPT-STREAM     (A1)
    3 OPT-AMOUNT     (I2)
    3 OPT-LINESIZE   (I2)
      /*
  2 INPUT-OUTPUTS
    3 INT-HANDLE     (I4)
    3 NEXT-SEQ       (I4)
    3 NEXT-NUM       (I2)
      /*
  2 OUTPUTS                        /* Output for READ, input for WRITE
    3 RETURNED       (I2)
    3 SRC-NUM        (I2/1:255)
    3 SRC-TEXT       (A1/1:255,1:92)
    3 REDEFINE SRC-TEXT
      4 SRC-GROUP    (1:255)
        5 SRC-LINE   (A92)
    3 SRC-SEQ        (I4/1:255)
    3 SRC-LONG       (A1/1:255)
      /*
1 NATA1100
  2 VERSION          (I1)     INIT <1>
  2 V1-NSC-CHECK     (A1)     /* Check against NSC
1 REDEFINE NATA1100
  2 EXTENDED-PARMS
    3 EXTENDED-DATA  (A1/1:2)
1 NAD-MSG
  2 MSG              (A79) /* Message
  2 MSG-NR           (I4)  /* Message number:
*                          /* <  0: NATURAL error number
*                          /* >= 0: NAT. Util. error number
  2 MSG-TYPE         (I1)  /* Type of message:
*                          /*   0 = Informatory message
*                          /*   1 = Warning
*                          /* 100 = Severe error
  2 MSG-DATA         (A32/1:3) /* Pass variables to be substituted
1 NAD-FLD
  2 FIELD-STRUCTURE  (A32) /* Name of structure the field
*                                    /* in error belongs to.
  2 FIELD-NAME       (A32) /* Name of field in error
  2 FIELD-POSITION   (I4)  /* Result of the POS function
  2 FIELD-INDEX1     (I4)  /* These indexes are used if the
  2 FIELD-INDEX2     (I4)  /* field in error is an element
  2 FIELD-INDEX3     (I4)  /* of an array.
*
1 #B-VALUES          (B256)
  CONST <
  H'000102030405060708090A0B0C0D0E0F' -
  H'101112131415161718191A1B1C1D1E1F' -
  H'202122232425262728292A2B2C2D2E2F' -
  H'303132333435363738393A3B3C3D3E3F' -
  H'404142434445464748494A4B4C4D4E4F' -
  H'505152535455565758595A5B5C5D5E5F' -
  H'606162636465666768696A6B6C6D6E6F' -
  H'707172737475767778797A7B7C7D7E7F' -
  H'808182838485868788898A8B8C8D8E8F' -
  H'909192939495969798999A9B9C9D9E9F' -
  H'A0A1A2A3A4A5A6A7A8A9AAABACADAEAF' -
  H'B0B1B2B3B4B5B6B7B8B9BABBBCBDBEBF' -
  H'C0C1C2C3C4C5C6C7C8C9CACBCCCDCECF' -
  H'D0D1D2D3D4D5D6D7D8D9DADBDCDDDEDF' -
  H'E0E1E2E3E4E5E6E7E8E9EAEBECEDEEEF' -
  H'F0F1F2F3F4F5F6F7F8F9FAFBFCFDFEFF' >
1 REDEFINE #B-VALUES
  2 #B-TABLE         (B1/256)
1 #B-TABLE-INV       (I2/256)
1 #A-CHAR            (A4)
1 #I2                (I2)
1 #I                 (I4)
1 #J                 (I4)
1 #K                 (I4)
1 #IX                (I4)
1 #LEN               (I4)
1 #DIGIT             (I1)
1 #CHAR              (A1)
1 #U-CHAR            (U1)
1 REDEFINE #U-CHAR
  2 #B-CHAR          (B2)
1 #HEXCHAR           (A4)
1 #HEX               (A16) CONST <'0123456789ABCDEF'>
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET ERC ERT
PERFORM FILL-U-TABLE
* fhi      2018-11-23   NOMALL-1918 start commenting
*  IF ERC NE 0
*    ESCAPE ROUTINE
*  END-IF
*  +CP-MEMBER := CP-MEMBER
*  DECIDE ON FIRST VALUE OF FUNCTION
* fhi      2018-11-23   NOMALL-1918 end commenting, start insertion
DECIDE ON EVERY VALUE OF FUNCTION
* fhi      2018-11-23   NOMALL-1918 end   insertion
  VALUES 'T','I','U','A'
    IF ERC = 0
      +CP-MEMBER := CP-MEMBER
    END-IF
  VALUES 'T','I'
    ESCAPE ROUTINE
  VALUE 'U' /* Convert from A-STRING to U-STRING
    REDUCE DYNAMIC U-STRING TO 0
    EXAMINE B-STRING FOR ' ' GIVING LENGTH IN #LEN
    FOR #I = 1 TO #LEN
      #I2 := B-STRING-ARRAY(#I)
      #I2 := #I2 + 1
      MOVE +U-TABLE(#I2) TO SUBSTR(U-STRING,#I)
    END-FOR
  VALUE 'A' /* Convert from U-STRING to A-STRING
    RESET B-STRING
    FOR #I = 1 TO *LENGTH(U-STRING)
      #U-CHAR := SUBSTR(U-STRING,#I,1)
      EXAMINE +U-TABLE (*) FOR #U-CHAR GIVING INDEX IN #IX
      IF #IX NE 0
        MOVE #B-TABLE(#IX) TO B-STRING-ARRAY (#I)
      ELSE
        MOVE #B-TABLE(65) TO B-STRING-ARRAY (#I) /* replace with blank
        ERC := -3413
        MOVE EDITED #U-CHAR (EM=HH) TO #HEXCHAR
        COMPRESS  '3413' #HEXCHAR TO ERT
      END-IF
    END-FOR
  NONE
    *ERROR-NR := 999 /* call with wrong function
END-DECIDE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE FILL-U-TABLE
************************************************************************
IF CP-MEMBER  = +CP-MEMBER
  ESCAPE ROUTINE
END-IF
EXAMINE CP-MEMBER TRANSLATE INTO UPPER /*SU1 move it above RGETLIB
IF CP-MEMBER NE MASK('TB') /* a user CP member must start with 'TB'
  ERC := 9172
  COMPRESS ERC CP-MEMBER TO ERT
  ESCAPE ROUTINE
END-IF
* fhi     2018-11-23 NOMALL-1918 start insertion
EXAMINE CP-MEMBER FOR ' ' GIVING LENGTH #I
IF #I > 8
  ERC := 5
  ESCAPE ROUTINE
END-IF
* fhi     2018-11-23 NOMALL-1918 end   insertion
RESET #J
CALLNAT 'RGETLIB' LIBRARY
IF FUNCTION NE 'I' /* if function = 'I' then take it from SYSNOM
  COMPRESS LIBRARY 'U' TO LIBRARY LEAVING NO
END-IF
OBJECT-NAME      := CP-MEMBER
OPT-LINE-NUM     := 'N'
OPT-AMOUNT       := 255
OPT-LINESIZE     := 85
OPT-STREAM       := 'B'
V1-NSC-CHECK     := 'Y'
OBJECT-TYPE      := ' '
OBJECT-KIND      := 'S'
OPT-ACCESS       := 'O'
CALLNAT 'NATA1100' NADA1100  NATA1100.EXTENDED-PARMS
  NAD-MSG   NAD-FLD
IF MSG-NR NE 0 AND MSG-TYPE GT 1
  ERC := 9171
  COMPRESS ERC CP-MEMBER TO ERT
  ESCAPE ROUTINE
END-IF
RESET SRC-LINE(*)
OPT-ACCESS   := 'R'
CALLNAT 'NATA1100' NADA1100  NATA1100.EXTENDED-PARMS NAD-MSG NAD-FLD
IF RETURNED LT 1
  PERFORM CLOSE-MEMBER
  ESCAPE ROUTINE
END-IF
IF MSG-NR NE 0 AND MSG-TYPE GT 1
  PERFORM CLOSE-MEMBER
  ESCAPE ROUTINE
END-IF
FOR #I = 1 TO RETURNED
  IF SRC-LINE(#I) = MASK ('*') /* comment line
    ESCAPE TOP
  END-IF
  SRC-LINE(#I) := SUBSTR(SRC-LINE(#I),5)
  REPEAT UNTIL SRC-LINE(#I) = ' '
    SEPARATE SRC-LINE(#I) INTO #A-CHAR REMAINDER SRC-LINE(#I)
    ADD 1 TO #J
    IF #J  > 256
      ESCAPE MODULE
    END-IF
    RESET #U-VALUES (#J)
    FOR #K    = 4 TO 1 STEP -1
      #CHAR         := SUBSTR(#A-CHAR,#K,1)
      EXAMINE #HEX FOR #CHAR GIVING POSITION IN #DIGIT
      IF #DIGIT      = 0
          OR #CHAR  NE MASK (H)
        ESCAPE MODULE
      END-IF
      #DIGIT         := #DIGIT - 1
      #U-VALUES (#J) := #U-VALUES (#J) + #DIGIT * 16 ** (4 - #K)
    END-FOR
  END-REPEAT
END-FOR
*
END-SUBROUTINE /* FILL-U-TABLE
*
************************************************************************
DEFINE SUBROUTINE CLOSE-MEMBER
************************************************************************
OPT-ACCESS := 'C' /* CLOSE MEMBER FOR UNIX ACCESS
CALLNAT 'NATA1100' NADA1100  NATA1100.EXTENDED-PARMS NAD-MSG NAD-FLD
*
END-SUBROUTINE /* CLOSE-MEMBER
*
************************************************************************
ON ERROR
************************************************************************
  ERT := ERC := *ERROR * -1
  CALLNAT 'NAT42002' #NAT42002
  COMPRESS ERT P-DYN-PART (*) TO ERT
  ESCAPE ROUTINE
*
END-ERROR
*
END
