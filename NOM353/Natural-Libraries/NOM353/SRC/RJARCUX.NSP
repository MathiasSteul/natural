FORMAT LS=133 PS=60
*
PERFORM #INIT
*
DEFINE WORK FILE 1 TYPE 'PORTABLE' /* NOMALL-1073: create length bytes
*
* compare STX-START-SCRIPT in RMARCJOB
INPUT G-MONITOR-JOBNAME
  /  G-NPR-USERID
  /  G-MONITOR-NODE
  /  #CURRENT-ARCHIVE-NO
  /  #SAVE-ARCHIVE-NO
  /  #ARCHIVE-DSNAME
  /  #AD-EXPIRATION-DATE-PHYS /*not used Ü
  /  #NOMEX008
  /  #USERARC-NUMBER
*
PERFORM PRINT-PARMS
*
IF #NOMEX008 = 'Y'
  +G-NOMEXIT-ACTIVE(8):= TRUE
END-IF
*
PERFORM CHECK_SET-LFILES
PERFORM CHECK-ARCHIVE-DATASET
PERFORM CHECK-USER-ARCHIVE
PERFORM CHECK-NAT_LIB_MEM
*
COMPRESS '0442' #ARCHIVE-NAME TO LG-MSG /*:1:Archiver started.
PERFORM #RLOG
*
G-NPR-CURRENT-USERID := G-NPR-USERID
*
PERFORM PURGE-ACTIVE-REPORTS
PERFORM ARCHIVE-ACTIVE-REPORTS  /*1. part:write to work ÜÜ
PERFORM UPD-AR /*2. part:mark AR as archived ÜÜ
PERFORM FINALIZE-USER-ARCHIVE
PERFORM FINALIZE
*
