DEFINE SUBROUTINE READ-SYSOUT-PORTION
************************************************************************
DECIDE ON FIRST VALUE OF SOURCE.SR-TYPE /*SU 2018-10-10 G-SOURCE-TYPE
  VALUE NOM-DATA-BASE
    PERFORM READ-NOMDB-PORTION
  NONE
    SPOOL-ERROR := TRUE
    MOVE EDITED SOURCE.SR-TYPE (EM=HH) TO #ERR-TXT
    COMPRESS 'Invalid source type of report' #ERR-TXT TO #ERR-TXT
    PERFORM WRITE-ERROR-IN-SYSOUT
END-DECIDE
*
END-SUBROUTINE /* READ-SYSOUT-PORTION
*
************************************************************************
DEFINE SUBROUTINE WRITE-WORK-OPSYS /*unix specific part(see RJARC-C
************************************************************************
RESIZE DYNAMIC #WKF-RECORD TO 0
MOVE SUBSTR (#TEXT-RECORD,1,#RECLEN) TO #WKF-RECORD
WRITE WORK FILE 1 VARIABLE #WKF-RECORD
*
END-SUBROUTINE /* WRITE-WORK-OPSYS
*
************************************************************************
DEFINE SUBROUTINE WRITE-WORK-OPSYS2 /*unix specific part(see RJARC-C
************************************************************************
RESIZE DYNAMIC #WKF-RECORD TO 0
#WKF-RECORD := #ID-RECORD
WRITE WORK FILE 1 VARIABLE #WKF-RECORD
*
END-SUBROUTINE /* WRITE-WORK-OPSYS2
*
************************************************************************
