* fhi   2019-02-20 NOMALL-2215 Add object type MF Node: NO /rewritten
* SU3   2020-11-10 NOMALL-2440 split DDM -> NRM-MF-NODES
* SU4   2021-01-08 NOMALL-2443 avoid dup. entries
* SU5   2021-04-22 NOMALL-2460 show actions
* SU6   2021-08-18 NOMALL-2467 recat (RMIMP-A/RMIMP-C/RMIMP-C1)+RMIMPPHL
************************************************************************
DEFINE DATA
PARAMETER USING RMIMP-A
PARAMETER
1 PH-FILL
  2 PH-VTAMID           (A8)
  2 PH-STATUS           (A1)
  2 PH-FORM             (A10)
  2 PH-LOCATION         (A30)
  2 PH-PRINTER-TYPE     (A8)
  2 PH-ATTRIBUTES       (A95/1:25)
  2 REDEFINE PH-ATTRIBUTES
    3 PH-ATTR-GROUP     (1:25)
      4 PH-ATTR-ID      (I1)
      4 PH-ATTRIB       (A94)
  2 PH-JCL-SKELETON     (A8)
  2 PH-PRINT-PGM        (A8)
  2 PH-ESCAPE-CHAR      (A1)
  2 PH-MAX-LINES        (P10)
  2 PH-TIME-WINDOWS     (A8/1:8)
  2 PH-LAST-UPDATE      (T)
  2 PH-LAST-UPDATE-USER (A16)
  2 PH-OBJECT-TYPE      (A10)
  2 PH-OBJECT-TIME      (T)
************************************************************************
LOCAL USING RMIMP-L /*SU5
LOCAL USING RMBAS64P
/*SU6 LOCAL USING RMIMPPHL
*
LOCAL
1 PH VIEW OF NRM-PHYSICAL-PRINTERS /*SU6 was RMIMPPHL
  2 PH-OBJECT-TYPE       (A10)
  2 PH-OBJECT-TIME       (T)
  2 PH-VTAMID            (A8)
  2 PH-STATUS            (A1)
  2 PH-FORM              (A10)
  2 PH-LOCATION          (A30)
  2 PH-PRINTER-TYPE      (A8)
  2 PH-ATTRIBUTES        (A95/1:25)
  2 REDEFINE PH-ATTRIBUTES
    3 PH-ATTR-GROUP      (1:25)
      4 PH-ATTR-ID       (I1)
      4 PH-ATTRIB        (A94)
  2 PH-JCL-SKELETON      (A8)
  2 PH-PRINT-PGM         (A8)
  2 PH-ESCAPE-CHAR       (A1)
  2 PH-MAX-LINES         (P10)
  2 PH-TIME-WINDOWS      (A8/1:8)
  2 PH-LAST-UPDATE       (T)
  2 PH-LAST-UPDATE-USER  (A16)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
IF *OCC(B64-TEXT-ARRAY) = 0
  EXPAND ARRAY B64-TEXT-ARRAY TO (1:5)
END-IF
IF NOT #SAVE
  IF #TAG-CURRENT = #TAG-OLD
    ADD 1 TO #IND
  ELSE
    #IND := 1
  END-IF
  IF #VALUE-CURRENT = ' '
    ESCAPE MODULE
  END-IF
  DECIDE ON FIRST VALUE OF #TAG-CURRENT
    VALUE 'PH-OBJECT-TYPE'
      PH-FILL.PH-OBJECT-TYPE := #VALUE-CURRENT
    VALUE 'PH-OBJECT-TIME'
      MOVE EDITED #VALUE-CURRENT TO PH-FILL.PH-OBJECT-TIME
        (EM=YYYY'-'MM'-'DD'-'HH':'II':'SS'.'T)
    VALUE 'PH-VTAMID'
      PH-FILL.PH-VTAMID := #VALUE-CURRENT
    VALUE 'PH-STATUS'
      PH-FILL.PH-STATUS := #VALUE-CURRENT
    VALUE 'PH-FORM'
      PH-FILL.PH-FORM := #VALUE-CURRENT
    VALUE 'PH-LOCATION'
      PH-FILL.PH-LOCATION := #VALUE-CURRENT
    VALUE 'PH-PRINTER-TYPE'
      PH-FILL.PH-PRINTER-TYPE := #VALUE-CURRENT
    VALUE 'PH-ATTR-ID'
      IF #VALUE-CURRENT IS (I1)
        PH-FILL.PH-ATTR-ID (#IND) := VAL (#VALUE-CURRENT)
      ELSE
        #MSG := 'PH-ATTR-ID'
        PERFORM FIELD-IGNORED /*RMIMP-C1
      END-IF
    VALUE 'PH-ATTRIB'
      PH-FILL.PH-ATTRIB (#IND) := #VALUE-CURRENT
    VALUE 'PH-JCL-SKELETON'
      PH-FILL.PH-JCL-SKELETON := #VALUE-CURRENT
    VALUE 'PH-PRINT-PGM'
      PH-FILL.PH-PRINT-PGM := #VALUE-CURRENT
    VALUE 'PH-ESCAPE-CHAR'
      PH-FILL.PH-ESCAPE-CHAR := #VALUE-CURRENT
    VALUE 'PH-MAX-LINES'
      IF #VALUE-CURRENT IS (P10)
        PH-FILL.PH-MAX-LINES := VAL (#VALUE-CURRENT)
      ELSE
        #MSG := 'PH-MAX-LINES'
        PERFORM FIELD-IGNORED /*RMIMP-C1
      END-IF
    VALUE 'PH-TIME-WINDOWS'
      PH-FILL.PH-TIME-WINDOWS (#IND) := #VALUE-CURRENT
    VALUE 'PH-LAST-UPDATE'
      MOVE EDITED #VALUE-CURRENT TO PH-FILL.PH-LAST-UPDATE
        (EM=YYYY'-'MM'-'DD'-'HH':'II':'SS'.'T)
    VALUE 'PH-LAST-UPDATE-USER'
      PH-FILL.PH-LAST-UPDATE-USER := #VALUE-CURRENT
    NONE IGNORE
  END-DECIDE
ELSE
  #OBJ-NAME := PH-FILL.PH-VTAMID
  OBJ. FIND (1) PH WITH PH-VTAMID = PH-FILL.PH-VTAMID /*SU4 was #KEY
    IF NO RECORDS FOUND
      MOVE BY NAME PH-FILL TO PH
      STORE PH
      PERFORM ADD-LOADED
      ESCAPE BOTTOM (OBJ.)
    END-NOREC
    MOVE BY NAME PH-FILL TO PH
    IF #REPL = 'Y'
      UPDATE (OBJ.)
      PERFORM ADD-REPLACED
    ELSE
      COMPRESS PH-FILL.PH-VTAMID 'not replaced for PH' TO #MSG /*SU4
      PERFORM XXRLOG-WRITE-LOG 'W' #MSG
      PERFORM ADD-NOT-REPLACED
    END-IF
  END-FIND
  END TRANSACTION
END-IF
*
INCLUDE RMIMP-C1
*
END
