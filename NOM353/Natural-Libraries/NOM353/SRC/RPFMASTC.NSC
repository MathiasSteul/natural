* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RPFMASTC       Standard PF-key Assignment for Master
*
* MAINTENANCE:
* xsisgg 00-08-16 CE7461 New PF-key to toggle between display long and
*                        short Report and bundle name
* ----------------------------------------------------------------------
G-PF-IDENT (09) := ##PFN-MASTER
G-PF-CODE  (09) := ##PFK-MASTER
IF G-SUPPORT-LONG-NAMES
   G-PF-IDENT (21) := ##PFN-DISPLAY-LONG-NAMES
   G-PF-CODE  (21) := ##PFK-DISPLAY-LONG-NAMES
  ELSE
   G-PF-IDENT (21) := ##PFN-MASTER
   G-PF-CODE  (21) := ##PFK-MASTER
END-IF
