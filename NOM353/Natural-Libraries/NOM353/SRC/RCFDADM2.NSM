* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* MAP2: PROTOTYPE VERSION 820 --- CREATED BY NAT 0802030000 ---
* INPUT USING MAP 'XXXXXXXX'
*     #CONFDEL #DSNAME #UNCAT-DSN CV-UNCAT
DEFINE DATA PARAMETER
1 #CONFDEL (A006)
1 #DSNAME (A044)
1 #UNCAT-DSN (A001)
1  CV-UNCAT (C)
END-DEFINE
FORMAT PS=010 LS=061 ZP=OFF SG=OFF KD=OFF IP=OFF
* MAP2: MAP PROFILES *****************************        410***********
* .TTAAAMMOO   TU6ID I N D I D I        ?_)^&:+(                       *
* 010060        N0NNUCN             X        01 SYSPROF NL           1 *
************************************************************************
INPUT          (     IP=OFF                                           /*
                                                                       )
 004T 'Bestaetigen Sie das Loeschen der Archivdatei'(YEI)
/
/
 008T #DSNAME  (AD=OI CD=NE ) /*.01U044 A044 .
/
/
 006T 'Datei entkatalogisieren'(TU)
 030T #UNCAT-DSN  (AD=MYT'_' CD=NE CV=CV-UNCAT ) /*.99U001 A001 .
/
/
 005T 'Bitte durch Eingabe von'(TU)
 029T 'DELETE'(YEI)
/
 010T 'bestaetigen'(TU)
 024T #CONFDEL  (AD=AIT'_' CD=NE ) /*.99U006 A006 .
/
/
 002T 'PF3'(YEI)
 006T 'Ende'(TU)
* MAP2: VALIDATION *****************************************************
RULEVAR F00*PF-KEY
INCDIC                                 ;
DECIDE ON FIRST VALUE OF *PF-KEY
 VALUE 'PF3' ESCAPE ROUTINE
 NONE IGNORE
END-DECIDE
RULEVAR F00#UNCAT-DSN
INCDIC                                 ;
IF NOT(& = 'Y' OR = 'N')
 REINPUT *0007 MARK *& ALARM
END-IF
RULEVAR F00#CONFDEL
INCDIC                                 ;
IF & ^= 'DELETE'
  REINPUT *4 ALARM
END-IF
* MAP2: END OF MAP *****************************************************
END
