* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* EOMMSK-N - Check if valid Mask specified
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* mrs 93-06-02           created
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 P-MASK   (A50)
1 P-VALID  (L)
************************************************************************
LOCAL
1 #TEMP    (A50)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
P-VALID := TRUE
IF #TEMP = MASK P-MASK
  IGNORE
END-IF
*
************************************************************************
ON ERROR
************************************************************************
  P-VALID := FALSE
  ESCAPE ROUTINE
*
END-ERROR
*
END
