* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 5
* <Natural Source Header
* RLISBC - List Bundle Contents
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* mrs 93-11-08 s(999999) old version saved, clean up, search on group
* mrs 93-12-14 s(999999) not needed pf2 key commented out
* mrs 94-03-14 s(196685) confirmation window
* mrs 95-03-23 s(220427) bundles with reports from different UserID's
* mrs 95-05-09 s(222896) security check corrected
* gw  96-03-06 s(241250) security check corrected
* gw  96-10-15 s(231722) TOP doesn't go top
* gw  98-03-12 s(283470) add line command 'print'
* gw  98-03-13 s(278970) save search values in independent variables
* gw  98-03-24 s(279421) sort reports by repname-rnb within group-seqno
*                        new superde BC-BUNDLE-RNB-GROUP-SEQNO-REPRNB
*                        if not present (NAT3061) we use the old one
* gw  98-07-06 p(172117) allow access to public reports
* gw  98-07-12 p(172221) NAT1316 after previous change
* gw  98-07-16 p(172297) build list active bundle redesign
* jvd 98-05-04 p(168326) Increase display size to show lines > 10m
* jvd 98-09-10 p(164220) NOM141ÖNAT23
*                        p(168326) is now in p(164220) so I have removed
*                        all refferance to P(168326) to make easier
*                        reading
* sju 00-03-24 p(191368) use N-HEADER instead of C-HEADER
* wcd 00-04-01 CE 7267   New PFkey for additional printers in RPFK---L
* sju 00-05-31 p(179982) reset selection criteria
* xsisgg 00-05-31 p(191312) Sort reports in bundle - take out old code
* xsisgg 00-08-15 CE7461 Extend Report and Bundle names
* jwo 00-12-22 p(204583) Write LOG record, when report is deleted from
*                        a bundle.
* sju     2001-04-20 p(208757) User-exit to decide old or new sequence
* sju     2001-11-01 p(216880) Public reports not shown
* xsetoba 2002-04-19 (CE5903)  BOT doesn't work
* fhi     2002-10-30 fhi101    switch on optimizer compiler
* sju     2002-11-13 p(231843) mail wrong if run number wraps round
* sju     2003-10-08 p(244538) No error message if logon as owner fails
* xsetggr 2004-05-31 (ce5903)
* xsetggr 2005-10-26 p(270950) ISN fields must be P10, not P8
* xsetggr 2007-05-04 NOM3201   Support P11 format run numbers
* xsetggr 2007-11-12 NRT2768   Display size of binary documents in bytes
* xsetggr 2008-02-24 add parm to RBINSZ-N
* xsetggr 2008-02-27 NOM32 allow brose of binary docs from NGC client
* fhi     2008-03-02 P302629   added SAGSIS problem for line above.
* xsetggr 2008-03-11 p(302778) change format of RBINS-N parms
* fhi     2008-04-28 P304674   Avoid printing of binary file types
* xsetggr 2008-05-05 p(304350) get siZe of binary doccs from spool attr.
* fhi     2008-06-24 P306370   recataloged, not reproducible error
* xsetggr 2009-09-01 P319642  test print (sommented out)
* fhi     2010-03-05 P307403 Don't use text and binary reports mixed
* xsetggr 2010-03-16 P307403 use RPFKEX1C instead of RPFKEX-C
* fhi     2010-09-03 NOMALL-97 Extend message line
* xsetggr 2010-08-31 NOMALL-870 check folder grants for BR function
* xsetggr 2011-03-03 NOMALL-953 correct setting of folder grants
* fhi     2011-05-02 NOMALL-901 Log any online delete operation
* xsetggr 2012-02-02 NOMALl-1100 correct parms of writing in log
* xsetggr 2012-04-23 NOMALL-1136 correcting of using user prof values
* SU1     2013-01-31 unused      Deactivate unused data areas
* fhi     2013-09-04 NOMALL-1004 Give warning on mixed output formats
* SU1     2014-06-04 NOMALL-1281 restruct - no changes
* fhi     2014-08-25 NOMALL-1475 Introduce formatter uniprint
* fhi     2015-05-18 NOMALL-1552 Show real size, not base64 size
* SU2     2015-06-01 NOMALL-1552 Show size 1 (instead 0)
* SU3     2016-08-01 NOMALL-1518 NOM3.5 deactivate opt.Compiler
* fhi     2016-08-01 NOMALL-1748 Backout Report Formatting
* BLI     2017-12-15 NOMALL-1986 check authorization / profile
* ----------------------------------------------------------------------
*
DEFINE DATA GLOBAL USING NRM-GL
INDEPENDENT
1 +G-RLISBC-SEL-GROUP          (A8)
1 +G-RLISBC-SEL-REPNAME        (A25)
1 +G-L9-EXISTS                 (L)
* *****
LOCAL USING VBURP-L
LOCAL USING VMAILR-L
LOCAL USING SUPER-L
LOCAL USING ROT----L
LOCAL USING RPFK---L
LOCAL USING RLC----L
LOCAL USING RMSPL--L
LOCAL USING RLOG-L
LOCAL USING RMSR---E
LOCAL USING RCCTYP-E
*
LOCAL
1 GRANTS VIEW OF NRM-GRANTS
1 ACTIVE-REPORTS    VIEW  OF  NRM-ACTIVE-REPORTS
  2 AR-NUMBER-OF-LINES
  2 AR-CURRENT-LOCATION
  2 AR-SOURCE-ID
  2 AR-USERID
  2 AR-CC-TYPE
  2 AR-SPOOL-ATTRIBUTES
  2 AR-MASTER-REPNAME
1 REPORTS VIEW OF NRM-REPORTS-NEW
1 ACTIVE-REPORT-OWNER VIEW OF NRM-ACTIVE-REPORTS
  2 AR-USERID
1 NRM-SOURCE VIEW OF NRM-SOURCE
  2 SR-TYPE
1 FOLDER VIEW OF NRM-FOLDER
  2 FO-LINKED-FO-ID            (A10)
  2 REDEFINE FO-LINKED-FO-ID
    3 FO-LINKED-USERID         (A8)
    3 FO-LINKED-ID             (B2)
*
1 #AR-NOT-YET-READ             (L)
1 #BROWSE-FLAGS
  2 #NEWVAL                    (L)
  2 #TOP                       (L)
  2 #BOT                       (L)
  2 #FORWARD                   (L)
  2 #BACKWARD                  (L)
  2 GET-SCREEN                 (L)
  2 #SCROLL-AMOUNT             (N3)
1 #END-OF-DATA                 (L)
1 #NOFLINES                    (I4) CONST <15>
1 #NOFPAGES                    (I4) CONST <40>
1 L-HEADER                     (A78)
1 L-SCREEN
  2 L-SCREEN-NO-SAVE
    3 L-SCR-NO (1:#NOFLINES)
      4 CV-MARK                (C)
      4 CVU                    (C)
      4 L-LINES                (A8)
      4 L-FORM                 (A8)
      4 L-FCB                  (A4)
      4 L-CHARS                (A20)
      4 L-FLASH                (A4)
      4 L-SOURCE-ID            (P10)

  2 L-SCREEN-SAVE-AREA
    3 L-SCR (1:#NOFLINES)
      4 L-IDENT                (I2)              /* 002
      4 L-MARK                 (A2)              /* 002
      4 L-NAME                 (A25)             /* 025
      4 L-RNB                  (P11)             /* 006
      4 L-GROUP                (A8)              /* 008
      4 L-SEQNO                (P3)              /* 002
      4 L-ISN                  (P10)             /* 006 -> 600
    3 #CP                      (P3)              /* 002
    3 #MAXP                    (P3)              /* 002
    3 #MAXAP                   (P3)              /* 002
    3 #OLD-GROUP               (A8)              /* 008
    3 #OLD-SEQNO               (P3)              /* 002
    3 #NUMBER                  (P10)             /* 006
    3 #START-KEY               (A41)             /* 41
    3 REDEFINE    #START-KEY
      4 #SK-BUNDLE             (A25)
      4 #SK-RNB                (P11)
      4 #SK-GROUP              (A8)
      4 #SK-SEQNO              (P3)
    3 #START-NUMBER            (P10)             /* 006
    3 #TOPKEY                  (A41)             /* 41
    3 REDEFINE    #TOPKEY
      4 #TK-BUNDLE             (A25)
      4 #TK-RNB                (P11)
      4 #TK-GROUP              (A8)
      4 #TK-SEQNO              (P3)
    3 #TOPKEY-NUMBER           (P10)             /* 006
    3 #LAST-KEY                (A41)             /* 41
    3 REDEFINE    #LAST-KEY
      4 #LK-BUNDLE             (A25)
      4 #LK-RNB                (P11)
      4 #LK-GROUP              (A8)
      4 #LK-SEQNO              (P3)
    3 #LAST-NUMBER             (P10)             /* 006 -> 706
    3 #PAGES-TAB (1:#NOFPAGES)
      4 #PAGES                 (A41)             /* 039
      4 REDEFINE #PAGES                          /*     -> 1586
        5  #PK-BUNDLE          (A25)
        5  #PK-RNB             (P11)
        5  #PK-GROUP           (A8)
        5  #PK-SEQNO           (P3)
      4 #PAGES-NUMBER          (P10)             /* 006
    3 #S-GROUP                 (A25) INIT <'*'>  /* 020
    3 #S-GROUP-F               (A25)             /* 020
    3 #S-GROUP-T               (A25)             /* 025
    3 #S-REPNAME               (A25) INIT <'*'>  /* 025
    3 #S-REPNAME-F             (A25)             /* 025
    3 #S-REPNAME-T             (A25)             /* 025
    3 #PANEL                   (I2) INIT <1>     /* 001 ->  127
  2 REDEFINE    L-SCREEN-SAVE-AREA
    3 L-SCREEN-SEGMENT         (A200/1:9)
  2 REDEFINE    L-SCREEN-SAVE-AREA
    3 L-SCREEN-SEG             (9)
      4 L-SCREEN-SEG-F         (A199)
      4 L-SCREEN-SEG-L         (A1)
  2 L-SCREEN-SEG-FLAG          (L/1:9)
*
1 #ERROR-CODE                  (N4)
1 #ERROR-TEXT                  (A250)
1 SOURCE-EXIST                 (L)
1 #LEN                         (N3)
1 CV-LINES                     (C)
1 I                            (N5)
1 #CONFIRMED                   (L)
1 #ALLOWED                     (L)
1 #UPDATE                      (L)
1 #FATHER-PROG                 (A8) INIT <'RLISAB'>
1 DISPLAY-IT                   (L)
1 #EXIST                       (L)
*
1 #MA-RNB-USER                 (A14)
1 REDEFINE #MA-RNB-USER
  2 #MA-RNB                    (P11)
  2 #MA-USER                   (A8)
*
1 CV-SELECTION                 (C/2)
1 REDEFINE    CV-SELECTION
  2 CV-SREP                    (C)
  2 CV-SGROUP                  (C)
*
1 #LANGUAGE                    (I1)
1 #ADD-PROGRAM                 (A8)
1 #ACT-MAST                    (A8)
1 F                            (P2)
1 #STACK-PGM                   (A8)
1 #OBJECT-NAME                 (A32)
1 LOWER-CASE                   (L)
1 #SAVE-NPR-USERID             (A8)
1 #GR-TYPE-OBJ-USER            (A34)
1 REDEFINE #GR-TYPE-OBJ-USER
  2 #GR-TYPE                   (A1)
  2 #GR-OBJ                    (A25)
  2 #GR-USER                   (A8)
1 #OBJECT-TYPE                 (A1)
1 #BUNDLE-RNB                  (A41)
1 NAT00053-PARMS
  2 NAT00053-FUNCTION          (A1)     INIT <'O'>
  2 NAT00053-MEMBER            (A8)     INIT <'RMBUNSEQ'>
  2 NAT00053-LIBRARY           (A8)
  2 NAT00053-DBID              (B2)
  2 NAT00053-FNR               (B2)
  2 NAT00053-RSP               (I2)
  2 NAT00053-FIELDS            (A55)
1 #I                           (N2)
1 #MA-REP-RNB                  (A31)
1 REDEFINE #MA-REP-RNB
  2 #MA-REP                    (A25)
  2 #MA-REPRNB                 (P11)
1 #BIN-SIZE                    (I4)
1 #WARNING                     (L)
1 #WIN-PFKEY                   (A4)
1 #A4                          (A4)
1 REDEFINE #A4
  2 #I4                        (I4)
1 #BINARY-REPORTS              (L)
1 #BROWSE                      (L)
1 #GRANTED                     (L)
1 #OPTIONS                     (A1/6)
1 #GR-SUPER                    (A34)
1 REDEFINE #GR-SUPER
  2 #GR-OBJECT-TYPE            (A1)
  2 #GR-USERID                 (A8)
  2 #GR-OBJECT-NAME            (A25)
1 #FO-ID-N                     (N5)
1 REDEFINE #FO-ID-N
  2 #FO-ID-A                   (A5)
1 #FO-NAME                     (A25)
1 #FO-USER-ID                  (A10)
1 REDEFINE #FO-USER-ID
  2 #FO-USER                   (A8)
  2 #FO-ID                     (B2)
1 #OBJ                         (A50)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
DEFINE WINDOW WARNING
CALLNAT 'RGETLIB' NAT00053-LIBRARY
+G-L9-EXISTS:= TRUE
CALLNAT 'NAT00053' NAT00053-PARMS
IF NAT00053-RSP = 0
  CALLNAT 'RMBUNSEQ' G-C-BUNDLE (AD=O) G-C-BUNDRNB (AD=O) +G-L9-EXISTS
END-IF
#FATHER-PROG := G-FATHER-PROG
RESET G-COMMIT G-NATRP-ERT
*
CALLNAT 'NARPSEC' G-USER-PROFILE 'DAB' #ALLOWED
INCLUDE C-NALLOW
CALLNAT 'NARPSEC' G-USER-PROFILE 'MAB' #UPDATE
INCLUDE CVIDEO
*
IF *DATA = 5
  PERFORM READ-FROM-STACK
  PERFORM INIT-LINECOM
  PERFORM LINE-COMMANDS
  PERFORM INIT-SELECTION-KEYS
  GET-SCREEN := TRUE
ELSE
  #NEWVAL := TRUE
  #S-REPNAME := +G-RLISBC-SEL-REPNAME
  #S-GROUP   := +G-RLISBC-SEL-GROUP
END-IF
*
MAIN-LOOP. REPEAT
  G-C-FUNC := 'L'
*
  PERFORM GET-SCREEN
  RESET GET-SCREEN
*
  IF #LANGUAGE NE *LANGUAGE
    CALLNAT 'ROTINI-N' ##EQO-REPORT-IN-BUNDLE G-OBJ-TYPE G-OTB
    PERFORM INIT-PFKEYS
    PERFORM INIT-LINECOM
    #LANGUAGE := *LANGUAGE
  END-IF
*
  CALLNAT 'RFLIPG-N' G-LC G-LINECOM (*)
*
  PERFORM SET-PFKEYS
  INCLUDE RMVHLP-C
*
  INCLUDE C-TOPBOT
*
  PERFORM FLIP-DISPLAY
  SET CONTROL 'M21'
  SET CONTROL 'WB'
  CALLNAT 'N-HEADER' L-HEADER G-DATE-FORMAT 'RLISBCM&'
*
  RESET #WARNING
  DECIDE ON FIRST #PANEL
    VALUE 1
      IF G-DISPLAY-LONG-NAMES
        COMPRESS G-C-BUNDLE '/' G-C-BUNDRNB TO #BUNDLE-RNB
        COMPRESS #BUNDLE-RNB H'FA' '-' TO #BUNDLE-RNB LEAVING NO
        INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
          MARK *G-DIRECT-COMMAND USING MAP 'RLISBC1&'
      ELSE
        INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
          MARK *G-DIRECT-COMMAND USING MAP 'RLISBCM&'
      END-IF
    VALUE 2
      IF G-DISPLAY-LONG-NAMES
        COMPRESS G-C-BUNDLE '/' G-C-BUNDRNB TO #BUNDLE-RNB
        COMPRESS #BUNDLE-RNB H'FA' '-' TO #BUNDLE-RNB LEAVING NO
        INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
          MARK *G-DIRECT-COMMAND USING MAP 'RLISBC3&'
      ELSE
        INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
          MARK *G-DIRECT-COMMAND USING MAP 'RLISBC2&'
      END-IF
    VALUE 3
      IF G-DISPLAY-LONG-NAMES
        COMPRESS G-C-BUNDLE '/' G-C-BUNDRNB TO #BUNDLE-RNB
        COMPRESS #BUNDLE-RNB H'FA' '-' TO #BUNDLE-RNB LEAVING NO
        INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
          MARK *G-DIRECT-COMMAND USING MAP 'RLISBC4&'
      ELSE
        INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
          MARK *G-DIRECT-COMMAND USING MAP 'RLISBC5&'
      END-IF
    NONE VALUE  IGNORE
  END-DECIDE
*
  INCLUDE RPFKVA-C
*
  RESET G-NATRP-ERC G-NATRP-ERT #BROWSE-FLAGS
*
  INCLUDE C-DIRECT
  INCLUDE C-LOCCMD
  INCLUDE RPFKEX1C
*
  DECIDE ON FIRST VALUE OF G-PF-FUNC
    VALUE 'RIGHT'
      DECIDE ON FIRST #PANEL
        VALUE 1 #PANEL := 2
        VALUE 2 #PANEL := 3
        NONE VALUE IGNORE
      END-DECIDE
    VALUE 'LEFT'
      DECIDE ON FIRST #PANEL
        VALUE 2 #PANEL := 1
        VALUE 3 #PANEL := 2
        NONE VALUE IGNORE
      END-DECIDE
      VALUE 'EXT' DECIDE FOR FIRST CONDITION
        WHEN G-SUPPORT-LONG-NAMES AND NOT G-DISPLAY-LONG-NAMES
          G-DISPLAY-LONG-NAMES := TRUE
        WHEN G-SUPPORT-LONG-NAMES AND G-DISPLAY-LONG-NAMES
          IF #PANEL = 3
            #PANEL := 2
          END-IF
          RESET G-DISPLAY-LONG-NAMES
        WHEN NONE RESET G-DISPLAY-LONG-NAMES
      END-DECIDE
    NONE VALUE
      IGNORE
  END-DECIDE
*
  PERFORM LINE-COMMANDS
*
  IF CV-SELECTION (*) MODIFIED
    +G-RLISBC-SEL-GROUP   := #S-GROUP
    +G-RLISBC-SEL-REPNAME := #S-REPNAME
    #NEWVAL := TRUE
  END-IF
*
END-REPEAT
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE GET-SCREEN
************************************************************************
IF G-DIRECT-COMMAND = 'TOP'
  #TOP := TRUE
END-IF
RESET L-MARK(*)
*
DECIDE FOR EVERY  CONDITION
  WHEN #NEWVAL OR #TOP
    RESET #PAGES(*) #MAXP #MAXAP #OLD-GROUP #OLD-SEQNO
    PERFORM INIT-SELECTION-KEYS
    #PAGES (1) := #START-KEY
    #PAGES-NUMBER (1) := #CP := #MAXAP := 1
  WHEN #BOT
    RESET #NUMBER
    #I := 0
    IF +G-L9-EXISTS
      READ BUNDLE-CONTENTS BY BC-BUNDLE-RNB-GROUP-SEQNO-REPRNB
          STARTING FROM #START-KEY
        IF BC-BUNDLE  NE G-C-BUNDLE OR BC-BUNDRNB NE G-C-BUNDRNB
            OR BC-GROUP > #S-GROUP-T
          ESCAPE BOTTOM
        END-IF
        IF #S-REPNAME NE ' ' AND (BC-REPNAME < #S-REPNAME-F OR
            BC-REPNAME > #S-REPNAME-T)
          ESCAPE TOP
        END-IF
        IF #S-GROUP NE ' ' AND (BC-GROUP < #S-GROUP-F OR
            BC-GROUP > #S-GROUP-T)
          ESCAPE TOP
        END-IF
        IF #OLD-GROUP NE BC-GROUP OR #OLD-SEQNO NE BC-SEQNO
          RESET #NUMBER
          #OLD-GROUP := BC-GROUP
          #OLD-SEQNO := BC-SEQNO
        END-IF
        ADD 1 TO #NUMBER
        ADD 1 TO #I
        IF #I = 16
          IF #CP = #NOFPAGES
            #PAGES (2:#NOFPAGES - 1) := #PAGES (3:#NOFPAGES)
            #PAGES-NUMBER(2:#NOFPAGES - 1):=#PAGES-NUMBER(3:#NOFPAGES)
            #LK-BUNDLE := BC-BUNDLE
            #LK-RNB      := BC-BUNDRNB
            #LK-GROUP    := BC-GROUP
            #LK-SEQNO    := BC-SEQNO
            #LAST-NUMBER := #NUMBER
            #PAGES (#CP) := #LAST-KEY
            #PAGES-NUMBER (#CP) := #LAST-NUMBER
          ELSE
            IF #SCROLL-AMOUNT < 1
              #SCROLL-AMOUNT := 1
            END-IF
            IF #CP + #SCROLL-AMOUNT <= #MAXAP
              #CP := #CP + #SCROLL-AMOUNT
            ELSE
              IF #SCROLL-AMOUNT > 1
                #CP := #MAXAP
              ELSE
                ADD 1 TO #CP
              END-IF
            END-IF
            IF #CP > #MAXAP
              #LK-BUNDLE   := BC-BUNDLE
              #LK-RNB      := BC-BUNDRNB
              #LK-GROUP    := BC-GROUP
              #LK-SEQNO    := BC-SEQNO
              #LAST-NUMBER := #NUMBER
              #PAGES (#CP) := #LAST-KEY
              #PAGES-NUMBER (#CP) := #LAST-NUMBER
            END-IF
          END-IF
          #I := 1
        END-IF
      END-READ
    ELSE
      READ BUNDLE-CONTENTS BY BC-BUNDLE-RNB-GROUP-SEQNO = #START-KEY
        IF BC-BUNDLE  NE G-C-BUNDLE OR BC-BUNDRNB NE G-C-BUNDRNB OR
            BC-GROUP > #S-GROUP-T
          ESCAPE BOTTOM
        END-IF
        IF #S-REPNAME NE ' ' AND (BC-REPNAME < #S-REPNAME-F OR
            BC-REPNAME > #S-REPNAME-T)
          ESCAPE TOP
        END-IF
        IF #S-GROUP NE ' ' AND (BC-GROUP < #S-GROUP-F OR
            BC-GROUP > #S-GROUP-T)
          ESCAPE TOP
        END-IF
        IF #OLD-GROUP NE BC-GROUP OR #OLD-SEQNO NE BC-SEQNO
          RESET #NUMBER
          #OLD-GROUP := BC-GROUP
          #OLD-SEQNO := BC-SEQNO
        END-IF
        ADD 1 TO #NUMBER
        ADD 1 TO #I
        IF #I = 16
          IF #CP = #NOFPAGES
            #PAGES (2:#NOFPAGES - 1) := #PAGES (3:#NOFPAGES)
            #PAGES-NUMBER(2:#NOFPAGES - 1) := #PAGES-NUMBER(3:#NOFPAGES)
            #LK-BUNDLE   := BC-BUNDLE
            #LK-RNB      := BC-BUNDRNB
            #LK-GROUP    := BC-GROUP
            #LK-SEQNO    := BC-SEQNO
            #LAST-NUMBER := #NUMBER
            #PAGES (#CP) := #LAST-KEY
            #PAGES-NUMBER (#CP) := #LAST-NUMBER
          ELSE
            IF #SCROLL-AMOUNT < 1
              #SCROLL-AMOUNT := 1
            END-IF
            IF #CP + #SCROLL-AMOUNT <= #MAXAP
              #CP := #CP + #SCROLL-AMOUNT
            ELSE
              IF #SCROLL-AMOUNT > 1
                #CP := #MAXAP
              ELSE
                ADD 1 TO #CP
              END-IF
            END-IF
            IF #CP > #MAXAP
              #LK-BUNDLE   := BC-BUNDLE
              #LK-RNB      := BC-BUNDRNB
              #LK-GROUP    := BC-GROUP
              #LK-SEQNO    := BC-SEQNO
              #LAST-NUMBER := #NUMBER
              #PAGES (#CP) := #LAST-KEY
              #PAGES-NUMBER (#CP) := #LAST-NUMBER
            END-IF
          END-IF
          #I := 1
        END-IF
      END-READ
    END-IF
    #MAXAP := #CP
    #CP := 1
    #CP := #MAXAP
  WHEN #FORWARD
    IF #END-OF-DATA
      ESCAPE ROUTINE
    END-IF
    IF #CP = #NOFPAGES
      #PAGES (1:#NOFPAGES - 1) := #PAGES (2:#NOFPAGES)
      #PAGES-NUMBER (1:#NOFPAGES - 1) := #PAGES-NUMBER (2:#NOFPAGES)
      #PAGES (#CP) := #LAST-KEY
      #PAGES-NUMBER (#CP) := #LAST-NUMBER
    ELSE
      IF #SCROLL-AMOUNT < 1
        #SCROLL-AMOUNT := 1
      END-IF
      IF #CP + #SCROLL-AMOUNT <= #MAXAP
        #CP := #CP + #SCROLL-AMOUNT
      ELSE
        IF #SCROLL-AMOUNT > 1
          #CP := #MAXAP
        ELSE
          ADD 1 TO #CP
        END-IF
      END-IF
      #PAGES (#CP) := #LAST-KEY
      #PAGES-NUMBER (#CP) := #LAST-NUMBER
    END-IF
  WHEN #BACKWARD
    IF #CP GE 2
      IF #SCROLL-AMOUNT < 1
        #SCROLL-AMOUNT := 1
      END-IF
      #CP := #CP - #SCROLL-AMOUNT
      IF #CP < 1
        #CP := 1
      END-IF
    END-IF
  WHEN GET-SCREEN
    IGNORE
  WHEN NONE
    ESCAPE ROUTINE
END-DECIDE
*
RESET I L-SCR (*) L-SCR-NO (*) #END-OF-DATA
CV-MARK (*) := (AD=P)
*
RESET #OLD-GROUP #OLD-SEQNO #NUMBER
*
IF #CP > #MAXAP
  #MAXAP := #CP
END-IF
*
#START-KEY    := #PAGES (#CP)
#START-NUMBER := #PAGES-NUMBER (#CP)
*
IF +G-L9-EXISTS
  PERFORM READ-BUNDLE-CONTENTS-NEW
ELSE
  PERFORM READ-BUNDLE-CONTENTS-OLD
END-IF
IF I > #NOFLINES
  ESCAPE ROUTINE
END-IF
*
#END-OF-DATA := TRUE
#MAXP := #CP
*
END-SUBROUTINE /* GET-SCREEN
*
************************************************************************
DEFINE SUBROUTINE READ-BUNDLE-CONTENTS-NEW
************************************************************************
BCN. READ BUNDLE-CONTENTS BY BC-BUNDLE-RNB-GROUP-SEQNO-REPRNB=#START-KEY
  IF BC-BUNDLE  NE G-C-BUNDLE OR BC-BUNDRNB NE G-C-BUNDRNB
      OR BC-GROUP > #S-GROUP-T
    ESCAPE BOTTOM
  END-IF
  IF #OLD-GROUP NE BC-GROUP OR #OLD-SEQNO NE BC-SEQNO
    RESET #NUMBER
    #OLD-GROUP := BC-GROUP
    #OLD-SEQNO := BC-SEQNO
  END-IF
  ADD 1 TO #NUMBER
  IF BC-GROUP = #SK-GROUP AND BC-SEQNO = #SK-SEQNO AND
      #NUMBER  < #START-NUMBER
    ESCAPE TOP
  END-IF
  PERFORM HANDLE-BUNDLE-CONTENTS
  IF I > #NOFLINES
    ESCAPE ROUTINE
  END-IF
END-READ
*
END-SUBROUTINE /* READ-BUNDLE-CONTENTS-NEW
*
************************************************************************
DEFINE SUBROUTINE READ-BUNDLE-CONTENTS-OLD
************************************************************************
BCO. READ BUNDLE-CONTENTS BY BC-BUNDLE-RNB-GROUP-SEQNO = #START-KEY
  IF BC-BUNDLE  NE G-C-BUNDLE OR BC-BUNDRNB NE G-C-BUNDRNB OR
      BC-GROUP > #S-GROUP-T
    ESCAPE BOTTOM
  END-IF
  IF #OLD-GROUP NE BC-GROUP OR #OLD-SEQNO NE BC-SEQNO
    RESET #NUMBER
    #OLD-GROUP := BC-GROUP
    #OLD-SEQNO := BC-SEQNO
  END-IF
  ADD 1 TO #NUMBER
  IF BC-GROUP = #SK-GROUP AND BC-SEQNO = #SK-SEQNO AND
      #NUMBER  < #START-NUMBER
    ESCAPE TOP
  END-IF
  PERFORM HANDLE-BUNDLE-CONTENTS
  IF I > #NOFLINES
    ESCAPE ROUTINE
  END-IF
END-READ
*
END-SUBROUTINE /* READ-BUNDLE-CONTENTS-OLD
*
************************************************************************
DEFINE SUBROUTINE HANDLE-BUNDLE-CONTENTS
************************************************************************
#TK-BUNDLE     := BC-BUNDLE
#TK-RNB        := BC-BUNDRNB
#TK-GROUP      := BC-GROUP
#TK-SEQNO      := BC-SEQNO
#TOPKEY-NUMBER := #NUMBER
*
DISPLAY-IT := TRUE
#AR-NOT-YET-READ := TRUE
*
#AR-REPNAME := BC-REPNAME
#AR-REPRNB := BC-REPRNB
*
DECIDE FOR EVERY CONDITION
  WHEN NOT (BC-REPNAME = #S-REPNAME-F THRU #S-REPNAME-T)
    DISPLAY-IT := FALSE
  WHEN DISPLAY-IT AND G-USER-TYPE NE 'A'
    #MA-USER   := G-USERID
    #MA-RNB    := #AR-REPRNB
    #MA-REP    := #AR-REPNAME
    #MA-REPRNB := #AR-REPRNB
    FNDMA2.  FIND NUMBER MAIL-REPORTS WITH MA-RNB-USER = #MA-RNB-USER
      AND  MA-REP-RNB  = #MA-REP-RNB
    IF *NUMBER (FNDMA2.) = 0
      #GR-TYPE := 'R'
      #GR-OBJ  := BC-REPNAME
      #GR-USER := 'PUBLIC'
      RP. FIND NUMBER REPORTS WITH R-REPNAME = BC-REPNAME
      IF *NUMBER (RP.) = 0
        PERFORM FIND-ACTIVE-REPORT
        #AR-NOT-YET-READ := FALSE
        #GR-OBJ := ACTIVE-REPORTS.AR-MASTER-REPNAME
      END-IF
      GR. FIND NUMBER GRANTS WITH GR-TYPE-OBJ-USER = #GR-TYPE-OBJ-USER
      IF *NUMBER (GR.) = 0
        DISPLAY-IT := FALSE
      END-IF
    END-IF
  WHEN NONE
    IGNORE
END-DECIDE
*
REJECT IF NOT DISPLAY-IT
*
ADD 1 TO I
IF I = 1
  #PAGES (#CP) := #TOPKEY
  #PAGES-NUMBER (#CP) := #TOPKEY-NUMBER
END-IF
*
#LK-BUNDLE := BC-BUNDLE
#LK-RNB    := BC-BUNDRNB
#LK-GROUP  := BC-GROUP
#LK-SEQNO        := BC-SEQNO
*
IF I > #NOFLINES
  #LK-BUNDLE   := BC-BUNDLE
  #LK-RNB      := BC-BUNDRNB
  #LK-GROUP    := BC-GROUP
  #LK-SEQNO    := BC-SEQNO
  #LAST-NUMBER := #NUMBER
  ESCAPE ROUTINE
END-IF
*
RESET CV-MARK (I)
L-NAME  (I) := BC-REPNAME
L-RNB   (I) := BC-REPRNB
L-GROUP (I) := BC-GROUP
L-SEQNO (I) := BC-SEQNO
L-FORM  (I) := BC-FORM
L-FCB   (I) := BC-FCB
L-FLASH (I) := BC-FLASH
L-CHARS (I) := BC-CHARS
*
IF #AR-NOT-YET-READ
  PERFORM FIND-ACTIVE-REPORT
END-IF
RESET #BIN-SIZE #SPOOL-ATTRIBUTES
IF AR-CC-TYPE = BINARY
  #SPOOL-ATTRIBUTES := ACTIVE-REPORTS.AR-SPOOL-ATTRIBUTES
  IF NOT (#SPOOL-DI-SIZE = #I4 OR = 0)
    #BIN-SIZE := (#SPOOL-DI-SIZE / 1024) * 3 / 4 + 1
    COMPRESS #BIN-SIZE 'K' TO L-LINES(I) LEAVING NO
  ELSE
    L-LINES(I) := '--K'
  END-IF
ELSE
  L-LINES     (I) := ACTIVE-REPORTS.AR-NUMBER-OF-LINES
END-IF
L-SOURCE-ID (I) := ACTIVE-REPORTS.AR-SOURCE-ID
L-ISN       (I) := *ISN (BCN.)
*
END-SUBROUTINE /* HANDLE-BUNDLE-CONTENTS
*
************************************************************************
DEFINE SUBROUTINE FIND-ACTIVE-REPORT
************************************************************************
#AR-REPNAME := BC-REPNAME
#AR-REPRNB  := BC-REPRNB
*
AR. FIND ACTIVE-REPORTS WITH AR-REPORT-RNB = #AR-REPORT-RNB
  IF AR-CC-TYPE = BINARY
    #BINARY-REPORTS := TRUE
  END-IF
END-FIND
*
END-SUBROUTINE /* FIND-ACTIVE-REPORT
*
************************************************************************
DEFINE SUBROUTINE LINE-COMMANDS
************************************************************************
IF L-MARK (*) = '.'
  INCLUDE C-ESCAPE
END-IF
*
INCLUDE RLCMTI-C
*
FOR I = 1 TO #NOFLINES
  DECIDE ON FIRST VALUE OF L-IDENT (I)
    VALUE ##EQU-DELETE
      IF NOT #UPDATE
        REINPUT *20 MARK *L-MARK(I) ALARM
      END-IF
    VALUE ##EQU-MODIFY
      IF NOT #UPDATE
        REINPUT *20 MARK *L-MARK(I) ALARM
      END-IF
    NONE VALUE
      IGNORE
  END-DECIDE
END-FOR
*
FOR I = 1 TO #NOFLINES
  IF L-IDENT (I) = ##EQU-PRINT
    PERFORM CHECK-SOURCE
  END-IF
  IF L-IDENT(I) = ##EQU-BROWSE
    PERFORM CHECK-SOURCE
    #AR-REPNAME := L-NAME (I)
    #AR-REPRNB         := L-RNB (I)
    FIND ACTIVE-REPORTS WITH AR-REPORT-RNB = #AR-REPORT-RNB
      IF AR-USERID NE G-USERID
        PERFORM CHECK-FOLDER
        IF NOT #BROWSE
          REINPUT *0728 MARK *L-MARK(I) ALARM
        END-IF
      END-IF
      IF AR-CC-TYPE = BINARY
        REINPUT *725 MARK *L-MARK(I) ALARM
      END-IF
    END-FIND
  END-IF
  IF L-IDENT(I) = ##EQU-PRINT
    #AR-REPNAME := L-NAME (I)
    #AR-REPRNB  := L-RNB (I)
    FIND ACTIVE-REPORTS WITH AR-REPORT-RNB = #AR-REPORT-RNB
      #SPOOL-ATTRIBUTES := AR-SPOOL-ATTRIBUTES
      IF AR-CC-TYPE = BINARY AND NOT #WARNING
          AND #SPOOL-DI-FILETYPE NE 'prn'
        #WARNING := TRUE
        INPUT WINDOW='WARNING' USING MAP 'RLIACFW&'
        #WIN-PFKEY := *PF-KEY
        DECIDE ON FIRST VALUE OF #WIN-PFKEY
          VALUE 'PF3'
            RESET L-IDENT (I) L-MARK (I)
            G-NATRP-ERC := 428 /* Report not queued for printing.
          VALUE 'PF5'
            IGNORE
          NONE
            REINPUT ' '
        END-DECIDE
      END-IF
    END-FIND
  END-IF
  IF L-IDENT (I) = ##EQU-DELETE
    G-NATRP-ERC := 0017
    IF G-CONFIRM
      #OBJECT-NAME := L-NAME(I)
      #OBJECT-TYPE := 'R'
      CALLNAT 'N-CNFRM' #OBJECT-NAME #OBJECT-TYPE G-DISPLAY-LONG-NAMES
        #CONFIRMED G-NATRP-ERT LOWER-CASE
    END-IF
    IF #CONFIRMED OR NOT G-CONFIRM
      DGU.
      GET BUNDLE-CONTENTS L-ISN (I)
      DELETE RECORD (DGU.)
      COMPRESS G-C-BUNDLE '/' G-C-BUNDRNB TO #OBJ LEAVING NO
      PERFORM RMLOGDEL #OBJ 'BUNDLE-CONTENTS'
      G-NATRP-ERC := 0018
      GET-SCREEN := TRUE
      LG-USERID := G-USERID
      LG-CODE := 'AB'
      LG-BUNDLE := G-C-BUNDLE
      LG-BUNDRNB := G-C-BUNDRNB
      COMPRESS G-C-BUNDLE '-' G-C-BUNDRNB TO LG-OBJECT-NAME LEAVING NO
      COMPRESS L-NAME (I) '/' L-RNB  (I) TO LG-MSG LEAVING NO
      COMPRESS '0772' LG-MSG TO LG-MSG
      CALLNAT 'RLOG' PL-PARMS
      END TRANSACTION
    END-IF
  END-IF
END-FOR
*
FOR I 1 TO #NOFLINES
  DECIDE ON FIRST VALUE OF L-IDENT (I)
    VALUE ##EQU-BROWSE
      #AR-REPNAME := L-NAME (I)
      #AR-REPRNB  := L-RNB (I)
      PERFORM CHECK-SPOOL-ERROR
      IF G-NATRP-ERC NE 0
        ESCAPE BOTTOM
      END-IF
      G-C-REPORT  := L-NAME (I)
      G-C-REPRNB  := L-RNB (I)
      PERFORM COMMIT-WORK
      RESET L-MARK (I) L-IDENT (I)
      PERFORM STACK-SCREEN
      FETCH 'RDISRP' G-C-REPORT G-C-REPRNB
    VALUE ##EQU-MODIFY
      G-C-REPORT  := L-NAME(I)
      G-C-REPRNB  := L-RNB(I)
      PERFORM COMMIT-WORK
* BLI 2017-12-15 NOMALL-1986 not allowed #UPDATE is rejected above
**    IF NOT #UPDATE
**      G-C-FUNC := 'D'
**    ELSE
      G-C-FUNC := 'M'
**    END-IF
      FETCH RETURN 'RDEFBC'
        #BINARY-REPORTS
      GET-SCREEN := TRUE
    VALUE ##EQU-PRINT
      RESET L-MARK (I) L-IDENT (I)
      G-C-REPORT := L-NAME (I)
      G-C-REPRNB := L-RNB (I)
      FETCH RETURN 'RPRTAR'
    NONE VALUE
      IGNORE
  END-DECIDE
END-FOR
*
END-SUBROUTINE /* LINE-COMMANDS
*
************************************************************************
DEFINE SUBROUTINE CHECK-FOLDER
************************************************************************
RESET #BROWSE
IF G-USER-TYPE = 'A'
  #BROWSE := TRUE
  ESCAPE ROUTINE
END-IF
*
RESET #MA-REP-RNB
#MA-REP    := L-NAME(I)
#MA-REPRNB := L-RNB(I)
MA. FIND MAIL-REPORTS WITH MA-REP-RNB = #MA-REP-RNB
*
  RESET #GRANTED #OPTIONS(*) #FO-ID-N
  #GR-USERID := G-USERID
  DECIDE FOR FIRST CONDITION
/* mailed to g-userid own folder
    WHEN MA-USERID = G-USERID AND MA-FO-ID = 0001
      #BROWSE := TRUE
/* mailed to g-userid, to linked folder
    WHEN MA-USERID = G-USERID AND MA-FO-ID NE 0001
      #FO-ID   := MA-FO-ID
      #FO-USER := MA-USERID
      FFO. FIND FOLDER WITH FO-USER-FO-ID = #FO-USER-ID
        #FO-ID-N := FO-LINKED-ID
        COMPRESS FO-LINKED-USERID #FO-ID-A TO #FO-NAME LEAVING NO
        CALLNAT 'RGRANT-N' #GR-USERID 'F' #FO-NAME #GRANTED #OPTIONS(*)
        IF #GRANTED
* BLI     2017-12-15 NOMALL-1986 check options (1:4)
**        IF #OPTIONS(1) = 'Y' OR #OPTIONS(4) = 'Y'
          IF #OPTIONS(1:4) = 'Y'
            #BROWSE := TRUE
            ESCAPE BOTTOM (FFO.)
          END-IF
        END-IF
      END-FIND
/* mailed not to g-userid, but contains in linked folder
    WHEN MA-USERID NE G-USERID AND MA-FO-ID = 0001
      #FO-ID-N := MA-FO-ID
      COMPRESS MA-USERID #FO-ID-A TO #FO-NAME LEAVING NO
      CALLNAT 'RGRANT-N' #GR-USERID 'F' #FO-NAME #GRANTED #OPTIONS(*)
      IF #GRANTED
* BLI     2017-12-15 NOMALL-1986 check options (1:4)
**      IF #OPTIONS(1) = 'Y' OR #OPTIONS(4) = 'Y'
        IF #OPTIONS(1:4) = 'Y'
          #BROWSE := TRUE
        END-IF
      END-IF
    WHEN NONE IGNORE
  END-DECIDE
  IF #BROWSE
    ESCAPE BOTTOM(MA.)
  END-IF
END-FIND
*
END-SUBROUTINE /* CHECK-FOLDER
*
************************************************************************
DEFINE SUBROUTINE CHECK-SPOOL-ERROR
************************************************************************
FIND ACTIVE-REPORTS WITH AR-REPORT-RNB = #AR-REPORT-RNB
  RESET G-NATRP-ERC
  IF AR-CURRENT-LOCATION = 'D' OR AR-SOURCE-ID = 0
    ESCAPE ROUTINE
  END-IF
  IF G-USE-OWNER
    IF ACTIVE-REPORTS.AR-USERID NE G-NPR-USERID-CURRENT
      FIND NRM-SOURCE WITH SR-ID = AR-SOURCE-ID
      END-FIND
      IF NRM-SOURCE.SR-TYPE NE NOM-DATA-BASE
        #SAVE-NPR-USERID := G-NPR-USERID
        G-NPR-USERID := ACTIVE-REPORTS.AR-USERID
        PERFORM LOGON-TO-ESY
        IF G-NATRP-ERC NE 0
          ESCAPE ROUTINE
        END-IF
        RESET G-NATRP-ERC G-NATRP-ERT
        G-NPR-USERID := #SAVE-NPR-USERID
      END-IF
    END-IF
  END-IF
  CALLNAT 'RMSRCK-N' G-NATRP-ERC G-NATRP-ERT AR-SOURCE-ID #EXIST
  IF NOT #EXIST
    G-NATRP-ERC := 426
  END-IF
END-FIND
*
END-SUBROUTINE /* CHECK-SPOOL-ERROR
*
************************************************************************
DEFINE SUBROUTINE INIT-SELECTION-KEYS
************************************************************************
#LEN := 25
CALLNAT 'SELALPHA' #S-REPNAME #S-REPNAME-F #S-REPNAME-T #LEN
CALLNAT 'SELALPHA' #S-GROUP #S-GROUP-F #S-GROUP-T #LEN
#SK-BUNDLE := G-C-BUNDLE
#SK-RNB    := G-C-BUNDRNB
#SK-GROUP  := #S-GROUP-F
#SK-SEQNO  := 0
*
END-SUBROUTINE /* INIT-SELECTION-KEYS
*
************************************************************************
DEFINE SUBROUTINE INIT-LINECOM
************************************************************************
G-LC-IDENT (01) := ##EQU-BROWSE
G-LC-IDENT (02) := ##EQU-MODIFY
G-LC-IDENT (03) := ##EQU-DELETE
G-LC-IDENT (04) := ##EQU-PRINT
G-LC-NUM        := 4
CALLNAT 'RLCINI-N' G-OBJ-TYPE G-LC G-LCB
*
END-SUBROUTINE /* INIT-LINECOM
*
************************************************************************
DEFINE SUBROUTINE INIT-PFKEYS
************************************************************************
INCLUDE RPFSTD-C
INCLUDE RPFBRW-C
INCLUDE RPFBRW-C
INCLUDE RPFLR--C
INCLUDE RPFEXT-C
CALLNAT 'RPFINI-N' G-PF G-PFB
*
END-SUBROUTINE /* INIT-PFKEYS
*
************************************************************************
DEFINE SUBROUTINE STACK-SCREEN
************************************************************************
FOR F = 1 TO 9
  IF L-SCREEN-SEG-L (F) = H'00'
    L-SCREEN-SEG-L (F) := H'01'
    L-SCREEN-SEG-FLAG (F) := TRUE
  ELSE
    L-SCREEN-SEG-FLAG (F) := FALSE
  END-IF
END-FOR
STACK TOP DATA FORMATTED L-SCREEN-SEGMENT (*) L-SCREEN-SEG-FLAG (*)
#STACK-PGM := *PROGRAM
STACK TOP DATA FORMATTED #STACK-PGM 'X' 'X' 'X' 'X'
STACK TOP COMMAND *PROGRAM
RESET F
*
END-SUBROUTINE /* STACK-SCREEN
*
************************************************************************
DEFINE SUBROUTINE READ-FROM-STACK
************************************************************************
INPUT #STACK-PGM
IF #STACK-PGM NE *PROGRAM
  *ERROR-NR := 999 /* internal error, should not occur
END-IF
INPUT (LS=202) L-SCREEN-SEGMENT (*) L-SCREEN-SEG-FLAG (*)
FOR F = 1 TO 9
  IF L-SCREEN-SEG-FLAG (F) = TRUE
    L-SCREEN-SEG-L (F) := H'00'
  END-IF
END-FOR
*
END-SUBROUTINE /* READ-FROM-STACK
*
************************************************************************
DEFINE SUBROUTINE CHECK-SOURCE
************************************************************************
IF L-SOURCE-ID (I) = 0
  ESCAPE ROUTINE
END-IF
*
IF G-USE-OWNER
  #AR-REPNAME := L-NAME (I)
  #AR-REPRNB  := L-RNB (I)
  FIND ACTIVE-REPORT-OWNER WITH AR-REPORT-RNB = #AR-REPORT-RNB
    IF AR-USERID NE G-NPR-USERID-CURRENT
      #SAVE-NPR-USERID := G-NPR-USERID
      G-NPR-USERID := AR-USERID
      PERFORM LOGON-TO-ESY
      RESET G-NATRP-ERC G-NATRP-ERT
      G-NPR-USERID := #SAVE-NPR-USERID
    END-IF
  END-FIND
END-IF
*
RESET #ERROR-CODE #ERROR-TEXT SOURCE-EXIST
CALLNAT 'RMSRCK-N' #ERROR-CODE #ERROR-TEXT L-SOURCE-ID (I) SOURCE-EXIST
IF #ERROR-CODE NE 0
  REINPUT *#ERROR-CODE, #ERROR-TEXT MARK *L-MARK(I) ALARM
END-IF
IF NOT SOURCE-EXIST
  REINPUT *0426 MARK *L-MARK(I) ALARM
END-IF
*
END-SUBROUTINE /* CHECK-SOURCE
* --------------------------------------- set pfkeys -------------------
INCLUDE RPFSET-C
*
END
