* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* MAP2: PROTOTYPE VERSION 820 --- CREATED BY NAT 0802030000 ---
* INPUT USING MAP 'XXXXXXXX'
*     #CODE
DEFINE DATA PARAMETER
1 #CODE (A001)
END-DEFINE
FORMAT PS=015 LS=051 ZP=OFF SG=OFF KD=OFF IP=OFF
* MAP2: MAP PROFILES *****************************        410***********
* .TTAAAMMOO   D I D I N D I D I        ?_)^&:+(   00000               *
* 015050        N0NNUCN             X        01 SYSPROF NLH          1 *
************************************************************************
INPUT          (     IP=OFF                                           /*
                                                                       )
 006T 'Sort flag for selected Active Reports'(I)
/
/
 001T 'This flag works if Active Reports in Folder are'
/
 001T 'selected by Report name. Then you can choose one'
/
 001T 'of 2 possible values:'
/
/
 008T 'D'(I)
 011T 'Selected Active Reports will be sorted'
/
 011T 'in list by date and time'
/
/
/
 008T 'N'(I)
 011T 'Selected Active Reports will be sorted'
/
 011T 'in list by Report name (default value)'
/
/
 009T 'Select'(I)
 016T '=>'
 020T #CODE  (AD=MILT'_' ) /*.99U001 A001 .
/
* MAP2: VALIDATION *****************************************************
RULEVAR F00#CODE
INCDIC                                 ;
IF NOT (& = 'D' OR = 'N')
REINPUT *682
ALARM
END-IF
SET CONTROL 'Q'
* MAP2: END OF MAP *****************************************************
END
