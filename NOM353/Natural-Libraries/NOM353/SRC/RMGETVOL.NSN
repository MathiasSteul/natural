* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RMGETVOL - Get Current VOLSER
*
* Maintenance:
* uuu     yyyy-mm-dd s(999999) ....
* mrs     1993-11-25 s(999999) clean up
* xsetggr 2007-05-02 NOM3201   support 5 byte node numbers
* fhi     2010-09-03 NOMALL-97 Extend message line
* SU1     2019-11-01 NOMALL-2343 show search parms in MSG
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 #DDNAME                    (A8)
1 #MONITOR-JOBNAME           (A8)
1 #NODE                      (N5)
1 #VOLSER                    (A6)
1 #DSNAME                    (A44)
1 #ERC                       (N4)
1 #ERT                       (A250)
************************************************************************
LOCAL USING VJOBALOC
LOCAL
1 I  (I1)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET #ERC #ERT #VOLSER
*
FORAL. FOR I = 1 TO 10 /*why 10 times ? SU1
  FNDAL. FIND ALLOCATIONS WITH NODE=#NODE AND JOB-NAME=#MONITOR-JOBNAME
  AND DDNAME   = #DDNAME                                              /*
    DECIDE ON FIRST ERROR-CODE
      VALUE 0     IGNORE
      VALUE 804   ESCAPE BOTTOM (FNDAL.) /*ESC5804 timeout
      NONE VALUE
        #ERC := ERROR-CODE
        COMPRESS ERROR-TEXT 'Node:' #NODE 'Jobname:' #MONITOR-JOBNAME
          'DDNAME:' #DDNAME TO #ERT /*SU1
        ESCAPE BOTTOM (FORAL.)
    END-DECIDE
    #VOLSER := VOLSER
    ESCAPE BOTTOM (FORAL.)
  END-FIND
END-FOR
END
