* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RMCKCMPR:  Test for correct compression routine NOMCOMPR          *
*            Writes 2 16k buffers, test NOMCOMPR with large buffers *
* template: CHCKCMP4                                                *
*                                                                   *
* Maintenance:                                                      *
* userid  yyyy-mm-dd NOMALL      Comment                            *
* ----------------------------------------------------------------- *
* fhi     2014-05-07 NOMALL-1415 created.
* fhi     2014-06-30 NOMALL-1415 Changed processing for mainframe.
*                                no tags entered, rewritten.
*********************************************************************
*
DEFINE DATA
PARAMETER
1 #CMPR-ERC                  (N4)   BY VALUE RESULT
*                                   0: OK
*                                   1: not found
*                                   2: wrong version
1 #CMPR-ERT                  (A250) BY VALUE RESULT
1 #TRACE                     (I1)   BY VALUE
************************************************************************
LOCAL
1 #VERS-OK                   (A4) CONST <'0304'> /*Correct compr version
1 #NSMVER-OUTVER             (A10) INIT <"----------">
1 #NSMVER-RC                 (B2)
1 #VERSION                   (A4)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
************************************************************************
* Check version number on Unix (new with NAT 8.3):
************************************************************************
IF *MACHINE-CLASS NE 'MAINFRAME'
  CALL "NSMCMPV" #NSMVER-OUTVER
  #NSMVER-RC := RET('NSMCMPV')
  IF SUBSTR (#NSMVER-OUTVER,1,4) < #VERS-OK
/* We check against #VERS-OK because this version is valid for the
/* current NOM version for now. Must be changed if a newer version of
/* NOMCOMPR will be a prerequisite.
    #CMPR-ERC := 2
    COMPRESS 'Wrong version of NOMCOMPR detected:' #NSMVER-OUTVER
      '- must be:' #VERS-OK 'or above.'
      TO #CMPR-ERT
  END-IF
  ESCAPE ROUTINE
ELSE
************************************************************************
* Now do the test if we run on mainframe:
************************************************************************
  CALLNAT 'XXDUMP' 'NRMCMP  ' #VERSION #CMPR-ERC #CMPR-ERT
  IF #CMPR-ERC = 0 AND #VERSION < #VERS-OK
    #CMPR-ERC := 2
    COMPRESS 'Wrong version of NOMCOMPR detected:' #VERSION
      '- must be:' #VERS-OK 'or above.'
      TO #CMPR-ERT
  END-IF
END-IF
*
END
