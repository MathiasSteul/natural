* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* MEMBER       MIG----C
* FUNCTION     Set migration flags in monitor record
*
* VERSION      3.5
*
* Variables needed: #MONITOR-ID (A20), #FOUND (L)
* Internal Subroutine needed: &1&
* View of monitor needed:     &2&
*
* Maintenance
* fhi  2019-01-25 NOMALL-2212 Created.
*
* ----------------------------------------------------------------------
RESET #FOUND
#MONITOR-ID := F#MONITOR-TASK-ID1 (<>)
FIND &2& WITH M-MONITOR-ID = #MONITOR-ID
  IF NO RECORDS FOUND
    #MONITOR-ID := *LIBRARY-ID
    FIND &2& WITH M-MONITOR-ID = #MONITOR-ID
      PERFORM &1&
      UPDATE
      #FOUND := TRUE
    END-FIND
    ESCAPE BOTTOM
  END-NOREC
  PERFORM &1&
  UPDATE
  #FOUND := TRUE
END-FIND
