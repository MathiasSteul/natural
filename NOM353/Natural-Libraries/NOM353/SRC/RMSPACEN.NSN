* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    RMSPACEN
* Version   1.3
* Function  Compute optimum extent size for given volsers
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* gw  91-11-26 s(999999) saved and rewritten
* gw  96-11-07 s(999999) vtoc.unit changed length from 3 to 4
*                        and unit-attributes doesn't find the unit
* sju     2000-06-14 p(197306) volser/space not built for disk archive
* fhi     2002-10-30 fhi101    switch on optimizer compiler
* xsetggr 2007-05-04 NOM3201   Support 5 bte node number
* fhi     2010-09-03 NOMALL-97 Extend message line
* SU1     2016-08-01 NOMALL-1518 NOM3.5 deactivate opt.Compiler
* fhi     2017-01-27 NOMALL-1961 Show node name in errors
* ----------------------------------------------------------------------
/*SU1 OPTIONS MCG=(INDX=ON,OVFLW=ON,DIGTCHCK=ON) /*fhi101 inserted
DEFINE DATA
PARAMETER
1 P-NODE                           (N5)
1 P-GENERIC                        (A8)
1 P-VOLSERS                        (A6/6)
1 P-VOLSER-STRING                  (A64)
1 P-SPACE-STRING                   (A64)
1 P-NATRP-ERC                      (N4)
1 P-NATRP-ERT                      (A250)
* fhi     2017-01-27 NOMALL-1961 start insertion
INDEPENDENT
1 +NOD-CURRENT-NAME            (A16)
* fhi     2017-01-27 NOMALL-1961 end   insertion
************************************************************************
LOCAL
1 DEVICE-NAMES  VIEW  OF  DEVICE-NAMES
  2 ERROR-CODE
  2 ERROR-TEXT
  2 ADDRESS
1 UNIT-ATTRIBUTES  VIEW  OF  UNIT-ATTRIBUTES
  2 ERROR-CODE
  2 ERROR-TEXT
  2 UNIT-HEX
  2 CONTIG-CYLINDERS
  2 VOLSER
  2 DEVICE-STATUS
1 VTOC VIEW OF VTOC
  2 ERROR-CODE
  2 ERROR-TEXT
  2 UNIT
*
1 #I                               (I4)
1 #J                               (I4)
1 #K                               (I4)
1 #V                               (I4)
1 #SUM                             (I4)
1 #MAX-SUM                         (I4)
1 #EXTENT-SIZE                     (I4)
1 #EXTENT-SIZE-TEMP                (I4)
1 #EXTENT-INCREMENT                (I4)
1 #EXTENTS-ON-VOLUME               (I4)
1 #NUMBER-OF-EXTENTS               (I4)
1 #CONTIG                          (N5/6)
1 #VOLSERS                         (A6/6)
1 #VOLSER                          (A6)
1 #L                               (I2)
1 #UNIT-A4                         (A4)
1 REDEFINE #UNIT-A4
  2 #FILLER                        (A1)
  2 #UNIT                          (A3)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET P-NATRP-ERC P-NATRP-ERT
*
IF NOT P-VOLSERS (*) NE ' '
  PERFORM SCAN-VOLSERS
  IF P-NATRP-ERC NE 0
    ESCAPE ROUTINE
  END-IF
ELSE
  #VOLSERS (*) := P-VOLSERS (*)
  RESET P-VOLSERS (*)
  FOR #V 1 6
    IF #VOLSERS (#V) = ' '
      ESCAPE BOTTOM
    END-IF
    #VOLSER := #VOLSERS (#V)
    PERFORM UPDATE-VOLSER-EXTENT-TAB
    IF P-NATRP-ERC NE 0
      ESCAPE ROUTINE
    END-IF
  END-FOR
END-IF
*
PERFORM GET-BEST-SIZE
*
PERFORM BUILD-STRINGS
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE BUILD-STRINGS
************************************************************************
COMPRESS '(CYL,(' #EXTENT-SIZE ',' #EXTENT-SIZE '),RLSE)'
  TO P-SPACE-STRING LEAVING NO
*
COMPRESS '(' P-VOLSERS (1) TO P-VOLSER-STRING LEAVING NO
FOR #V 2 6
  IF P-VOLSERS (#V) = ' '
    ESCAPE BOTTOM
  END-IF
  COMPRESS P-VOLSER-STRING ',' P-VOLSERS (#V)
    TO P-VOLSER-STRING LEAVING NO
END-FOR
COMPRESS P-VOLSER-STRING ')'
  TO P-VOLSER-STRING LEAVING NO
*
END-SUBROUTINE /* BUILD-STRINGS
*
************************************************************************
DEFINE SUBROUTINE SCAN-VOLSERS
************************************************************************
FIND DEVICE-NAMES WITH NODE = P-NODE AND NAME = P-GENERIC
  IF ERROR-CODE NE 0
    P-NATRP-ERC := 21
*   P-NATRP-ERT := ERROR-TEXT
* fhi     2017-01-27 NOMALL-1961 line above out, start insertion
    COMPRESS ERROR-TEXT '/' +NOD-CURRENT-NAME '/' *PROGRAM '/' *LINE
      TO P-NATRP-ERT
* fhi     2017-01-27 NOMALL-1961 end insertion
    ESCAPE ROUTINE
  END-IF
  PERFORM UPDATE-VOLSER-EXTENT-TAB
  IF P-NATRP-ERC NE 0
    ESCAPE ROUTINE
  END-IF
*
END-FIND
*
END-SUBROUTINE /* SCAN-VOLSERS
*
************************************************************************
DEFINE SUBROUTINE GET-BEST-SIZE
************************************************************************
#EXTENT-SIZE-TEMP := #CONTIG (1) + 10
#EXTENT-INCREMENT := -10
REPEAT
  #EXTENT-SIZE-TEMP := #EXTENT-SIZE-TEMP + #EXTENT-INCREMENT
  IF #EXTENT-SIZE-TEMP <= 0
    #EXTENT-SIZE-TEMP := #EXTENT-SIZE
    #EXTENT-INCREMENT := 1
    ESCAPE TOP
  END-IF
  RESET #NUMBER-OF-EXTENTS
  FOR #I 1 6
    IF #CONTIG (#I) = 0
      ESCAPE BOTTOM
    END-IF
    #EXTENTS-ON-VOLUME := #CONTIG (#I) / #EXTENT-SIZE-TEMP
    ADD #EXTENTS-ON-VOLUME TO #NUMBER-OF-EXTENTS
    IF #NUMBER-OF-EXTENTS >= 17
      #NUMBER-OF-EXTENTS := 17
      ESCAPE BOTTOM
    END-IF
  END-FOR
  #SUM := #NUMBER-OF-EXTENTS * #EXTENT-SIZE-TEMP
  IF #SUM > #MAX-SUM
    #EXTENT-SIZE := #EXTENT-SIZE-TEMP
    #MAX-SUM := #SUM
  ELSE
    IF #EXTENT-INCREMENT = 1
      ESCAPE ROUTINE
    END-IF
  END-IF
END-REPEAT
*
END-SUBROUTINE /* GET-BEST-SIZE
*
************************************************************************
DEFINE SUBROUTINE UPDATE-VOLSER-EXTENT-TAB
************************************************************************
IF DEVICE-NAMES.ADDRESS = 0
  FIND (1) VTOC WITH VOLSER = #VOLSER AND NODE   = P-NODE
    IF ERROR-CODE NE 0
      P-NATRP-ERC := 21
*     P-NATRP-ERT := ERROR-TEXT
* fhi     2017-01-27 NOMALL-1961 line above out, start insertion
      COMPRESS ERROR-TEXT '/' +NOD-CURRENT-NAME '/' *PROGRAM '/' *LINE
        TO P-NATRP-ERT
* fhi     2017-01-27 NOMALL-1961 end insertion
      ESCAPE ROUTINE
    END-IF
  END-FIND
END-IF
*
EXAMINE VTOC.UNIT FOR ' ' GIVING LENGTH #L
IF #L = 4
  #UNIT-A4  := VTOC.UNIT
  VTOC.UNIT := #UNIT-A4
END-IF
FIND (1) UNIT-ATTRIBUTES WITH UNIT = VTOC.UNIT
    OR UNIT-HEX = DEVICE-NAMES.ADDRESS AND NODE = P-NODE
*
  IF ERROR-CODE NE 0
    P-NATRP-ERC := 21
*   P-NATRP-ERT := ERROR-TEXT
* fhi     2017-01-27 NOMALL-1961 line above out, start insertion
    COMPRESS ERROR-TEXT '/' +NOD-CURRENT-NAME '/' *PROGRAM '/' *LINE
      TO P-NATRP-ERT
* fhi     2017-01-27 NOMALL-1961 end insertion
    ESCAPE ROUTINE
  END-IF
*
  REJECT IF DEVICE-STATUS NE 'ONLINE'
*
  IF #CONTIG (6) < CONTIG-CYLINDERS
    FOR #I 1 6
      IF #CONTIG (#I) < CONTIG-CYLINDERS
        IF #I < 6
          #K := #I + 1
          FOR #J 6 #K STEP -1
            #CONTIG (#J) := #CONTIG (#J - 1)
            P-VOLSERS (#J) := P-VOLSERS (#J - 1)
          END-FOR
        END-IF
        #CONTIG (#I) := CONTIG-CYLINDERS
        P-VOLSERS (#I) := VOLSER
        ESCAPE BOTTOM
      END-IF
    END-FOR
  END-IF
END-FIND
*
END-SUBROUTINE /* UPDATE-VOLSER-EXTENT-TAB
*
END
