DEFINE DATA PARAMETER
/* >Natural Source Header 000000
/* :Mode S
/* :CP
/* <Natural Source Header
1 NOMSTCSP
  2 NOMSTCSP-PARAMS
    3 VERSION (N2) /** :in  OF THE INTERFACE
    3 FUNCTION (A1) /** :in  A/C/N/R/W
    3 ERC (N4) /** :out Error number
    3 ERT (A250) /** :out Error text
    3 SS-ITEM (A16) /** :in  Item to be read
    3 SS-TIMESTAMP (A16) /** :out Timestamp
    3 SS-START (A16) /** :out Begin of measure
  2 SS-NAME (A/1:*) DYNAMIC /* FOR FUTURE USE.
  2 SS-TITLE (A/1:*) DYNAMIC /* :OUT ITEM TITLE
  2 SS-VALUE (A/1:*) DYNAMIC /* :INOUT  VALUE OF  item
  2 TRACE (I2) OPTIONAL /** :IN TRACE-LEVEL
END-DEFINE
