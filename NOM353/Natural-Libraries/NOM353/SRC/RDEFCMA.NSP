* <Natural Source Header
* Member    RDEFCMA
* Version   1.3
* Function  Define CMASPOOL Defaults
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* gw  94-06-22 s(999999) created
* gw  95-01-17 p(136151) cataloged
* wcd 00-04-01 CE 7267   New PFkey for additional printers in RPFK---L
* sju 03-01-27 p(235267) CMASpool version 2
* xsetggr 2005-10-26 p(270950) ISN fields must be P10, not P8
* fhi     2010-09-03 NOMALL-97 Extend message line
* SU1     2016-08-01 NOMALL-1518 NOM3.5 deactivate opt.Compiler
* SU2     2020-11-10 NOMALL-2440 recat for VMONIT-L
* ----------------------------------------------------------------------
DEFINE DATA GLOBAL USING NRM-GL
LOCAL  USING RPFK---L
/*SU2 LOCAL  USING VMONIT-L
LOCAL
1 NRM-MONITOR VIEW OF NRM-MONITOR /*SU2 was VMONIT-L
  2 M-VERSION             (A60)
  2 M-BATCH-MODULE        (A8)
  2 M-DEFAULT-PRINTER     (A8)
  2 M-TIME-SCHEDULE       (A1) /*Scan CA SPOOL queue
  2 M-COPY-FILES-V141     (A26/1:20)
  2 REDEFINE M-COPY-FILES-V141
    3 M-CP-TAB            (1:20)
      4 M-CP-DBID         (N5)
      4 M-CP-FNR          (N5)
      4 M-CP-IDENT        (A16)
      4 REDEFINE M-CP-IDENT
        5 M-CP-IDENT-B    (A1/1:16)
  2 M-MONITOR-ID          (A20)
  2 M-WAIT-INCREMENT      (N3)
*
1 #FATHER-PROG               (A8) INIT <'RDFMEN'>
1 CV-MAP                     (C)  INIT <(AD=I CD=NE)>
1 #ISN                       (N10)
1 L-HEADER                   (A78)
1 #ALLOWED                   (L)
1 #FUNC                      (A1)
1 #LANGUAGE                  (I1)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET G-COMMIT G-LINECOM(*)
*
#FUNC := G-C-FUNC
MAIN-LOOP. REPEAT
  FIND-LOOP. FIND NRM-MONITOR WITH M-MONITOR-ID = 'CMASPOOL'
*
    IF NO RECORDS FOUND /*???? SU optional ? if required, return err
      M-MONITOR-ID := 'CMASPOOL'
      M-VERSION    := '90'
      STOR. STORE NRM-MONITOR /*CMASPOOL
      END TRANSACTION
      ESCAPE BOTTOM
    END-NOREC
    #ISN := *ISN (FIND-LOOP.)
    DECIDE ON FIRST VALUE OF #FUNC
      VALUE 'M'
        CALLNAT 'NARPSEC' G-USER-PROFILE 'MMO' #ALLOWED
        INCLUDE C-NALLOW
        GETREC. GET NRM-MONITOR #ISN
      VALUE 'D'
        CALLNAT 'NARPSEC' G-USER-PROFILE 'DMO' #ALLOWED
        INCLUDE C-NALLOW
        CV-MAP := (AD=IP)
      NONE IGNORE
    END-DECIDE
*
    SCREEN-LOOP. REPEAT
      IF #LANGUAGE NE *LANGUAGE
        PERFORM INIT-PFKEYS
        PERFORM SET-PFKEYS
        #LANGUAGE := *LANGUAGE
      END-IF
      PERFORM FLIP-DISPLAY
      CALLNAT 'N-HEADER' L-HEADER G-DATE-FORMAT 'RDEFAVM&'
      PERFORM BEFORE-INPUT
      INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT MARK *G-DIRECT-COMMAND
        USING MAP 'RDEFCMA&'
      PERFORM AFTER-INPUT
      RESET G-NATRP-ERC G-NATRP-ERT
*
      INCLUDE RPFKVA-C
      INCLUDE C-DIRECT
      INCLUDE RPFKED-C
*
      IF CV-MAP MODIFIED OR G-MAP-MODIFIED
        PERFORM VALIDATE-INPUT
        UPDATE(GETREC.)
        G-NATRP-ERC := 0032
        INCLUDE C-COMMIT
      END-IF
      INCLUDE REXDO--C
    END-REPEAT
  END-FIND
END-REPEAT
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-INPUT
************************************************************************
IF NOT M-TIME-SCHEDULE = 'Y' OR = 'N'
  REINPUT *1099 MARK *M-TIME-SCHEDULE ALARM
END-IF
IF NOT M-BATCH-MODULE = ' ' OR = '1' OR = '2'
  IF *LANGUAGE = 2
    REINPUT 'Bitte ''1'' oder ''2'' eingeben' MARK *M-BATCH-MODULE ALARM
  ELSE
    REINPUT 'Please enter ''1'' or ''2''' MARK *M-BATCH-MODULE ALARM
  END-IF
END-IF
*
END-SUBROUTINE /* VALIDATE-INPUT
*
************************************************************************
DEFINE SUBROUTINE BEFORE-INPUT
************************************************************************
ESCAPE ROUTINE
*
END-SUBROUTINE /* BEFORE-INPUT
*
************************************************************************
DEFINE SUBROUTINE AFTER-INPUT
************************************************************************
ESCAPE ROUTINE
*
END-SUBROUTINE /* AFTER-INPUT
*
************************************************************************
DEFINE SUBROUTINE INIT-PFKEYS
************************************************************************
RESET G-PF
*
INCLUDE RPFSTD-C
INCLUDE RPFCOM-C
CALLNAT 'RPFINI-N' G-PF G-PFB
*
END-SUBROUTINE /* INIT-PFKEYS
************************************************************************
