* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RDEFPH - Define a Physical Printer
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* gw  93-06-01 s(999999) rewritten
* sju 95-09-27 s(229945) support delete direct command
* gw  95-12-11 s(222350) user exit to allow/disallow access to NSPF
* gw  96-09-09 s(250901) avoid NAT1106 when invoking NSPF
* gw  98-03-13 s(278970) save search values in independent variables
* wcd 00-04-01 CE 7267   New PFkey for additional printers in RPFK---L
* sju 01-05-09 s(209360) 1st attribute corrupted with X'01'
* xsetoba 01-12-07 p(208312) several problems defining physical printer
* xsetggr 02-02-08 p(208312) reinput when err NOM1206
* fhi     02-06-13 p(225125) add printer type EMAIL
* fhi     02-10-30 fhi101    switch on optimizer compiler
* fhi     2003-02-06 p(225241) Get rid of prt type 'DISKUNIX','UNIXLP'
* xsetggr 2003-08-11 p(240465) allow non-defined userid call eom api
* fhi     2004-12-10 NOM3104   Backout p(225241)
* fhi     2008-06-25 P306560   Reactivate DISKUNIX printer type
* XSETHZ  2008-12-04 P310075   Reactivate print program select
* splildav 2009-02-19 P(311477)  check unix node name from sel list
* splildav 2009-03-02 P(311477)  Fix to work in Unix env
* xsetggr 2010-11-03 NOMALL-865  not allows skeleton for WRTSPOOL
* SU1     2013-06-05 NOMALL-1262 remove OS2PM,HPSPOOL,WINPM,WINPM32
* SU2     2014-06-10 NOMALL-1281 show last update user+date
* SU3     2016-08-01 NOMALL-1518 NOM3.5 deactivate opt.Compiler+S-SEPEDT
* fhi     2017-04-07 NOMALL-1961 Omit field PO-MONITOR
* SU4     2017-10-09 NOMALL-1823 NOM 3.5: remove CONNECT,ECL,XML
* SU5     2018-12-18             avoid NAT1108 after '*' on node
* SU6     2024-04-24 NOM36       remove unused
* ----------------------------------------------------------------------
DEFINE DATA GLOBAL USING  NRM-GL
*
LOCAL USING RPFK---L
LOCAL USING EOM----E
LOCAL USING EOM----P
LOCAL USING EOMPHM-E
LOCAL USING EOMPHM-P
LOCAL USING EOMPHTYE
LOCAL USING EOMMSG-P
LOCAL USING XXGMSG-A
*
LOCAL
1 USERS VIEW OF NRM-USERS
* *****
1 #FUNC                     (A1)
1 #PRINTER                  (A8)
*
1 CV-MAP                    (C) INIT < (AD=I CD=NE)>
1 CV-TYPE                   (C) INIT < (AD=I CD=NE)>
1 CV-PGM                    (C) INIT < (AD=I CD=NE)>
1 CV-SKELETON               (C) INIT < (AD=I CD=NE)>
1 CV-ATTR                   (C) INIT < (AD=I CD=NE)>
1 CV-DEFAULT                (C) INIT < (AD=I CD=NE)>
1 CV-KEY                    (C) INIT < (AD=I CD=NE)>
1 L-HEADER                  (A78)
1 READ-RECORD               (L)
1 #FATHER-PROG              (A8) INIT <'RLISPH'>
1 #LANGUAGE                 (I1)
1 #PANEL                    (I2)
1 #MAP-IND                  (N7) INIT <1>
1 #MAP-IX1                  (N7) INIT <1>
1 #MAP-IX2                  (N7) INIT <1>
1 #I                        (N7)
1 #J                        (N7)
1 #K                        (I2)
1 #CP                       (I2) INIT <1>
1 #END-OF-DATA              (L)
1 #LENGTH-DEFAULT           (I1) CONST<72>
1 #STRING                   (A72)
1 REDEFINE  #STRING
  2 #STRING-B               (A1/1:#LENGTH-DEFAULT)
1 #DYN-ATTRIBUTE            (A1)
1 #MAP-TAB                  (14)
  2 #LENGTH-TAB             (N3)
  2 #PROMPT-TAB             (A72)
1 #SET-DYN                  (L)
1 #MAP-OCC                  (I1) INIT <14>
1 #CURSOR                   (N5)
1 REDEFINE #CURSOR
  2 #CURSOR-LINE            (N2)
  2 #MARK                   (I2)
/*SU6 1 #EDIT-MEMBER(A8) 1 #EDIT-LIB(A8) 1 SPF-ACTIVE(L) 1 #NSPFCOM(A50)
/*SU6 1 #POS (I4) 1 #A8 (A8)
1 #ATTRIBUTES-VAR           (L)
1 #ZOOM-ON                  (L)
1 UX-NODES  VIEW OF NRM-UX-NODES
1 UNIX-NODE-NAME            (A16)
1 PHM-NODE-NAME             (A16)
1 MAP-PHP                   (L)
1 #LAST-MOD                 (A40)
1 #PROG                     (A8) INIT <*PROGRAM>
1 #MARK1                    (I4)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
DEFINE WINDOW ATTRIBUTE-ZOOM SIZE 13*78 BASE 08/02 CONTROL SCREEN
*
IF *DATA = 3
  INPUT (AD=MIT) G-C-FUNC G-C-PHYSICAL #PANEL
END-IF
IF G-C-FUNC = 'P'
  FETCH RETURN 'RDELPH'
  INCLUDE C-ESCAPE
END-IF
*
RESET G-COMMIT G-LINECOM(*)
*
#FUNC := G-C-FUNC
#PRINTER := G-C-PHYSICAL
*
EOM-USER-PROFILE := G-USER-PROFILE
EOM-USER         := G-USERID
EOM-USER-TYPE    := G-USER-TYPE
FNDUS. FIND NUMBER USERS WITH USER-ID = G-USERID
IF *NUMBER (FNDUS.) = 0
  EOM-DEF-USER := 'Y'
END-IF
EOM-LANGUAGE := *LANGUAGE
CALLNAT 'RGETLIB' EOM-LIBRARY
COMPRESS EOM-LIBRARY 'U' TO EOM-USER-LIBRARY LEAVING NO
IF #PANEL = 0
  #PANEL := PRINTER-GENERAL-ATTRIBUTES
END-IF
*
MAIN-LOOP. REPEAT
*
  EOMPHM-I-ID             := #PRINTER
  EOMPHM-I-ATTRIBUTE-TYPE := #PANEL
*
  DECIDE ON FIRST #FUNC
    VALUE 'A'
      EOM-FUNCTION            := EOM-INIT
      EOMPHM-I-ATTRIBUTE-TYPE := PRINTER-GENERAL-ATTRIBUTES
      #PANEL                  := PRINTER-GENERAL-ATTRIBUTES
      RESET EOMPHM-GENERAL-ATTRIBUTES #PROMPT-TAB (*) #PRINTER #LANGUAGE
    VALUE 'M'
      EOM-FUNCTION := EOM-READHOLD
    VALUE 'D'
      EOM-FUNCTION := EOM-READ
    NONE  G-NATRP-ERC := 9999
      INCLUDE C-ESCAPE
  END-DECIDE
*
  FIND-LOOP. REPEAT
    RESET EOMMSG-PARMS
    CALLNAT 'EOMPHM-N' EOM-PARMS EOMPHM-PARMS EOMMSG-PARMS
    IF EOMMSG-NR NE 0
      G-NATRP-ERC := EOMMSG-NR
      G-NATRP-ERT := EOMMSG-TOKEN (1)
      INCLUDE C-ESCAPE
    END-IF
    G-HOLD-TIME := *TIMX
    SCREEN-LOOP. REPEAT
      IF #LANGUAGE NE *LANGUAGE
        #LANGUAGE := *LANGUAGE
        PERFORM INIT-PFKEYS
        PERFORM SET-PFKEYS
      END-IF
      IF #FUNC NE 'D'
        INCLUDE C-HOLD
      END-IF
      PERFORM FLIP-DISPLAY
      SET CONTROL 'L'
      SET CONTROL 'WB'
      CALLNAT 'N-HEADER' L-HEADER G-DATE-FORMAT 'RDEFPHG&'
      CALLNAT 'N-HEAD2' EOMPHM-LAST-UPDATE-USER EOMPHM-LAST-UPDATE
        #LAST-MOD G-DATE-FORMAT
      RESET G-MAP-MODIFIED
*
      IF #PANEL NE PRINTER-GENERAL-ATTRIBUTES
        PERFORM CHECK-TOP-BOTTOM-MORE-ALL
      END-IF
      PERFORM PREPARE-DYNAMIC-ATTRIBUTE
      IF #FUNC NE 'A'
        PERFORM GET-PROMPT-TEXT
      END-IF
*
      IF #MARK1 = 0
        #MARK1 := POS(G-DIRECT-COMMAND)
      END-IF
      DECIDE ON FIRST #PANEL
        VALUE PRINTER-GENERAL-ATTRIBUTES
          INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT,
            EOMMSG-TOKEN(2), EOMMSG-TOKEN(3)
            MARK #MARK1 USING MAP 'RDEFPHG&'
        VALUE PRINTER-SPECIAL-ATTRIBUTES
          DECIDE FOR FIRST CONDITION
            WHEN #ATTRIBUTES-VAR
              INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT,
                EOMMSG-TOKEN(2), EOMMSG-TOKEN(3)
                MARK #MARK1 USING MAP 'RDEFPHS&'
            WHEN NONE
              INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT,
                EOMMSG-TOKEN(2), EOMMSG-TOKEN(3)
                MARK #MARK1 USING MAP 'RDEFPHP&'
              MAP-PHP := TRUE
          END-DECIDE
        NONE IGNORE
      END-DECIDE
      RESET #MARK1
      PERFORM REMOVE-DYNAMIC-ATTRIBUTE
      PERFORM CHECK-MODIFIED
      RESET G-NATRP-ERC G-NATRP-ERT
*
      INCLUDE RPFKVA-C
      INCLUDE C-DIRECT
      INCLUDE RPFKED-C
*
      RESET READ-RECORD
*
      IF G-MAP-MODIFIED AND #FUNC NE 'D'
        PERFORM CHECK-ACTIVE-HELP
        EOMPHM-I-ID             := #PRINTER
        EOMPHM-I-ATTRIBUTE-TYPE := #PANEL
        IF #FUNC = 'A'
          EOM-FUNCTION := EOM-ADD
          READ-RECORD := TRUE
        ELSE
          EOM-FUNCTION := EOM-MODIFY
        END-IF
*
        RESET EOMMSG-PARMS
        CALLNAT 'EOMPHM-N' EOM-PARMS EOMPHM-PARMS EOMMSG-PARMS
*
        IF EOMMSG-NR = 0
          IF EOM-FUNCTION = EOM-ADD
            G-NATRP-ERC := 31
            #FUNC := 'M'
            RESET #LANGUAGE
          ELSE
            G-NATRP-ERC := 32
          END-IF
        ELSE
          PERFORM CHECK-ERROR-CODE
        END-IF
*
        INCLUDE C-COMMIT
      END-IF
*
      INCLUDE REXDO--C
*
      DECIDE ON FIRST VALUE OF G-PF-FUNC
        VALUE ##PFK-EXIT-SUBFUNC
          IF #PANEL NE PRINTER-GENERAL-ATTRIBUTES
            IF #ATTRIBUTES-VAR
              #PANEL := PRINTER-SPECIAL-ATTRIBUTES
              RESET #ATTRIBUTES-VAR
            ELSE
              #PANEL := PRINTER-GENERAL-ATTRIBUTES
            END-IF
            RESET #LANGUAGE
            READ-RECORD := TRUE
          END-IF
        VALUE ##PFK-UP
          SUBTRACT #MAP-OCC FROM #MAP-IND
        VALUE ##PFK-DOWN
          #J := #MAP-IND + #MAP-OCC - 1
          #K := EOMPHM-ATTRIBUTES-OCC - #J
          IF #K < #MAP-OCC
            #MAP-IND := EOMPHM-ATTRIBUTES-OCC - #MAP-OCC + 1
          END-IF
          IF #MAP-IND < 1
            #MAP-IND := 1
          END-IF
          IF #MAP-IND > 17
            #MAP-IND := 17
          END-IF
        VALUE ##PFK-VAR
          #ATTRIBUTES-VAR := TRUE
        VALUE ##PFK-PROMPT
          #ATTRIBUTES-VAR := FALSE
        VALUE ##PFK-ATTRIBUTES
          #PANEL := PRINTER-SPECIAL-ATTRIBUTES
          RESET #LANGUAGE         /* to re-init pf-keys
        VALUE ##PFK-EDIT
          PERFORM EDIT-SKELETON
        VALUE ##PFK-ZOOM
          #CURSOR := *CURSOR
          IF NOT (#CURSOR-LINE = 7 THRU 20)
            REINPUT *1206 MARK *G-DIRECT-COMMAND
          END-IF
          #MAP-IX1 := #MAP-IND + #CURSOR-LINE - 7
          #MAP-IX2 := #CURSOR-LINE - 6
          IF EOMPHM-ATTR-VAR(#MAP-IX1) = ' '
            REINPUT *1206 MARK *G-DIRECT-COMMAND
          END-IF
          #PANEL := PRINTER-ATTRIBUTE-ZOOM
          PERFORM INIT-PFKEYS
          PERFORM SET-PFKEYS
          #ZOOM-ON:= TRUE
          REPEAT
            PERFORM PREPARE-DYNAMIC-ATTRIBUTE
            INPUT WINDOW = 'ATTRIBUTE-ZOOM'
              WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
              MARK *G-DIRECT-COMMAND USING MAP 'RDEFPHZ&'
            PERFORM REMOVE-DYNAMIC-ATTRIBUTE
            PERFORM CHECK-MODIFIED
            UNTIL *PF-KEY = 'PF3'
          END-REPEAT
          #ZOOM-ON:= FALSE
          #PANEL := PRINTER-SPECIAL-ATTRIBUTES
          RESET #LANGUAGE         /* to re-init pf-keys
        NONE  IGNORE
      END-DECIDE
*
      IF READ-RECORD = TRUE
        ESCAPE BOTTOM (FIND-LOOP.)
      END-IF
*
    END-REPEAT
  END-REPEAT
END-REPEAT
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
*
************************************************************************
DEFINE SUBROUTINE CHECK-MODIFIED
************************************************************************
IF CV-TYPE MODIFIED OR CV-PGM MODIFIED  OR CV-SKELETON MODIFIED
    OR CV-ATTR MODIFIED  OR CV-MAP MODIFIED  OR CV-DEFAULT MODIFIED
  G-MAP-MODIFIED := TRUE
END-IF
*
END-SUBROUTINE /* CHECK-MODIFIED
*
************************************************************************
DEFINE SUBROUTINE CHECK-ACTIVE-HELP
************************************************************************
DECIDE FOR EVERY CONDITION
  WHEN EOMPHM-PRINTER-TYPE = SCAN '*'
    REINPUT USING HELP MARK *EOMPHM-PRINTER-TYPE
* fhi     2017-04-07 NOMALL-1961 start commenting
* WHEN EOMPHM-MONITOR-ID   = SCAN '*'
*   REINPUT USING HELP MARK *EOMPHM-MONITOR-ID
* fhi     2017-04-07 NOMALL-1961 end   commenting
  WHEN EOMPHM-JCL-SKELETON = SCAN '*'
    REINPUT USING HELP MARK *EOMPHM-JCL-SKELETON
  WHEN NONE IGNORE
END-DECIDE
*
END-SUBROUTINE /* CHECK-ACTIVE-HELP
*
************************************************************************
DEFINE SUBROUTINE CHECK-ERROR-CODE
************************************************************************
DECIDE ON FIRST EOMMSG-FIELD-NAME
  VALUE 'EOMPHM-I-ID'
    REINPUT *EOMMSG-NR MARK *#PRINTER
  VALUE 'EOMPHM-PRINTER-TYPE'
    REINPUT *EOMMSG-NR MARK *EOMPHM-PRINTER-TYPE
* VALUE 'EOMPHM-MONITOR-ID'
*   REINPUT *EOMMSG-NR MARK *EOMPHM-MONITOR-ID
* fhi     2017-04-07 NOMALL-1961 2 lines above out
  VALUE 'EOMPHM-PRINT-PGM'
    REINPUT *EOMMSG-NR MARK *EOMPHM-PRINT-PGM
  VALUE 'EOMPHM-JCL-SKELETON'
    REINPUT *EOMMSG-NR MARK *EOMPHM-JCL-SKELETON
  VALUE 'EOMPHM-ESCAPE-CHAR'
    REINPUT *EOMMSG-NR MARK *EOMPHM-ESCAPE-CHAR
  VALUE 'EOMPHM-TIME-FROM'
    REINPUT *EOMMSG-NR MARK *EOMPHM-TIME-FROM (EOMMSG-IND1)
  VALUE 'EOMPHM-TIME-TO'
    REINPUT *EOMMSG-NR MARK *EOMPHM-TIME-TO   (EOMMSG-IND1)
  VALUE 'EOMPHM-ATTR-VAR' , 'EOMPHM-ATTR-PROMPT' ,
      'EOMPHM-ATTR-LENGTH' , 'EOMPHM-ATTR-DEFAULT'
    #MARK := (EOMMSG-IND1 - #MAP-IND) * 4
    DECIDE ON FIRST EOMMSG-FIELD-NAME
      VALUE 'EOMPHM-ATTR-VAR'      ADD 1 TO #MARK
      VALUE 'EOMPHM-ATTR-PROMPT'   ADD 2 TO #MARK
      VALUE 'EOMPHM-ATTR-LENGTH'   ADD 3 TO #MARK
      VALUE 'EOMPHM-ATTR-DEFAULT'  ADD 4 TO #MARK
      NONE                         IGNORE
    END-DECIDE
    REINPUT *EOMMSG-NR MARK #MARK
  NONE VALUE
    #MARK1 := (EOMMSG-IND1 - #MAP-IND) +1
    G-NATRP-ERC := EOMMSG-NR
    G-NATRP-ERT := EOMMSG-TOKEN(1)
END-DECIDE
*
END-SUBROUTINE /* CHECK-ERROR-CODE
*
************************************************************************
DEFINE SUBROUTINE CHECK-TOP-BOTTOM-MORE-ALL
************************************************************************
IF #MAP-IND < 1
  #MAP-IND := 1
END-IF
#J := EOMPHM-ATTRIBUTES-OCC
IF #MAP-IND + #MAP-OCC > #J AND G-C-FUNC = 'D'
  #MAP-IND := #J - #MAP-OCC + 1
END-IF
IF #MAP-IND > #J
  #MAP-IND := #J
END-IF
#I := #MAP-IND
#K := #J - #I
IF #J = 0
  #MAP-IND := 1
  RESET G-NATRP-ERC
ELSE
  DECIDE FOR EVERY CONDITION
    WHEN #K < #MAP-OCC
      RESET #CP                   /* indicate 'bottom of data'
      #END-OF-DATA := TRUE
    WHEN #K >= #MAP-OCC
      RESET #CP #END-OF-DATA      /* indicate 'more ...'
    WHEN #MAP-IND <= 1
      #MAP-IND := 1
      #CP := 1                    /* indicate 'top of data'
      RESET #END-OF-DATA
    WHEN #J <= #MAP-OCC AND #J NE #MAP-IND
      #CP := 1                    /* indicate 'all'
      #END-OF-DATA := TRUE
    WHEN NONE
      IGNORE
  END-DECIDE
*
  INCLUDE C-TOPBOT
*
END-IF
*
END-SUBROUTINE /* CHECK-TOP-BOTTOM-MORE-ALL
*
************************************************************************
DEFINE SUBROUTINE PREPARE-DYNAMIC-ATTRIBUTE
************************************************************************
IF #FUNC NE 'A'
  #DYN-ATTRIBUTE := H'01'
  #SET-DYN := TRUE
  PERFORM SET-DYNAMIC-ATTRIBUTE
END-IF
*
DECIDE FOR EVERY CONDITION
*
  WHEN #FUNC = 'A'
    CV-KEY := CV-MAP := CV-TYPE := CV-SKELETON := CV-ATTR := (AD=I)
    CV-PGM := (AD=IP)
  WHEN #FUNC = 'M'
    CV-KEY := CV-TYPE := (AD=IP)
    CV-MAP := (AD=I)
    DECIDE ON FIRST VALUE EOMPHM-PRINTER-TYPE
      VALUE ##PHYS-VTAM , ##PHYS-NAF, ##PHYS-UNIXLP,
          ##PHYS-CMASPOOL , ##PHYS-NATUNIX, ##PHYS-DISKUNIX,
          ##PHYS-WRTSPOOL           /* xsetggr 2010-11-03 NOMALL-865 in
        CV-PGM := CV-SKELETON := CV-ATTR := (AD=IP)
      NONE
        CV-PGM := CV-ATTR := (AD=IP)
        CV-SKELETON := (AD=I)
    END-DECIDE
    IF #ZOOM-ON
      IF EOMPHM-ATTR-LENGTH (#MAP-IX1) <= 50
        CV-DEFAULT := (AD=DP)
        EOMPHM-ATTR-DEFAULT-51-72 (#MAP-IX1) := H'01'
      ELSE
        CV-DEFAULT := (AD=I)
      END-IF
    END-IF
  WHEN #FUNC = 'D'
    CV-KEY := CV-MAP := CV-TYPE := CV-PGM := CV-SKELETON := CV-ATTR :=
    CV-DEFAULT := (AD=IP)
  WHEN NONE
    IGNORE
*
END-DECIDE
*
END-SUBROUTINE /* PREPARE-DYNAMIC-ATTRIBUTE
*
************************************************************************
DEFINE SUBROUTINE REMOVE-DYNAMIC-ATTRIBUTE
************************************************************************
IF #FUNC NE 'A'
  #DYN-ATTRIBUTE := ' '
  #SET-DYN := FALSE
  PERFORM SET-DYNAMIC-ATTRIBUTE
END-IF
*
END-SUBROUTINE /* REMOVE-DYNAMIC-ATTRIBUTE
*
************************************************************************
DEFINE SUBROUTINE SET-DYNAMIC-ATTRIBUTE
************************************************************************
FOR #I 1 #MAP-OCC
  #J := #MAP-IND - 1 + #I
  PHM-NODE-NAME := EOMPHM-ATTR-DEFAULT(#J)
  IF #SET-DYN = FALSE AND PHM-NODE-NAME NE ' '
      AND EOMPHM-ATTR-VAR(#J) =  'SERVICE ' AND MAP-PHP =TRUE
      AND *PF-KEY = 'ENTR' AND EOMPHM-PRINTER-TYPE = ##PHYS-DISKUNIX
    RESET MAP-PHP
    UXNO. FIND NUMBER UX-NODES WITH UX-NODE-NAME = PHM-NODE-NAME
    IF *NUMBER (UXNO.) = 0
      UNIX-NODE-NAME := PHM-NODE-NAME
      CALLNAT 'HRSELUXN' 'U' UNIX-NODE-NAME
      EOMPHM-ATTR-DEFAULT(#J) := UNIX-NODE-NAME
    END-IF
  END-IF
  IF #SET-DYN
    #K := EOMPHM-ATTR-LENGTH (#J) + 1
    #LENGTH-TAB (#I) := #K
  ELSE
    #K := #LENGTH-TAB (#I)
  END-IF
  IF #K = 2 THRU 71
    #STRING := EOMPHM-ATTR-DEFAULT (#J)
    #STRING-B (#K) := #DYN-ATTRIBUTE
    RESET  #STRING-B (#K + 1 : #LENGTH-DEFAULT)
    EOMPHM-ATTR-DEFAULT (#J) := #STRING
  ELSE
    EOMPHM-ATTR-DEFAULT (#J) := #DYN-ATTRIBUTE
  END-IF
*
END-FOR
*
END-SUBROUTINE /* SET-DYNAMIC-ATTRIBUTE
*
************************************************************************
DEFINE SUBROUTINE GET-PROMPT-TEXT
************************************************************************
RESET #PROMPT-TAB (*)
*
FOR #I 1 #MAP-OCC
  #J := #MAP-IND + #I - 1
  IF EOMPHM-ATTR-PROMPT (#J) = 0
    ESCAPE TOP
  END-IF
  #XX-ERROR-CODE := EOMPHM-ATTR-PROMPT (#J)
  CALLNAT 'XXGMSG-N' #XX-GMSG-PARMS
  #PROMPT-TAB (#I) := #XX-SHORT-TEXT
END-FOR
*
END-SUBROUTINE /* GET-PROMPT-TEXT
*
************************************************************************
DEFINE SUBROUTINE EDIT-SKELETON
************************************************************************
IF EOMPHM-JCL-SKELETON = ' '
  ESCAPE ROUTINE
END-IF
PERFORM S-SEPED2 #PROG EOMPHM-JCL-SKELETON #FUNC #PRINTER #PANEL
*
END-SUBROUTINE /* EDIT-SKELETON
*
************************************************************************
DEFINE SUBROUTINE INIT-PFKEYS
************************************************************************
RESET G-PF
*
INCLUDE RPFSTD-C
*
DECIDE ON FIRST #PANEL
  VALUE PRINTER-GENERAL-ATTRIBUTES
    INCLUDE RPFADD-C
    INCLUDE RPFCOM-C
    IF #FUNC NE 'A'
      INCLUDE RPFATT-C
    END-IF
    INCLUDE RPFEDT-C
  VALUE PRINTER-SPECIAL-ATTRIBUTES
    INCLUDE RPFESF-C
    INCLUDE RPFADD-C
    INCLUDE RPFCOM-C
    INCLUDE RPFBRW-C
    IF NOT EOMPHM-PRINTER-TYPE = ##PHYS-VTAM
      INCLUDE RPFVAR-C
      INCLUDE RPFPMT-C
    END-IF
    INCLUDE RPFZOM-C
  VALUE PRINTER-ATTRIBUTE-ZOOM
    INCLUDE RPFESF-C
  NONE  #PANEL := PRINTER-GENERAL-ATTRIBUTES
END-DECIDE
*
CALLNAT 'RPFINI-N' G-PF G-PFB
*
END-SUBROUTINE /* INIT-PFKEYS
*
INCLUDE RPFSET-C /*SET-PFKEYS
*
END
