* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RPFKED-C       EXECUTE LOCAL COMMANDS
*
* MAINTENANCE:
* ----------------------------------------------------------------------
INCLUDE RPFKVA-C
DECIDE ON FIRST VALUE OF G-PF-FUNC
  VALUE 'HELP'
    REINPUT USING HELP
  VALUE 'ADD','PF14'
    PERFORM COMMIT-WORK
    #FUNC := G-C-FUNC := 'A'
    ESCAPE BOTTOM (FIND-LOOP.)
  VALUE 'EXIT'
    INCLUDE C-ESCAPE
  VALUE 'FLIP'
    PERFORM FLIP-HANDLE
  VALUE 'UNDO'
    BACKOUT TRANSACTION
    RESET G-HOLD-TIME
    G-NATRP-ERC := 0016
    RESET G-COMMIT
    IF G-C-FUNC = 'A'
      #FUNC := 'A'
    END-IF
    ESCAPE BOTTOM (FIND-LOOP.)
  VALUE 'FOLLOW'
    PERFORM FOLLOW-MONITOR
    ESCAPE TOP
  VALUE 'MENU'
    INCLUDE C-MENU
  NONE IGNORE
END-DECIDE
