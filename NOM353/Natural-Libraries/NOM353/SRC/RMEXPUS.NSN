DEFINE DATA
PARAMETER USING XXUX---P
PARAMETER USING RMEXP-A
PARAMETER
1 #TRACING               (L)
1 #ID                    (A250) BY VALUE OPTIONAL
************************************************************************
INDEPENDENT
1 +ID                    (A/*) DYNAMIC
1 +ID-INDEX              (I2)
************************************************************************
/*SU4 LOCAL USING RMEXPUSL
LOCAL USING RMBAS64P
LOCAL USING VUXDEF-L
/*SU2 LOCAL USING VMONITUL /* NOMALL-2215 fhi in
LOCAL USING N-41002L /*SU1
* *****
LOCAL
1 US VIEW OF NRM-USERS /*SU4 was RMEXPUSL
  2 US-OBJECT-TYPE      (A10)
  2 US-OBJECT-TIME      (T)
  2 US-LAST-UPDATE      (T)
  2 US-LAST-UPDATE-USER (A16)
  2 USER-ID             (A8)
  2 USER-PASSWORD       (A8)
  2 USER-PROFILE        (A250)
  2 MR-MRS              (A8)
  2 LAST-NAME           (A32)
  2 FIRST-NAME          (A32)
  2 INITIAL             (A1)
  2 WORK-TITLE          (A32)
  2 WORK-ORGANIZATION   (A32)
  2 WORK-LOCATION       (A32)
  2 WORK-DEPT-NAME      (A32)
  2 WORK-DEPT-NUM       (A10)
  2 WORK-ADDRESS        (A60/1:3)
  2 WORK-CITY           (A32)
  2 WORK-STATE-PROV     (A8)
  2 WORK-POSTAL-CODE    (A10)
  2 WORK-COUNTRY        (A8)
  2 WORK-PHONE-COUNTRY  (N2)
  2 WORK-PHONE          (A15)
  2 WORK-PHONE-EXT      (A10)
  2 HOME-ADDRESS        (A60/1:3)
  2 HOME-CITY           (A32)
  2 HOME-STATE-PROV     (A8)
  2 HOME-POSTAL-CODE    (A10)
  2 HOME-COUNTRY        (A8)
  2 HOME-PHONE-COUNTRY  (N2)
  2 HOME-PHONE          (A15)
1 WRITE-FILE VIEW OF WRITE-FILE
  2 ERROR-CODE
  2 ERROR-TEXT
*
1 #FIELD                 (A32)
1 #VALUE                 (A300)
1 #LEN                   (I4)
1 #WORK-LINE             (A250)
1 #FUNCTION              (A10)
1 #I                     (I4)
1 #J                     (I4)
1 #K                     (I4)
1 #L                     (I4)
1 #PROGRAM               (A8) INIT <*PROGRAM>
1 REDEFINE #PROGRAM
  2 FILLER               5X /*RMEXP
  2 #TYPE                (A2)
1 #KEY                   (A100)
1 #KEY-FROM              (A100)
1 #KEY-TO                (A100) INIT FULL LENGTH <H'FF'>
1 #KEY-MASK              (A25)
/*SU4 1 #KEY-LEN               (I2)
1 #KEY-LEN2              (I2) CONST <8> /*full len USER-ID SU4
1 #TRACE-MSG             (A250)
1 #IND                   (I4)
1 #POS                   (I4)
1 #DEP                   (A5)
1 #NODE                  (N5)
1 #ID-MEMBER             (A) DYNAMIC
1 #EXPORT-PROG           (A8)
1 #MASK                  (A300) INIT FULL LENGTH <'P'>
1 #PRINTABLE             (A300)
1 #US-OBJECT-TIME        (A21)
1 #US-LAST-UPDATE        (A21)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
PERFORM #START
READ US BY USER-ID = #KEY-FROM THRU #KEY-TO
  #KEY := USER-ID
  PERFORM HANDLE-MASK
* Get depending objects:
  INCLUDE RMLD2XC1 'USER-ID' '''RMEXPFO'''
  COMPRESS '<US depending="' #DEP '">' TO #WORK-LINE LEAVING NO
  PERFORM WRITE-XML
  IF #OD-LOG = 'Y'
    IF #ID SPECIFIED
      COMPRESS 'Exported: US */' USER-ID TO #TRACE-MSG
    ELSE
      COMPRESS 'Exported: US /' USER-ID TO #TRACE-MSG
    END-IF
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    END TRANSACTION
  END-IF
  MOVE EDITED US.US-OBJECT-TIME (EM=YYYY'-'MM'-'DD'-'HH':'II':'SS'.'T)
    TO #US-OBJECT-TIME
  MOVE EDITED US.US-LAST-UPDATE (EM=YYYY'-'MM'-'DD'-'HH':'II':'SS'.'T)
    TO #US-LAST-UPDATE
  #FIELD := 'US-OBJECT-TYPE'
  #VALUE :=  US.US-OBJECT-TYPE
  PERFORM CONVERT-XML
  #FIELD := 'US-OBJECT-TIME'
  #VALUE :=  #US-OBJECT-TIME
  PERFORM CONVERT-XML
  #FIELD := 'US-LAST-UPDATE'
  #VALUE :=  #US-LAST-UPDATE
  PERFORM CONVERT-XML
  #FIELD := 'US-LAST-UPDATE-USER'
  #VALUE :=  US.US-LAST-UPDATE-USER
  PERFORM CONVERT-XML
  #FIELD := 'USER-ID'
  #VALUE :=  US.USER-ID
  PERFORM CONVERT-XML
  #FIELD := 'USER-PASSWORD'
  #VALUE :=  US.USER-PASSWORD
  PERFORM CONVERT-XML
  #FIELD := 'USER-PROFILE'
  #VALUE :=  US.USER-PROFILE
  PERFORM CONVERT-XML
  #FIELD := 'MR-MRS'
  #VALUE :=  US.MR-MRS
  PERFORM CONVERT-XML
  #FIELD := 'LAST-NAME'
  #VALUE :=  US.LAST-NAME
  PERFORM CONVERT-XML
  #FIELD := 'FIRST-NAME'
  #VALUE :=  US.FIRST-NAME
  PERFORM CONVERT-XML
  #FIELD := 'INITIAL'
  #VALUE :=  US.INITIAL
  PERFORM CONVERT-XML
  #FIELD := 'WORK-TITLE'
  #VALUE :=  US.WORK-TITLE
  PERFORM CONVERT-XML
  #FIELD := 'WORK-ORGANIZATION'
  #VALUE :=  US.WORK-ORGANIZATION
  PERFORM CONVERT-XML
  #FIELD := 'WORK-LOCATION'
  #VALUE :=  US.WORK-LOCATION
  PERFORM CONVERT-XML
  #FIELD := 'WORK-DEPT-NAME'
  #VALUE :=  US.WORK-DEPT-NAME
  PERFORM CONVERT-XML
  #FIELD := 'WORK-DEPT-NUM'
  #VALUE :=  US.WORK-DEPT-NUM
  PERFORM CONVERT-XML
  FOR #L := 3 TO 1 STEP -1
    IF US.WORK-ADDRESS (#L) NE ' '
      ESCAPE BOTTOM
    END-IF
  END-FOR
  FOR #I = 1 TO #L
    #FIELD := 'WORK-ADDRESS'
    #VALUE :=  US.WORK-ADDRESS(#I)
    PERFORM CONVERT-XML1
  END-FOR
  #FIELD := 'WORK-CITY'
  #VALUE :=  US.WORK-CITY
  PERFORM CONVERT-XML
  #FIELD := 'WORK-STATE-PROV'
  #VALUE :=  US.WORK-STATE-PROV
  PERFORM CONVERT-XML
  #FIELD := 'WORK-POSTAL-CODE'
  #VALUE :=  US.WORK-POSTAL-CODE
  PERFORM CONVERT-XML
  #FIELD := 'WORK-COUNTRY'
  #VALUE :=  US.WORK-COUNTRY
  PERFORM CONVERT-XML
  #FIELD := 'WORK-PHONE-COUNTRY'
  #VALUE :=  US.WORK-PHONE-COUNTRY
  MOVE LEFT #VALUE TO #VALUE
  PERFORM CONVERT-XML
  #FIELD := 'WORK-PHONE'
  #VALUE :=  US.WORK-PHONE
  PERFORM CONVERT-XML
  #FIELD := 'WORK-PHONE-EXT'
  #VALUE :=  US.WORK-PHONE-EXT
  PERFORM CONVERT-XML
  FOR #L := 3 TO 1 STEP -1
    IF US.HOME-ADDRESS (#L) NE ' '
      ESCAPE BOTTOM
    END-IF
  END-FOR
  FOR #I = 1 TO #L
    #FIELD := 'HOME-ADDRESS'
    #VALUE :=  US.HOME-ADDRESS(#I)
    PERFORM CONVERT-XML1
  END-FOR
  #FIELD := 'HOME-CITY'
  #VALUE :=  US.HOME-CITY
  PERFORM CONVERT-XML
  #FIELD := 'HOME-STATE-PROV'
  #VALUE :=  US.HOME-STATE-PROV
  PERFORM CONVERT-XML
  #FIELD := 'HOME-POSTAL-CODE'
  #VALUE :=  US.HOME-POSTAL-CODE
  PERFORM CONVERT-XML
  #FIELD := 'HOME-COUNTRY'
  #VALUE :=  US.HOME-COUNTRY
  PERFORM CONVERT-XML
  #FIELD := 'HOME-PHONE-COUNTRY'
  #VALUE :=  US.HOME-PHONE-COUNTRY
  MOVE LEFT #VALUE TO #VALUE
  PERFORM CONVERT-XML
  #FIELD := 'HOME-PHONE'
  #VALUE :=  US.HOME-PHONE
  PERFORM CONVERT-XML
*
  PERFORM #END-OBJ
END-READ
PERFORM #END
*
INCLUDE RMEXP-C /*CALL-NPR, WRITE-XML, OPEN-XML, CLOSE-XML, WRITE-XML
