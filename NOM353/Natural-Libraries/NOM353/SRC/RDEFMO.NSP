* xsetggr 2011-03-02 NOMALL-937 display rename,copy for BS2 in read-only
*                               mode
* xsetggr 2011-06-20 NOMALL-984 prevent use only first task under Unix
* raya    2011-06-23 NOMALL-1014 prevent nat1314 in analizing trace
* raya    2012-01-11 NOMALL-1096 add error-code/text to nomex007
* raya    2012-08-16 NOMALL-78  disable long records
* bli     2012-09-14 NOMALL-94  delete old version check
* raya     2012-11-29 NOMALL-1214 check cat date of nomex*
* SU1     2013-01-02 NOMALL-82  new class error
* SU2     2013-01-31 unused      Deactivate unused data areas
* raya    2013-05-09 NOMALL-1214 backout check cat date of nomex*
* SU3     2014-03-05 NOMALL-1281 show last update user+date
* SU4     2016-08-01 NOMALL-1518 NOM3.5 deactivate opt.Compiler
* fhi     2016-08-15 NOMALL-1620 Introduce Multinode Feature
* fhi     2016-09-09 NOMALL-1620 same
* fhi     2016-10-26 NOMALL-1620 Correct field validation
* fhi     2016-11-09 NOMALL-1961 Add number of copy tasks
* fhi     2016-11-15 NOMALL-1961 Use new task IDs
* fhi     2017-07-18 NOMALL-1918 Use Unix correctly
* fhi     2017-10-09 NOMALL-1620 Correct map display for BS2000
* fhi     2018-02-06 NOMALL-1918 Unix adaptions
* SU5     2018-02-20             NOM 3.5: BS2:rename or copy/ownUnix map
* SU6     2018-07-31             store BS2 device without H'FF'
* SU7     2018-09-25         M-INTERNAL-NODE-ID -> M-INTERNAL-EMAIL-NODE
* fhi     2018-11-07 NOMALL-1620 Add email addressees with PF11
* SU8    2019-08-26 NOMALL-2311 email adress:no check+store always (a)
* SU9     2020-11-10 NOMALL-2440 split DDM -> NRM-MF-NODES
* SU10    2022-03-16 ES-32029    Spool Class "SYSOUT" optional
* SU11    2024-03-07 ES-34613    NOM 3.6 Remove power + BS2
* NKEW1   2024-07-24 EF-4541     Decide what to show on map with func
* ----------------------------------------------------------------------
DEFINE DATA GLOBAL USING NRM-GL
INDEPENDENT
1 +MONITOR-FUNC             (A1)
1 +G-NOMEXIT-ACTIVE         (L/1:20)
1 +NOD-LOCAL-NAME           (A16)
1 +NOD-LOCAL-NODE           (N5)
1 +NOD-LOCAL-SPOOL-TYPE     (A8)
1 +NOD-LOCAL-SYSTEM-TYPE    (A8)
*
LOCAL USING RPFK---L
/*SU9 LOCAL USING VMONIT-L
LOCAL USING RLOG-L
LOCAL USING EOMFLD-E
LOCAL USING CONST-L /* NKEW1 changed
LOCAL
1 NRM-MONITOR VIEW OF NRM-MONITOR /*SU9 was VMONIT-L
  2 M-INTERNAL-EMAIL-NODE   (P15)
  2 M-COPY-FILES-V141       (A26/1:20)
  2 REDEFINE M-COPY-FILES-V141
    3 M-CP-TAB              (1:20)
      4 M-CP-DBID           (N5)
      4 M-CP-FNR            (N5)
      4 M-CP-IDENT          (A16)
      4 REDEFINE M-CP-IDENT
        5 M-CP-IDENT-B      (A1/1:16)
  2 M-EMAIL-RECIPIENTS      (A250/1:2)
  2 M-LAST-UPDATE           (T)
  2 M-LAST-UPDATE-USER      (A16)
  2 M-MAX-RETRIES           (N3)
  2 M-RETRY-INTERVAL        (N5)
  2 M-MONITOR-ID            (A20)
  2 M-LAST-ACTIVE           (T)
  2 REDEFINE M-LAST-ACTIVE
    3 M-LAST-ACTIVE-CK      (A7)
  2 M-WAIT-MINIMUM          (P9)
  2 M-WAIT-MAXIMUM          (N9)
  2 M-WAIT-INCREMENT        (N3)
  2 M-BATCH-MODULE          (A8)
  2 M-XCOM-JOBNAME          (A8)
  2 M-PRT-TASK-NO           (N2)
  2 M-NTDB-PROCESS          (N3)
  2 M-DATE-FORMAT           (A1)
  2 M-ARCHIVE-TIME          (T)
  2 REDEFINE M-ARCHIVE-TIME
    3 M-ARCHIVE-TIME-CK     (A7)
  2 M-BUNDLE-DEFAULTS       (A250)
  2 M-JOBCARD               (A72/1:3)
/*SU9 1 NODE-SPOOL-DATA VIEW OF NRM-MONITOR
1 MF-NODE VIEW OF NRM-MF-NODES /*SU9
  2 MF-LAST-UPDATE          (T)
  2 MF-LAST-UPDATE-USER     (A16)
  2 MF-SYSTEM-TYPE          (A8)
  2 MF-CLASSES              (A1/1:20)
  2 MF-TEMP-CLASS           (A4)
  2 MF-PRINT-CLASS          (A1)
  2 MF-ERR-CLASS            (A1)
  2 MF-TIME-SCHEDULE        (A1) /*BS2 rename/copy
  2 MF-BS2-DEST             (A8/1:4)  /*BS2
  2 MF-JES3-OUTPUT-CLASSES  (A1/1:20) /*JES3
* *****
1 #FATHER-PROG              (A8) INIT <'RDFMEN'>
1 CV-MAP                    (C) INIT <(AD=I)>
1 L-HEADER                  (A78)
1 #ALLOWED                  (L)
1 I                         (P3)
1 #FUNC                     (A1)
1 #LANGUAGE                 (I1)
1 #BS2-RENAME               (A1)
1 #BS2-COPY                 (A1)
1 #MODIFIED-BY-EXIT         (L)
1 #BS2-RENAME-CV            (C) INIT <(AD=I CD=NE)>
1 #BS2-COPY-CV              (C) INIT <(AD=I CD=NE)>
1 NOMEX007-FIELD-MODIFIABLE (A1)
1 NOMEX007-FIELD-VALUE      (A54)
1 #BUNDLE-DEFAULTS          (A250)
1 REDEFINE #BUNDLE-DEFAULTS
  2 #BUNDDEF
    3 B-CHAR-FIELDS1        (A40)
    3 B-FLUSH-TIME          (T)
    3 REDEFINE B-FLUSH-TIME
      4 B-FLUSH-TIME-A      (A7)
    3 B-CHAR-FIELDS2        (A197)
1 #PROGRAM                  (A8)
1 #LOG-FLAG                 (L)
1 #JC-ERR                   (L)
1 #LAST-MOD                 (A40)
1 #MF                       (L)
1 #POS1                     (I4)
1 #FF8                      (A8) CONST <H'FFFFFFFFFFFFFFFF'>
1 #EMPTY_A8                 (A8) CONST <' '>
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#PROGRAM := *PROGRAM
RESET G-COMMIT
*
IF G-C-FUNC = 'X' /* recursivly called
  G-C-FUNC := #FUNC := 'M'
ELSE
  #FUNC := 'D'
END-IF
IF *MACHINE-CLASS = 'MAINFRAME'
  #MF := TRUE
END-IF
* NKEW1 <
#JOB_ADD_FIELD := F#SETVAR(<#_JOBCARDS(1:2),#_ADDITIONALPARA(1:2)>)
* NKEW1 >
*
MAIN-LOOP. REPEAT
  NRM-MONITOR.M-MONITOR-ID := F#MONITOR-TASK-ID1 (<>)
  FIND-LOOP. FIND NRM-MONITOR WITH M-MONITOR-ID =
      NRM-MONITOR.M-MONITOR-ID
    IF NO RECORDS FOUND
      *ERROR-NR := 999 /* Internal error
    END-NOREC
    IF +NOD-LOCAL-SPOOL-TYPE NE 'UNIX' /*no data from unix node needed
/*SU 2018-07 MON. FIND NODE-SPOOL-DATA WITH M-MONITOR-ID = +NOD-LOCAL-ID
      LOCALMON. FIND MF-NODE WITH MF-INTERNAL-NODE-ID =
          NRM-MONITOR.M-INTERNAL-EMAIL-NODE /*SU7
/*SU7     NRM-MONITOR.M-INTERNAL-NODE-ID
        IF NO RECORDS FOUND
          *ERROR-NR := 999 /* Internal error
        END-NOREC
      END-FIND
    END-IF
    IF M-LAST-ACTIVE-CK = ' '
      RESET M-LAST-ACTIVE
    END-IF
    IF M-ARCHIVE-TIME-CK = ' '
      RESET M-ARCHIVE-TIME
    END-IF
    #BUNDLE-DEFAULTS := M-BUNDLE-DEFAULTS
    IF B-FLUSH-TIME-A = ' '
      RESET B-FLUSH-TIME
      M-BUNDLE-DEFAULTS := #BUNDLE-DEFAULTS
    END-IF
    CALLNAT 'N-HEAD2' M-LAST-UPDATE-USER M-LAST-UPDATE
      #LAST-MOD G-DATE-FORMAT
*
    G-HOLD-TIME := *TIMX
    IF +NOD-LOCAL-SPOOL-TYPE NE 'UNIX'
      IF MF-TIME-SCHEDULE = 'K'
        #BS2-COPY := 'Y'
        #BS2-RENAME := 'N'
      ELSE
        #BS2-RENAME := MF-TIME-SCHEDULE
        #BS2-COPY := 'N'
      END-IF
      PERFORM #NOMEX007
    END-IF
    DECIDE ON FIRST VALUE OF #FUNC
      VALUE 'M'
        CALLNAT 'NARPSEC' G-USER-PROFILE 'MMO' #ALLOWED
        INCLUDE C-NALLOW
        IF NOT #LOG-FLAG
          LG-USERID := G-USERID
          LG-CODE := 'MO'
          IF G-LANGUAGE = 2
            G-NATRP-ERT := '''Monitor-Standards'''
          ELSE
            G-NATRP-ERT := '''Monitor-Defaults'''
          END-IF
          COMPRESS '1543' G-NATRP-ERT TO LG-MSG
          G-NATRP-ERC := 1543
          CALLNAT 'RLOG' PL-PARMS
          END TRANSACTION
          #LOG-FLAG := TRUE
        END-IF
        PERFORM GET-UPD
      VALUE 'D'
        CALLNAT 'NARPSEC' G-USER-PROFILE 'DMO' #ALLOWED
        INCLUDE C-NALLOW
        CV-MAP := #BS2-RENAME-CV := #BS2-COPY-CV := (AD=IP)
      NONE VALUE IGNORE
    END-DECIDE
*
    SCREEN-LOOP. REPEAT
      IF #LANGUAGE NE *LANGUAGE
        PERFORM INIT-PFKEYS
        #LANGUAGE := *LANGUAGE
      END-IF
      PERFORM SET-PFKEYS
      PERFORM FLIP-DISPLAY
      INCLUDE C-HOLD
      DECIDE FOR EVERY CONDITION
        WHEN NRM-MONITOR.M-WAIT-MINIMUM = 0
          NRM-MONITOR.M-WAIT-MINIMUM := 60
        WHEN NRM-MONITOR.M-WAIT-MAXIMUM = 0
          NRM-MONITOR.M-WAIT-MAXIMUM := 300
        WHEN NRM-MONITOR.M-WAIT-INCREMENT  = 0
          NRM-MONITOR.M-WAIT-INCREMENT := 5
        WHEN NRM-MONITOR.M-BATCH-MODULE = ' ' AND NOT #MF
          NRM-MONITOR.M-BATCH-MODULE := 'UNIX'
        WHEN NRM-MONITOR.M-PRT-TASK-NO = 0
          NRM-MONITOR.M-PRT-TASK-NO := 2
        WHEN MF-CLASSES (1) = ' ' AND NOT #MF
          MF-CLASSES (1) := 'A'
        WHEN MF-TEMP-CLASS = ' ' AND NOT #MF
          MF-TEMP-CLASS := 'T'
        WHEN MF-ERR-CLASS = ' ' AND NOT #MF /*(etc.)
          MF-ERR-CLASS := 'T'
        WHEN MF-PRINT-CLASS = ' ' AND NOT #MF
          MF-PRINT-CLASS := 'P'
        WHEN NONE IGNORE
      END-DECIDE
      EXAMINE MF-BS2-DEST (*) FOR H'FF' DELETE
      CALLNAT 'N-HEADER' L-HEADER G-DATE-FORMAT 'RDEFMOM1'
      DECIDE ON FIRST +NOD-LOCAL-SPOOL-TYPE
        VALUE  'JES3'
          INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
            MARK *G-DIRECT-COMMAND USING MAP 'RDEFMJ3&'
/*SU11  VALUE  'SPOOL'
/*SU11    INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
/*SU11      MARK *G-DIRECT-COMMAND USING MAP 'RDEFMOB&'
        VALUE  'UNIX'
          INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
            MARK *G-DIRECT-COMMAND USING MAP 'RDEFMOX&'
        NONE VALUE /*JES2
          INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
            MARK *G-DIRECT-COMMAND USING MAP 'RDEFMOM&'
      END-DECIDE
/*    MU-field:avoid suppression (see RDEFNO/NODUOP1N/NOSDOP-N):
      EXAMINE FULL MF-BS2-DEST(*) FOR FULL #EMPTY_A8 REPLACE #FF8 /*SU6
      INCLUDE RPFKVA-C
      RESET G-NATRP-ERC G-NATRP-ERT
      INCLUDE C-DIRECT
      INCLUDE RPFKED-C
      IF G-PF-FUNC = 'ARCHIVE'
        PERFORM COMMIT-WORK
        FETCH RETURN 'RDEFAV'
        ESCAPE BOTTOM (FIND-LOOP.)
      END-IF
      IF G-PF-FUNC = ##PFK-TASKS
        PERFORM COMMIT-WORK
        +MONITOR-FUNC := #FUNC
        FETCH RETURN 'RDEFMT'
        ESCAPE BOTTOM (FIND-LOOP.)
      END-IF
      IF G-PF-FUNC = ##PFK-COPY-FILES
        PERFORM VALIDATE-INPUT
        SET CONTROL 'WC20L67B2/5F'
        SET CONTROL 'MB'
        INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT USING MAP 'RDEFCFI&'
        IF CV-MAP MODIFIED OR #BS2-RENAME-CV MODIFIED
        OR #BS2-COPY-CV   MODIFIED OR #MODIFIED-BY-EXIT               /*
          G-COMMIT := TRUE
          PERFORM VALIDATE-COPY-FILES
        END-IF
        IF NOT *PF-KEY = 'PF3'
          REINPUT ' '
        END-IF
        IF #FUNC = 'M' OR = 'A'
          PERFORM #UPD
        END-IF
        SET CONTROL 'WB'
        SET CONTROL 'M21'
      END-IF
      IF G-PF-FUNC = ##PFK-MODIFY AND G-C-FUNC = 'M'
        G-C-FUNC := 'X'
        FETCH RETURN #PROGRAM
        ESCAPE BOTTOM (MAIN-LOOP.)
      END-IF
      IF G-PF-FUNC = ##PFK-EMAIL
        CALLNAT 'XXLONG' '1059' M-EMAIL-RECIPIENTS (1) CV-MAP
/*SU8   PERFORM XXCHKEM-CHECK-EMAIL M-EMAIL-RECIPIENTS (1)
/*SU8     G-NATRP-ERC M-MONITOR-NODE
        IF M-EMAIL-RECIPIENTS (1) NE ' ' AND G-NATRP-ERC=1
          G-NATRP-ERC := 2056
          ESCAPE BOTTOM(FIND-LOOP.)
        END-IF
      END-IF
      IF CV-MAP MODIFIED OR G-MAP-MODIFIED OR #BS2-RENAME-CV MODIFIED
      OR #BS2-COPY-CV   MODIFIED OR #MODIFIED-BY-EXIT                 /*
        G-MAP-MODIFIED := TRUE
        PERFORM VALIDATE-INPUT
        IF #FUNC NE 'D'
          PERFORM #UPD
          G-NATRP-ERC := 0032
          INCLUDE C-COMMIT
          IF G-PF-FUNC = 'DO'
            RESET  G-MAP-MODIFIED
            END TRANSACTION
            RESET  G-COMMIT G-HOLD-TIME
            G-NATRP-ERC := 15
            ESCAPE BOTTOM (FIND-LOOP.)
          END-IF
        END-IF
      END-IF
    END-REPEAT
  END-FIND /*(FIND-LOOP.)
END-REPEAT /*(MAIN-LOOP.)
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-COPY-FILES
************************************************************************
FOR I 1 20
  IF NRM-MONITOR.M-CP-IDENT (I) NE ' '
    DECIDE FOR EVERY CONDITION
      WHEN NOT NRM-MONITOR.M-CP-DBID (I) > 0
        #POS1 := POS(NRM-MONITOR.M-CP-DBID (I))
        REINPUT *635 MARK #POS1
      WHEN NOT NRM-MONITOR.M-CP-FNR (I) > 0
        #POS1 := POS(NRM-MONITOR.M-CP-DBID (I))
        REINPUT *636 MARK #POS1 /* Invalid FNR
      WHEN NONE
        IGNORE
    END-DECIDE
  ELSE
    RESET NRM-MONITOR.M-COPY-FILES-V141 (I)
  END-IF
END-FOR
*
END-SUBROUTINE /* VALIDATE-COPY-FILES
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-INPUT
************************************************************************
G-DATE-FORMAT := NRM-MONITOR.M-DATE-FORMAT
*
DECIDE FOR EVERY CONDITION
/*SU9  WHEN NOT (NRM-MONITOR.M-NTDB-PROCESS = 0 THRU 255)
/*SU9    REINPUT *0642 MARK *NRM-MONITOR.M-MONITOR-NODE ALARM
  WHEN NRM-MONITOR.M-NTDB-PROCESS = 0
    NRM-MONITOR.M-NTDB-PROCESS := 148
  WHEN NRM-MONITOR.M-WAIT-MINIMUM < 1
    REINPUT *632 MARK *NRM-MONITOR.M-WAIT-MINIMUM
  WHEN NRM-MONITOR.M-WAIT-MAXIMUM < NRM-MONITOR.M-WAIT-MINIMUM
    REINPUT *628 MARK *NRM-MONITOR.M-WAIT-MAXIMUM
  WHEN NRM-MONITOR.M-WAIT-MINIMUM + NRM-MONITOR.M-WAIT-INCREMENT
      > NRM-MONITOR.M-WAIT-MAXIMUM
    REINPUT *631 MARK *NRM-MONITOR.M-WAIT-MAXIMUM
  WHEN NRM-MONITOR.M-PRT-TASK-NO > 32
    REINPUT *1524,'<= 32' MARK *NRM-MONITOR.M-PRT-TASK-NO
  WHEN NRM-MONITOR.M-JOBCARD(1:3) = SCAN 'TRACE'
    IF NRM-MONITOR.M-JOBCARD(1:3) = SCAN 'TRACE=ON' OR= SCAN 'TRACE=OFF'
      IGNORE
    ELSE
      CALLNAT 'RMGTRACC' NRM-MONITOR.M-JOBCARD(1:3) #JC-ERR
      IF #JC-ERR
        REINPUT *1547 MARK *NRM-MONITOR.M-JOBCARD(1)
      END-IF
    END-IF
  WHEN NONE
    IGNORE
END-DECIDE
*
DECIDE FOR FIRST CONDITION
/*SU11->  WHEN MF-SYSTEM-TYPE = SCAN 'BS2' OR
/*    +NOD-LOCAL-SPOOL-TYPE = SCAN 'SPOOL'
/*  IF NOT (#BS2-RENAME = 'Y' OR = 'N')
/*    REINPUT *9206 MARK *#BS2-RENAME END-IF
/*  IF NOT (#BS2-COPY   = 'Y' OR = 'N')
/*    REINPUT *9206 MARK *#BS2-COPY END-IF
/*  IF (#BS2-RENAME = 'Y' AND #BS2-COPY = 'Y')
/*  OR (#BS2-RENAME = 'N' AND #BS2-COPY = 'N')                        /*
/*    REINPUT *9211 MARK *#BS2-RENAME END-IF
/*  IF #BS2-COPY = 'Y'
/*  AND (NRM-MONITOR.M-CP-DBID (1)=0 OR NRM-MONITOR.M-CP-FNR (1)=0)   /*
/*    REINPUT *9212 MARK *#BS2-COPY END-IF
/*  MF-TIME-SCHEDULE := #BS2-RENAME
/*SU11<-  IF #BS2-COPY = 'Y' MF-TIME-SCHEDULE := 'K' END-IF
  WHEN +NOD-LOCAL-SPOOL-TYPE = 'JES3'
    DECIDE FOR FIRST CONDITION
/*SU10 -> WHEN NOT (MF-CLASSES(*) NE ' ')
/*    AND NOT (MF-JES3-OUTPUT-CLASSES(*) NE ' ')                      /*
/*SU10 <- REINPUT *0629 MARK *MF-CLASSES(1) ALARM
      WHEN MF-TEMP-CLASS = ' ' AND MF-JES3-OUTPUT-CLASSES (*) NE ' '
        REINPUT *0627 MARK *MF-TEMP-CLASS
      WHEN MF-TEMP-CLASS NE ' ' AND (MF-TEMP-CLASS = MF-PRINT-CLASS
      OR MF-TEMP-CLASS = MF-JES3-OUTPUT-CLASSES (*))                  /*
        REINPUT *0626 MARK *MF-TEMP-CLASS
      WHEN MF-ERR-CLASS NE ' ' AND (MF-ERR-CLASS = MF-PRINT-CLASS
      OR= MF-JES3-OUTPUT-CLASSES (*))                                 /*
        REINPUT *0640 MARK *MF-ERR-CLASS
      WHEN MF-PRINT-CLASS = ' '
        REINPUT *0622 MARK *MF-PRINT-CLASS
      WHEN MF-PRINT-CLASS = MF-JES3-OUTPUT-CLASSES (*)
        REINPUT *0623 MARK *MF-PRINT-CLASS
      WHEN NONE
        IGNORE
    END-DECIDE
  WHEN +NOD-LOCAL-SPOOL-TYPE = 'UNIX' IGNORE /*nothing to be tested
  WHEN NONE /*JES2!POWER
    DECIDE FOR FIRST CONDITION
      WHEN NRM-MONITOR.M-BATCH-MODULE = ' ' AND #MF
        REINPUT *0621 MARK *NRM-MONITOR.M-BATCH-MODULE
/*SU10 WHEN NOT (MF-CLASSES(*) NE ' ')
/*SU10  REINPUT *0629 MARK *MF-CLASSES(1) ALARM
      WHEN MF-TEMP-CLASS = ' '
        REINPUT *0627 MARK *MF-TEMP-CLASS
      WHEN MF-TEMP-CLASS = MF-CLASSES(*)
        REINPUT *0626 MARK *MF-TEMP-CLASS
      WHEN MF-PRINT-CLASS = ' '
        REINPUT *0622 MARK *MF-PRINT-CLASS
      WHEN MF-PRINT-CLASS = MF-CLASSES(*)
      OR MF-PRINT-CLASS = MF-TEMP-CLASS                               /*
        REINPUT *0623 MARK *MF-PRINT-CLASS
      WHEN MF-ERR-CLASS NE ' ' AND (MF-ERR-CLASS = MF-PRINT-CLASS
      OR= MF-CLASSES (*))                                             /*
        REINPUT *0640 MARK *MF-ERR-CLASS
      WHEN NONE
        IGNORE
    END-DECIDE
END-DECIDE
*
IF NOT #MF
  NRM-MONITOR.M-BATCH-MODULE := 'UNIX' /*???? SU
END-IF
*
END-SUBROUTINE /* VALIDATE-INPUT
*
************************************************************************
DEFINE SUBROUTINE #NOMEX007
************************************************************************
IF NOT +G-NOMEXIT-ACTIVE (7) /* now get values from exit
  ESCAPE ROUTINE
END-IF
NOMEX007-FIELD-VALUE := #BS2-RENAME
RESET NOMEX007-FIELD-MODIFIABLE #MODIFIED-BY-EXIT
CALLNAT 'NOMEX007' BS2-FILERENAME NOMEX007-FIELD-MODIFIABLE
  NOMEX007-FIELD-VALUE G-NATRP-ERC G-NATRP-ERT
DECIDE ON EVERY VALUE OF NOMEX007-FIELD-MODIFIABLE
  VALUE 'Y' , 'N'
    #BS2-RENAME := NOMEX007-FIELD-VALUE
    IF #BS2-RENAME NE NOMEX007-FIELD-VALUE
      #MODIFIED-BY-EXIT := TRUE     /* force an update
    END-IF
  VALUE 'N'
    #BS2-RENAME-CV := (AD=IP)
  NONE IGNORE
END-DECIDE
*
NOMEX007-FIELD-VALUE := #BS2-COPY
RESET NOMEX007-FIELD-MODIFIABLE
CALLNAT 'NOMEX007' BS2-FILECOPY NOMEX007-FIELD-MODIFIABLE
  NOMEX007-FIELD-VALUE G-NATRP-ERC G-NATRP-ERT
DECIDE ON EVERY VALUE OF NOMEX007-FIELD-MODIFIABLE
  VALUE 'Y' , 'N'
    #BS2-COPY := NOMEX007-FIELD-VALUE
    IF #BS2-COPY NE NOMEX007-FIELD-VALUE
      #MODIFIED-BY-EXIT := TRUE     /* force an update
    END-IF
  VALUE 'N'
    #BS2-COPY-CV := (AD=IP)
  NONE IGNORE
END-DECIDE
*
END-SUBROUTINE /* #NOMEX007
*
************************************************************************
DEFINE SUBROUTINE GET-UPD
************************************************************************
GETREC. GET NRM-MONITOR *ISN(FIND-LOOP.)
IF +NOD-LOCAL-SPOOL-TYPE NE 'UNIX'
  GETUPD. GET MF-NODE *ISN(LOCALMON.)
END-IF
END-SUBROUTINE /* GET-UPD
*
************************************************************************
DEFINE SUBROUTINE #UPD
************************************************************************
NRM-MONITOR.M-LAST-UPDATE := *TIMX
NRM-MONITOR.M-LAST-UPDATE-USER := G-USERID
UPDATE (GETREC.)
IF +NOD-LOCAL-SPOOL-TYPE NE 'UNIX'
  MF-LAST-UPDATE      := NRM-MONITOR.M-LAST-UPDATE
  MF-LAST-UPDATE-USER := NRM-MONITOR.M-LAST-UPDATE-USER
  UPDATE (GETUPD.)
END-IF
*
END-SUBROUTINE /* #UPD
*
************************************************************************
DEFINE SUBROUTINE INIT-PFKEYS
************************************************************************
INCLUDE RPFSTD-C
INCLUDE RPFCOM-C
INCLUDE RPFARC-C
INCLUDE RPFCOP-C
INCLUDE RPFTSK-C
IF G-C-FUNC = 'M' /* modify allowed in user profile
  G-PF-IDENT (10) := G-PF-IDENT (22) := ##PFN-MODIFY
  G-PF-CODE  (10) := G-PF-CODE  (22) := ##PFK-MODIFY
END-IF
G-PF-IDENT (11) := G-PF-IDENT (23) := ##PFN-EMAIL
G-PF-CODE  (11) := G-PF-CODE  (23) := ##PFK-EMAIL
CALLNAT 'RPFINI-N' G-PF G-PFB
*
END-SUBROUTINE /* INIT-PFKEYS
*
INCLUDE RPFSET-C /*set-pfkeys
*
END
