* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RLISBU - LIST BUNDLES DEFINED FOR A USER OR GRANTED TO A USER
*
* Maintenance
*              F(190)    two times reading for building first screen
*              F(191)    NO 'ending at' WE READ ALWAYS UNTIL END OF DATA
*              F(015)    refresh list after renaming entity
* gw  98-03-13 s(278970) save search values in independent variables
* wcd 00-04-01 CE 7267   New PFkey for additional printers in RPFK---L
*                        & VMBUND-L
* xsisgg 00-08-09 CE7461 Extend Report and Bundle names
* xsetoba 2002-04-04 (CE5903) BOT doesn't work
* xsetggr 2003-08-11 p(240465) msg 0020 when not allowed modify bundle
* xsetggr 2004-05-31 (CE5903)
* uksju   2004-08-23 p(256132) Ada calls exceeded - restow for new C-BRW
* xsetggr 2005-10-26 p(270950) ISN fields must be P10, not P8
* xsetggr 2007-08-30 NOM3201   Support P11 run numbers
* xsetggr 2010-01-07 P300184   use G-LANGUAGE for checking
* splildav 2010-01-14 N3246    Support bundle status
* fhi     2010-03-05 P307403  Don't use text and binary reports mixed
* xsetggr 2010-03-16 P307403  Restow - RPFKEX-C is changed back
* xsetggr 2010-04-12 N3246    no selection by type for general user
* fhi     2010-09-03 NOMALL-97 Extend message line
* xsetggr 2012-09-19 NOMALL-89 implement line commands validation check
* xsetggr 2013-06-19 NOMALL-1198 restow due corrections in C-CHKLC
* SU1     2013-07-17 remove empty copy code CSTARTLS
* SU2     2016-08-01 NOMALL-1518 NOM3.5 deactivate opt.Compiler
* BLI     2017-07-17 NOMALL-1984 differ MODIFY/DISPLAY (C-CHKLC)
* ----------------------------------------------------------------------
DEFINE DATA
GLOBAL USING  NRM-GL
INDEPENDENT
1 +G-RLISBU-SEL-REPORT        (A25)
1 +G-RLISBU-SEL-BUNDLE        (A25)
1 +G-RLISBU-SEL-AUTHORIZATION (A8)
1 +G-RLISBU-SEL-STATUS        (A1)
* *****
LOCAL USING  RLC----L
LOCAL USING  RPFK---L
LOCAL USING  ROT----L
LOCAL USING  VMBUND-L
LOCAL USING  VGRANT-L
LOCAL
1 LIST  VIEW  OF  NRM-DISTRIBUTION-LIST
1 BUNDLE-REPORT  VIEW  OF  NRM-BUNDLE-REPORT
*
1 #FATHER-PROG                     (A8) INIT <'RMENU'>
1 REPORT-IN-BUNDLE                 (L)
1 #NOFLINES                        (P2) INIT <15>
1 #NOFPAGES                        (P3) INIT <80>
1 #END-OF-DATA                     (L)
***
1 #CP                              (P3)
1 #MAXP                            (P3)
1 #MAXAP                           (P3)
1 #BROWSE-FLAGS
  2 #NEWVAL                        (L)
  2 #BACKWARD                      (L)
  2 #FORWARD                       (L)
  2 #TOP                           (L)
  2 #BOT                           (L)
  2 #SCROLL-AMOUNT                 (N3)
1 DISPLAY-IT                       (L)
1 GET-SCREEN                       (L)
1 #START-KEY                       (A25)
1 #RSTART                          (A25)
1 #LAST-KEY                        (A25)
1 #TOPKEY                          (A25)
1 #PAGES                           (A34/80)
1 REDEFINE  #PAGES
  2 #FROM-KEYS                     (80)
    3 #F-TYPE                      (A1)
    3 #F-USERID                    (A8)
    3 #F-OBJECT-NAME               (A25)
*
1 #T-KEY                           (A34)
1 REDEFINE  #T-KEY
  2 #T-TYPE                        (A1)
  2 #T-USERID                      (A8)
  2 #T-OBJECT-NAME                 (A25)
1 #ISN                             (P10)
*
1 L-HEADER                         (A78)
1 #S-REPORT                        (A25)
1 #S-AUTHORIZATION                 (A8)
1 #S-STATUS                        (A1)
1 #S-MASTER                        (A25)
1 #S-BUNDLE                        (A25)
1 #M-REPORT                        (A25)
1 REDEFINE #M-REPORT
  2 #M-REPORT-17                   (A17)
  2 #M-REPORT-R                    (A8)
1 #M-MASTER                        (A25)
1 REDEFINE #M-MASTER
  2 #M-MASTER-17                   (A17)
  2 #M-MASTER-R                    (A8)
1 #M-BUNDLE                        (A25)
1 REDEFINE #M-BUNDLE
  2 #M-BUNDLE-8                    (A8)
  2 #M-BUNDLE-R                    (A17)
1 #S-REPORT-F                      (A25)
1 #S-MASTER-F                      (A25)
1 #S-BUNDLE-F                      (A25)
1 #S-REPORT-T                      (A25)
1 #S-MASTER-T                      (A25)
1 #S-BUNDLE-T                      (A25)
1 #S-COORD                         (A8)
1 CV-SELECTION                     (C/7)
1 REDEFINE  CV-SELECTION
  2 CV-SREP                        (C)
  2 CV-SMAST                       (C)
  2 CV-SBUN                        (C)
  2 CV-SSTA                        (C)
  2 CV-SCOORD                      (C)
  2 CV-SAUTH                       (C)
  2 CV-SSTAT                       (C)
*
1 L-SCREEN                         (15)
  2 L-IDENT                        (I2)
  2 L-NAME                         (A25)
  2 L-BUNDRNB                      (P11)
  2 L-DESC                         (A50)
  2 L-NUMREP                       (P10)
  2 L-STATUS                       (A10)
  2 L-ISN                          (N10)
  2 L-OPTION                       (A1/6)
  2 L-AUTHORIZATION                (A8)
  2 L-MARK                         (A2)
  2 CV-MARK                        (C)
  2 CVU                            (C)
*
1 I                                (N5)
1 #ALLOWED                         (L)
1 #UPDATE                          (L)
1 #DELETE                          (L)
1 #FLUSH                           (L)
1 GRANTED                          (L)
1 #LEN                             (N3)
1 CV-LINES                         (C)
1 #ADD-PROGRAM                     (A8) INIT <'RDEFBU'>
1 #ACT-MAST                        (A8) INIT <'RLISAB'>
1 F                                (P2)
1 #LANGUAGE                        (I1)
1 #I                               (N2)
1 #HP                              (N3)
1 #ARCHIVE                         (L)
1 #REVIVE                          (L)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
/*SU2 OPTIONS MCG=OFF
*
INCLUDE CVIDEO
*
RESET G-COMMIT
CALLNAT 'NARPSEC' G-USER-PROFILE 'DBU' #ALLOWED
INCLUDE C-NALLOW
*
CALLNAT 'NARPSEC' G-USER-PROFILE 'MBU' #UPDATE
CALLNAT 'NARPSEC' G-USER-PROFILE 'PBU' #DELETE
CALLNAT 'NARPSEC' G-USER-PROFILE 'FBU' #FLUSH
*
G-C-OBJTYPE := 'BUNDLE'
#NEWVAL := TRUE
IF *DATA > 0
  INPUT #S-BUNDLE
END-IF
IF #S-REPORT = ' ' AND #S-BUNDLE = ' ' AND #S-AUTHORIZATION = ' '
    AND #S-STATUS = ' '
  #S-STATUS        := +G-RLISBU-SEL-STATUS
  #S-REPORT        := +G-RLISBU-SEL-REPORT
  #S-BUNDLE        := +G-RLISBU-SEL-BUNDLE
  #S-AUTHORIZATION := +G-RLISBU-SEL-AUTHORIZATION
ELSE
  +G-RLISBU-SEL-REPORT          := #S-REPORT
  +G-RLISBU-SEL-BUNDLE          := #S-BUNDLE
  +G-RLISBU-SEL-AUTHORIZATION := #S-AUTHORIZATION
  +G-RLISBU-SEL-STATUS  := #S-STATUS
END-IF
IF G-USER-TYPE = 'G' AND #S-BUNDLE = ' '
  #S-AUTHORIZATION := G-USERID
END-IF
MAIN-LOOP. REPEAT
*
  PERFORM GET-SCREEN
  RESET GET-SCREEN
*
  INCLUDE C-TOPBOT
*
  CALLNAT 'N-HEADER' L-HEADER G-DATE-FORMAT 'RLISBUM&'
*
  IF #LANGUAGE NE *LANGUAGE
    MOVE G-LANGUAGE TO #LANGUAGE *LANGUAGE
    CALLNAT 'ROTINI-N' ##EQO-BUNDLE G-OBJ-TYPE G-OTB
    PERFORM INIT-PFKEYS
    PERFORM INIT-LINECOM
  END-IF
  CALLNAT 'RFLIPG-N' G-LC G-LINECOM (*)
  PERFORM SET-PFKEYS
  INCLUDE RMVHLP-C
*
  PERFORM FLIP-DISPLAY
  SET CONTROL 'WB'
  SET CONTROL 'M21'
  PERFORM PREPARE-QUERY-TEXT
  IF G-DISPLAY-LONG-NAMES
    INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT MARK *G-DIRECT-COMMAND
      USING MAP 'RLISBU1&'
  ELSE
    INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT MARK *G-DIRECT-COMMAND
      USING MAP 'RLISBUM&'
  END-IF
  INCLUDE RPFKVA-C
  RESET G-NATRP-ERC G-NATRP-ERT
  RESET #BROWSE-FLAGS
  INCLUDE C-DIRECT
  INCLUDE C-LOCCMD
  INCLUDE RPFKEX-C
  IF G-PF-FUNC = 'EXT'
    DECIDE FOR FIRST CONDITION
      WHEN G-SUPPORT-LONG-NAMES AND NOT G-DISPLAY-LONG-NAMES
        G-DISPLAY-LONG-NAMES := TRUE
      WHEN G-SUPPORT-LONG-NAMES AND G-DISPLAY-LONG-NAMES
        RESET G-DISPLAY-LONG-NAMES
      WHEN NONE IGNORE
    END-DECIDE
  END-IF
  INCLUDE REXQRY-C
  PERFORM LINE-COMMANDS
*
  IF CV-SELECTION(*) MODIFIED
    #NEWVAL := TRUE
    +G-RLISBU-SEL-REPORT          := #S-REPORT
    +G-RLISBU-SEL-BUNDLE          := #S-BUNDLE
    +G-RLISBU-SEL-AUTHORIZATION := #S-AUTHORIZATION
    +G-RLISBU-SEL-STATUS  := #S-STATUS
  END-IF
END-REPEAT
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE GET-SCREEN
************************************************************************
IF G-DIRECT-COMMAND = 'TOP'
  #TOP := TRUE
END-IF
RESET L-MARK(*) L-IDENT (*)
INCLUDE C-BRW
*
RESET I L-SCREEN(*) #END-OF-DATA
CV-MARK(*) := (AD=P)
IF #S-AUTHORIZATION = ' ' OR = '*' OR = 'ADMIN'
  PERFORM READ-ALL-BUNDLES
ELSE
  PERFORM READ-GRANTED-BUNDLES
END-IF
*
END-SUBROUTINE /* GET-SCREEN
*
************************************************************************
DEFINE SUBROUTINE READ-ALL-BUNDLES
************************************************************************
READ-LOOP. READ BUNDLES BY B-BUNDLE = #RSTART THRU #S-BUNDLE-T
*
  AT START OF DATA
    #PAGES(#CP) := #TOPKEY := B-BUNDLE
  END-START
*
  DISPLAY-IT := TRUE
  REPORT-IN-BUNDLE := FALSE
  IF BUNDLES.B-BUNDLE-STATUS NE 'S'
    BUNDLES.B-BUNDLE-STATUS := 'M'
  END-IF
*
  PERFORM SELECT-RECORD
  REJECT IF NOT DISPLAY-IT OR NOT REPORT-IN-BUNDLE
*
  IF G-USER-TYPE = 'A'
    GRANTED := TRUE
    GRANTS.GR-OPTION(*) := 'Y'
    GRANTS.GR-USERID    := 'ADMIN'
  ELSE
    GRANTS.GR-USERID      := G-USERID
    GRANTS.GR-OBJECT-NAME := B-BUNDLE
    CALLNAT 'RGRANT-N' GRANTS.GR-USERID 'B' GRANTS.GR-OBJECT-NAME
      GRANTED GRANTS.GR-OPTION(*)
  END-IF
*
  REJECT IF NOT GRANTED
*
  ADD 1 TO I
  IF I > #NOFLINES
    #LAST-KEY := B-BUNDLE
    ESCAPE ROUTINE
  END-IF
  IF I = 1
    #PAGES(#CP) := B-BUNDLE
  END-IF
  PERFORM DATA-TO-SCREEN
*
END-READ
#END-OF-DATA := TRUE
#MAXP := #CP
*
END-SUBROUTINE /* READ-ALL-BUNDLES
*
************************************************************************
DEFINE SUBROUTINE READ-GRANTED-BUNDLES
************************************************************************
DECIDE FOR EVERY  CONDITION
  WHEN #NEWVAL OR #TOP
    RESET #PAGES(*) #MAXP #MAXAP
    PERFORM INIT-SELECTION-KEYS
    #CP := 1
    #MAXAP := 1
  WHEN #BOT
    #HP := #NOFPAGES / 2
    #I := 0
    READ GRANTS BY GR-SUPER STARTING FROM #PAGES (1)
      #I := #I +1
      IF #I = 16
        IF #CP = #NOFPAGES
          #PAGES(#HP - 1 : #NOFPAGES - 1) := #PAGES(#HP : #NOFPAGES)
          RESET #PAGES(#CP)
          #CP := #CP - 1
        END-IF
        #CP := #CP + 1
        #F-OBJECT-NAME (#CP) := BUNDLES.B-BUNDLE
        #I := 1
      END-IF
    END-READ
    #MAXAP := #CP
    #CP:=1
    #CP := #MAXAP
  WHEN #FORWARD
    IF #END-OF-DATA
      ESCAPE ROUTINE
    END-IF
    IF #CP = #NOFPAGES
      #PAGES(1 : #NOFPAGES - 1) := #PAGES(2 : #NOFPAGES)
      RESET #PAGES(#CP)
      #F-TYPE (#CP) := 'B'
      #F-USERID (#CP) := #S-AUTHORIZATION
      #F-OBJECT-NAME (#CP) := #LAST-KEY
    ELSE
      IF #SCROLL-AMOUNT < 1
        #SCROLL-AMOUNT := 1
      END-IF
      IF #CP + #SCROLL-AMOUNT <= #MAXAP
        #CP := #CP + #SCROLL-AMOUNT
      ELSE
        ADD 1 TO #CP
      END-IF
      IF #CP > #MAXAP
        #F-TYPE (#CP) := 'B'
        #F-USERID (#CP) := #S-AUTHORIZATION
        #F-OBJECT-NAME (#CP) := #LAST-KEY
      END-IF
    END-IF
  WHEN #BACKWARD
    IF #CP GE 2
      IF #SCROLL-AMOUNT < 1
        #SCROLL-AMOUNT := 1
      END-IF
      SUBTRACT #SCROLL-AMOUNT FROM #CP
      IF #CP < 1
        #CP := 1
      END-IF
    END-IF
  WHEN GET-SCREEN IGNORE
  WHEN NONE ESCAPE ROUTINE
END-DECIDE
*
IF #CP >= #MAXAP
  #MAXAP := #CP
END-IF
RESET I L-SCREEN(*) #END-OF-DATA
CV-MARK(*) := (AD=P)
READ-LOOP-GRANT. READ GRANTS BY GR-SUPER = #PAGES (#CP)
  IF GR-OBJECT-TYPE NE #T-TYPE OR GR-USERID NE #T-USERID    OR
      GR-OBJECT-NAME > #T-OBJECT-NAME
    ESCAPE BOTTOM (READ-LOOP-GRANT.)
  END-IF
  FIND-LOOP. FIND BUNDLES WITH B-BUNDLE = GR-OBJECT-NAME
    DISPLAY-IT := TRUE
    REPORT-IN-BUNDLE := FALSE
    IF BUNDLES.B-BUNDLE-STATUS NE 'S'
      BUNDLES.B-BUNDLE-STATUS := 'M'
    END-IF
*
    PERFORM SELECT-RECORD
*
    REJECT IF NOT DISPLAY-IT OR NOT REPORT-IN-BUNDLE
*
    IF G-USER-TYPE = 'A'
      GRANTS.GR-OPTION(*) := 'Y'
    END-IF
    GRANTED := TRUE
    ADD 1 TO I
    IF I > #NOFLINES
      #LAST-KEY := BUNDLES.B-BUNDLE
      ESCAPE ROUTINE
    END-IF
    IF I = 1
      #F-OBJECT-NAME (#CP) := BUNDLES.B-BUNDLE
    END-IF
    #ISN := *ISN (FIND-LOOP.)
    PERFORM DATA-TO-SCREEN
  END-FIND
END-READ
#END-OF-DATA := TRUE
#MAXP := #CP
*
END-SUBROUTINE /* READ-GRANTED-BUNDLES
*
************************************************************************
DEFINE SUBROUTINE SELECT-RECORD
************************************************************************
DECIDE FOR EVERY CONDITION
  WHEN #S-REPORT = ' ' OR = '*'
    REPORT-IN-BUNDLE := TRUE
  WHEN NOT(#S-REPORT = ' ' OR = '*')
    FNDNUM.
    FIND NUMBER BUNDLE-REPORT WITH BR-BUNDLE = BUNDLES.B-BUNDLE AND
      BR-REPNAME = #S-REPORT-F THRU #S-REPORT-T
    IF *NUMBER(FNDNUM.) > 0
      REPORT-IN-BUNDLE := TRUE
    ELSE
      REPORT-IN-BUNDLE := FALSE
    END-IF
  WHEN NOT(BUNDLES.B-MASTER-REPNAME = #S-MASTER-F THRU #S-MASTER-T)
    DISPLAY-IT := FALSE
  WHEN NOT(#S-COORD = ' ')
    IF BUNDLES.B-COORDINATOR-ID NE #S-COORD
      DISPLAY-IT := FALSE
    END-IF
  WHEN NOT (#S-STATUS = ' ' OR = '*') AND
      BUNDLES.B-BUNDLE-STATUS NE #S-STATUS
    DISPLAY-IT := FALSE
  WHEN NONE IGNORE
END-DECIDE
*
END-SUBROUTINE /* SELECT-RECORD
*
************************************************************************
DEFINE SUBROUTINE DATA-TO-SCREEN
************************************************************************
RESET CV-MARK(I)
#LAST-KEY := L-NAME(I) := BUNDLES.B-BUNDLE
L-ISN(I) := #ISN
L-NAME(I) := BUNDLES.B-BUNDLE
L-DESC(I) := BUNDLES.B-DESC
L-STATUS(I) := BUNDLES.B-BUNDLE-STATUS
L-BUNDRNB(I) := BUNDLES.B-BUNDRNB
*
FNDBR. FIND NUMBER BUNDLE-REPORT WITH BR-BUNDLE = BUNDLES.B-BUNDLE
L-NUMREP(I) := *NUMBER(FNDBR.)
*
L-OPTION(I,1:6) := GRANTS.GR-OPTION(1:6)
L-AUTHORIZATION (I) := GRANTS.GR-USERID
RESET CV-MARK(I)
*
END-SUBROUTINE /* DATA-TO-SCREEN
*
************************************************************************
DEFINE SUBROUTINE LINE-COMMANDS
************************************************************************
IF L-SCREEN.L-MARK(*) = '.'
  INCLUDE C-ESCAPE
END-IF
INCLUDE RLCMTI-C /* VALIDATE LINE COMMANDS
INCLUDE C-CHKLC
* --- DELETE LINE COMMANDS
FOR I 1 TO #NOFLINES
  IF L-IDENT (I) = ##EQU-DELETE
    G-C-BUNDLE := L-NAME(I)
    CALLNAT 'RDELBU' G-C-BUNDLE G-USERID G-DISPLAY-LONG-NAMES
      G-CONFIRM G-NATRP-ERC
    GET-SCREEN := TRUE
  END-IF          /* (6180)
END-FOR
* --- OTHER LINE COMMANDS
FOR I 1 TO #NOFLINES
  DECIDE ON FIRST VALUE OF L-IDENT (I)
    VALUE ##EQU-COPY             /* COPY
      PERFORM COMMIT-WORK
      G-C-BUNDLE :=        L-NAME(I)
      FETCH RETURN 'RCOPBU'
      GET-SCREEN := TRUE
    VALUE ##EQU-MODIFY
      G-C-BUNDLE :=        L-NAME(I)
      G-C-FUNC := 'M'
      PERFORM COMMIT-WORK
      FETCH RETURN 'RDEFBU'
      GET-SCREEN := TRUE
    VALUE ##EQU-ADD-REPORT
      G-C-FUNC := 'A'
      PERFORM COMMIT-WORK
      G-C-BUNDLE :=        L-NAME(I)
      FETCH RETURN 'RDEFBR'
      GET-SCREEN := TRUE
    VALUE ##EQU-LOG
      FETCH RETURN 'RLISLG' 'BM' L-NAME(I)
    VALUE ##EQU-DISPLAY         /* DISPLAY
      G-C-BUNDLE :=        L-NAME(I)
      G-C-FUNC := 'D'
      PERFORM COMMIT-WORK
      FETCH RETURN 'RDEFBU'
    VALUE ##EQU-LIST-REPORTS
      G-C-BUNDLE :=        L-NAME(I)
      PERFORM COMMIT-WORK
      FETCH RETURN 'RLISBR'
      FNDN. FIND NUMBER BUNDLE-REPORT WITH BR-BUNDLE = L-NAME (I)
      L-NUMREP (I) := *NUMBER (FNDN.)
    VALUE ##EQU-AUTHORIZE
      G-C-OBJNAME := L-NAME(I)
      G-FATHER-PROG := *PROGRAM
      G-C-OBJTYPE := 'B'
      G-C-GRANTS(1:6) := L-OPTION(I,1:6)
      PERFORM COMMIT-WORK
      FETCH RETURN 'RLISGR'
    VALUE ##EQU-RENAME
      G-C-BUNDLE :=        L-NAME(I)
      PERFORM COMMIT-WORK
      FETCH RETURN 'RRENBU'
      GET-SCREEN := TRUE                            /* f(015)
    NONE VALUE IGNORE
  END-DECIDE        /* (0483)
END-FOR           /* (0540)
*
END-SUBROUTINE /* LINE-COMMANDS
*
************************************************************************
DEFINE SUBROUTINE INIT-SELECTION-KEYS
************************************************************************
PERFORM VALIDATE-SELECTION-KEYS
#LEN := 25
CALLNAT 'SELALPHA'  #S-BUNDLE #S-BUNDLE-F #S-BUNDLE-T #LEN
*
CALLNAT 'SELALPHA'  #S-REPORT #S-REPORT-F #S-REPORT-T #LEN
*
CALLNAT 'SELALPHA'  #S-MASTER #S-MASTER-F #S-MASTER-T #LEN
#START-KEY := #S-BUNDLE-F
IF #S-AUTHORIZATION NE ' '
  #F-USERID (1)             := #S-AUTHORIZATION
  #T-USERID                 := #S-AUTHORIZATION
  #F-USERID (1)             := #S-AUTHORIZATION
  #T-USERID                 := #S-AUTHORIZATION
  #F-TYPE               (1) := 'B'
  #F-OBJECT-NAME (1) := #S-BUNDLE-F
  #T-TYPE                   := 'B'
  #T-OBJECT-NAME            := #S-BUNDLE-T
END-IF
*
END-SUBROUTINE /* INIT-SELECTION-KEYS
*
************************************************************************
DEFINE SUBROUTINE PREPARE-QUERY-TEXT
************************************************************************
IF #S-REPORT NE ' '
  COMPRESS 'REPORT=' #S-REPORT INTO G-NATRP-ERT
END-IF
IF #S-MASTER NE ' '
  COMPRESS G-NATRP-ERT 'MASTER=' #S-MASTER INTO G-NATRP-ERT
END-IF
*
END-SUBROUTINE /* PREPARE-QUERY-TEXT
*
************************************************************************
DEFINE SUBROUTINE DEFINE-QUERY
************************************************************************
SET CONTROL 'WC9L55B10/15F'
#M-BUNDLE := #S-BUNDLE
#M-REPORT := #S-REPORT
#M-MASTER := #S-MASTER
IF NOT G-DISPLAY-LONG-NAMES
  #M-BUNDLE-R := H'FA'
  #M-REPORT-R := H'FA'
  #M-MASTER-R := H'FA'
END-IF
INPUT USING MAP 'RQRYBUM&'
SET CONTROL 'WB'
IF G-DISPLAY-LONG-NAMES
  #S-BUNDLE := #M-BUNDLE
  #S-REPORT := #M-REPORT
  #S-MASTER := #M-MASTER
ELSE
  #S-BUNDLE := #M-BUNDLE-8
  #S-REPORT := #M-REPORT-17
  #S-MASTER := #M-MASTER-17
END-IF
*
END-SUBROUTINE /* DEFINE-QUERY
*
************************************************************************
DEFINE SUBROUTINE INIT-LINECOM
************************************************************************
G-LC-IDENT (01) := ##EQU-DISPLAY
G-LC-IDENT (02) := ##EQU-MODIFY
G-LC-IDENT (03) := ##EQU-DELETE
G-LC-IDENT (04) := ##EQU-COPY
G-LC-IDENT (05) := ##EQU-RENAME
G-LC-IDENT (06) := ##EQU-AUTHORIZE
G-LC-IDENT (07) := ##EQU-LOG
G-LC-IDENT (08) := ##EQU-LIST-REPORTS
G-LC-IDENT (09) := ##EQU-ADD-REPORT
G-LC-NUM               := 9
CALLNAT 'RLCINI-N' G-OBJ-TYPE G-LC G-LCB
*
END-SUBROUTINE /* INIT-LINECOM
*
************************************************************************
DEFINE SUBROUTINE INIT-PFKEYS
************************************************************************
INCLUDE RPFSTD-C
INCLUDE RPFADD-C
INCLUDE RPFBRW-C
INCLUDE RPFACT-C
INCLUDE RPFQRY-C
CALLNAT 'RPFINI-N' G-PF G-PFB
*
END-SUBROUTINE /* INIT-PFKEYS
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-SELECTION-KEYS
************************************************************************
DECIDE FOR FIRST CONDITION
  WHEN (G-USER-TYPE = 'A' AND #S-AUTHORIZATION = 'ADMIN')
      OR #S-AUTHORIZATION = '*' OR = ' '
    RESET #S-AUTHORIZATION
  WHEN #S-AUTHORIZATION = G-USERID OR #S-AUTHORIZATION = 'PUBLIC'
    IGNORE
  WHEN NONE
    IF G-USER-TYPE NE 'A'
      FNDL. FIND NUMBER LIST WITH D-LIST-NAME = #S-AUTHORIZATION
        AND D-USER-LIST = G-USERID
      IF *NUMBER (FNDL.) = 0
        REINPUT *0911 MARK *#S-AUTHORIZATION ALARM
      END-IF
    END-IF
END-DECIDE
*
END-SUBROUTINE /* VALIDATE-SELECTION-KEYS
*
INCLUDE RPFSET-C
*
END
