INPUT          (     IP=OFF                                           /*
                                                                       )
 014T '- Standard Separation 2 Search String -'(YEI)
/
/
 001T 'Enter the string to be searched for. If this string appears on a'(TU)
/
 001T 'page, the suffix is evaluated (at break of the suffix value, a'(TU)
/
 001T 'new Report is opened). Otherwise the page is added to the'(TU)
/
 001T 'currently opened Report, or is rejected if no Report is opened.'(TU)
/
/
 001T 'If you do not specify'(TU)
 023T 'Search Line,'(YEI)
 036T 'the string can'(TU)
/
 001T 'appear anywhere on the page.'(TU)
/
/
 001T 'You can specify a search pattern containing'(TU)
 045T '*'(YEI)
 047T 'and/or'(TU)
 054T '%,'(YEI)
 057T 'where'(TU)
 063T '*'(YEI)
/
 001T 'stands for any string and'(TU)
 027T '%'(YEI)
 029T 'stands for any character.'(TU)
/
/
 001T 'example:'(TU)
 015T '*String%String*'(YEI)
/
/
 001T 'Note: NOM now also provides full support of NATURAL masks, so'(TU)
/
 007T '*'(YEI)
 009T 'may not only be used as wildcard but also as string.'(TU)
/
 001T 'example:'(TU)
 014T 'MASK(*''String''*''*** ''NNN'' ***''*''String''*)'(YEI)
* MAP2: VALIDATION *****************************************************
* MAP2: END OF MAP *****************************************************
END
