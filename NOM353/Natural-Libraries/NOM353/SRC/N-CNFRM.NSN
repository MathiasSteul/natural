* SU3     2022-03-03 NOMALL-2536 recat: N-CNFRM1/2 changed + ignore len.
* ----------------------------------------------------------------------
*
DEFINE DATA
PARAMETER
1 #OBJECT-NAME                 (A32)
1 #OBJECT-TYPE                 (A1)
1 #DISPLAY-LONG-NAMES          (L)
1 #CONFIRMED                   (L)
1 #MSG                         (A250)
1 #LOWER-CASE                  (L)
************************************************************************
LOCAL
1 #USER-TYPE-IN                (A32)
/*SU3 1 #LENGTH                      (P3)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
SET KEY PF3
*
RESET #CONFIRMED
/*SU3 -> DECIDE ON FIRST VALUE OF #OBJECT-TYPE
/*VALUE 'R'
/*  IF #DISPLAY-LONG-NAMES
/*    #LENGTH := 25
/*  ELSE
/*    #LENGTH := 17
/*  END-IF
/*VALUE 'B'
/*  IF #DISPLAY-LONG-NAMES
/*    #LENGTH := 25
/*  ELSE
/*    #LENGTH := 8
/*  END-IF
/*VALUE 'F'
/*  #LENGTH := 16
/*VALUE 'M'
/*  #LENGTH := 10
/*NONE VALUE
/*  #LENGTH := 8
/*SU3 <- END-DECIDE
*
DEFINE WINDOW CONFIRM SIZE 8*73 BASE 10/4 FRAMED
SET CONTROL 'MB' /*show msg-line in window SU2
INPUT WINDOW='CONFIRM' WITH TEXT #MSG USING MAP 'N-CNFRM&'
*
IF *PF-KEY = 'PF3'
  ESCAPE ROUTINE
END-IF
*
IF NOT #LOWER-CASE
  EXAMINE #USER-TYPE-IN TRANSLATE INTO UPPER CASE
END-IF
/*SU3 IF #USER-TYPE-IN = SUBSTR(#OBJECT-NAME,1,#LENGTH)
IF #USER-TYPE-IN = #OBJECT-NAME /*SU3
  #CONFIRMED := TRUE
ELSE
  REINPUT *4 ALARM
END-IF
*
SET CONTROL 'WB'
*
END
