* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* XSETGGR 2001-03-21 P(105864) CALENDAR HANDLING           S
* SU1     2013-01-31 unused      Deactivate unused data areas
DEFINE DATA PARAMETER
1 #CALENDAR-NAME (A8)
1 #EXIST(L)
**LOCAL USING VCALEN-L /*SU1 out
LOCAL
1 CALENDARS VIEW OF NRM-CALENDARS /*SU1 in
1 #DATEN8         (N8)
1 REDEFINE #DATEN8
  2 #YEAR         (N4)
1 #CALENDAR-ID    (A12)
1 REDEFINE #CALENDAR-ID
  2 #C-CALENDAR   (A8)
  2 #C-YEAR       (N4)
END-DEFINE
*
MOVE *DATN TO #DATEN8
MOVE #YEAR TO #C-YEAR
MOVE #CALENDAR-NAME TO #C-CALENDAR
FIND-CAL. FIND NUMBER CALENDARS WITH CA-CALENDAR-ID = #CALENDAR-ID
IF *NUMBER(FIND-CAL.) > 0
   MOVE TRUE TO #EXIST
ELSE
  MOVE FALSE TO #EXIST
END-IF
END
