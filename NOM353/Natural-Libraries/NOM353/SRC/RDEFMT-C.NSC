IF M-TASK-NUMBER (&1&) EQ 1 THRU #MAX-TASKS
  #MAP-IX := (M-TASK-NUMBER(&1&) - 1) / 10
  IF #MAP-IX = 0
    #MAP-IX := 1
  END-IF
  &2&(#MAP-IX)           := 'X'
  #TASK-NUMBERS(#MAP-IX) := M-TASK-NUMBER(&1&)
END-IF
