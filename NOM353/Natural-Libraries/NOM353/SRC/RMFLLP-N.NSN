* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RMFLLP-N - GET ATTRIBUTES FOR FLUSH VIA UNIXLP
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* gw  94-03-22 s(999999) created
* xsiszha 2000-08-01 (CE7461) Extend Report and Bundle Names
* fhi     2003-02-06 p(225241) module no more used, stays in library.
* xsetggr 04-11-23 p(258871) recat due to changes in rmfl---p
* fhi     2004-12-10 NOM3104   Backout p(225241)
* fhi     2005-04-07 NOM31     Extend interface for UNIXLP (without comments)
* fhi     2005-08-10 S(268281) Formfeed suppression as parameter
* fhi     2005-08-10 S(267180) SPOOLFILE name not RFC1179 compliant
* fhi     2005-08-10 S(272458) Use new Interface of ESMLPR (Version 2)
* xsetggr 2007-05-02 NOM3201   Support 5 byte node numbers
* fhi     2010-09-03 NOMALL-97 Extend message line
* xsetggr 2010-12-21 NOMALL-865 restow due to changes in RMFL---P
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER USING RMFL---P
PARAMETER
1 P-ERROR-CODE                 (N4)
1 P-ERROR-TEXT                 (A250)
************************************************************************
LOCAL USING EOMPHTYE
LOCAL USING RMFLLP-P
LOCAL
1 PRINTOUT    VIEW  OF  NRM-PRINTOUTS
  2 PO-ATTRIBUTES              (1:25)
  2 REDEFINE PO-ATTRIBUTES
    3 PO-ATTRIB                (1:25)
      4 PO-IDENT               (I1)
      4 PO-LENGTH              (N2)
      4 PO-PROMPT              (N4)
      4 PO-VAR                 (A16)
      4 PO-VALUE               (A72)
  2 C*PO-ATTRIBUTES
* variables for hex conversion
1 #PO-STRING                   (A251)
1 #PO-CHAR                     (B1)
1 #PO-CHAR-P                   (P3)
1 #PO-VAL                      (P5)
1 #PO-LEN                      (P3)
1 #PO-FLAG                     (L)
*
1 F                            (I2)
1 NOE                          (I2)
1 I                            (I2)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET P-ERROR-CODE P-ERROR-TEXT
*
PERFORM READ-PRINTOUT-RECORD
IF P-ERROR-CODE = 0
  PERFORM UNIXLP-INTERFACE
END-IF
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE READ-PRINTOUT-RECORD
************************************************************************
FNDPR. FIND PRINTOUT WITH PO-ID = FLUSH-POID
  IF NO RECORDS FOUND
    P-ERROR-CODE := 0005
    P-ERROR-TEXT := 'Printout Record not found'
    ESCAPE BOTTOM (FNDPR.)
  END-NOREC
END-FIND
*
END-SUBROUTINE /* READ-PRINTOUT-RECORD
*
************************************************************************
DEFINE SUBROUTINE UNIXLP-INTERFACE
************************************************************************
RESET UNIXLP-ATTRIBUTES
IF PRINTOUT.C*PO-ATTRIBUTES > 25
  NOE := 25
ELSE
  NOE := PRINTOUT.C*PO-ATTRIBUTES
END-IF
FOR F = 1 TO NOE
  DECIDE ON FIRST PO-VAR (F)
    VALUE 'SERVER'      UNIXLP-SERVER      := PO-VALUE (F)
    VALUE 'DEST'        UNIXLP-DEST        := PO-VALUE (F)
    VALUE 'PORT'        UNIXLP-PORT        := PO-VALUE (F)
    VALUE 'FORMFEED'    UNIXLP-FORMFEED    := PO-VALUE (F)
    VALUE 'LISTNAME'    UNIXLP-LISTNAME    := PO-VALUE (F)
    VALUE 'USER'        UNIXLP-USER        := PO-VALUE (F)
    VALUE 'TABLE'       UNIXLP-TABLE       := PO-VALUE (F)
    VALUE 'SPOOLNUMBER' UNIXLP-SPOOLNUMBER := PO-VALUE (F)
    VALUE 'SPOOLHOST'   UNIXLP-SPOOLHOST   := PO-VALUE (F)
    VALUE 'TRACE'       UNIXLP-TRACE       := PO-VALUE (F)
    VALUE 'ESCAPE-B1'
      PERFORM CHAR2HEX
      UNIXLP-ESCAPE-BEFORE-1 := PO-VALUE (F)
    VALUE 'ESCAPE-B2'
      PERFORM CHAR2HEX
      UNIXLP-ESCAPE-BEFORE-2 := PO-VALUE (F)
    VALUE 'ESCAPE-B3'
      PERFORM CHAR2HEX
      UNIXLP-ESCAPE-BEFORE-3 := PO-VALUE (F)
    VALUE 'ESCAPE-A1'
      PERFORM CHAR2HEX
      UNIXLP-ESCAPE-AFTER-1 := PO-VALUE (F)
    VALUE 'TIMEOUT'
      IF PO-VALUE (F) IS (N5)
        UNIXLP-TIMEOUT             := VAL(PO-VALUE (F))
      END-IF
    NONE VALUE IGNORE
  END-DECIDE
END-FOR
*
END-SUBROUTINE /* UNIXLP-INTERFACE
*
************************************************************************
DEFINE SUBROUTINE CHAR2HEX
************************************************************************
EXAMINE PO-VALUE(F) FOR ' ' GIVING LENGTH IN #PO-LEN
EXAMINE PO-VALUE(F) TRANSLATE USING #PO-TABLE(*)
RESET #PO-FLAG #PO-CHAR #PO-VAL #PO-STRING
FOR I = 1 TO #PO-LEN
  #PO-CHAR := SUBSTR(PO-VALUE(F),I,1)
  IF NOT #PO-FLAG
    IF #PO-CHAR  < 16
      #PO-CHAR-P := #PO-CHAR
      #PO-VAL    := #PO-CHAR-P * 16
    ELSE
      RESET #PO-CHAR
    END-IF
    #PO-FLAG     := TRUE
  ELSE
    IF #PO-CHAR  < 16
      #PO-CHAR-P := #PO-CHAR
      #PO-VAL    := #PO-VAL + #PO-CHAR-P
    END-IF
    #PO-CHAR     := #PO-VAL
    COMPRESS #PO-STRING #PO-CHAR TO #PO-STRING LEAVING NO
    #PO-FLAG     := FALSE
  END-IF
END-FOR
PO-VALUE(F)      := #PO-STRING
*
END-SUBROUTINE /* CHAR2HEX
*
END
