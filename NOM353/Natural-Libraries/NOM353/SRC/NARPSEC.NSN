* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* NARPSEC  SECURITY INTERFACE
*
* Maintenance:
*
* fhi     2006-06-07 p(279849) Introduce new Revive profile 'M'
*
** LIST OF CODES
**
**CODE  FUNCTION                       PROFILE-VARIABLE
**----  -----------------------------  -------------------
** ADM  ADMINISTRATOR
** DRP  DISPLAY REPORT DEFINITION      REPORTS=D,M,P
** MRP  MODIFY  REPORT DEFINITION      REPORTS=M,P
** PRP  PURGE   REPORT DEFINITION      REPORTS=P
** DBU  DISPLAY BUNDLE                 BUNDLES=D,M,P
** MBU  MODIFY  BUNDLE                 BUNDLES=M,P
** PBU  PURGE   BUNDLE                 BUNDLES=P
** FBU  FLUSH   BUNDLE                 FLUSH=Y
** DUS  DISPLAY USER                   USERS=D,M,P
** MUS  MODIFY  USER                   USERS=M,P
** PUS  PURGE   USER                   USERS=P
** DPR  DISPLAY PRINTER                PRINTERS=D,M,P
** MPR  MODIFY  PRINTER                PRINTERS=M,P
** PPR  PURGE   PRINTER                PRINTERS=P
** DPH  DISPLAY PHYSICAL PRINTER       PHYSICAL=D,M,P
** MPH  MODIFY  PHYSICAL PRINTER       PHYSICAL=M,P
** PPH  PURGE   PHYSICAL PRINTER       PHYSICAL=P
** DDL  DISPLAY DISTRIBUTION LIST      LISTS   =D,M,P
** MDL  MODIFY  DISTRIBUTION LIST      LISTS   =M,P
** PDL  PURGE   DISTRIBUTION LIST      LISTS   =P
** DMO  DISPLAY MONITOR DEFAULTS       DEFAULTS=D,M
** MMO  MODIFY  MONITOR DEFAULTS       DEFAULTS=M
** STA  START   MONITOR                STARTUP =Y
** STP  STOP    MONITOR                SHUTDOWN=Y
** ARC  ARCHIVE REPORT                 ARCHIVE =Y,N,M
** REV  REVIVE  REPORT                 REVIVE  =Y,N,M
** PAC  PURGE   ACTIVE REPORT          AREPS   =P
** MAC  MODIFY  ACTIVE REPORT          AREPS   =M,P
** DAC  DISPLAY ACTIVE REPORT          AREPS   =D,M,P
** PNO  PURGE   NODE                   NODES   =P
** MNO  MODIFY  NODE                   NODES   =M,P
** DNO  DISPLAY NODE                   NODES   =D,M,P
** PDS  PURGE   DESTINATION            DEST    =P
** MDS  MODIFY  DESTINATION            DEST    =M,P
** DDS  DISPLAY DESTINATION            DEST    =D,M,P
** DCA  DISPLAY CALENDAR DEFINITION    REPORTS=D,M,P
** MCA  MODIFY  CALENDAR DEFINITION      CALENDARS=M,P
** PCA  PURGE   CALENDAR DEFINITION      CALENDARS=P
** AAD  ARCHIVE ADMINISTRATION         ARCHIVE-ADMIN=Y,N
** PAB  PURGE   ACTIVE BUNDLES         ABUNDS=P
** MAB  MODIFY  ACTIVE BUNDLES         ABUNDS=M,P
** DAB  DISPLAY ACTIVE BUNDLES         ABUNDS=D,M,P
** PPO  PURGE   PRINTOUTS              PRINTO=P
** MPO  MODIFY  PRINTOUTS              PRINTO=M,P
** DPO  DISPLAY PRINTOUTS              PRINTO=D,M,P
** DLO  DISPLAY LOG FOR NON-ADMIN      DISPLAY-MONITOR=Y,N
*
* MAINTENANCE:
*
* GW  91-03-01  'AAD' ARCHIVE ADMINISTRATION ADDED
* GW  91-12-13  'PAB','MAB','DAB','PPO','MPO','DPO' ADDED
* WS  00-06-07  CE 7592 'DLO' DISPLAY LOG FOR NON-ADMINISTRATORS
*
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 USER-PROFILE(A250)
1 FUNCTION(A3)
1 ALLOWED(L)
LOCAL USING PROF-LOC
END-DEFINE
RESET ALLOWED  /*MB111
MOVE USER-PROFILE TO PROFILE-STRING
*
IF PROF-TYPE = 'A'
  MOVE TRUE TO ALLOWED
  ESCAPE ROUTINE
END-IF
RESET ALLOWED
DECIDE ON FIRST VALUE OF FUNCTION
*** NETWORK FUNCTIONS'
  VALUE 'MUS' /* ADD UPDATE COPY USERS
    IF PROF-USERS ='M' OR = 'P' MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'DUS' /* LIST USERS
    IF PROF-USERS    = 'D' OR = 'M' OR = 'P'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'PUS' /* DELETE USERS
    IF PROF-USERS = 'P'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'DRP'  /*LIST REPORTS
    IF PROF-REPORTS = 'D' OR ='M' OR ='P'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'PRP' /* DELETE REPORTS
    IF PROF-REPORTS = 'P'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'MRP' /* UPDATE REPORT DEFINITION
    IF PROF-REPORTS = 'M' OR ='P'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'DBU'  /*LIST BUNDLES
    IF PROF-BUNDLES = 'D' OR ='M' OR ='P'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'PBU' /* DELETE BUNDLE
    IF PROF-BUNDLES = 'P'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'MBU' /* UPDATE BUNDLE DEFINITION
    IF PROF-BUNDLES = 'M' OR ='P'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'DPR'  /*LIST PRINTERS
    IF PROF-PRINTERS = 'D' OR ='M' OR ='P'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'PPR' /* DELETE PRINTER
    IF PROF-PRINTERS = 'P'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'MPR' /* UPDATE PRINTER DEFINITION
    IF PROF-PRINTERS = 'M' OR ='P'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'DPH'  /*LIST PHYSICAL PRINTERS
    IF PROF-PHYSICAL = 'D' OR ='M' OR ='P'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'PPH' /* DELETE PHYSICAL PRINTER
    IF PROF-PHYSICAL = 'P'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'MPH' /* UPDATE PHYSICAL PRINTER DEFINITION
    IF PROF-PHYSICAL = 'M' OR ='P'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'DDL'  /*LIST DISTRIBUTION LISTS
    IF PROF-LISTS = 'D' OR ='M' OR ='P'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'PDL' /* DELETE DISTRIBUTION LIST
    IF PROF-LISTS = 'P'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'MDL' /* MODIFY DISTRIBUTION LIST
    IF PROF-LISTS = 'M' OR ='P'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'DAC'  /*LIST ACTIVE REPORTS
    IF PROF-AREPS = 'D' OR ='M' OR ='P'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'PDL' /* DELETE ACTIVE-REPORTS
    IF PROF-AREPS = 'P'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'MAC' /* MODIFY ACTIVE REPORTS
    IF PROF-AREPS = 'M' OR ='P'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'ARC'   /* ARCHIVE ACTIVE REPORT
    IF PROF-ARCHIVE NE 'N' /* P279849 was "= 'Y'"
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'REV'   /* REVIVE ACTIVE REPORT
    IF PROF-REVIVE NE 'N' /* P279849 was "= 'Y'"
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'DMO'  /*DISPLAY DEFAULTS
    IF PROF-DEFAULTS = 'D' OR = 'M'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'MMO' /* MODIFY DEFAULTS
    IF PROF-DEFAULTS = 'M' OR = 'P'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'STA'   /* START MONITOR
    IF PROF-STARTUP = 'Y'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'STP'   /* STOP  MONITOR
    IF PROF-SHUTDOWN = 'Y'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'FBU'   /* FLUSH BUNDLE
    IF PROF-FLUSH = 'Y'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'PAC'
    IF PROF-AREPS = 'P'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'PNO'
    IF PROF-NODES = 'P'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'MNO'
    IF PROF-NODES = 'P' OR = 'M'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'DNO'
    IF PROF-NODES = 'P' OR = 'M' OR = 'D'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'PDS'
    IF PROF-DEST = 'P'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'MDS'
    IF PROF-DEST = 'P' OR = 'M'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'DDS'
    IF PROF-DEST = 'P' OR = 'M' OR = 'D'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'PCA'
    IF PROF-CALENDARS = 'P'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'MCA'
    IF PROF-CALENDARS = 'P' OR = 'M'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'DCA'
    IF PROF-CALENDARS = 'P' OR = 'M' OR = 'D'
      MOVE TRUE TO ALLOWED
    END-IF
* GW 91-03-01 FOLLOWING LINES ADDED
  VALUE 'AAD'
    IF PROF-ARCHIVE-ADMIN = 'Y'
      MOVE TRUE TO ALLOWED
    END-IF
* GW 91-03-01 END INSERTION
* GW 91-12-13 FOLLOWING LINES ADDED
  VALUE 'DAB'
    IF PROF-ABUNDS = 'P' OR = 'M' OR = 'D'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'MAB'
    IF PROF-ABUNDS = 'P' OR = 'M'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'PAB'
    IF PROF-ABUNDS = 'P'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'DPO'
    IF PROF-PRINTOUTS = 'P' OR = 'M' OR = 'D'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'MPO'
    IF PROF-PRINTOUTS = 'P' OR = 'M'
      MOVE TRUE TO ALLOWED
    END-IF
  VALUE 'PPO'
    IF PROF-PRINTOUTS = 'P'
      MOVE TRUE TO ALLOWED
    END-IF
* GW 91-12-13 END INSERTION
* WS 00-06-07 CE 7592 START
  VALUE 'DLO'
    IF PROF-DISPLAY-MONITOR = 'Y'
      MOVE TRUE TO ALLOWED
    END-IF
* WS 00-06-07 CE 7592 END
  NONE VALUE MOVE FALSE TO ALLOWED
END-DECIDE
END
