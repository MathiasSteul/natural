* <Natural Source Header
* Member    NRMHELP
* Version   1.3
* Function  Help main routine
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* mrs 93-06-15           clean up
* wcd 00-04-01 CE 7267   New PFkey for additional printers in RPFK---L
* fhi 02-10-30 fhi101    switch on optimizer compiler
* sju 03-06-04 p(240461) work in development environment
* HH 04-12-09 use callnat NATA1100 instead of SYSTEM-FNAT/SYSTEM-FUSER
* fhi 06-03-29 p(265450) Make help available in test environment
* SU1     2014-12-23 NOMALL-1548 removed unused definitions
* SU2     2016-07-29 NOMALL-1518 NOM3.5 deactivate opt.Compiler
* ----------------------------------------------------------------------
/*SU2 OPTIONS MCG=(INDX=ON,OVFLW=ON,DIGTCHCK=ON)
*
DEFINE DATA GLOBAL USING NRM-GL
*
LOCAL USING RPFK---L
LOCAL USING RTXT---L
LOCAL USING NAD-MSG   /* Data for message exchange
LOCAL USING NAD-FLD   /* Description of the field in error
*
LOCAL
1 L-HEADER               (A78)
1 #INPUT-MEMBER          (A8)
1 #MEMBER                (A8)
1 REDEFINE #MEMBER
  2 #MEMBER-1            (A1)
1 I                      (I2)
1 NADA1100
  2 OBJEKT-KEY
    3 DBID               (N5)
    3 FNR                (N5)
    3 PASSWORD           (A8)
    3 CIPHERCODE         (N8)
    3 OBJECT-CLASS       (I1)
    3 LIBRARY            (A8)
    3 OBJECT-NAME        (A32)
    3 OBJECT-TYPE        (A2)
    3 OBJECT-KIND        (A1)
  2 INPUTS
    3 OPT-ACCESS         (A1)
    3 OPT-ET             (L)
    3 OPT-REPLACE        (A1)
    3 OPT-LINE-NUM       (A1)
    3 OPT-STEPLIBS       (L)
    3 OPT-REDEF-DIR      (L)
    3 OPT-STREAM         (A1)
    3 OPT-AMOUNT         (I2)
    3 OPT-LINESIZE       (I2)
  2 INPUT-OUTPUTS
    3 INT-HANDLE         (I4)
    3 NEXT-SEQ           (I4)
    3 NEXT-NUM           (I2)
  2 OUTPUTS                        /* Output for READ, input for WRITE
    3 RETURNED           (I2)
    3 SRC-NUM            (I2/1:20)
    3 SRC-TEXT           (A1/1:20,1:92)
    3 REDEFINE SRC-TEXT
      4 SRC-GROUP        (1:20)
        5 SRC-LINE       (A92)
    3 SRC-SEQ            (I4/1:20)
    3 SRC-LONG           (A1/1:20)
*
1 NATA1100
  2 VERSION              (I1) INIT <1>
  2 V1-NSC-CHECK         (A1) /* Check against NSC
1 REDEFINE NATA1100
  2 EXTENDED-PARMS
    3 EXTENDED-DATA      (A1/1:2)
*
1 #RECORD1               (A82)
1 REDEFINE #RECORD1
  2 #FILLER              (B2)
  2 #RECORD              (A80)
  2 REDEFINE #RECORD
    3 #CODE              (A2)
    3 REDEFINE #CODE
      4 #CODE-1          (A1)
    3 #REC-31            (A1)
    3 #REC-32            (A77)
1 #S77                   (A77)
1 REDEFINE #S77
  2 #S77-1               (A1/77)
1 #TOKENS                (A30/10)
1 #FORW                  (A10)
1 #BACK                  (A10)
1 SEL                    (A4/30)
1 SELP                   (A10/30)
1 SW-SEL                 (L) INIT <FALSE>
1 #I                     (I4)
1 J                      (I4)
1 #REC-COUNT             (N3)
1 #LINE1                 (A78)
1 REDEFINE #LINE1
  2 #LINE1C              (A1/78)
1 #TREE                  (A8/10) INIT <'H00000'>
1 #TRX                   (I2)    INIT <1>
1 #SCREEN                (A78/18)
1 #NOLIN                 (N3)       INIT <18>
1 #L                     (N2)
1 #IND                   (N2)
1 #COMMAND               (A50)
1 REDEFINE #COMMAND
  2 #COMMAND-1           (A1)
1 #HDLEN                 (I2)  INIT <1>
1 #HDPOS                 (I2)  INIT <1>
1 #TI1                   (I2)  INIT <1>
1 #FROM-KEY              (A18)
1 REDEFINE #FROM-KEY
  2 #FROM-LIB            (A8)
  2 #FROM-MEM            (A8)
  2 #FROM-SEQ            (B2)
1 #TO-KEY                (A18)
1 REDEFINE #TO-KEY
  2 #TO-LIB              (A8)
  2 #TO-MEM              (A8)
  2 #TO-SEQ              (B2)
1 #HELP-LIB              (A8)
1 REDEFINE #HELP-LIB
  2 #SYSTEM-PREF         (A3)
  2 #SYSTEM-TYPE         (A1)
  2 #VERSION             (A3)
  2 #LANGUAGE            (A1)
1 #SELECTION             (L)
1 #CIND                  (N2)
1 #CMND                  (A8)
1 REDEFINE #CMND
  2 #CMD-FIL             (A1)
  2 #CMD-CMD             (A7)
1 #COMMANDS              (A10/6) INIT
  (01) <' QUIT'>
  (02) <' UP'>
  (03) <' EXIT'>
  (04) <' DOWN'>
  (05) <' FORWARD'>
  (06) <' BACKWARD'>
*
1 #TXT-NOT-AVAILABLE     (A70)
1 #TXT-RETURN-FROM-HELP  (A70)
1 #TXT-MORE              (A70)
1 #LIBRARY               (A8)
1 REDEFINE #LIBRARY
  2 #LIB-PREFIX          (A6)
  2 REDEFINE #LIB-PREFIX
    3 #LIB-PROD          (A3)
    3 #LIB-VERS          (N3)
1 REDEFINE #LIBRARY
  2 #LIB-HPREF           (A5)
1 IX                     (I2)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
IF *DATA > 0
  INPUT #INPUT-MEMBER
ELSE
  #INPUT-MEMBER := 'HMN00000'
END-IF
PERFORM INIT-TEXT
*
#MEMBER := #INPUT-MEMBER
*
SET CONTROL 'WB'
IF #MEMBER NE ' '
  #TREE(1) := #MEMBER
END-IF
*
PERFORM INIT-PFKEYS
PERFORM SET-PFKEYS
SET KEY CLR ='%R'
*
#TRX := 1 /* TREE INDEX
*
LAN. REPEAT
*
  #LANGUAGE := *LANGUAGE
  CALLNAT 'RGETLIB' #LIBRARY
  IF #LIB-PROD NE 'SYS' /* TEST ENVIRONMENT IN FUSER
    COMPRESS #LIB-HPREF 'H' #LANGUAGE TO #HELP-LIB LEAVING NO
  ELSE
    COMPRESS #LIB-PREFIX 'H' #LANGUAGE TO #HELP-LIB LEAVING NO
  END-IF
  #FROM-LIB := #TO-LIB := #HELP-LIB
  REPEAT1. REPEAT
    IF #TRX < 1
      ESCAPE ROUTINE
    END-IF
    #MEMBER := #TREE(#TRX)
/*SU 2018-05-18 IF G-NATRP-INDICATOR='NSM-ONLY' AND #MEMBER='HMN00000'
/*SU 2018-05-18 #MEMBER := 'HNRMMEN' END-IF
    #FROM-MEM := #TO-MEM := #MEMBER
    RESET #FROM-SEQ #L #REC-COUNT #I
    #TO-SEQ := H'FFFF'
    RESET #SCREEN(*) #BACK #FORW      /* CLEAR MAP
    SET KEY PF7 NAMED ' '
    SET KEY PF8 NAMED ' '
***
    IF #MEMBER-1 NE 'H' /*-- THE HELP MAP IS IN THE 'NATOP' LIBRARY --
      INPUT USING MAP #MEMBER
      SUBTRACT 1 FROM #TRX
      ESCAPE TOP
    END-IF
    PERFORM READ-NAT-MEMBER
    FOR J 1 TO #I
      IF SEL(J) NE ' '
        EXAMINE SEL(J) '''' REPLACE ' '
        EXAMINE SELP(J) '*' REPLACE ' '
        MOVE LEFT SEL(J) TO SEL(J)
        MOVE LEFT SELP(J) TO SELP(J)
      END-IF
    END-FOR
    EXAMINE #MEMBER 'ISR' REPLACE 'SPL'
    IF #REC-COUNT = 0
      COMPRESS #TXT-NOT-AVAILABLE ' (' #MEMBER ')' TO #S77 LEAVING NO
      #SCREEN(#NOLIN) := #TXT-RETURN-FROM-HELP
    END-IF
    IF #FORW NE ' '
      COMPRESS '#' #TXT-MORE '§' TO #SCREEN(#NOLIN) LEAVING NO
    END-IF
    PERFORM BUILD-HEADER
    CALLNAT 'N-HEADER' L-HEADER G-DATE-FORMAT #MEMBER
    SET CONTROL 'WB'
    INPUT USING MAP 'NRMHLPM&'
    RESET G-NATRP-ERC G-NATRP-ERT
    MOVE LEFT G-DIRECT-COMMAND TO G-DIRECT-COMMAND
    #COMMAND := G-DIRECT-COMMAND
*
    IF G-DIRECT-COMMAND NE ' '
      IF G-DIRECT-COMMAND = MASK ('SET LAN')
        SEPARATE G-DIRECT-COMMAND LEFT INTO #TOKENS(1:10)
          WITH DELIMITERS ' '
        IF #TOKENS (3) IS (N3)
          *LANGUAGE := VAL(#TOKENS (3))
          PERFORM INIT-TEXT
          PERFORM INIT-PFKEYS
          PERFORM SET-PFKEYS
          ESCAPE BOTTOM (REPEAT1.)
        END-IF
      END-IF
      RESET #SELECTION
      DECIDE FOR FIRST CONDITION
        WHEN (G-DIRECT-COMMAND = MASK ('H'NNN..) OR=MASK ('HC'NNN..)
            OR=MASK ('SPL'NNN..) )
          #TRX := 1
          #TREE(#TRX) := G-DIRECT-COMMAND /* NEW MAP DIRECTLY
          ESCAPE TOP
        WHEN #I > 0
          EXAMINE SEL(1:#I) FOR G-DIRECT-COMMAND GIVING INDEX #IND
          IF #IND > 0 AND SEL(#IND) = G-DIRECT-COMMAND
            ADD 1 TO #TRX
            #TREE(#TRX) := SELP(#IND)
            #SELECTION := TRUE
            ESCAPE TOP
          END-IF
        WHEN NONE
          IGNORE
      END-DECIDE
      IF #SELECTION
        ESCAPE TOP
      END-IF
      #CMD-CMD := G-DIRECT-COMMAND
      EXAMINE #COMMANDS(*) FOR #CMND GIVING INDEX #CIND
    END-IF
    DECIDE FOR  EVERY CONDITION
      WHEN *PF-KEY = 'PF2' OR (#CIND > 0 AND #COMMANDS(#CIND)=' QUIT')
        RESET #TRX
        ESCAPE ROUTINE
      WHEN *PF-KEY = 'PF3' OR (#CIND > 0 AND #COMMANDS(#CIND)=' EXIT')
        SUBTRACT 1 FROM #TRX
        ESCAPE TOP
      WHEN *PF-KEY = 'PF7'
          OR (#CIND > 0 AND #COMMANDS(#CIND)=' UP' OR = ' BACKWARD')
        IF #BACK NE ' '
          #TREE(#TRX) := #BACK
          ESCAPE TOP
        END-IF
      WHEN *PF-KEY = 'PF8' OR = 'ENTR'
          OR (#CIND > 0 AND #COMMANDS(#CIND)=' DOWN' OR = ' FORWARD')
        IF #FORW NE ' '
          #TREE(#TRX) := #FORW
          ESCAPE TOP
        END-IF
      WHEN NONE IGNORE
    END-DECIDE
  END-REPEAT
END-REPEAT
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE READ-NAT-MEMBER
************************************************************************
I := 1
RESET  #REC-COUNT
*
LIBRARY       := #FROM-LIB
OBJECT-NAME   := #FROM-MEM
OPT-LINE-NUM  := 'Y'
OPT-AMOUNT    := 20
OPT-LINESIZE  := 79
OPT-STREAM    := 'B'
V1-NSC-CHECK  := 'Y'
OPT-ACCESS   := 'O'
/*
REPEAT
  CALLNAT 'NATA1100' NADA1100  NATA1100.EXTENDED-PARMS NAD-MSG NAD-FLD
  OPT-ACCESS := 'R'
  IF NOT NAD-MSG.MSG-NR = 0 OR=100
    ESCAPE BOTTOM
  END-IF
  FOR IX = 1 TO RETURNED
    IF SRC-NUM(IX) > 0
      #RECORD := SRC-LINE (IX)
      PERFORM BUILD-LINE
    END-IF
  END-FOR
  #REC-COUNT := #REC-COUNT + 1
  IF NAD-MSG.MSG-NR = 100
    OPT-ACCESS := 'C'
    CALLNAT 'NATA1100' NADA1100 NATA1100.EXTENDED-PARMS NAD-MSG NAD-FLD
    ESCAPE BOTTOM /* EOF
  END-IF
END-REPEAT
*
END-SUBROUTINE /* READ-NAT-MEMBER
*
************************************************************************
DEFINE SUBROUTINE BUILD-LINE
************************************************************************
IF #RECORD = SCAN 'TUTORIAL ---' OR #RECORD = ' '
  ESCAPE ROUTINE
END-IF
*
DECIDE ON FIRST VALUE OF #CODE
  VALUE '&S'
    SEPARATE #RECORD LEFT INTO #TOKENS(1:10) WITH DELIMITERS ' '
    DECIDE ON EVERY VALUE OF #TOKENS(1)
      VALUE ')'
        SW-SEL := FALSE
      NONE VALUE
        ADD 1 TO #I
        SEL(#I) := #TOKENS(2)
        SELP(#I) := #TOKENS(3)
    END-DECIDE
  VALUE '&U'
    SEPARATE #RECORD LEFT INTO #TOKENS(1:10) WITH DELIMITERS ' '
  VALUE '&C', '&F'    /* CONT, FORW
    SEPARATE #RECORD LEFT INTO #TOKENS(1:10) WITH DELIMITERS ' '
    #FORW := #TOKENS(2)
    SET KEY PF8 = PGM NAMED ' +  '
  VALUE '&B'           /* BACK
    SEPARATE #RECORD LEFT INTO #TOKENS(1:10) WITH DELIMITERS ' '
    #BACK := #TOKENS(2)
    SET KEY PF7 = PGM NAMED ' -  '
  VALUE '&H'           /* HEADER
    #S77 := #REC-32
  NONE VALUE      /* NO '&.'
    IF #L <  #NOLIN
      IF #CODE ='&L' OR = '&l'
        RESET #RECORD
      END-IF
      EXAMINE #RECORD '%' REPLACE '#'
      ADD 1 TO #L
      #SCREEN(#L) := #RECORD
    END-IF
END-DECIDE
*
END-SUBROUTINE /* BUILD-LINE
*
************************************************************************
DEFINE SUBROUTINE BUILD-HEADER
************************************************************************
MOVE ALL '-' TO #LINE1
*
IF #S77 = ' '
  ESCAPE ROUTINE
END-IF
*
#HDLEN := 77
*
REPEAT
  WHILE #HDLEN > 0 AND #S77-1 (#HDLEN) = ' '
  SUBTRACT 1 FROM #HDLEN
END-REPEAT
*
ADD 1 TO #HDLEN
#HDPOS := (78 - #HDLEN) / 2
*
FOR #TI1 = 1 TO #HDLEN
  #LINE1C (#HDPOS+#TI1) := #S77-1 (#TI1)
END-FOR
*
#LINE1C (#HDPOS) := '#'
#LINE1C (#HDPOS+#HDLEN) := '§'
*
END-SUBROUTINE /* BUILD-HEADER
*
************************************************************************
DEFINE SUBROUTINE INIT-PFKEYS
************************************************************************
INCLUDE RPFEXI-C
INCLUDE RPFQUI-C
*
CALLNAT 'RPFINI-N' G-PF G-PFB
*
END-SUBROUTINE /* INIT-PFKEYS
*
************************************************************************
DEFINE SUBROUTINE INIT-TEXT
************************************************************************
CALLNAT 'RLTINI-N' ##TXT-HELP-NOT-AVAILABLE #TXT-NOT-AVAILABLE G-TXB
CALLNAT 'RLTINI-N' ##TXT-RETURN-FROM-HELP #TXT-RETURN-FROM-HELP G-TXB
CALLNAT 'RLTINI-N' ##TXT-MORE #TXT-MORE G-TXB
*
END-SUBROUTINE
* --------------------------------------- set pfkeys -------------------
