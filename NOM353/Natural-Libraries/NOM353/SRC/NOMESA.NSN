* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    NOMESA
* Function  This exit is called by NOM Unix accessing a BS2000 node.
*   When ESA (ESM-Adapter for BS2000) is used to access the data,
*   there are two options for the character translation:
*   o use ESA character translation.
*   o use NOM character translation (data is read binary and converted
*     within NOM Unix.
*   The two parameters #NODE and #NODE-NAME vcan be used to decide
*   which method should be used.
*
* Maintenance
* uuu     yyyy-mm-dd s(999999) ...
*         2021-10-10 created for version 3.5.2
* SU1     2022-06-07 NOMALL-2563 avoid NAT0082:move SYSNOMS -> SYSNOM
* ---------------------------------------------------------------------
DEFINE DATA PARAMETER
1 #NODE      (N5)  BY VALUE   /*node number in nOM (8.1.13)
1 #NODE-NAME (A16) BY VALUE   /*name of the node in NOM (8.1.13)
1 #REPORT-NAME (A25) BY VALUE OPTIONAL /*name or the NOM report
1 #USE-ESA   (L)   /*character translation: TRUE=ESA / FALSE=NOM
************************************************************************
LOCAL
1 #MSG (A250)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#USE-ESA := FALSE
/* #USE-ESA := true
MOVE EDITED #USE-ESA (EM='No'/'Yes') TO #MSG
COMPRESS 'Use ESA=' #MSG TO #MSG LEAVING NO
IF #REPORT-NAME SPECIFIED
  COMPRESS #MSG 'RP:' #REPORT-NAME TO #MSG
END-IF
PRINT *DAT4I *TIME(AL=8) *PROGRAM 'node:'
  #NODE '(' #NODE-NAME ')' #MSG
*
END
