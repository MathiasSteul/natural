DEFINE DATA
PARAMETER USING XXUX---P
PARAMETER USING RMEXP-A
PARAMETER
1 #TRACING               (L)
1 #ID                    (A250) BY VALUE OPTIONAL
/***********************************************************************
/*SU4 LOCAL USING RMEXPUXL
LOCAL USING RMBAS64P
LOCAL USING VUXDEF-L
/*SU2 LOCAL USING VMONITUL /* NOMALL-2215 fhi in
LOCAL USING N-41002L /*SU1
/***********************************************************************
LOCAL
1 UX VIEW OF NRM-UX-NODES /*SU4 was RMEXPUXL
  2 UX-OBJECT-TYPE          (A10)
  2 UX-OBJECT-TIME          (T)
  2 UX-LAST-UPDATE          (T)
  2 UX-LAST-UPDATE-USER     (A16)
  2 UX-NODE-NAME            (A16)
  2 UX-NODE-DESCRIPTION     (A50)
  2 UX-NODE-USERID          (A8)
  2 UX-NODE-PASSWORD        (A32)
  2 UX-NODE-GROUP           (A8)
  2 UX-NODE-SUSPEND         (A1)
  2 UX-NODE-TIMEOUT         (N2)
  2 UX-NODE-TEMPDIR         (A70)
  2 UX-NODE-ACCESS
    3 UX-NODE-PATH          (A70/1:10)
    3 UX-NODE-CONTAINER-DB  (N5/1:10)
    3 UX-NODE-CONTAINER-FNR (N5/1:10)
1 WRITE-FILE VIEW OF WRITE-FILE
  2 ERROR-CODE
  2 ERROR-TEXT
*
1 #FIELD                 (A32)
1 #VALUE                 (A300)
1 #LEN                   (I4)
1 #WORK-LINE             (A250)
1 #FUNCTION              (A10)
1 #I                     (I4)
1 #J                     (I4)
1 #K                     (I4)
1 #L                     (I4)
1 #PROGRAM               (A8) INIT <*PROGRAM>
1 REDEFINE #PROGRAM
  2 FILLER               5X /*RMEXP
  2 #TYPE                (A2)
1 #KEY                   (A100)
1 #KEY-FROM              (A100)
1 #KEY-TO                (A100) INIT FULL LENGTH <H'FF'>
1 #KEY-MASK              (A25)
/*SU4 1 #KEY-LEN               (I2)
1 #KEY-LEN2              (I2) CONST <16> /*full len UX-NODE-NAME SU4
1 #TRACE-MSG             (A250)
1 #POS                   (I4)
1 #DEP                   (A5)
1 #NODE                  (N5)
1 #MASK                  (A300) INIT FULL LENGTH <'P'>
1 #PRINTABLE             (A300)
1 #UX-OBJECT-TIME        (A21)
1 #UX-LAST-UPDATE        (A21)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
PERFORM #START
READ UX BY UX-NODE-NAME = #KEY-FROM THRU #KEY-TO
  #KEY := UX-NODE-NAME
  PERFORM HANDLE-MASK
  COMPRESS '<UX depending="' #DEP '">' TO #WORK-LINE LEAVING NO
  PERFORM WRITE-XML
  IF #OD-LOG = 'Y'
    IF #ID SPECIFIED
      COMPRESS 'Exported: UX */' UX-NODE-NAME TO #TRACE-MSG
    ELSE
      COMPRESS 'Exported: UX /' UX-NODE-NAME TO #TRACE-MSG
    END-IF
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    END TRANSACTION
  END-IF
  MOVE EDITED UX.UX-OBJECT-TIME (EM=YYYY'-'MM'-'DD'-'HH':'II':'SS'.'T)
    TO #UX-OBJECT-TIME
  MOVE EDITED UX.UX-LAST-UPDATE (EM=YYYY'-'MM'-'DD'-'HH':'II':'SS'.'T)
    TO #UX-LAST-UPDATE
  #FIELD := 'UX-OBJECT-TYPE'
  #VALUE :=  UX.UX-OBJECT-TYPE
  PERFORM CONVERT-XML
  #FIELD := 'UX-OBJECT-TIME'
  #VALUE :=  #UX-OBJECT-TIME
  PERFORM CONVERT-XML
  #FIELD := 'UX-LAST-UPDATE'
  #VALUE :=  #UX-LAST-UPDATE
  PERFORM CONVERT-XML
/*SU2 ->  #FIELD :='UX-LAST-UPDATE-USER' #VALUE:=UX.UX-LAST-UPDATE-USER
/*  PERFORM CONVERT-XML FOR #L := 2 TO 1 STEP -1
/*  IF UX.UX-EMAIL-RECIPIENTS (#L) NE ' ' ESCAPE BOTTOM END-IF END-FOR
/*FOR #I = 1 TO #L #FIELD := 'UX-EMAIL-RECIPIENTS'
/*#VALUE :=UX.UX-EMAIL-RECIPIENTS(#I) PERFORM CONVERT-XML END-FOR SU2 <-
  #FIELD := 'UX-NODE-NAME'
  #VALUE :=  UX.UX-NODE-NAME
  PERFORM CONVERT-XML
  #FIELD := 'UX-NODE-DESCRIPTION'
  #VALUE :=  UX.UX-NODE-DESCRIPTION
  PERFORM CONVERT-XML
  #FIELD := 'UX-NODE-USERID'
  #VALUE :=  UX.UX-NODE-USERID
  PERFORM CONVERT-XML
  #FIELD := 'UX-NODE-PASSWORD'
  #VALUE :=  UX.UX-NODE-PASSWORD
  PERFORM CONVERT-XML
  #FIELD := 'UX-NODE-GROUP'
  #VALUE :=  UX.UX-NODE-GROUP
  PERFORM CONVERT-XML
  #FIELD := 'UX-NODE-SUSPEND'
  #VALUE :=  UX.UX-NODE-SUSPEND
  PERFORM CONVERT-XML
  #FIELD := 'UX-NODE-TIMEOUT'
  #VALUE :=  UX.UX-NODE-TIMEOUT
  MOVE LEFT #VALUE TO #VALUE
  PERFORM CONVERT-XML
  #FIELD := 'UX-NODE-TEMPDIR'
  #VALUE :=  UX.UX-NODE-TEMPDIR
  PERFORM CONVERT-XML
  FOR #L := 10 TO 1 STEP -1
    IF UX.UX-NODE-PATH (#L) NE ' '
      ESCAPE BOTTOM
    END-IF
  END-FOR
  FOR #I = 1 TO #L
    #FIELD := 'UX-NODE-PATH'
    #VALUE :=  UX.UX-NODE-PATH(#I)
    PERFORM CONVERT-XML1
  END-FOR
  FOR #L := 10 TO 1 STEP -1
    IF UX.UX-NODE-CONTAINER-DB (#L) NE 0
      ESCAPE BOTTOM
    END-IF
  END-FOR
  FOR #I = 1 TO #L
    #FIELD := 'UX-NODE-CONTAINER-DB'
    #VALUE :=  UX.UX-NODE-CONTAINER-DB(#I)
    MOVE LEFT #VALUE TO #VALUE
    PERFORM CONVERT-XML1
  END-FOR
  FOR #L := 10 TO 1 STEP -1
    IF UX.UX-NODE-CONTAINER-FNR (#L) NE 0
      ESCAPE BOTTOM
    END-IF
  END-FOR
  FOR #I = 1 TO #L
    #FIELD := 'UX-NODE-CONTAINER-FNR'
    #VALUE :=  UX.UX-NODE-CONTAINER-FNR(#I)
    MOVE LEFT #VALUE TO #VALUE
    PERFORM CONVERT-XML1
  END-FOR
*
  PERFORM #END-OBJ
END-READ
PERFORM #END
*
INCLUDE RMEXP-C /*CALL-NPR, WRITE-XML, OPEN-XML, CLOSE-XML, WRITE-XML
