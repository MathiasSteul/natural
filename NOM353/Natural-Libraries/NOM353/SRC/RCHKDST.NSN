* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
*
** RCHKDST
** CHECK IF AN ADDRESSEE IN A DISTRIBUTION LIST IS DEFINED
*** Author :Michel
* SU1     2013-01-31 unused      Deactivate unused data areas
***********************************************************************
DEFINE DATA
PARAMETER
1 #ADDRESSEE(A8)  /* MAY BE A USER OR A DISTRIBUTION LIST
1 #EXIST(L)
**LOCAL USING VUSERS-L /*SU1 out
LOCAL
*
1 LISTS VIEW OF NRM-DISTRIBUTION-LIST
1 USERS VIEW OF NRM-USERS /*SU1 in
**2 D-LIST-NAME /*SU1 out
*
END-DEFINE
FIND-USERS.
FIND NUMBER USERS WITH USER-ID = #ADDRESSEE
IF *NUMBER(FIND-USERS.) > 0
  MOVE TRUE TO #EXIST
  ESCAPE ROUTINE
ELSE
FIND-LISTS.
  FIND NUMBER LISTS WITH D-LIST-NAME=#ADDRESSEE
  IF *NUMBER(FIND-LISTS.) > 0
    MOVE TRUE TO #EXIST
    ESCAPE ROUTINE
  ELSE
    MOVE FALSE TO #EXIST
  END-IF
END-IF
END
