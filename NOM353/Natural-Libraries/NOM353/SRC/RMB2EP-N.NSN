* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    RMB2EP-N
* Function  Eliminate BS2000 password from print file
* Version   1.3.5
*
* Maintenance
* uuu     yyyy-mm-dd s(999999) ...
* gw      1996-06-16 s(999999) created
* xsetggr 2007-05-02 NOM3201 Support 5 byte  node numbers
* fhi     2010-09-03 NOMALL-97 Extend message line
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
01  RMB2EP-NODE                (N5) /* xsetggr 2007-05-02 NOm3201 was n3
01  RMB2EP-DSNAME              (A54)
01  RMB2EP-ERC                 (N4)
01  RMB2EP-ERT                 (A250) /* NOMALL-97 was (A70)
*
            LOCAL
01  CATALOG-UPDATE VIEW OF CATALOG-UPDATE
    02  ERROR-CODE
    02  ERROR-TEXT
    02  REDEFINE ERROR-TEXT
        03  ERROR-PREFIX       (A7)
        03  ERROR-FIL          (A1)
        03  ERROR-TXT          (A49)
    02  SYSTEM-MESSAGE-CODE
*
END-DEFINE
* --------------------------------------- Main -------------------------
*
RESET RMB2EP-ERC RMB2EP-ERT
*
  UPDPSWD.
FIND CATALOG-UPDATE
    WITH NODE              = RMB2EP-NODE
    AND DSNAME             = RMB2EP-DSNAME
    AND READ-PASSWORD      = '*NONE'
    AND WRITE-PASSWORD     = '*NONE'
    AND EXECUTION-PASSWORD = '*NONE'
*
  IF ERROR-CODE NE 0
    COMPRESS CATALOG-UPDATE.ERROR-PREFIX
      '(' CATALOG-UPDATE.SYSTEM-MESSAGE-CODE
      ')' CATALOG-UPDATE.ERROR-TXT
      INTO CATALOG-UPDATE.ERROR-TEXT
    WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
      'Error while modifying passwords' RMB2EP-DSNAME
    WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
      ERROR-TEXT
  END-IF
*
END-FIND
*
END
