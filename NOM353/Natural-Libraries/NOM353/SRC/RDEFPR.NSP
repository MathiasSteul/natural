DEFINE DATA GLOBAL USING  NRM-GL
*
LOCAL USING RPFK---L
LOCAL USING EOM----E
LOCAL USING EOM----P
LOCAL USING EOMPRM-E
LOCAL USING EOMPRM-P
LOCAL USING EOMMSG-P
LOCAL USING EOMPHTYE
LOCAL USING CONST-L /* NKEW1 changed
*
LOCAL
1 PHYSICAL-PRINTER VIEW OF NRM-PHYSICAL-PRINTERS
  2 PH-VTAMID
  2 PH-JCL-SKELETON
  2 PH-LOCATION
  2 PH-PRINTER-TYPE
1 USERS VIEW OF NRM-USERS
1 UX-NODES  VIEW OF NRM-UX-NODES
*
1 UNIX-NODE-NAME            (A16)
1 #FUNC                     (A1)
1 #PRINTER                  (A8)
1 CV-KEY                    (C)
1 CV-DESC                   (C) INIT <(AD=I CD=NE)>
1 CV-MAP                    (C) INIT <(AD=I CD=NE)>
1 CV-JOBCARDS               (C) INIT <(AD=I CD=NE)>
1 CV-JOBCARDS-PROTECT       (L)
1 L-HEADER                  (A78)
1 READ-RECORD               (L)
1 #FATHER-PROG              (A8) INIT <'RLISPR'>
1 #LANGUAGE                 (I1)
1 #PANEL                    (I2)
1 #MAP-IND                  (I1) INIT <1>
1 #MAP-DYNAMIC              (11)
  2 #MAP-VALUE-FROM-COL     (I2)
  2 #MAP-VALUE-TO-COL       (I2)
  2 #MAP-LINE               (A77)
  2 REDEFINE #MAP-LINE
    3 #MAP-LINE-A1          (A1/1:77)
1 #I                        (I2)
1 #J                        (I2)
1 #K                        (I2)
1 #L                        (I2)
1 #IX                       (I2)
1 #MAP-OCC                  (I1) CONST <11>
1 #EDIT-LIB                 (A8)
1 #CP                       (I2) INIT <1>
1 #END-OF-DATA              (L)
1 #LOCATION                 (A30)
1 #CURRENT-PHYSICAL         (A8)
1 #MARK                     (I4)
1 #MARK2                    (I4) INIT <7>
1 #MARK3                    (I4)
1 #ANY-ERROR                (L)
1 #OLD-EXITLIB              (A8)
1 #OLD-EXITMEM              (A8)
1 #FIRST-TIME               (L)
1 #P-ID-E                   (A8)
1 #P-ID                     (A8) INIT <'DEFAULT'>
1 REDEFINE #P-ID
  2 #P-ID-1                 (A7)
  2 #SUFFIX                 (A1)
1 #PROG                     (A8) INIT <*PROGRAM>
1 #GR-NAME                  (A25)
1 #ALLOWED                  (L) /* xsetggr 2012-09-21 NOMALL-89 end
1 #LAST-MOD                 (A40) /*SU2
1 #POS                      (I4)
1 #A8                       (A8)
1 #N9                       (N9)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
* NKEW1 <
#JOB_ADD_FIELD := F#SETVAR(<#_JOBCARDS(1:2),#_ADDITIONALPARA(1:2)>)
* NKEW1 >
IF *DATA = 3
  INPUT (AD=MIT) G-C-FUNC G-C-PRINTER #PANEL
END-IF
* xsetggr 2012-09-21 NOMALL-89 insert next lines
#GR-NAME := G-C-PRINTER
PERFORM XXSECURITY-CHECK #PROG #GR-NAME #ALLOWED
INCLUDE C-NALLOW                     /* xsetggr 2012-09-21 NOMALL-89 end
IF G-C-FUNC = 'P'
  FETCH RETURN 'RDELPR'
  INCLUDE C-ESCAPE
END-IF
CV-KEY := (AD=I)
RESET G-COMMIT G-LINECOM(*)
*
#FUNC := G-C-FUNC
#PRINTER := G-C-PRINTER
#SUFFIX := 'Z'
#P-ID-E := #P-ID
#SUFFIX := 'A'
*
EOM-USER-PROFILE := G-USER-PROFILE
EOM-USER         := G-USERID
EOM-USER-TYPE    := G-USER-TYPE
FNDUS. FIND NUMBER USERS WITH USER-ID = G-USERID
IF *NUMBER (FNDUS.) = 0
  EOM-DEF-USER := 'Y'
END-IF
EOM-LANGUAGE := G-LANGUAGE
* xsetggr 2011-05-11 NOMALL-986 insert next 2 lines
CALLNAT 'RGETLIB' EOM-LIBRARY
COMPRESS EOM-LIBRARY 'U' TO EOM-USER-LIBRARY LEAVING NO
*
RESET  EOM-LOGGING                          /* ????????????????
IF G-LOG-PRT                                /* ????????????????
  EOM-LOG-TYPES (1) := 'P'                 /* ????????????????
END-IF                                      /* ????????????????
*
IF #PANEL = 0
  #PANEL := PRINTER-GENERAL-ATTRIBUTES
END-IF
*
MAIN-LOOP. REPEAT
*
  EOMPRM-I-NAME           := #PRINTER
  EOMPRM-I-ATTRIBUTE-TYPE := #PANEL
*
  DECIDE ON FIRST #FUNC
    VALUE 'A'
      CV-KEY := CV-DESC := (AD=I)
      EOM-FUNCTION := EOM-INIT
      EOMPRM-I-ATTRIBUTE-TYPE := PRINTER-GENERAL-ATTRIBUTES
      #PANEL := PRINTER-GENERAL-ATTRIBUTES
      RESET EOMPRM-ATTR-GENERAL #PRINTER #LANGUAGE
      #FIRST-TIME:= TRUE
    VALUE 'M'
      CV-KEY := (AD=IP)
      IF #PRINTER = #P-ID THRU #P-ID-E
        CV-DESC := (AD=IP)
      END-IF
      EOM-FUNCTION := EOM-READHOLD
    VALUE 'D'
      CV-KEY := CV-MAP := CV-JOBCARDS := CV-DESC := (AD=IP)
      CV-JOBCARDS-PROTECT := TRUE
      EOM-FUNCTION := EOM-READ
    NONE
      G-NATRP-ERC := 9999
      INCLUDE C-ESCAPE
  END-DECIDE
*
  FIND-LOOP. REPEAT
    RESET EOMMSG-PARMS
    CALLNAT 'EOMPRM-N' EOM-PARMS EOMPRM-PARMS EOMMSG-PARMS
*
    IF EOMMSG-NR NE 0
      G-NATRP-ERC := EOMMSG-NR
      G-NATRP-ERT := EOMMSG-TOKEN (1)
      INCLUDE C-ESCAPE
    END-IF
*
    PERFORM READ-PHYSICAL-PRINTER
    MOVE *TIMX TO G-HOLD-TIME
    SCREEN-LOOP. REPEAT
*
      IF #LANGUAGE NE *LANGUAGE
        MOVE G-LANGUAGE TO #LANGUAGE *LANGUAGE
        PERFORM INIT-PFKEYS
        PERFORM SET-PFKEYS
      END-IF
*
      IF #FUNC NE 'D'
        INCLUDE C-HOLD
      END-IF
*
      PERFORM FLIP-DISPLAY
      SET CONTROL 'L'
      SET CONTROL 'WB'
      CALLNAT 'N-HEADER' L-HEADER G-DATE-FORMAT 'RDEFPR1&'
      CALLNAT 'N-HEAD2' EOMPRM-LAST-UPDATE-USER EOMPRM-LAST-UPDATE /*SU2
        #LAST-MOD G-DATE-FORMAT /*SU2
      RESET G-MAP-MODIFIED
*
      PERFORM BEFORE-INPUT
*
      DECIDE ON FIRST #PANEL
        VALUE PRINTER-GENERAL-ATTRIBUTES
          INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
            MARK #MARK2 USING MAP 'RDEFPRG&'
          IF NOT CV-JOBCARDS-PROTECT
            #MARK2 := 10
          ELSE
            #MARK2 := 7
          END-IF
        VALUE PRINTER-SPECIAL-ATTRIBUTES
          PERFORM CHECK-TOP-BOTTOM-MORE-ALL
          PERFORM BUILD-SCREEN
          IF #MARK3 = 0
            #MARK3 := POS(G-DIRECT-COMMAND)
          END-IF
          INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
            MARK #MARK3 USING MAP 'RDEFPRS&'
/*SU34      MARK *G-DIRECT-COMMAND USING MAP 'RDEFPRS&'
          RESET #MARK3
          IF NOT CV-JOBCARDS-PROTECT
            #MARK2 := 10
          ELSE
            #MARK2 := 7
          END-IF
        NONE VALUE
          IGNORE
      END-DECIDE
*
      PERFORM CHECK-MODIFIED
      RESET #ANY-ERROR G-NATRP-ERC G-NATRP-ERT
*
      INCLUDE RPFKVA-C
      INCLUDE C-DIRECT
*
      IF G-PF-FUNC = 'UNDO' OR = 'DO'   /* ???????????????????
        RESET EOM-LOG-FUNCTION         /* ???????????????????
      END-IF                            /* ???????????????????
*
      INCLUDE RPFKED-C
*
      RESET READ-RECORD
*
      IF G-MAP-MODIFIED AND #FUNC NE 'D'
        IF #PANEL = PRINTER-SPECIAL-ATTRIBUTES
          PERFORM GET-VALUES
        END-IF
        PERFORM CHECK-ACTIVE-HELP
        EOMPRM-I-NAME := #PRINTER
        EOMPRM-I-ATTRIBUTE-TYPE := #PANEL
        IF #FUNC = 'A'
          EOM-FUNCTION := EOM-ADD
          READ-RECORD := TRUE
        ELSE
          EOM-FUNCTION := EOM-MODIFY
        END-IF
*
        RESET EOMMSG-PARMS
        CALLNAT 'RGETLIB' EOM-USER-LIBRARY
        COMPRESS EOM-USER-LIBRARY 'U' TO EOM-USER-LIBRARY LEAVING NO
        CALLNAT 'EOMPRM-N' EOM-PARMS EOMPRM-PARMS EOMMSG-PARMS
*
        IF EOMMSG-NR = 0
          IF EOM-FUNCTION = EOM-ADD
            G-NATRP-ERC := 31
            #FUNC := 'M'
            RESET #LANGUAGE
          ELSE
            G-NATRP-ERC := 32
            IF EOMPRM-PARMS.EOMPRM-EXITMEM NE ' '
            AND EOMPRM-PARMS.EOMPRM-EXITLIB = ' '                     /*
              CALLNAT 'RGETLIB' EOMPRM-PARMS.EOMPRM-EXITLIB
              COMPRESS EOMPRM-PARMS.EOMPRM-EXITLIB 'U'
                TO EOMPRM-PARMS.EOMPRM-EXITLIB LEAVING NO
            END-IF
          END-IF
        ELSE
          PERFORM CHECK-ERROR-CODE
          IF EOMMSG-NR = 1079
            IF EOMPRM-EXITLIB NE #OLD-EXITLIB    /* only give error once
            OR EOMPRM-EXITMEM NE #OLD-EXITMEM                         /*
              #OLD-EXITLIB:= EOMPRM-EXITLIB
              #OLD-EXITMEM:= EOMPRM-EXITMEM
              G-NATRP-ERC := EOMMSG-NR
              G-NATRP-ERT := EOMMSG-TEXT
              #MARK2      := 4
              #ANY-ERROR:= TRUE
              ESCAPE TOP
            ELSE
              RESET EOMMSG-NR EOMMSG-TEXT
            END-IF
          END-IF
          IF EOMMSG-NR NE 0
            ESCAPE TOP
          END-IF
        END-IF
*
        INCLUDE C-COMMIT
*
      END-IF
*
      INCLUDE REXDO--C
*
      DECIDE ON FIRST VALUE OF G-PF-FUNC
        VALUE ##PFK-EXIT-SUBFUNC
          IF #PANEL NE PRINTER-GENERAL-ATTRIBUTES
            #PANEL := PRINTER-GENERAL-ATTRIBUTES
            RESET #LANGUAGE
          END-IF
        VALUE ##PFK-UP
          SUBTRACT #MAP-OCC FROM #MAP-IND
          IF #MAP-IND < 1
            #MAP-IND := 1
          END-IF
        VALUE ##PFK-DOWN
          #J := #MAP-IND + #MAP-OCC - 1
          #K := EOMPRM-ATTRIBUTES-OCC - #J
          IF #K < #MAP-OCC
            #MAP-IND := EOMPRM-ATTRIBUTES-OCC - #MAP-OCC + 1
          ELSE
            ADD #MAP-OCC TO #MAP-IND
          END-IF
          IF #MAP-IND > 18
            #MAP-IND := 18
          END-IF
        VALUE ##PFK-ATTRIBUTES
          #PANEL := PRINTER-SPECIAL-ATTRIBUTES
          RESET #LANGUAGE         /* to re-init pf-keys
        VALUE ##PFK-EDIT
          PERFORM EDIT-EXIT
        NONE  IGNORE
      END-DECIDE
*
      IF READ-RECORD = TRUE
        ESCAPE BOTTOM (FIND-LOOP.)
      END-IF
*
    END-REPEAT
  END-REPEAT
END-REPEAT
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE BEFORE-INPUT
************************************************************************
DECIDE ON FIRST #PANEL
  VALUE PRINTER-GENERAL-ATTRIBUTES
    IF #FUNC = 'D' OR (PHYSICAL-PRINTER.PH-JCL-SKELETON = ' '
    AND NOT(PHYSICAL-PRINTER.PH-PRINTER-TYPE = ##PHYS-UNIXLP          /*
    OR=##PHYS-NATUNIX OR=##PHYS-DISKUNIX OR=##PHYS-WRTSPOOL))         /*
      CV-JOBCARDS := (AD=IP)
      CV-JOBCARDS-PROTECT := TRUE
    ELSE
      CV-JOBCARDS := (AD=I)
      CV-JOBCARDS-PROTECT := FALSE
    END-IF
    DECIDE FOR FIRST CONDITION
      WHEN #FIRST-TIME
        #MARK2:= 9
        RESET #FIRST-TIME
      WHEN G-NATRP-ERC = 1079
        #MARK:= 4
      WHEN NOT CV-JOBCARDS-PROTECT
        #MARK2 := 10
      WHEN NONE
        #MARK2 := 7
    END-DECIDE
  NONE VALUE
    IGNORE
END-DECIDE
*
END-SUBROUTINE /* BEFORE-INPUT
*
************************************************************************
DEFINE SUBROUTINE GET-VALUES
************************************************************************
FOR #I 1 #MAP-OCC
  #IX := #MAP-IND + #I - 1
  IF #MAP-VALUE-FROM-COL (#I) = 0
    ESCAPE TOP
  END-IF
  #J := #MAP-VALUE-FROM-COL (#I)
  #K := #MAP-VALUE-TO-COL   (#I)
  #L := #K - #J + 1
  RESET EOMPRM-ATTR-VALUE (#IX)
  EOMPRM-ATTR-VALUE-A1 (#IX,1:#L) := #MAP-LINE-A1 (#I,#J:#K)
  IF PHYSICAL-PRINTER.PH-PRINTER-TYPE = ##PHYS-DISKUNIX               /*
  AND EOMPRM-ATTR-VAR(#IX) = 'SERVICE'   /* SERVER NODE               /*
  AND EOMPRM-ATTR-VALUE(#IX) NE ' '                                   /*
    UXNO. FIND NUMBER UX-NODES WITH UX-NODE-NAME=EOMPRM-ATTR-VALUE (#IX)
    IF *NUMBER (UXNO.) = 0
      UNIX-NODE-NAME := EOMPRM-ATTR-VALUE(#IX)
      CALLNAT 'HRSELUXN' 'U' UNIX-NODE-NAME
      EOMPRM-ATTR-VALUE(#IX) := UNIX-NODE-NAME
    END-IF
  END-IF
END-FOR
*
END-SUBROUTINE /* GET-VALUES
*
************************************************************************
DEFINE SUBROUTINE BUILD-SCREEN
************************************************************************
CALLNAT 'RDEFPR-N' #MAP-IND EOMPRM-ATTRIBUTES (*) #MAP-DYNAMIC (*)
*
END-SUBROUTINE /* BUILD-SCREEN
*
************************************************************************
DEFINE SUBROUTINE CHECK-MODIFIED
************************************************************************
IF CV-MAP MODIFIED OR #ANY-ERROR
  G-MAP-MODIFIED := TRUE
END-IF
*
END-SUBROUTINE /* CHECK-MODIFIED
*
************************************************************************
DEFINE SUBROUTINE CHECK-ACTIVE-HELP
************************************************************************
IF EOMPRM-PHYSICAL-NAME = SCAN '*'
  REINPUT USING HELP MARK *EOMPRM-PHYSICAL-NAME
END-IF
*
END-SUBROUTINE /* CHECK-ACTIVE-HELP
*
************************************************************************
DEFINE SUBROUTINE CHECK-ERROR-CODE
************************************************************************
DECIDE ON FIRST EOMMSG-NR
  VALUE 0
    IGNORE
  VALUE 0002
    IF #PANEL = PRINTER-GENERAL-ATTRIBUTES
      REINPUT *EOMMSG-NR, EOMMSG-TOKEN (1) MARK *EOMPRM-I-NAME
    END-IF
  VALUE 0019
    REINPUT *EOMMSG-NR MARK *#PRINTER
  VALUE 0108, 0130, 0131
    REINPUT *EOMMSG-NR MARK *EOMPRM-PHYSICAL-NAME
  VALUE 0105
    IF EOMMSG-FIELD-NAME = 'EOMPRM-PHYSICAL-NAME'
      REINPUT *EOMMSG-NR MARK *EOMPRM-PHYSICAL-NAME
    END-IF
    REINPUT *EOMMSG-NR MARK *EOMPRM-I-NAME
  VALUE 1079
    IGNORE
  VALUE 1099
    REINPUT *EOMMSG-NR MARK *EOMPRM-RESTRICTED
  NONE VALUE
    #MARK := (EOMMSG-IND1 - #MAP-IND) + 2
    REINPUT *EOMMSG-NR, EOMMSG-TOKEN (1), EOMMSG-TOKEN (2),
      EOMMSG-TOKEN (3) MARK #MARK
*
END-DECIDE
*
END-SUBROUTINE /* CHECK-ERROR-CODE
*
************************************************************************
DEFINE SUBROUTINE READ-PHYSICAL-PRINTER
************************************************************************
IF EOMPRM-PHYSICAL-NAME = #CURRENT-PHYSICAL
  ESCAPE ROUTINE
END-IF
*
IF EOMPRM-PHYSICAL-NAME = ' '
  RESET PHYSICAL-PRINTER #LOCATION
  ESCAPE ROUTINE
END-IF
*
FNDPH. FIND PHYSICAL-PRINTER WITH PH-VTAMID = EOMPRM-PHYSICAL-NAME
  IF NO RECORDS FOUND
    ENTER
  END-NOREC
  #LOCATION := PH-LOCATION
END-FIND
*
#CURRENT-PHYSICAL := EOMPRM-PHYSICAL-NAME
*
END-SUBROUTINE /* READ-PHYSICAL-PRINTER
*
************************************************************************
DEFINE SUBROUTINE CHECK-TOP-BOTTOM-MORE-ALL
************************************************************************
IF #MAP-IND < 1
  #MAP-IND := 1
END-IF
*
#J := EOMPRM-ATTRIBUTES-OCC
*
IF #MAP-IND + #MAP-OCC > #J AND G-C-FUNC = 'D'
  #MAP-IND := #J - #MAP-OCC + 1
END-IF
*
IF #MAP-IND > #J
  #MAP-IND := #J
END-IF
*
#I := #MAP-IND
#K := #J - #I
*
IF #J = 0
  #MAP-IND := 1
  RESET G-NATRP-ERC
ELSE
  DECIDE FOR EVERY CONDITION
    WHEN #K < #MAP-OCC
      RESET #CP                   /* indicate 'bottom of data'
      #END-OF-DATA := TRUE
    WHEN #K >= #MAP-OCC
      RESET #CP #END-OF-DATA      /* indicate 'more ...'
    WHEN #MAP-IND <= 1
      #MAP-IND := 1
      #CP := 1                    /* indicate 'top of data'
      RESET #END-OF-DATA
    WHEN #J <= #MAP-OCC AND #J NE #MAP-IND
      #CP := 1                    /* indicate 'all'
      #END-OF-DATA := TRUE
    WHEN NONE
      IGNORE
  END-DECIDE
*
  INCLUDE C-TOPBOT
*
END-IF
*
END-SUBROUTINE /* CHECK-TOP-BOTTOM-MORE-ALL
*
************************************************************************
DEFINE SUBROUTINE EDIT-EXIT
************************************************************************
IF EOMPRM-EXITMEM = ' '
  G-NATRP-ERC := 4101
  ESCAPE ROUTINE
END-IF
*
PERFORM S-SEPEDT #PROG #POS #POS #A8 #POS #A8 2X EOMPRM-EXITMEM
  EOMPRM-EXITLIB 1X #FUNC #PRINTER #PANEL
*
END-SUBROUTINE /* EDIT-EXIT
*
************************************************************************
DEFINE SUBROUTINE INIT-PFKEYS
************************************************************************
RESET G-PF
*
INCLUDE RPFSTD-C
*
DECIDE ON FIRST #PANEL
  VALUE PRINTER-GENERAL-ATTRIBUTES
    INCLUDE RPFADD-C
    INCLUDE RPFCOM-C
    IF #FUNC NE 'A'
      INCLUDE RPFATT-C
    END-IF
    INCLUDE RPFEDT-C
  VALUE PRINTER-SPECIAL-ATTRIBUTES
    INCLUDE RPFESF-C
    INCLUDE RPFADD-C
    INCLUDE RPFCOM-C
    INCLUDE RPFBRW-C
  NONE
    #PANEL := PRINTER-GENERAL-ATTRIBUTES
END-DECIDE
*
CALLNAT 'RPFINI-N' G-PF G-PFB
*
END-SUBROUTINE
* --------------------------------------- set pfkeys -------------------
INCLUDE RPFSET-C
*
END
