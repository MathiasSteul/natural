* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
***                            NOMDELSU                                       ***
***   Delete subtask parameter record                                         ***
***   Handle with care.                                                       ***
***                                                                           ***
***   Template: NOMDELMO                                                      ***
***                                                                           ***
***   fhi/SAG 01/2017                                                         ***
***                                                                           ***
*********************************************************************************
DEFINE DATA LOCAL
1 SUB VIEW OF NRM-SUBTASK-INFO
  2 ST-SUBTASK-ID
  2 ST-LAST-ACTIVE
  2 ST-STATUS
  2 ST-WAIT-MINIMUM
  2 ST-WAIT-MAXIMUM
  2 ST-WAIT-INCREMENT
  2 ST-WAIT-CURRENT
  2 ST-EXEC-TYPE
  2 ST-MESSAGE-CODE
  2 ST-MESSAGE
  2 ST-PID
  2 ST-LOGFILE
  2 ST-OBJECT-TYPE
  2 ST-OBJECT-TIME
1 #ID                   (A20)
1 #YESNO                (A1)
END-DEFINE
SET KEY ALL
FORMAT LS=180
REPEAT
  INPUT (AD=MIL'_')
    '                         D E L E T E    S U B T A S K   P A R A M E T E R S' / /
    'ID of subtask:' #ID
    / 'End with any PF-key' / '''LIST'' shows all Monitor records.'
  IF *PF-KEY NE 'ENTR'
    ESCAPE ROUTINE
  END-IF
  IF #ID = 'LIST'
    PERFORM SHOW-MONITOR
    ESCAPE TOP
  END-IF
  FIND SUB WITH ST-SUBTASK-ID = #ID
    IF NO RECORDS FOUND
      WRITE NOTITLE NOHDR 'No Monitor parameters found for library ' #ID
      ESCAPE BOTTOM
    END-NOREC
    INPUT NO ERASE (AD=O CD=RE)
      '                         D E L E T E    M O N I T O R   P A R A M E T E R S'
      / / / / / /
      '='  ST-LAST-ACTIVE   40T
      '='  ST-STATUS (EM=H) /
      '='  ST-WAIT-MINIMUM  40T
      '='  ST-WAIT-MAXIMUM  /
      '='  ST-WAIT-INCREMENT 40T
      'Delete (Y/N)' #YESNO (AD=MILT'_')
    IF #YESNO = 'Y' OR = 'y'
      DELETE
      END TRANSACTION
      WRITE NOTITLE NOHDR 'MONITOR set ' #ID ' deleted.'
    ELSE
      WRITE NOTITLE NOHDR 'Nothing happened.'
    END-IF
  END-FIND
END-REPEAT
*
DEFINE SUBROUTINE SHOW-MONITOR
READ SUB BY ST-SUBTASK-ID
  DISPLAY
    'ID'      ST-SUBTASK-ID
    'LAST'    ST-LAST-ACTIVE (EM=YYYYMMDDHHIISS)
    'STAT'    ST-STATUS      (EM=H)
END-READ
END-SUBROUTINE
*
END
