* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RMB2CT-N - Extract chars token (pool-name, pool-index, chars from a
*           given chars line of the sh-print-job-attributes command
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* mrs 95-11-22 s(999999) created
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 RMB2CT-LINE            (A64)
1 REDEFINE RMB2CT-LINE
  2 RMB2CT-LIN           (A1/1:64)
1 RMB2CT-POOL-NAME       (A4)
1 RMB2CT-POOL-INDEX      (A2)
1 RMB2CT-CHARS           (A64)
1 REDEFINE RMB2CT-CHARS
  2 RMB2CT-CHA           (A1/1:64)
************************************************************************
LOCAL
1 FIRST-CHAR             (L)
1 #F                     (I4)
1 #I                     (I4)
1 #J                     (I4)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
EXAMINE RMB2CT-LINE FOR 'POOL-NAME' GIVING POSITION #F
IF #F > 0
  PERFORM IS-CHARS-POOL
ELSE
  PERFORM IS-CHARS-NAME
END-IF
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE IS-CHARS-POOL
************************************************************************
EXAMINE RMB2CT-LIN (#F:64) FOR ':' GIVING INDEX #F
IF #F > 0
  ADD 2 TO #F
  RMB2CT-POOL-NAME := SUBSTR (RMB2CT-LINE, #F, 4)
  EXAMINE RMB2CT-LINE FOR 'POOL-INDEX' GIVING POSITION #F
  IF #F > 0
    EXAMINE RMB2CT-LIN (#F:64) FOR ':' GIVING INDEX #F
    IF #F > 0
      ADD 1 TO #F
      RMB2CT-POOL-INDEX := SUBSTRING (RMB2CT-LINE, #F, 2)
    END-IF
  END-IF
END-IF
*
END-SUBROUTINE /* IS-CHARS-POOL
*
************************************************************************
DEFINE SUBROUTINE IS-CHARS-NAME
************************************************************************
EXAMINE RMB2CT-LINE FOR 'x' GIVING LENGTH #F
*
FOR #I = 1 TO #F
  IF RMB2CT-LIN (#I) = ' '
    FIRST-CHAR := TRUE
  ELSE
    IF FIRST-CHAR AND #J > 0
      ADD 1 TO #J
      RMB2CT-CHA (#J) := ','
    END-IF
    FIRST-CHAR := FALSE
    ADD 1 TO #J
    RMB2CT-CHA (#J) := RMB2CT-LIN (#I)
  END-IF
END-FOR
*
END-SUBROUTINE /* IS-CHARS-NAME
*
END
