* fhi     2015-07-07 NOMALL-1655 Leave copies field as entered
* fhi     2016-08-01 NOMALL-1748 Backout Report Formatting
* fhi     2016-08-12 NOMALL-1620 Add field EOMRPM-REMOTE-NODE-ID
* fhi     2016-09-14 NOMALL-1620 Allow alpha node ids
* SU4     2016-09-28 NOM35 code reworked
* fhi     2016-11-15 NOMALL-1961 Use new task IDs
* fhi     2017-01-17 NOMALL-1620 Fill codepage and check it
* fhi     2017-01-19 NOMALL-1620 Use EOMRPM-INTERNAL-NODE-ID
* SU5     2017-07-18 NOMALL-1823 NOM 3.5: remove SAP
* SU6     2018-01-05 NOM35       change codepage handling(NOMALL-1620)
* SU7     2018-03-15 NOMALL-2085 NOM35 printer:sep.pages
* fhi     2018-10-29 NOMALL-2125 Use codepage at identification only
* SU8     2020-01-30 NOMALL-2379 Unix files A26 -> A50
* SU9     2020-11-10 NOMALL-2440 split DDM -> NRM-MF-NODES
* SU10    2024-03-07 ES-34613    NOM 3.6 Remove power
* ----------------------------------------------------------------------
DEFINE DATA
PARAMETER USING EOM----P
PARAMETER USING EOMRPM-P
PARAMETER USING EOMMSG-P
************************************************************************
LOCAL USING EOMRPM-E
LOCAL USING EOM----E
LOCAL USING EOMGRM-P
LOCAL USING RLOG-L
LOCAL USING VUSARC-L
LOCAL USING EOMPHTYE
LOCAL USING VDEFRP-L
*
LOCAL
1 USERS VIEW OF NRM-USERS
  2 USER-PROFILE
  2 REDEFINE USER-PROFILE
    3 PROF-TYPE (A1)
1 NRM-REPORT VIEW OF NRM-REPORTS-NEW
  2 R-REPNAME
  2 R-MODIFIED-BY
  2 R-LAST-MODIFIED
  2 R-LAST-UPDATE
  2 R-LAST-UPDATE-USER
1 UX-NODES  VIEW OF NRM-UX-NODES
1 PRINTERS VIEW OF NRM-PRINTERS
  2 P-DISP
  2 P-PHYSICAL-NAME
1 PHYSICAL VIEW OF NRM-PHYSICAL-PRINTERS
  2 PH-PRINTER-TYPE
*
1 #NOF                        (I2) CONST <4>
1 #FUNCTION                   (A1/1:#NOF) INIT <'O','P','M','D'>
1 #SECURITY-OPTION            (A3)
1 VALID-MASK                  (L)
1 ALLOWED                     (L)
1 EXIST                       (L)
1 #I                          (P5)
1 #L                          (L)
1 I                           (I2)
1 J                           (I2)
1 F                           (I2)
1 N                           (I2)
1 OT                          (I2)
1 OJ                          (I2)
1 #GRANTS                     (A1/1:6)
1 #USER-ID                    (A8)
1 #OBJECT-NAME                (A25)
1 #DSN-NAME                   (A44)
1 REDEFINE #DSN-NAME
  2 #DSN-PREF                 (A4)
1 #DSNLEN                     (P2)
1 #MAXLEN                     (P2)
1 #T-IN                       (A50)
1 #T-OUT                      (A78)
1 #NEXT-REPORT                (A25)
1 REDEFINE #NEXT-REPORT
  2 #NEXT-REPORT-24           (A24)
  2 #NEXT-REPORT-1            (I1)
1 #USERARC-ID                 (A10)  INIT <'USERARC00'>
1 REDEFINE #USERARC-ID
  2 #USERARC-FIXED            (A8)
  2 #USERARC-NUMBER           (A1)
1 #LUX                        (L)
1 #READ-PRINTER               (L)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET EOMMSG-PARMS
*
PERFORM SECURITY-CHECK
IF EOMMSG-NR NE 0 OR EOMRPM-EOF = 'X'
  ESCAPE ROUTINE
END-IF
*
PERFORM LOGGING-CHECK
*
IF EOM-FUNCTION NE EOM-SECURITY-CHECK
  EOMRPM-I-CHECK-FUNCTION := EOM-FUNCTION
  PERFORM FUNCTION-SECURITY
  IF EOMMSG-NR NE 0
    ESCAPE ROUTINE
  END-IF
END-IF
*
DECIDE ON FIRST EOM-FUNCTION
  VALUE EOM-SECURITY-CHECK  PERFORM FUNCTION-SECURITY
  VALUE EOM-INIT            PERFORM INIT-REPORT-ATTRIBUTES
  VALUE EOM-ADD, EOM-MODIFY PERFORM MODIFY-REPORT-ATTRIBUTES
  VALUE EOM-DELETE          PERFORM DELETE-REPORT
  VALUE EOM-COPY            PERFORM COPY-REPORT
  VALUE EOM-RENAME          PERFORM RENAME-REPORT
  VALUE EOM-READ, EOM-READHOLD, EOM-READ-NEXT, EOM-READHOLD-NEXT
    PERFORM READ-REPORT-ATTRIBUTES
  VALUE EOM-COMMIT
    RESET EOM-LOG-FUNCTION EOM-LOG-OBJECT-NAME
    END OF TRANSACTION
  VALUE EOM-BACKOUT
    RESET EOM-LOG-FUNCTION EOM-LOG-OBJECT-NAME
    BACKOUT TRANSACTION
  NONE VALUE
    EOMMSG-NR := 2600
END-DECIDE
*
IF EOM-LOG AND EOMMSG-NR = 0
  PERFORM WRITE-LOG-RECORD
END-IF
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE WRITE-LOG-RECORD
************************************************************************
IF EOM-LOG-FUNCTION =EOM-FUNCTION AND EOM-LOG-OBJECT-NAME =EOMRPM-I-NAME
  ESCAPE ROUTINE
END-IF
*
DECIDE ON FIRST EOM-FUNCTION
  VALUE EOM-ADD
    LG-OBJECT-NAME := EOMRPM-I-NAME
    COMPRESS '2500' EOMRPM-I-NAME TO LG-MSG
    RESET  EOM-LOG-OBJECT-NAME
  VALUE EOM-MODIFY
    LG-OBJECT-NAME := EOMRPM-I-NAME
    COMPRESS '2501' EOMRPM-I-NAME TO LG-MSG
    EOM-LOG-OBJECT-NAME := EOMRPM-I-NAME
  VALUE EOM-DELETE
    LG-OBJECT-NAME := EOMRPM-I-NAME
    COMPRESS '2502' EOMRPM-I-NAME TO LG-MSG
    RESET  EOM-LOG-OBJECT-NAME
  VALUE EOM-RENAME
    LG-OBJECT-NAME:=EOMRPM-I-NEWNAME
    COMPRESS '2503' EOMRPM-I-NAME EOMRPM-I-NEWNAME TO LG-MSG
    RESET  EOM-LOG-OBJECT-NAME
  VALUE EOM-COPY
    LG-OBJECT-NAME:=EOMRPM-I-NEWNAME
    COMPRESS '2504' EOMRPM-I-NAME EOMRPM-I-NEWNAME TO LG-MSG
    RESET  EOM-LOG-OBJECT-NAME
  ANY VALUE
    EOM-LOG-FUNCTION := EOM-FUNCTION
    LG-USERID        := EOM-USER
    LG-CODE          := 'RM'
    LG-REPNAME       := EOMRPM-I-NAME
    CALLNAT 'RLOG' PL-PARMS
  NONE IGNORE
END-DECIDE
*
END-SUBROUTINE /* WRITE-LOG-RECORD
*
************************************************************************
DEFINE SUBROUTINE LOGGING-CHECK
************************************************************************
IF EOM-LOG-OBJTYP = 'R'
  ESCAPE ROUTINE
END-IF
RESET  EOM-LOGGING
EOM-LOG-OBJTYP := 'R'
IF EOM-LOG-TYPES (*) = 'R'
  EOM-LOG := TRUE
END-IF
*
END-SUBROUTINE /* LOGGING-CHECK
*
************************************************************************
DEFINE SUBROUTINE SECURITY-CHECK
************************************************************************
IF EOM-OBJTYP NE 'R'
  IF EOM-USER = ' ' AND EOM-USER-TYPE NE 'A'
    EOMMSG-NR := 48
    EOMMSG-FIELD-NAME := 'EOM-USER'
    ESCAPE ROUTINE
  END-IF
  IF EOM-USER-TYPE NE 'A'
    FNDUS. FIND USERS WITH USER-ID = EOM-USER
      IF NO RECORDS FOUND
        IF EOM-DEF-USER NE 'Y'
          EOMMSG-NR := 2
          EOMMSG-TOKEN(1) := EOM-USER
          EOMMSG-FIELD-NAME := 'EOM-USER'
          ESCAPE ROUTINE
        ELSE
          FIND USERS WITH USER-ID = 'DEFAULT'
            EOM-USER-PROFILE := USER-PROFILE
            EOM-USER-TYPE := PROF-TYPE
          END-FIND
          ESCAPE BOTTOM (FNDUS.)
        END-IF
      END-NOREC
      EOM-USER-PROFILE := USER-PROFILE
      EOM-USER-TYPE := PROF-TYPE
    END-FIND
  END-IF
  EOM-OBJTYP := 'R'
  IF EOM-USER-TYPE = 'A'
    EOM-OBJTYP-SECURITY (*) := 'Y'
  ELSE
    EOM-OBJTYP-SECURITY (*) := 'N'
    FOR I = 2 TO 4
      COMPRESS #FUNCTION (I) 'RP' TO #SECURITY-OPTION LEAVING NO
      RESET ALLOWED
      CALLNAT 'NARPSEC' EOM-USER-PROFILE #SECURITY-OPTION ALLOWED
      IF ALLOWED
        EOM-OBJTYP-SECURITY (I:6) := 'Y'
        ESCAPE BOTTOM
      END-IF
    END-FOR
  END-IF
  RESET EOM-OBJECT-NAME EOM-OBJECT-SECURITY (*)
END-IF
*
IF NOT (EOM-OBJTYP-SECURITY (*) = 'Y')
  EOMMSG-NR := 0020
  ESCAPE ROUTINE
END-IF
*
IF EOM-FUNCTION = EOM-INIT OR = EOM-ADD
  EOM-OBJECT-NAME := EOMRPM-I-NAME
  EOM-OBJECT-SECURITY (*) := EOM-OBJTYP-SECURITY (*)
  IF EOM-OBJTYP-SECURITY (2) = 'Y' OR EOM-OBJTYP-SECURITY (3) = 'Y'
    EOM-OBJECT-SECURITY (1) := 'Y'
  ELSE
    EOM-OBJECT-SECURITY (1) := 'N'
  END-IF
END-IF
*
RESET EOMRPM-EOF
IF EOM-FUNCTION = EOM-READ-NEXT OR = EOM-READHOLD-NEXT
  IF EOM-FUNCTION = EOM-READ-NEXT AND
      NOT (EOM-OBJTYP-SECURITY(1:4) = 'Y') OR
      EOM-FUNCTION = EOM-READHOLD-NEXT AND
      NOT (EOM-OBJTYP-SECURITY(1:3) = 'Y')
    EOMMSG-NR := 0020
    ESCAPE ROUTINE
  END-IF
  RESET EOM-OBJECT-NAME EOMRPM-EOF
  EOMRPM-EOF := 'X'
  #NEXT-REPORT := EOMRPM-I-NAME
  ADD 1 TO #NEXT-REPORT-1
  READ NRM-REPORT WITH R-REPNAME = #NEXT-REPORT
    IF EOM-USER-TYPE = 'A'
      EOM-OBJECT-SECURITY (*) := 'Y'
      RESET EOMRPM-EOF
    ELSE
      #USER-ID := EOM-USER
      CALLNAT 'RGRANT-N'  /*  GET USER ACCESS LEVEL ON AN OBJECT
        #USER-ID EOM-OBJTYP R-REPNAME ALLOWED #GRANTS (*)
      IF ALLOWED AND (EOM-FUNCTION = EOM-READ-NEXT AND #GRANTS(1:4) ='Y'
      OR EOM-FUNCTION = EOM-READHOLD-NEXT AND #GRANTS(1:3) = 'Y')     /*
        EOM-OBJECT-SECURITY (1)   := #GRANTS (1)     /* owner
        EOM-OBJECT-SECURITY (2)   := #GRANTS (3)      /* purge
        EOM-OBJECT-SECURITY (3)   := #GRANTS (2)     /* modify
        EOM-OBJECT-SECURITY (4:6) := #GRANTS (4:6)          /* display
        RESET EOMRPM-EOF
      END-IF
    END-IF
    IF EOMRPM-EOF = ' '
      EOM-OBJECT-NAME := EOMRPM-I-NAME := R-REPNAME
      EOM-OBJECT-NAME := EOMRPM-I-NAME := R-REPNAME
      ESCAPE BOTTOM
    END-IF
  END-READ
END-IF
*
IF EOM-OBJECT-NAME NE EOMRPM-I-NAME AND EOMRPM-EOF = ' '
  EOM-OBJECT-NAME := EOMRPM-I-NAME
  IF EOM-USER-TYPE = 'A'
    EOM-OBJECT-SECURITY (*) := 'Y'
  ELSE
    EOM-OBJECT-SECURITY (*) := 'N'
    #USER-ID := EOM-USER
    CALLNAT 'RGRANT-N'  /*  GET USER ACCESS LEVEL ON AN OBJECT
      #USER-ID EOM-OBJTYP EOMRPM-I-NAME ALLOWED #GRANTS (*)
    EOM-OBJECT-SECURITY (1)   := #GRANTS (1)     /* owner
    EOM-OBJECT-SECURITY (2)   := #GRANTS (3)     /* purge
    EOM-OBJECT-SECURITY (3)   := #GRANTS (2)     /* modify
    EOM-OBJECT-SECURITY (4:6) := #GRANTS (4:6)          /* display ...
  END-IF
END-IF
*
IF NOT (EOM-OBJECT-SECURITY (*) = 'Y') AND EOMRPM-EOF = ' '
    AND EOMRPM-I-NAME NE ' '
  EOMMSG-NR := 0020
END-IF
*
END-SUBROUTINE /* SECURITY-CHECK
*
************************************************************************
DEFINE SUBROUTINE FUNCTION-SECURITY
************************************************************************
EXAMINE EOM-OBJECT-SECURITY (*) FOR 'Y' GIVING INDEX IN OJ
EXAMINE EOM-OBJTYP-SECURITY (*) FOR 'Y' GIVING INDEX IN OT
*
DECIDE ON FIRST EOMRPM-I-CHECK-FUNCTION
  VALUE EOM-SECURITY-CHECK, EOM-COMMIT, EOM-BACKOUT
    IGNORE
  VALUE EOM-ADD, EOM-READHOLD, EOM-READHOLD-NEXT, EOM-MODIFY,
      EOM-INIT, EOM-COPY, EOM-RENAME
    IF OJ > 3 OR OT > 3
      EOMMSG-NR := 0020
    END-IF
  VALUE EOM-READ, EOM-READ-NEXT
    IF OJ > 4 OR OT > 4
      EOMMSG-NR := 0020
    END-IF
  VALUE EOM-DELETE
    IF OJ > 2 OR OT > 2
      EOMMSG-NR := 0020
    END-IF
  NONE VALUE
    EOMMSG-NR := 2600
END-DECIDE
*
END-SUBROUTINE /* FUNCTION-SECURITY
*
************************************************************************
DEFINE SUBROUTINE READ-REPORT-ATTRIBUTES
************************************************************************
PERFORM VALIDATE-KEY
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
*
PERFORM REPORT-ATTRIBUTE-INTERFACE
*
END-SUBROUTINE /* READ-REPORT-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE INIT-REPORT-ATTRIBUTES
************************************************************************
PERFORM REPORT-ATTRIBUTE-INTERFACE
*
END-SUBROUTINE /* INIT-REPORT-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE MODIFY-REPORT-ATTRIBUTES
************************************************************************
PERFORM VALIDATE-KEY
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
*
PERFORM VALIDATION
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
*
PERFORM REPORT-ATTRIBUTE-INTERFACE
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
FND. FIND NRM-REPORT WITH R-REPNAME = EOMRPM-I-NAME
  R-LAST-MODIFIED := R-LAST-UPDATE      := *TIMX
  R-MODIFIED-BY   := R-LAST-UPDATE-USER := EOM-USER
  UPDATE (FND.)
END-FIND
*
IF EOM-FUNCTION = EOM-ADD
  EOMGRM-I-NAME := EOMRPM-I-NAME
  EOMGRM-I-TYPE := 'R'
  EOMGRM-I-USER := EOM-USER
  EOMGRM-I-DEF-USER := EOM-DEF-USER
  EOMGRM-OPTION (*) := 'Y'
  CALLNAT 'EOMGRM-N' EOM-ADD EOMGRM-PARMS EOMMSG-PARMS /*Grant
END-IF
*
END-SUBROUTINE /* MODIFY-REPORT-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE VALIDATION
************************************************************************
DECIDE ON FIRST EOMRPM-I-ATTRIBUTE-TYPE
  VALUE REPORT-GENERAL-ATTRIBUTES
    PERFORM VALIDATE-GENERAL-ATTRIBUTES
  VALUE REPORT-DISTRIBUTION-ATTRIBUTES
    PERFORM VALIDATE-DISTRIBUTION-ATTRIBUTES
  VALUE REPORT-PRINTING-ATTRIBUTES
    PERFORM VALIDATE-PRINTING-ATTRIBUTES
  VALUE REPORT-ADDITIONAL-PRINTERS
    PERFORM VALIDATE-PRINTERS
  VALUE REPORT-SEPARATION-ATTRIBUTES
    PERFORM VALIDATE-SEPARATION-ATTRIBUTES
  VALUE REPORT-JES-ATTRIBUTES
    PERFORM VALIDATE-JES-ATTRIBUTES
  VALUE REPORT-NAF-ATTRIBUTES
    PERFORM VALIDATE-NAF-ATTRIBUTES
  VALUE REPORT-BS2-ATTRIBUTES
    PERFORM VALIDATE-BS2-ATTRIBUTES
  VALUE REPORT-UNIX-ATTRIBUTES
    PERFORM VALIDATE-UNIX-ATTRIBUTES
  VALUE REPORT-UNIX-NODE
    PERFORM VALIDATE-UNIX-NODE
/*SU10  VALUE REPORT-POWER-ATTRIBUTES PERFORM VALIDATE-POWER-ATTRIBUTES
  VALUE REPORT-NOMUSR-ATTRIBUTES
    PERFORM VALIDATE-NOMUSR-ATTRIBUTES
  NONE  IGNORE
END-DECIDE
*
END-SUBROUTINE /* VALIDATION
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-KEY
************************************************************************
IF EOMRPM-I-NAME = ' '
  EOMMSG-NR := 0305
  EOMMSG-FIELD-NAME := 'EOMRPM-I-NAME'
  ESCAPE ROUTINE
END-IF
*
MOVE LEFT JUSTIFIED EOMRPM-I-NAME TO EOMRPM-I-NAME
IF EOMRPM-I-NAME NE MASK (P................)
  EOMMSG-NR := 0019
  EOMMSG-FIELD-NAME := 'EOMRPM-I-NAME'
  ESCAPE ROUTINE
END-IF
*
END-SUBROUTINE /* VALIDATE-KEY
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-GENERAL-ATTRIBUTES
************************************************************************
IF NOT (EOMRPM-STORE-IN-DIRECTORY-FILE = 'Y' OR = 'N')
  EOMMSG-NR := 1099
  EOMMSG-FIELD-NAME := 'EOMRPM-STORE-IN-DIRECTORY-FILE'
  ESCAPE ROUTINE
END-IF
IF NOT (EOMRPM-REPORT-TYPE = 'C' OR = 'M' OR = 'S' OR = 'D')
  EOMMSG-NR := 1103
  EOMMSG-FIELD-NAME := 'EOMRPM-REPORT-TYPE'
  ESCAPE ROUTINE
END-IF
IF EOMRPM-REPORT-TYPE = 'C' AND EOM-FUNCTION = EOM-ADD
  EOMMSG-NR := 1102
  EOMMSG-FIELD-NAME := 'EOMRPM-REPORT-TYPE'
  ESCAPE ROUTINE
END-IF
IF EOMRPM-MASTER-OWNER = ' '
  EOMRPM-MASTER-OWNER := EOM-USER
ELSE
  IF EOMRPM-DEF-OWNER NE 'Y'
    CALLNAT 'RCHKUS' EOMRPM-MASTER-OWNER EXIST /*CHECK IF A USERID EXIST
    IF NOT EXIST
      EOMMSG-NR := 0002
      EOMMSG-TOKEN (1) := EOMRPM-MASTER-OWNER
      EOMMSG-FIELD-NAME := 'EOMRPM-MASTER-OWNER'
      ESCAPE ROUTINE
    END-IF
  END-IF
END-IF
*
IF EOMRPM-REV-NUMBER = 0
AND ( EOMRPM-REV-FACTOR NE ' ' OR EOMRPM-REV-CALENDAR NE ' ' )        /*
  EOMMSG-NR := 0415
  EOMMSG-FIELD-NAME := 'EOMRPM-REV-NUMBER'
  ESCAPE ROUTINE
END-IF
IF EOMRPM-REV-NUMBER > 0
  IF EOMRPM-REV-CALENDAR NE ' '
    CALLNAT 'RCHKCA' EOMRPM-REV-CALENDAR EXIST
    IF NOT EXIST
      EOMMSG-NR := 2004
      EOMMSG-FIELD-NAME := 'EOMRPM-REV-CALENDAR'
      ESCAPE ROUTINE
    END-IF
    EOMRPM-REV-FACTOR := 'W'
  END-IF
  IF NOT (EOMRPM-REV-FACTOR = 'W' OR = 'A' OR = 'V' OR = 'M')
    EOMMSG-NR := 1087
    EOMMSG-FIELD-NAME := 'EOMRPM-REV-FACTOR'
    ESCAPE ROUTINE
  END-IF
  IF EOMRPM-REV-FACTOR = 'W' AND EOMRPM-REV-CALENDAR = ' '
    RESET EOMRPM-REV-FACTOR
    EOMMSG-NR := 2003
    EOMMSG-FIELD-NAME := 'EOMRPM-REV-CALENDAR'
    ESCAPE ROUTINE
  END-IF
END-IF
*
IF EOMRPM-RET-NUMBER = 0
AND (EOMRPM-RET-FACTOR NE ' ' OR EOMRPM-RET-CALENDAR NE ' ' )         /*
  EOMMSG-NR := 0415
  EOMMSG-FIELD-NAME := 'EOMRPM-RET-NUMBER'
  ESCAPE ROUTINE
END-IF
IF EOMRPM-RET-NUMBER > 0
  IF EOMRPM-RET-CALENDAR NE ' '
    CALLNAT 'RCHKCA' EOMRPM-RET-CALENDAR EXIST
    IF NOT EXIST
      EOMMSG-NR := 2004
      EOMMSG-FIELD-NAME := 'EOMRPM-RET-CALENDAR'
      ESCAPE ROUTINE
    END-IF
    EOMRPM-RET-FACTOR := 'W'
  END-IF
  IF NOT (EOMRPM-RET-FACTOR = 'W' OR = 'A' OR = 'V' OR = 'M' OR = 'G')
    EOMMSG-NR := 1087
    EOMMSG-FIELD-NAME := 'EOMRPM-RET-FACTOR'
    ESCAPE ROUTINE
  END-IF
  IF EOMRPM-RET-FACTOR = 'G'
    RESET EOMRPM-RET-CALENDAR
  END-IF
  IF EOMRPM-RET-FACTOR = 'W' AND EOMRPM-RET-CALENDAR = ' '
    RESET EOMRPM-RET-FACTOR
    EOMMSG-NR := 2003
    EOMMSG-FIELD-NAME := 'EOMRPM-RET-CALENDAR'
    ESCAPE ROUTINE
  END-IF
END-IF
IF NOT (EOMRPM-RET-ACTION = 'A' OR = 'P')
  EOMMSG-NR := 1088
  EOMMSG-FIELD-NAME := 'EOMRPM-RET-ACTION'
  ESCAPE ROUTINE
END-IF
IF NOT (EOMRPM-ARCHIVE = 'Y' OR = 'N' OR = 'I')
  EOMMSG-NR := 1107
  EOMMSG-FIELD-NAME := 'EOMRPM-ARCHIVE'
  ESCAPE ROUTINE
END-IF
IF EOMRPM-ARC-NUMBER = 0
  RESET EOMRPM-ARC-FACTOR
ELSE
  IF NOT (EOMRPM-ARC-FACTOR = 'D' OR = 'W' OR = 'M' OR = 'Y')
    EOMMSG-NR := 1083
    EOMMSG-FIELD-NAME := 'EOMRPM-ARC-FACTOR'
    ESCAPE ROUTINE
  END-IF
END-IF
IF EOMRPM-ARCHIVE-TYPE NE ' ' AND EOMRPM-ARCHIVE-TYPE NE '0'
  IF EOMRPM-ARCHIVE-TYPE LT '0' OR EOMRPM-ARCHIVE-TYPE GT '9'
    EOMMSG-NR := 1109
    EOMMSG-FIELD-NAME := 'EOMRPM-ARCHIVE-TYPE'
    ESCAPE ROUTINE
  END-IF
  #USERARC-NUMBER:= EOMRPM-ARCHIVE-TYPE
  FIND NUMBER NRM-USER-DEFINED-ARCHIVE WITH M-MONITOR-ID = #USERARC-ID
  IF *NUMBER = 0
    EOMMSG-NR := 1108
    EOMMSG-FIELD-NAME := 'EOMRPM-ARCHIVE-TYPE'
    ESCAPE ROUTINE
  END-IF
END-IF
*
END-SUBROUTINE /* VALIDATE-GENERAL-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-DISTRIBUTION-ATTRIBUTES
************************************************************************
FOR I = 1 TO 10
  IF EOMRPM-EOM-USER-LIST (I) = ' '
    RESET EOMRPM-EOM-DIST (I)
    ESCAPE TOP
  END-IF
  EXAMINE FULL VALUE OF EOMRPM-EOM-USER-LIST (*) FOR
    FULL VALUE OF EOMRPM-EOM-USER-LIST (I) GIVING NUMBER IN F
  IF F > 1
    EOMMSG-NR := 1091
    EOMMSG-TOKEN (1) := EOMRPM-EOM-USER-LIST (I)
    EOMMSG-FIELD-NAME := 'EOMRPM-EOM-USER-LIST'
    EOMMSG-IND1 := I
    ESCAPE ROUTINE
  END-IF
  /* CHECK IF AN ADDRESSEE IN A DISTRIBUTION LIST IS DEFINED:
  IF EOMRPM-DEF-EOM-USER-LIST (I) NE 'Y'
    CALLNAT 'RCHKUL' EOMRPM-EOM-USER-LIST (I) EXIST
    IF NOT EXIST
      EOMMSG-NR := 0002
      EOMMSG-TOKEN (1) := EOMRPM-EOM-USER-LIST (I)
      EOMMSG-FIELD-NAME := 'EOMRPM-EOM-USER-LIST'
      EOMMSG-IND1 := I
      ESCAPE ROUTINE
    END-IF
  END-IF
*
  FOR J = 1 TO 10
    DECIDE FOR FIRST CONDITION
      WHEN EOMRPM-LAYOUT-COLFROM(I,J) > 0 AND EOMRPM-LAYOUT-COLTO(I,J)=0
        EOMMSG-NR := 1086
        EOMMSG-FIELD-NAME := 'EOMRPM-LAYOUT-COLTO'
      WHEN EOMRPM-LAYOUT-COLTO(I,J) > 0 AND EOMRPM-LAYOUT-COLFROM(I,J)=0
        EOMMSG-NR := 1085
        EOMMSG-FIELD-NAME := 'EOMRPM-LAYOUT-COLFROM'
      WHEN EOMRPM-LAYOUT-COLFROM (I,J) > EOMRPM-LAYOUT-COLTO (I,J)
        EOMMSG-NR := 1084
        EOMMSG-FIELD-NAME := 'EOMRPM-LAYOUT-COLFROM'
      WHEN ANY
        EOMMSG-IND1 := I
        EOMMSG-IND2 := J
        ESCAPE ROUTINE
      WHEN NONE IGNORE
    END-DECIDE
  END-FOR
END-FOR
*
END-SUBROUTINE /* VALIDATE-DISTRIBUTION-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-PRINTING-ATTRIBUTES
************************************************************************
IF NOT (EOMRPM-HOLD-PRINT = ' ' OR = 'H' OR = 'C' OR = 'R')
  EOMMSG-NR := 1089
  EOMMSG-FIELD-NAME := 'EOMRPM-HOLD-PRINT'
  ESCAPE ROUTINE
END-IF
IF NOT(EOMRPM-SEPARATOR-START =' ' OR ='NONE' OR='KEIN' OR=MASK('RS'))
  EOMMSG-NR := 0423
  EOMMSG-FIELD-NAME := 'EOMRPM-SEPARATOR-START'
  ESCAPE ROUTINE
END-IF
IF NOT(EOMRPM-SEPARATOR-END =' ' OR ='NONE' OR='KEIN' OR=MASK('RS'))
  EOMMSG-NR := 0423
  EOMMSG-FIELD-NAME := 'EOMRPM-SEPARATOR-END'
  ESCAPE ROUTINE
END-IF
FOR I = 1 TO 20
  RESET #READ-PRINTER
  IF EOMRPM-PRINTER (I) = ' '
    RESET EOMRPM-COPIES (I) EOMRPM-SEP-PAGES (I)
    ESCAPE TOP
  END-IF
  EXAMINE FULL VALUE OF EOMRPM-PRINTER(*) FOR FULL VALUE
    OF EOMRPM-PRINTER (I) GIVING NUMBER IN N
  IF N > 1
    EOMMSG-NR := 0104          /* printer already defined
    ESCAPE BOTTOM
  END-IF
  CALLNAT 'RCHKPRT' EOMRPM-PRINTER (I) EXIST /*exist printer ?
  IF NOT EXIST
    EOMMSG-NR := 0108
    ESCAPE BOTTOM
  END-IF
  IF EOM-USER-TYPE NE 'A'
    #USER-ID := EOM-USER
    #OBJECT-NAME := EOMRPM-PRINTER (I)
    /* GET USER ACCESS LEVEL ON AN OBJECT:
    CALLNAT 'RGRANT-N' #USER-ID 'P' #OBJECT-NAME ALLOWED #GRANTS (*)
    IF ALLOWED AND NOT #GRANTS(*) = 'Y'
      FIND PRINTERS WITH P-ID = #OBJECT-NAME
        IF P-DISP = 'Y'
          RESET ALLOWED
          #READ-PRINTER := TRUE
        END-IF
      END-FIND
    END-IF
    IF NOT ALLOWED
      EOMMSG-NR := 1090
      ESCAPE BOTTOM
    END-IF
    PERFORM CHECK-PRINTER-TYPE
    IF EOMMSG-NR NE 0
      ESCAPE BOTTOM
    END-IF
  END-IF
END-FOR
IF EOMMSG-NR NE 0
  EOMMSG-TOKEN (1)  := EOMRPM-PRINTER (I)
  EOMMSG-FIELD-NAME := 'EOMRPM-PRINTER'
  EOMMSG-IND1       := I
END-IF
*
END-SUBROUTINE /* VALIDATE-PRINTING-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE CHECK-PRINTER-TYPE
************************************************************************
IF NOT #READ-PRINTER
  FIND PRINTERS WITH P-ID = EOMRPM-PRINTER (I)
  END-FIND
ELSE
  FIND PHYSICAL WITH PH-VTAMID = PRINTERS.P-PHYSICAL-NAME
    IF *MACHINE-CLASS = 'MAINFRAME'
      IF PH-PRINTER-TYPE = ##PHYS-NATUNIX
        EOMMSG-NR := 0130
      END-IF
    ELSE
      IF NOT (PH-PRINTER-TYPE = ##PHYS-NATUNIX OR = ##PHYS-DISKUNIX)
        EOMMSG-NR := 0131
      END-IF
    END-IF
  END-FIND
END-IF
*
END-SUBROUTINE /* CHECK-PRINTER-TYPE
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-SEPARATION-ATTRIBUTES
************************************************************************
IF EOM-FUNCTION = EOM-ADD
  PERFORM READ-REPORT-DEFAULTS
END-IF
DECIDE ON FIRST EOMRPM-EXIT-STANDARD
  VALUE 01 PERFORM VALIDATE-STD1-ATTRIBUTES
  VALUE 02 PERFORM VALIDATE-STD2-ATTRIBUTES
  VALUE 03 PERFORM VALIDATE-STD3-ATTRIBUTES
  ANY
    IF *PF-KEY NE 'PF3' AND *PF-KEY NE 'PF9'
    AND EOMRPM-STD1-IDENT-LINE =0 AND EOMRPM-STD1-IDENT-STRING =' '   /*
    AND EOMRPM-STD2-IDENT-LINE =0 AND EOMRPM-STD2-IDENT-STRING =' '   /*
    AND EOMRPM-STD3-IDENT-LINE =0 AND EOMRPM-STD3-IDENT-STRING =' '   /*
      EOMMSG-NR := 0657
      EOMMSG-FIELD-NAME := 'EOMRPM-STD1-IDENT-STRING'
    END-IF
    RESET EOMRPM-EXIT-USER-NATPGM EOMRPM-EXIT-USER-NATLIB
      EOMRPM-EXIT-USER-3GL
  NONE
    IF EOMRPM-EXIT-STANDARD = 4 THRU 99
      EOMMSG-NR := 0658
      EOMMSG-FIELD-NAME := 'EOMRPM-EXIT-STANDARD'
    END-IF
    RESET EOMRPM-EXIT-STANDARD
    PERFORM VALIDATE-USEREXIT-ATTRIBUTES
END-DECIDE
IF NOT(EOMRPM-CREATE-DEFINITION = ' ' OR = 'Y' OR = 'N')
AND EOMRPM-EXIT-STANDARD = 0 AND EOMRPM-EXIT-USER-NATPGM = ' '        /*
AND EOMRPM-EXIT-USER-3GL = ' '                                        /*
  EOMMSG-NR := 1099
  EOMMSG-FIELD-NAME := 'EOMRPM-CREATE-DEFINITION'
  ESCAPE ROUTINE
END-IF
IF NOT(EOMRPM-CREATE-DEFINITION = 'Y' OR = 'N')
AND (EOMRPM-EXIT-STANDARD NE 0                                        /*
OR EOMRPM-EXIT-USER-NATPGM NE ' ' OR EOMRPM-EXIT-USER-3GL NE ' ')     /*
  EOMMSG-NR := 1099
  EOMMSG-FIELD-NAME := 'EOMRPM-CREATE-DEFINITION'
  ESCAPE ROUTINE
END-IF
*
END-SUBROUTINE /* VALIDATE-SEPARATION-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE READ-REPORT-DEFAULTS
************************************************************************
REPORT-DEFAULTS.M-MONITOR-ID := F#MONITOR-TASK-ID1 (<>)
FIND REPORT-DEFAULTS WITH M-MONITOR-ID = REPORT-DEFAULTS.M-MONITOR-ID
  EOMRPM-CREATE-DEFINITION := R-CREATE-DEFINITION
END-FIND
*
END-SUBROUTINE /*READ-REPORT-DEFAULTS
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-STD1-ATTRIBUTES
************************************************************************
DECIDE FOR FIRST CONDITION
  WHEN EOMRPM-STD1-IDENT-STRING = ' ' AND EOMRPM-STD1-IDENT-LINE  = 0
    RESET EOMRPM-STD1
  WHEN EOMRPM-STD1-IDENT-STRING = ' '
    EOMMSG-NR := 0651
    EOMMSG-FIELD-NAME := 'EOMRPM-STD1-IDENT-STRING'
  WHEN EOMRPM-STD1-IDENT-STRING NE ' '
    #T-IN  := EOMRPM-STD1-IDENT-STRING
    #T-OUT := 'VALIDATE'    /* check for correct Natural mask
    /* build ident string for Standard separation routines:
    CALLNAT 'RMEXMSKN' #T-IN #T-OUT
    IF #T-OUT = H'FF'
      EOMMSG-NR := 0667
      EOMMSG-FIELD-NAME := 'EOMRPM-STD1-IDENT-STRING'
    END-IF
  WHEN EOMRPM-STD1-BREAK-START = 0
    EOMMSG-NR := 0653
    EOMMSG-FIELD-NAME := 'EOMRPM-STD1-BREAK-START'
  WHEN EOMRPM-STD1-BREAK-END   = 0
    EOMMSG-NR := 0653
    EOMMSG-FIELD-NAME := 'EOMRPM-STD1-BREAK-END'
  WHEN EOMRPM-STD1-BREAK-START > EOMRPM-STD1-BREAK-END
    EOMMSG-NR := 0654
    EOMMSG-FIELD-NAME := 'EOMRPM-STD1-BREAK-START'
  WHEN EOMRPM-STD1-REPORT-PREFIX = ' '
    EOMMSG-NR := 0655
    EOMMSG-FIELD-NAME := 'EOMRPM-STD1-REPORT-PREFIX'
  WHEN NONE
    IGNORE
END-DECIDE
*
END-SUBROUTINE /* VALIDATE-STD1-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-STD2-ATTRIBUTES
************************************************************************
IF EOMRPM-STD2-IDENT-LINE = 0 AND EOMRPM-STD2-IDENT-STRING = ' '
AND NOT (EOMRPM-STD2-BREAK-LINE  (*) NE 0)                            /*
AND NOT (EOMRPM-STD2-BREAK-START (*) NE 0)                            /*
AND NOT (EOMRPM-STD2-BREAK-END   (*) NE 0)                            /*
  RESET EOMRPM-STD2
  ESCAPE ROUTINE
END-IF
*
IF EOMRPM-STD2-IDENT-STRING = ' '
  EOMMSG-NR := 0651
  EOMMSG-FIELD-NAME := 'EOMRPM-STD2-IDENT-STRING'
  ESCAPE ROUTINE
END-IF
#T-IN  := EOMRPM-STD2-IDENT-STRING
#T-OUT := 'VALIDATE'    /* check for correct Natural mask
/* build ident string for Standard separation routines:
CALLNAT 'RMEXMSKN' #T-IN #T-OUT
IF #T-OUT = H'FF'
  EOMMSG-NR := 0667
  EOMMSG-FIELD-NAME := 'EOMRPM-STD2-IDENT-STRING'
END-IF
*
RESET J
FOR I = 1 TO 5
  IF EOMRPM-STD2-BREAK-START (I)=0 AND EOMRPM-STD2-BREAK-END (I)=0
  AND EOMRPM-STD2-BREAK-LINE (I)=0 AND EOMRPM-STD2-REPORT-PREFIX (I)=' '
    RESET EOMRPM-STD2-TAB (I)
    ESCAPE TOP
  END-IF
  DECIDE FOR FIRST CONDITION
    WHEN EOMRPM-STD2-BREAK-START (I) = 0
      EOMMSG-NR := 0653
      EOMMSG-FIELD-NAME := 'EOMRPM-STD2-BREAK-START'
    WHEN EOMRPM-STD2-BREAK-END   (I) = 0
      EOMMSG-NR := 0653
      EOMMSG-FIELD-NAME := 'EOMRPM-STD2-BREAK-END'
    WHEN EOMRPM-STD2-BREAK-START (I) > EOMRPM-STD2-BREAK-END (I)
      EOMMSG-NR := 0654
      EOMMSG-FIELD-NAME := 'EOMRPM-STD2-BREAK-START'
    WHEN EOMRPM-STD2-REPORT-PREFIX (I) = ' '
      EOMMSG-NR := 0655
      EOMMSG-FIELD-NAME := 'EOMRPM-STD2-REPORT-PREFIX'
    WHEN ANY
      EOMMSG-IND1 := I
      ESCAPE ROUTINE
    WHEN NONE IGNORE
  END-DECIDE
  ADD 1 TO J
END-FOR
IF J = 0
  EOMMSG-NR := 0656
  EOMMSG-IND1 := 1
  EOMMSG-FIELD-NAME := 'EOMRPM-STD2-REPORT-PREFIX'
END-IF
*
END-SUBROUTINE /* VALIDATE-STD2-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-STD3-ATTRIBUTES
************************************************************************
IF EOMRPM-STD3-IDENT-LINE   = 0   AND EOMRPM-STD3-IDENT-STRING = ' '
AND EOMRPM-STD3-START-LINE  = 0   AND EOMRPM-STD3-HEADER-LINES = 0    /*
AND NOT (EOMRPM-STD3-VALUE-FROM (*) NE 0)                             /*
AND NOT (EOMRPM-STD3-VALUE-TO   (*) NE 0)                             /*
  RESET EOMRPM-STD3-TAB (*)
  ESCAPE ROUTINE
END-IF
IF EOMRPM-STD3-HEADER-LINES > 20
  EOMMSG-NR := 0672
  EOMMSG-FIELD-NAME := 'EOMRPM-STD3-HEADER-LINES'
  ESCAPE ROUTINE
END-IF
IF EOMRPM-STD3-HEADER-LINES >=  EOMRPM-STD3-START-LINE
AND EOMRPM-STD3-HEADER-LINES > 0                                      /*
  EOMMSG-NR := 0673
  EOMMSG-FIELD-NAME := 'EOMRPM-STD3-HEADER-LINES'
  ESCAPE ROUTINE
END-IF
IF EOMRPM-STD3-IDENT-STRING = ' '
  RESET EOMRPM-STD3-IDENT-LINE
ELSE
  #T-IN  := EOMRPM-STD3-IDENT-STRING
  #T-OUT := 'VALIDATE'    /* check for correct Natural mask
  /* build ident string for Standard separation routines:
  CALLNAT 'RMEXMSKN' #T-IN #T-OUT
  IF #T-OUT = H'FF'
    EOMMSG-NR := 0667
    EOMMSG-FIELD-NAME := 'EOMRPM-STD3-IDENT-STRING'
  END-IF
END-IF
IF EOMRPM-STD3-IDENT-LINE =  0 AND EOMRPM-STD3-IDENT-STRING NE ' '
  EOMMSG-NR := 0670
  EOMMSG-FIELD-NAME := 'EOMRPM-STD3-IDENT-LINE'
  ESCAPE ROUTINE
END-IF
IF EOMRPM-STD3-IDENT-LINE >=  EOMRPM-STD3-START-LINE
  EOMMSG-NR := 0671
  EOMMSG-FIELD-NAME := 'EOMRPM-STD3-IDENT-LINE'
  ESCAPE ROUTINE
END-IF
FOR I = 1 TO 5
  IF EOMRPM-STD3-VALUE-FROM (I) = 0 AND EOMRPM-STD3-VALUE-TO (I) = 0
  AND EOMRPM-STD3-VALUE-TYPE (I) = ' '                                /*
    RESET EOMRPM-STD3-TAB (I)
    ESCAPE TOP
  END-IF
  IF NOT (EOMRPM-STD3-BOOL-CONNECTOR (I) = 'AND' OR = 'OR') AND I > 1
    EOMMSG-NR := 0678
    EOMMSG-FIELD-NAME := 'EOMRPM-STD3-BOOL-CONNECTOR'
    EOMMSG-IND1 := I
  END-IF
  IF EOMRPM-STD3-BOOL-CONNECTOR (I) NE 'OR'
  OR EOMRPM-STD3-VALUE-FROM (I) NE 0 OR EOMRPM-STD3-VALUE-TO (I) NE 0 /*
    IF EOMRPM-STD3-VALUE-FROM (I) = 0
      EOMMSG-NR := 0653
      EOMMSG-FIELD-NAME := 'EOMRPM-STD3-VALUE-FROM'
      EOMMSG-IND1 := I
      ESCAPE ROUTINE
    END-IF
    IF EOMRPM-STD3-VALUE-TO (I) = 0
      EOMMSG-NR := 0653
      EOMMSG-FIELD-NAME := 'EOMRPM-STD3-VALUE-TO'
      EOMMSG-IND1 := I
      ESCAPE ROUTINE
    END-IF
    IF EOMRPM-STD3-VALUE-TO (I) < EOMRPM-STD3-VALUE-FROM (I)
      EOMMSG-NR := 0654
      EOMMSG-FIELD-NAME := 'EOMRPM-STD3-VALUE-TO'
      EOMMSG-IND1 := I
      ESCAPE ROUTINE
    END-IF
  END-IF
*
  DECIDE ON EVERY EOMRPM-STD3-VALUE-TYPE (I)
    VALUE 'A','N'
      IF NOT (EOMRPM-STD3-REL-CHARACTER (I)='EQ' OR='NE' OR='LT' OR='LE'
      OR='GT' OR='GE' OR='=' OR='!' OR='<' OR='<=' OR='>' OR='>=')    /*
        EOMMSG-NR := 0674
        EOMMSG-FIELD-NAME := 'EOMRPM-STD3-REL-CHARACTER'
        EOMMSG-IND1 := I
        ESCAPE ROUTINE
      END-IF
    VALUE 'N'
      IF NOT (EOMRPM-STD3-VALUE (I) IS (N27))
        EOMMSG-NR := 0675
        EOMMSG-FIELD-NAME := 'EOMRPM-STD3-VALUE'
        EOMMSG-IND1 := I
        ESCAPE ROUTINE
      END-IF
    VALUE 'M'
      RESET EOMRPM-STD3-REL-CHARACTER (I)
      CALLNAT 'EOMMSK-N' EOMRPM-STD3-VALUE (I) VALID-MASK
      IF NOT VALID-MASK
        EOMMSG-NR := 0676
        EOMMSG-FIELD-NAME := 'EOMRPM-STD3-VALUE'
        EOMMSG-IND1 := I
        ESCAPE ROUTINE
      END-IF
    NONE
      EOMMSG-NR := 0677
      EOMMSG-FIELD-NAME := 'EOMRPM-STD3-VALUE-TYPE'
      EOMMSG-IND1 := I
      ESCAPE ROUTINE
  END-DECIDE
*
END-FOR
*
END-SUBROUTINE /* VALIDATE-STD3-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-USEREXIT-ATTRIBUTES
************************************************************************
DECIDE FOR FIRST CONDITION
  WHEN EOMRPM-EXIT-USER-NATPGM NE ' ' AND EOMRPM-EXIT-USER-3GL    NE ' '
    EOMMSG-NR := 1081
    ESCAPE ROUTINE
  WHEN EOMRPM-EXIT-USER-NATPGM NE ' '
    IF EOMRPM-EXIT-USER-NATLIB = ' '
      EOMMSG-FIELD-NAME := 'EOMRPM-EXIT-USER-NATLIB'
      EOMMSG-NR := 1080
      ESCAPE ROUTINE
    END-IF
  WHEN EOMRPM-EXIT-USER-3GL NE ' '
    RESET EOMRPM-EXIT-USER-NATPGM EOMRPM-EXIT-USER-NATLIB
  WHEN NONE
    RESET EOMRPM-EXIT-USER-NATLIB
END-DECIDE
*
END-SUBROUTINE /* VALIDATE-USEREXIT-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-NAF-ATTRIBUTES
************************************************************************
IF EOMRPM-NAF-USER-ID     NE ' ' AND EOMRPM-NAF-NATLIB NE ' '
  EOMMSG-FIELD-NAME := 'EOMRPM-NAF-USER-ID'
  EOMMSG-NR := 1545
END-IF
IF EOM-USER-TYPE = 'G'
  RESET EOMRPM-NAF-NATLIB
  EOMRPM-NAF-USER-ID := EOM-USER
END-IF
*
END-SUBROUTINE /* VALIDATE-NAF-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-BS2-ATTRIBUTES
************************************************************************
#MAXLEN := 27
FOR #I = 1 TO 10
  #DSN-NAME := EOMRPM-BS2-FILES (#I)
  PERFORM VALIDATE-FILE-LENGTH
  IF EOMMSG-NR NE 0
    EOMMSG-FIELD-NAME := 'EOMRPM-BS2-FILES'
    EOMMSG-IND1 := #I
    ESCAPE ROUTINE
  END-IF
END-FOR
CALLNAT 'N-CP-CH2' EOMRPM-BS2-CODEPAGE EOMMSG-NR EOMMSG-TOKEN(1)
IF EOMMSG-NR NE 0
  EOMMSG-FIELD-NAME := 'EOMRPM-BS2-CODEPAGE'
  ESCAPE ROUTINE
END-IF
*
END-SUBROUTINE /* VALIDATE-BS2-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-UNIX-ATTRIBUTES
************************************************************************
IF EOMRPM-UNIX-NODENAME NE ' ' OR EOMRPM-UNIX-PATH   NE ' '
OR EOMRPM-UNIX-FILES(*) NE ' ' OR EOMRPM-UNIX-FORMAT NE ' '           /*
  RESET #LUX
  UXNO. FIND NUMBER UX-NODES WITH UX-NODE-NAME = EOMRPM-UNIX-NODENAME
  IF *NUMBER (UXNO.) = 0
    IF EOMRPM-UNIX-NODENAME = SCAN '*'
      CALLNAT 'HRSELUXN' 'U' EOMRPM-UNIX-NODENAME
      #LUX := TRUE
      EOMMSG-NR := 9876 /*used in RDEFRP
    ELSE
      EOMMSG-FIELD-NAME := 'EOMRPM-UNIX-NODENAME'
      EOMMSG-NR := 2028 /*Unix node not found in Unix defaults.
      ESCAPE ROUTINE
    END-IF
  END-IF
  IF *PF-KEY NE 'PF11'
    IF EOMRPM-UNIX-PATH = ' ' AND #LUX = FALSE
      EOMMSG-FIELD-NAME := 'EOMRPM-UNIX-PATH'
      EOMMSG-NR := 2029
      ESCAPE ROUTINE
    END-IF
    RESET #L
    #MAXLEN := 50
    FOR #I = 1 TO 10
      IF  EOMRPM-UNIX-FILES (#I) NE ' '
        #L := TRUE
        #DSN-NAME := EOMRPM-UNIX-FILES (#I)
        PERFORM VALIDATE-FILE-LENGTH
        IF EOMMSG-NR > 0
          EOMMSG-IND1 := #I
          EOMMSG-FIELD-NAME := 'EOMRPM-UNIX-FILES'
          ESCAPE ROUTINE
        END-IF
        IF EOMRPM-UNIX-FILES (#I) = SCAN '/'
          EOMMSG-FIELD-NAME := 'EOMRPM-UNIX-FILES'
          EOMMSG-TOKEN (1)  := #I /* mark field occurrence
          EOMMSG-NR := 2041
        END-IF
      END-IF
    END-FOR
    IF NOT #L AND #LUX = FALSE
      EOMMSG-FIELD-NAME := 'EOMRPM-UNIX-FILES'
      EOMMSG-TOKEN (1)  := 1 /* mark field occurrence
      EOMMSG-NR := 2020
    END-IF
  END-IF
END-IF
*
END-SUBROUTINE /* VALIDATE-UNIX-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-UNIX-NODE
************************************************************************
ESCAPE ROUTINE
*
END-SUBROUTINE /* VALIDATE-UNIX-NODE
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-JES-ATTRIBUTES
************************************************************************
#MAXLEN := 27
CALLNAT 'N-CHKRPJ' 'E' EOMRPM-JES-FILES(*) EOMMSG-NR
  EOMMSG-FIELD-NAME EOMMSG-IND1
IF EOMMSG-NR NE 0 /*SU8 in because below...
  ESCAPE ROUTINE
END-IF
CALLNAT 'N-CP-CH2' EOMRPM-JES-CODEPAGE EOMMSG-NR EOMMSG-TOKEN(1)
IF EOMMSG-NR NE 0
  EOMMSG-FIELD-NAME := 'EOMRPM-JES-CODEPAGE'
  ESCAPE ROUTINE
END-IF
*
END-SUBROUTINE /* VALIDATE-JES-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-NOMUSR-ATTRIBUTES
************************************************************************
#MAXLEN := 23
FOR #I = 1 TO 10
  #DSN-NAME := EOMRPM-NOMUSR-FILES(#I)
  PERFORM VALIDATE-FILE-LENGTH
  IF EOMMSG-NR NE 0
    EOMMSG-FIELD-NAME := 'EOMRPM-NOMUSR-FILES'
    EOMMSG-IND1 := #I
    ESCAPE ROUTINE
  END-IF
END-FOR
*
END-SUBROUTINE /* VALIDATE-NOMUSR-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-FILE-LENGTH
************************************************************************
EXAMINE FULL #DSN-NAME FOR ' ' GIVING POSITION IN #DSNLEN
IF #DSNLEN > #MAXLEN
  EOMMSG-NR := 1114 /* identification file name too long
END-IF
*
END-SUBROUTINE /* VALIDATE-FILE-LENGTH
*
************************************************************************
DEFINE SUBROUTINE DELETE-REPORT
************************************************************************
PERFORM VALIDATE-KEY
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
CALLNAT 'EOMRPMVN' EOM-PARMS EOMRPM-PARMS EOMMSG-PARMS
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
EOMGRM-I-NAME := EOMRPM-I-NAME
EOMGRM-I-TYPE := 'R'
RESET EOMGRM-I-USER EOMGRM-I-AUTO-COMMIT
CALLNAT 'EOMGRM-N' EOM-DELETE-ALL EOMGRM-PARMS EOMMSG-PARMS/*>> Grant <<
*
END-SUBROUTINE /* DELETE-REPORT
*
************************************************************************
DEFINE SUBROUTINE COPY-REPORT
************************************************************************
PERFORM VALIDATE-KEY
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
IF NOT (EOMRPM-I-COPY-AUTHORIZATION = ' ' OR = 'Y' OR = 'N')
  EOMRPM-I-COPY-AUTHORIZATION := 'N'
END-IF
IF EOMRPM-I-NEWNAME = ' '
  EOMMSG-NR := 0305
  EOMMSG-FIELD-NAME := 'EOMRPM-I-NEWNAME'
  ESCAPE ROUTINE
END-IF
MOVE LEFT JUSTIFIED EOMRPM-I-NEWNAME TO EOMRPM-I-NEWNAME
IF EOMRPM-I-NEWNAME NE MASK (P................)
  EOMMSG-NR := 0019
  EOMMSG-FIELD-NAME := 'EOMRPM-I-NEWNAME'
  ESCAPE ROUTINE
END-IF
CALLNAT 'EOMRPMVN' EOM-PARMS EOMRPM-PARMS EOMMSG-PARMS
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
EOMGRM-I-TYPE := 'R'
EOMGRM-I-DEF-USER := EOM-DEF-USER
IF EOMRPM-I-COPY-AUTHORIZATION = 'Y'
  EOMGRM-I-NAME    := EOMRPM-I-NAME
  EOMGRM-I-NEWNAME := EOMRPM-I-NEWNAME
  CALLNAT 'EOMGRM-N' EOM-COPY EOMGRM-PARMS EOMMSG-PARMS /*Grant
ELSE
  RESET   EOMGRM-I-AUTO-COMMIT
  EOMGRM-I-NAME := EOMRPM-I-NEWNAME
  EOMGRM-I-USER := EOM-USER
  EOMGRM-OPTION (*) := 'Y'
  CALLNAT 'EOMGRM-N' EOM-ADD EOMGRM-PARMS EOMMSG-PARMS /*Grant
END-IF
*
END-SUBROUTINE /* COPY-REPORT
*
************************************************************************
DEFINE SUBROUTINE RENAME-REPORT
************************************************************************
PERFORM VALIDATE-KEY
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
IF EOMRPM-I-NEWNAME = ' '
  EOMMSG-NR := 0305
  EOMMSG-FIELD-NAME := 'EOMRPM-I-NEWNAME'
  ESCAPE ROUTINE
END-IF
MOVE LEFT JUSTIFIED EOMRPM-I-NEWNAME TO EOMRPM-I-NEWNAME
IF EOMRPM-I-NEWNAME NE MASK (P................)
  EOMMSG-NR := 0019
  EOMMSG-FIELD-NAME := 'EOMRPM-I-NEWNAME'
  ESCAPE ROUTINE
END-IF
CALLNAT 'EOMRPMVN' EOM-PARMS EOMRPM-PARMS EOMMSG-PARMS
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
EOMGRM-I-NAME    := EOMRPM-I-NAME
EOMGRM-I-NEWNAME := EOMRPM-I-NEWNAME
EOMGRM-I-TYPE    := 'R'
RESET EOMGRM-I-AUTO-COMMIT EOMGRM-I-USER
CALLNAT 'EOMGRM-N' EOM-RENAME EOMGRM-PARMS EOMMSG-PARMS /*Grant
*
END-SUBROUTINE /* RENAME-REPORT
*
************************************************************************
DEFINE SUBROUTINE REPORT-ATTRIBUTE-INTERFACE
************************************************************************
DECIDE ON FIRST EOMRPM-I-ATTRIBUTE-TYPE
  VALUE REPORT-GENERAL-ATTRIBUTES
    CALLNAT 'EOMRPMGN' EOM-FUNCTION EOMRPM-PARMS EOMMSG-PARMS
  VALUE REPORT-DISTRIBUTION-ATTRIBUTES
    CALLNAT 'EOMRPMDN' EOM-FUNCTION EOMRPM-PARMS EOMMSG-PARMS
  VALUE REPORT-PRINTING-ATTRIBUTES, REPORT-ADDITIONAL-PRINTERS
    CALLNAT 'EOMRPMPN' EOM-FUNCTION EOMRPM-PARMS EOMMSG-PARMS
  VALUE REPORT-JES-ATTRIBUTES, /*SU10 REPORT-POWER-ATTRIBUTES,
  REPORT-NAF-ATTRIBUTES, REPORT-BS2-ATTRIBUTES, REPORT-CMA-ATTRIBUTES  ,
  REPORT-NOMUSR-ATTRIBUTES , REPORT-UNIX-ATTRIBUTES                   /*
    CALLNAT 'EOMRPMIN' EOM-FUNCTION EOMRPM-PARMS EOMMSG-PARMS
  VALUE REPORT-SEPARATION-ATTRIBUTES
    CALLNAT 'EOMRPMSN' EOM-FUNCTION EOMRPM-PARMS EOMMSG-PARMS
  NONE  IGNORE
END-DECIDE
*
END-SUBROUTINE /* REPORT-ATTRIBUTE-INTERFACE
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-PRINTERS
************************************************************************
FOR I = 6 TO 20
  IF EOMRPM-PRINTER (I) = ' '
    RESET EOMRPM-COPIES (I) EOMRPM-SEP-PAGES (I)
    ESCAPE TOP
  END-IF
  CALLNAT 'RCHKPRT' EOMRPM-PRINTER (I) EXIST /*exist printer?
  IF NOT EXIST
    EOMMSG-NR := 0108
    EOMMSG-TOKEN (1) := EOMRPM-PRINTER (I)
    EOMMSG-FIELD-NAME := 'EOMRPM-PRINTER'
    EOMMSG-IND1 := I
    ESCAPE ROUTINE
  END-IF
  IF EOM-USER-TYPE NE 'A'
    #USER-ID := EOM-USER
    #OBJECT-NAME := EOMRPM-PRINTER (I)
    CALLNAT 'RGRANT-N' #USER-ID 'P' #OBJECT-NAME ALLOWED #GRANTS (*)
    IF NOT ALLOWED
      EOMMSG-NR := 1090
      EOMMSG-TOKEN (1) := EOMRPM-PRINTER (I)
      EOMMSG-FIELD-NAME := 'EOMRPM-PRINTER'
      EOMMSG-IND1 := I
      ESCAPE ROUTINE
    END-IF
    IF NOT #GRANTS(*) = 'Y'
      FIND PRINTERS WITH P-ID = #OBJECT-NAME
        IF P-DISP = 'Y'
          RESET ALLOWED
        END-IF
      END-FIND
    END-IF
  END-IF
END-FOR
FOR I = 20 TO 6 STEP -1
  IF EOMRPM-PRINTER (I) NE ' '
  AND EOMRPM-PRINTER (1:I - 1) = EOMRPM-PRINTER (I)                   /*
    EOMMSG-NR := 104 /*Printer already defined.
    EOMMSG-FIELD-NAME := 'EOMRPM-PRINTER'
    EOMMSG-IND1 := I
    ESCAPE ROUTINE
  END-IF
END-FOR
*
END-SUBROUTINE /* VALIDATE-PRINTERS
*
END
