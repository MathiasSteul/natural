* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* ----------------------------------------------------------------------
* Member    N-CHKPSW
* Version   2.2
* Function  CODE AND DECODE PASSWORD
*           CODING IS DONE BY SHIFTING A LETTER 7 POSITIONS TO THE RIGHT.
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* fhi 02-10-30 fhi101    switch on optimizer compiler
* SU1     2016-07-28 NOMALL-1518 NOM3.5 deactivate opt.Compiler
* ----------------------------------------------------------------------
/*SU1 OPTIONS MCG=(INDX=ON,OVFLW=ON,DIGTCHCK=ON) /*fhi101 inserted
DEFINE DATA PARAMETER
1 #ORG-PASS         (A8)
1 REDEFINE #ORG-PASS
  2 #ORG-1          (A1/8)
1 #CYPH-PASS        (A8)
1 REDEFINE #CYPH-PASS
  2 #CYPH-1         (A1/8)
1 #FUNC             (A1)
1 RC                (N1)
************************************************************************
LOCAL
1 #LETTERS          (A36) CONST <'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789'>
1 REDEFINE #LETTERS
  2 #LETTER         (A1/36)
1 #IND              (P2)
1 #IND1             (P2)
1 I                 (P2)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
DECIDE ON FIRST VALUE OF #FUNC
  VALUE 'C'                                       /*CODE PASSWORD
    RESET #CYPH-PASS
    FOR I 1 TO 8
      IF #ORG-1(I) = ' '
        ESCAPE BOTTOM
      END-IF
      EXAMINE #LETTER(1:36) #ORG-1(I) GIVING INDEX IN #IND
      IF #IND = 0
        RC := 1
        ESCAPE ROUTINE
      END-IF
      #IND1 := #IND + 7
      IF #IND1 > 36
        #IND1 := #IND1 - 36
      END-IF
      #CYPH-1(I) := #LETTER(#IND1)
    END-FOR
*
  VALUE 'D'
    RESET #ORG-PASS
    FOR I 1 TO 8
      IF #CYPH-1(I) = ' '
        ESCAPE BOTTOM
      END-IF
      EXAMINE #LETTER(1:36) #CYPH-1(I) GIVING INDEX IN #IND
      IF #IND = 0
        RC := 2
        ESCAPE ROUTINE
      END-IF
      IF #IND = 8 THRU 36
        #IND1 := #IND - 7
      ELSE
        #IND1 := #IND + 29
      END-IF
      #ORG-1(I) := #LETTER(#IND1)
    END-FOR
  NONE IGNORE
END-DECIDE
*
END
