* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
************************************************************************
***                            NOMDELOS                              ***
***                                                                  ***
*** Delete or show Natural Sources associated with an order which    ***
*** are zombies because the corresponding order does not exist       ***
***                                                                  ***
*** Version: 3.5.                                                    ***
*** Author:  fhi/SAG                                                 ***
***                                                                  ***
************************************************************************
DEFINE DATA
LOCAL
1 OD VIEW OF NRM-ORDER
  2 OD-ID
*
1 ORDER-SOURCE VIEW OF NRM-ORDER-SOURCE
  2 OS-OD-ID
  2 OS-RUNNUMBER
  2 OS-SOURCE-TEXT                 (50)
*
1 #OS-ID           (B12)
1 REDEFINE #OS-ID
  2 #OS-OD-ID        (P10)
  2 #OS-RUNNUMBER    (P11)
*
LOCAL
1 FUNCTION       (A1)
1 #I2            (I2)
1 #J             (I4)
END-DEFINE
**********************************************************
INPUT 'D(elete, S(how orders, E(nd:' FUNCTION
IF FUNCTION = 'E'
  ESCAPE ROUTINE
END-IF
READOS.
READ ORDER-SOURCE BY OS-ID
  FIND OD WITH OD-ID = OS-OD-ID
    IF NO RECORDS FOUND
      WRITE (AD=L)
        'Non-existing order' OD-ID 'contains source-lines:' /
        OS-SOURCE-TEXT (1:10) (AL=78)
      IF FUNCTION = 'D'
        CALLNAT 'RMPRGOS' OD-ID
        END TRANSACTION
      END-IF
    END-NOREC
  END-FIND
END-READ
END
