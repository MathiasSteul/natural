* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* **********************************************************************
* MEMBER    NOMPUTLN
* FUNCTION  This program will be used to set the logical file
*           depending on which version of NATURAL.
*
* VERSION   1.4
*
* Maintenance:
* jwo 1997-09-18 S(164220) created NAT23 solution
* gw  1998-11-02 s(999999) copied from SETNRMLN because only modules
*                          NOMPUT* make up the NAF/NOM interface.
* jvd 1999-06-30 p(183302) NOM142 changes
* fhi 2000-01-26 p(191368) module taken from NOM142, STOWED for NOM211
* bli 2012-09-19 NOMALL-94 remove old version, delete NOMPUTVN at all
* **********************************************************************
*
DEFINE DATA PARAMETER
1 #PARM-DBID        (N5)
1 #PARM-FNR         (N5)
1 #PARM-LFILE       (N5)
1 #PARM-PASSWORD    (A8)
1 #PARM-CIPHER      (A8)
1 #PARM-RC          (I4)
*
LOCAL
1 #NOM-SYS-LFILE    (N5) INIT <206>
*
1 #PARMS-NATF0205   /* Param. for NAT23 call
  2 #FUNCTION       (A1)
  2 #DBID           (N5)
  2 #FNR            (N5)
  2 #PASSWORD       (A8)
  2 #CIPHER         (A8)
  2 #LFID           (N5)
  2 #RESPONSE       (N4)
*
END-DEFINE
*
* *--------------------------------------------------------------------
RESET #PARMS-NATF0205
*
IF #PARM-LFILE EQ 0
  #PARM-LFILE := #NOM-SYS-LFILE
END-IF
*
#DBID     :=  #PARM-DBID
#FNR      :=  #PARM-FNR
#LFID     :=  #PARM-LFILE
#PASSWORD :=  #PARM-PASSWORD
#CIPHER   :=  #PARM-CIPHER
CALLNAT 'NATF0205' #PARMS-NATF0205
#PARM-RC := #RESPONSE
END
