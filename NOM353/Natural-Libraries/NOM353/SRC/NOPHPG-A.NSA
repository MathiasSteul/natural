DEFINE DATA PARAMETER
/* >Natural Source Header 000000
/* :Mode S
/* :CP
/* <Natural Source Header
* ----------------------------------------------------------------------
*   PARAMETER: NOPHPG-A
*   VERSION:   3.2
*   FUNCTION   Start and stop group   of physical printers
*
*   MAINTENANCE:
*   XSETGGR 2008-01-25   created
*   XSETHZ  2008-01-28   modified
* -----------------------------------------------------------------------
1 NOPHPG-PARMS
  2 NOPHPG-PARM-AREA (A253/1:20)
  2 REDEFINE NOPHPG-PARM-AREA
    3 NOPHPG (0:19)
      4 NOPHPG-STR (A253)
      4 REDEFINE NOPHPG-STR
        5 NOPHPG-STR-AREA (0:24)
          6 NOPHPG-NAME (A8)
          6 NOPHPG-OPTION (A2)
        5 NOPHPG-STR-FILLER (A3)
END-DEFINE
