* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    RMTRACEC
* Version   1.3
* Function  Display a window to avoid NAT3009
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* jwo 97-12-04 P(167749) created
* ----------------------------------------------------------------------
*
*
IF *DEVICE NE 'BATCH'
  ADD 1 TO #TRACE-CNT
  IF #TRACE-CNT GT #TRACE-MAX
    IF *TPSYS NE SCAN 'IMS'
      SET CONTROL 'WC06L45B10/15F'
      SET CONTROL 'N'
*     SET CONTROL 'Y45'
*     Position window
      INPUT USING MAP 'RMTRACE&'
      SET CONTROL 'WB'
    ELSE
      CALLNAT 'NAT00031' #TRACE-WAIT
    END-IF
    RESET #TRACE-CNT
  END-IF
END-IF
