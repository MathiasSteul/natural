* INPUT USING MAP 'XXXXXXXX'
*     #ANS-COMMIT
DEFINE DATA PARAMETER
1 #ANS-COMMIT (A001)
END-DEFINE
FORMAT PS=001 LS=053 ZP=OFF SG=OFF KD=OFF IP=OFF
* MAP2: MAP PROFILES *****************************        410***********
* .TTAAAMMOO   TU6ID I N D I D I        ?_)^&:+(                       *
* 001052        N0NNUCN             X        01 SYSPROF NL           1 *
************************************************************************
INPUT          (     IP=OFF                                           /*
                                                                       )
 001T 'Bestaetigen Sie mit'(TU)
 021T 'Y'(YEI)
 023T 'oder verwerfen Sie mit'(TU)
 046T 'N'(YEI)
 048T '==>'(TU)
 052T #ANS-COMMIT  (AD=AILT'_' ) /*.99U001 A001 .
* MAP2: VALIDATION *****************************************************
RULEVAR F00#ANS-COMMIT
INCDIC                                 ;
IF NOT(& = 'Y' OR = 'N') AND *PF-KEY NE 'PF3'
  REINPUT 'Enter Y OR N' ALARM
END-IF
* MAP2: END OF MAP *****************************************************
END
