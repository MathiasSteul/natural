DEFINE DATA PARAMETER
/* >Natural Source Header 000000
/* :Mode S
/* :CP
/* <Natural Source Header
*                                              /* INSERTED FROM NAT23006
1 #CB (A156)
1 REDEFINE #CB
  2 #FUNCTION (I4) /* emc function
  2 #MESSAGES (I4) /* number of stored msg
  2 #SLOTS (I4) /* number of available slots
  2 #RSP (I4) /* response code
  2 #DYN_STRING (A1) /* 'y' return only 'dyn parts'
  2 #FREEBYTE3 (B1) /* free
  2 #FREEBYTE2 (B1) /* free
  2 #FREEBYTE1 (B1) /* free
  2 #FREE3 (I4) /* free
  2 #FREE2 (I4) /* free
  2 #FREE1 (I4) /* free
  2 #ERROR (B124) /* error info
  2 REDEFINE #ERROR
    3 #E-NUMBER (I4) /* error number
    3 #E-LINE (I4) /* object line
    3 #E-PGM (A32) /* object name
    3 #E-LIB (A32) /* object's library
    3 #E-DBID (I4) /* object's database id
    3 #E-FNR (I4) /* object's file number
    3 #E-TIME (B8) /* error time
    3 REDEFINE #E-TIME
      4 #E-TIMX (T)
    3 #E-OBJTYPE (A1) /* object type
    3 #E-FILLER-BYTE3 (A1) /* free
    3 #E-FILLER-BYTE2 (A1) /* free
    3 #E-FILLER-BYTE1 (A1) /* free
    3 #E-LANG (I4) /* language code
    3 #E-LEVEL (I4) /* subroutine level
    3 #E-FILL4 (B1) /* free
    3 #E-MC (B1) /* message class
    3 #E-EC (B1) /* error class
    3 #E-ET (B1) /* error type
    3 #E-TEXT-LEN (I4) /* length of #TEXT
    3 #E-RESERVED (B16) /* free
*
1 #TEXT (A253) /* dyn text or msg text
*                                              /* END OF NAT23006
END-DEFINE
