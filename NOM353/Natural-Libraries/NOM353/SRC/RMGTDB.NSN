* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    RMGTDB
* Function  Get Top of current page (NOMDB Interface)
* Version   1.3
*
* Maintenance:
* uuu yy-mm-dd s(999999) ....
* mrs 93-03-15 s(999999) created
* mrs 94-05-09 s(999999) h'81' is a valid ff (write and skip) in BS2
* fhi 05-04-19 NOM31107  Support 7-byte job numbers
* fhi     2009-07-23 P319198   Message of Compression routine too long
* fhi     2009-07-28 P319282 Binary files on Linux corrupted
* fhi     2009-09-15 P320367 Use compression routine NOMCOMPR
* SPLILDAV 2012-06-27 NOMALL-1078 SUPPORT COMPRESSION 16K BYTE RECORDS
* raya     2012-09-27 NOMALL-1143 work with lob fields
* SU1     2014-01-27 NOMALL-1341 remove LA-fields
* SU2     2016-09-01 NOMALL-1912 show compression err. not in hex
************************************************************************
*
DEFINE DATA
PARAMETER USING RMGT---P
************************************************************************
LOCAL USING RCCTYP-E             /* supported cc Types
LOCAL USING RMSR---L             /* supported cc Types
LOCAL
1 SOURCE-TEXT VIEW OF NRM-SOURCE-TEXT
  2 ST-ID
  2 ST-LINE-START
  2 ST-TEXT                          (1:66)
  2 REDEFINE ST-TEXT
    3 ST-TEXT-LOB                    (A16381)
*
1 LINE-FOUND                         (L)
1 #ST-ID-LINE                        (B10)
1 REDEFINE #ST-ID-LINE
  2 #ST-ID                           (P10)
  2 #ST-LINE                         (B4)
1 #START-LINE                        (P10)
1 #RECORD-NUMBER                     (P10)
1 #NSMCOMP-CB                        (B40)
1 REDEFINE #NSMCOMP-CB
  2 #NSMCOMP-COMMAND                 (A1)
  2 #NSMCOMP-CODE                    (B1)
  2 #NSMCOMP-INLENGTH-OLD            (B1)
  2 #NSMCOMP-OUTLENGTH-OLD           (B1)
  2 #NSMCOMP-INLENGTH                (B2)
  2 #NSMCOMP-OUTLENGTH               (B2)
1 #NSMCOMP-RC                        (B2)
1 #NSMCOMP-WORK                      (B4)
1 #NSMCOMP-LINE                      (A251)
1 REDEFINE #NSMCOMP-LINE
  2 #REC-CC                          (A1)
1 #NSMCOMP-BUFFER-LENGTH             (B4)
1 P-SOURCE-TYPE-BIN                  (B2)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET P-ERROR-CODE P-ERROR-TEXT P-TOP-RECORD
*
#SOURCE-ATTRIBUTES := P-SOURCE-ATTRIBUTES
P-SOURCE-TYPE-BIN  := P-SOURCE-TYPE
CALLNAT 'RMSR7--N' #SOURCE-ATTRIBUTES P-SOURCE-TYPE-BIN /*Jobnr:N5->N7
*
#NSMCOMP-BUFFER-LENGTH := 16381 - 7          /*raya/fhi nomall-1143 in
#NSMCOMP-CODE    := 'N'  /* 'N' - NEW PARM LIST
#NSMCOMP-COMMAND := 'D'
*
#ST-ID           := #NOMDB-ID
#ST-LINE         := P-RECORD-NUMBER
#START-LINE      := P-RECORD-NUMBER
RESET LINE-FOUND
*
NOMDB. REPEAT
  READNOMDB. READ (1) SOURCE-TEXT BY ST-ID-LINE = #ST-ID-LINE
    IF ST-ID NE #ST-ID
      P-ERROR-CODE := 0005
      P-ERROR-TEXT := 'Invalid Record Number'
      ESCAPE BOTTOM (NOMDB.)
    END-IF
*
    RESET   #NSMCOMP-WORK
    #RECORD-NUMBER := ST-LINE-START
    SUBTRACT 1 FROM #RECORD-NUMBER
*
  END-READ
*
  IF *COUNTER (READNOMDB.) = 0
    P-ERROR-CODE := 0005
    P-ERROR-TEXT := 'Invalid Record Number'
    ESCAPE BOTTOM (NOMDB.)
  END-IF
*
  REP. REPEAT
    RESET #NSMCOMP-LINE
    INCLUDE C-NSMCMP 'SOURCE-TEXT.ST-TEXT-LOB' /* raya nomall-1143 in
    DECIDE ON FIRST #NSMCOMP-RC
      VALUE 0
        IGNORE
      VALUE 4
        IF P-TOP-RECORD > 0
          ESCAPE BOTTOM (NOMDB.)
        END-IF
        #START-LINE := SOURCE-TEXT.ST-LINE-START
        #START-LINE := #START-LINE - 1
        #ST-LINE    := #START-LINE
        ESCAPE BOTTOM (REP.)
      NONE
        P-ERROR-CODE := 0005
        MOVE EDITED #NSMCOMP-RC (EM=H(4)) TO P-ERROR-TEXT /*SU2
        COMPRESS 'Compression Routine rc=' P-ERROR-TEXT /*SU2
          TO P-ERROR-TEXT
        ESCAPE BOTTOM (NOMDB.)
    END-DECIDE
*
    ADD 1 TO #RECORD-NUMBER
*
    IF (#REC-CC = H'89' AND P-CC-TYPE = MACHINE-CODE)
    OR (#REC-CC = H'8B' AND P-CC-TYPE = MACHINE-CODE)                 /*
    OR (#REC-CC = '1'   AND P-CC-TYPE = ASA-CODE)                     /*
    OR (#REC-CC = H'81' AND P-CC-TYPE = BS2000-CC)                    /*
    OR (#REC-CC = 'A'   AND P-CC-TYPE = BS2000-CC)                    /*
    OR #RECORD-NUMBER = 1                                             /*
      IF (#REC-CC = H'89' AND P-CC-TYPE = MACHINE-CODE)
      OR (#REC-CC = H'81' AND P-CC-TYPE = BS2000-CC)                  /*
        P-TOP-RECORD := #RECORD-NUMBER + 1
      ELSE
        P-TOP-RECORD := #RECORD-NUMBER
      END-IF
    END-IF
*
    IF #RECORD-NUMBER >= P-RECORD-NUMBER
      IF P-TOP-RECORD > 0
        ESCAPE BOTTOM (NOMDB.)
      END-IF
      #START-LINE := SOURCE-TEXT.ST-LINE-START
      #START-LINE := #START-LINE - 1
      #ST-LINE    := #START-LINE
      ESCAPE BOTTOM (REP.)
    END-IF
*
  END-REPEAT
END-REPEAT
*
END
