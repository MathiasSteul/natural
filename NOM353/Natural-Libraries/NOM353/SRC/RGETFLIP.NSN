* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RGETFLIP  BUILD FLIP LINE
*
* MAINTENANCE:
*
* GW  91-05-14  F(198) SORT FLIP LINE
* GW  91-07-09  compress flip lines be able to display more commands
* GW  91-08-07  get 2nd line if first line full
*
* Userid yyyy-mm-dd SAGSIS  Remark
* ----------------------------------------------------------------------
* fhi    2000-04-25 P191368 Make module Nat31 STOW compliant
*
* ----------------------------------------------------------------------
DEFINE DATA
*
PARAMETER
1 #FLIP-PARMS
  2 #FLIP-ARRAY(L/50)
  2 #FLIP-LINES(A78/2)
*
LOCAL USING EQU-L
*
LOCAL
1 #I           (I2) INIT <1>
1 #J           (I2) INIT <1>
1 #TEMP-STRING (A20)
1 #LENGTH-FLIP (I2)
1 #LENGTH-TEMP (I2)
*
END-DEFINE
*
RESET #FLIP-LINES(*)
*
FOR #I 1 TO 49
END-ALL
SORT BY ##LCM-CODE-V(#I)
*
*    USING ##LCM-CODE-V(#I)
* fhi    2000-04-25 P191368 line above out, below 'USING' inserted
    USING ##LCM-NAME-V(#I)
    #FLIP-ARRAY (#I)
  IF #FLIP-ARRAY(#I)
    COMPRESS '<' ##LCM-CODE-V(#I) '#' ##LCM-NAME-V(#I) TO #TEMP-STRING LEAVING NO
    EXAMINE #FLIP-LINES (#J) FOR ' ' GIVING LENGTH #LENGTH-FLIP
    EXAMINE #TEMP-STRING     FOR ' ' GIVING LENGTH #LENGTH-TEMP
    IF #LENGTH-TEMP > 77 - #LENGTH-FLIP OR #LENGTH-TEMP = 0
      IF #J = 2
        ESCAPE ROUTINE  /* that's all we can handle
      END-IF
      ADD 1 TO #J
    END-IF
    COMPRESS #FLIP-LINES (#J) #TEMP-STRING TO #FLIP-LINES (#J)
  END-IF
END-SORT
END
