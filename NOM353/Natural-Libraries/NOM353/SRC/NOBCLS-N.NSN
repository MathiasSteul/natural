* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* NOBCLS-N - NOM API List of Active Reports in Bundle
*
* Maintenance:
* XSETGGR 2002-05-29 created
* XSETGGR 2002-08-23 change CHECK-SOURCE (as in NOARLS-N)
* XSETGGR 2002-09-25 changes
* XSETGGR 2002-10-25 valuable number-of-lines field
* XSETGGR 2002-10-28 change numeric fields in list
* XSETGGR 2002-11-12 changes in CHECK-SOURCE
* XSETGGR 2002-11-14 new field ES-APP-SERVER-LIBRARY
* XSETGGR 2002-11-20 add options
* XSETGGR 2002-11-26 check grants for non-administrator users
* XSETGGR 2003-01-14 changes
* sju     2003-01-31 p(231843) mail wrong if run number wraps round
* sju     2003-03-18 special  TYPE=AL
* fhi     2005-04-19 NOM31107  Support 7-byte job numbers
* XSETGGR 2006-07-31 change CHECK-SOURCE as in NOARLS-N
* xsetggr 2007-06-27 NOM3201 Support P11 format run numbers
* xsetggr 2008-01-14 NRT2768 show size of binary docs in bytes
* xsetggr 2008-02-24 add parm to RBINSZ-N
* xsetggr 2008-03-06 change option 'BR' to 'BB'
* xsetggr 2008-03-11 p(302778) change format of RBINSZ-N parms
* xsetggr 2008-05-05 p(304350) get size of binary docs from spool-attr.
* XSETHZ  2008-07-23 p(307577) use full name of ES-APP-SERVER-LIBRARY
* fhi     2010-09-03 NOMALL-97 Extend message line
* xsetggr 2010-09-20 NOMALL-870 check folder grants, use NOSRCK-N
* xsetggr 2012-04-23 NOMALL-1136 corrections of using grants
* SU1     2013-01-31 unused      Deactivate unused data areas
* fhi     2015-05-18 NOMALL-1552 Show real size, not base64 size
* SU2     2015-06-01 NOMALL-1552 Show size 1 (instead 0)
* CF1     2015-07-03 NOMALL-1658 Support language dependent lists
* CF2     2015-12-14 NOMALL-1794 Suppress sending header texts
* SU3     2016-08-04 NOM 3.5: remove unused code
* HEB1    2020-09-28 NOMALL-2439 return error message to client/NOMLOG
* --------------------------------------------------------------------
DEFINE DATA
PARAMETER USING ESMCNT-A
PARAMETER USING ESMINP-A
PARAMETER USING ESMWORKA
PARAMETER USING NOBCLS-A
*
LOCAL USING VBURP-L
LOCAL USING NOBCSL-A
LOCAL USING ESMCONSL
LOCAL USING NADA2000
LOCAL USING NAD-MSG
LOCAL USING NAD-FLD
LOCAL USING RCCTYP-E
LOCAL USING RMSPL--L
*
LOCAL
1 MAIL VIEW OF NRM-MAIL
  2 MA-USERID
  2 MA-FO-ID
1 ACTIVE-REPORTS VIEW OF NRM-ACTIVE-REPORTS
  2 AR-NUMBER-OF-LINES
  2 AR-MASTER-REPNAME
  2 AR-CC-TYPE
  2 AR-SPOOL-ATTRIBUTES
1 FOLDER VIEW OF NRM-FOLDER
  2 FO-LINKED-FO-ID           (A10)
  2 REDEFINE FO-LINKED-FO-ID
    3 FO-LINKED-USER         (A8)
    3 FO-LINKED-ID           (B2)
1 REPORTS VIEW OF NRM-REPORTS-NEW
* *****
1 #MA-RNB-USER               (A14)
1 REDEFINE #MA-RNB-USER
  2 #MA-RNB                  (P11)
  2 #MA-USER                 (A8)
1 #BC-BUNDLE-RNB-GROUP-SEQNO-REPRNB (A72)
1 REDEFINE #BC-BUNDLE-RNB-GROUP-SEQNO-REPRNB
  2 #BC-BUNDLE    (A25)
  2 #BC-BUNDRNB   (P11)
  2 #BC-GROUP     (A8)
  2 #BC-SEQNO     (P3)
  2 #BC-REPNAME   (A25)
  2 #BC-REPRNB    (P11)
1 #AR-REPORT-RNB  (A31)
1 REDEFINE #AR-REPORT-RNB
  2 #AR-REPORT    (A25)
  2 #AR-RNB       (P11)
1 #I2             (I4)
1 #IMAX           (I4)
1 #REPORT-E       (A25)
1 #GROUP-E        (A8)
1 #NUMB-A3        (A3)
1 REDEFINE #NUMB-A3
  2 #NUMB-N3      (N3)
1 #RNB-A11        (A11)
1 REDEFINE #RNB-A11
  2 #RNB-N11      (N11)
1 #ES-MSG-PREF    (A7) INIT <'NOM'>
1 REDEFINE #ES-MSG-PREF
  2 #ES-MSG-NOM   (A3)
  2 #ES-MSG-NR    (N4)
1 #HEADER-NR      (N4) CONST <6111>
1 #I              (I2)
1 #NOT-SELECT     (L)
1 #SOURCE-EXIST   (L)
1 #READ-AR        (L)
1 #ENV            (A16)
1 #OPTIONS        (A2/1:10)
1 #NEW-OPTIONS    (A2/1:8)
1 #GRANTS         (A1/1:6)
1 #GR-OBJECT      (A25)
1 #GR-USER        (A8)
1 #MA-REP-RNB     (A31)
1 REDEFINE #MA-REP-RNB
  2 #MA-REP       (A25)
  2 #MA-REPRNB    (P11)
1 #BIN            (L)
1 #BIN-SIZE       (I4)
1 #A4             (A4)
1 REDEFINE #A4
  2 #I4           (I4)
1 #ES-MSG-TXT     (A250)
1 #RECNUM         (I4)
1 #BROWSE         (L)
1 #FO-NAME        (A25)
1 #GR-USERID      (A8)
1 #FO-ID-N        (N5)
1 REDEFINE #FO-ID-N
  2 #FO-ID-A      (A5)
1 #FO-USER-ID     (A10)
1 REDEFINE #FO-USER-ID
  2 #FO-USER      (A8)
  2 #FO-ID        (B2)
1 #FOLDER-GRANTS  (A1/6)
*
1 P-ERC           (N4)      /* CF2
1 P-VERSION-A10   (A10)     /* CF2
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET ES-RC ES-NUMBER ES-STARTINDEX ES-SORTKEY ES-SORTORDER
#ENV := *MACHINE-CLASS
ES-EOF := 'X'
ES-OPTION-COUNT := 10
IF ES-EXPAND NE ' '
  #IMAX := 443
  ES-FIELD-COUNT := 1
  NOBCEX-FIELD-LENGTH := 37
ELSE
  #IMAX := 205
  ES-FIELD-COUNT := 10
  NOBCLS-FIELD-LENGTH(1) := 25
  NOBCLS-FIELD-LENGTH(2) := 911
  NOBCLS-FIELD-LENGTH(3) := 8
  NOBCLS-FIELD-LENGTH(4) := 903
  NOBCLS-FIELD-LENGTH(5) := 908
  NOBCLS-FIELD-LENGTH(6) := 908
  NOBCLS-FIELD-LENGTH(7) := 8
  NOBCLS-FIELD-LENGTH(8) := 8
  NOBCLS-FIELD-LENGTH(9) := 20
  NOBCLS-FIELD-LENGTH(10) := 4
END-IF
#BC-BUNDLE  := ES-KEY-PARM(1)
#BC-BUNDRNB := VAL(ES-KEY-PARM(2))
#NOBCSL := ES-SELECT
EXAMINE #NOBCSL.#GROUP FOR '*' DELETE
EXAMINE #NOBCSL.#REPORT FOR '*' DELETE
COMPRESS #NOBCSL.#GROUP H'FF' TO #GROUP-E LEAVING NO
COMPRESS #NOBCSL.#REPORT H'FF' TO #REPORT-E LEAVING NO
IF ES-NEXT-KEY-PARM(1) > ' '
  #BC-GROUP  := ES-NEXT-KEY-PARM(1)
  #BC-SEQNO  := VAL(ES-NEXT-KEY-PARM(2))
  #BC-REPNAME := ES-NEXT-KEY-PARM(3)
  #BC-REPRNB  := VAL(ES-NEXT-KEY-PARM(4))
ELSE
  #BC-GROUP := #NOBCSL.#GROUP
  #BC-REPNAME := #NOBCSL.#REPORT
  RESET #BC-SEQNO #BC-REPRNB
/* Suppress sending list header texts, to enable the  /* CF2 +
/* client side using its own texts with German Umlaute.
/* Client versions GT 3.4.3.4 support this feature.
 CALLNAT 'ESMAVC-N' 'N' P-VERSION-A10 P-ERC ES-CONTROL /*1 char->2 digit
  IF P-VERSION-A10 LE '0304030004'                      /* CF2 -
    IF ES-EXPAND NE 'E'
      ES-STARTINDEX := 2
      #I2 := 1
      RESET NOBCLS-HEADER
      #ES-MSG-NR := #HEADER-NR
      PERFORM GET-MSG-TXT
      NOBCLS-HEADER := LONG-MSG(1)
      FOR #I = 2 TO ES-FIELD-COUNT
        COMPRESS NOBCLS-HEADER C-HEADER-DELIMITER LONG-MSG(#I)
          TO NOBCLS-HEADER LEAVING NO
      END-FOR
    END-IF
  END-IF                                                /* CF2
END-IF
*
/* read active reports in bundle
RDBR. READ BUNDLE-CONTENTS BY BC-BUNDLE-RNB-GROUP-SEQNO-REPRNB
    STARTING FROM #BC-BUNDLE-RNB-GROUP-SEQNO-REPRNB
  IF BC-BUNDLE NE #BC-BUNDLE OR BC-BUNDRNB NE #BC-BUNDRNB
      OR BC-GROUP > #GROUP-E
    ESCAPE BOTTOM(RDBR.)
  END-IF
  REJECT IF NOT(BC-REPNAME = #NOBCSL.#REPORT THRU #REPORT-E)
  RESET #READ-AR #GRANTS(*) #NOT-SELECT
  IF ES-USER-TYPE NE 'A'
    #MA-USER   := ES-USER
    #MA-RNB    := BC-REPRNB
    #MA-REP    := BC-REPNAME
    #MA-REPRNB := BC-REPRNB
    MA. FIND NUMBER MAIL WITH MA-RNB-USER = #MA-RNB-USER
      AND  MA-REP-RNB  = #MA-REP-RNB
    IF *NUMBER (MA.) = 0
      #GR-OBJECT := BC-REPNAME
      RP. FIND NUMBER REPORTS WITH R-REPNAME = BC-REPNAME
      IF *NUMBER (RP.) = 0
        #AR-REPORT := BC-REPNAME
        #AR-RNB    := BC-REPRNB
        FIND ACTIVE-REPORTS WITH AR-REPORT-RNB = #AR-REPORT-RNB
          #GR-OBJECT := AR-MASTER-REPNAME
          #READ-AR   := TRUE
        END-FIND
      END-IF
      CALLNAT 'NOGROU-N' 'R' #GR-OBJECT ES-USER #GR-USER #GRANTS(*)
      IF #GR-USER = ' '
        #NOT-SELECT := TRUE
      END-IF
    END-IF
  END-IF
  IF NOT #NOT-SELECT
    #I2 := #I2 + 1
    IF #I2 > #IMAX
      ES-NEXT-KEY-PARM(1) := BC-GROUP
      #NUMB-N3 := BC-SEQNO
      ES-NEXT-KEY-PARM(2) := #NUMB-A3
      ES-NEXT-KEY-PARM(3) := BC-REPNAME
      #RNB-N11 := BC-REPRNB
      ES-NEXT-KEY-PARM(4) := #RNB-A11
      ES-NUMBER := #IMAX
      RESET  ES-EOF
      ESCAPE BOTTOM
    ELSE
      RESET #OPTIONS(*) #BIN-SIZE  #ES-MSG-NR #ES-MSG-TXT
      PERFORM CHECK-BINARY-FILES
      IF #BIN
        PERFORM GET-BINARY-SIZE
      END-IF
      IF ES-EXPAND = 'E'
        COMPRESS BC-REPNAME C-PARM-DELIMITER BC-REPRNB TO
          NOBCEX-REPRNB(#I2) LEAVING NO
        PERFORM OPTIONS
        NOBCEX-OPTIONS (#I2,*) := #OPTIONS(*)
      ELSE
        NOBCLS-GROUP-ID(#I2):= BC-GROUP
        NOBCLS-SEQNO(#I2)   := BC-SEQNO
        MOVE RIGHT JUSTIFIED NOBCLS-SEQNO(#I2) TO NOBCLS-SEQNO(#I2)
        NOBCLS-REPNAME(#I2) := BC-REPNAME
        NOBCLS-REPRNB(#I2)  := BC-REPRNB
        MOVE RIGHT JUSTIFIED NOBCLS-REPRNB(#I2) TO NOBCLS-REPRNB(#I2)
        IF NOT #READ-AR
          #AR-REPORT := BC-REPNAME
          #AR-RNB    := BC-REPRNB
          FIND ACTIVE-REPORTS WITH AR-REPORT-RNB = #AR-REPORT-RNB
          END-FIND
        END-IF
        IF #BIN
          RESET NOBCLS-LINES(#I2)
          NOBCLS-BYTES(#I2) := #BIN-SIZE
          MOVE RIGHT JUSTIFIED NOBCLS-BYTES(#I2) TO NOBCLS-BYTES(#I2)
        ELSE
          RESET NOBCLS-BYTES(#I2)
          NOBCLS-LINES(#I2) := ACTIVE-REPORTS.AR-NUMBER-OF-LINES
          MOVE RIGHT JUSTIFIED NOBCLS-LINES(#I2) TO NOBCLS-LINES(#I2)
        END-IF
        NOBCLS-FORM (#I2)   := BC-FORM
        NOBCLS-FCB (#I2)    := BC-FCB
        NOBCLS-CHARS (#I2)  := BC-CHARS
        NOBCLS-FLASH (#I2)  := BC-FLASH
        PERFORM OPTIONS
        NOBCLS-OPTIONS(#I2,*) := #OPTIONS(*)
      END-IF
      ES-NUMBER := #I2
    END-IF
  END-IF
END-READ
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE CHECK-BINARY-FILES
************************************************************************
RESET #AR-REPORT-RNB #SPOOL-ATTRIBUTES
#AR-REPORT-RNB.#AR-REPORT := BC-REPNAME
#AR-REPORT-RNB.#AR-RNB     := BC-REPRNB
FNDAR. FIND ACTIVE-REPORTS WITH AR-REPORT-RNB = #AR-REPORT-RNB
  IF AR-CC-TYPE NE BINARY
    RESET #BIN
  ELSE
    #BIN := TRUE
    #SPOOL-ATTRIBUTES := AR-SPOOL-ATTRIBUTES
  END-IF
END-FIND
*
END-SUBROUTINE /* CHECK-BINARY-FILES
*
************************************************************************
DEFINE SUBROUTINE GET-BINARY-SIZE
************************************************************************
RESET #BIN-SIZE #RECNUM #ES-MSG-NR #ES-MSG-TXT
IF NOT (#SPOOL-DI-SIZE = #I4 OR = 0)
  #BIN-SIZE := (#SPOOL-DI-SIZE / 1024) * 3 / 4 + 1
ELSE
  CALLNAT 'RBINSZ-N' BC-REPNAME BC-REPRNB 'R' #RECNUM #BIN-SIZE
    #ES-MSG-NR #ES-MSG-TXT
  IF #ES-MSG-NR = 0 AND #BIN-SIZE NE 0
    #BIN-SIZE := #BIN-SIZE / 1024 + 1
  END-IF
END-IF
*
END-SUBROUTINE /* GET-BINARY-SIZE
*
************************************************************************
DEFINE SUBROUTINE OPTIONS
************************************************************************
RESET #NEW-OPTIONS(*)
  #ES-MSG-NR  #ES-MSG-TXT                           /* HEB1
CALLNAT 'NOSRCK-N' BC-REPNAME BC-REPRNB #SOURCE-EXIST
  #ES-MSG-NR #ES-MSG-TXT ES-USER (AD=O)                 /* HEB1
  ES-APP-SERVER-LIBRARY (AD=O)                          /* HEB1
IF #ES-MSG-NR NE 0                                    /* HEB1 >
  ES-RC := 1
  ES-MSG-NR := #ES-MSG-NR
  ES-MSG-TXT := #ES-MSG-TXT
  ESCAPE MODULE
END-IF                                                /* HEB1 <
*
IF NOT #SOURCE-EXIST
  #OPTIONS (1) := 'BB'
  #OPTIONS (2) := 'PR'
END-IF
IF #BIN AND #BIN-SIZE = 0
  #OPTIONS(3) := 'BB'
END-IF
IF ES-USER-TYPE NE 'A'
  PERFORM CHECK-FOLDER-GRANTS
  DECIDE FOR EVERY CONDITION
    WHEN NOT #BROWSE
      #NEW-OPTIONS(1) := 'BB'
    WHEN ANY
      CALLNAT 'NOOPT--N' #NEW-OPTIONS(*) #OPTIONS(*)
    WHEN NONE IGNORE
  END-DECIDE
END-IF
END-SUBROUTINE /* OPTIONS
*
************************************************************************
DEFINE SUBROUTINE CHECK-FOLDER-GRANTS
************************************************************************
RESET #BROWSE
*
#MA-REP    := BC-REPNAME
#MA-REPRNB := BC-REPRNB
*
MA1. FIND MAIL WITH MA-REP-RNB = #MA-REP-RNB
*
  RESET #FOLDER-GRANTS(*) #GR-USERID
  DECIDE FOR FIRST CONDITION
/* mailed to es-user  own folder
    WHEN MA-USERID = ES-USER  AND MA-FO-ID = 0001
      #BROWSE := TRUE
/* mailed to es-user , to linked folder
    WHEN MA-USERID = ES-USER  AND MA-FO-ID NE 0001
      #FO-ID   := MA-FO-ID
      #FO-USER := MA-USERID
      FIND FOLDER WITH FO-USER-FO-ID = #FO-USER-ID
        #FO-ID-N := FO-LINKED-ID
        COMPRESS FO-LINKED-USER #FO-ID-A TO #FO-NAME LEAVING NO
        CALLNAT 'NOGROU-N'
          'F' #FO-NAME ES-USER #GR-USERID #GRANTS(*)
        IF #GRANTS(4) NE 'Y'
          #BROWSE := FALSE
        ELSE
          #BROWSE := TRUE
        END-IF
      END-FIND
/* mailed not to es-user , but contains in linked folder
    WHEN MA-USERID NE ES-USER  AND MA-FO-ID = 0001
      #FO-ID-N := MA-FO-ID
      COMPRESS MA-USERID #FO-ID-A TO #FO-NAME LEAVING NO
      CALLNAT 'NOGROU-N'
        'F' #FO-NAME ES-USER #GR-USERID #GRANTS(*)
      IF #GRANTS(4) NE 'Y'
        #BROWSE := FALSE
      ELSE
        #BROWSE := TRUE
      END-IF
    WHEN NONE IGNORE
  END-DECIDE
  IF #BROWSE
    ESCAPE BOTTOM(MA1.)
  END-IF
END-FIND
*
END-SUBROUTINE /* CHECK-FOLDER-GRANTS
*
************************************************************************
DEFINE SUBROUTINE GET-MSG-TXT
************************************************************************
RESET SHORT-MSG LONG-MSG(*)
VERSION := 0
NADA2000.OBJECT-KIND := 'U'
NADA2000.ERROR-NUMBER := #ES-MSG-NR
NADA2000.OPT-LANGUAGE := ES-LANGUAGE            /* CF1
NADA2000.OPT-INSERT-DYN := FALSE
NADA2000.LIBRARY := ES-APP-SERVER-LIBRARY
CALLNAT 'NATA2000' NADA2000 NATA2000.EXTENDED-PARMS NAD-MSG NAD-FLD
*
END-SUBROUTINE /* GET-MSG-TXT
*
END
