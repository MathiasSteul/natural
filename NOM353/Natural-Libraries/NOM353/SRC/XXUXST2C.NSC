* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* XXUXST2C
*
* Move Parameters for XXUXST-N back from stack
*
* MODIFICATIONS
* User Id yyyy-mm-dd Mark        Comment
* fhi     2016-08-11 NOMALL-1903 Created
* ---------------------------------------------------------------------
#COL     := #COL + 1
#FORMAT  := &2&
DECIDE ON FIRST VALUE OF #FORMAT
  VALUE 'N'
    #NUM := VAL(+XXUX---P(+XXUXD--P,#COL))
  VALUE 'L'
    IF +XXUX---P(+XXUXD--P,#COL) = 'X'
      #LOG := TRUE
    ELSE
      #LOG := FALSE
    END-IF
  NONE
    MOVE +XXUX---P (+XXUXD--P,#COL) TO #ALPHA
END-DECIDE
* ---------------------------------------------------------------------
