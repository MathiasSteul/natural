* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RPFBUP-C       Bundle Printing Attributes PF-key Assignment
*
* MAINTENANCE:
* xsisgg 00-08-07 CE7461 New PF-key for toggle between display long
*                        or short report and bundle names
* ----------------------------------------------------------------------
G-PF-IDENT (09) := ##PFN-BUNDLE-PRINT
G-PF-CODE  (09) := ##PFK-BUNDLE-PRINT
IF G-SUPPORT-LONG-NAMES
  G-PF-IDENT (21) := ##PFN-DISPLAY-LONG-NAMES
  G-PF-CODE  (21) := ##PFK-DISPLAY-LONG-NAMES
ELSE
  G-PF-IDENT (21) := ##PFN-BUNDLE-PRINT
  G-PF-CODE  (21) := ##PFK-BUNDLE-PRINT
END-IF
