* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RBRWRPN - allowed editor line cmds (browse AR): bits as bytes for
*   CALL 'EDITOR'
*     ED-REQUEST := 'ALCS' /*Allow some Line CommandS
*     ED-MCMND := #BYTE
*     /* 'ALAL'  ALlow All Line commands
*   For editor line cmds: RBRWRPN2
* Maintenance
* SU1 2023-12-11 NOMALL-2489 created for hex on MF
************************************************************************
DEFINE DATA
PARAMETER
1 #BYTE         (A15)  /*out: 10 bytes with 80 bites and 5 bytes left
1 REDEFINE #BYTE
  2 #BYTE1      (A1)
************************************************************************
LOCAL
1 #MAX          (I2) CONST <80>
1 #BITS         (A1/#MAX) INIT (V) <  /*=8*10
* x: ' '=not allowed / '1'=allowed
*  x      NR CMD       REMARK
*  -      -- ---- ---- ---------------------
  ' ', /*  1 A    A    after
  ' ', /*  2 B    B    before
  ' ', /*  3 O    O    overlay one line
  ' ', /*  4 I    I    insert lines
  ' ', /*  5 D    D    delete one line
  ' ', /*  6 DD   DD   delete block
  ' ', /*  7 R    R    repeat one line
  ' ', /*  8 RR   RR   repeat block
  '1', /*  9 C    C    copy one line - for EXPORT
  '1', /* 10 CC   CC   copy block - for EXPORT
  ' ', /* 11 M    M    move one line
  ' ', /* 12 MM   MM   move block
  ' ', /* 13 OO   OO   overlay block
  ' ', /* 14 )    CR   cols right
  ' ', /* 15 ))   CRB  cols right
  ' ', /* 16 (    CL   cols left
  ' ', /* 17 ((   CLB  cols left
  ' ', /* 18 >    DR   data right
  ' ', /* 19 >>   DRB  data right
  ' ', /* 20 <    DL   data left
  ' ', /* 21 <<   DLB  data left
  '1', /* 22 X    X    exclude one line
  '1', /* 23 XX   XX   exclude block
  ' ', /* 24 F    F    first
  ' ', /* 25 L    L    last
  ' ', /* 26 S    S    split
  ' ', /* 27 TS   TS   text split
  ' ', /* 28 TO   TO   text order
  ' ', /* 29 TE   TE   text enter
  ' ', /* 30 BNDS BNDS boundary - ok,but lines not modifiable->not ok
  '1', /* 31 COLS COLS columns
  ' ', /* 32 MASK MASK mask
  ' ', /* 33 TABS TABS tabs
  ' ', /* 34 UCC  UC   change to upper case
  ' ', /* 35 UC   UCB  change to upper case          *
  ' ', /* 36 LCC  LC   change to lower case
  ' ', /* 37 LC   LCB  change to lower case
  ' ', /* 38 TOO  TOB  text order
  ' ', /* 39 TF   TF   text flow
  ' ', /* 40 TCC  TC   text centering
  ' ', /* 41 TC   TCB  text centering
  ' ', /* 42 LJJ  LJ   left justify
  ' ', /* 43 LJ   LJB  left justify
  ' ', /* 44 RJJ  RJ   right justify
  ' ', /* 45 RJ   RJB  right justify
  ' ', /* 46 W    W    insert window
  ' ', /* 47 TJ   TJ   text join
  ' ', /* 48 N    N    do not change data
  '1', /* 49 P    P    print  - print command
  '1', /* 50 PP   PP   print  - print command
  '1', /* 51 T    T    make it top   line
  ' ', /* 52 CX   CX   copy x line
  ' ', /* 53 CY   CY   copy y line
  ' ', /* 54 DX   DX   delete x line
  ' ', /* 55 DY   DY   delete y line
  ' ', /* 56 MX   MX   move x line
  ' ', /* 57 MY   MY   move y line
  ' ', /* 58 CX-Y CX_Y copy x-y lines
  ' ', /* 59 DX-Y DX_Y delete x-y lines
  ' ', /* 60 MX-Y MX_Y move x-y lines
  ' ', /* 61 CY-X CY_X copy y-x lines
  ' ', /* 62 DY-X DY_X delete y-x lines
  ' ', /* 63 MY-X MY_X move y-x lines
  ' ', /* 64 TI   TI   text inverse
  ' ', /* 65 TC   TIB  text inverse
  ' ', /* 66 WS   WS   window start
  ' ', /* 67 WE   WE   window end
  ' ', /* 68 WC   WC   window copy
  ' ', /* 69 WM   WM   window move
  ' ', /* 70 WD   WD   window delete
  ' ', /* 71 WO   WO   window over
  ' ', /* 72 WW   WW   window, built-in command
  ' ', /* 73 NP   NP   new control page
  ' '> /* 74 NZ   NZ   point a line
1 REDEFINE #BITS
  2 #BIT1       (A1)
1 NAT00038-LEN  (B2)
1 NAT00038-RC   (N4)
1 #I            (I2)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET #BYTE
FOR #I =1 TO #MAX
  IF #BITS (#I) NE '1'
    #BITS (#I) := '0'
  END-IF
END-FOR
* Bits to bytes:
NAT00038-LEN := #MAX / 8 /* 80/8=10 byte
CALLNAT 'NAT00038' 'Y' #BYTE1 #BIT1 NAT00038-LEN NAT00038-RC
IF NAT00038-RC NE 0
  PRINT *DAT4I *TIME(AL=8) *PROGRAM '>> NAT00038 rc:' NAT00038-RC
    'bits:' #BITS (*)
END-IF
**FOR #I =11 TO 11
**  MOVE H'FF' TO SUBSTR(#BYTE,#I,1) /*??? does export work ?
**END-FOR
**MOVE ALL H'FF' TO #BYTE /*???
**#BYTE1 := H'DC'
**PRINT '=' #BYTE (EM=H(15)) /*?????
*
END
