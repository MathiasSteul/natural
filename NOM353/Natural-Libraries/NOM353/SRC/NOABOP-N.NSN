* :LineIncrement 10
* <Natural Source Header
* NOABOP-N - NOM API Active Bundle Maintenance
*
* Maintenance:
* XSETGGR 2002-05-27  created
* XSETGGR 2002-10-01  change work with time variables
* XSETGGR 2002-11-04  consequent validation check of members and libs
* XSETGGR 2002-11-14  use ES-APP-SERVER-LIBRARY parameter
* XSETGGR 2002-12-30  changes
* XSETGGR 2003-03-04  p(222810)-only open bundles can be updated
* XSETHZ  2003-08-11  USER-AUTODEF
* xsetggr 2004-02-24 p(250342) implement 'NONE'/'KEIN' separator page
* HH 040825 FORMATTING T CHANGED;                /* HH 040825
* xsetggr 2006-02-15  no changes, restow
* xsetggr 2007-03-22  replace call of ES...-N  to call of direct module
* xsetggr 2007-04-25  add options for archive/revive
* xsetggr 2007-05-08  NOM3201 Support P11 format run numbers
* fhi     2007-07-12 NOM3202   C-NATERR changed, NAD23006 is obsolete.
* XSETHZ  2008-07-23 p(307577) use full name of ES-APP-SERVER-LIBRARY
* fhi     2008-07-24 P307319   restow due to changes in DDM NRM-BUNDLE-CONTENTS
* fhi     2010-09-03 NOMALL-97 Extend message line
* xsetggr 2011-07-29 NOMALL-982 restow due changes in NOABOP-A
* xsetggr 2012-01-12 NOMALL-1020 write language independants msgs in log
* xsetggr 2012-03-11 NOMALL-1099 use interface to call RLOG from NGC
* xsetggr 2012-05-17 NOMALL-1136 improve validation of printers
* fhi     2013-08-29 FHI285    Enhance error message 406
* SU1     2013-11-22 NOMALL-82 new class: activate error
*                                No tags, only restructured
* SU2     2014-06-30 NOMALL-1279 fill fields for Adabas Vista
* SU3     2014-06-30 NOMALL-1281 show last update user+date
* fhi     2015-06-30 NOMALL-1655 Leave copies field as entered
* SU4     2016-01-15 NOMALL-1802 do not update Adabas Vista fields
* SU5     2016-09-29 NOM3.5 use N-NONE+N-SEPME2
* SU6     2017-03-07 NOM 3.5: remove unused code
* ---------------------------------------------------------------------
DEFINE DATA
PARAMETER USING ESMCNT-A
PARAMETER USING ESMINP-A
PARAMETER USING NOABOP-A
************************************************************************
LOCAL USING VABUND-L
LOCAL USING MAXITIML
LOCAL USING NADA2000
LOCAL USING NAD-MSG
LOCAL USING NAD-FLD
LOCAL USING NOMODE-A
LOCAL USING NOUSUP-L
LOCAL USING RLOG-L
LOCAL
1 BUNDLES VIEW OF NRM-BUNDLES
  2 B-DESC
1 USERS VIEW OF NRM-USERS
  2 FIRST-NAME
  2 LAST-NAME
  2 WORK-PHONE
  2 WORK-PHONE-EXT
  2 USER-PROFILE
1 BUNDLE-CONTENTS VIEW OF NRM-BUNDLE-CONTENTS
  2 BC-REPNAME
  2 BC-REPRNB
1 ACT-REP VIEW OF NRM-ACTIVE-REPORTS
  2 AR-NUMBER-OF-LINES
1 REPORTS VIEW OF NRM-REPORTS-NEW
1 #ES-CONTROL               (A250)
1 #ES-INPUT-AREA            (A253/1:3)
1 #ES-MSG-FIELD             (A32)
1  REDEFINE #ES-MSG-FIELD
  2 #ES-MSG-FIELD-NAME      (A28)
  2 #ES-MSG-FIELD-INDEX     (N4)
  2 REDEFINE #ES-MSG-FIELD-INDEX
    3 #ES-MSG-FIELD-INDEX1  (N2)
    3 #ES-MSG-FIELD-INDEX2  (N2)
1 #ES-MSG-TXT               (A250)
1 #ES-MSG-PREF              (A7)  INIT <'NOM'>
1 REDEFINE #ES-MSG-PREF
  2 #ES-MSG-NOM             (A3)
  2 #ES-MSG-NR              (N4)
1 #I                        (I2)
1 #DEF-COPIES               (N3)  CONST <1>
1 #MAX-PRINTER              (N2)  CONST <20>
1 #LIBRARY-ID               (A8)
1 #BUNDLE-RNB               (A33)
1 REDEFINE #BUNDLE-RNB
  2 #BUNDLE                 (A25)
  2 #RNB                    (P11)
  2 #SEQNO                  (P3)
1 #BUNDRNB-A                (A11)
1 REDEFINE #BUNDRNB-A
  2 #BUNDRNB-N              (N11)
1 #OPENT                    (T)
1 #OPENP                    (P12)
1 #BC-SUPER                 (A41)
1 REDEFINE  #BC-SUPER
  2 #BC-BUNDLE              (A25)
  2 #BC-BUNDRNB             (P11)
  2 #BC-GROUP               (A8)
  2 #BC-SEQNO               (P3)
1 #BC-SUPER-E               (A41)
1 #AR-REPORT-RNB            (A31)
1 REDEFINE #AR-REPORT-RNB
  2 #AR-REPNAME             (A25)
  2 #AR-REPRNB              (P11)
1 #DATE                     (A12)
1 REDEFINE #DATE
  2 #DATE-A8               (A8)
  2 #TIME-A4               (A4)
1 #DATE-A10                 (A10)
1 #TIME                     (A8)
1 REDEFINE #TIME
  2 #HH                     (N2)
  2 #FIL1                   (A1)
  2 #II                     (N2)
  2 #FIL2                   (A1)
  2 #SS                     (N2)
1 #TXT                      (A250)
1 #TT                       (T)
1 #GRANTS                   (A1/6)
1 #GR-USER                  (A8)
1 #GR-OBJECT                (A25)
1 #USER-LIB                 (A8)
1 #J                        (I2)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET ES-RC #TT
#LIBRARY-ID       := ES-APP-SERVER-LIBRARY
COMPRESS ES-APP-SERVER-LIBRARY 'U' TO #USER-LIB LEAVING NO
#ES-CONTROL       := ES-CONTROL
#ES-INPUT-AREA(*) := ES-INPUT-AREA(*)
#BUNDLE    := ES-KEY-PARM(1)
#BUNDRNB-A := ES-KEY-PARM(2)
#RNB := VAL(#BUNDRNB-A)
NOMOD-PARMS := ES-SELECT
#BC-BUNDLE := #BUNDLE
#BC-BUNDRNB := VAL(#BUNDRNB-A)
#BC-GROUP := H'FF'
#BC-SEQNO := 999
#BC-SUPER-E := #BC-SUPER
RESET #BC-GROUP #BC-SEQNO
DECIDE ON FIRST VALUE OF ES-FUNCTION
  VALUE 'OP'
    DECIDE ON FIRST VALUE OF ES-EXTEND-FUNCTION
      VALUE ' '
        PERFORM READ-RECORD
      VALUE 'UPD'
        PERFORM UPDATE-RECORD
        IF ES-RC = 0
          PERFORM WRITE-LOG-RECORD
          END TRANSACTION
        ELSE
          BACKOUT TRANSACTION
        END-IF
      VALUE 'CHK'
        PERFORM UPDATE-RECORD
      NONE VALUE IGNORE
    END-DECIDE
  NONE VALUE IGNORE
END-DECIDE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE READ-RECORD
************************************************************************
RESET NOAB-PARMS #ES-MSG-FIELD #ES-MSG-NR
FNDBU. FIND ACTIVE-BUNDLES WITH AB-BUNDLE-RNB = #BUNDLE-RNB
  IF NO RECORDS FOUND
    #ES-MSG-NR := 0408                   /* bundle not defined
    #ES-MSG-FIELD-NAME := 'BUNDLE'
    ESCAPE BOTTOM (FNDBU.)
  END-NOREC
/* read general attributes
  NOAB-BUNDLE  := AB-BUNDLE
  NOAB-BUNDRNB := AB-BUNDRNB
  NOAB-STATUS  := AB-STATUS
  FIND BUNDLES WITH B-BUNDLE = AB-BUNDLE
    NOAB-DESC := B-DESC
  END-FIND
  NOAB-COORDINATOR-ID := AB-COORDINATOR-ID
  #OPENT := #OPENP := AB-OPEN-TIME
  #OPENP := #MAX-INV-TIME - #OPENP
  #OPENT := #OPENP
  IF ACTIVE-BUNDLES.AB-OPEN-TIME NE #TT
    MOVE EDITED #OPENT (EM=YYYYMMDD) TO #DATE-A8
    MOVE EDITED #OPENT (EM=HH':'II) TO NOAB-OPEN-T
    CALLNAT 'NODATF-N' #DATE-A8 NOAB-OPEN-D ES-DATE-FORMAT
  ELSE
    RESET NOAB-OPEN-TIME
  END-IF
  IF ACTIVE-BUNDLES.AB-PLAN-FLUSH-TIME NE #TT
    MOVE EDITED AB-PLAN-FLUSH-TIME (EM=YYYYMMDD) TO #DATE-A8
    MOVE EDITED AB-PLAN-FLUSH-TIME (EM=HH':'II) TO NOAB-SCHEDULE-T
    CALLNAT 'NODATF-N' #DATE-A8 NOAB-SCHEDULE-D ES-DATE-FORMAT
  ELSE
    RESET NOAB-SCHEDULE-TIME
  END-IF
  NOAB-FLUSH-REPORTS (1:10)    := AB-FLUSH-REPORTS(1:10)
  NOAB-FLUSH-LINES             := AB-FLUSH-LINES
  IF ACTIVE-BUNDLES.AB-FLUSH-TIME NE #TT
    MOVE EDITED AB-FLUSH-TIME (EM=YYYYMMDD) TO #DATE-A8
    MOVE EDITED AB-FLUSH-TIME (EM=HH':'II) TO NOAB-CLOSE-T
    CALLNAT 'NODATF-N' #DATE-A8 NOAB-CLOSE-D ES-DATE-FORMAT
  ELSE
    RESET NOAB-CLOSE-TIME
  END-IF
  IF AB-EXPIRATION NE ' '
    CALLNAT 'NODATF-N' AB-EXPIRATION-DATE #DATE-A10 ES-DATE-FORMAT
    IF AB-EXPIRATION-ACTION = 'F'
      NOAB-FORCE := #DATE-A10 /* for info
    ELSE
      NOAB-PURGE := #DATE-A10
    END-IF
  END-IF
  FNDUS. FIND USERS WITH USER-ID = AB-COORDINATOR-ID
    IF NO RECORDS FOUND
      NOAB-COORD-NAME := 'not defined'
      RESET  NOAB-COORD-PHONE
      ESCAPE BOTTOM(FNDUS.)
    END-NOREC
    COMPRESS FIRST-NAME LAST-NAME TO NOAB-COORD-NAME
    COMPRESS WORK-PHONE '/' WORK-PHONE-EXT TO NOAB-COORD-PHONE LEAVING NO
  END-FIND
  RESET NOAB-NUMBER-OF-REPORTS NOAB-NUMBER-OF-LINES
  FNDBC. FIND BUNDLE-CONTENTS
      WITH BC-BUNDLE-RNB-GROUP-SEQNO = #BC-SUPER THRU #BC-SUPER-E
    NOAB-NUMBER-OF-REPORTS := *NUMBER (FNDBC.)
    #AR-REPNAME := BC-REPNAME
    #AR-REPRNB  := BC-REPRNB
    FAC. FIND ACT-REP WITH AR-REPORT-RNB = #AR-REPORT-RNB
      ADD AR-NUMBER-OF-LINES TO NOAB-NUMBER-OF-LINES
    END-FIND
  END-FIND
/* read printing attributes
  NOAB-HOLD-PRINT      := AB-HOLD
  NOAB-PRINTER(*)      := AB-PRINTER(*)
  NOAB-PRINT-COPIES(*) := AB-PRINTER-COPIES(*)
  NOAB-SEP-START       := AB-SEPSTART
  NOAB-SEP-END         := AB-SEPEND
  CALLNAT 'N-NONE' NOAB-SEP-START NOAB-SEP-END
  NOAB-SEPARATOR-COPIES   := AB-SEPNO
  NOAB-CONTROL-EXITLIB    := AB-CONTROL-EXITLIB
  NOAB-CONTROL-EXITMEM    := AB-CONTROL-EXITMEM
  NOAB-PRINT-JOBCARD(1:3) := AB-PRINT-JOBCARD(1:3)
END-FIND
IF #ES-MSG-NR NE 0
  PERFORM GET-MSG-TXT
END-IF
*
END-SUBROUTINE /* READ-RECORD
*
************************************************************************
DEFINE SUBROUTINE UPDATE-RECORD
************************************************************************
FNDMOD. FIND ACTIVE-BUNDLES WITH AB-BUNDLE-RNB = #BUNDLE-RNB
  IF NO RECORDS FOUND
    #ES-MSG-NR := 0408
    ESCAPE BOTTOM (FNDMOD.)
  END-NOREC
  PERFORM VALIDATION-S
  IF #ES-MSG-NR NE 0 OR ES-EXTEND-FUNCTION NE 'UPD'
    ESCAPE BOTTOM(FNDMOD.)
  END-IF
  GETMOD. GET ACTIVE-BUNDLES *ISN(FNDMOD.)
/* general attributes
  AB-BUNDLE           := NOAB-BUNDLE
  AB-BUNDRNB          := NOAB-BUNDRNB
  AB-LAST-UPDATE      := *TIMX /*SU3
  AB-LAST-UPDATE-USER := ES-USER /*SU3
  IF NOAB-COORDINATOR-ID > ' '
    AB-COORDINATOR-ID := NOAB-COORDINATOR-ID
  ELSE
    AB-COORDINATOR-ID := ES-USER
  END-IF
  DECIDE FOR FIRST CONDITION
    WHEN NOAB-SCHEDULE-D = ' ' AND NOAB-SCHEDULE-T = ' '
      RESET AB-PLAN-FLUSH-TIME
    WHEN NOAB-SCHEDULE-D NE ' ' AND NOAB-SCHEDULE-T NE ' '
      CALLNAT 'IODATE-N' 'M' 'S' #DATE-A8 NOAB-SCHEDULE-D
        ES-DATE-FORMAT #ES-MSG-NR #TXT
      #TIME := NOAB-SCHEDULE-T
      EXAMINE #TIME FOR ':' DELETE
      #TIME-A4 := #TIME
      MOVE EDITED #DATE TO AB-PLAN-FLUSH-TIME(EM=YYYYMMDDHHII)
    WHEN NONE IGNORE
  END-DECIDE
  AB-FLUSH-REPORTS(*) := NOAB-FLUSH-REPORTS(*)
  AB-FLUSH-LINES      := NOAB-FLUSH-LINES
/* printing attributes
  AB-HOLD                := NOAB-HOLD-PRINT
  FOR #I=1 TO #MAX-PRINTER
    IF NOAB-PRINTER(#I)  = ' '
      RESET AB-PRINTER(#I) AB-PRINTER-COPIES(#I)
    ELSE
      AB-PRINTER(#I) := NOAB-PRINTER(#I)
      IF NOAB-PRINT-COPIES(#I) = 0
        AB-PRINTER-COPIES(#I):= #DEF-COPIES
      ELSE
        AB-PRINTER-COPIES(#I):= NOAB-PRINT-COPIES(#I)
      END-IF
    END-IF
  END-FOR
  AB-SEPSTART := NOAB-SEP-START
  AB-SEPEND   := NOAB-SEP-END
  AB-SEPNO := NOAB-SEPARATOR-COPIES
  AB-CONTROL-EXITLIB     := NOAB-CONTROL-EXITLIB
  AB-CONTROL-EXITMEM     := NOAB-CONTROL-EXITMEM
  AB-PRINT-JOBCARD(1:3)  := NOAB-PRINT-JOBCARD(1:3)
/*
  RESET NOAB-OPTIONS (*)
  FBC. FIND NUMBER BUNDLE-CONTENTS WITH
    BC-BUNDLE-RNB-GROUP-SEQNO = #BC-SUPER THRU #BC-SUPER-E
  IF *NUMBER(FBC.) = 0
    AB-STATUS   :=  'E'
    NOAB-OPTIONS (1) := 'LB'
    NOAB-OPTIONS (2) := 'SS'
    RESET NOAB-NUMBER-OF-REPORTS
  ELSE
    NOAB-NUMBER-OF-REPORTS := *NUMBER(FBC.)
  END-IF
  IF ACTIVE-BUNDLES.AB-STATUS NE 'O' OR
      NOT (ES-USER-TYPE = 'A' OR NOMOD-FLUSH = 'Y')
    NOAB-OPTIONS(3) := 'CL'
  END-IF
  IF ACTIVE-BUNDLES.AB-STATUS = 'E' OR
      NOT (ES-USER-TYPE = 'A' OR NOMOD-FLUSH = 'Y')
    NOAB-OPTIONS(4) := 'PB'
  END-IF
  IF ES-USER-TYPE NE 'A'
    CALLNAT 'NOGROU-N' 'B' AB-BUNDLE ES-USER #GR-USER #GRANTS(*)
    IF #GRANTS(1) NE 'Y' AND #GRANTS(3) NE 'Y'
      NOAB-OPTIONS(5) := 'DL'
    END-IF
  END-IF
  IF ACTIVE-BUNDLES.AB-STATUS NE 'O'
    NOAB-OPTIONS(6) := 'OP'
  END-IF
  FIND USERS WITH USER-ID = ES-USER
    PROFILE-STRING := USER-PROFILE
    IF PROF-TYPE NE 'A'
      IF PROF-ARCHIVE NE 'Y' AND PROF-ARCHIVE NE 'M'
        NOAB-OPTIONS(7) := 'AR'
      END-IF
      IF PROF-REVIVE NE 'Y' AND PROF-REVIVE NE 'M'
        NOAB-OPTIONS(8) := 'RV'
      END-IF
    END-IF
  END-FIND
  NOAB-STATUS := ACTIVE-BUNDLES.AB-STATUS
  UPDATE (GETMOD.)
END-FIND
IF #ES-MSG-NR NE 0
  PERFORM GET-MSG-TXT
END-IF
*
END-SUBROUTINE /* UPDATE-RECORD
*
************************************************************************
DEFINE SUBROUTINE VALIDATION-S
************************************************************************
PERFORM VALIDATION
ES-CONTROL := #ES-CONTROL
ES-INPUT-AREA(*) := #ES-INPUT-AREA(*)
*
END-SUBROUTINE /* VALIDATION-S
*
************************************************************************
DEFINE SUBROUTINE VALIDATION
************************************************************************
RESET #ES-MSG-NR #ES-MSG-FIELD
/* validation of general attributes
DECIDE FOR FIRST CONDITION
  WHEN NOAB-BUNDLE = ' '
    #ES-MSG-NR := 0042            /* bundle name is required
    #ES-MSG-FIELD-NAME := 'BUNDLE'
    ESCAPE ROUTINE
  WHEN NOAB-BUNDLE NE MASK (P........................)
    #ES-MSG-NR := 0019           /* name must start with letter
    #ES-MSG-FIELD-NAME := 'BUNDLE'
    ESCAPE ROUTINE
  WHEN NOAB-COORDINATOR-ID > ' '
    IF NOT (NOMOD-USER-AUTODEF = 'P' OR = 'Y')
      ES-OBJECT := 'US'
      ES-FUNCTION := 'EX'
      ES-KEY-PARM(1) := NOAB-COORDINATOR-ID
/* check user existance
      CALLNAT 'NOXXEX-N' ES-CONTROL ES-INPUT
      IF ES-RC NE 0
        #ES-MSG-NR := 0002
        #ES-MSG-FIELD-NAME := 'COORDINATOR-ID'
        ESCAPE ROUTINE
      END-IF
    END-IF
  WHEN NONE IGNORE
END-DECIDE
IF NOAB-SCHEDULE-D NE ' ' AND NOAB-SCHEDULE-T = ' '
  #ES-MSG-NR := 0051
  #ES-MSG-FIELD-NAME := 'SCHEDULE-D'
  ESCAPE ROUTINE
END-IF
IF NOAB-SCHEDULE-D = ' ' AND NOAB-SCHEDULE-T NE ' '
  #ES-MSG-NR := 0051
  #ES-MSG-FIELD-NAME := 'SCHEDULE-T'
  ESCAPE ROUTINE
END-IF
IF NOAB-SCHEDULE-D NE ' ' AND NOAB-SCHEDULE-T NE ' '
  CALLNAT 'IODATE-N' 'V' 'L' #DATE-A8 NOAB-SCHEDULE-D ES-DATE-FORMAT
    #ES-MSG-NR #TXT
  IF #ES-MSG-NR NE 0
    #ES-MSG-FIELD-NAME := 'SCHEDULE-D'
    ESCAPE ROUTINE
  END-IF
  #TIME := NOAB-SCHEDULE-T
  IF NOT (#HH =0 THRU 23) OR NOT(#II =0 THRU 59) OR NOT (#SS =0 THRU 59)
    #ES-MSG-NR := 0051   /* enter correct time
    #ES-MSG-FIELD-NAME := 'SCHEDULE-T'
    ESCAPE ROUTINE
  END-IF
END-IF
IF NOAB-FLUSH-REPORTS(*) NE ' '
  FOR #I = 1 TO 10
    IF NOAB-FLUSH-REPORTS(#I) NE ' ' AND NOAB-ADD-FLUSH-REP(#I) NE 'Y'
      FNUM. FIND NUMBER REPORTS WITH R-REPNAME = NOAB-FLUSH-REPORTS(#I)
      IF *NUMBER(FNUM.) = 0
        #ES-MSG-NR := 0490
        #ES-MSG-FIELD-NAME := 'FLUSH-REPORTS'
        #ES-MSG-FIELD-INDEX := #I
        ESCAPE ROUTINE
      END-IF
    END-IF
  END-FOR
END-IF
/* validate printing attributes
IF NOT (NOAB-HOLD-PRINT = 'Y' OR = 'N' OR = ' ')
  #ES-MSG-NR := 1099
  #ES-MSG-FIELD-NAME := 'HOLD'
END-IF
IF NOAB-HOLD-PRINT = ' '
  NOAB-HOLD-PRINT := 'N'
END-IF
IF NOT (NOAB-PRINTER(*)  NE ' ')
  #ES-MSG-NR := 0421
  #ES-MSG-FIELD-NAME := 'PRINT-LIST'
  #ES-MSG-FIELD-INDEX := 1
  ESCAPE ROUTINE
END-IF
FOR #I=1 TO #MAX-PRINTER
  IF NOAB-PRINTER(#I) = ' '
    RESET NOAB-PRINT-COPIES(#I)
  ELSE
    EXAMINE FULL NOAB-PRINTER(*) FOR FULL VALUE OF NOAB-PRINTER(#I)
      GIVING NUMBER #J
    IF #J > 1
      #ES-MSG-NR := 0104     /* printer already defined
      #ES-MSG-FIELD-NAME  := 'PRINT-LIST'
      #ES-MSG-FIELD-INDEX := #I
      ESCAPE ROUTINE
    END-IF
    ES-KEY-PARM(1) := NOAB-PRINTER (#I)
    ES-OBJECT := 'PR'
    ES-FUNCTION := 'EX'
/* check printer existance
    CALLNAT 'NOXXEX-N' ES-CONTROL ES-INPUT
    IF ES-RC NE 0
      #ES-MSG-NR := 0108     /* printer not defined
      #ES-MSG-FIELD-NAME  := 'PRINT-LIST'
      #ES-MSG-FIELD-INDEX := #I
      ESCAPE ROUTINE
    END-IF
    IF ES-USER-TYPE NE 'A'
      #GR-OBJECT := NOAB-PRINTER(#I)
      CALLNAT 'NOGROU-N' 'P' #GR-OBJECT ES-USER #GR-USER #GRANTS(*)
      IF NOT (#GRANTS(*) = 'Y')
        #ES-MSG-NR := 1090
        #ES-MSG-FIELD-NAME  := 'PRINT-LIST'
        #ES-MSG-FIELD-INDEX := #I
        ESCAPE ROUTINE
      END-IF
    END-IF
  END-IF
END-FOR
CALLNAT 'N-SEPME2' ES-CONTROL ES-INPUT NOAB-SEP-START 1X
  NOAB-SEP-END 1X 'B' #ES-MSG-NR #ES-MSG-FIELD-NAME
IF #ES-MSG-NR NE 0
  ESCAPE ROUTINE
END-IF
DECIDE FOR EVERY CONDITION
  WHEN NOAB-CONTROL-EXITMEM = ' ' AND NOAB-CONTROL-EXITLIB NE ' '
    #ES-MSG-NR := 4101
    #ES-MSG-FIELD-NAME := 'CONTROL-EXITMEM'
    ESCAPE ROUTINE
  WHEN NOAB-CONTROL-EXITMEM NE ' ' AND NOAB-CONTROL-EXITLIB = ' '
    #ES-MSG-NR := 1080
    #ES-MSG-FIELD-NAME := 'CONTROL-EXITLIB'
    ESCAPE ROUTINE
  WHEN NOAB-CONTROL-EXITMEM NE ' ' AND NOAB-CONTROL-EXITLIB NE ' '
    ES-KEY-PARM(1) := NOAB-CONTROL-EXITLIB
    ES-KEY-PARM(2) := NOAB-CONTROL-EXITMEM
    CALLNAT 'NOSFEX-N' ES-CONTROL ES-INPUT
    IF ES-RC NE 0
      #ES-MSG-NR  := 1079      /*  Library or member not found
      #ES-MSG-TXT := NOAB-CONTROL-EXITMEM
      #ES-MSG-FIELD-NAME := 'CONTROL-EXITMEM'
      ESCAPE ROUTINE
    END-IF
  WHEN NONE IGNORE
END-DECIDE
*
END-SUBROUTINE /* VALIDATION
*
************************************************************************
DEFINE SUBROUTINE GET-MSG-TXT
************************************************************************
RESET SHORT-MSG LONG-MSG(*)
VERSION := 0
NADA2000.OBJECT-KIND := 'U'
NADA2000.ERROR-NUMBER := #ES-MSG-NR
NADA2000.OPT-INSERT-DYN := FALSE
NADA2000.OPT-LANGUAGE := ES-LANGUAGE
NADA2000.LIBRARY := #LIBRARY-ID
CALLNAT 'NATA2000' NADA2000 NATA2000.EXTENDED-PARMS NAD-MSG NAD-FLD
ES-MSG-NR    := #ES-MSG-NR
ES-MSG-TXT   := SHORT-MSG
IF ES-MSG-NR = 0150               /* enter date in format :1:
  EXAMINE ES-MSG-TXT FOR ':1:' REPLACE #TXT
END-IF
EXAMINE ES-MSG-TXT FOR #ES-MSG-PREF DELETE
EXAMINE ES-MSG-TXT FOR ':1:' REPLACE ' '
EXAMINE ES-MSG-TXT FOR ':2:' REPLACE ' '
ES-MSG-FIELD := #ES-MSG-FIELD
ES-RC := 1
*
END-SUBROUTINE /* GET-MSG-TXT
*
************************************************************************
DEFINE SUBROUTINE WRITE-LOG-RECORD
************************************************************************
IF NOMOD-LOG-TYPES (*) = 'B' AND ES-EXTEND-FUNCTION = 'UPD'
  LG-USERID      := ES-USER
  LG-CODE        := 'AB'
  LG-BUNDLE      := AB-BUNDLE
  LG-BUNDRNB     := AB-BUNDRNB
  COMPRESS NOAB-BUNDLE '-'  NOAB-BUNDRNB INTO LG-OBJECT-NAME
    LEAVING NO
  COMPRESS '2105' LG-OBJECT-NAME TO LG-MSG
  CALLNAT 'NOLG---N' PL-PARMS #USER-LIB
END-IF
*
END-SUBROUTINE /* WRITE-LOG-RECORD
*
END
