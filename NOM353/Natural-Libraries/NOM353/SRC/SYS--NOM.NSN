*  Library ........ SYSAPI
*
*  Function ....... All APIs of Entire Output Management (NOM)
*                   shown with SYSAPI
*
*
*  Parameters ..... 01 PRODUCT-DEFINITIONS
*                     02 PROD-CODE         (A03) - Product code
*                     02 PROD-NAME         (A50) - Product long name
*                     02 PROD-SUBGROUPS    (I02) - number of groups
*                   01 GROUP-DEFINITIONS         - info for each group
*                     02 GROUP-NAME        (A60)
*                     02 DOC-LIBRARY       (A08)
*                     02 DOC-MASK          (A08)
*                     02 API-LIBRARY       (A08)
*                     02 API-MASK          (A08)  - not used on MF
*                     02 EXA-LIBRARY       (A08)  - optional
*                     02 EXA-MASK          (A08)  - optional
*                     02 XML-PGM1          (A8)   - not used on MF
*                     02 XML-PGM2          (A8)   - not used on MF
*                   01 CURRENT-SUBGROUP    (I02)
*                   01 RESPONSE            (N04)
*                   01 VERSION             (I02)
*                   01 ADDITIONALS         (A01/1:V)
*
*  Description .... APIs for NOM 320
*
*  Author ......... R. Kessler
*  Date ........... August,2007
*
****** Maintenance log *************************************************
*
* Date       User    SAGSIS   Description
* ---------- ------- -------  ------------------------------------------
* 2009-01-19 xsetggr P300323  returns to NOM API menu when use NOM APIs
* 2013-09-20 SU1              Avoid NAT0923 after API-GEN
************************************************************************
DEFINE DATA PARAMETER
1 PRODUCT-DEFINITIONS
  2 PROD-CODE         (A03)
  2 PROD-NAME         (A50)
  2 PROD-SUBGROUPS    (I02)
1 GROUP-DEFINITIONS
  2 GROUP-NAME (A60)
  2 DOC-LIBRARY       (A8)
  2 DOC-MASK          (A8)
  2 API-LIBRARY       (A8)
  2 API-MASK          (A8)       /* not used on MF
  2 EXA-LIBRARY       (A8)       /* Optional parameter
  2 EXA-MASK          (A8)       /* Optional parameter
  2 XML-PGM1          (A8)       /* not used on MF
  2 XML-PGM2          (A8)       /* not used on MF
1 CURRENT-SUBGROUP    (I2)
1 RESPONSE            (N4)
1 VERSION             (I2)
1 ADDITONALS          (A1/1:V)
* *****
END-DEFINE
************************************************************************
/*
OPTIONS USREXIT=ON
/*
RESET PROD-CODE PROD-NAME
PROD-CODE      := 'NOM'
PROD-SUBGROUPS := 1
/*
/* Get long name of the product
/*
CALLNAT 'NAT41019' PROD-CODE PROD-NAME
/*
DECIDE ON FIRST VALUE OF CURRENT-SUBGROUP
  VALUE 1
    GROUP-NAME  := 'APIs of Entire Output Management'
    DOC-LIBRARY := 'SYSNOMS'        /* Library for Descriptions
    DOC-MASK    := 'DOC????Ü'
    API-LIBRARY := 'SYSNOM'         /* Library for APIs
    API-MASK    := 'NOM????N'
    EXA-LIBRARY := ' '              /* Library for Examples (if used)
    EXA-MASK    := ' '
    XML-PGM1    := 'NOM-XM1Ü'       /* located in library DOC-LIBRARY
    XML-PGM2    := 'NOM-XM2Ü'
/*SU1 out *STARTUP    := *PROGRAM /* xsetggr 2009-01-19 P300323 in
    *STARTUP    := 'SYSAPI'  /* SU1 in
    /*
    /*
    /* If more groups exist, copy the previous value clause,
    /* increment the value by one and set the variable PROD-SUBGROUPS
    /* to the correct value.
    /*
  NONE VALUE
    IGNORE
END-DECIDE
*
END
