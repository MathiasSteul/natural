* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    RLISLM1
* Version   1.3
* Function  List Monitor log
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* mrs 93-12-01 s(999999) old version saved, various modifications
* mrs 93-12-10 s(999999) length of text display A60 -> A65
* gw  94-01-11 s(999999) remove 'delete' line command
* gw  94-01-18 s(999999) allow log for general users who are
*                        authorized for monitor management
* mrs 95-01-18 p(136331) NAT1320 when evaluating error code
* gw  96-10-15 s(231722) TOP doesn't go top
* jvd 97-10-09 p(163166) Replace Callnat 'OUTDATE' with 'IODATE-N'
*                        Y2C and use only one date routine for NOM
* fhi 00-01-28 p(190228) Get rid of rlislm0* maps (intermediate dialog)
* sju 00-03-28 p(191368) Monitor multitasking
* ws  00-04-01 CE 7267   New PFkey for additional printers in RPFK---L
* ws  00-06-07 CE 7592   DLOG for non-administrators
* xsiszha 2000-08-15 (CE7461) Extend Report and Bundle Names
* fhi 00-09-05 QA01      Return to Father program did not work
* sju 00-11-14 s(999999) SAT logging
* xsetggr 2005-10-26 p(270950) ISN fields must be P10, not P8
* fhi     2005-12-21 QA01      NAT1313 in 4410, add IGNORE in SEPARATE
* fhi     2007-04-04 FHI219    QA01 corrected for Natural Unix Compiler
* xsetggr 2008-05-03 p(303852) use SATLGR2P/N
* fhi     2009-03-23 P315387   Message truncated.
* fhi     2010-09-03 NOMALL-97 Extend message line, old tags deleted,
* xsetggr 2011-09-02 NOMALL-1018 use RSUBMSGN to read msg from SYSERR
* raya    2011-11-24 NOMALL-1080 avoide 1342
* xsetggr 2012-02-02 NOMALL-1100 extract text of msgs - not depends on
*                                the form they are written in log
* raya    2012-11-20 NOMALL-1209 avoide duplicate error 5
* raya    2013-06-19 NOMALL-1259 use SATLGR3P/N
* fhi     2014-08-27 NOMALL-1454 correct messages
* fhi     2014-09-04 NOMALL-1454 same
* SU1     2015-01-26 NOMALL-1388 avoid S0C7/(SAT-288:SATLGR3P changed)
* fhi     2016-11-15 NOMALL-1961 Use new task IDs
* fhi     2017-01-04 NOMALL-1913 Use microseconds for logging
* fhi     2017-10-05 NOMALL-2040 Avoid loop and wrong sequence
* fhi     2018-04-12 NOMALL-1913 Show microseconds
* BLI     2020-01-24 NOMALL-2337 Show logs from user TASKnn
* SU2     2021-04-16 NOMALL-2454 recat RMTASK-P to avoid NAT1305
* ----------------------------------------------------------------------
DEFINE DATA GLOBAL USING  NRM-GL
LOCAL  USING  RLC----L
LOCAL  USING  RPFK---L
LOCAL  USING  ROT----L
LOCAL  USING  SATLGR4P            /* NOMALL-1913 fhi was SATLGR3P
LOCAL  USING  SATLG01E
LOCAL  USING  RMTASK-P            /* NOMALL-1961 fhi in
LOCAL
1 #PANEL                  (I1) INIT <1>
1 #OBJECT-TYPE            (A32)
1 #FATHER-PROG            (A8) INIT <'RHANMO'>
1 #NOFLINES               (P2) INIT <015 >
1 #NOFPAGES               (P3) CONST <0100 >
1 #END-OF-DATA            (L)
1 #CP                     (P3)
1 #MAXP                   (P3)
1 #MAXAP                  (P3)
1 #NEWVAL                 (L)
1 #BACKWARD               (L)
1 #FORWARD                (L)
1 #TOP                    (L)
1 #BOT                    (L)
1 GET-SCREEN              (L)
1 #LAST-KEY               (A16) /* NOMALL-2040 was (A13)
1 REDEFINE    #LAST-KEY
  2 #LK-TIMEINV           (P13)
  2 #LK-MICROSEC          (P5)  /* NOMALL-2040 fhi in
  2 #LK-ISN               (P10)
1 #PAGES                  (A16/#NOFPAGES) /* NOMALL-2040 was (A13...)
1 REDEFINE    #PAGES
  2 #PAGES1               (1:#NOFPAGES)
    3 #PK-TIMEINV         (P13)
    3 #PK-MICROSEC        (P5)  /* NOMALL-2040 fhi in
    3 #PK-ISN             (P10)
1 L-HEADER                (A78)
1 L-SCREEN                (15)
  2 #L-MSG                (A65)
  2 #L-USERID             (A8)
  2 #L-DATE               (A8)
  2 #L-TIME               (A10)
  2 #L-TIME-ZONE          (A5)
  2 L-ISN                 (P10)
1 L-LCMD                  (15)
  2 L-MARK                (A2)
  2 L-IDENT               (I2)
  2 CV-MARK               (C)
1 I                       (N5)
1 #I2                     (N5)
1 #SCROLL-AMOUNT          (N3)
1 F                       (P2)
1 #LANGUAGE               (I1)
1 #ADMIN                  (L)
1 #START                  (L)
1 #STOP                   (L)
1 #DLOG                   (L)
1 #MESSAGE-TEXT           (A250)
1 #FORMATED-DATE          (A10)
1 REDEFINE #FORMATED-DATE
  2 #S-FORMATED-DATE      (A8)
1 #ERROR-CODE             (N4)
1 #ERROR-TEXT             (A250)
1 #WRAP-MESSAGE           (A65/*)
1 #ERN                    (N4)
1 #ERC                    (A250)
1 #STRING                 (A250)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
CALLNAT 'NARPSEC' G-USER-PROFILE 'ADM' #ADMIN
CALLNAT 'NARPSEC' G-USER-PROFILE 'STA' #START
CALLNAT 'NARPSEC' G-USER-PROFILE 'STP' #STOP
CALLNAT 'NARPSEC' G-USER-PROFILE 'DLO' #DLOG
IF NOT (#ADMIN OR #START OR #STOP OR #DLOG)
  G-NATRP-ERC := 0020
  FETCH 'RMENU'
END-IF
*
SATLGR-PRODUCT          := 'NOM'
SATLGR-LANGUAGE         := *LANGUAGE
SATLGR-SEARCH-KEY       := SATLG-ENV-TIMEINV
SATLGR-ACCESS-TYPE      := SATLG-READ
SATLGR-NUMBER-OF-RECORDS:= 20
COMPRESS '     NOM-Monitor -' H'01' TO #OBJECT-TYPE
*
RESET G-LINECOM (*)
G-LINECOM (1) := '<DE#Delete>'
*
#NEWVAL := TRUE
*
MAIN-LOOP. REPEAT
  RESET L-MARK(*)
  IF #LANGUAGE NE *LANGUAGE
    #LANGUAGE := *LANGUAGE
    SATLGR-LANGUAGE:= #LANGUAGE
    CALLNAT 'ROTINI-N' ##EQO-LOG-RECORD G-OBJ-TYPE G-OTB
    PERFORM INIT-LINECOM
    PERFORM INIT-PFKEYS
    GET-SCREEN := TRUE
  END-IF
  PERFORM SET-PFKEYS
  INCLUDE RMVHLP-C
*
  PERFORM GET-SCREEN
  CALLNAT 'N-HEADER' L-HEADER G-DATE-FORMAT 'RLISLGM&'
  INCLUDE C-TOPBOT
  PERFORM FLIP-DISPLAY
  SET CONTROL 'WB'
*
  IF #PANEL = 1
    INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT MARK *G-DIRECT-COMMAND
      USING MAP 'RLISLGM&'
  ELSE
    INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT MARK *G-DIRECT-COMMAND
      USING MAP 'RLISLG2&'
  END-IF
*
  INCLUDE RPFKVA-C
*
  RESET G-NATRP-ERC G-NATRP-ERT
  RESET #FORWARD #BACKWARD #NEWVAL G-NATRP-ERT G-NATRP-ERC
*
  INCLUDE C-DIRECT
*
  RESET #TOP #BOT #SCROLL-AMOUNT
  INCLUDE C-LOCCMD
*
  DECIDE ON FIRST VALUE OF G-PF-FUNC
    VALUE 'HELP'
      REINPUT USING HELP
    VALUE 'EXIT'
      IF #DLOG AND NOT #ADMIN /* QA01 instead
        INCLUDE C-ESCAPE
      END-IF
      PERFORM COMMIT-WORK
      FETCH #FATHER-PROG
    VALUE 'FLIP'
      PERFORM FLIP-HANDLE
    VALUE 'UP'
      #BACKWARD := TRUE
    VALUE 'DOWN'
      #FORWARD := TRUE
    VALUE 'RIGHT'
      IF #PANEL = 1
        #PANEL := 2
      END-IF
    VALUE 'LEFT'
      IF #PANEL = 2
        #PANEL := 1
      END-IF
    VALUE 'MENU'
      INCLUDE C-MENU
    VALUE 'ENTR'
      IF NOT (L-MARK (*) NE ' ')
        #NEWVAL := TRUE
      END-IF
    NONE VALUE
      IGNORE
  END-DECIDE
*
  PERFORM LINE-COMMANDS
*
END-REPEAT
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE GET-SCREEN
************************************************************************
IF G-DIRECT-COMMAND = 'TOP'
  #TOP := TRUE
END-IF
*
RESET G-NATRP-ERT
DECIDE FOR EVERY  CONDITION
  WHEN #NEWVAL OR #TOP
    RESET #PAGES (*) #MAXP #MAXAP #PK-TIMEINV(1) #PK-ISN(1)
      #PK-MICROSEC(1)       /* NOMALL-2040 fhi in
    #CP := #MAXAP := 1
  WHEN #BOT
    #CP := #MAXAP
  WHEN #FORWARD
    IF #END-OF-DATA
      ESCAPE ROUTINE
    END-IF
    IF #CP = #NOFPAGES
      #PAGES (1:#NOFPAGES - 1) := #PAGES (2:#NOFPAGES)
      RESET #PAGES (#CP)
      #PAGES (#CP) := #LAST-KEY
    ELSE
      IF #SCROLL-AMOUNT < 1
        #SCROLL-AMOUNT := 1
      END-IF
      IF #CP + #SCROLL-AMOUNT <= #MAXAP
        #CP := #CP + #SCROLL-AMOUNT
      ELSE
        IF #SCROLL-AMOUNT > 1
          #CP := #MAXAP
        ELSE
          ADD 1 TO #CP
        END-IF
      END-IF
      IF #CP > #MAXAP
        #PAGES(#CP) := #LAST-KEY
      END-IF
    END-IF
  WHEN #BACKWARD
    IF #CP < 2
      IGNORE
    ELSE
      IF #SCROLL-AMOUNT < 1
        #SCROLL-AMOUNT := 1
      END-IF
      SUBTRACT #SCROLL-AMOUNT FROM #CP
      IF #CP < 1
        #CP := 1
      END-IF
    END-IF
  WHEN GET-SCREEN
    IGNORE
  WHEN NONE
    ESCAPE ROUTINE
END-DECIDE
*
IF #CP >= #MAXAP
  #MAXAP := #CP
END-IF
*
SATLGR-START-TIMEINV   := #PK-TIMEINV(#CP)
SATLGR-START-MICROINV3 := #PK-MICROSEC(#CP)
SATLGR-START-ISN       := #PK-ISN(#CP)
*
CV-MARK (*) := (AD=P)
RESET I L-SCREEN (*) #END-OF-DATA
*
RESET I
READ-LOOP. REPEAT
  CALLNAT 'SATLGR4N' SATLGR-PARMS
  FOR #I2 = 1 TO SATLGR-NUMBER-OF-RECORDS
    IF #I2 GT SATLGR-RECORDS-FOUND
      #END-OF-DATA:= TRUE
      ESCAPE BOTTOM(READ-LOOP.)
    END-IF
    RMTASK-P.FUNCTION       := 'L'
    RMTASK-P.SUBTASK-NUMBER := 1
    CALLNAT 'RMTASKID' RMTASK-P
    IF SATLGR-NOM-TYPE(#I2) = 'MO' OR = 'A1' OR = 'R1'
    OR SATLGR-EXEC-USERID(#I2) = 'MONITOR' OR = RMTASK-P.TASK-ID      /*
    OR = MASK('TASK'NN)                                               /*
      ADD 1 TO I
      #L-USERID(I):= SATLGR-EXEC-USERID(#I2)
      L-ISN(I)    := SATLGR-ISN(#I2)
      PERFORM PREPARE-MESSAGE
      #L-MSG (I) := #MESSAGE-TEXT
      MOVE EDITED SATLGR-TIME(#I2) (EM=HH':'II':'SS'.'T) TO #L-TIME(I)
      MOVE EDITED SATLGR-TIME(#I2) (EM=YYYYMMDD)     TO #L-DATE(I)
      MOVE SATLGR-TIME-ZONE(I)                       TO #L-TIME-ZONE(I)
      CALLNAT 'IODATE-N' 'M' 'S' #L-DATE(I) #FORMATED-DATE
        G-DATE-FORMAT #ERROR-CODE #ERROR-TEXT
      IF #ERROR-CODE = 0
        #L-DATE(I) := #S-FORMATED-DATE
      END-IF
      RESET CV-MARK(I)
      IF I = #NOFLINES
        ESCAPE BOTTOM(READ-LOOP.)
      END-IF
    END-IF
  END-FOR
  SATLGR-START-TIMEINV  := SATLGR-TIME-INV(SATLGR-NUMBER-OF-RECORDS)
  SATLGR-START-MICROINV3:= SATLGR-MICROSEC-INV(SATLGR-NUMBER-OF-RECORDS)
  SATLGR-START-ISN      := SATLGR-ISN(SATLGR-NUMBER-OF-RECORDS)
END-REPEAT
*
IF NOT #END-OF-DATA
  IF #I2 GT SATLGR-NUMBER-OF-RECORDS
    #I2:= SATLGR-NUMBER-OF-RECORDS
  END-IF
  #LK-TIMEINV  := SATLGR-TIME-INV(#I2)
  #LK-MICROSEC := SATLGR-MICROSEC-INV(#I2)
  #LK-ISN      := SATLGR-ISN(#I2)
ELSE
  #MAXP := #CP
END-IF
*
END-SUBROUTINE /* GET-SCREEN
*
************************************************************************
DEFINE SUBROUTINE PREPARE-MESSAGE
************************************************************************
RESET #ERN
SEPARATE SATLGR-MESSAGE(#I2) INTO #ERC
  REMAINDER #STRING WITH DELIMITER ' '
DECIDE FOR FIRST CONDITION
  WHEN #ERC IS (N4)
    #ERN := VAL(#ERC)
    MOVE EDITED #ERN (EM=9999) TO #ERC
  WHEN SATLGR-MESSAGE(#I2) = MASK ('NOM'NNNN' ')
    #ERC    := SUBSTR(SATLGR-MESSAGE(#I2),4,4)
    #ERN    := VAL(#ERC)
    SATLGR-MESSAGE(#I2) := SUBSTR(SATLGR-MESSAGE(#I2),4)
  WHEN NONE
    IGNORE
END-DECIDE
#MESSAGE-TEXT := SATLGR-MESSAGE(#I2)
CALLNAT 'RSUBMSGN' #MESSAGE-TEXT
IF #MESSAGE-TEXT NE ' '
  PERFORM XXWRAP-WORD-WRAP 'L' #MESSAGE-TEXT #WRAP-MESSAGE (*) 65
  #MESSAGE-TEXT := #WRAP-MESSAGE (1)
END-IF
*
END-SUBROUTINE /* PREPARE-MESSAGE
*
************************************************************************
DEFINE SUBROUTINE LINE-COMMANDS
************************************************************************
RESET L-IDENT (*)
INCLUDE RLCMTI-C
*
FOR I 1 TO #NOFLINES
  IF L-IDENT (I) = ##EQU-INFO
    FETCH RETURN 'RINFLO' L-ISN (I)
  END-IF
END-FOR
*
END-SUBROUTINE /* LINE-COMMANDS
*
************************************************************************
DEFINE SUBROUTINE INIT-LINECOM
************************************************************************
G-LC-IDENT (01) := ##EQU-INFO
G-LC-NUM        := 1
CALLNAT 'RLCINI-N' G-OBJ-TYPE G-LC G-LCB
CALLNAT 'RFLIPG-N' G-LC G-LINECOM (*)
*
END-SUBROUTINE /* INIT-LINECOM
*
************************************************************************
DEFINE SUBROUTINE INIT-PFKEYS
************************************************************************
INCLUDE RPFSTD-C
INCLUDE RPFBRW-C
INCLUDE RPFLR--C
CALLNAT 'RPFINI-N' G-PF G-PFB
*
END-SUBROUTINE /* INIT-PFKEYS
* --------------------------------------- set pfkeys -------------------
INCLUDE RPFSET-C
*
END
