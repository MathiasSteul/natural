* ---------------------------------------------------------------------
DEFINE DATA PARAMETER USING EOM----P
PARAMETER USING EOMBUM-P
PARAMETER USING EOMMSG-P
************************************************************************
LOCAL USING EOMBUM-E
LOCAL USING EOM----E
LOCAL USING EOMPHTYE
LOCAL USING RLOG-L
LOCAL USING EOMGRM-P
LOCAL USING EOMBRM-P
*
LOCAL
1 BUNDLE VIEW OF NRM-BUNDLES
  2 B-BUNDLE
  2 B-FLUSH-EVENTS (1:8)
    3 B-FLUSH-REPORTS
  2 B-LAST-MODIFIED
  2 B-MODIFIED-BY
1 REPORT VIEW OF NRM-REPORTS-NEW
1 BUNDLE-REPORT VIEW OF NRM-BUNDLE-REPORT
  2 BR-BUNDLE
  2 REDEFINE BR-BUNDLE
    3 BR-BUNDLE-8 (A8)
  2 BR-REPNAME
  2 BR-PRINTER
  2 BR-GROUP
  2 BR-SEQNO
  2 BR-SEPNO
  2 BR-REPNO
  2 BR-PAGEDEF
  2 BR-FORMDEF
1 USER VIEW OF NRM-USERS
  2 USER-PROFILE
  2 REDEFINE USER-PROFILE
    3 USER-TYPE     (A1)
1 PRINTERS VIEW OF NRM-PRINTERS
  2 P-DISP
  2 P-PHYSICAL-NAME
1 PHYSICAL VIEW OF NRM-PHYSICAL-PRINTERS
  2 PH-PRINTER-TYPE
* *****
1 #FLUSH-START-CH   (A4)
1 REDEFINE #FLUSH-START-CH
  2 #FLUSH-START    (N4)
  2 REDEFINE #FLUSH-START
    3 #FLUSH-START-N1 (N2)
    3 #FLUSH-START-N2 (N2)
1 #FLUSH-END-CH     (A4)
1 REDEFINE #FLUSH-END-CH
  2 #FLUSH-END      (N4)
  2 REDEFINE #FLUSH-END
    3 #FLUSH-END-N1 (N2)
    3 #FLUSH-END-N2 (N2)
1 #FLUSH-INT        (A4)
1 REDEFINE #FLUSH-INT
  2 #FLUSH-INT-N1   (N2)
  2 #FLUSH-INT-N2   (N2)
1 #MSG-NR           (N4)
1 #NOF              (I2) CONST <4>
1 #PRINTER-NMB      (N2) CONST <20>
1 #FUNCTION         (A1/1:#NOF) INIT <'O','P','M','D'>
1 #SECURITY-OPTION  (A3)
1 #FLUSH-REPORTS    (A25/1:8)
1 #NAME             (A50)
1 REDEFINE #NAME
  2 #BUNDLE         (A25)
  2 #REPORT         (A25)
1 I                 (I2)
1 N                 (N2)
1 M                 (N2)
1 F                 (I02)
1 ALLOWED           (L)
1 EXIST             (L)
1 OJ                (I2)
1 OT                (I2)
1 #GRANTS           (A1/1:6)
1 #USER-ID          (A8)
1 #OBJECT-NAME      (A25)
1 #NEXT-BUNDLE      (A25)
1 REDEFINE #NEXT-BUNDLE
  2 #NEXT-BUNDLE-24 (A24)
  2 #NEXT-BUNDLE-1  (I1)
1 #OBJ              (A50)
1 #USER             (A8)
1 #APPL             (A8)
* fhi     2017-06-29 NOMALL-2029 start insertion
1 #TRACING            (L)
1 #TRACE-MSG          (A250)
* fhi     2017-06-29 NOMALL-2029 end   insertion
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
* fhi     2017-06-29 NOMALL-2029 start insertion
IF *DEVICE NE 'BATCH'
  PERFORM RMGTRACO-GET-SETTINGS #TRACING
ELSE
  PERFORM RMGTRACE-GET-SETTINGS #TRACING
END-IF
* fhi     2017-06-29 NOMALL-2029 end   insertion
RESET EOMMSG-PARMS
*
PERFORM SECURITY-CHECK
IF EOMMSG-NR NE 0 AND EOMBUM-EOF = 'X'
  ESCAPE ROUTINE
END-IF
*
PERFORM LOGGING-CHECK
*
IF EOM-FUNCTION NE EOM-SECURITY-CHECK
  EOMBUM-I-CHECK-FUNCTION := EOM-FUNCTION
  PERFORM FUNCTION-SECURITY
  IF EOMMSG-NR NE 0
    ESCAPE ROUTINE
  END-IF
END-IF
*
* fhi     2017-06-29 NOMALL-2029 start insertion
IF #TRACING
  IF EOM-FUNCTION > 0 AND EOM-FUNCTION <= EOM-MAX
    #TRACE-MSG := EOM-TEXTS(EOM-FUNCTION)
  ELSE
    #TRACE-MSG := 'Unknown function'
  END-IF
  COMPRESS #TRACE-MSG 'function executing' TO #TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
END-IF
* fhi     2017-06-29 NOMALL-2029 end   insertion
DECIDE ON FIRST EOM-FUNCTION
  VALUE EOM-SECURITY-CHECK PERFORM FUNCTION-SECURITY
  VALUE EOM-INIT           PERFORM INIT-BUNDLE-ATTRIBUTES
  VALUE EOM-ADD            PERFORM MODIFY-BUNDLE-ATTRIBUTES
  VALUE EOM-DELETE         PERFORM DELETE-BUNDLE-DEFINITION
  VALUE EOM-COPY           PERFORM COPY-BUNDLE
  VALUE EOM-RENAME         PERFORM RENAME-BUNDLE
  VALUE EOM-COMMIT         END OF TRANSACTION
  VALUE EOM-READ, EOM-READHOLD, EOM-READ-NEXT, EOM-READHOLD-NEXT
    PERFORM READ-BUNDLE-ATTRIBUTES
  VALUE EOM-MODIFY
    IF EOMBUM-I-REP-FUNCTION = 0
      PERFORM MODIFY-BUNDLE-ATTRIBUTES
    ELSE
      PERFORM CHECK-REPORT-FUNCTION
    END-IF
  VALUE EOM-BACKOUT
    RESET EOM-LOG-FUNCTION EOM-LOG-OBJECT-NAME
    BACKOUT TRANSACTION
  NONE  IGNORE
END-DECIDE
*
* fhi     2017-06-29 NOMALL-2029 start insertion
IF #TRACING
  IF EOM-FUNCTION > 0 AND EOM-FUNCTION <= EOM-MAX
    #TRACE-MSG := EOM-TEXTS(EOM-FUNCTION)
  ELSE
    #TRACE-MSG := 'Unknown function'
  END-IF
  COMPRESS #TRACE-MSG EOMBUM-I-NAME EOMBUM-I-NEWNAME
    'got RC' EOMMSG-NR EOMMSG-TEXT TO #TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
END-IF
* fhi     2017-06-29 NOMALL-2029 end   insertion
*
IF EOM-LOG AND EOMMSG-NR = 0
  PERFORM WRITE-LOG-RECORD
END-IF
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE CHECK-REPORT-FUNCTION
************************************************************************
PERFORM VALIDATE-KEY
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
*
PERFORM REPORT-VALIDATE-KEY
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
*
DECIDE ON FIRST EOMBUM-I-REP-FUNCTION
  VALUE EOM-READ, EOM-READHOLD  PERFORM READ-BUNDLED-REPORT
  VALUE EOM-ADD                 PERFORM MODIFY-BUNDLED-REPORT
  VALUE EOM-MODIFY              PERFORM MODIFY-BUNDLED-REPORT
  VALUE EOM-DELETE              PERFORM DELETE-BUNDLED-REPORT
  VALUE EOM-COMMIT              END OF TRANSACTION
  VALUE EOM-BACKOUT             BACKOUT TRANSACTION
  NONE  IGNORE
END-DECIDE
*
END-SUBROUTINE /* CHECK-REPORT-FUNCTION
*
************************************************************************
DEFINE SUBROUTINE LOGGING-CHECK
************************************************************************
IF EOM-LOG-OBJTYP='B'
  ESCAPE ROUTINE
END-IF
*
RESET EOM-LOGGING
EOM-LOG-OBJTYP:='B'
EOM-LOG := TRUE
*
IF EOM-LOG-TYPES(*) = 'B'
  EOM-LOG := TRUE
END-IF
*
END-SUBROUTINE /* LOGGING-CHECK
*
************************************************************************
DEFINE SUBROUTINE WRITE-LOG-RECORD
************************************************************************
IF EOM-LOG-FUNCTION = EOM-FUNCTION AND EOM-LOG-OBJECT-NAME=EOMBUM-I-NAME
  ESCAPE ROUTINE
END-IF
*
DECIDE ON FIRST EOM-FUNCTION
  VALUE EOM-ADD
    #MSG-NR := 2505
    LG-MSG  := EOMBUM-I-NAME
    RESET EOM-LOG-OBJECT-NAME
  VALUE EOM-MODIFY
    #MSG-NR := 2506
    LG-MSG := EOMBUM-I-NAME
    LG-OBJECT-NAME := EOMBUM-I-NAME
  VALUE EOM-DELETE
    #MSG-NR := 2509
    LG-MSG         := EOMBUM-I-NAME
    RESET  EOM-LOG-OBJECT-NAME
  VALUE EOM-RENAME
    #MSG-NR := 2507
    COMPRESS EOMBUM-I-NAME EOMBUM-I-NEWNAME TO LG-MSG
    LG-OBJECT-NAME := EOMBUM-I-NAME
  VALUE EOM-COPY
    #MSG-NR := 2508
    COMPRESS EOMBUM-I-NAME EOMBUM-I-NEWNAME TO LG-MSG
    LG-OBJECT-NAME := EOMBUM-I-NAME
  ANY VALUE
    LG-USERID        := EOM-USER
    LG-CODE          := 'BM'
    LG-BUNDLE        := EOMBUM-I-NAME
    LG-OBJECT-NAME   := EOMBUM-I-NAME
    EOM-LOG-FUNCTION := EOM-FUNCTION
    COMPRESS #MSG-NR LG-MSG TO LG-MSG
    CALLNAT 'RLOG' PL-PARMS
  NONE VALUE IGNORE
END-DECIDE
*
END-SUBROUTINE /* WRITE-LOG-RECORD
*
************************************************************************
DEFINE SUBROUTINE SECURITY-CHECK
************************************************************************
IF EOM-OBJTYP NE 'B'
  IF EOM-USER = ' ' AND EOM-USER-TYPE NE 'A'
    EOMMSG-NR         := 0048
    EOMMSG-FIELD-NAME := 'EOM-USER'
    ESCAPE ROUTINE
  END-IF
  EOM-OBJTYP := 'B'
*
  IF EOM-USER-TYPE NE 'A'
    FNDUS. FIND USER WITH USER-ID = EOM-USER
      IF NO RECORDS FOUND
        IF EOM-DEF-USER NE 'Y'
          EOMMSG-NR         := 0002
          EOMMSG-TOKEN(1)   := EOM-USER
          EOMMSG-FIELD-NAME := 'EOM-USER'
          ESCAPE ROUTINE
        END-IF
        FIND USER WITH USER-ID = 'DEFAULT'
          EOM-USER-PROFILE := USER-PROFILE
          EOM-USER-TYPE    := USER-TYPE
        END-FIND
        ESCAPE BOTTOM(FNDUS.)
      END-NOREC
      EOM-USER-PROFILE := USER-PROFILE
      EOM-USER-TYPE    := USER-TYPE
    END-FIND
  END-IF
*
  IF EOM-USER-TYPE = 'A'
    EOM-OBJTYP-SECURITY (*) := 'Y'
  ELSE
    EOM-OBJTYP-SECURITY (*) := 'N'
    FOR I = 2 TO 4
      COMPRESS #FUNCTION (I) 'BU' TO #SECURITY-OPTION LEAVING NO
      RESET ALLOWED
      CALLNAT 'NARPSEC' EOM-USER-PROFILE #SECURITY-OPTION ALLOWED
      IF ALLOWED
        EOM-OBJTYP-SECURITY (I:6) := 'Y'
        ESCAPE BOTTOM
      END-IF
    END-FOR
  END-IF
  RESET EOM-OBJECT-NAME EOM-OBJECT-SECURITY(*)
END-IF
*
IF EOM-FUNCTION = EOM-ADD
  EOM-OBJECT-NAME := EOMBUM-I-NAME
  EOM-OBJECT-SECURITY(*) := EOM-OBJTYP-SECURITY(*)
  IF EOM-OBJTYP-SECURITY(2) = 'Y' OR EOM-OBJTYP-SECURITY(3) = 'Y'
    EOM-OBJECT-SECURITY (1) := 'Y'
  ELSE
    EOM-OBJECT-SECURITY(1) := 'N'
  END-IF
END-IF
RESET EOMBUM-EOF
IF EOM-FUNCTION = EOM-READ-NEXT OR = EOM-READHOLD-NEXT
  IF EOM-FUNCTION=EOM-READ-NEXT AND NOT(EOM-OBJTYP-SECURITY(1:4) ='Y')
  OR EOM-FUNCTION=EOM-READHOLD-NEXT                                   /*
  AND NOT(EOM-OBJTYP-SECURITY(1:3)='Y')                               /*
    EOMMSG-NR := 0020
    ESCAPE ROUTINE
  END-IF
  RESET EOM-OBJECT-NAME EOMBUM-EOF
  EOMBUM-EOF := 'X'
  #NEXT-BUNDLE := EOMBUM-I-NAME
  ADD 1 TO #NEXT-BUNDLE-1
  READ BUNDLE WITH B-BUNDLE = #NEXT-BUNDLE
    IF EOM-USER-TYPE = 'A'
      EOM-OBJTYP-SECURITY(*) := 'Y'
      RESET EOMBUM-EOF
    ELSE
      #USER-ID := EOM-USER
      CALLNAT 'RGRANT-N' #USER-ID EOM-OBJTYP B-BUNDLE ALLOWED #GRANTS(*)
      IF ALLOWED AND (EOM-FUNCTION = EOM-READ-NEXT AND #GRANTS(1:4) ='Y'
          OR EOM-FUNCTION = EOM-READHOLD-NEXT AND  #GRANTS (1:3) = 'Y')
        EOM-OBJTYP-SECURITY(1) := #GRANTS(1)
        EOM-OBJTYP-SECURITY(2) := #GRANTS(2)
        EOM-OBJTYP-SECURITY(3) := #GRANTS(3)
        EOM-OBJTYP-SECURITY(4:6) := #GRANTS(4:6)
        RESET EOMBUM-EOF
      END-IF
    END-IF
    IF EOMBUM-EOF = ' '
      EOM-OBJECT-NAME := EOMBUM-I-NAME := B-BUNDLE
      ESCAPE BOTTOM
    END-IF
  END-READ
END-IF
*
IF EOM-OBJECT-NAME NE EOMBUM-I-NAME AND EOMBUM-EOF = ' '
  EOM-OBJECT-NAME := EOMBUM-I-NAME
  IF EOM-USER-TYPE = 'A'
    EOM-OBJECT-SECURITY(*) := 'Y'
  ELSE
    EOM-OBJECT-SECURITY(*) := EOM-OBJTYP-SECURITY(*)
  END-IF
END-IF
*
IF NOT (EOM-OBJTYP-SECURITY (*) = 'Y') AND EOMBUM-EOF = ' '
  EOMMSG-NR := 0020
  ESCAPE ROUTINE
END-IF
*
END-SUBROUTINE /* SECURITY-CHECK
*
************************************************************************
DEFINE SUBROUTINE FUNCTION-SECURITY
************************************************************************
EXAMINE EOM-OBJECT-SECURITY(*) FOR 'Y' GIVING INDEX IN OJ
EXAMINE EOM-OBJTYP-SECURITY(*) FOR 'Y' GIVING INDEX IN OT
*
DECIDE ON FIRST EOMBUM-I-CHECK-FUNCTION
  VALUE EOM-SECURITY-CHECK, EOM-COMMIT, EOM-BACKOUT
    IGNORE
  VALUE EOM-ADD, EOM-READHOLD, EOM-READHOLD-NEXT, EOM-MODIFY,
      EOM-INIT, EOM-COPY, EOM-RENAME
    IF OJ > 3 OR OT > 3
      EOMMSG-NR := 0020
    END-IF
  VALUE EOM-READ, EOM-READ-NEXT
    IF OJ > 4 OR OT > 4
      EOMMSG-NR := 0020
    END-IF
  VALUE EOM-DELETE
    IF OJ > 2 OR OT > 2
      EOMMSG-NR := 0020
    END-IF
  NONE VALUE
    EOMMSG-NR := 2600
END-DECIDE
*
END-SUBROUTINE /* FUNCTION-SECURITY
*
************************************************************************
DEFINE SUBROUTINE READ-BUNDLE-ATTRIBUTES
************************************************************************
IF EOM-FUNCTION = EOM-READ OR = EOM-READHOLD
  PERFORM VALIDATE-KEY
END-IF
*
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
*
PERFORM REPORT-VALIDATE-KEY
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
*
PERFORM BUNDLE-ATTRIBUTE-INTERFACE
*
END-SUBROUTINE /* READ-BUNDLE-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE MODIFY-BUNDLE-ATTRIBUTES
************************************************************************
PERFORM VALIDATE-KEY
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
*
PERFORM VALIDATION
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
*
IF EOM-FUNCTION = EOM-ADD
  PERFORM REPORT-VALIDATE-KEY
  IF EOMMSG-NR NE 0
    ESCAPE ROUTINE
  END-IF
END-IF
*
PERFORM BUNDLE-ATTRIBUTE-INTERFACE
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
IF EOMBUM-I-ATTRIBUTE-TYPE NE BUNDLE-GENERAL-ATTRIBUTES
  FND. FIND BUNDLE  WITH B-BUNDLE = EOMBUM-I-NAME
    GT. GET BUNDLE *ISN(FND.)
    B-LAST-MODIFIED := *TIMX
    B-MODIFIED-BY   := EOM-USER
    UPDATE (GT.)
  END-FIND
END-IF
*
IF EOM-FUNCTION = EOM-ADD
  EOMGRM-I-NAME := EOMBUM-I-NAME
  EOMGRM-I-TYPE := 'B'
  EOMGRM-I-USER := EOM-USER
  EOMGRM-OPTION (*) := 'Y'
  CALLNAT 'EOMGRM-N'      /* maintenance of EOM Object >>>Grants<<<
    EOM-ADD EOMGRM-PARMS EOMMSG-PARMS
END-IF
*
END-SUBROUTINE /* MODIFY-BUNDLE-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE COPY-BUNDLE
************************************************************************
PERFORM REPORT-VALIDATE-KEY
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
*
IF NOT (EOMBUM-I-COPY-AUTHORIZATION = ' ' OR ='Y' OR ='N')
  EOMBUM-I-COPY-AUTHORIZATION := 'N'
END-IF
*
IF EOMBUM-I-NEWNAME = ' '
  EOMMSG-NR := 0405
  EOMMSG-FIELD-NAME := 'EOMBUM-I-NEWNAME'
  ESCAPE ROUTINE
END-IF
*
MOVE LEFT JUSTIFIED EOMBUM-I-NEWNAME TO EOMBUM-I-NEWNAME
IF EOMBUM-I-NEWNAME NE MASK (P.......)
  EOMMSG-NR := 0019
  EOMMSG-FIELD-NAME := 'EOMBUM-I-NEWNAME'
  ESCAPE ROUTINE
END-IF
/* DB Interface of EOM Object Bundle /* (dlete, copy, rename)
CALLNAT 'EOMBUMVN' EOM-PARMS EOMBUM-PARMS EOMMSG-PARMS
*
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
*
EOMGRM-I-TYPE := 'B'
IF EOMBUM-I-COPY-AUTHORIZATION = 'Y'
  EOMGRM-I-NAME    := EOMBUM-I-NAME
  EOMGRM-I-NEWNAME := EOMBUM-I-NEWNAME
  CALLNAT 'EOMGRM-N' EOM-COPY EOMGRM-PARMS EOMMSG-PARMS /*Object Grant
ELSE
  RESET  EOMGRM-I-AUTO-COMMIT
  EOMGRM-I-NAME    := EOMBUM-I-NEWNAME
  EOMGRM-I-USER    := EOM-USER
  EOMGRM-OPTION(*) := 'Y'
  CALLNAT 'EOMGRM-N' EOM-ADD EOMGRM-PARMS EOMMSG-PARMS /*Object Grant
END-IF
*
END-SUBROUTINE /* COPY-BUNDLE
*
************************************************************************
DEFINE SUBROUTINE RENAME-BUNDLE
************************************************************************
PERFORM REPORT-VALIDATE-KEY
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
*
IF EOMBUM-I-NEWNAME = ' '
  EOMMSG-NR := 0405
  EOMMSG-FIELD-NAME := 'EOMBUM-I-NEWNAME'
  ESCAPE ROUTINE
END-IF
*
IF EOMBUM-I-NEWNAME NE MASK (P.......)
  EOMMSG-NR := 0019
  EOMMSG-FIELD-NAME := 'EOMBUM-I-NEWNAME'
  ESCAPE ROUTINE
END-IF
*
/* DB Interface EOM Object Bundle /* (delete, copy, rename)
CALLNAT 'EOMBUMVN' EOM-PARMS EOMBUM-PARMS EOMMSG-PARMS
*
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
*
EOMGRM-I-TYPE    := 'B'
EOMGRM-I-NEWNAME := EOMBUM-I-NEWNAME
EOMGRM-I-NAME    := EOMBUM-I-NAME
RESET  EOMGRM-I-AUTO-COMMIT EOMGRM-I-USER
CALLNAT 'EOMGRM-N'       /* Maintenance of EOM Object >>>Grant<<<
  EOM-RENAME EOMGRM-PARMS EOMMSG-PARMS
*
END-SUBROUTINE /* RENAME-BUNDLE
*
************************************************************************
DEFINE SUBROUTINE VALIDATION
************************************************************************
DECIDE ON FIRST VALUE OF EOMBUM-I-ATTRIBUTE-TYPE
  VALUE BUNDLE-GENERAL-ATTRIBUTES
    PERFORM VALIDATE-GENERAL-ATTRIBUTES
  VALUE BUNDLE-PRINTING-ATTRIBUTES
    PERFORM VALIDATE-PRINTING-ATTRIBUTES
  NONE  IGNORE
END-DECIDE
*
END-SUBROUTINE /* VALIDATION
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-KEY
************************************************************************
IF EOMBUM-I-NAME = ' '
  EOMMSG-NR := 0042
  EOMMSG-FIELD-NAME := 'EOMBUM-I-NAME'
  ESCAPE ROUTINE
END-IF
*
MOVE LEFT JUSTIFIED EOMBUM-I-NAME TO EOMBUM-I-NAME
IF EOMBUM-I-NAME NE MASK (P.......)
  EOMMSG-NR := 0019
  EOMMSG-FIELD-NAME := 'EOMBUM-I-NAME'
  ESCAPE ROUTINE
END-IF
*
END-SUBROUTINE /* VALIDATE-KEY
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-GENERAL-ATTRIBUTES
************************************************************************
IF NOT (EOMBUM-BUNDLE-STATUS = 'S' OR = 'M')
  EOMBUM-BUNDLE-STATUS := 'M'
END-IF
*
IF EOMBUM-COORDINATOR-ID > ' '
  CALLNAT 'RCHKUS' EOMBUM-COORDINATOR-ID EXIST /*userid exist?
  IF NOT EXIST AND EOM-DEF-USER NE 'Y'
    EOMMSG-NR := 0002
    EOMMSG-TOKEN(1) := EOMBUM-COORDINATOR-ID
    EOMMSG-FIELD-NAME := 'EOMBUM-COORDINATOR-ID'
    ESCAPE ROUTINE
  END-IF
ELSE
  EOMBUM-COORDINATOR-ID := EOM-USER
END-IF
*
IF EOMBUM-RET-NUMBER = 0
AND ( EOMBUM-RET-FACTOR NE ' ' OR EOMBUM-RET-CALENDAR NE ' ' )        /*
  EOMMSG-NR := 0415           /* enter ret period
  EOMMSG-FIELD-NAME := 'EOMBUM-RET-NUMBER'
  ESCAPE ROUTINE
END-IF
IF EOMBUM-RET-NUMBER > 0
  CALLNAT 'RCHKRETU' EOMBUM-RET-FACTOR EOMMSG-NR
  IF EOMMSG-NR NE 0
    EOMMSG-NR := 0634    /* invalid retention period
    EOMMSG-FIELD-NAME := 'EOMBUM-RET-FACTOR'
    ESCAPE ROUTINE
  END-IF
  IF EOMBUM-RET-CALENDAR > ' '
    CALLNAT 'RCHKCA' EOMBUM-RET-CALENDAR EXIST
    IF NOT EXIST
      EOMMSG-NR := 2004
      EOMMSG-FIELD-NAME := 'EOMBUM-RET-CALENDAR'
      ESCAPE ROUTINE
    END-IF
    EOMBUM-RET-FACTOR := 'W'
  END-IF
  IF NOT (EOMBUM-RET-FACTOR='W' OR ='A' OR ='V' OR ='M')
    EOMMSG-NR := 0634
    EOMMSG-FIELD-NAME := 'EOMBUM-RET-FACTOR'
    ESCAPE ROUTINE
  END-IF
END-IF
*
IF EOMBUM-RET-PURGE-NUMBER = 0 AND (EOMBUM-RET-PURGE-FACTOR NE ' '
OR EOMBUM-RET-PURGE-CALENDAR NE ' ' )                                 /*
  EOMMSG-NR := 0415           /* enter ret period
  EOMMSG-FIELD-NAME := 'EOMBUM-RET-NUMBER'
  ESCAPE ROUTINE
END-IF
IF EOMBUM-RET-PURGE-NUMBER > 0
  CALLNAT 'RCHKRETU' EOMBUM-RET-PURGE-FACTOR EOMMSG-NR
  IF EOMMSG-NR NE 0
    EOMMSG-NR := 0634    /* invalid retention period
    EOMMSG-FIELD-NAME := 'EOMBUM-RET-PURGE-FACTOR'
    ESCAPE ROUTINE
  END-IF
  IF EOMBUM-RET-PURGE-CALENDAR > ' '
    CALLNAT 'RCHKCA' EOMBUM-RET-PURGE-CALENDAR EXIST
    IF NOT EXIST
      EOMMSG-NR := 2004
      EOMMSG-FIELD-NAME := 'EOMBUM-RET-PURGE-CALENDAR'
      ESCAPE ROUTINE
    END-IF
    EOMBUM-RET-PURGE-FACTOR := 'W'
  END-IF                     /* xsetggr 2012-06-19 NOMALL-1163 end
  IF NOT (EOMBUM-RET-PURGE-FACTOR='W' OR ='A' OR ='V' OR='M')
    EOMMSG-NR := 0634
    EOMMSG-FIELD-NAME := 'EOMBUM-RET-PURGE-FACTOR'
    ESCAPE ROUTINE
  END-IF
END-IF
*
IF EOMBUM-RET-FACTOR = 'W' AND EOMBUM-RET-CALENDAR = ' '
  EOMMSG-NR := 2003
  EOMMSG-FIELD-NAME:='EOMBUM-RET-CALENDAR'
  ESCAPE ROUTINE
END-IF
*
IF EOMBUM-RET-PURGE-FACTOR = 'W' AND EOMBUM-RET-PURGE-CALENDAR = ' '
  EOMMSG-NR := 2003
  EOMMSG-FIELD-NAME:='EOMBUM-RET-PURGE-CALENDAR'
  ESCAPE ROUTINE
END-IF
*
IF EOMBUM-FLUSH-TIME-SCHEDULE=' '
  EOMBUM-FLUSH-TIME-SCHEDULE:='N'
END-IF
IF NOT(EOMBUM-FLUSH-TIME-SCHEDULE='Y' OR ='N')
  EOMMSG-NR := 1099
  EOMMSG-FIELD-NAME:='EOMBUM-FLUSH-TIME-SCHEDULE'
  ESCAPE ROUTINE
END-IF
*
IF EOMBUM-FLUSH-START > ' '
  EOMBUM-FLUSH-TIME-SCHEDULE := 'Y'
  #FLUSH-START-CH := EOMBUM-FLUSH-START
  IF EOMBUM-FLUSH-START NE MASK(NNNN)
    EOMMSG-NR         := 0051
    EOMMSG-FIELD-NAME := 'EOMBUM-FLUSH-START'
    ESCAPE ROUTINE
  END-IF
  IF #FLUSH-START-N1 > 24 OR #FLUSH-START-N2 > 59
    EOMMSG-NR         := 0051
    EOMMSG-FIELD-NAME := 'EOMBUM-FLUSH-START'
    ESCAPE ROUTINE
  END-IF
  IF EOMBUM-FLUSH-END > ' '
    #FLUSH-END-CH := EOMBUM-FLUSH-END
    IF #FLUSH-END-N1 < #FLUSH-START-N1
      EOMMSG-NR := 0055
      ESCAPE ROUTINE
    END-IF
    IF #FLUSH-END-N1=#FLUSH-START-N1 AND #FLUSH-END-N2 < #FLUSH-START-N2
      EOMMSG-NR := 0055
      ESCAPE ROUTINE
    END-IF
  END-IF
END-IF
*
IF EOMBUM-FLUSH-END > ' '
  EOMBUM-FLUSH-TIME-SCHEDULE := 'Y'
  #FLUSH-END-CH := EOMBUM-FLUSH-END
  IF EOMBUM-FLUSH-END NE MASK(NNNN) OR #FLUSH-END-N1 > 24
  OR #FLUSH-END-N2 > 59                                               /*
    EOMMSG-NR         := 0051
    EOMMSG-FIELD-NAME := 'EOMBUM-FLUSH-END'
    ESCAPE ROUTINE
  END-IF
END-IF
*
IF EOMBUM-FLUSH-INT > ' '
  EOMBUM-FLUSH-TIME-SCHEDULE := 'Y'
  #FLUSH-INT := EOMBUM-FLUSH-INT
  IF EOMBUM-FLUSH-INT NE MASK(NNNN)
      OR #FLUSH-INT-N1 > 24 OR #FLUSH-INT-N2 > 59
    EOMMSG-NR         := 0051
    EOMMSG-FIELD-NAME := 'EOMBUM-FLUSH-INT'
    ESCAPE ROUTINE
  END-IF
END-IF
*
FOR N=1 TO 7
  IF EOMBUM-FLUSH-WEEK-DAYS(N) = ' '
    ESCAPE TOP
  END-IF
  IF EOMBUM-FLUSH-TIME-SCHEDULE = 'N'
    EOMBUM-FLUSH-TIME-SCHEDULE := 'Y'
    ESCAPE ROUTINE
  END-IF
  IF NOT (EOMBUM-FLUSH-WEEK-DAYS(N)='SA' OR ='SU' OR ='MO' OR ='TU'
      OR ='WE' OR ='TH' OR ='FR')
    EOMMSG-NR := 0057
    EOMMSG-FIELD-NAME := 'EOMBUM-FLUSH-WEEK-DAYS(N)'
    ESCAPE ROUTINE
  END-IF
  IF EOMBUM-FLUSH-CALENDAR=' '
    EOMMSG-NR := 2003
    ESCAPE ROUTINE
  END-IF
  FOR M=1 TO 30
    IF EOMBUM-FLUSH-DAYS(M) > ' '
      EOMMSG-NR := 0630
      ESCAPE ROUTINE
    END-IF
  END-FOR
END-FOR
*
IF EOMBUM-FLUSH-CALENDAR > ' ' AND EOMBUM-FLUSH-BEFORE-AFTER = ' '
  EOMMSG-NR := 0060
  EOMMSG-FIELD-NAME := 'EOMBUM-FLUSH-BEFORE-AFTER'
  ESCAPE ROUTINE
END-IF
*
END-SUBROUTINE /* VALIDATE-GENERAL-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-PRINTING-ATTRIBUTES
************************************************************************
IF EOMBUM-HOLD-PRINT = ' '
  EOMBUM-HOLD-PRINT := 'N'
END-IF
IF NOT (EOMBUM-HOLD-PRINT='Y' OR ='N')
  EOMMSG-NR:=1099
  EOMMSG-FIELD-NAME:='EOMBUM-HOLD'
  ESCAPE ROUTINE
END-IF
*
IF NOT (EOMBUM-FLAG-REPSEP='Y' OR ='N' OR = ' ')
  EOMMSG-NR:=1099
  EOMMSG-FIELD-NAME:='EOMBUM-FLAG-REPSEP'
  ESCAPE ROUTINE
END-IF
*
IF EOMBUM-SEP-START NE ' ' AND EOMBUM-SEP-START NE 'DEFAULT' AND
    EOMBUM-SEP-START NE MASK('BS'......)
  EOMMSG-NR:=0416
  EOMMSG-FIELD-NAME:='EOMBUM-SEP-START'
  ESCAPE ROUTINE
END-IF
*
IF EOMBUM-SEP-END NE ' ' AND EOMBUM-SEP-END NE 'DEFAULT' AND
    EOMBUM-SEP-END NE MASK('BS'......)
  EOMMSG-NR:=0416
  EOMMSG-FIELD-NAME:='EOMBUM-SEP-END'
  ESCAPE ROUTINE
END-IF
*
* fhi     2015-06-30 NOMALL-1655 start commenting
*  IF EOMBUM-SEPARATOR-COPIES = 0 AND
*      (EOMBUM-SEP-START NE ' ' OR EOMBUM-SEP-END NE ' ')
*    EOMBUM-SEPARATOR-COPIES:=1
*  END-IF
* fhi     2015-06-30 NOMALL-1655 end   commenting
*
FOR I=1 TO #PRINTER-NMB
  IF EOMBUM-PRINTER(I) = ' '
    RESET EOMBUM-BUNDLE-PRINT-COPIES(I)
  ELSE
    EXAMINE FULL VALUE OF EOMBUM-PRINTER(*) FOR FULL VALUE
      OF EOMBUM-PRINTER (I) GIVING NUMBER IN F
    IF F > 1
      EOMMSG-NR         := 0104          /* printer already defined
      EOMMSG-TOKEN (1)  := EOMBUM-PRINTER (I)
      EOMMSG-FIELD-NAME := 'EOMBUM-PRINTER'
      EOMMSG-IND1       := I
      ESCAPE ROUTINE
    END-IF
    CALLNAT 'RCHKPRT' EOMBUM-PRINTER(I) EXIST /*printer exist?
    IF NOT EXIST
      EOMMSG-NR         := 0108
      EOMMSG-FIELD-NAME := 'EOMBUM-PRINTER'
      ESCAPE ROUTINE
    END-IF
    IF EOM-USER-TYPE NE 'A'
      #USER-ID     := EOM-USER
      #OBJECT-NAME := EOMBUM-PRINTER(I)
      CALLNAT 'RGRANT-N'   /* get user access level on an object
        #USER-ID 'P' #OBJECT-NAME ALLOWED #GRANTS(*)
      IF ALLOWED AND NOT #GRANTS(*) = 'Y'
        FIND PRINTERS WITH P-ID = #OBJECT-NAME
          IF P-DISP = 'Y'
            RESET ALLOWED
          END-IF
        END-FIND
      END-IF
      IF NOT ALLOWED
        EOMMSG-NR         := 1090
        EOMMSG-FIELD-NAME := 'EOMBUM-PRINTER'
        EOMMSG-IND1       := I
        ESCAPE ROUTINE
      END-IF
    END-IF
    FIND PRINTERS WITH P-ID = EOMBUM-PRINTER(I)
      FIND PHYSICAL WITH PH-VTAMID = P-PHYSICAL-NAME
        IF *MACHINE-CLASS = 'MAINFRAME'
          IF PH-PRINTER-TYPE = ##PHYS-NATUNIX
            EOMMSG-NR := 0130
          END-IF
        ELSE
          IF NOT(PH-PRINTER-TYPE = ##PHYS-DISKUNIX OR = ##PHYS-NATUNIX)
            EOMMSG-NR := 0131
          END-IF
        END-IF
        IF EOMMSG-NR NE 0
          EOMMSG-FIELD-NAME := 'EOMBUM-PRINTER'
          EOMMSG-IND1 := I
          ESCAPE ROUTINE
        END-IF
      END-FIND
    END-FIND
  END-IF
END-FOR
*
END-SUBROUTINE /* VALIDATE-PRINTING-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE INIT-BUNDLE-ATTRIBUTES
************************************************************************
PERFORM REPORT-VALIDATE-KEY
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
*
PERFORM BUNDLE-ATTRIBUTE-INTERFACE
*
END-SUBROUTINE /* INIT-BUNDLE-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE DELETE-BUNDLE-DEFINITION
************************************************************************
PERFORM REPORT-VALIDATE-KEY
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
*
/* DB Interface EOM Object Bundle (delete)
CALLNAT 'EOMBUMVN' EOM-PARMS EOMBUM-PARMS EOMMSG-PARMS
*
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
*
EOMGRM-I-NAME := EOMBUM-I-NAME
EOMGRM-I-TYPE := 'B'
RESET  EOMGRM-I-USER EOMGRM-I-AUTO-COMMIT
CALLNAT 'EOMGRM-N' EOM-DELETE-ALL EOMGRM-PARMS EOMMSG-PARMS /*Obj Grants
*
END-SUBROUTINE /* DELETE-BUNDLE-DEFINITION
*
************************************************************************
DEFINE SUBROUTINE BUNDLE-ATTRIBUTE-INTERFACE
************************************************************************
DECIDE ON FIRST EOMBUM-I-ATTRIBUTE-TYPE
  VALUE BUNDLE-GENERAL-ATTRIBUTES
    CALLNAT 'EOMBUMGN'  /* DB Interface EOM Object Bundle
    /* (general attributes)
      EOM-FUNCTION EOM-USER EOMBUM-PARMS EOMMSG-PARMS
  VALUE BUNDLE-PRINTING-ATTRIBUTES
    CALLNAT 'EOMBUMPN'  /* DB Interface EOM Object Bundle
    /* (printing attributes)
      EOM-FUNCTION EOMBUM-PARMS EOMMSG-PARMS
  NONE IGNORE
END-DECIDE
*
END-SUBROUTINE /* BUNDLE-ATTRIBUTE-INTERFACE
*
************************************************************************
DEFINE SUBROUTINE REPORT-VALIDATE-KEY
************************************************************************
DECIDE FOR FIRST CONDITION
  WHEN EOM-FUNCTION NE EOM-MODIFY AND EOMBUM-I-REP-FUNCTION > 0
    EOMMSG-NR := 2600
    EOMMSG-FIELD-NAME := 'EOMBUM-I-REP-FUNCTION'
  WHEN EOMBUM-I-REP-FUNCTION > 0 AND EOMBUM-I-REPNAME = ' '
    EOMMSG-NR := 0041
    EOMMSG-FIELD-NAME := 'EOMBUM-I-REPNAME'
    ESCAPE ROUTINE
  WHEN EOMBUM-I-REP-FUNCTION > 0  AND EOMBUM-I-REPNAME > ' '
    IF EOMBUM-I-REP-FUNCTION = EOM-READ-NEXT OR = EOM-READHOLD-NEXT OR
        = EOM-INIT OR = EOM-COPY OR = EOM-RENAME
      EOMMSG-NR := 0020
      EOMMSG-FIELD-NAME := 'EOMBUM-I-REP-FUNCTION'
      ESCAPE ROUTINE
    END-IF
    FN. FIND NUMBER BUNDLE-REPORT WITH BR-BUNDLE = EOMBUM-I-NAME
    DECIDE FOR FIRST CONDITION
      WHEN EOMBUM-REP-INDEX = 0 OR (EOMBUM-I-REP-FUNCTION NE EOM-ADD
          AND EOMBUM-REP-INDEX > *NUMBER(FN.))
        EOMMSG-NR := 0125
      WHEN ANY
        EOMMSG-FIELD-NAME := 'EOMBUM-REP-INDEX'
        ESCAPE ROUTINE
      WHEN NONE IGNORE
    END-DECIDE
    FNDRP. FIND REPORT WITH R-REPNAME = EOMBUM-I-REPNAME
      IF *NUMBER(FNDRP.) = 0
        EOMMSG-NR := 0406
        COMPRESS EOMBUM-I-REPNAME ' (' *PROGRAM ',' *LINE ')'
          TO EOMMSG-TOKEN(1) LEAVING NO
        EOMMSG-FIELD-NAME := 'EOMBUM-I-REPNAME'
        ESCAPE BOTTOM(FNDRP.)
      END-IF
    END-FIND
  WHEN NONE  IGNORE
END-DECIDE
*
END-SUBROUTINE
*
************************************************************************
DEFINE SUBROUTINE READ-BUNDLED-REPORT
************************************************************************
#BUNDLE := EOMBUM-I-NAME
#REPORT := EOMBUM-I-REPNAME
*
FNDBR. FIND BUNDLE-REPORT WITH BR-BUNDLE-REPORT = #NAME
  IF NO RECORDS FOUND
    EOMMSG-NR := 0034
    EOMMSG-TOKEN(1) := #NAME
    ESCAPE BOTTOM(FNDBR.)
  END-NOREC
  EOMBUM-REP-REPNAME(EOMBUM-REP-INDEX) := BR-REPNAME
  EOMBUM-REP-SEPNO(EOMBUM-REP-INDEX)   := BR-SEPNO
  EOMBUM-REP-REPNO(EOMBUM-REP-INDEX)   := BR-REPNO
  EOMBUM-REP-SEQNO(EOMBUM-REP-INDEX)   := BR-SEQNO
  EOMBUM-REP-PRINTER(EOMBUM-REP-INDEX) := BR-PRINTER
  EOMBUM-REP-PAGEDEF(EOMBUM-REP-INDEX) := BR-PAGEDEF
  EOMBUM-REP-FORMDEF(EOMBUM-REP-INDEX) := BR-FORMDEF
  IF EOMBUM-I-REP-FUNCTION = EOM-READHOLD OR = EOM-READHOLD-NEXT
    UPDBR. GET BUNDLE-REPORT *ISN (FNDBR.)
    IF BR-BUNDLE NE BR-BUNDLE
      UPDATE (UPDBR.)
    END-IF
  END-IF
END-FIND
*
END-SUBROUTINE /* READ-BUNDLED-REPORT
*
************************************************************************
DEFINE SUBROUTINE MODIFY-BUNDLED-REPORT
************************************************************************
IF EOMBUM-REP-SEQNO(EOMBUM-REP-INDEX) NE MASK (NNN)
  RESET EOMBUM-REP-SEQNO(EOMBUM-REP-INDEX)
END-IF
*
IF EOMBUM-REP-REPNO(EOMBUM-REP-INDEX) NE MASK (NNN)
  RESET EOMBUM-REP-REPNO(EOMBUM-REP-INDEX)
END-IF
*
IF EOMBUM-REP-SEPNO(EOMBUM-REP-INDEX) NE MASK (NNN)
  RESET EOMBUM-REP-SEPNO(EOMBUM-REP-INDEX)
END-IF
*
IF EOMBUM-I-REP-FUNCTION = EOM-MODIFY
  EOMBRM-I-BUNDLE         := EOMBUM-I-NAME
  EOMBRM-I-REPORT         := EOMBUM-I-REPNAME
  EOMBRM-PRINTER          := EOMBUM-REP-PRINTER(EOMBUM-REP-INDEX)
  EOMBRM-SEPARATOR-COPIES := EOMBUM-REP-SEPNO(EOMBUM-REP-INDEX)
  EOMBRM-REPORT-COPIES    := EOMBUM-REP-REPNO(EOMBUM-REP-INDEX)
  EOMBRM-PAGEDEF          := EOMBUM-REP-PAGEDEF(EOMBUM-REP-INDEX)
  EOMBRM-FORMDEF          := EOMBUM-REP-FORMDEF(EOMBUM-REP-INDEX)
  EOMBRM-GROUP            := EOMBUM-REP-GROUP(EOMBUM-REP-INDEX)
  EOMBRM-SEQUENCE-NUMBER  := EOMBUM-REP-SEQNO(EOMBUM-REP-INDEX)
  CALLNAT 'EOMBRMGN' EOMBUM-I-REP-FUNCTION EOMBRM-PARMS EOMMSG-PARMS
*
  IF EOMMSG-NR NE 0
    ESCAPE ROUTINE
  END-IF
END-IF
*
IF EOMBUM-I-REP-FUNCTION = EOM-ADD
  FNDMOD. FIND BUNDLE-REPORT WITH BR-BUNDLE = EOMBUM-I-NAME AND
      BR-REPNAME = EOMBUM-I-REPNAME
    IF NO RECORDS FOUND
      ENTER
    END-NOREC
*
    DECIDE FOR FIRST CONDITION
      WHEN *NUMBER(FNDMOD.) = 0
        BR-REPNAME := EOMBUM-I-REPNAME
        BR-BUNDLE  := EOMBUM-I-NAME
      WHEN *NUMBER(FNDMOD.) > 0
        EOMMSG-NR := 0437
        ESCAPE BOTTOM(FNDMOD.)
      WHEN  NONE IGNORE
    END-DECIDE
    IF EOMBUM-REP-GROUP(EOMBUM-REP-INDEX) = ' '
      BR-GROUP := BR-BUNDLE-8
    ELSE
      BR-GROUP := EOMBUM-REP-GROUP(EOMBUM-REP-INDEX)
    END-IF
    IF EOMBUM-REP-SEQNO(EOMBUM-REP-INDEX) = 0
      BR-SEQNO := 1
    ELSE
      BR-SEQNO := EOMBUM-REP-SEQNO(EOMBUM-REP-INDEX)
    END-IF
    BR-PRINTER  := EOMBUM-REP-PRINTER(EOMBUM-REP-INDEX)
    BR-SEPNO    := EOMBUM-REP-SEPNO(EOMBUM-REP-INDEX)
    BR-REPNO    := EOMBUM-REP-REPNO(EOMBUM-REP-INDEX)
    BR-PAGEDEF  := EOMBUM-REP-PAGEDEF(EOMBUM-REP-INDEX)
    BR-FORMDEF  := EOMBUM-REP-FORMDEF(EOMBUM-REP-INDEX)
    STORE BUNDLE-REPORT
  END-FIND
END-IF
*
END-SUBROUTINE /* MODIFY-BUNDLED-REPORT
*
************************************************************************
DEFINE SUBROUTINE DELETE-BUNDLED-REPORT
************************************************************************
DELBRP. FIND BUNDLE-REPORT WITH BR-BUNDLE = EOMBUM-I-NAME AND
    BR-REPNAME = EOMBUM-I-REPNAME
  IF NO RECORDS FOUND
    EOMMSG-NR := 0449
    EOMMSG-FIELD-NAME := 'EOMBUM-I-REPNAME'
    ESCAPE BOTTOM (DELBRP.)
  END-NOREC
*
  FIND BUNDLE WITH B-BUNDLE = EOMBUM-I-NAME
    #FLUSH-REPORTS(*) := B-FLUSH-REPORTS(*)
  END-FIND
  RESET N
  FOR N=1 TO 8
    IF EOMBUM-I-REPNAME = #FLUSH-REPORTS(N)
      EOMMSG-NR := 0049 /* not allowed delete 'print enevt' reps
      EOMMSG-FIELD-NAME := 'EOMBUM-I-REPNAME'
      ESCAPE ROUTINE
    END-IF
  END-FOR
*
  DELETE
  #OBJ  := EOMBUM-I-NAME
  #USER := EOM-USER
  #APPL := EOM-LIBRARY
  PERFORM RMLOGDEL #OBJ 'RP-CONTENTS' #USER #APPL
END-FIND
*
END-SUBROUTINE /* DELETE-BUNDLED-REPORT
*
END
