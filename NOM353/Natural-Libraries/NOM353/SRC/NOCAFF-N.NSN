* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* NOCAFF-N - NOM API Maintenance of NOM Calendars - Function  delete
*            Input keys :
*            ES-KEY-PARM(1)     calendar-name
*            ES-KEY-PARM(2)     calendar-year
* Maintenance:
* XSETGGR 2004-10-28 created
* fhi     2011-05-02 NOMALL-901 Log any online delete operation
* xsetggr 2011-09-20 NOMALL-901 correct writing delete operations in log
* xsetggr 2012-01-12 NOMALL-1020 write language independent msgs to log
* xsetggr 2012-03-11 NOMALL-1099 use interface to call RLOG from NGC
* SU1     2024-04-24 NOM36       remove unused
* -------------------------------------------------------------------
DEFINE DATA
PARAMETER USING ESMCNT-A
PARAMETER USING ESMINP-A
************************************************************************
LOCAL USING NADA2000
LOCAL USING NAD-MSG
LOCAL USING NAD-FLD
LOCAL USING RLOG-L
LOCAL
1 CAL VIEW OF NRM-CALENDARS
/*SU1  2 CA-CALENDAR-ID 2 REDEFINE CA-CALENDAR-ID 3 CALENDAR-NAME   (A8)
/*SU1   3 CALENDAR-YEAR   (N4) 2 CA-WORKING-DAYS   (12)
1 #ES-MSG-PREF             (A7) INIT <'NOM'>
1 REDEFINE #ES-MSG-PREF
  2 #ES-MSG-NOM            (A3)
  2 #ES-MSG-NR             (N4)
1 #LIBRARY-ID              (A8)
1 #CALENDAR-ID             (A12)
1 REDEFINE #CALENDAR-ID
  2 #CA-NAME               (A8)
  2 #CA-YEAR               (A4)
1 #USER-LIB                (A8)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET ES-RC ES-MSG-NR ES-MSG-FIELD ES-MSG-TXT
*
#LIBRARY-ID  := ES-APP-SERVER-LIBRARY
COMPRESS ES-APP-SERVER-LIBRARY 'U' TO #USER-LIB LEAVING NO
#CA-NAME := ES-KEY-PARM(1)
#CA-YEAR := ES-KEY-PARM(2)
*
DECIDE ON FIRST VALUE OF ES-ORIG-FUNCTION
  VALUE 'DL'
    PERFORM DELETE-RECORD
    IF ES-RC = 0
      PERFORM WRITE-LOG
      END TRANSACTION
    ELSE
      BACKOUT TRANSACTION
    END-IF
  NONE VALUE IGNORE
END-DECIDE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE DELETE-RECORD
************************************************************************
FNDDEL. FIND CAL WITH CA-CALENDAR-ID = #CALENDAR-ID
  IF NO RECORDS FOUND
    #ES-MSG-NR := 2004                   /* Calendar does not exist
    ESCAPE BOTTOM(FNDDEL.)
  END-NOREC
  DELETE(FNDDEL.)
END-FIND
IF #ES-MSG-NR NE 0
  PERFORM GET-MSG-TXT
END-IF
*
END-SUBROUTINE /* DELETE-RECORD
*
************************************************************************
DEFINE SUBROUTINE WRITE-LOG
************************************************************************
IF ES-ORIG-FUNCTION = 'DL'
  COMPRESS '0075' #CALENDAR-ID 'CALENDAR' TO LG-MSG
  LG-USERID   := ES-USER
  LG-CODE     := 'MO'
  LG-FUNCTION := 'W'
  CALLNAT 'NOLG---N' PL-PARMS #USER-LIB
END-IF
*
END-SUBROUTINE /* WRITE-LOG
*
************************************************************************
DEFINE SUBROUTINE GET-MSG-TXT
************************************************************************
RESET SHORT-MSG LONG-MSG(*)
VERSION := 0
NADA2000.OBJECT-KIND := 'U'
NADA2000.ERROR-NUMBER := #ES-MSG-NR
NADA2000.OPT-INSERT-DYN := FALSE
NADA2000.OPT-LANGUAGE := ES-LANGUAGE
NADA2000.LIBRARY := #LIBRARY-ID
CALLNAT 'NATA2000' NADA2000 NATA2000.EXTENDED-PARMS NAD-MSG NAD-FLD
ES-MSG-NR    := #ES-MSG-NR
ES-MSG-TXT   := SHORT-MSG
EXAMINE ES-MSG-TXT FOR #ES-MSG-PREF DELETE
EXAMINE ES-MSG-TXT FOR ':1:' REPLACE ' '
EXAMINE ES-MSG-TXT FOR ':2:' REPLACE ' '
ES-RC := 1
*
END-SUBROUTINE /* GET-MSG-TXT
*
************************************************************************
ON ERROR
************************************************************************
  ES-RC := 1
  COMPRESS *PROGRAM 'ERROR' *ERROR-NR *ERROR-LINE TO ES-MSG-TXT
  ESCAPE ROUTINE
END-ERROR
*
END
