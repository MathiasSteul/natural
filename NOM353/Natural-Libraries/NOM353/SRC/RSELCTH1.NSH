* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    RSELCTH1
* Function  General help routine for map fields (english)
*           for the maps RSELCT11 and RSELCT21
*           and RSELCT31         xsiszha 2000-08-28 (CE7461)
* Version   2.1.1
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* sju 00-06-01 p(179982) created
* SU1 2017-10-09 NOMALL-1823 NOM 3.5: remove CONNECT
* ----------------------------------------------------------------------
*
DEFINE DATA PARAMETER
1 #FIELD-NAME       (A65)
LOCAL
1 #L                 (A65/16)  /* help text lines
1 #T                 (A32)     /* help window title
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
DECIDE ON FIRST #FIELD-NAME
  VALUE 'RSELCT11','RSELCT21','RSELCT31'
    FETCH RETURN 'NRMHELP' 'HSELCTM1'
    ESCAPE ROUTINE
  VALUE '+G-RLIACF-SEL-LOCATION'
    #T    :='Active Report Current Location'
    #L(1) :='Select Active Reports according '
    #L(2) :='to their current location.      '
    #L(3) :='For example<D>to display active '
    #L(4) :='reports stored in the database.'
  VALUE '+G-RLIACF-SEL-REPNAME'
    #T    :='Active Report Name'
    #L(1) :='Select Active Reports according '
    #L(2) :='to their name, including wildcard.'
    #L(3) :='For example<ABC*>to display all '
    #L(4) :='active reports with a name  '
    #L(5) :='beginning ABC.   '
  VALUE '+G-RLIACF-SEL-ARC-FLAG'
    #T    :='Active Report Archive Status'
    #L(1) :='Select Active Reports according '
    #L(2) :='to their Archive status.        '
    #L(3) :='For example<*>to display archived'
    #L(4) :='reports;<A>to display reports'
    #L(5) :='waiting to be archived.'
  VALUE '+G-RLIACF-SEL-REV-FLAG'
    #T    :='Active Report Revive Status'
    #L(1) :='Select Active Reports according '
    #L(2) :='to their Revive status.        '
    #L(3) :='For example<*>to display currently'
    #L(4) :='revived reports;<D>to display '
    #L(5) :='reports waiting to be revived to'
    #L(6) :='the NOM database. '
  VALUE '+G-RLISAB-SEL-ABUNDLE'
    #T    :='Active Bundle Name'
    #L(1) :='Select Active Bundles according '
    #L(2) :='to their name, including wildcard.'
    #L(3) :='For example<ABC*>to display all '
    #L(4) :='active bundles with a name  '
    #L(5) :='beginning ABC.   '
  VALUE '+G-RLISAB-SEL-COORD'
    #T    :='Active Bundle Coordinator'
    #L(1) :='Select Active Bundles for a '
    #L(2) :='particular coordinator.     '
    #L(3) :='For example<ABCDEF>to display '
    #L(4) :='active bundles coordinated by '
    #L(5) :='user ABCDEF.   '
  VALUE '+G-RLISAB-SEL-STAT'
    #T    :='Active Bundle Status'
    #L(1) :='Select Active Bundles according '
    #L(2) :='to their status.        '
    #L(3) :='For example<O>to display open  '
    #L(4) :='active bundles.  '
  VALUE '+G-RLISBC-SEL-GROUP'
    #T    :='Active Bundle Reports By Group'
    #L(1) :='Select Reports in an Active  '
    #L(2) :='Bundle according to their group.'
    #L(3) :='For example<ABC*> to display '
    #L(4) :='active reports bundled with  '
    #L(5) :='group names beginning ABC.'
  VALUE '+G-RLISBC-SEL-REPNAME'
    #T    :='Active Bundle Reports By Name'
    #L(1) :='Select Reports in an Active '
    #L(2) :='Bundle according to their name. '
    #L(3) :='For example<ABC*>to display '
    #L(4) :='bundled active reports with  '
    #L(5) :='names beginning ABC.   '
  VALUE '+G-RLISBR-SEL-GROUP'
    #T    :='Bundle Reports By Group'
    #L(1) :='Select Reports in a Bundle  '
    #L(2) :='according to their group.'
    #L(3) :='For example<ABC*> to display '
    #L(4) :='reports bundled with group '
    #L(5) :='names beginning ABC.'
  VALUE '+G-RLISBR-SEL-REPNAME'
    #T    :='Bundle Reports By Name'
    #L(1) :='Select Reports in a Bundle '
    #L(2) :='according to their name. '
    #L(3) :='For example<ABC*>to display '
    #L(4) :='bundled reports with names '
    #L(5) :='beginning ABC.   '
  VALUE '+G-RLISBU-SEL-AUTHORIZATION'
    #T    :='Bundle Authorization'
    #L(1) :='Select Bundles according to '
    #L(2) :='their authorization.        '
    #L(3) :='For example<PUBLIC>to display  '
    #L(4) :='bundles for which all users have'
    #L(5) :='authorization. Please note that'
    #L(6) :='non-administrators may only'
    #L(7) :='specify PUBLIC, * or their own id.'
  VALUE '+G-RLISBU-SEL-REPORT'
    #T    :='Bundles Containing Report'
    #L(1) :='Select Bundles which contain'
    #L(2) :='the given report.'
    #L(3) :='For example<ABC*>to display all '
    #L(4) :='bundles containing reports with'
    #L(5) :='names beginning ABC.   '
  VALUE '+G-RLISBU-SEL-BUNDLE'
    #T    :='Bundle Name'
    #L(1) :='Select Bundles according to'
    #L(2) :='their name, including wildcard.'
    #L(3) :='For example<ABC*>to display all '
    #L(4) :='bundles with a name  '
    #L(5) :='beginning ABC.   '
  VALUE '+G-RLISPO-SEL-PID'
    #T    :='Printouts For Printer'
    #L(1) :='Select Printouts according to '
    #L(2) :='logical printer name.        '
    #L(3) :='For example<ABC*>to display  '
    #L(4) :='printouts queued to printers   '
    #L(5) :='with names beginning ABC. '
  VALUE '+G-RLISPO-SEL-REPNAME'
    #T    :='Printouts For Report/Bundle'
    #L(1) :='Select Printouts for the given '
    #L(2) :='report or bundle name, including'
    #L(3) := 'wildcard.'
    #L(4) :='For example<ABC*>to display all  '
    #L(5) :='printouts for reports and bundles'
    #L(6) :='with names beginning ABC. '
  VALUE '+G-RLISPO-SEL-STATUS'
    #T    :='Printouts by Status'
    #L(1) :='Select Printouts according to'
    #L(2) :='their status.        '
    #L(3) :='For example<H>to display all  '
    #L(4) :='held printouts.'
  VALUE '+G-RLISRP-SEL-AUTHORIZATION'
    #T    :='Report Authorization'
    #L(1) :='Select Reports according to '
    #L(2) :='their authorization.        '
    #L(3) :='For example<PUBLIC>to display  '
    #L(4) :='reports for which all users have'
    #L(5) :='authorization. Please note that'
    #L(6) :='non-administrators may only'
    #L(7) :='specify PUBLIC, * or their own id.'
  VALUE '+G-RLISRP-SEL-REPNAME'
    #T    :='Report Name'
    #L(1) :='Select Reports according to '
    #L(2) :='their name, including wildcard.'
    #L(3) :='For example<ABC*>to display all '
    #L(4) :='reports with a name beginning '
    #L(5) :='ABC.   '
  VALUE '+G-RLISRP-SEL-REPORT-TYPE'
    #T    :='Report Type'
    #L(1) :='Select Reports of the given type.'
    #L(2) :='Enter<M>to display master definitions'
    #L(3) :='<C>to display dynamically created'
    #L(4) :='definitions,<S>to display suspended'
    #L(5) :='definitions,<*>or<blank>to display'
    #L(6) :='reports of all types.'
  VALUE '+G-RLISAD-SEL-DSN'
    #T    :='Archive Dataset Name'
    #L(1) :='Select Archive datasets with the'
    #L(2) :='given name or prefix.        '
    #L(3) :='For example<NOM.ARC*>to list all'
    #L(4) :='archive datasets with names'
    #L(5) :='beginning NOM.ARC.   '
  VALUE '+G-RLISCA-SEL-CAL'
    #T    :='Calendar'
    #L(1) :='Select Calendars with the given '
    #L(2) :='name, including wildcard.       '
    #L(3) :='For example<CAL*>to list all '
    #L(4) :='calendars with names beginning '
    #L(5) :='CAL.   '
  VALUE '+G-RLISDL-SEL-AUTHORIZATION'
    #T    :='Distribution List Authorization'
    #L(1) :='Select Distribution Lists by'
    #L(2) :='their authorization.        '
    #L(3) :='For example<PUBLIC>to display  '
    #L(4) :='lists for which all users have'
    #L(5) :='authorization. Please note that'
    #L(6) :='non-administrators may only'
    #L(7) :='specify PUBLIC, * or their own id.'
  VALUE '+G-RLISDL-SEL-LIST'
    #T    :='Distribution List Name'
    #L(1) :='Select Distribution Lists by '
    #L(2) :='name, including wildcard.       '
    #L(3) :='For example<LIST*>to display all '
    #L(4) :='lists with names beginning LIST.'
  VALUE '+G-RLISDR-SEL-REPORT'
    #T    :='Reports In Archive Dataset'
    #L(1) :='Select Reports in an archive dataset'
    #L(2) :='by name, including wildcard.    '
    #L(3) :='For example<ABC*>to display archived '
    #L(4) :='reports with name beginning ABC. '
  VALUE '+G-RLISFO-SEL-FOLDER'
    #T    :='Folder Name'
    #L(1) :='List Folders by name, including'
    #L(2) :='wildcard.    '
    #L(3) :='For example<ABC*>to list folders '
    #L(4) :='with name beginning ABC. '
  VALUE '+G-RLISPH-SEL-PID'
    #T    :='Physical Printer Id'
    #L(1) :='List Physical Printers by name'
    #L(2) :='including wildcard.'
    #L(3) :='For example<ABC*>to list physical'
    #L(4) :='printers with name beginning ABC. '
  VALUE '+G-RLISPR-SEL-PHYSICAL'
    #T    :='Printer Physical Id'
    #L(1) :='List Printers defined for a given'
    #L(2) :='Physical Printer, including wildcard.'
    #L(3) :='For example<SYS*>to list printers'
    #L(4) :='related to physical printers with '
    #L(5) :='names beginning SYS. '
  VALUE '+G-RLISPR-SEL-PID'
    #T    :='Printer Id'
    #L(1) :='List Printers by name, including'
    #L(2) :='wildcard.'
    #L(3) :='For example<ABC*>to list printers'
    #L(4) :='with names beginning ABC.'
  VALUE '+G-RLISPR-SEL-AUTHORIZATION'
    #T    :='Printer Authorization'
    #L(1) :='Select Printers by authorization'
    #L(2) :='For example<PUBLIC>to display  '
    #L(3) :='lists for which all users have'
    #L(4) :='authorization. Please note that'
    #L(5) :='non-administrators may only'
    #L(6) :='specify PUBLIC, * or their own id.'
  VALUE '+G-RLISUS-SEL-USERID'
    #T    :='User Id'
    #L(1) :='List Users by User Id, including'
    #L(2) :='wildcard.'
    #L(3) :='For example<ABC*>to list users'
    #L(4) :='with user ids beginning ABC.'
  NONE VALUE
    COMPRESS 'Sorry (' *PROGRAM ')' TO #T LEAVING NO
    #L(1):='No Help available for this field.'
*
END-DECIDE
*
DEFINE WINDOW HELP TITLE #T
INPUT WINDOW = 'HELP' (IP=OFF AD=O DY=<YEI>)
 / #L(01) / #L(02) / #L(03) / #L(04) / #L(05) / #L(06) / #L(07) / #L(08)
 / #L(09) / #L(10) / #L(11) / #L(12) / #L(13) / #L(14) / #L(15) / #L(16)
*
END
