*
************************************************************************
* Main line
************************************************************************
*
FORMAT LS=132
*
PERFORM RMGTRACP-GET-SETTINGS
IF G-TRACE GE *LEVEL AND G-TRACE-SET = SCAN ('PRINT')
  #TRACING := TRUE
/*SU8 COMPRESS 'Monitor tracing switched on. Trace set is' G-TRACE-SET
/*SU8 TO G-TRACE-MSG ELSE G-TRACE-MSG := 'Monitor tracing switched off.'
END-IF
PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END TRANSACTION
INPUT #PO-ID #ESY-USER #FOLLOW-PRINTOUT #NOMEXIT-6 #TASK-TYPE
  #NSC-ACTIVE
RESET G-NATRP-ERC G-NATRP-ERT #CP
PERFORM INIT-FUNCTION
IF #TRACING
  COMPRESS 'Init function return code' G-NATRP-ERC TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END TRANSACTION
END-IF
IF G-NATRP-ERC = 0
  PERFORM GET-FLAGS
  PERFORM ACTIVE-REPORT-INTERFACE
  PERFORM FLUSH-INTERFACE
  PERFORM SEPARATOR-INTERFACE
  PERFORM CHECK-IF-RESTART
  IF #TRACING
    IF G-NATRP-ERC NE 0 /*SU6
      COMPRESS *PROGRAM 'restart:' G-NATRP-ERC G-NATRP-ERT
        TO G-TRACE-MSG
      PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
    END-IF

    IF +G-NOMEXIT-ACTIVE (14)
      G-TRACE-MSG := 'Nomexit 14 is active.'
    ELSE
      G-TRACE-MSG := 'Nomexit 14 is not active.'
    END-IF
  END-IF
  INCLUDE CMRDC
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END TRANSACTION
  IF +G-NOMEXIT-ACTIVE (14)
    PERFORM CALL-NOMEX014
  END-IF
  REPEAT
    UNTIL G-NATRP-ERC NE 0 OR #CP >= #COPIES
    ADD 1 TO #CP
    PERFORM PRINT-ACTIVE-REPORT
  END-REPEAT
END-IF
NOMWK-TASK-TYPE:= EQU-MANAGE-PRINTOUTS
CALLNAT NOM-WAKE-MONITOR NOMWK-NOMVERS NOMWK-PARMS (*)
IF LOGOFF-FROM-ESY
  CALLNAT 'N-ESYLG' SATSL-LOGOFF PRINTOUT.PO-NODE #ESY-USER #CALLER
    #ERC #ERT 2X #TRACING /* G-NATRP-ERC in use
  IF #ERC NE 0
    PRINT NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
      '(' *LINE ')' #ERC #ERT
  END-IF
END-IF
IF STEPLIB-ADDED
  PERFORM REMOVE-STEPLIB
END-IF
PERFORM UPDATE-PRINTOUT-RECORD
IF PO-UPD.PO-RS-COUNT = 0
  PERFORM RMPRSTCS-WRITE-STATISTICS PO-UPD.PO-LOGICAL
    PO-UPD.PO-LAST-PRINTED-RECNO PO-UPD.PO-STATUS PO-UPD.PO-MSG
    FLUSH-CC-TYPE
END-IF
IF #NOMEXIT-6 = 'Y' AND G-NATRP-ERC = 0
  PERFORM CALL-STATISTIC-EXIT
END-IF
*
COMPRESS PO-UPD.PO-REPNAME '/' PO-UPD.PO-REPRNB TO G-TRACE-MSG
  LEAVING NO
COMPRESS 'Printing of report' G-TRACE-MSG TO G-TRACE-MSG
IF G-NATRP-ERC = 0
  COMPRESS G-TRACE-MSG 'terminated normally.' TO G-TRACE-MSG
  PRINT NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
    G-TRACE-MSG /*SU10 (AL=103)
ELSE
  COMPRESS G-TRACE-MSG 'terminated with condition code'
    G-NATRP-ERC TO G-TRACE-MSG
  PRINT NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
    G-TRACE-MSG /*SU10 (AL=103)
  PRINT NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
    'Error Text' G-NATRP-ERT /*SU10 (AL=70)
  IF #TASK-TYPE NE 'SUBTASK' AND *MACHINE-CLASS = 'MAINFRAME'
    TERMINATE 50
  END-IF
END-IF
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE PRINT-ACTIVE-REPORT
************************************************************************
IF #CP = 1
  FLUSH-SEGMENT := FLUSH-BRACKET := 'F'
END-IF
*
IF #PRINT-SEPARATORS AND
NOT (ACTIVE-REPORT.AR-SEP-START = 'NONE' OR = 'KEIN')                 /*
AND (FLUSH-CC-TYPE NE BINARY OR FLUSH-PRINTER-TYPE = 'DISKUNIX')      /*
  RMSPFL-TYPE          := REPORT-START-SEPARATOR
  RMSPFL-MEMBER := ACTIVE-REPORT.AR-SEP-START
  CALLNAT 'RMSPFL-N' RMSPFL-PARMS G-SUBST-PARMS FLUSH-PARMS
    G-LINE-PARMS G-NATRP-ERC G-NATRP-ERT
  IF FLUSH-PRINTER-TYPE ='DISKUNIX' OR ='NATUNIX'
    FLUSH-BRACKET := 'M'
  END-IF
  IF G-NATRP-ERC NE 1006 /* sep page not found, treated like NONE.
    FLUSH-SEGMENT := 'M'
  ELSE
    RESET G-NATRP-ERC
    ACTIVE-REPORT.AR-SEP-START := 'NONE'
  END-IF
END-IF
IF  NOT #PRINT-SEPARATORS
  IF FLUSH-PRINTER-TYPE ='DISKUNIX' OR ='NATUNIX'
    FLUSH-BRACKET := 'L'
  END-IF
  IF #COPIES > 1 AND #COPIES = #CP        /* the last copy of report
    FLUSH-SEGMENT := 'L'
  END-IF
  IF #COPIES = 1                          /* the only copy of report
    FLUSH-SEGMENT := 'A'
  END-IF
END-IF
* print separators, but end-separator is 'NONE'/'KEIN'
IF #PRINT-SEPARATORS AND (ACTIVE-REPORT.AR-SEP-END ='NONE' OR = 'KEIN')
AND #COPIES = #CP                      /* the last copy of report     /*
  FLUSH-SEGMENT := 'L'
  IF FLUSH-PRINTER-TYPE ='DISKUNIX' OR='NATUNIX'
    FLUSH-BRACKET := 'L'
  END-IF
END-IF
IF G-NATRP-ERC NE 0
  ESCAPE ROUTINE
END-IF
*
FLUSH-CC-TYPE := ACTIVE-REPORT.AR-CC-TYPE
FLUSH-TYPE-AL := 'N'                  /* assume not type=al
IF (#SPOOL-TYPE = JES2 OR = JES3) AND #SPOOL-JES-DSTYPE = 'AL'
  FLUSH-TYPE-AL:= 'Y'                /* it is type=al
END-IF
IF +WKF-NUMBER NE 2                 /* NOT RECFM=Fxx P306371 +WKF-NUMBER
  FLUSH-RECORD-LENGTH := ACTIVE-REPORT.AR-RECORD-LENGTH
  IF FLUSH-RECORD-LENGTH < REPORT.R-SEPLENG
    FLUSH-RECORD-LENGTH := REPORT.R-SEPLENG
  END-IF
  IF REPORT.R-SEPLENG = 0 AND FLUSH-RECORD-LENGTH < 132
  AND  ACTIVE-REPORT.AR-SEPNO NE 0                                    /*
  AND NOT (ACTIVE-REPORT.AR-SEP-START = 'NONE' OR = 'KEIN'            /*
  AND  ACTIVE-REPORT.AR-SEP-END   = 'NONE' OR = 'KEIN')               /*
    FLUSH-RECORD-LENGTH := 132
  END-IF
END-IF
*
DECIDE ON FIRST ACTIVE-REPORT.AR-CURRENT-LOCATION
  VALUE 'S' /* Flush Lines of an Active Report with location = 'S'
    CALLNAT 'RMARFLSN' RMARFL-PARMS FLUSH-PARMS G-LINE-PARMS
      #SKIP-PAGES G-NATRP-ERC G-NATRP-ERT
  VALUE 'D' /* Flush Lines of an Active Report with Location = 'D'
    CALLNAT 'RMARFLDN' RMARFL-PARMS FLUSH-PARMS G-LINE-PARMS
      #SKIP-PAGES G-NATRP-ERC G-NATRP-ERT
  NONE ESCAPE ROUTINE /*???? SU at least MSG?
END-DECIDE
*
IF G-NATRP-ERC NE 0
  ESCAPE ROUTINE
END-IF
IF FLUSH-SEGMENT = 'F'
  FLUSH-SEGMENT := 'M'
END-IF
*
IF #PRINT-SEPARATORS AND NOT (ACTIVE-REPORT.AR-SEP-END='NONE' OR='KEIN')
  IF #COPIES = #CP
    FLUSH-SEGMENT := 'L'
    IF FLUSH-PRINTER-TYPE ='DISKUNIX' OR='NATUNIX'
      FLUSH-BRACKET := 'L'
    END-IF
  ELSE
    FLUSH-SEGMENT := 'M'
  END-IF
  RMSPFL-TYPE   := REPORT-END-SEPARATOR
  RMSPFL-MEMBER := ACTIVE-REPORT.AR-SEP-END
  /*  Flush Lines of an Separator Member:
  CALLNAT 'RMSPFL-N' RMSPFL-PARMS G-SUBST-PARMS FLUSH-PARMS G-LINE-PARMS
    G-NATRP-ERC G-NATRP-ERT
  IF G-NATRP-ERC = 1006 /* sep page not found, treated like NONE.
    IF #COPIES = #CP
      FLUSH-SEGMENT := 'L'
    ELSE
      FLUSH-SEGMENT := 'M'
    END-IF
    RESET G-NATRP-ERC
    ACTIVE-REPORT.AR-SEP-END := 'NONE'
  END-IF
END-IF
*
END-SUBROUTINE /* PRINT-ACTIVE-REPORT
*
************************************************************************
DEFINE SUBROUTINE INIT-FUNCTION
************************************************************************
IF NOT #TRACING
  CALLNAT 'NOMGSTEP' '*' G-NATRP-ERC
ELSE
  CALLNAT 'NOMGSTEP' '*' G-NATRP-ERC G-TRACE
END-IF
CALLNAT 'SATLGFVN' SATLGV-PARMS
IF SATLGV-RC NE 0
  WRITE NOTITLE NOHDR *PROGRAM *TIMX(EM=YYYY'-'MM'-'DD' 'HH':'II)
    SATLGV-ERROR-TEXT
  IF SATLGV-LOG-DBID NE 0 OR SATLGV-LOG-FNR NE 0
    WRITE NOTITLE NOHDR *PROGRAM *TIMX(EM=YYYY'-'MM'-'DD' 'HH':'II)
      'Dbid:' SATLGV-LOG-DBID 'Fnr:' SATLGV-LOG-FNR
  END-IF
  IF *MACHINE-CLASS = 'MAINFRAME'
    IF #TASK-TYPE = 'SUBTASK'
      STOP
    END-IF
    TERMINATE 50
  END-IF
  ESCAPE MODULE
END-IF
RESET RACTLF-LOGGING
RACTLF-ERROR-LOGGING:= TRUE
RMTASK-P.FUNCTION       := 'L'
RMTASK-P.SUBTASK-NUMBER := 1
CALLNAT 'RMTASKID' RMTASK-P
RACTLF-LOG-USERID := RMTASK-P.TASK-ID
RACTLF-LOG-CODE := 'MO'
RACTLF-LFILE-1 := 91
RACTLF-LFILE-2 := 206
CALLNAT 'RACTLF-N' RACTLF-PARMS
IF RACTLF-ERROR-CODE NE 0
  WRITE NOTITLE NOHDR *PROGRAM *TIMX(EM=YYYY'-'MM'-'DD' 'HH':'II)
    RACTLF-ERROR-CODE RACTLF-ERROR-TEXT
  WRITE NOTITLE NOHDR *PROGRAM *TIMX(EM=YYYY'-'MM'-'DD' 'HH':'II)
    'Dbid1:' RACTLF-DBID-1 'Fnr1:' RACTLF-FNR-1
  WRITE NOTITLE NOHDR *PROGRAM *TIMX(EM=YYYY'-'MM'-'DD' 'HH':'II)
    'Dbid2:' RACTLF-DBID-2 'Fnr2:' RACTLF-FNR-2
  IF *MACHINE-CLASS = 'MAINFRAME'
    IF #TASK-TYPE = 'SUBTASK'
      STOP
    END-IF
    TERMINATE 50
  ELSE
    ESCAPE MODULE
  END-IF
END-IF
#HEX-TIMESTAMP := +HEX-TIMESTAMP
PERFORM SATTIMST-GET-TIME #HEX #HEX-TIMESTAMP
+HEX-TIMESTAMP := #HEX-TIMESTAMP
DECIDE FOR EVERY CONDITION
  WHEN G-NATRP-ERC = 0
    PERFORM READ-PRINTOUT-RECORD
  WHEN G-NATRP-ERC = 0
    PERFORM READ-TRACE
  WHEN G-NATRP-ERC = 0
    IF PRINTOUT.PO-NODE NE 0
      CALLNAT 'N-ESYLG' 1X PRINTOUT.PO-NODE #ESY-USER #CALLER
        G-NATRP-ERC G-NATRP-ERT 1X
      IF G-NATRP-ERC NE 0
        G-NATRP-ERC := 0005
      ELSE
        LOGOFF-FROM-ESY := TRUE
      END-IF
    END-IF
  WHEN G-NATRP-ERC = 0
    PERFORM READ-USER
  WHEN G-NATRP-ERC = 0
    PERFORM READ-ACTIVE-REPORT
  WHEN G-NATRP-ERC = 0
    PERFORM SUBSTITUTION-VARIABLES
  WHEN G-NATRP-ERC = 0
    PERFORM READ-REPORT
  WHEN NONE
    IGNORE
END-DECIDE
IF G-NATRP-ERC = 1079
  RESET G-NATRP-ERC G-NATRP-ERT
END-IF
*
END-SUBROUTINE /* INIT-FUNCTION
*
************************************************************************
DEFINE SUBROUTINE ACTIVE-REPORT-INTERFACE
************************************************************************
RMARFL-REPNAME                := PRINTOUT.PO-REPNAME
RMARFL-REPRNB                 := PRINTOUT.PO-REPRNB
RMARFL-LINE-FROM              := PRINTOUT.PO-FROM-LINE
RMARFL-LINE-TO                := PRINTOUT.PO-TO-LINE
RMARFL-LAYOUT-HEADER-LINES    := PRINTOUT.PO-HEADLINES
RMARFL-LAYOUT-ENTRIES         := PRINTOUT.C*PO-LAYOUT
RMARFL-LAYOUT-FROM        (*) := PRINTOUT.PO-LAYOUT-FROM (*)
RMARFL-LAYOUT-TO          (*) := PRINTOUT.PO-LAYOUT-TO  (*)
FLUSH-REPRNB                  := PRINTOUT.PO-REPRNB
*
END-SUBROUTINE /* ACTIVE-REPORT-INTERFACE
*
************************************************************************
DEFINE SUBROUTINE SEPARATOR-INTERFACE
************************************************************************
RMSPFL-LANGUAGE := PRINTOUT.PO-LANGUAGE
RMSPFL-COPIES   := ACTIVE-REPORT.AR-SEPNO
IF +WKF-NUMBER NE 2                 /* NOT RECFM=Fxx P306371 +WKF-NUMBER
  RMSPFL-RECORD-LENGTH := ACTIVE-REPORT.AR-RECORD-LENGTH
  IF RMSPFL-RECORD-LENGTH < REPORT.R-SEPLENG
    RMSPFL-RECORD-LENGTH := REPORT.R-SEPLENG
  END-IF
ELSE
  RMSPFL-RECORD-LENGTH := FLUSH-RECORD-LENGTH
END-IF
*
END-SUBROUTINE /* SEPARATOR-INTERFACE
*
************************************************************************
DEFINE SUBROUTINE FLUSH-INTERFACE
************************************************************************
RESET FLUSH-COMMON-FIELDS
FLUSH-POID    := #PO-ID
FLUSH-CC-TYPE := ACTIVE-REPORT.AR-CC-TYPE
FLUSH-DESC    := ACTIVE-REPORT.AR-DESC
/*  Get attributes for flush
CALLNAT 'RMFL---N' FLUSH-PARMS G-NATRP-ERC G-NATRP-ERT
*
FLUSH-BRACKET := 'F'
IF +WKF-NUMBER = 2          /* RECFM=Fxx P306371 +WKF-NUMBER
  FLUSH-CC-TYPE              := ACTIVE-REPORT.AR-CC-TYPE
  DECIDE FOR FIRST CONDITION
    WHEN FLUSH-CC-TYPE = BINARY
      FLUSH-RECORD-LENGTH:= 0
    WHEN FLUSH-RECORD-LENGTH = 0  /* NO LRECL ON PRINTOUT DEFINITION
        AND FLUSH-CC-TYPE NE BINARY
      FLUSH-RECORD-LENGTH:= 251
    WHEN NONE
      IGNORE
  END-DECIDE
ELSE
  FLUSH-RECORD-LENGTH := ACTIVE-REPORT.AR-RECORD-LENGTH
  IF FLUSH-RECORD-LENGTH < REPORT.R-SEPLENG
    FLUSH-RECORD-LENGTH := REPORT.R-SEPLENG
  END-IF
END-IF
#COPIES := FLUSH-COPIES
*
END-SUBROUTINE /* FLUSH-INTERFACE
*
************************************************************************
DEFINE SUBROUTINE READ-PRINTOUT-RECORD
************************************************************************
FNDPR. FIND PRINTOUT WITH PO-ID = #PO-ID
  IF NO RECORDS FOUND
    G-NATRP-ERC := 0005
    G-NATRP-ERT := 'Printout Record not found'
    ESCAPE BOTTOM (FNDPR.)
  END-NOREC
*
  RESET #SKIP-PAGES
  EXAMINE PRINTOUT.PO-JOBCARD (*) FOR 'SKIP' GIVING INDEX #IND
  IF #IND = 0
    EXAMINE PRINTOUT.PO-JOBCARD (*) FOR 'skip' GIVING INDEX #IND
  END-IF
  IF #IND > 0
    #PO-JOBCARD := PRINTOUT.PO-JOBCARD (#IND)
    EXAMINE #PO-JOBCARD FOR 'SKIP' GIVING POSITION #POS LENGTH #LEN
    IF #POS = 0
      EXAMINE #PO-JOBCARD FOR 'skip' GIVING POSITION #POS LENGTH #LEN
    END-IF
    #POS := #POS + 4 /* start position for number
    RESET #DIGIT
    FORPOS.
    FOR #J = #POS TO #LEN
      IF SUBSTR(#PO-JOBCARD,#J,1) = ' ' OR = MASK(N)
        #DIGIT := TRUE
        ESCAPE TOP
      END-IF
      ESCAPE BOTTOM (FORPOS.)
    END-FOR
    IF #DIGIT = TRUE
      #K := #J - #POS /* number of digits and blanks
      #PO-JOBCARD := SUBSTR(#PO-JOBCARD,#POS,#K)
      MOVE LEFT #PO-JOBCARD TO #PO-JOBCARD
      #SKIP-PAGES := VAL(#PO-JOBCARD)
    END-IF
  END-IF
  IF PRINTOUT.PO-EXITMEM NE ' ' AND PRINTOUT.PO-EXITLIB NE ' '
    PERFORM ADD-STEPLIB
*
    IF G-NATRP-ERC = 0
      CALLNAT 'N-CHKCAT' G-NATRP-ERC G-NATRP-ERT /*SU10
        PRINTOUT.PO-EXITMEM PRINTOUT.PO-EXITLIB
        #CALLER #CAT-DATE-1 #CAT-DATE-2
      IF G-NATRP-ERC NE 0
        COMPRESS PRINTOUT.PO-REPNAME '/' PRINTOUT.PO-REPRNB
          TO LG-MSG LEAVING NO
        COMPRESS PRINTOUT.PO-EXITLIB '(' PRINTOUT.PO-EXITMEM ')'
          TO #MEMBER LEAVING NO
        COMPRESS '1587' LG-MSG #MEMBER PRINTOUT.PO-LOGICAL TO LG-MSG
        RMTASK-P.FUNCTION       := 'L'
        RMTASK-P.SUBTASK-NUMBER := 1
        CALLNAT 'RMTASKID' RMTASK-P
        LG-USERID := RMTASK-P.TASK-ID
        LG-CODE := 'MO'
        CALLNAT 'RLOG' PL-PARMS
        IF #TRACING
          COMPRESS PRINTOUT.PO-EXITLIB '(' PRINTOUT.PO-EXITMEM ')'
            TO G-TRACE-MSG LEAVING NO
          COMPRESS 'Unable to find exitmem' G-TRACE-MSG TO G-TRACE-MSG
          PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
        END-IF
      END-IF
    END-IF
  END-IF
END-FIND
*
END-SUBROUTINE /* READ-PRINTOUT-RECORD
*
************************************************************************
DEFINE SUBROUTINE UPDATE-PRINTOUT-RECORD
************************************************************************
IF #TRACING
  COMPRESS 'Updating PO-ID' #PO-ID TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END TRANSACTION
END-IF
FNDPO. FIND PO-UPD WITH PO-ID = #PO-ID
  IF #TRACING
    COMPRESS 'Got PO-MSG' PO-MSG TO G-TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END-IF
  IF PO-MSG = '8861' /* RMPRTJOB did not find jobvariable in BS2
    RESET G-NATRP-ERC G-NATRP-ERT PO-MSG
    #FOLLOW-PRINTOUT := 'N'
  END-IF
  IF #TRACING
    COMPRESS '#FOLLOW-PRINTOUT is' #FOLLOW-PRINTOUT TO G-TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END-IF
  IF #FOLLOW-PRINTOUT = 'Y' AND G-NATRP-ERC = 0
    ESCAPE ROUTINE
  END-IF
  IF #TRACING
    COMPRESS 'Got PO-MSG' PO-MSG 'and return code' G-NATRP-ERC
      TO G-TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END-IF
  IF G-NATRP-ERC = 0
    PO-UPD.PO-STATUS := 'D'
    IF #TRACING
      COMPRESS 'Set PO-Status:' PO-UPD.PO-STATUS TO G-TRACE-MSG
      PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
    END-IF
    FOR-JOBC. FOR #I = 1 TO 3
      #PO-JOBCARD := PO-UPD.PO-JOBCARD (#I)
      IF #TRACING
        COMPRESS 'Got jobcard:' #PO-JOBCARD TO G-TRACE-MSG
        PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
      END-IF
      EXAMINE #PO-JOBCARD TRANSLATE INTO UPPER
      IF #PO-JOBCARD = SCAN ('EXTERNAL-OK')  /* confirm manually
        PO-UPD.PO-STATUS         := 'X'
        IF #TRACING
          COMPRESS 'Set PO-Status:' PO-UPD.PO-STATUS TO G-TRACE-MSG
          PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
        END-IF
        ESCAPE BOTTOM (FOR-JOBC.)
      END-IF
    END-FOR
    IF PO-UPD.PO-STATUS NE 'X'
      RESET  PO-MSG
      PO-PRINTED := *TIMX
    END-IF
    LG-OBJECT-NAME := PO-UPD.PO-REPNAME
    LG-REPNAME     := PO-UPD.PO-REPNAME
    LG-REPRNB      := PO-UPD.PO-REPRNB
    LG-PRINTER     := PO-UPD.PO-LOGICAL
    COMPRESS PO-UPD.PO-REPNAME '/' PO-UPD.PO-REPRNB TO LG-MSG LEAVING NO
    COMPRESS '7202' LG-MSG TO LG-MSG
  ELSE
    PO-UPD.PO-STATUS := 'E'
    IF #TRACING
      COMPRESS 'Set PO-Status:' PO-UPD.PO-STATUS TO G-TRACE-MSG
      PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
    END-IF
    IF G-NATRP-ERC = 5
      COMPRESS 'Log:' *TIME G-NATRP-ERT TO PO-MSG
      PERFORM XXRLOG-WRITE-LOG 'W' G-NATRP-ERT
    ELSE
      #RC := G-NATRP-ERC
      COMPRESS #RC-A G-NATRP-ERT TO PO-MSG
      IF #RC = 8854
        PO-UPD.PO-STATUS := 'A'
        IF #TRACING
          COMPRESS 'Set PO-Status:' PO-UPD.PO-STATUS TO G-TRACE-MSG
          PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
        END-IF
        #I := PO-NUMBER-OF-RETRIES
        COMPRESS '8854' #I TO PO-MSG
      END-IF
    END-IF
    LG-OBJECT-NAME := PO-UPD.PO-REPNAME
    LG-REPNAME     := PO-UPD.PO-REPNAME
    LG-REPRNB      := PO-UPD.PO-REPRNB
    LG-PRINTER     := PO-UPD.PO-LOGICAL
    COMPRESS PO-UPD.PO-REPNAME '/' PO-UPD.PO-REPRNB TO LG-MSG LEAVING NO
    COMPRESS '7204' LG-MSG TO LG-MSG
  END-IF
*
  LG-CODE := 'PR'
  COMPRESS LG-MSG PO-UPD.PO-LOGICAL TO LG-MSG
  RMTASK-P.FUNCTION       := 'L'
  RMTASK-P.SUBTASK-NUMBER := 1
  CALLNAT 'RMTASKID' RMTASK-P
  LG-USERID := RMTASK-P.TASK-ID
  CALLNAT 'RLOG' PL-PARMS
  UPDATE (FNDPO.)
  END OF TRANSACTION
*
END-FIND
*
END-SUBROUTINE /* UPDATE-PRINTOUT-RECORD
*
************************************************************************
DEFINE SUBROUTINE READ-TRACE
************************************************************************
FIND PRINTERS WITH P-ID = PRINTOUT.PO-LOGICAL
  EXAMINE P-ATTRIBUTES (*) FOR 'TRACE' GIVING POSITION #POS INDEX #IND
  IF #IND = 0
    ESCAPE TOP
  END-IF
  #POS := #POS + 5
  #P-ATTRIBUTES := SUBSTR (P-ATTRIBUTES (#IND),#POS)
  SEPARATE #P-ATTRIBUTES LEFT JUSTIFIED INTO #G-TRACE IGNORE
  RESET G-TRACE
  IF SUBSTR(#G-TRACE,1,1) = 'Y' OR = '1' OR = '2' OR = '3'
    G-TRACE := 100
  END-IF
END-FIND
*
END-SUBROUTINE /* READ-TRACE
*
************************************************************************
DEFINE SUBROUTINE READ-USER
************************************************************************
FNDUS. FIND USER WITH USER-ID = PRINTOUT.PO-USERID
  IF NO RECORDS FOUND
    IF NOT(F#MONITOR-USER-AUTODEF (<>) = 'Y' OR='P')
      G-NATRP-ERC := 0005
      COMPRESS 'User' PRINTOUT.PO-USERID 'not found.' TO G-NATRP-ERT
      ESCAPE BOTTOM (FNDUS.)
    END-IF
    FIND USER WITH USER-ID = 'DEFAULT'
    END-FIND
  END-NOREC
END-FIND
*
END-SUBROUTINE /* READ-USER
*
************************************************************************
DEFINE SUBROUTINE READ-ACTIVE-REPORT
************************************************************************
#PRINT-SEPARATORS := TRUE
#AR-REPNAME       := PRINTOUT.PO-REPNAME
#AR-REPRNB        := PRINTOUT.PO-REPRNB
FNDAR. FIND ACTIVE-REPORT WITH AR-REPORT-RNB = #AR-REPORT-RNB
  IF NO RECORDS FOUND
    G-NATRP-ERC := 0005
    G-NATRP-ERT := 'Active Report not found'
    ESCAPE BOTTOM (FNDAR.)
  END-NOREC
  #SPOOL-ATTRIBUTES := ACTIVE-REPORT.AR-SPOOL-ATTRIBUTES
  CALLNAT 'RMSPL7-N' #SPOOL-ATTRIBUTES #SPOOL-TYPE
  IF ACTIVE-REPORT.AR-SEPNO = 0 OR PO-PRINT-SEPARATION NE ' ' /*SU5
  OR ((ACTIVE-REPORT.AR-SEP-START = 'NONE'  OR = 'KEIN')              /*
  AND (ACTIVE-REPORT.AR-SEP-END  = 'NONE'  OR = 'KEIN' ))             /*
    RESET #PRINT-SEPARATORS
  END-IF
  IF ACTIVE-REPORT.AR-DESC = ' '
    FNDRP. FIND REPORT WITH R-REPNAME = PRINTOUT.PO-REPNAME
    END-FIND
  END-IF
  IF ACTIVE-REPORT.AR-RECORD-LENGTH > 251
    ACTIVE-REPORT.AR-RECORD-LENGTH := 251
  END-IF
END-FIND
*
END-SUBROUTINE /* READ-ACTIVE-REPORT
*
************************************************************************
DEFINE SUBROUTINE SUBSTITUTION-VARIABLES
************************************************************************
G-SUBST-ENTRIES := 19
*
G-SUBST-VAR (01) := '§REPORT'
G-SUBST-VAR (02) := '§CDATE'
G-SUBST-VAR (03) := '§CTIME'
G-SUBST-VAR (04) := '§DATE'
G-SUBST-VAR (05) := '§TIME'
G-SUBST-VAR (06) := '§EXIT'
G-SUBST-VAR (07) := '§DESCR'
G-SUBST-VAR (08) := '§USER'
G-SUBST-VAR (09) := '§NAME'
G-SUBST-VAR (10) := '§DEPTNO'
G-SUBST-VAR (11) := '§DEPTNAME'
G-SUBST-VAR (12) := '§PHONE'
G-SUBST-VAR (13) := '§LOCATION'
G-SUBST-VAR (14) := '§ORGANIZATION'
G-SUBST-VAR (15) := '§ADDRESS1'
G-SUBST-VAR (16) := '§ADDRESS2'
G-SUBST-VAR (17) := '§ADDRESS3'
G-SUBST-VAR (18) := '§JOBNAME'
G-SUBST-VAR (19) := '§JOBNO'
*
G-SUBST-TEXT (01) := PRINTOUT.PO-REPNAME
*
MOVE EDITED ACTIVE-REPORT.AR-PROCESS-TIME (EM=YYYYMMDD) TO #DATE
CALLNAT 'IODATE-N' 'M' 'S' #DATE #FORMATED-DATE G-DATE-FORMAT
  #ERROR-CODE #ERROR-TEXT
IF #ERROR-CODE = 0
  #DATE := #S-FORMATED-DATE
END-IF
G-SUBST-TEXT (02) := #DATE
MOVE EDITED ACTIVE-REPORT.AR-PROCESS-TIME (EM=HH':'II)
  TO G-SUBST-TEXT (03)
MOVE EDITED *DATX (EM=YYYYMMDD) TO #DATE
CALLNAT 'IODATE-N' 'M' 'S' #DATE #FORMATED-DATE G-DATE-FORMAT
  #ERROR-CODE #ERROR-TEXT
IF #ERROR-CODE = 0
  #DATE := #S-FORMATED-DATE
END-IF
G-SUBST-TEXT (04) := #DATE
MOVE EDITED *TIMX (EM=HH':'II)  TO G-SUBST-TEXT (05)
G-SUBST-TEXT (06) := PRINTOUT.PO-EXITMEM
IF ACTIVE-REPORT.AR-DESC = ' '
  G-SUBST-TEXT (07) := REPORT.R-DESC
ELSE
  G-SUBST-TEXT (07) := ACTIVE-REPORT.AR-DESC
END-IF
G-SUBST-TEXT (08) := PRINTOUT.PO-USERID
COMPRESS USER.LAST-NAME ',' USER.FIRST-NAME
  TO G-SUBST-TEXT (09) LEAVING NO
G-SUBST-TEXT (10) := USER.WORK-DEPT-NUM
G-SUBST-TEXT (11) := USER.WORK-DEPT-NAME
IF USER.WORK-PHONE = ' '
  G-SUBST-TEXT (12) := USER.WORK-PHONE-EXT
ELSE
  COMPRESS USER.WORK-PHONE '/' USER.WORK-PHONE-EXT
    TO G-SUBST-TEXT (12) LEAVING NO
END-IF
G-SUBST-TEXT (13) := USER.WORK-LOCATION
G-SUBST-TEXT (14) := USER.WORK-ORGANIZATION
G-SUBST-TEXT (15) := USER.WORK-ADDRESS (01)
G-SUBST-TEXT (16) := USER.WORK-ADDRESS (02)
G-SUBST-TEXT (17) := USER.WORK-ADDRESS (03)
*
DECIDE ON FIRST #SPOOL-TYPE
  VALUE JES2, JES3
    G-SUBST-TEXT (18) := #SPOOL-JES-JOB-NAME
    G-SUBST-TEXT (19) := #SPOOL-JES-JOB-NUMBER
/*SU12 VALUE POWER
  VALUE SEQUENTIAL-FILE-BS2
    G-SUBST-TEXT (18) := #SPOOL-BS2-JOB-NAME
    G-SUBST-TEXT (19) := #SPOOL-BS2-JOB-ID
  NONE
    RESET G-SUBST-TEXT (18) G-SUBST-TEXT (19)
END-DECIDE
*
END-SUBROUTINE /* SUBSTITUTION-VARIABLES
*
************************************************************************
DEFINE SUBROUTINE READ-REPORT
************************************************************************
FIND REPORT WITH R-REPNAME = PRINTOUT.PO-REPNAME
END-FIND
*
END-SUBROUTINE /* READ-REPORT
*
************************************************************************
DEFINE SUBROUTINE CALL-STATISTIC-EXIT
************************************************************************
INCLUDE NOMEXC06
*
END-SUBROUTINE /* CALL-STATISTIC-EXIT
*
************************************************************************
DEFINE SUBROUTINE CHECK-IF-RESTART
************************************************************************
IF #TRACING
  COMPRESS 'Last printed recno in line' *LINE 'is'
    PRINTOUT.PO-LAST-PRINTED-RECNO
    TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END TRANSACTION
END-IF
IF PRINTOUT.PO-LAST-PRINTED-RECNO LE 0      /* not a restart
  ESCAPE ROUTINE
END-IF
#LINE-COUNT:= PRINTOUT.PO-TO-LINE
IF #LINE-COUNT LE 0                         /* automatic printout
  #LINE-COUNT:= ACTIVE-REPORT.AR-NUMBER-OF-LINES
END-IF
IF #LINE-COUNT LE 0                         /* can't handle it without
  ESCAPE ROUTINE                            /* a line count
END-IF
REPEAT UNTIL PRINTOUT.PO-LAST-PRINTED-RECNO LT #LINE-COUNT
  IF #TRACING
    COMPRESS 'Last printed recno in line' *LINE 'is'
      PRINTOUT.PO-LAST-PRINTED-RECNO '=' #COPIES
      TO G-TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
    END TRANSACTION
  END-IF
  IF PRINTOUT.PO-LAST-PRINTED-RECNO GE #LINE-COUNT
    SUBTRACT #LINE-COUNT FROM PRINTOUT.PO-LAST-PRINTED-RECNO
    SUBTRACT 1 FROM #COPIES
  END-IF
END-REPEAT
IF #COPIES LT 1
  G-NATRP-ERC:= 5
  COMPRESS 'Nothing left to print for restarted printout'
    PRINTOUT.PO-REPNAME PRINTOUT.PO-REPRNB TO G-NATRP-ERT
  ESCAPE ROUTINE
END-IF
RMARFL-LINE-FROM:= PRINTOUT.PO-FROM-LINE
  + PRINTOUT.PO-LAST-PRINTED-RECNO - FLUSH-LINES
FLUSH-LINES:= PRINTOUT.PO-LAST-PRINTED-RECNO
IF RMARFL-LINE-FROM LE 1
  RMARFL-LINE-FROM:= 1
ELSE
  IF RMARFL-LINE-FROM GT #LINE-COUNT
    G-NATRP-ERC:= 5
    COMPRESS 'Invalid line range - from:' RMARFL-LINE-FROM
      ',to:' PRINTOUT.PO-TO-LINE TO G-NATRP-ERT
  END-IF
END-IF
*
END-SUBROUTINE /* CHECK-IF-RESTART
*
************************************************************************
DEFINE SUBROUTINE ADD-STEPLIB
************************************************************************
** check existence of po-exitlib in steplib table
CALLNAT 'RLIBACT' PRINTOUT.PO-EXITLIB #STEPLIB-EXIST
IF NOT #STEPLIB-EXIST
  NAT00009-LIBRARY         := PRINTOUT.PO-EXITLIB
  RESET  NAT00009-FNR NAT00009-DBID
  CALLNAT 'RGETLIB' NAT00009-APPLIC
  NAT00009-FUNCTION := 08
  CALLNAT 'NAT00009' NAT00009-PARMS
  IF NAT00009-RESPONSE NE 0
    G-NATRP-ERC := 1078
    RMTASK-P.FUNCTION       := 'L'
    RMTASK-P.SUBTASK-NUMBER := 1
    CALLNAT 'RMTASKID' RMTASK-P
    LG-USERID := RMTASK-P.TASK-ID
    LG-CODE   := 'MO'
    COMPRESS  '1078'  PRINTOUT.PO-EXITLIB TO LG-MSG
    CALLNAT 'RLOG' PL-PARMS
    END TRANSACTION
    IF #TRACING
      COMPRESS 'Unable to add steplib' PRINTOUT.PO-EXITLIB
        TO G-TRACE-MSG
      PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
    END-IF
  ELSE
    STEPLIB-ADDED := TRUE
  END-IF
END-IF
*
END-SUBROUTINE /* ADD-STEPLIB
*
************************************************************************
DEFINE SUBROUTINE REMOVE-STEPLIB
************************************************************************
IF NOT STEPLIB-ADDED
  ESCAPE ROUTINE
END-IF
*
CALLNAT 'RLIBACT' PRINTOUT.PO-EXITLIB #STEPLIB-EXIST
IF #STEPLIB-EXIST
  NAT00009-FUNCTION := 16
  CALLNAT 'NAT00009' NAT00009-PARMS
END-IF
STEPLIB-ADDED := FALSE
*
END-SUBROUTINE /* REMOVE-STEPLIB
*
************************************************************************
DEFINE SUBROUTINE CALL-NOMEX014
************************************************************************
IF G-NATRP-ERC NE 0
  IF #TRACING
    COMPRESS 'RC' G-NATRP-ERC-A
      '/ No exit called due to error condition.' TO G-TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END-IF
  ESCAPE ROUTINE /* do nothing if error in preceeding step
END-IF
MOVE BY NAME PRINTOUT      TO #PRINTOUT
MOVE BY NAME ACTIVE-REPORT TO #ACTIVE-REPORT
MOVE BY NAME REPORT        TO #REPORT
RESET #SPOOL-ATTR-EXTENDED
RESIZE DYNAMIC #SPOOL-ATTR-EXTENDED TO 0
FOR-EXT.
FOR #I = 1 TO 120
  IF AR-SPOOL-ATTR-EXTENDED (#I) = ' '
    ESCAPE BOTTOM (FOR-EXT.)
  END-IF
  COMPRESS #SPOOL-ATTR-EXTENDED AR-SPOOL-ATTR-EXTENDED (#I)
    TO #SPOOL-ATTR-EXTENDED LEAVING NO
END-FOR
IF #TRACING
  COMPRESS 'Calling NOMEX014 with extended spool-attributes:'
    #SPOOL-ATTR-EXTENDED TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
CALLNAT 'NOMEX014' #PRINTOUT #ACTIVE-REPORT #REPORT #SPOOL-ATTR-EXTENDED
  NOMEX014-ERROR-CODE NOMEX014-ERROR-TEXT
G-NATRP-ERC := NOMEX014-ERROR-CODE
G-NATRP-ERT := NOMEX014-ERROR-TEXT
IF #TRACING
  IF G-NATRP-ERC = 0
    G-TRACE-MSG := 'NOMEX014 ended with no errors.'
    PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  ELSE
    COMPRESS 'NOMEX014 ended with error fields:'
      G-NATRP-ERC-A G-NATRP-ERT TO G-TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END-IF
END-IF
*
END-SUBROUTINE /* CALL-NOMEX014
*
************************************************************************
DEFINE SUBROUTINE GET-FLAGS
************************************************************************
FIND (1) USER-EXITS WITH M-MONITOR-ID = 'API-DEFS'
  FOR #I = 1 TO 20
    IF M-NOMEXIT-ACTIVE (#I) = 'Y'
      +G-NOMEXIT-ACTIVE (#I) := TRUE
    ELSE
      +G-NOMEXIT-ACTIVE (#I) := FALSE
    END-IF
  END-FOR
END-FIND
*
END-SUBROUTINE /* GET-FLAGS
*
************************************************************************
ON ERROR
************************************************************************
  BACKOUT TRANSACTION
*
  WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
    'Print Report abnormal termination'
  CALLNAT 'C-NATERN' G-NATRP-ERT
  PRINT NOTITLE NOHDR *PROGRAM 10T /*SU9
    *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II) G-NATRP-ERT
/*SU9 WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
/*SU9    G-NATRP-ERT (AL=70)
  G-NATRP-ERC := 21
  IF #PO-ID NE 0 AND NOT *ERROR-NR = 3000 THRU 3999
    PERFORM UPDATE-PRINTOUT-RECORD
  END-IF
  IF *MACHINE-CLASS = 'MAINFRAME'
    IF #TASK-TYPE = 'SUBTASK'
      STOP
    END-IF
    TERMINATE 50
  END-IF
  ESCAPE MODULE
*
END-ERROR
*
END
