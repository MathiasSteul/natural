* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* ----------------------------------------------------------------------
* Title........: Center Title
* Name.........: XXCTIT-N
* Version......: 1.0.0
* Quality check:
* Author.......: BF
* Type.........:
* Description..: This program takes a string and centers it
* Maintenance..:
* fhi 02-10-30 fhi101    switch on optimizer compiler
* SU1     2016-08-02 NOMALL-1518 NOM3.5 deactivate opt.Compiler
* ----------------------------------------------------------------------
*
/*SU1 OPTIONS MCG=(INDX=ON,OVFLW=ON,DIGTCHCK=ON) /*fhi101 inserted
DEFINE DATA
PARAMETER USING XXCTIT-A /* The own Interface
*
LOCAL     USING XXCTIT-L /* Locals only used here
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
EXAMINE #XX-TITLE FOR ' ' GIVING LENGTH #I
IF #I = 0 OR #I >= #XX-LENGTH
  ESCAPE ROUTINE
END-IF
*
#TITLE-TEMP := #XX-TITLE
RESET #XX-TITLE
#J := (#XX-LENGTH - #I) / 2 + 1
#K := #I + #J - 1
#XX-TITLE-A1 (#J:#K) := #TITLE-TEMP-A1 (1:#I)
IF #XX-NUMBER > 0
  #K := #J - 2
  IF #K <= 0
    ESCAPE ROUTINE
  END-IF
  #J := #K - (#XX-NUMBER - 1)
  IF #J < 1
    #J := 1
  END-IF
  #XX-TITLE-A1 (#J:#K) := #XX-CHARACTER
  #J := #K + #I + 3
  #K := #J + (#XX-NUMBER - 1)
  IF #K > #XX-LENGTH
    #K := #XX-LENGTH
  END-IF
  #XX-TITLE-A1 (#J:#K) := #XX-CHARACTER
END-IF
*
END
