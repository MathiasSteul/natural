* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* XSETOBA 2002-04-04 (CE5903) BOT DOESN'T WORK (ONLY FOR BUNDLES)
* SJU 2004-08-23 P(256132) ADACALLS EXCEEDED - SOLUTION COPIED FROM
*                XSETGGR SOLUTION TO P254201 IN RLISBU
* ----------------------------------------------------------------------
DECIDE FOR EVERY  CONDITION
  WHEN #NEWVAL
    RESET #PAGES(*) #MAXP #MAXAP
    PERFORM INIT-SELECTION-KEYS
    #PAGES(1) := #START-KEY
    #CP := #MAXAP := 1
  WHEN #BOT
    #HP := #NOFPAGES / 2.
    #I := 0
    READ BUNDLES BY B-BUNDLE = #PAGES(1) ENDING AT #S-BUNDLE-T
      ADD 1 TO #I
      IF #I = 16
        IF #CP = #NOFPAGES
          #PAGES(#HP - 1:#NOFPAGES - 1) := #PAGES(#HP : #NOFPAGES)
          RESET #PAGES(#CP)
          SUBTRACT 1 FROM #CP
        END-IF
        ADD 1 TO #CP
        #PAGES(#CP) := B-BUNDLE
        #I := 1
      END-IF
    END-READ
    #MAXAP := #CP
    #CP := 1
    #CP := #MAXAP
  WHEN #TOP
    #CP := 1
    INCLUDE C-FORWRD
  WHEN #BACKWARD
    IF #CP > 1
      IF #SCROLL-AMOUNT < 1
        #SCROLL-AMOUNT := 1
      END-IF
      SUBTRACT #SCROLL-AMOUNT FROM #CP
      IF #CP < 1
        #CP := 1
      END-IF
    END-IF
  WHEN GET-SCREEN IGNORE
  WHEN NONE ESCAPE ROUTINE
END-DECIDE
*
IF #CP >= #MAXAP
  #MAXAP := #CP
END-IF
*
#RSTART := #PAGES(#CP)
** End of copycode C-BRW ***********************************************
