* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RFLIPG-N  BUILD FLIP LINE
*
* MAINTENANCE:
*
* Userid yyyy-mm-dd SAGSIS  Remark
* ----------------------------------------------------------------------
* fhi    2000-04-25 P191368 Make module Nat31 STOW compliant
* SU1     2019-04-29 NOMALL-2266 avoid NAT0910 - avoid SORT statement
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 G-LC
  2 G-LC-NUM        (I2)
  2 G-LINE-COMMANDS (1:20)
    3 G-LC-IDENT    (I2)
    3 G-LC-CODE     (A2)
    3 G-LC-SHORT    (A10)
    3 G-LC-TEXT     (A32)
  2 #FLIP-LINES     (A78/2)
*
LOCAL
1 #I                (I2)
1 #I1               (I2)
1 #I2               (I2)
1 #I3               (I2)
1 #I4               (I2)
1 #J                (I2) INIT <1>
1 #TEMP-STRING      (A20)
1 #LENGTH-FLIP      (I2)
1 #LENGTH-TEMP      (I2)
1 #TAB              (I2/1:20)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET #FLIP-LINES(*)
FOR #I=1 TO G-LC-NUM
  #TAB (#I) := #I
END-FOR
FOR #I=1 TO G-LC-NUM
  FOR #I1=#I TO G-LC-NUM
    #I2 := #TAB(#I)
    #I3 := #TAB(#I1)
    IF G-LC-CODE (#I3) < G-LC-CODE (#I2)
      #I4 := #TAB(#I1)
      #TAB(#I1) := #TAB(#I)
      #TAB(#I) := #I4
    END-IF
  END-FOR
END-FOR
*
FOR #I=1 TO G-LC-NUM
  #I2 := #TAB(#I)
  COMPRESS '<' G-LC-CODE (#I2) '#' G-LC-SHORT (#I2)
    TO #TEMP-STRING LEAVING NO
  EXAMINE #FLIP-LINES (#J) FOR ' ' GIVING LENGTH #LENGTH-FLIP
  EXAMINE #TEMP-STRING     FOR ' ' GIVING LENGTH #LENGTH-TEMP
  IF #LENGTH-TEMP > 77 - #LENGTH-FLIP OR #LENGTH-TEMP = 0
    IF #J = 2
      ESCAPE ROUTINE  /* that's all we can handle
    END-IF
    ADD 1 TO #J
  END-IF
  COMPRESS #FLIP-LINES (#J) #TEMP-STRING TO #FLIP-LINES (#J)
END-FOR
*
END
