* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RMIGDLXR - xref of related objects of a distribution list
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* mrs 93-10-11 s(999999) translate some texts
* xsiszha 2000-08-02 (CE7461) Extend Report and Bundle Names
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 #P-MSG            (N4)
1 #PARMS
  2 #P-LIST         (A8)
  2 #P-NUMBER       (P3)
  2 #P-USER         (200)
    3 #P-USERID     (A8)
    3 #P-USER-MSG   (A4)
1 #LAN-TEXT         (A70/1:6)
************************************************************************
LOCAL USING VDISTS-L
LOCAL
1 MIGRATE-USERS VIEW OF NRM-MIGRATE-USERS
1 MIGRATE-LIST VIEW OF NRM-MIGRATE-DISTRIBUTION-LIST
1 #I         (P2)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET #P-MSG
FNDS. FIND DISTRIBUTION-LIST WITH D-LIST-NAME = #P-LIST
  IF NO RECORDS FOUND
    #P-MSG := 4017
    ESCAPE BOTTOM (FNDS.)
  END-NOREC
  PERFORM CHECK-RELATED-OBJECTS
END-FIND
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE CHECK-RELATED-OBJECTS
************************************************************************
#P-NUMBER := DISTRIBUTION-LIST.C*D-USER-LIST
FOR #I = 1 TO DISTRIBUTION-LIST.C*D-USER-LIST
  #P-USERID (#I) := DISTRIBUTION-LIST.D-USER-LIST (#I)
  FNDU. FIND NUMBER MIGRATE-USERS
    WITH USER-ID = DISTRIBUTION-LIST.D-USER-LIST (#I)
  IF *NUMBER (FNDU.) = 0
    FNDL. FIND NUMBER MIGRATE-LIST
      WITH D-LIST-NAME = DISTRIBUTION-LIST.D-USER-LIST (#I)
    IF *NUMBER = 0
      #P-USER-MSG (#I) := #LAN-TEXT (2)
    ELSE
      #P-USER-MSG (#I) := #LAN-TEXT (1)
    END-IF
  ELSE
    #P-USER-MSG (#I) := #LAN-TEXT (1)
  END-IF
END-FOR
*
END-SUBROUTINE /* CHECK-RELATED-OBJECTS
*
END
