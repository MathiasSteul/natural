* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RMIGCACO
* Function:  copy calendar from source to target environment
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 #P-MSG     (N4)
1 #P-ID      (A12)
************************************************************************
LOCAL USING VCALEN-L
LOCAL USING VTCAL--L
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
FNDS. FIND CALENDARS WITH CA-CALENDAR-ID = #P-ID
  IF NO RECORDS FOUND
    #P-MSG := 4016
    ESCAPE BOTTOM (FNDS.)
  END-NOREC
  FNDT. FIND MIGRATE-CALENDARS WITH CA-CALENDAR-ID = #P-ID
    IF NO RECORDS FOUND
      ENTER
    END-NOREC
    MOVE BY NAME CALENDARS TO MIGRATE-CALENDARS
    IF *NUMBER (FNDT.) = 0
      STORE MIGRATE-CALENDARS
    ELSE
      UPDATE (FNDT.)
    END-IF
  END-FIND
END-FIND
END OF TRANSACTION
*
END
