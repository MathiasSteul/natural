DEFINE SUBROUTINE DO-IT2
************************************************************************
DECIDE ON FIRST VALUE OF #I
  VALUE 151
    INCLUDE RMFL---C 'SYMBOL-VAL.#SPOOL-JES-FCB'
  VALUE 152
    INCLUDE RMFL---C 'SYMBOL-VAL.#SPOOL-JES-FLASH'
  VALUE 153
    INCLUDE RMFL---C 'SYMBOL-VAL.#SPOOL-JES-FORM'
  VALUE 154
    INCLUDE RMFL---C 'SYMBOL-VAL.#SPOOL-JES-FORMDEF'
  VALUE 155
