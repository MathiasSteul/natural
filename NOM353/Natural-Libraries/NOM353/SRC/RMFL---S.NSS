  VALUE 157
    INCLUDE RMFL---C 'SYMBOL-VAL.#SPOOL-JES-RECFM'
  VALUE 158
    INCLUDE RMFL---C 'SYMBOL-VAL.#SPOOL-JES-COPIES'
  VALUE 159
    INCLUDE RMFL---C 'SYMBOL-VAL.#SPOOL-JES-UCS'
  VALUE 160
