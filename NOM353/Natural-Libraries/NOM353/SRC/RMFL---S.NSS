************************************************************************
DEFINE SUBROUTINE #EXAM /*SU4
************************************************************************
IF #STRING2 = ' '
  EXAMINE #STRING #SYMBOL DELETE LENGTH ##LEN1
ELSE
  EXAMINE #STRING2 #SYMBOL NUMBER ##LEN1
  IF ##LEN1 NE 0
    PRINT (AD=L) 'Recursive replcmnt. Ignored ('#I'):'
      #SYMBOL '=' #STRING2
    EXAMINE #STRING #SYMBOL DELETE
  ELSE
    EXAMINE #STRING #SYMBOL REPLACE #STRING2
  END-IF
END-IF
*
END-SUBROUTINE /* #EXAM
*
END-SUBROUTINE /* RMFL---S-SUBSTITUTE-SYMBOLS
*
END
