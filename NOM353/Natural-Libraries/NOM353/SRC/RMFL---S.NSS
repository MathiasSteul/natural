* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RMFL---S - Subroutine to substitute NOM printer symbols                          >
*
* Reads the table in RMFL---E. In SYMBOL (*)
* it finds the symbol the user has entered in #STRING, preceeded by
* escape character '&'. Then it reads the desired value from
* the SYMBOL-VAL group. Thus changes in RMFL---P must reflect
* the same changes in RMFL---E to replace the new symbol(s).
*
* As a high amount of memory is needed, catalog this module using
* NOM.IV340.CNTL(CATRMFLS)
*
* Maintenance
* uuuuuuuu yyyy-mm-dd Issue
* fhi      2010-11-12 NOMALL-856  Created
* fhi      2010-12-21 NOMALL-856  Blank fields not needed
* fhi      2011-03-04 NOMALL-856  Spool-Attributes blank
* fhi      2011-03-10 NOMALL-856  Replace with null string
* fhi      2011-03-22 NOMALL-856  If no &, then escape at once
* fhi      2011-04-18 NOMALL-947  Avoid 0C7 on mainframes
* fhi      2012-06-12 NOMALL-1004 Extensions for NOM 3.4
* SU1      2013-10-24 NOMALL-1291 NAT1308 for DISKUNIX - show better msg
* SU2      2013-11-20 NOMALL-1306 avoid NAT6011 during compile on unix
*                     recat, since RMFL---C changed
* fhi      2014-08-25 NOMALL-1475 Introduce formatter uniprint
* fhi      2014-10-09 NOMALL-1504 Allow symbols as parameter in #SYM
*                                 format: &symb1=value;&symb2=value;...
* fhi      2014-11-13 NOMALL-1500 Still buffer problems (Unix), code
*                                 separated into several blocks.
*                                 Partly rewritten, no tags.
* fhi      2015-03-25 NOMALL-1561 Avoid NAT0965 on Unix, code shortened
* SU3      2016-02-02 NOMALL-1722 support long path names
* SU4      2018-02-16 NOM 3.5     avoid compile error NAT7545(RMFL---C)
* SU5      2022-01-12 NOMALL-2515 add sym NOUT (OUTPUT)
* SU6      2024-03-07 ES-34613    NOM 3.6 Remove power
* ----------------------------------------------------------------------
DEFINE DATA
PARAMETER USING RMFL---P
PARAMETER
1 #STRING             (A) DYNAMIC BY VALUE RESULT /*NOMALL-1561 was A250
1 #P-SPOOL-ATTRIBUTES (A250)               /* NOMALL-856 2011-03-04 in
1 #SYM                (A) DYNAMIC BY VALUE OPTIONAL  /* NOMALL-1504 in
************************************************************************
LOCAL USING RMFL---E
LOCAL USING RMSPL--L
LOCAL USING RMSR---E
LOCAL USING EOMPHTYE
LOCAL USING XXHASH-P /*SU3
LOCAL
1 #I                   (I2)
1 #J                   (I2)
1 #K                   (I2)
1 #POS                 (I2)
1 ##POS                (I2)         /* for copycode
1 ##STRING             (A)  DYNAMIC /* for copycode
1 #STRING2             (A)  DYNAMIC /*SU4
1 #LEN                 (I2)
1 #ESCAPE              (I2)
1 #STRING-LEN          (I2)
1 #SYMBOL-FOUND        (L)
1 #DELIMITER-FOUND     (L)
1 #RND                 (F8)
1 #SYMBOL              (A11)  INIT <'&'>
1 REDEFINE #SYMBOL
  2 #ESC-CHAR          (A1)
  2 #SYMBOL-VALUE      (A10)
1 #TIMSTMP             (B8)
1 REDEFINE #TIMSTMP
  2 #FILLER            (B4)
  2 #TIMSTMP-B         (B4)
1 #TIMSTMP-N           (N10)
1 #SPECIAL-CHAR        (A1/32) CONST
  <' ','Ü','"','@','$','%','&','/','(',')','=','?','§','+','*',
  'ß','''','#',',',';','.',':','-','_','<','>','!'>
1 ##LEN1 (I2)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE RMFL---S-SUBSTITUTE-SYMBOLS
************************************************************************
/* Check for symbols at all
EXAMINE #STRING FOR '&' GIVING POSITION IN #POS
IF #POS = 0
  ESCAPE ROUTINE
END-IF
/* Init system symbol values:
#SPOOL-ATTRIBUTES := #P-SPOOL-ATTRIBUTES
IF #SPOOL-NAF-ST-ID = MASK (NNNNNNNNNZ)  /*P10 format ?
  #SPOOL-NAF-ST-ID-DYN := #SPOOL-NAF-ST-ID
END-IF
IF FLUSH-REPRNB     = MASK (NNNNNNNNNNZ) /*P11 format ?
  FLUSH-REPRNB-DYN := FLUSH-REPRNB
END-IF
IF FLUSH-BUNDRNB    = MASK (NNNNNNNNNNZ) /*P11 format ?
  FLUSH-BUNDRNB-DYN := FLUSH-BUNDRNB
END-IF
MOVE BY NAME FLUSH-PARMS  TO SYMBOL-VAL /*RMFL---P -> RMFL---E ÜÜÜ
MOVE BY NAME #SPOOL-GROUP TO SYMBOL-VAL /*RMSPL--L -> RMFL---E ÜÜÜ
DECIDE FOR EVERY CONDITION
  WHEN    SYMBOL-VAL.FLUSH-PRINTER-TYPE NE 'WRTSPOOL'
    RESET WRTSPL-GROUP
  WHEN    SYMBOL-VAL.FLUSH-PRINTER-TYPE NE 'EMAIL'
    RESET EMAIL-GROUP
  WHEN    SYMBOL-VAL.FLUSH-PRINTER-TYPE NE 'UNIXLP'
    RESET UNIXLP-GROUP
  WHEN    SYMBOL-VAL.FLUSH-PRINTER-TYPE NE 'NATUNIX'
    RESET NATUNIX-GROUP
  WHEN    SYMBOL-VAL.FLUSH-PRINTER-TYPE NE 'DISKUNIX'
    RESET DISKUNIX-GROUP
    RESET DISKUNIX-GROUP2 /* NOMALL-1004 in
  WHEN    #SPOOL-GROUP.#SPOOL-TYPE NE CMASPOOL
    RESET #SPOOL-CMA-GROUP
  WHEN NOT(#SPOOL-GROUP.#SPOOL-TYPE = JES2 OR=JES3)
    RESET #SPOOL-JES-GROUP
/*SU6  WHEN    #SPOOL-GROUP.#SPOOL-TYPE NE POWER
  WHEN    #SPOOL-GROUP.#SPOOL-TYPE NE SEQUENTIAL-FILE-BS2
    RESET #SPOOL-BS2-GROUP
  WHEN    #SPOOL-GROUP.#SPOOL-TYPE NE NAT
    RESET #SPOOL-NAF-GROUP
  WHEN    #SPOOL-GROUP.#SPOOL-TYPE NE SEQUENTIAL-FILE-UNIX
    RESET #SPOOL-UNIX-GRP
  WHEN    #SPOOL-GROUP.#SPOOL-TYPE NE DIRECT-INPUT
    RESET #SPOOL-DI-GROUP
  WHEN NONE
    IGNORE
END-DECIDE
REPEAT
  CALLNAT 'XXRANDOM' #RND /* Get random no between 0 and 1
  #RND     := #RND * 10000
  #RND     := INT(#RND)
  UNTIL #RND NE 0
END-REPEAT
MOVE EDITED #RND (EM=9999) TO SYMBOL-VAL.#RANDOM
SYMBOL-VAL.#DATE      := *DATI
SYMBOL-VAL.#TIME      := *TIMN
#TIMSTMP              := *TIMESTMP
#TIMSTMP-N            := #TIMSTMP-B
SYMBOL-VAL.#TIMESTAMP := #TIMSTMP-N + 2147483648
SYMBOL-VAL.#PID       := *PID
REPEAT
  RESET #SYMBOL-FOUND
  ADD 1 TO #ESCAPE
  FOR1. FOR #I = 1 TO 150
    IF SYMBOL (#I) = ' '
      ESCAPE BOTTOM (FOR1.)
    END-IF
    #SYMBOL-VALUE := SYMBOL (#I)
    EXAMINE #STRING FOR #SYMBOL GIVING POSITION #POS LENGTH #STRING-LEN
    IF #POS = 0
      ESCAPE TOP
    END-IF
    #SYMBOL-FOUND := TRUE
    EXAMINE #SYMBOL FOR 'X' GIVING LENGTH IN #LEN
    #J := #POS + #LEN
    IF #J LE #STRING-LEN
      RESET #DELIMITER-FOUND
      FOR3. FOR #K := 1 TO 27 /* scan the special-characters
        EXAMINE FULL SUBSTR(#STRING,#J,1) FOR FULL #SPECIAL-CHAR (#K)
          GIVING POSITION IN #POS
        IF #POS = 0
          ESCAPE TOP
        END-IF
        #DELIMITER-FOUND := TRUE
        ESCAPE BOTTOM (FOR3.)
      END-FOR
      IF NOT #DELIMITER-FOUND
        RESET #SYMBOL-FOUND
        ESCAPE TOP /* was not the symbol, no delimiter or no '.'
      END-IF
      EXAMINE SUBSTR(#STRING,#J) FOR '.' AND DELETE FIRST
      PERFORM DO-IT1
    END-IF
  END-FOR
  UNTIL NOT #SYMBOL-FOUND OR #ESCAPE > 99
END-REPEAT
REPEAT
  RESET #SYMBOL-FOUND
  ADD 1 TO #ESCAPE
  FOR2. FOR #I = 151 TO SYMBOL-MAX
    IF SYMBOL (#I) = ' '
      ESCAPE BOTTOM (FOR2.)
    END-IF
    #SYMBOL-VALUE := SYMBOL (#I)
    EXAMINE #STRING FOR #SYMBOL GIVING POSITION #POS LENGTH #STRING-LEN
    IF #POS = 0
      ESCAPE TOP
    END-IF
    #SYMBOL-FOUND := TRUE
    EXAMINE #SYMBOL FOR 'X' GIVING LENGTH IN #LEN
    #J := #POS + #LEN
    IF #J LE #STRING-LEN
      RESET #DELIMITER-FOUND
      FOR4. FOR #K := 1 TO 27 /* scan the special-characters
        EXAMINE FULL SUBSTR(#STRING,#J,1) FOR FULL #SPECIAL-CHAR (#K)
          GIVING POSITION IN #POS
        IF #POS = 0
          ESCAPE TOP
        END-IF
        #DELIMITER-FOUND := TRUE
        ESCAPE BOTTOM (FOR4.)
      END-FOR
      IF NOT #DELIMITER-FOUND
        RESET #SYMBOL-FOUND
        ESCAPE TOP /* was not the symbol, no delimiter or no '.'
      END-IF
      EXAMINE SUBSTR(#STRING,#J) FOR '.' AND DELETE FIRST
      PERFORM DO-IT2
    END-IF
  END-FOR
  UNTIL NOT #SYMBOL-FOUND OR #ESCAPE > 99
END-REPEAT
/* Now delete remaining symbols that were not found (unknown):
REPEAT
  EXAMINE #STRING FOR '&' GIVING POSITION #POS LENGTH #STRING-LEN
  IF #POS = 0
    ESCAPE BOTTOM
  END-IF
  #J := #POS + 1
  IF #J > #STRING-LEN
    ESCAPE BOTTOM
  END-IF
  EXAMINE FULL SUBSTR(#STRING,#J) FOR '.' GIVING POSITION #LEN
  IF #LEN = 0
    ESCAPE BOTTOM
  END-IF
  SUBTRACT 1 FROM #LEN /* without delimiter
  #SYMBOL-VALUE := SUBSTR(#STRING,#J,#LEN)
  EXAMINE #STRING FOR #SYMBOL AND DELETE
  EXAMINE SUBSTR(#STRING,#J) FOR '.' AND DELETE FIRST
END-REPEAT
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
***********
ON ERROR
***********
  PRINT (AD=L) '==> NAT' *ERROR 'in' *PROGRAM '(line:' *ERROR-LINE ')'
    / '=' #STRING
    / '=' #I '=' #SYMBOL
END-ERROR
*
************************************************************************
DEFINE SUBROUTINE DO-IT1
************************************************************************
/* The following symbol replacement must be done this way because
/* of the following reasons:
/* - The replacement must be done with alpha variables, not the
/*   given structure of RMFL---P.
/* - An array with alpha values with constant length would waste space.
/* So we implement the array with different variables as DECIDE.
/* This is also independent of structure changes in RMFL---P because
/* MOVE BY NAME will fill the symbol value structure.
/* RMFL---C: EXAMINE #STRING #SYMBOL REPLACE &1&
DECIDE ON FIRST VALUE OF #I
  VALUE   1
    INCLUDE RMFL---C 'SYMBOL-VAL.FLUSH-POID'
  VALUE   2
    INCLUDE RMFL---C 'SYMBOL-VAL.FLUSH-PROGRAM'
  VALUE   3
    INCLUDE RMFL---C 'SYMBOL-VAL.FLUSH-COPIES'
