* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* EOMPHH-N - Physical Printer Field Help
*
* Maintenance
* UUU YYYY-MM-DD iTrac         Desciption
* gw  1993-06-07             created
* fhi 2017-04-07 NOMALL-1961 Omit field PO-MONITOR
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 #FIELD-NAME    (A65)
************************************************************************
LOCAL
1 F              (P2)
1 #FIELD         (A65)
1 REDEFINE #FIELD
  2 #F           (A1/1:65)
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#FIELD := #FIELD-NAME
EXAMINE #FIELD FOR '.' GIVING POSITION IN F
IF F > 0
  RESET #F (1:F)
  MOVE LEFT #FIELD TO #FIELD
END-IF
*
DECIDE ON FIRST #FIELD
  VALUE '#PRINTER'                      INPUT USING MAP 'HPHPPHY&'
  VALUE 'EOMPRM-PHYSICAL-NAME'          INPUT USING MAP 'HPHPPHY&'
  VALUE 'EOMPHM-PRINTER-TYPE'           INPUT USING MAP 'HPHPTYP&'
  VALUE 'EOMPHM-LOCATION'               INPUT USING MAP 'HPHPLOC&'
  VALUE 'EOMPHM-PRINT-PGM'              INPUT USING MAP 'HPHPPGM&'
  VALUE 'EOMPHM-JCL-SKELETON'           INPUT USING MAP 'HPHPSKL&'
  VALUE 'EOMPHM-MAX-LINES'              INPUT USING MAP 'HPHPMAX&'
  VALUE 'EOMPHM-TIME-FROM'              INPUT USING MAP 'HPHPTIM&'
  VALUE 'EOMPHM-TIME-TO'                INPUT USING MAP 'HPHPTIM&'
  VALUE 'EOMPHM-ESCAPE-CHAR'            INPUT USING MAP 'HPHPESC&'
  VALUE 'EOMPHM-ATTR-LENGTH'            INPUT USING MAP 'HPHPLEN&'
  VALUE 'EOMPHM-ATTR-PROMPT'            INPUT USING MAP 'HPHPERR&'
  VALUE 'EOMPHM-ATTR-VAR'               INPUT USING MAP 'HPHPSUB&'
  VALUE 'EOMPHM-ATTR-DEFAULT'           INPUT USING MAP 'HPHPDEF&'
  VALUE 'EOMPHM-ATTR-DEFAULT-1-50'      INPUT USING MAP 'HPHPDEF&'
  VALUE 'EOMPHM-ATTR-DEFAULT-51-72'     INPUT USING MAP 'HPHPDEF&'
  NONE                                  IGNORE
END-DECIDE
*
END
