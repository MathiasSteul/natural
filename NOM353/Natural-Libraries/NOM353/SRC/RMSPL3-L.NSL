    3 #SPOOL3-BS2-ORIGINATOR-JOB-ID (A5)
    3 #SPOOL3-BS2-COPIES (N3)
    3 #SPOOL3-BS2-FORM (A8)
    3 #SPOOL3-BS2-CHARS (A16)
    3 #SPOOL3-BS2-DSNAME (A54)
    3 #SPOOL3-BS2-CONTROL-OPTION (A16)
    3 #SPOOL3-BS2-DESTINATION (A8)
    3 #SPOOL3-BS2-DEVICE (A8)
    3 #SPOOL3-BS2-ROTATION (A8)
    3 #SPOOL3-BS2-DIA (A2)
    3 #SPOOL3-BS2-SIZE (A6)
    3 #SPOOL3-BS2-RECFM (A5)
    3 #SPOOL3-BS2-RECSIZE (N5)
    3 #SPOOL3-BS2-BLKSIZE (N5)
    3 #SPOOL3-BS2-SECONDARY (N7)
    3 #SPOOL3-BS2-ORIG-DSNAME (A54)
    3 #SPOOL3-BS2-CLASS (A4)
*   ---------------------------------      -----------------------------------
*   JES
*   ---------------------------------      -----------------------------------
  2 REDEFINE #SPOOL3-ATTRIB
    3 #SPOOL3-JES-NODE (N3)
    3 #SPOOL3-JES-JOB-NAME (A10)
    3 #SPOOL3-JES-JOB-NUMBER (N7)
    3 REDEFINE #SPOOL3-JES-JOB-NUMBER
      4 #SPOOL3-JES-JOB-NUMBER-A (A7)
    3 #SPOOL3-JES-DSTYPE (A2)
    3 #SPOOL3-JES-DSNO-OLD (N3)
    3 #SPOOL3-JES-DATASET-KEY (N7)
    3 #SPOOL3-JES-GROUP-ID (A20)
    3 #SPOOL3-JES-PROCNAME (A8)
    3 #SPOOL3-JES-STEPNAME (A8)
    3 #SPOOL3-JES-DDNAME (A8)
    3 #SPOOL3-JES-CHARS (A20)
    3 #SPOOL3-JES-FCB (A4)
    3 #SPOOL3-JES-FLASH (A4)
    3 #SPOOL3-JES-FORM (A8)
    3 #SPOOL3-JES-FORMDEF (A8)
    3 #SPOOL3-JES-PAGEDEF (A8)
    3 #SPOOL3-JES-TRC (A3)
    3 #SPOOL3-JES-RECFM (A3)
    3 #SPOOL3-JES-COPIES (N3)
    3 #SPOOL3-JES-UCS (A4)
    3 #SPOOL3-JES-BURST (A3)
    3 #SPOOL3-JES-COMPACT (A8)
    3 #SPOOL3-JES-LINECT (N3)
    3 #SPOOL3-JES-DESTINATION (A8)
    3 #SPOOL3-JES-TRIGGER-DSNAME (A44)
    3 #SPOOL3-JES-DSNO (N5)
* **SU1 POWER: #SPOOL3-POWER-..
* **End of LDA RMSPL3-L *************************************************
