G-PF-CODE  (01) := G-PF-CODE  (13) := ##PFK-HELP
*
G-PF-IDENT (03) := G-PF-IDENT (15) := ##PFN-EXIT
G-PF-CODE  (03) := G-PF-CODE  (15) := ##PFK-EXIT
*
G-PF-IDENT (04) := G-PF-IDENT (16) := ##PFN-FLIP
G-PF-CODE  (04) := G-PF-CODE  (16) := ##PFK-FLIP
*
G-PF-IDENT (12) := G-PF-IDENT (24) := ##PFN-MENU
