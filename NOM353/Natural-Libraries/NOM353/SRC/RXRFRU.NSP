* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    RXRFRU
* Function  Display Users connected to an active Report
* Version   1.3
*
* MAINTENANCE
* uuu yy-mm-dd s(999999) ...
* mrs 93-08-05           rewritten
* xsiszha 2000-08-15 (CE7461) Extend Report and Bundle Names
* sju     2002-11-13 p(231843) mail wrong if run number wraps round
* xsetggr 2003-08-19 p(240465) accept non-defined userid
* sju     2004-10-13 p(257820) loop reading mail records
* xsetggr 2007-08-27 NOM3201  Support P11 format run numbers
* ----------------------------------------------------------------------
DEFINE DATA GLOBAL USING NRM-GL
LOCAL  USING RTXT---L
* ----------------------------------------------------------------------
LOCAL
1 MAIL VIEW OF NRM-MAIL
  2 MA-USERID
  2 MA-REPRNB
  2 MA-STATUS
  2 MA-REPNAME
1 USER VIEW OF NRM-USERS
  2 FIRST-NAME
  2 LAST-NAME
*
1 #I                   (P2)
1 #NOFLINES            (I2)   CONST <10>
1 #SCREEN              (1:#NOFLINES)
  2 L-NAME             (A40)
  2 L-USER-ID          (A8)
  2 L-CONFIRM          (A10)
*
1 CV-LINE              (C/1:#NOFLINES)
1 END-OF-PROCESSING    (L)
1 END-OF-DISPLAY       (L)
1 END-OF-DATA          (L)
1 NEW-SEARCH           (L)
*
1 #PAGE                (P3)  INIT <1>
1 #NOFPAGES            (I2)  CONST <40>
1 #MA-RNB-USER         (A14/1:#NOFPAGES)
1 REDEFINE #MA-RNB-USER
  2 #MA-RNB-USER-TAB   (1:#NOFPAGES)
    3 #MA-RNB          (P11)
    3 #MA-USER         (A8)
*
1 J                    (P2)
1 #NOT                 (P2)   CONST <2>
1 #LAN-TAB (1:#NOT)
  2 #LAN-IDENT         (I2)
  2 #LAN-TXT           (A70)
1 #M-REPORT            (A25)
1 REDEFINE #M-REPORT
  2 #M-REPORT-17       (A17)
  2 #M-REPORT-R        (A8)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
*
DEFINE WINDOW USER-WINDOW SIZE 20*66 BASE 03/10 CONTROL WINDOW
*
PERFORM PF-KEYS
PERFORM INIT-TEXT
*
#MA-RNB         (1) := G-C-REPRNB
#MA-USER (1) := H'0000000000000000'
MAIN. REPEAT
  UNTIL END-OF-PROCESSING
  RESET #I
  RESET INITIAL END-OF-DATA NEW-SEARCH
  REA. READ MAIL BY MA-RNB-USER = #MA-RNB-USER (#PAGE)
*
    IF MA-REPRNB NE G-C-REPRNB
      ESCAPE BOTTOM (REA.)
    END-IF
    IF MA-REPNAME NE G-C-REPORT
      ESCAPE TOP
    END-IF
*
    IF #I = #NOFLINES
      PERFORM SCREEN-IO
      IF END-OF-PROCESSING OR NEW-SEARCH
        ESCAPE BOTTOM (REA.)
      END-IF
    END-IF
    ADD 1 TO #I
    PERFORM USER-TO-SCREEN
*
  END-READ
*
  DECIDE FOR FIRST CONDITION
    WHEN #I > 0
      END-OF-DATA := TRUE
    WHEN *COUNTER (REA.) = 0
      ESCAPE BOTTOM (MAIN.)
    WHEN ANY
      PERFORM SCREEN-IO
    WHEN NONE
      IGNORE
  END-DECIDE
END-REPEAT
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE SCREEN-IO
************************************************************************
RESET END-OF-DISPLAY
REPEAT
  DECIDE FOR FIRST CONDITION
    WHEN G-NATRP-ERC NE 0
      IGNORE
    WHEN END-OF-DATA AND #PAGE > 1
      G-NATRP-ERC := 12                   /* bottom of data
    WHEN END-OF-DATA AND #PAGE = 1
      G-NATRP-ERC := 14                   /* all
    WHEN NOT END-OF-DATA AND #PAGE = 1
      G-NATRP-ERC := 11                   /* top of data
    WHEN NONE
      G-NATRP-ERC := 13                   /* more
  END-DECIDE
  #M-REPORT := G-C-REPORT
  IF NOT G-DISPLAY-LONG-NAMES
    #M-REPORT-R := H'FA'
  END-IF
  PERFORM FLIP-DISPLAY
  SET CONTROL 'M15'
  INPUT WINDOW = 'USER-WINDOW' WITH TEXT *G-NATRP-ERC, G-NATRP-ERT
    USING MAP 'RXRFRUM&'
  SET CONTROL 'M21'
  RESET G-NATRP-ERC G-NATRP-ERT
  PERFORM COMMAND-PF-KEY
  UNTIL END-OF-DISPLAY
END-REPEAT
RESET #I #SCREEN (*)
*
END-SUBROUTINE /* SCREEN-IO
*
************************************************************************
DEFINE SUBROUTINE USER-TO-SCREEN
************************************************************************
FNDUS. FIND USER WITH USER-ID = MA-USERID
*
  IF NO RECORDS FOUND
    RESET L-NAME (#I)
    ESCAPE BOTTOM
    PERFORM MAIL-STATUS
  END-NOREC
*
  COMPRESS LAST-NAME ',' TO L-NAME (#I) LEAVING NO
  COMPRESS L-NAME (#I) FIRST-NAME TO L-NAME (#I)
  PERFORM MAIL-STATUS
*
END-FIND
L-USER-ID (#I) := MAIL.MA-USERID
*
END-SUBROUTINE /* USER-TO-SCREEN
*
************************************************************************
DEFINE SUBROUTINE MAIL-STATUS
************************************************************************
DECIDE ON FIRST MAIL.MA-STATUS
  VALUE 'C'
    L-CONFIRM (#I) := #LAN-TXT (1)
  VALUE 'P'
    L-CONFIRM (#I) := #LAN-TXT (2)
  NONE VALUE
    IGNORE
END-DECIDE
*
END-SUBROUTINE /* MAIL-STATUS
*
************************************************************************
DEFINE SUBROUTINE COMMAND-PF-KEY
************************************************************************
DECIDE ON FIRST *PF-KEY
  VALUE 'PF3'
    END-OF-PROCESSING := TRUE            /* return to
    END-OF-DISPLAY           := TRUE     /* father-prog
  VALUE 'PF7'
    IF #PAGE > 1
      #PAGE := #PAGE - 1
      END-OF-DATA    := FALSE
      END-OF-DISPLAY := TRUE
      NEW-SEARCH     := TRUE
    END-IF
  VALUE 'PF8'
    IF NOT END-OF-DATA
      ADD 1 TO #PAGE
      IF #PAGE > #NOFPAGES
        #PAGE := #NOFPAGES
        #MA-RNB-USER (1:#NOFLINES - 1) := #MA-RNB-USER (2:#NOFLINES)
      END-IF
      #MA-RNB (#PAGE)  := G-C-REPRNB
      #MA-USER (#PAGE) := MAIL.MA-USERID
      END-OF-DISPLAY := TRUE
    END-IF
  NONE           IGNORE
END-DECIDE
*
END-SUBROUTINE /* COMMAND-PF-KEY
*
************************************************************************
DEFINE SUBROUTINE PF-KEYS
************************************************************************
SET KEY PF1 = PGM PF2 = PGM PF3 = PGM PF4 = PGM PF5 = PGM PF6 = PGM
  PF7 = PGM PF8 = PGM PF9 = PGM PF10 = PGM PF11 = PGM PF12 = PGM
*
END-SUBROUTINE /* PF-KEYS
*
************************************************************************
DEFINE SUBROUTINE INIT-TEXT
************************************************************************
#LAN-IDENT (1) := ##TXT-CONFIRM-PRINT
#LAN-IDENT (2) := ##TXT-CONFIRMED-PRINT
FOR J = 1 TO #NOT
  IF #LAN-IDENT (J) NE 0
    CALLNAT 'RLTINI-N' #LAN-IDENT (J) #LAN-TXT   (J) G-TXB
  END-IF
END-FOR
*
END-SUBROUTINE /* INIT-TEXT
*
END
