* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* ----------------------------------------------------------------------
* Member    XXXML-N
* Version   3.3
* Function  Create XML file as a string from text array
* Template  NOMRPCXT
*
* ----------------------------------------------------------------------
*
* Maintenance
* -----------
* uuuuuu yyyy-mm-dd P999999 Remark
* fhi    2011-10-13         Created.
* ----------------------------------------------------------------------
DEFINE DATA
*
PARAMETER
1 #FUNCTION                (A1)
*
* Function:
* F - Create complete file including XML prefix "<?xml version..."
* G - Create a group only, indent to level #GROUP-LEVEL
*
1 #TEXT-ARRAY              (A/*) DYNAMIC BY VALUE
1 #TAG-ARRAY               (A/*) DYNAMIC BY VALUE
1 #TAG-GROUP               (A)   DYNAMIC BY VALUE
1 #GROUP-LEVEL             (N2)          BY VALUE
1 #XML-STRING              (A)   DYNAMIC BY VALUE RESULT
*
LOCAL
1 #PREFIX                  (A30) CONST <'<?xml version="1.0"  ?>'>
1 #CR                      (A1)  CONST <H'0A'>
1 #END-TAG                 (A2)
1 #FILLER                  (A60)
  CONST <'Ö/ÖÖ/ÖÖ/ÖÖ/ÖÖ/ÖÖ/ÖÖ/ÖÖ/ÖÖ/ÖÖ/ÖÖ/ÖÖ/ÖÖ/ÖÖ/ÖÖ/ÖÖ/ÖÖ/ÖÖ/ÖÖ/ÖÖ/Ö'>
1 #INDENT1                 (A60)
1 #INDENT2                 (A60)
1 #I                       (I4)
1 #LEN-STRING              (I4)
1 #LEN-TEXT                (I4)
1 #LEN-TAG                 (I4)
1 #LEN-INDENT1             (I1)
1 #LEN-INDENT2             (I1)
*
END-DEFINE
* ------------------------------------------ main ----------------------
REDUCE DYNAMIC #XML-STRING TO 0
COMPRESS '>' #CR TO #END-TAG LEAVING NO
#LEN-INDENT1 := (#GROUP-LEVEL - 1) * 6
IF #LEN-INDENT1 < 0
    OR #FUNCTION NE 'G'
  #LEN-INDENT1 := 0
ELSE
  MOVE SUBSTR (#FILLER,1,#LEN-INDENT1) TO #INDENT1
END-IF
#LEN-INDENT2 := #LEN-INDENT1 + 6
MOVE SUBSTR (#FILLER,1,#LEN-INDENT2) TO #INDENT2
COMPRESS #INDENT2 '<' TO #INDENT2 LEAVING NO
#LEN-INDENT2 := #LEN-INDENT2 + 1
IF #FUNCTION = 'G'
  COMPRESS #INDENT1 '<' #TAG-GROUP #END-TAG
    TO #XML-STRING LEAVING NO
ELSE
  COMPRESS #PREFIX #CR '<' #TAG-GROUP #END-TAG
    TO #XML-STRING LEAVING NO
END-IF
FOR #I = 1 TO *OCC (#TEXT-ARRAY)
  EXAMINE #TEXT-ARRAY (#I) FOR 'X' GIVING LENGTH IN #LEN-TEXT
  EXAMINE #TAG-ARRAY  (#I) FOR 'X' GIVING LENGTH IN #LEN-TAG
  EXAMINE #XML-STRING      FOR 'X' GIVING LENGTH IN #LEN-STRING
  #LEN-STRING           := #LEN-STRING + 1
  MOVE #INDENT2         TO SUBSTR  (#XML-STRING,#LEN-STRING)
  #LEN-STRING           := #LEN-STRING + #LEN-INDENT2
  MOVE #TAG-ARRAY (#I)  TO SUBSTR  (#XML-STRING,#LEN-STRING)
  #LEN-STRING           := #LEN-STRING + #LEN-TAG
  MOVE '>'              TO SUBSTR  (#XML-STRING,#LEN-STRING)
  #LEN-STRING           := #LEN-STRING + 1
  MOVE #TEXT-ARRAY (#I) TO SUBSTR  (#XML-STRING,#LEN-STRING)
  #LEN-STRING           := #LEN-STRING + #LEN-TEXT
  MOVE '</'             TO SUBSTR  (#XML-STRING,#LEN-STRING)
  #LEN-STRING           := #LEN-STRING + 2
  MOVE #TAG-ARRAY (#I)  TO SUBSTR  (#XML-STRING,#LEN-STRING)
  #LEN-STRING           := #LEN-STRING + #LEN-TAG
  MOVE #END-TAG         TO SUBSTR  (#XML-STRING,#LEN-STRING)
END-FOR
EXAMINE #XML-STRING FOR 'X' GIVING LENGTH IN #LEN-STRING
#LEN-STRING             := #LEN-STRING + 1
MOVE '</'               TO SUBSTR  (#XML-STRING,#LEN-STRING)
#LEN-STRING             := #LEN-STRING + 2
MOVE #TAG-GROUP         TO SUBSTR  (#XML-STRING,#LEN-STRING)
EXAMINE #XML-STRING FOR 'X' GIVING LENGTH IN #LEN-STRING
#LEN-STRING             := #LEN-STRING + 1
MOVE #END-TAG           TO SUBSTR  (#XML-STRING,#LEN-STRING)
EXAMINE #XML-STRING FOR 'Ö/Ö' REPLACE WITH ' '
* ----------------------------------------------------------------------
END
