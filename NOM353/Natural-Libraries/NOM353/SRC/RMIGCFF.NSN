* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RMIGCF
* Function:  confirm overwriting of folders to be migrated
*
* xsetggr 2011-01-31 NOMALL-851 create for folders only (lower case
*                    allowed in folder name)
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 #OBJECT-OUT     (A16)
1 REDEFINE #OBJECT-OUT
  2 #OBJECT-OUT-A (A1/16)
1 #CONFIRMED      (L)
LOCAL
1 #OBJECT-IN      (A16)
1 REDEFINE #OBJECT-IN
  2 #OBJECT-IN-A  (A1/16)
END-DEFINE
RESET #OBJECT-IN #CONFIRMED
SET CONTROL 'WC07L54B10/13F'
SET CONTROL 'M3'
INPUT USING MAP 'RMIGCFF&'
IF *PF-KEY = 'PF3'
   SET CONTROL 'WB'
   ESCAPE ROUTINE
END-IF
IF #OBJECT-IN = #OBJECT-OUT
   MOVE TRUE TO #CONFIRMED
ELSE
   REINPUT *4 ALARM
END-IF
SET CONTROL 'WB'
END
