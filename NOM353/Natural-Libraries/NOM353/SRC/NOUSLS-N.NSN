* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* NOUSLS-N - EOM API User list
*
* Maintenance:
* XSETGGR 2001-08-02 created
* XSETGGR 2002-02-02 erweitert
* XSETGGR 2003-02-07 add headers
* XSETHZ  2003-08-11 REJECT IF USER-ID = 'DEFAULT'
* XSETHZ  2008-07-23 p(307577) use full name of ES-APP-SERVER-LIBRARY
* --------------------------------------------------------------------
DEFINE DATA
PARAMETER USING ESMCNT-A
PARAMETER USING ESMINP-A
PARAMETER USING ESMWORKA
PARAMETER USING NOUSLS-A
************************************************************************
LOCAL USING NOUSSL-A
LOCAL USING ESMCONSL
LOCAL USING NADA2000
LOCAL USING NAD-MSG
LOCAL USING NAD-FLD
LOCAL
1 USERS VIEW OF NRM-USERS
  2 USER-ID
  2 LAST-NAME
  2 FIRST-NAME
  2 WORK-PHONE-COUNTRY
  2 WORK-PHONE
  2 WORK-PHONE-EXT
1 GRANTS VIEW OF NRM-GRANTS
1 #E-USER      (A8)
1 #USERID-S    (A8)
1 #I2          (I4)
1 #IMAX        (I4)
1 #GR-SUPER    (A34)
1 REDEFINE #GR-SUPER
  2 #OBJ-TYPE  (A1)
  2 #USERID    (A8)
  2 #OBJ-NAME  (A25)
1 #GR-SUPER-E  (A34)
1 #MSG-NR      (N4) CONST <6115>
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
ON ERROR
  ES-RC := 1
  COMPRESS *PROGRAM 'ERROR' *ERROR-NR *ERROR-LINE TO ES-MSG-TXT
  ESCAPE ROUTINE
END-ERROR
*
RESET ES-RC ES-SORTKEY ES-SORTORDER ES-STARTINDEX ES-NUMBER
ES-OPTION-COUNT := 10
ES-FIELD-COUNT := 1
RESET ES-SORTKEY
  ES-NUMBER
  ES-SORTORDER
#NOUSSL := ES-SELECT
#GR-SUPER.#OBJ-TYPE := #NOUSSL.#OBJ-TYPE
DECIDE ON FIRST VALUE OF ES-FUNCTION
  VALUE 'LS'
    IF ES-EXPAND = 'E'
      #IMAX := 903
      NOUSEX-FIELD-LENGTH(1) := 8
    ELSE
      #IMAX := 229
      ES-FIELD-COUNT := 3
      NOUSLS-FIELD-LENGTH(1) := 8
      NOUSLS-FIELD-LENGTH(2) := 64
      NOUSLS-FIELD-LENGTH(3) := 18
    END-IF
  VALUE 'LS1','LS2'
    #IMAX := 3162
    ES-OPTION-COUNT := 0
    NOUSLI-FIELD-LENGTH(1) := 8
  VALUE 'LS3'
    #IMAX := 351
    ES-OPTION-COUNT := 0
    ES-FIELD-COUNT := 2
    NOUSLN-FIELD-LENGTH(1) := 8
    NOUSLN-FIELD-LENGTH(2) := 64
  NONE VALUE IGNORE
END-DECIDE
ES-EOF := 'X'
#NOUSSL := ES-SELECT
EXAMINE  #NOUSSL.#USER-ID FOR '*' DELETE
COMPRESS #NOUSSL.#USER-ID H'FF' INTO #E-USER LEAVING NO
IF ES-NEXT-KEY-PARM(1) NE ' '
  #USERID-S := ES-NEXT-KEY-PARM(1)
ELSE
  #USERID-S := #NOUSSL.#USER-ID
  IF ES-EXPAND NE 'E' AND ES-FUNCTION = 'LS'
    ES-STARTINDEX := 2
    #I2 := 1
    RESET SHORT-MSG LONG-MSG(*) NOUSLS-HEADER
    VERSION := 0
    NADA2000.OBJECT-KIND := 'U'
    NADA2000.ERROR-NUMBER := #MSG-NR
    NADA2000.OPT-INSERT-DYN := FALSE
    NADA2000.OPT-LANGUAGE := ES-LANGUAGE
    NADA2000.LIBRARY := ES-APP-SERVER-LIBRARY
    CALLNAT 'NATA2000' NADA2000 NATA2000.EXTENDED-PARMS NAD-MSG NAD-FLD
    COMPRESS LONG-MSG(1) C-HEADER-DELIMITER LONG-MSG(2)
      C-HEADER-DELIMITER LONG-MSG(3) TO NOUSLS-HEADER LEAVING NO
  END-IF
END-IF
READ USERS BY USER-ID STARTING FROM #USERID-S ENDING AT #E-USER
  REJECT IF USER-ID = 'DEFAULT'
  IF ES-FUNCTION = 'LS1'
    #GR-SUPER.#USERID := USERS.USER-ID
    #GR-SUPER.#OBJ-NAME := H'FF'
    #GR-SUPER.#OBJ-TYPE := H'FF'
    #GR-SUPER-E := #GR-SUPER
    #GR-SUPER.#OBJ-NAME := H'00'
    RESET #GR-SUPER.#OBJ-TYPE
    FNG. FIND NUMBER GRANTS WITH GR-SUPER = #GR-SUPER THRU #GR-SUPER-E
    ACCEPT IF *NUMBER(FNG.) > 0
  END-IF
  ADD 1 TO #I2
  IF #I2 > #IMAX
    ES-NEXT-KEY-PARM(1) := USERS.USER-ID
    ES-NUMBER := #IMAX
    RESET  ES-EOF
    ESCAPE BOTTOM
  END-IF
  DECIDE ON FIRST VALUE OF ES-FUNCTION
    VALUE 'LS'
      IF ES-EXPAND = 'E'
        NOUSEX-USER-ID(#I2) := USERS.USER-ID
      ELSE
        NOUSLS-USER-ID(#I2) := USERS.USER-ID
        COMPRESS FIRST-NAME LAST-NAME TO NOUSLS-NAME(#I2)
        IF WORK-PHONE NE ' '
          IF WORK-PHONE-COUNTRY > 0
            COMPRESS WORK-PHONE-COUNTRY '/' WORK-PHONE
              TO NOUSLS-PHONE(#I2) LEAVING NO
          ELSE
            NOUSLS-PHONE(#I2) := WORK-PHONE
          END-IF
          IF WORK-PHONE-EXT NE ' '
            COMPRESS NOUSLS-PHONE(#I2) '-' WORK-PHONE-EXT
              TO NOUSLS-PHONE(#I2) LEAVING NO
          END-IF
        ELSE
          RESET NOUSLS-PHONE(#I2)
        END-IF
      END-IF
    VALUE 'LS1','LS2'
      NOUSLI-USER-ID(#I2) := USERS.USER-ID
    VALUE 'LS3'
      NOUSLN-USER-ID(#I2) := USERS.USER-ID
      COMPRESS USERS.FIRST-NAME ',' TO NOUSLN-NAME(#I2) LEAVING NO
      COMPRESS NOUSLN-NAME(#I2) USERS.LAST-NAME TO NOUSLN-NAME(#I2)
    NONE VALUE IGNORE
  END-DECIDE
  ES-NUMBER := #I2
END-READ
*
END
