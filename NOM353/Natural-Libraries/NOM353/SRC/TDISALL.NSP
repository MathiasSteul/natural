* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* fhi     2008-07-24 P307319   restow due to changes in DDM NRM-BUNDLE-CONTENTS
DEFINE DATA LOCAL
01  ACTIVE-BUNDLES VIEW OF NRM-ACTIVE-BUNDLES
01  ACTIVE-REPORTS VIEW OF NRM-ACTIVE-REPORTS
01  ARCHIVE-DATASET VIEW OF NRM-ARCHIVE-DATASET
01  BUNDLE-CONTENTS VIEW OF NRM-BUNDLE-CONTENTS
01  BUNDLE-REPORT VIEW OF NRM-BUNDLE-REPORT
01  BUNDLES VIEW OF NRM-BUNDLES
01  CALENDARS VIEW OF NRM-CALENDARS
01  DATASET-REPORT VIEW OF NRM-DATASET-REPORT
01  DISTRIBUTION-LIST VIEW OF NRM-DISTRIBUTION-LIST
01  FILED-SYSOUTS VIEW OF NRM-FILED-SYSOUTS
    02 F-REPNAME-RNB-SEQ
01  FOLDER VIEW OF NRM-FOLDER
01  GRANTS VIEW OF NRM-GRANTS
01  LOG VIEW OF NRM-LOG
01  MAIL VIEW OF NRM-MAIL
01  ORDER VIEW OF NRM-ORDER
01  PHYSICAL-PRINTERS VIEW OF NRM-PHYSICAL-PRINTERS
01  PRINTERS VIEW OF NRM-PRINTERS
01  PRINTOUTS VIEW OF NRM-PRINTOUTS
01  REPORT-CONTENTS VIEW OF NRM-REPORT-CONTENTS
01  REPORTS VIEW OF NRM-REPORTS-NEW
01  SOURCE VIEW OF NRM-SOURCE
01  SYSOUT-CONTROL VIEW OF NRM-SYSOUT-CONTROL
01  USERS VIEW OF NRM-USERS
END-DEFINE
*
WRITE TITLE 'Records in NOM DB' //
*
FIND NUMBER ACTIVE-BUNDLES WITH AB-BUNDLE-RNB NE ' '
WRITE *NUMBER (AD=I) 'active bundles'
*
FIND NUMBER ACTIVE-REPORTS WITH AR-REPORT-RNB NE ' '
WRITE *NUMBER (AD=I) 'active reports'
*
FIND NUMBER ARCHIVE-DATASET WITH AD-ARCHIVE-DSNAME NE ' '
WRITE *NUMBER (AD=I) 'archive datasets'
*
FIND NUMBER BUNDLE-CONTENTS WITH BC-BUNDLE NE ' '
WRITE *NUMBER (AD=I) 'bundle contents'
*
FIND NUMBER BUNDLE-REPORT WITH BR-BUNDLE NE ' '
WRITE *NUMBER (AD=I) 'report-in-bundle definitions'
*
FIND NUMBER BUNDLES WITH B-BUNDLE NE ' '
WRITE *NUMBER (AD=I) 'bundles'
*
FIND NUMBER CALENDARS WITH CA-CALENDAR-ID NE ' '
WRITE *NUMBER (AD=I) 'calendars'
*
FIND NUMBER DATASET-REPORT WITH DR-ARCHIVE-DSNAME NE ' '
WRITE *NUMBER (AD=I) 'dataset reports'
*
FIND NUMBER DISTRIBUTION-LIST WITH D-LIST-NAME NE ' '
WRITE *NUMBER (AD=I) 'distribution lists'
*
F-S.
FIND NUMBER FILED-SYSOUTS WITH F-REPNAME-RNB-SEQ NE ' '
WRITE *NUMBER (F-S.) (AD=I) 'filed sysouts'
*
FIND NUMBER FOLDER WITH FO-USER-FO-ID NE ' '
WRITE *NUMBER (AD=I) 'folder'
*
FIND NUMBER GRANTS WITH GR-SUPER NE ' '
WRITE *NUMBER (AD=I) 'grants'
*
FIND NUMBER LOG WITH L-TIME NE 0
WRITE *NUMBER (AD=I) 'log records'
*
FIND NUMBER MAIL WITH MA-REP-RNB NE ' '
WRITE *NUMBER (AD=I) 'mail records'
*
FIND NUMBER ORDER WITH OD-ID NE 0
WRITE *NUMBER (AD=I) 'orders'
*
FIND NUMBER PHYSICAL-PRINTERS WITH PH-VTAMID NE ' '
WRITE *NUMBER (AD=I) 'physical printers'
*
FIND NUMBER PRINTERS WITH P-ID NE ' '
WRITE *NUMBER (AD=I) 'logical printers'
*
FIND NUMBER PRINTOUTS WITH PO-ID NE 0
WRITE *NUMBER (AD=I) 'printouts'
*
FIND NUMBER REPORT-CONTENTS WITH AC-REP-RNB-SEQ NE ' '
WRITE *NUMBER (AD=I) 'report contents'
*
FIND NUMBER REPORTS WITH R-REPNAME NE ' '
WRITE *NUMBER (AD=I) 'reports'
*
FIND NUMBER SOURCE WITH SR-ID NE 0
WRITE *NUMBER (AD=I) 'sources'
*
FIND NUMBER SYSOUT-CONTROL WITH SC-SUPER-SYSOUT NE ' '
WRITE *NUMBER (AD=I) 'sysout control'
*
FIND NUMBER USERS WITH USER-ID NE ' '
WRITE *NUMBER (AD=I) 'users'
*
END
