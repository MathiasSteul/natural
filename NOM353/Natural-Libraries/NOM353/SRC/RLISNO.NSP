* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RLISNO    List all nodes: Unix (was RLISUX) and MF(was RLISNO old)
*
* MAINTENANCE:
* User ID yyyy-mm-dd itrac       Comment
* ------- ---------- ----------- ---------------------------------------
* SU      2016-11-10 NOMALL-1620 Created
* fhi     2018-10-04 NOMALL-1621 Use 'inactive: I' instead of 'down: -'
* BLI     2019-01-23 NOMALL-1621 Use 'inactive: I' also in SHOW-STATUS
* BLI     2019-05-06 NOMALL-2261 Recataloged due to changes of XXUX---P
* SU1     2019-06-13 NOMALL-2286 Unix:PF9-do no change systemLinux->Unix
* SU2     2019-10-17 NOMALL-2329 avoid NAT1009/dump if to much ADA calls
* BLI     2020-05-13 NOMALL-2309 access rights Monitor System Defaults
* SU3     2020-06-04 NOMALL-2349 use N-ESYLG
* SU4     2020-11-10 NOMALL-2440 split DDM -> NRM-MF-NODES
* BLI     2021-10-04 NOMALL-2498 set Suspend instead of Inactive
* SU4     2021-10-27 NOMALL-2504 update time on map
* BLI1    2022-09-02 NOMALL-2505 inform about status time of Unix nodes
************************************************************************
*
DEFINE DATA GLOBAL USING NRM-GL
*
INDEPENDENT
1 +NOD-LOCAL-NAME         (A16)
*
LOCAL USING XXGMSG-A
LOCAL USING XXUX---P
LOCAL USING ROT----L
LOCAL USING RLC----L
LOCAL USING RPFK---L
*
LOCAL
1 UX-NODES VIEW OF NRM-UX-NODES
  2 UX-NODE-NAME          (A16)
  2 UX-NODE-DESCRIPTION   (A50)
  2 UX-NODE-SUSPEND
  2 UX-NODE-SUSPENDED           /* BLI1
  2 UX-LAST-UPDATE
1 MF-NODES VIEW OF NRM-MF-NODES /*SU4 NRM-MONITOR
  2 MF-MONITOR-ID         (A20)
  2 REDEFINE MF-MONITOR-ID
    3 MF-TYPE-ID1         (A2)
    3 MF-TYPE-ID2         (A16)
  2 MF-MONITOR-DESCRIPTION (A50)
  2 MF-NPR-USERID         (A8)
  2 MF-SYSTEM-TYPE        (A8)
  2 MF-TYPE               (A1)
  2 MF-MONITOR-NODE       (N5)
  2 MF-PRODUCT-NAME       (A16)
  2 MF-LAST-UPDATE
  2 MF-INTERNAL-NODE-ID
1 REPORTS VIEW OF NRM-REPORTS-NEW
  2 R-INTERNAL-NODE-ID    (P11)
  2 R-NODE-UX             (A16)
  2 R-REPNAME             (A25)
* *****
1 #I                      (I4)
1 #I1                     (I4)
1 #IND                    (I4)
1 #IND1                   (I4)
1 #POS                    (I4) INIT <1>
1 #NR                     (I4) /*no of nodes
1 #TAB                    (*)
  2 #NODE-NAME            (A16)
  2 #NODE-NO              (N5)
  2 #INT-NODE-ID          (P11)
  2 #NODE-DESC            (A50)
  2 #NODE-SYSTEM          (A9)
  2 #NODE-PRODUCT-NAME    (A16)
  2 #NODE-STATUS          (A8) /*status
  2 #NODE-IS-MF           (L) /*true=MF/false=unix
  2 #NODE-MSG             (A100)
  2 #NODE-TYPE            (A1)
  2 #NODE-TYPE-ORIG       (A1) /*M-TYPE
  2 #NODE-MF-USERID       (A8) /*M-NPR-USERID
  2 L-ISN                 (P10) /*for delete
  2 #NODE-STATUS-TIME     (A22) /* BLI1
1 #NOFLINES               (I2) CONST <15> /*LINES PER SCREEN
1 #MAP                    (1:#NOFLINES)
  2 #NODE-NAME            (A16)
  2 #NODE-NO              (N5)
  2 #NODE-DESC            (A50)
  2 #NODE-SYSTEM          (A9)
  2 #NODE-PRODUCT-NAME    (A16)
  2 #NODE-STATUS          (A8) /*status
  2 #NODE-IS-MF           (L) /*true=MF/false=unix
  2 #NODE-MSG             (A100)
1 #REPOS                  (A16)
1 GET-SCREEN              (L) INIT <TRUE>
1 CV-LINES                (C)
1 CV-SELECTION            (C/1)
1 REDEFINE    CV-SELECTION
  2 CV-SCAL               (C)
1 #END-OF-DATA            (L)
1 #CP                     (P3)
1 L-HEADER                (A78)
1 #LANGUAGE               (I1)
1 L-LCMD                  (1:#NOFLINES) /* LINE COMMANDS
  2 L-IDENT               (I2)
  2 L-MARK                (A2)
  2 CV-MARK               (C)
1 #BROWSE-FLAGS
  2 #NEWVAL               (L)
  2 #BACKWARD             (L)
  2 #FORWARD              (L)
  2 #TOP                  (L)
  2 #BOT                  (L)
  2 #SCROLL-AMOUNT        (N3)
1 #FATHER-PROG            (A8) CONST <'RDFMEN'>
1 #ADD-PROGRAM            (A8)
1 #ACT-MAST               (A8)
1 F                       (I2) /* RLCMTI-C
1 I                       (I2) /* RLCMTI-C
1 #CONFIRM-TEXT           (A32)
1 #CONFIRMED              (L)
1 LOWER-CASE              (L) CONST <TRUE>
1 #OBJ                    (A50)
/*#MONITOR-ID             (A20)
1 ##NODE-MSG              (A100)
1 REDEFINE ##NODE-MSG
  2 ##NODE-MSG1           (A65)
  2 ##NODE-MSG2           (A35)
1 #LIBRARY-ID             (A8)
1 #LANGUAGE_N2            (N2) INIT <*LANGUAGE>
1 #ES-MSG-NR              (N4)
1 ##NODE                  (A8)
1 ##SYSTEM                (A8) CONST <'System:'>
1 ##STATUS                (A8) CONST <'Status:'>
1 #S-NODE                 (A25)
1 #S-NODE-F               (A25)
1 #S-NODE-T               (A25)
1 #MSG                    (A70)
1 #LEN                    (N3) CONST <16>
1 #MF                     (A1)
1 #UNIX                   (A1)
1 #TIT-NEW                (A20)
1 #LAST-UPDATE            (T)
1 #MASTER-FOUND           (L)
/*#LANG            (I1) INIT <*LANGUAGE>
1 #MARK            (I4)
1 #FIRST-DISP      (L)
1 #XX-SHORT-TEXT1  (A) DYNAMIC
1 #RP              (A25/1:15) /*SU2 ->
1 #RP-CNT          (I2)
1 #RP-CNT-I        (I2)
1 #RP-CNT-TOT      (I2)
1 #SETTIME         (L) INIT <TRUE> /*SU2 <-
1 #ALLOWED         (L)        /* BLI NOMALL 2309 ->
1 #UPDATE          (L)
1 #DELETE          (L)        /* BLI NOMALL 2309 <-
1 #CALLER          (A8) INIT <*PROGRAM>
1 #ERC             (N4)
1 #ERT             (A250)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
DEFINE WINDOW WAIT1 SIZE 4*78 BASE BOTTOM LEFT /*SU2
* For title:
CALLNAT 'RGETLIB' #LIBRARY-ID
#XX-MSG-DYNA (1) := ':1:'
#XX-ERROR-CODE := 7003 /*Node:1:cannot be deleted - still in use.
CALLNAT 'XXGMSG-N' #XX-GMSG-PARMS
#XX-SHORT-TEXT1 := #XX-SHORT-TEXT
EXAMINE #XX-SHORT-TEXT1 FOR ':1:' REPLACE ' '
WRITE TITLE LEFT 2T L-HEADER (AD=OI CD=GR DY=<TU>)
  / #XX-SHORT-TEXT1 (AL=68) 70T 'Page:' *PAGE-NUMBER (NL=3) /
*
INCLUDE CVIDEO
IF *LANGUAGE = 1
  #TIT-NEW := 'Select Node type'
  ##NODE   := 'Node:'
ELSE
  #TIT-NEW := 'Knotentyp auswaehlen'
  ##NODE   := 'Knoten:'
END-IF
*
DEFINE WINDOW TYPE SIZE 6*30 TITLE #TIT-NEW CONTROL SCREEN
DEFINE WINDOW INFO SIZE 6*75
DEFINE WINDOW WAIT SIZE 4*75 BASE BOTTOM LEFT
*
RESET G-COMMIT
* BLI NOMALL-2309 check access rights according Monitor Defaults
* Note: PMO (Purge Monitor Defaults) doesn't exist (comp. RLISUSR,..)
CALLNAT 'NARPSEC' G-USER-PROFILE 'DMO' #ALLOWED
INCLUDE C-NALLOW
*
CALLNAT 'NARPSEC' G-USER-PROFILE 'MMO' #UPDATE
CALLNAT 'NARPSEC' G-USER-PROFILE 'PMO' #DELETE   /* BLI NOMALL-2309 end
*
MAIN-LOOP. REPEAT
  CALLNAT 'N-HEADER' L-HEADER G-DATE-FORMAT 'RLISNOM&' /*SU4
  IF GET-SCREEN
    PERFORM GET-SCREEN
    RESET GET-SCREEN
  ELSE
    PERFORM #POSITION
  END-IF
*
  IF #LANGUAGE NE *LANGUAGE
    #LANGUAGE := *LANGUAGE
    CALLNAT 'ROTINI-N' ##EQO-MF-NODE G-OBJ-TYPE G-OTB
    PERFORM INIT-PFKEYS
    PERFORM INIT-LINECOM
  END-IF
  PERFORM SET-PFKEYS
  IF #POS < 1
    RESET INITIAL #POS
  END-IF
**PRINT (AD=L) #POS '=' *OCC(#TAB.#NODE-NAME) '=' #IND '=' #NR
* IF #POS + #NOFLINES - 1 > *OCC(#TAB.#NODE-NAME)
*   #POS := *OCC(#TAB.#NODE-NAME) - #NOFLINES + 1 END-IF
  RESET L-MARK (*)
  PERFORM TAB-TO-MAP
  INCLUDE C-TOPBOT
  INCLUDE RMVHLP-C
  CALLNAT 'RFLIPG-N' G-LC G-LINECOM (*)
  PERFORM FLIP-DISPLAY
  IF #MARK = 0
    #MARK := POS(G-DIRECT-COMMAND)
  END-IF
  SET CONTROL 'WB'
  INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT MARK #MARK
    USING MAP 'RLISNOM&'
  RESET #MARK G-NATRP-ERC G-NATRP-ERT
  INCLUDE RPFKVA-C
  RESET #BROWSE-FLAGS
  INCLUDE C-DIRECT
  INCLUDE C-LOCCMD
*
  IF G-PF-FUNC =  ##PFK-ADD
    PERFORM ADD-NODE
    ESCAPE TOP
  END-IF
  IF G-PF-FUNC = ##PFK-STATUS
    PERFORM SHOW-STATUS
    ESCAPE TOP
  END-IF
  INCLUDE RPFKEX-C
  PERFORM LINE-COMMANDS
  IF G-NATRP-ERC NE 0
    ESCAPE TOP
  END-IF
*
  IF CV-SELECTION (*) MODIFIED /*start val
    RESET INITIAL #POS #REPOS
*   #NEWVAL := TRUE
    CALLNAT 'SELALPHA' #S-NODE #S-NODE-F #S-NODE-T #LEN
  END-IF
*
END-REPEAT /*(MAIN-LOOP.)
*
RESET G-NATRP-ERT G-NATRP-ERC
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE GET-SCREEN
************************************************************************
RESET INITIAL #POS
RESET #NR #IND
RESIZE AND RESET ARRAY #TAB TO (1:1)
PERFORM MF-NODES
PERFORM UNIX-NODES
*
END-SUBROUTINE /* GET-SCREEN
*
************************************************************************
DEFINE SUBROUTINE MF-NODES
************************************************************************
R-MF. READ MF-NODES BY MF-MONITOR-ID = 'R-'-H'00' THRU 'R-'-H'FF'
  RESET #IND1
  ADD 1 TO #IND
  PERFORM #ADD
  IF MF-NODES.MF-TYPE = 'M' /*monitor is first entry
    #IND1 := #IND
    #IND := 1 /*first entry for monitor Ü
    #MASTER-FOUND := TRUE
    PERFORM #MOVE-ENTRIES
  END-IF
  #TAB.#NODE-NAME      (#IND) := MF-NODES.MF-TYPE-ID2
  #TAB.#NODE-NO        (#IND) := MF-NODES.MF-MONITOR-NODE
  #TAB.#NODE-DESC      (#IND) := MF-NODES.MF-MONITOR-DESCRIPTION
  #TAB.#INT-NODE-ID    (#IND) := MF-NODES.MF-INTERNAL-NODE-ID
  #TAB.#NODE-MF-USERID (#IND) := MF-NODES.MF-NPR-USERID
  #TAB.L-ISN           (#IND) := *ISN (R-MF.)
  IF MF-NODES.MF-SYSTEM-TYPE = ' '
    #TAB.#NODE-SYSTEM (#IND) := 'Mainframe' /*better than nothing..
  ELSE
    #TAB.#NODE-SYSTEM (#IND) := MF-NODES.MF-SYSTEM-TYPE
  END-IF
  IF MF-NODES.MF-PRODUCT-NAME = ' '
    #TAB.#NODE-PRODUCT-NAME (#IND) := 'Mainframe'
  ELSE
    #TAB.#NODE-PRODUCT-NAME (#IND) := MF-NODES.MF-PRODUCT-NAME
    EXAMINE #TAB.#NODE-PRODUCT-NAME (#IND)
      FOR 'OSD' REPLACE WITH 'BS2000'
  END-IF
  #TAB.#NODE-IS-MF  (#IND) := TRUE
  #TAB.#NODE-TYPE (#IND) :=#TAB.#NODE-TYPE-ORIG (#IND):=MF-NODES.MF-TYPE
  PERFORM #TYPE-TEXT
**PRINT (AD=L) #IND #TAB.#NODE-NO (#IND) 'sys:' #TAB.#NODE-SYSTEM (#IND)
**  #TAB.#NODE-NAME (#IND) 'msg:' #TAB.#NODE-MSG (#IND) (AL=30)
  IF #IND1 NE 0
    #IND := #IND1
  END-IF
END-READ
*
END-SUBROUTINE /* MF-NODES
*
************************************************************************
DEFINE SUBROUTINE #TYPE-TEXT
************************************************************************
DECIDE ON FIRST VALUE OF #TAB.#NODE-TYPE (#IND)
  VALUE 'M','L' #XX-ERROR-CODE := 2049 /* Monitor
  VALUE 'S'     #XX-ERROR-CODE := 2032 /* suspended
  VALUE 'D'     #XX-ERROR-CODE := 2047 /* deactivated
  VALUE 'A'     #XX-ERROR-CODE := 2030 /* active
  VALUE 'E'     #XX-ERROR-CODE := 2051 /* error
* NONE          #XX-ERROR-CODE := 2008 /* down
* fhi     2018-10-04 NOMALL-1621 line above out, below in
  NONE          #XX-ERROR-CODE := 2031 /* inactive
END-DECIDE
CALLNAT 'XXGMSG-N' #XX-GMSG-PARMS
#TAB.#NODE-STATUS (#IND) := #XX-SHORT-TEXT
*
END-SUBROUTINE /* #TYPE-TEXT
*
************************************************************************
DEFINE SUBROUTINE UNIX-NODES
************************************************************************
RESET #IND /*sort both lists
R-UX. READ UX-NODES BY UX-NODE-NAME
  RESET #IND1
  PERFORM #ADD
  IF UX-NODES.UX-NODE-SUSPEND ='M' OR='L' /*master is first entry
    #IND1 := #IND
    #IND := 1 /*first entry for monitor Ü
    PERFORM #MOVE-ENTRIES
  ELSE
    #REP. REPEAT /*sort it into table
      ADD 1 TO #IND
      IF #TAB.#NODE-NAME (#IND) = ' '
        ESCAPE BOTTOM (#REP.)
      END-IF
      IF #IND = 1 AND #MASTER-FOUND
        ESCAPE TOP
      END-IF
      IF #TAB.#NODE-NAME (#IND) > UX-NODES.UX-NODE-NAME
        PERFORM #MOVE-ENTRIES
        ESCAPE BOTTOM (#REP.)
      END-IF
    END-REPEAT /*(#REP.)
  END-IF
  RESET #TAB.#NODE-NO     (#IND) #TAB.#NODE-IS-MF (#IND)
  #TAB.#NODE-NAME         (#IND) := P-NODE-NAME := UX-NODES.UX-NODE-NAME
  #TAB.#NODE-DESC         (#IND) := UX-NODES.UX-NODE-DESCRIPTION
  #TAB.#NODE-SYSTEM       (#IND) := 'Unix' /*better than nothing..
  #TAB.#NODE-PRODUCT-NAME (#IND) := 'Unix' /*better than nothing..
  IF UX-NODES.UX-NODE-SUSPEND ='M' OR='L'
    #TAB.#NODE-PRODUCT-NAME (#IND) := *OS
  END-IF
  #TAB.L-ISN              (#IND) := *ISN (R-UX.)
  #TAB.#NODE-TYPE-ORIG    (#IND) := #TAB.#NODE-TYPE (#IND) :=
    UX-NODES.UX-NODE-SUSPEND
  PERFORM #TYPE-TEXT
  IF NOT (#TAB.#NODE-TYPE (#IND) = 'M' OR= 'L') AND  /* BLI1 ->
      UX-NODES.UX-NODE-SUSPENDED GT 0
    CALLNAT 'N-HEAD3' UX-NODES.UX-NODE-SUSPENDED
      #NODE-STATUS-TIME(#IND) G-DATE-FORMAT
  END-IF /* BLI1 <-
  IF #IND1 NE 0
    #IND := #IND1
  END-IF
END-READ
*
END-SUBROUTINE /* UNIX-NODES
*
************************************************************************
DEFINE SUBROUTINE #ADD
************************************************************************
ADD 1 TO #NR
IF #NR GE *OCC(#TAB.#NODE-NAME)
  #I := *OCC(#TAB.#NODE-NAME) + (#NOFLINES * 2)
  EXPAND ARRAY #TAB TO (1:#I)
END-IF
*
END-SUBROUTINE /* #ADD
*
************************************************************************
DEFINE SUBROUTINE #MOVE-ENTRIES
************************************************************************
FOR #I = #NR TO #IND STEP -1
  IF #I LE #IND
    ESCAPE BOTTOM
  END-IF
  MOVE BY NAME #TAB (#I  - 1) TO #TAB (#I)
END-FOR
RESET #TAB (#IND)
*
END-SUBROUTINE /* #MOVE-ENTRIES
*
************************************************************************
DEFINE SUBROUTINE INIT-LINECOM
************************************************************************
I := 1                            /* BLI NOMALL-2309 start
G-LC-IDENT (I) := ##EQU-DISPLAY
IF #UPDATE
  ADD 1 TO I
  G-LC-IDENT (I) := ##EQU-MODIFY
END-IF
IF #DELETE
  ADD 1 TO I
  G-LC-IDENT (I) := ##EQU-DELETE
END-IF
ADD 1 TO I
G-LC-IDENT (I) := ##EQU-INFO
G-LC-NUM := I                     /* BLI NOMALL-2309 end
CALLNAT 'RLCINI-N' G-OBJ-TYPE G-LC G-LCB
*
END-SUBROUTINE /* INIT-LINECOM
*
************************************************************************
DEFINE SUBROUTINE LINE-COMMANDS
************************************************************************
IF L-MARK (*) = '.'
  INCLUDE C-ESCAPE
END-IF
/*SU 2017-10-13 FETCH RETURN 'RMGTNODE' after discussion with FHI
RESET L-IDENT (*) *PAGE-NUMBER
INCLUDE RLCMTI-C
* --- DELETE LINE COMMANDS
SCAN-LINES. FOR I 1 TO #NOFLINES
  IF L-IDENT (I) NE ##EQU-DELETE
    ESCAPE TOP
  END-IF
  #I1 := #POS + I - 1
  IF #TAB.#NODE-NAME (#I1) = +NOD-LOCAL-NAME
  OR #TAB.#NODE-TYPE (#I1) ='M' OR='L' /*just to be sure SU 2018-11   /*
    G-NATRP-ERC := 2055 /*deletion of local node not allowed
  ELSE
    PERFORM CHECK-IF-NODE-USED
  END-IF
  IF G-NATRP-ERC NE 0
    #MARK := POS(L-IDENT (I))
    ESCAPE ROUTINE
  END-IF
  G-NATRP-ERC := 0017 /*object was not deleted
  #CONFIRM-TEXT := #TAB.#NODE-NAME (#I1)
  IF G-CONFIRM
    CALLNAT 'N-CNFRM' #CONFIRM-TEXT 'F' G-DISPLAY-LONG-NAMES
      #CONFIRMED G-NATRP-ERT LOWER-CASE
  END-IF
*
  IF #CONFIRMED OR NOT G-CONFIRM
    IF #TAB.#NODE-IS-MF  (#I1)
      DEL-MF. GET MF-NODES L-ISN(#I1)
      DELETE RECORD (DEL-MF.)
    ELSE
      DEL-UX. GET UX-NODES L-ISN(#I1)
      DELETE RECORD (DEL-UX.)
    END-IF
    #OBJ := MF-MONITOR-ID
    PERFORM RMLOGDEL #OBJ 'NODE'
    GET-SCREEN := TRUE
    G-NATRP-ERC := 0018
    END TRANSACTION
  END-IF
END-FOR
* --- OTHER LINE COMMANDS
FOR I 1 TO #NOFLINES
  #I1 := #POS + I - 1
  DECIDE ON EVERY VALUE OF L-IDENT (I)
    VALUE ##EQU-MODIFY
      G-C-FUNC := 'M'
      #REPOS := #MAP.#NODE-NAME(1)
      IF #MAP.#NODE-IS-MF (I)
        GET MF-NODES #TAB.L-ISN (#I1)
        #LAST-UPDATE := MF-NODES.MF-LAST-UPDATE
        FETCH RETURN 'RDEFNO' G-C-FUNC #MAP.#NODE-NAME (I)
        GET MF-NODES #TAB.L-ISN (#I1)
        IF #LAST-UPDATE NE MF-NODES.MF-LAST-UPDATE /*modified
          GET-SCREEN := TRUE
        END-IF
      ELSE
        GET UX-NODES #TAB.L-ISN (#I1)
        #LAST-UPDATE := UX-NODES.UX-LAST-UPDATE
        FETCH RETURN 'RDEFUX' G-C-FUNC #MAP.#NODE-NAME (I)
        GET UX-NODES #TAB.L-ISN (#I1)
        IF #LAST-UPDATE NE UX-NODES.UX-LAST-UPDATE
          GET-SCREEN := TRUE
        END-IF
      END-IF
      IF G-C-FUNC = '+' /*RLISNO/RDEFUX: modified
        GET-SCREEN := TRUE
      END-IF
    VALUE ##EQU-DISPLAY
      G-C-FUNC := 'D'
      IF #MAP.#NODE-IS-MF (I)
        FETCH RETURN 'RDEFNO' G-C-FUNC #MAP.#NODE-NAME (I)
      ELSE
        FETCH RETURN 'RDEFUX' G-C-FUNC #MAP.#NODE-NAME (I)
      END-IF
    VALUE ##EQU-INFO
      ##NODE-MSG := #TAB.#NODE-MSG (#I1)
      COMPRESS ##NODE H'01' #TAB.#NODE-NAME (#I1) TO #MSG LEAVING NO
      IF #TAB.#NODE-NO (#I1) NE 0
        COMPRESS #MSG ' (' #TAB.#NODE-NO (#I1) ')' TO #MSG LEAVING NO
      END-IF
      COMPRESS #MSG H'02' ##SYSTEM H'01' #TAB.#NODE-PRODUCT-NAME (#I1)
        H'01' TO #MSG LEAVING NO
      IF #TAB.#NODE-SYSTEM (#I1) NE ' '
        COMPRESS #MSG '(' #TAB.#NODE-SYSTEM (#I1) ')' H'02'
          TO #MSG LEAVING NO
      END-IF
      COMPRESS #MSG ##STATUS H'01' #TAB.#NODE-STATUS (#I1)
        TO #MSG LEAVING NO
      IF ##NODE-MSG1 EQ ' ' AND                       /* BLI1 ->
          #NODE-STATUS-TIME(#I1) NE ' '
        MOVE RIGHT #NODE-STATUS-TIME(#I1) TO ##NODE-MSG1
      END-IF
      INPUT WINDOW='INFO' (AD=OIL IP=OFF) #MSG (AD=D DY='01I'02)
        / ##NODE-MSG1 (AD=D DY='01I'02) / ##NODE-MSG2 /* BLI1 <-
    NONE VALUE IGNORE
  END-DECIDE
END-FOR
*
END-SUBROUTINE /* LINE-COMMANDS
*
************************************************************************
DEFINE SUBROUTINE #POSITION
************************************************************************
DECIDE FOR FIRST CONDITION
  WHEN #TOP       #POS := 1
  WHEN #BOT       #POS := *OCC(#TAB.#NODE-NAME) /*correct it later
  WHEN #BACKWARD  SUBTRACT #NOFLINES FROM #POS
  WHEN #FORWARD
    IF #POS + #NOFLINES LE #NR
      ADD #NOFLINES TO #POS
    END-IF
  WHEN NONE IGNORE
END-DECIDE
*
END-SUBROUTINE /* #POSITION
*
************************************************************************
DEFINE SUBROUTINE INIT-PFKEYS
************************************************************************
INCLUDE RPFSTD-C
INCLUDE RPFADD-C
INCLUDE RPFBRW-C
INCLUDE RPFSTA-C /*PF Status ##PFK-STATUS
CALLNAT 'RPFINI-N' G-PF G-PFB
*
END-SUBROUTINE /* INIT-PFKEYS
*
************************************************************************
DEFINE SUBROUTINE TAB-TO-MAP
************************************************************************
RESET #MAP (*) #I1 #CP
#END-OF-DATA := TRUE
CV-MARK(*) := (AD=NP)
IF #REPOS NE ' '
  FOR #I = 1 TO #NR
    IF #TAB.#NODE-NAME (#I) GE #REPOS
      #POS := #I
      ESCAPE BOTTOM
    END-IF
  END-FOR
  RESET #REPOS
END-IF
CALLNAT 'SELALPHA' #S-NODE #S-NODE-F #S-NODE-T #LEN
FOR #I = #POS TO #NR
  IF #TAB.#NODE-NAME (#I) < #S-NODE-F
    ESCAPE TOP
  END-IF
  IF #TAB.#NODE-NAME (#I) > #S-NODE-T
    ESCAPE TOP /*monitor always 1. entry->ESCAPE BOTTOM not possible
  END-IF
  IF #I = 1
    #CP := 1
  END-IF
  IF #I1 GE #NOFLINES
    RESET #END-OF-DATA
    ESCAPE BOTTOM
  END-IF
  ADD 1 TO #I1
  IF #I1 = 1
    #POS := #I
  END-IF
  MOVE BY NAME #TAB (#I) TO #MAP (#I1)
  #MAP.#NODE-SYSTEM (#I1) := #TAB.#NODE-PRODUCT-NAME (#I)
  CV-MARK(#I1) := (AD=I)
END-FOR
*
END-SUBROUTINE /* TAB-TO-MAP
*
************************************************************************
DEFINE SUBROUTINE ADD-NODE
************************************************************************
INPUT WINDOW='TYPE' (AD=MIL'_' IP=OFF) / #MF 'Mainframe' / #UNIX 'Unix'
IF *PF-KEY NE 'ENTR'
  ESCAPE TOP
END-IF
IF SELECTION NOT UNIQUE #MF #UNIX
  REINPUT *2027
END-IF
G-C-FUNC := 'A'
GET-SCREEN := TRUE
#REPOS := #MAP.#NODE-NAME(1)
IF #MF NE ' '
  FETCH RETURN 'RDEFNO' G-C-FUNC ' '
ELSE /* #UNIX
  FETCH RETURN 'RDEFUX' G-C-FUNC ' '
END-IF
*
END-SUBROUTINE /* ADD-NODE
*
************************************************************************
DEFINE SUBROUTINE SHOW-STATUS
************************************************************************
FOR #IND 1 TO #NR
* PRINT (AD=L) #TAB.#NODE-NAME (#IND) '=' #TAB.#NODE-IS-MF(#IND)
* Show screen to user to be able to identify not responding node:
  IF #TAB.#NODE-IS-MF(#IND)
    COMPRESS #TAB.#NODE-NAME (#IND) '(' #TAB.#NODE-NO (#IND) ')'
      TO ##NODE-MSG LEAVING NO
  ELSE
    ##NODE-MSG := #TAB.#NODE-NAME (#IND)
  END-IF
  SET CONTROL 'N'
  INPUT WINDOW='WAIT' USING MAP 'RLISNOW&'
*
  IF #TAB.#NODE-IS-MF (#IND) /*MF
    IF (#TAB.#NODE-TYPE-ORIG (#IND) ='D' OR='S') /*deactive or suspended
      ESCAPE TOP
    END-IF
* check all other status and show E (Error) or leave it as it is
    CALLNAT 'N-ESYLG' 1X #TAB.#NODE-NO (#IND) #TAB.#NODE-MF-USERID(#IND)
      #CALLER #ERC #ERT 1X
    DECIDE ON FIRST VALUE OF #ERC
      VALUE 0     IGNORE
**    VALUES 3148,5999  #TAB.#NODE-TYPE (#IND) := '-'
**    VALUES 3148,5999  #TAB.#NODE-TYPE (#IND) := 'I'
* BLI     2021-10-04 NOMALL-2498 line above out, below in
      VALUES 3148,5999  #TAB.#NODE-TYPE (#IND) := 'S'    /* suspend
** ???? IF MF-NODES.M-TYPE = 'M' /*monitor - how to show mon.in err ????
      NONE        #TAB.#NODE-TYPE (#IND) := 'E'
    END-DECIDE
    PERFORM #TYPE-TEXT
    #TAB.#NODE-MSG    (#IND) := #ERT
  ELSE /* Unix: Get node info:
    IF #TAB.#NODE-TYPE (#IND) = 'M' OR='L' /* Monitor SU1
      ESCAPE TOP
    END-IF
    CALLNAT 'NODUST-N' #TAB.#NODE-NAME (#IND) #LIBRARY-ID #LANGUAGE_N2
      #TAB.#NODE-SYSTEM (#IND) #TAB.#NODE-STATUS (#IND) #ES-MSG-NR
      #TAB.#NODE-MSG (#IND)
    #TAB.#NODE-PRODUCT-NAME (#IND) := #TAB.#NODE-SYSTEM (#IND)
  END-IF
END-FOR
*
END-SUBROUTINE /* SHOW-STATUS
*
************************************************************************
DEFINE SUBROUTINE CHECK-IF-NODE-USED
************************************************************************
#FIRST-DISP := TRUE
RESET #RP-CNT
RP. READ REPORTS BY R-REPNAME
  IF #SETTIME /*SU5
    ST. SETTIME
    RESET #SETTIME
  END-IF
  IF *TIMD (ST.) > 50 /*5 seconds
    SET CONTROL 'N'
    INPUT WINDOW='WAIT1' USING MAP 'RDEFNOW&'
    #SETTIME := TRUE
  END-IF
  IF (#TAB.#NODE-IS-MF  (#I1)
  AND R-INTERNAL-NODE-ID =  #TAB.#INT-NODE-ID (#I1))                  /*
  OR (NOT #TAB.#NODE-IS-MF  (#I1) AND R-NODE-UX = #TAB.#NODE-NAME (#I1))
    IF #RP-CNT = *OCC(#RP) /*SU2
      PERFORM #DISP-RP
    END-IF
    ADD 1 TO #RP-CNT
    ADD 1 TO #RP-CNT-TOT
    IF #RP-CNT-TOT > 100 /* +----+----1----+----2----+
      #RP (#RP-CNT) := 'list stopped after 100 RP Def.'
      ESCAPE BOTTOM
    END-IF
    #RP (#RP-CNT) := R-REPNAME
  END-IF
END-READ /*(RP.)
IF #RP-CNT-TOT NE 0
  PERFORM #DISP-RP
  WRITE / '*** End of Report ***'
END-IF
*
END-SUBROUTINE /* CHECK-IF-NODE-USED
*
************************************************************************
DEFINE SUBROUTINE #DISP-RP /*SU2
************************************************************************
IF #FIRST-DISP
  RESET #FIRST-DISP
  PRINT ##NODE #TAB.#NODE-NAME (#I1)
  G-NATRP-ERC := 7003 /*Node:1:cannot be deleted - still in use.
  G-NATRP-ERT := #TAB.#NODE-NAME (#I1)
END-IF
FOR #RP-CNT-I = 1 TO #RP-CNT
  PRINT 2X 'Report' #RP (#RP-CNT-I)
END-FOR
RESET #RP-CNT
*
END-SUBROUTINE /* #DISP-RP
************************************************************************
INCLUDE RPFSET-C /*SET-PFKEYS
*
END
