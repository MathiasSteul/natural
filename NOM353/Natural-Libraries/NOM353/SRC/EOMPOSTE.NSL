  2 ##STATUS-IN-HOLD (A1) INIT<'H'>
  2 ##STATUS-CURRENTLY-PRINTING (A1) INIT<'P'>
  2 ##STATUS-AWAITING-CONFIRMATION (A1) INIT<'C'>
  2 ##STATUS-PRINTED-SUCCESSFULLY (A1) INIT<'D'>
  2 ##STATUS-ERROR (A1) INIT<'E'>
  2 ##STATUS-PRINT-FAILED (A1) INIT<'F'>
  2 ##STATUS-PRINTER-BUSY (A1) INIT<'T'>
  2 ##STATUS-PRINTER-OUTPUT (A1) INIT<'O'> /* P302238 IN
  2 ##STATUS-UNKNOWN (A1) INIT<'U'> /* P302238 IN
  2 ##STATUS-EXTERNAL-OK (A1) INIT<'X'> /* P321483 IN
