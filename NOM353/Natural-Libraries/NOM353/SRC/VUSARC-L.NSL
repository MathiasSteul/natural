DEFINE DATA LOCAL
/* >Natural Source Header 000000
/* :Mode S
/* :CP
/* <Natural Source Header
*   VUSARC-L
*   Created SJU 02-03-11
*   User defined archive types
*
*   User  yy-mm-dd p(......) Description
*   SU1    2014-06-27 NOMALL-1281              show last update user
* ***********************************************************************
*
1 #MAX-JOBCARDS (N3) CONST<3>
1 #MAX-SYMBOLS (N3) CONST<28>
1 NRM-USER-DEFINED-ARCHIVE VIEW OF NRM-USER-DEFINED-ARCHIVE
  2 M-LAST-UPDATE (T) /*SU1
  2 M-LAST-UPDATE-USER (A16) /*SU1
  2 M-MONITOR-ID (A20)
  2 REDEFINE M-MONITOR-ID /* REDEF. BEGIN : M-MONITOR-ID
    3 M-MONITOR-TYPE (A7) /* 'USERARC'
    3 M-USERARC-NUMBER (N2) /* NUMBER - 01 TO 09
  2 M-USERARC-DESCRIPTION (A50)
  2 M-USERARC-NAME (A8)
  2 M-USERARC-PREFIX (A30)
  2 M-USERARC-ARCHIVE-JOBCARDS (A72/1:#MAX-JOBCARDS)
  2 M-USERARC-REVIVE-JOBCARDS (A72/1:#MAX-JOBCARDS)
  2 M-USERARC-ARCHIVE-SKEL (A8)
  2 M-USERARC-REVIVE-SKEL (A8)
  2 M-USERARC-CONDENSE-SKEL (A8)
  2 M-USERARC-EXITLIB (A8)
  2 M-USERARC-EXITMEM (A8)
