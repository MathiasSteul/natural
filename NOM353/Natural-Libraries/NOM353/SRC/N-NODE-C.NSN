* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* N-NODE-C - Export/Import(MF only):INTERNAL-NODE-ID <-> MONITOR-ID
*
* MAINTENANCE:
* User ID yyyy-mm-dd itrac       Comment
* ------- ---------- ----------- ---------------------------------------
* SU      2018-02-13             NOM 3.5 Created
* SU1     2020-11-10 NOMALL-2440 split DDM -> NRM-MF-NODES
*                    no longer used in RDEFEM - ÜÜchange functionalityÜÜ
************************************************************************
*
DEFINE DATA
PARAMETER
1 #FUNC       (A1)  /*in:function:  ' '=int.ID->ID /else:ID->int.ID
1 #MONITOR-ID (A20) BY VALUE RESULT /*with prefix 'R-' ÜÜ
1 #INT-ID     (P11) BY VALUE RESULT /*INTERNAL-NODE-ID
1 #FIELD      (A20) BY VALUE RESULT /*always 'M-MONITOR-ID'
/* 1 #not-found  (L) ÜÜno error handling ÜÜ
************************************************************************
LOCAL
1 MF-NODE VIEW OF NRM-MF-NODES
  2 MF-MONITOR-ID       (A20)
  2 MF-INTERNAL-NODE-ID (P11)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#FIELD := 'M-MONITOR-ID'
IF #FUNC = ' ' /*int.ID->ID
  RESET #MONITOR-ID
ELSE
  RESET #INT-ID
END-IF
IF *MACHINE-CLASS NE 'MAINFRAME'
  ESCAPE ROUTINE
END-IF
IF #FUNC = ' ' /*int.ID->ID
  FIND MF-NODE WITH MF-INTERNAL-NODE-ID = #INT-ID
    #MONITOR-ID := MF-MONITOR-ID
  END-FIND
ELSE /*ID->int.ID
  FIND MF-NODE WITH MF-MONITOR-ID = #MONITOR-ID
    #INT-ID := MF-INTERNAL-NODE-ID
  END-FIND
END-IF
*
END
