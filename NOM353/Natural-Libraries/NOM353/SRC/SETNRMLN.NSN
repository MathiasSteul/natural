* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* ***********************************************************************
* MEMBER    SETNRMLN
* FUNCTION  This program will be used to set the logical file
*           depending on which version of NATURAL.
*
* VERSION   1.4
*
* Maintenance:
* jwo 1997-09-18 S(164220) created NAT23 solution
* jvd 1999-06-30 S(183302) MOM142 changes
* fhi 2000-01-28 S(191368) Module taken from NOM142 and stowed for NOM211
* bli 2012-09-19 NOMALL-94 delete old version checks                    1
* ***********************************************************************
*
DEFINE DATA PARAMETER
1 #PARM-DBID        (N5)
1 #PARM-FNR         (N5)
1 #PARM-LFILE       (N5)
1 #PARM-PASSWORD    (A8)
1 #PARM-CIPHER      (A8)
1 #PARM-RC          (I4)
*
LOCAL
1 #NOM-SYS-LFILE    (N5) INIT <206>
*
1 #PARMS-NATF0205   /* Param. for NAT23 call
  2 #FUNCTION       (A1)
  2 #DBID           (N5)
  2 #FNR            (N5)
  2 #PASSWORD       (A8)
  2 #CIPHER         (A8)
  2 #LFID           (N5)
  2 #RESPONSE       (N4)
*
END-DEFINE
*
* *--------------------------------------------------------------------
RESET #PARMS-NATF0205
*
IF #PARM-LFILE EQ 0
  #PARM-LFILE := #NOM-SYS-LFILE
END-IF
*
#DBID     :=  #PARM-DBID
#FNR      :=  #PARM-FNR
#LFID     :=  #PARM-LFILE
#PASSWORD :=  #PARM-PASSWORD
#CIPHER   :=  #PARM-CIPHER
CALLNAT 'NATF0205' #PARMS-NATF0205
#PARM-RC := #RESPONSE
END
