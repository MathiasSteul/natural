DEFINE FUNCTION F#MONITOR-TASK-USER-ID-LOG1 RETURNS #USER-ID-LOG (A16)
  DEFINE DATA
  LOCAL USING RMTASK-P   /*SU1
  END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RMTASK-P.FUNCTION       := 'L'
RMTASK-P.SUBTASK-NUMBER := 1
CALLNAT 'RMTASKID' RMTASK-P
#USER-ID-LOG := RMTASK-P.TASK-ID
*
END-FUNCTION /*F#MONITOR-TASK-USER-ID-LOG1
*
END
