* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* NOMLONGN - Convert NOM short names (A50) to long names (A250)
*   Template: XXHASH-T
*
* Maintenance
* User ID   yyyy-mm-dd Issue         Remark
* --------------------------------------------------------------------- --------
* fhi       2014-10-14 NOMALL-1595   Created.
* SU1 2015-12-30 NOMALL-1722 XXHASH-P changed->recat
********************************************************************************
DEFINE DATA PARAMETER USING NOMLONGP
************************************************************************
LOCAL     USING XXHASH-P
LOCAL     USING XXGMSG-A
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
XXHASH-PARMS.P-FUNCTION   := 'L' /*short -> long/GET-LONG-NAME
XXHASH-PARMS.P-SHORT-NAME := NL-SHORT-NAME
RESET XXHASH-PARMS.P-LONG-NAME NL-ERC NL-ERT
PERFORM XXHASH XXHASH-PARMS
IF XXHASH-PARMS.P-RC = 0
  NL-SHORT-NAME := XXHASH-PARMS.P-SHORT-NAME
  NL-LONG-NAME  := XXHASH-PARMS.P-LONG-NAME
ELSE
  NL-ERC := #XX-ERROR-CODE := 1125 /*Long name for :1: not found.
  #XX-MSG-DYNA(1) := NL-SHORT-NAME
  CALLNAT 'XXGMSG-N' #XX-GMSG-PARMS
  NL-ERT := #XX-SHORT-TEXT
END-IF
*
END
