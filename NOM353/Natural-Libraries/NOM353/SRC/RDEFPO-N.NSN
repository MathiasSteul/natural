* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RDEFPO-N - Get schedule time for printout
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* xsetggr 2007-06-04 p(294790) changes in eompom-p
* xsetggr 2007-06-27 NOM3201   support 5 byte node and 11 byte run numbe
*                              numbers, restow - changes in eompom-parms
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 #PHYSICAL-NAME             (A8)
1 #SCHEDULED                 (T)
************************************************************************
LOCAL  USING  EOMPOM-P
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET EOMPOM-ATTR-GENERAL EOMPOM-IN-PARMS (1)
EOMPOM-NAME := #PHYSICAL-NAME
*
CALLNAT 'EOMPOTWN' EOMPOM-PARMS
#SCHEDULED := EOMPOM-SCHEDULED
*
END
