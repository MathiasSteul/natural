1 #LAST-MOD                    (A40)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
DEFINE WINDOW REVIVE-WINDOW SIZE 14*55 BASE 05/10 CONTROL WINDOW
*
IF +G-RLISAB-LAYOUT-SWITCH = ' '
  +G-RLISAB-LAYOUT-SWITCH := G-USER-TYPE
END-IF
*
PROFILE-STRING:= G-USER-PROFILE
RESET G-COMMIT
G-C-OBJTYPE := 'BUNDLE'
*
CALLNAT 'NARPSEC' G-USER-PROFILE 'DAB' #ALLOWED
INCLUDE C-NALLOW
*
CALLNAT 'NARPSEC' G-USER-PROFILE 'MAB' #UPDATE
CALLNAT 'NARPSEC' G-USER-PROFILE 'PAB' #DELETE
CALLNAT 'NARPSEC' G-USER-PROFILE 'FBU' #FLUSH
*
#ACT-MAST := 'RLISBU'
INCLUDE CVIDEO
*
IF *DATA = 3
  INPUT #S-BUNDLE #S-STAT #S-COORD
  IF #S-BUNDLE NE ' ' OR #S-STAT NE ' ' OR #S-COORD NE ' '
    +G-RLISAB-SEL-ABUNDLE := #S-BUNDLE
    +G-RLISAB-SEL-STAT    := #S-STAT
    +G-RLISAB-SEL-COORD   := #S-COORD
  END-IF
END-IF
*
IF NOT (+G-RLISAB-SEL-ABUNDLE = ' ' OR +G-RLISAB-SEL-ABUNDLE = SCAN '*')
  #S-BUNDLE := +G-RLISAB-SEL-ABUNDLE
  #S-STAT   := +G-RLISAB-SEL-STAT
  #S-COORD  := +G-RLISAB-SEL-COORD
END-IF
IF *DATA = 5
  PERFORM READ-FROM-STACK
  PERFORM INIT-LINECOM
  PERFORM LINE-COMMANDS
  PERFORM INIT-SELECTION-KEYS
  GET-SCREEN := TRUE
  CV-NAME(*) := (AD=I CD=NE)
ELSE
  #NEWVAL := TRUE
END-IF
IF NOT (+G-RLISAB-SEL-ABUNDLE = ' ' OR +G-RLISAB-SEL-ABUNDLE = SCAN '*')
  #SELECTED-MODE := TRUE
ELSE
  #SELECTED-MODE := FALSE
END-IF
*
MAIN-LOOP. REPEAT
*
  IF #LANGUAGE NE *LANGUAGE
    CALLNAT 'ROTINI-N' ##EQO-ACTIVE-BUNDLE  /* Init Object Type
      G-OBJ-TYPE G-OTB
    PERFORM INIT-PFKEYS
    PERFORM INIT-LINECOM
    #LANGUAGE := *LANGUAGE
  END-IF
  PERFORM SET-PFKEYS
  INCLUDE RMVHLP-C
*
  PERFORM GET-SCREEN
  RESET GET-SCREEN
*
  INCLUDE C-TOPBOT
*
  CALLNAT 'N-HEADER' L-HEADER G-DATE-FORMAT 'RLISBUM&'
  CALLNAT 'RFLIPG-N' G-LC G-LINECOM (*)
  PERFORM FLIP-DISPLAY
  SET CONTROL 'WB'
*
  IF +G-RLISAB-LAYOUT-SWITCH = 'A'
    DECIDE FOR FIRST CONDITION
      WHEN G-DISPLAY-LONG-NAMES AND #LEFT
        INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
          MARK *G-DIRECT-COMMAND USING MAP 'RLISABL&'
      WHEN G-DISPLAY-LONG-NAMES AND #RIGHT
        INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT
          MARK *G-DIRECT-COMMAND USING MAP 'RLISAB3&'
      WHEN NONE
        INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT MARK *G-DIRECT-COMMAND
          USING MAP 'RLISABM&'
    END-DECIDE
  ELSE
    IF G-DISPLAY-LONG-NAMES
      INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT MARK *G-DIRECT-COMMAND
        USING MAP 'RLISAB4&'
    ELSE
      INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT MARK *G-DIRECT-COMMAND
        USING MAP 'RLISAB2&'
    END-IF
  END-IF
*
  RESET G-NATRP-ERC G-NATRP-ERT
  INCLUDE C-DIRECT
  RESET #FORWARD #BACKWARD #TOP #BOT #NEWVAL G-NATRP-ERC G-NATRP-ERT
    #SCROLL-AMOUNT
*
  INCLUDE C-LOCCMD
  INCLUDE RPFKEX-C
  DECIDE ON FIRST G-PF-FUNC
    VALUE 'SWLAYOUT'
      IF +G-RLISAB-LAYOUT-SWITCH = 'G'
        +G-RLISAB-LAYOUT-SWITCH := 'A'
      ELSE
        +G-RLISAB-LAYOUT-SWITCH := 'G'
      END-IF
      RESET #LANGUAGE
    VALUE 'EXT'
      IF G-SUPPORT-LONG-NAMES
        IF G-DISPLAY-LONG-NAMES
          RESET G-DISPLAY-LONG-NAMES
        ELSE
          G-DISPLAY-LONG-NAMES := TRUE
        END-IF
        RESET #LANGUAGE
      END-IF
    VALUE 'RIGHT'
      IF #LEFT
        RESET  #LEFT
        #RIGHT := TRUE
      END-IF
    VALUE 'LEFT'
      IF #RIGHT
        RESET  #RIGHT
        #LEFT := TRUE
      END-IF
    NONE VALUE IGNORE
  END-DECIDE
*
  PERFORM LINE-COMMANDS
*
  IF CV-SELECTION (*) MODIFIED
    #NEWVAL := TRUE
    +G-RLISBU-SEL-BUNDLE  := #S-BUNDLE
    #BUNDLE               := #S-BUNDLE
    IF PROF-ABUN-LIST-FORMAT = ' ' OR = '1' /* OLD-STYLE POP-UP
      IF #BUNDLE = SCAN '*'
        +G-SELECT-ACTIVE-BUNDLE := TRUE
        CALLNAT 'RSELBU-N' #BUNDLE  G-USERID G-USER-TYPE
          G-SUPPORT-LONG-NAMES G-DISPLAY-LONG-NAMES
        +G-SELECT-ACTIVE-BUNDLE := FALSE
        #S-BUNDLE := #BUNDLE
      END-IF
      IF #S-BUNDLE = ' '
        #SELECTED-MODE := FALSE
      ELSE
        #SELECTED-MODE := TRUE
      END-IF
    ELSE                                 /* NEW-STYLE FULL LIST
      IF NOT (#S-BUNDLE = ' ' OR #S-BUNDLE = SCAN '*')
        #SELECTED-MODE:= TRUE
      ELSE
        IF PROF-ABUN-LIST-FORMAT = '3' AND #S-BUNDLE NE ' '
          #SELECTED-MODE:= TRUE
        ELSE
          #SELECTED-MODE:= FALSE
        END-IF
      END-IF
    END-IF
    +G-RLISAB-SEL-ABUNDLE := #S-BUNDLE
    +G-RLISAB-SEL-STAT := #S-STAT
    +G-RLISAB-SEL-COORD := #S-COORD
  END-IF
*
END-REPEAT
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE GET-SCREEN
************************************************************************
IF G-DIRECT-COMMAND = 'TOP'
  #TOP := TRUE
END-IF
RESET L-MARK(*) L-IDENT (*)
*
DECIDE FOR EVERY CONDITION
  WHEN #NEWVAL OR #TOP
    PERFORM INIT-SELECTION-KEYS
    IF #SELECTED-MODE
      RESET #LS-RNB
      #LS-BUNDLE-SEL := #S-BUNDLE-F
    ELSE
      RESET #LS-OPEN
      #LS-BUNDLE := #S-BUNDLE-F
    END-IF
    RESET #PAGES (*) #MAXP #MAXAP
    #PAGES (1) := #AB-SUPER
    #CP := 1
    #MAXAP := 1
  WHEN #BOT
    #I := 0
    READ ACTIVE-BUNDLES BY AB-OPENTIME-BUNDLE = #PAGES(#CP)
      DECIDE FOR EVERY CONDITION
        WHEN NOT(AB-BUNDLE  = #S-BUNDLE-F THRU #S-BUNDLE-T)
          ESCAPE TOP
        WHEN NOT(#S-STAT = ' ' OR = '*')
          IF AB-STATUS NE #S-STAT
            ESCAPE TOP
          END-IF
        WHEN NOT(#S-COORD = ' 'OR = '*')
          IF AB-COORDINATOR-ID NE #S-COORD
            ESCAPE TOP
          END-IF
        WHEN NONE
          IGNORE
      END-DECIDE
      ADD 1 TO #I
      IF #I = 16
        IF #CP = #NOFPAGES
          #PAGES (2:#NOFPAGES - 1) := #PAGES (3:#NOFPAGES)
          #LK-OPEN := AB-OPEN-TIME
          #LK-BUNDLE := AB-BUNDLE
          RESET #PAGES(#CP)
          #PAGES (#CP) := #LAST-KEY
        ELSE
          IF #SCROLL-AMOUNT < 1
            #SCROLL-AMOUNT := 1
          END-IF
          IF #CP + #SCROLL-AMOUNT <= #MAXAP
            #CP := #CP + #SCROLL-AMOUNT
          ELSE
            IF #SCROLL-AMOUNT > 1
              #CP := #MAXAP
            ELSE
              ADD 1 TO #CP
            END-IF
          END-IF
          IF #CP > #MAXAP
            #LK-OPEN := AB-OPEN-TIME
            #LK-BUNDLE := AB-BUNDLE
            #PAGES(#CP) := #LAST-KEY
          END-IF
        END-IF
        #I := 1
      END-IF
    END-READ
    #MAXAP := #CP
  WHEN #FORWARD
    IF #END-OF-DATA
      ESCAPE ROUTINE
    END-IF
    IF #CP = #NOFPAGES
      #PAGES (1:#NOFPAGES - 1) := #PAGES (2:#NOFPAGES)
      RESET #PAGES (#CP)
      #PAGES (#CP) := #LAST-KEY
    ELSE
      IF #SCROLL-AMOUNT < 1
        #SCROLL-AMOUNT := 1
      END-IF
      IF #CP + #SCROLL-AMOUNT <= #MAXAP
        #CP := #CP + #SCROLL-AMOUNT
      ELSE
        IF #SCROLL-AMOUNT > 1
          #CP := #MAXAP
        ELSE
          ADD 1 TO #CP
        END-IF
      END-IF
      #PAGES(#CP) := #LAST-KEY
    END-IF
  WHEN #BACKWARD
    IF #CP < 2
      IGNORE
    ELSE
      IF #SCROLL-AMOUNT < 1
        #SCROLL-AMOUNT := 1
      END-IF
      SUBTRACT #SCROLL-AMOUNT FROM #CP
      IF #CP < 1
        #CP := 1
      END-IF
    END-IF
  WHEN GET-SCREEN
    IGNORE
  WHEN NONE
    ESCAPE ROUTINE
END-DECIDE
*
IF #CP >= #MAXAP
  #MAXAP := #CP
END-IF
*
#RSTART := #PAGES (#CP)
RESET I L-SCR (*) L-SCR-NO (*) #END-OF-DATA #TRACE-CNT
CV-MARK (*) := (AD=P)
*
DECIDE FOR FIRST CONDITION
  WHEN PROF-ABUN-LIST-FORMAT = '3'
    IF #SELECTED-MODE
      PERFORM READ-BY-BUNDLE-RNB-INV
    ELSE
      PERFORM READ-BY-OPENTIME-BUNDLE
    END-IF
  WHEN PROF-ABUN-LIST-FORMAT = '2'       /* NEW-STYLE FULL LIST
      AND NOT #SELECTED-MODE
    PERFORM READ-BY-OPENTIME-BUNDLE
  WHEN +G-RLISAB-SEL-ABUNDLE = ' '
    #SELECTED-MODE := FALSE
    PERFORM READ-BY-OPENTIME-BUNDLE
  WHEN +G-RLISAB-SEL-ABUNDLE = SCAN '*'
    +G-SELECT-ACTIVE-BUNDLE := TRUE
    #BUNDLE := +G-RLISAB-SEL-ABUNDLE
    CALLNAT 'RSELBU-N' #BUNDLE  G-USERID G-USER-TYPE
      G-SUPPORT-LONG-NAMES G-DISPLAY-LONG-NAMES
    +G-SELECT-ACTIVE-BUNDLE := FALSE
    RESET +G-RLISAB-SEL-STAT
      +G-RLISAB-SEL-COORD
    IF #BUNDLE = SCAN '*'
      RESET +G-RLISAB-SEL-ABUNDLE
    ELSE
      +G-RLISAB-SEL-ABUNDLE := #BUNDLE
    END-IF
*
    FETCH 'RLISAB'
*
  WHEN NONE
    #SELECTED-MODE := TRUE
    PERFORM READ-BY-BUNDLE-RNB-INV
END-DECIDE
*
END-SUBROUTINE /* GET-SCREEN
*
************************************************************************
DEFINE SUBROUTINE READ-BY-BUNDLE-RNB-INV
************************************************************************
SEL-MODE. READ ACTIVE-BUNDLES BY AB-BUNDLE-RNB-INV = #RSTART-SEL
  AT START OF DATA
    #TK-BUNDLE-SEL := AB-BUNDLE
    #TK-RNB := AB-BUNDRNB-INV
  END-START
  PERFORM HANDLE-ACTIVE-BUNDLE
  IF NOT (AB-BUNDLE  = #S-BUNDLE-F THRU #S-BUNDLE-T)
    ESCAPE BOTTOM
  END-IF
  IF I > #NOFLINES
    ESCAPE ROUTINE
  END-IF
*
END-READ
*
#END-OF-DATA := TRUE
#MAXP := #CP
*
END-SUBROUTINE /* READ-BY-BUNDLE-RNB-INV
*
************************************************************************
DEFINE SUBROUTINE READ-BY-OPENTIME-BUNDLE
************************************************************************
READ-LOOP. READ ACTIVE-BUNDLES BY AB-OPENTIME-BUNDLE = #RSTART
*
  AT START OF DATA
    #TK-BUNDLE := AB-BUNDLE
    #TK-OPEN := AB-OPEN-TIME
  END-START
*
  PERFORM HANDLE-ACTIVE-BUNDLE
  IF I > #NOFLINES
    ESCAPE ROUTINE
  END-IF
*
END-READ
*
#END-OF-DATA := TRUE
#MAXP := #CP
*
END-SUBROUTINE /* READ-BY-OPENTIME-BUNDLE
*
************************************************************************
DEFINE SUBROUTINE HANDLE-ACTIVE-BUNDLE
************************************************************************
DISPLAY-IT := TRUE
*
DECIDE FOR EVERY CONDITION
  WHEN NOT(AB-BUNDLE  = #S-BUNDLE-F THRU #S-BUNDLE-T)
    IF #SELECTED-MODE
      ESCAPE ROUTINE
    END-IF
    DISPLAY-IT := FALSE
  WHEN NOT(#S-STAT = ' ' OR = '*')
    IF AB-STATUS NE #S-STAT
      DISPLAY-IT := FALSE
    END-IF
  WHEN NOT(#S-COORD = ' 'OR = '*')
    IF AB-COORDINATOR-ID NE #S-COORD
      DISPLAY-IT := FALSE
    END-IF
  WHEN NONE
    IGNORE
END-DECIDE
*
IF NOT DISPLAY-IT
  INCLUDE RMTRACEC
END-IF
REJECT IF NOT DISPLAY-IT
IF G-USER-TYPE = 'A'
  GRANTED := TRUE
  GRANTS.GR-OPTION(*) := 'Y'
ELSE
  #GR-T := 'B'
  #GR-N := AB-BUNDLE
  #GR-U := G-USERID
  CALLNAT 'RGRANT-N'      /* GET USER ACCESS LEVEL ON AN OBJECT
    #GR-U #GR-T #GR-N GRANTED GRANTS.GR-OPTION (*)
END-IF
*
REJECT IF NOT GRANTED AND PROF-RESTRICT-ABUN = 'Y'
ADD 1 TO I
IF I > #NOFLINES
  IF #SELECTED-MODE
    #LK-BUNDLE-SEL := AB-BUNDLE
    #LK-RNB := AB-BUNDRNB-INV
  ELSE
    #LK-BUNDLE := AB-BUNDLE
    #LK-OPEN := AB-OPEN-TIME
  END-IF
  ESCAPE ROUTINE
END-IF
*
IF I = 1
  IF #SELECTED-MODE
    #PK-BUNDLE-SEL (#CP) := AB-BUNDLE
    #PK-RNB (#CP) := AB-BUNDRNB-INV
  ELSE
    #PK-BUNDLE (#CP) := AB-BUNDLE
    #PK-OPEN (#CP) := AB-OPEN-TIME
  END-IF
END-IF
*
#TK-BUNDLE := L-NAME (I) := AB-BUNDLE
#TK-OPEN := AB-OPEN-TIME
L-RNB (I) := AB-BUNDRNB
#OPENT := AB-OPEN-TIME
#OPENP := #OPENT
*
#OPENP := - (#OPENP - #MAX-INV-TIME)
#OPENT := #OPENP
IF #OPENT NE T'00:00:00'
  MOVE EDITED #OPENT (EM=YYYYMMDD) TO L-OPEN-DATE (I)
  MOVE EDITED #OPENT (EM=HH':'II) TO L-OPEN-TIME (I)
  CALLNAT 'IODATE-N' 'M' 'S' L-OPEN-DATE (I) #DATE G-DATE-FORMAT
    #ERC #ERT
  L-OPEN-DATE (I) := #DATE
END-IF
*
IF AB-FLUSH-TIME NE T'00:00:00'
  MOVE EDITED AB-FLUSH-TIME (EM=YYYYMMDD) TO L-FLUSH-DATE (I)
  MOVE EDITED AB-FLUSH-TIME (EM=HH':'II) TO L-FLUSH-TIME (I)
  CALLNAT 'IODATE-N' 'M' 'S' L-FLUSH-DATE (I) #DATE G-DATE-FORMAT
    #ERC #ERT
  L-FLUSH-DATE (I) := #DATE
END-IF
IF #SELECTED-MODE
  L-ISN (I) := *ISN (SEL-MODE.)
ELSE
  L-ISN (I) := *ISN (READ-LOOP.)
END-IF
L-OPTION (I,1:6) := GRANTS.GR-OPTION (1:6)
*
IF C*AB-PRINT-LIST = 0
  CALLNAT 'RLTINI-N' ##TXT-NO-PRINTER #IDENT-TEXT G-TXB
  L-MSG (I) := #IDENT-TEXT
ELSE
  RESET L-MSG(I)
END-IF
*
L-STAT (I) := AB-STATUS
*
DECIDE ON FIRST VALUE OF AB-STATUS
  VALUE 'O'       #IDENT := ##TXT-OPENED
  VALUE 'F'       #IDENT := ##TXT-FLUSHING
  VALUE 'D'       #IDENT := ##TXT-PROCESSED
  VALUE 'E' , ' ' #IDENT := ##TXT-EMPTY
  VALUE 'P' , ' ' #IDENT := ##TXT-FORCED
  VALUE 'M' , ' ' #IDENT := ##TXT-PRINT
  VALUE 'N' , ' ' #IDENT := ##TXT-PRINTED
  VALUE 'C' , ' ' #IDENT := ##TXT-CLOSED
  ANY
    CALLNAT 'RLTINI-N' #IDENT /* Language dependant Text
      #IDENT-TEXT G-TXB
    L-STATUS (I) := #IDENT-TEXT
  NONE VALUE
    IGNORE
END-DECIDE
*
RESET L-LINES (I)
#BC-BUNDLE := L-NAME (I)
#BC-BUNDRNB := L-RNB (I)
RESET #BC-GROUP #BC-SEQNO L-NUMREP (I)
#BC-BUNDLE-E := L-NAME (I)
#BC-BUNDRNB-E := L-RNB (I)
MOVE ALL H'FF' TO #BC-GROUP-E
#BC-SEQNO-E := 999
RESET L-NUMREP (I)
*
FNDBC. FIND NUMBER BUNDLE-CONTENTS
  WITH BC-BUNDLE-RNB-GROUP-SEQNO = #BC-SUPER THRU #BC-SUPER-END
L-NUMREP (I) := *NUMBER (FNDBC.)
*
FNDB. FIND BUNDLES WITH B-BUNDLE = L-NAME (I)
  IF NO RECORDS FOUND
    MOVE ALL '?' TO B-DESC
  END-NOREC
  L-DESC (I) := B-DESC
END-FIND
*
L-COORD-ID (I) := AB-COORDINATOR-ID
*
MOVE EDITED AB-PLAN-FLUSH-TIME (EM=YYYYMMDD) TO L-PLAN-FLUSH-DATE (I)
IF L-PLAN-FLUSH-DATE (I) = '00000102'
  RESET L-PLAN-FLUSH (I)
  MOVE EDITED AB-PLAN-FLUSH-TIME (EM=HH':'II) TO
    L-PLAN-FLUSH-TIME (I)
  CALLNAT 'IODATE-N' 'M' 'S' L-PLAN-FLUSH-DATE (I) #DATE G-DATE-FORMAT
    #ERC #ERT
  L-PLAN-FLUSH-DATE (I) := #DATE
END-IF
*
IF AB-EXPIRATION NE ' '
  CALLNAT 'IODATE-N' 'M' 'S' AB-EXPIRATION-DATE #DATE G-DATE-FORMAT
    #ERC #ERT
  IF AB-EXPIRATION-ACTION = 'F'
    L-FORCE (I) := #DATE
  ELSE
    L-PURGE (I) := #DATE
  END-IF
END-IF
*
RESET CV-MARK(I)
IF NOT GRANTED
  CV-NAME (I) := (AD=D CD=TU)
  CV-MARK (I) := (AD=PD)
ELSE
  CV-NAME (I) := (AD=I CD=NE)
END-IF
*
END-SUBROUTINE /* HANDLE-ACTIVE-BUNDLE
*
************************************************************************
DEFINE SUBROUTINE LINE-COMMANDS
************************************************************************
IF L-MARK(*) = '.'
  INCLUDE C-ESCAPE
END-IF
*
INCLUDE RLCMTI-C
INCLUDE C-CHKLC
*
FOR I 1 TO #NOFLINES
  DECIDE ON FIRST VALUE OF L-IDENT (I)
    VALUE ##EQU-CLOSE
      IF NOT #FLUSH
        REINPUT *0020  MARK *L-MARK (I) ALARM
      END-IF
      GET-BUND-C. GET ACTIVE-BUNDLES L-ISN(I)
      DECIDE ON FIRST VALUE OF AB-STATUS
        VALUE 'O' IGNORE                                  /* OPENED
        VALUE 'E',' '                                     /* EMPTY
          REINPUT *0709 MARK *L-MARK (I) ALARM
        NONE VALUE
          REINPUT *0710 MARK *L-MARK (I) ALARM
      END-DECIDE
    VALUE ##EQU-PRINT
      GET-BUND-P.
      GET ACTIVE-BUNDLES L-ISN (I)
      IF AB-STATUS = 'E'
        REINPUT *0707 MARK *L-MARK (I)
      END-IF
* BLI 2017-01-17 NOMALL-1984 move xsetggr 03-02-25 p(222810) to here
    VALUE ##EQU-MODIFY
      GET-BUND-M. GET ACTIVE-BUNDLES L-ISN(I)
      IF ACTIVE-BUNDLES.AB-STATUS NE 'O'
* closed bundles should be displayed as discussed with *EVI and *RRI
**      REINPUT *0701 MARK *L-MARK (I)
        L-IDENT (I) := ##EQU-DISPLAY
      END-IF
* BLI 2017-01-17 NOMALL-1984 move xsetggr 03-02-25 p(222810) end
    NONE VALUE
      IGNORE
  END-DECIDE
END-FOR
*
FOR I 1 TO #NOFLINES
  DECIDE ON FIRST VALUE OF L-IDENT (I)
    VALUE ##EQU-DELETE
      G-NATRP-ERC := 0017
      IF G-CONFIRM
        #OBJECT-NAME := L-NAME(I)
        #OBJECT-TYPE := 'B'
        CALLNAT 'N-CNFRM' #OBJECT-NAME #OBJECT-TYPE G-DISPLAY-LONG-NAMES
          #CONFIRMED G-NATRP-ERT LOWER-CASE
      END-IF
      IF #CONFIRMED OR NOT G-CONFIRM
        DEL-BUND. GET ACTIVE-BUNDLES L-ISN (I)
        IF AB-STATUS = 'O'
          ACTIVE-BUNDLES.AB-STATUS := 'OD'
        ELSE
          AB-STATUS := 'D'
        END-IF
        UPDATE (DEL-BUND.)
        G-C-BUNDLE  := L-NAME(I)
        G-C-BUNDRNB := L-RNB(I)
        FETCH RETURN 'RDELAB'
        G-NATRP-ERC := 0018
        GET-SCREEN  := TRUE
        INCLUDE L-COMMIT
      END-IF
    VALUE ##EQU-CLOSE
      PERFORM CLOSE-BUNDLE
    VALUE ##EQU-PRINT
      PERFORM PRINT-BUNDLE
    VALUE ##EQU-ARCHIVE
      PERFORM ARCHIVE-REVIVE-WHOLE-BUNDLE
    VALUE ##EQU-REVIVE
      PERFORM REVIVE-WHOLE-BUNDLE
    VALUE ##EQU-INFO
      PERFORM INFO-BUNDLE
    VALUE ##EQU-MODIFY
      G-C-FUNC := 'M'
      PERFORM COMMIT-WORK
      G-C-BUNDLE  := L-NAME (I)
      G-C-BUNDRNB := L-RNB (I)
      FETCH RETURN 'RDEFAB'
      GET-SCREEN := TRUE
    VALUE ##EQU-DISPLAY
      G-C-FUNC := 'D'
      PERFORM COMMIT-WORK
      G-C-BUNDLE  := L-NAME (I)
      G-C-BUNDRNB := L-RNB (I)
      FETCH RETURN 'RDEFAB'
      GET-SCREEN := TRUE
    VALUE ##EQU-MODIFY
      G-C-FUNC := 'M'
      PERFORM COMMIT-WORK
      G-C-BUNDLE := L-NAME (I)
      G-C-BUNDRNB := L-RNB (I)
      FETCH RETURN 'RDEFAB'
      GET-SCREEN := TRUE
    VALUE ##EQU-LIST-REPORTS
      RESET L-MARK (I) L-IDENT (I)
      G-C-BUNDLE  := L-NAME(I)
      G-C-BUNDRNB := L-RNB(I)
      PERFORM COMMIT-WORK
      G-FATHER-PROG := 'RLISAB'
      PERFORM STACK-SCREEN
      FETCH 'RLISBC'
    VALUE ##EQU-LOG
      COMPRESS L-NAME (I) '-' L-RNB (I) TO LG-OBJECT-NAME LEAVING NO
      FETCH RETURN 'RLISLG' 'AB' LG-OBJECT-NAME
    NONE VALUE IGNORE
  END-DECIDE
END-FOR
*
END-SUBROUTINE /* LINE-COMMANDS
*
************************************************************************
DEFINE SUBROUTINE INIT-SELECTION-KEYS
************************************************************************
#LEN := 25
CALLNAT 'SELALPHA' #S-BUNDLE #S-BUNDLE-F #S-BUNDLE-T #LEN
*
END-SUBROUTINE /* INIT-SELECTION-KEYS
*
************************************************************************
DEFINE SUBROUTINE INIT-LINECOM
************************************************************************
I := 1
G-LC-IDENT (I) := ##EQU-DISPLAY
ADD 1 TO I
G-LC-IDENT (I) := ##EQU-INFO
IF #UPDATE
  ADD 1 TO I
  G-LC-IDENT (I) := ##EQU-MODIFY
END-IF
IF #DELETE
  ADD 1 TO I
  G-LC-IDENT (I) := ##EQU-DELETE
END-IF
ADD 1 TO I
G-LC-IDENT (I) := ##EQU-LOG
ADD 1 TO I
G-LC-IDENT (I) := ##EQU-LIST-REPORTS
IF #FLUSH
  ADD 1 TO I
  G-LC-IDENT (I) := ##EQU-CLOSE
  ADD 1 TO I
  G-LC-IDENT (I) := ##EQU-PRINT
END-IF
IF #UPDATE
  ADD 1 TO I
  G-LC-IDENT (I) := ##EQU-ARCHIVE
  ADD 1 TO I
  G-LC-IDENT (I) := ##EQU-REVIVE
END-IF
G-LC-NUM := I
CALLNAT 'RLCINI-N' G-OBJ-TYPE G-LC G-LCB
*
END-SUBROUTINE /* INIT-LINECOM
*
************************************************************************
DEFINE SUBROUTINE REVIVE-WHOLE-BUNDLE
************************************************************************
G-C-BUNDLE  := #CUR-BUNDLE := L-NAME (I)
IF NOT G-DISPLAY-LONG-NAMES
  #CUR-BUNDLE-A(9) := H'FA'
END-IF
G-C-BUNDRNB := L-RNB  (I)
*
RESET #AR-REVIVE
*** If not MF, don't ask for revive medium - Only DB is valid
IF *MACHINE-CLASS NE 'MAINFRAME'
  #AR-REVIVE := 'D'
ELSE
  SET KEY PF3 = PGM
  SET CONTROL 'MT'
*
  INPUT WINDOW = 'REVIVE-WINDOW' WITH TEXT *G-NATRP-ERC, G-NATRP-ERT
    USING MAP 'RREVABM&'
  IF *PF-KEY = 'PF3'
    SET CONTROL 'M21'
    G-NATRP-ERC := 0475         /* bundle contents not marked for revive
    ESCAPE ROUTINE
  END-IF
  IF NOT #AR-REVIVE ='S' OR='D'
    REINPUT *0465               /* please enter valid revive location
  END-IF
*
END-IF
PERFORM ARCHIVE-REVIVE-WHOLE-BUNDLE
*
END-SUBROUTINE /* REVIVE-WHOLE-BUNDLE
*
************************************************************************
DEFINE SUBROUTINE ARCHIVE-REVIVE-WHOLE-BUNDLE
************************************************************************
RESET #COUNTER #BC-GROUP #BC-SEQNO
#BC-BUNDLE  := L-NAME (I)
#BC-BUNDRNB := L-RNB (I)
*
READ-BC-AR. READ BUNDLE-CONTENTS BY BC-BUNDLE-RNB-GROUP-SEQNO=#BC-SUPER
  IF BC-BUNDLE NE #BC-BUNDLE OR BC-BUNDRNB NE #BC-BUNDRNB
    ESCAPE BOTTOM
  END-IF
  #AR-REPNAME := BC-REPNAME
  #AR-REPRNB  := BC-REPRNB
  ARCHIVE. FIND ACT-REP WITH AR-REPORT-RNB = #AR-REPORT-RNB
    IF AR-ARCHIVE = ' ' AND L-IDENT (I) = ##EQU-ARCHIVE
      AR-ARCHIVE := 'A'
      RESET AR-ACTIVE
      ADD 1 TO #COUNTER
    END-IF
    IF AR-ARCHIVE = '*' AND L-IDENT (I) = ##EQU-REVIVE
        AND AR-CURRENT-LOCATION = 'A'
      AR-REVIVE := #AR-REVIVE
      ADD 1 TO #COUNTER
    END-IF
    UPDATE (ARCHIVE.)
  END-FIND
END-READ
IF L-IDENT (I) = ##EQU-ARCHIVE
  G-NATRP-ERC := 471
ELSE
  G-NATRP-ERC := 476
END-IF
G-NATRP-ERT := #COUNTER
*
END TRANSACTION
*
END-SUBROUTINE /* ARCHIVE-REVIVE-WHOLE-BUNDLE
*
************************************************************************
DEFINE SUBROUTINE PRINT-BUNDLE
************************************************************************
GET-BUND-PR-2. GET ACTIVE-BUNDLES L-ISN (I)
IF AB-PRINTER (1) NE ' '
  G-C-PRINTER := AB-PRINTER (1)
END-IF
IF AB-STATUS = 'O'
  SET CONTROL 'WC11L45B10/15F'
  INPUT USING MAP 'RPRTABM&'
  #PF-KEY := *PF-KEY
  DECIDE ON FIRST VALUE OF *PF-KEY
    VALUE 'PF3'
      ESCAPE ROUTINE
    VALUE 'PF4'
      PERFORM CLOSE-BUNDLE
    NONE VALUE
      REINPUT *1, #PF-KEY ALARM
  END-DECIDE
  SET CONTROL 'WB'
END-IF
G-C-BUNDLE := L-NAME (I)
G-C-BUNDRNB := L-RNB (I)
FETCH RETURN 'RPRTBU'
*
END-SUBROUTINE /* PRINT-BUNDLE
*
************************************************************************
DEFINE SUBROUTINE CLOSE-BUNDLE
************************************************************************
GET-BUND-CL. GET ACTIVE-BUNDLES L-ISN(I)
IF AB-STATUS = 'O'
  RESET ACTIVE-BUNDLES.AB-EXPIRATION
  IF ACTIVE-BUNDLES.AB-RETENTION-ACTION = 'P' AND
      ACTIVE-BUNDLES.AB-RETENTION-PERIOD NE ' '
    #DATE-IN := *DATX
    CALLNAT 'RCOMED-N' #DATE-IN ACTIVE-BUNDLES.AB-RETENTION-PERIOD
      #DATE-OUT
    MOVE EDITED #DATE-OUT (EM=YYYYMMDD) TO #DATE-A
    IF #DATE-A NE '00000102'
      COMPRESS 'P' #DATE-A TO ACTIVE-BUNDLES.AB-EXPIRATION LEAVING NO
    END-IF
  END-IF
  ACTIVE-BUNDLES.AB-STATUS := 'C'
  ACTIVE-BUNDLES.AB-FLUSH-TIME := *TIMX
  IF ACTIVE-BUNDLES.AB-PRINTER(1) = ' ' AND G-C-PRINTER NE ' '
    ACTIVE-BUNDLES.AB-PRINTER(1) := G-C-PRINTER
  END-IF
  UPDATE(GET-BUND-CL.)
  GET-SCREEN := TRUE
*
  LG-USERID := G-USERID
  LG-CODE := 'AB'
  COMPRESS L-NAME(I) '-' L-RNB(I) TO LG-OBJECT-NAME LEAVING NO
  LG-BUNDLE := L-NAME(I)
  LG-BUNDRNB := L-RNB(I)
  COMPRESS '2108' LG-OBJECT-NAME TO LG-MSG
  CALLNAT 'RLOG' PL-PARMS
  END TRANSACTION
END-IF
*
END-SUBROUTINE /* CLOSE-BUNDLE
*
************************************************************************
DEFINE SUBROUTINE INFO-BUNDLE
************************************************************************
#SI := I
#BC-BUNDLE  := L-NAME (I)
#BC-BUNDRNB := L-RNB (I)
#CUR-BUNDLE := L-NAME(I)
IF G-DISPLAY-LONG-NAMES
  COMPRESS #CUR-BUNDLE '/' L-RNB (I) TO #BUN-RNB
ELSE
  COMPRESS #CUR-BUNDLE-8 '/' L-RNB (I) TO #BUN-RNB
END-IF
RESET #BC-GROUP #BC-SEQNO L-LINES(I)
*
READ BUNDLE-CONTENTS BY BC-BUNDLE-RNB-GROUP-SEQNO = #BC-SUPER
  IF BC-BUNDLE NE #BC-BUNDLE OR BC-BUNDRNB NE #BC-BUNDRNB
    ESCAPE BOTTOM
  END-IF
  #AR-REPNAME := BC-REPNAME
  #AR-REPRNB  := BC-REPRNB
  FIND ACT-REP WITH AR-REPORT-RNB = #AR-REPORT-RNB
    ADD AR-NUMBER-OF-LINES TO L-LINES(I)
  END-FIND
END-READ
*
FNDU. FIND USERS WITH USER-ID = L-COORD-ID (I)
  IF NO RECORDS FOUND
    #COORD-NAME := 'not defined'
    RESET  #COORD-PHONE
    ESCAPE BOTTOM
  END-NOREC
  COMPRESS FIRST-NAME LAST-NAME TO #COORD-NAME
  COMPRESS WORK-PHONE '/' WORK-PHONE-EXT TO #COORD-PHONE LEAVING NO
END-FIND
RESET #LAST-MOD
IF L-ISN(I) NE 0 /*just to be sure
  GET-BUND2. GET ACTIVE-BUNDLES L-ISN(I)
  CALLNAT 'N-HEAD2' AB-LAST-UPDATE-USER AB-LAST-UPDATE
    #LAST-MOD G-DATE-FORMAT
END-IF
SET CONTROL 'WFL72C24B01/07'
INPUT USING MAP 'RLISABW&'
SET CONTROL 'WMB'
*
END-SUBROUTINE /* INFO-BUNDLE
*
************************************************************************
DEFINE SUBROUTINE INIT-PFKEYS
************************************************************************
RESET G-PF
INCLUDE RPFSTD-C
INCLUDE RPFBRW-C
INCLUDE RPFMASTC
INCLUDE RPFREFRC
INCLUDE RPFSWLYC
IF G-DISPLAY-LONG-NAMES AND +G-RLISAB-LAYOUT-SWITCH = 'A'
    AND (#LEFT OR #RIGHT)
  INCLUDE RPFLR1-C
END-IF
CALLNAT 'RPFINI-N' G-PF G-PFB
*
END-SUBROUTINE
*
************************************************************************
DEFINE SUBROUTINE STACK-SCREEN
************************************************************************
FOR F = 1 TO 13
  IF L-SCREEN-SEG-L (F) = H'00'
    L-SCREEN-SEG-L (F) := H'01'
    L-SCREEN-SEG-FLAG (F) := TRUE
  ELSE
    L-SCREEN-SEG-FLAG (F) := FALSE
  END-IF
END-FOR
STACK TOP DATA FORMATTED L-SCREEN-SEGMENT (*) L-SCREEN-SEG-FLAG (*)
#STACK-PGM := *PROGRAM
STACK TOP DATA FORMATTED #STACK-PGM 'X' 'X' 'X' 'X'
STACK TOP COMMAND *PROGRAM
RESET F
*
END-SUBROUTINE /* STACK-SCREEN
*
************************************************************************
DEFINE SUBROUTINE READ-FROM-STACK
************************************************************************
INPUT #STACK-PGM
IF #STACK-PGM NE *PROGRAM
  *ERROR-NR := 999 /* internal error, should not occur
END-IF
INPUT (LS=202) L-SCREEN-SEGMENT (*) L-SCREEN-SEG-FLAG (*)
FOR F = 1 TO 13
  IF L-SCREEN-SEG-FLAG (F) = TRUE
    L-SCREEN-SEG-L (F) := H'00'
  END-IF
END-FOR
*
END-SUBROUTINE /* READ-FROM-STACK
*
INCLUDE RPFSET-C /*set pfkeys
*
END
