        5 L-OPEN-TIME          (A5)
      4 L-FLUSH                (A14)
      4 REDEFINE    L-FLUSH
        5 L-FLUSH-DATE         (A8)
        5 L-FLUSH-FIL          (A1)
        5 L-FLUSH-TIME         (A5)
      4 L-FORCE                (A8)
