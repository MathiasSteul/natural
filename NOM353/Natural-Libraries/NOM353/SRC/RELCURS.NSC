* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    RELCURS
* Version   1.3
* Function  Translate absolute cursor position to CURSOR-AREA, ROW,
*           COLUMN
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* mrs 93-11-05 s(999999) prefix on/off implemented
* gw  94-07-22 s(999999) *curs-line gt 21 is ignored
* fhi 02-10-30 fhi101    switch on optimizer compiler
* SU1     2016-08-01 NOMALL-1518 NOM3.5 deactivate opt.Compiler
* ----------------------------------------------------------------------
/*SU1 OPTIONS MCG=(INDX=ON,OVFLW=ON,DIGTCHCK=ON) /*fhi101 inserted
*
************************************************************************
DEFINE SUBROUTINE RELATIVE-CURSOR
************************************************************************
CURSOR-ROW := *CURS-LINE
CURSOR-COLUMN := *CURS-COL
DECIDE ON EVERY VALUE OF CURSOR-ROW
  VALUE 1 /* IN MESSAGE LINE
    ED-CAREA := 1
    ED-CCLM := *CURS-COL
    ED-CROW := 1
  VALUE 2        /* IN COMMAND LINE
    IF CURSOR-COLUMN  = 8 THRU 57 /*COMMAND FIELD
      ED-CAREA := 2
      SUBTRACT 6 FROM CURSOR-COLUMN
    ELSE     /*SCROLL FIELD
      ED-CAREA := 3
      SUBTRACT 73 FROM CURSOR-COLUMN
    END-IF
    ED-CCLM := CURSOR-COLUMN
    ED-CROW := 1
  NONE
    IF CURSOR-COLUMN = 1 THRU 7 AND G-EDT-PREFIX-IS-ON
      ED-CAREA := 4
      SUBTRACT 1 FROM CURSOR-COLUMN
    ELSE
      ED-CAREA := 5
      IF G-EDT-PREFIX-IS-ON
        CURSOR-COLUMN := *CURS-COL - 7
      ELSE
        CURSOR-COLUMN := *CURS-COL
      END-IF
    END-IF
    CURSOR-ROW := CURSOR-ROW - 2 /* WAS 3
    ED-CROW := CURSOR-ROW
    ED-CCLM := CURSOR-COLUMN
END-DECIDE
/*SU1 OPTIONS MCG=(OFF) /*fhi101 inserted
*
END-SUBROUTINE /* RELATIVE-CURSOR
