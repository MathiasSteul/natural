* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* MEMBER       MIGENDFO
* FUNCTION     Force end of migration, reset all flags
*
* VERSION      3.4
*
* Maintenance
* fhi  2013-06-03 Created from MIGUEXQE
* fhi  2014-11-25 NOMALL-1529 added error message
* fhi  2016-11-15 NOMALL-1961 Use new task IDs
* fhi  2019-01-24 NOMALL-1988 Honour migration under Unix, rewrtitten
* ----------------------------------------------------------------------
DEFINE DATA
LOCAL
1 MONITOR VIEW OF NRM-MONITOR
  2 M-MONITOR-ID
  2 M-NATRPT-DBID-N5
  2 M-NATRPT-FNR-N5
  2 M-VERSION
  2 REDEFINE M-VERSION
    3 M-VERS-VERSION-N       (N2)
    3 M-VERS-RELEASE-N       (N2)
    3 M-VERS-SP-N            (N2)
    3 M-VERS-CF-N            (N4)
    3 M-VERS-MIGRATION-IN-PROGRESS (A1)
    3 M-VERS-DATE            (A8)
    3 M-VERS-NO-OF-MIG-PROGS (N2)
    3 M-VERS-MIGRATION-COMPL (A1/10)
1 #YESNO                      (A3)
*
1 #MONITOR-ID                (A20)
1 #FOUND                     (L)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
INPUT '* ------------------------  MIGEND FORCE ------------------ *'
  // 'Be careful running this program.'
  /  'It will reset all migration flags. No migration will be detected'
  /  'to be in progress.'
  // 'It will not set the correct version number. To do so, run MIGEND'
  /  'after this program.'
  /  'Enter ''YES'' if you want to reset the flags, any other input'
  /  'to escape.'
  // '-->' #YESNO (AD=MIL'_')
IF *PF-KEY NE 'ENTR' OR #YESNO NE 'YES'
  WRITE // 'No changes done. Exiting.'
  ESCAPE MODULE
END-IF
INCLUDE MIG----C 'SET-VALUES' 'MONITOR'
END TRANSACTION
IF #FOUND
  WRITE // 'MIGEND forced. No migration in progress any more.'
ELSE
  WRITE // 'No monitor record found, nothing changed.'
END-IF
*
************************************************************************
* Subroutines
************************************************************************
DEFINE SUBROUTINE SET-VALUES /* Called by MIG----C
*                 ----------
M-VERS-MIGRATION-IN-PROGRESS := 'N'  /* No migration in progress
M-VERS-MIGRATION-COMPL(*)    := 'Y'  /* migration completed
END-SUBROUTINE
************************************************************************
*
END
