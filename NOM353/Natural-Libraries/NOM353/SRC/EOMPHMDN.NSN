DEFINE SUBROUTINE ATTRIBUTES-WRTSPOOL
************************************************************************
RESET EOMPHM-ATTRIBUTES (*) EOMPHM-JCL-SKELETON EOMPHM-ESCAPE-CHAR #K
/*SU3 -> IF *OPSYS = MASK('VSE') FOR #I = 6 TO #WRTSPL-VARS ADD 1 TO #K
/*EOMPHM-ATTR-IDENT (#K) := #K EOMPHM-ATTR-L-P-V (#K):=#WRTSPL-L-P-V(#I)
/*SU3 <-  END-FOR ELSE
FOR #I = 1 TO 10
  ADD 1 TO #K
  EOMPHM-ATTR-IDENT (#K) := #K
  EOMPHM-ATTR-L-P-V (#K) := #WRTSPL-L-P-V (#I)
END-FOR
/*SU3 END-IF
