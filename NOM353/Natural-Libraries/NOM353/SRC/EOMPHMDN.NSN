DEFINE DATA
PARAMETER USING EOMPHM-P
************************************************************************
LOCAL USING EOMPHTYE
LOCAL USING EOMPHVRE
LOCAL
1 #I  (I2)
1 #K  (I2)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET EOMPHM-JCL-SKELETON EOMPHM-ESCAPE-CHAR
*
DECIDE ON FIRST VALUE EOMPHM-PRINTER-TYPE
/*SU3 VALUE ##PHYS-SYSPR-PWR    PERFORM ATTRIBUTES-SYSPR-PWR
  VALUE ##PHYS-SYSPR-JES    PERFORM ATTRIBUTES-SYSPR-JES
/*SU3  VALUE ##PHYS-TAPE-VSE     PERFORM ATTRIBUTES-TAPE-VSE
  VALUE ##PHYS-TAPE-MVS     PERFORM ATTRIBUTES-TAPE-MVS
  VALUE ##PHYS-DISK-MVS     PERFORM ATTRIBUTES-DISK-MVS
  VALUE ##PHYS-NAF          PERFORM ATTRIBUTES-NAF
  VALUE ##PHYS-CMASPOOL     PERFORM ATTRIBUTES-CMASPOOL
  VALUE ##PHYS-UNIXLP       PERFORM ATTRIBUTES-UNIXLP
  VALUE ##PHYS-NATUNIX      PERFORM ATTRIBUTES-NATUNIX
  VALUE ##PHYS-DISKUNIX     PERFORM ATTRIBUTES-DISKUNIX
/*SU3  VALUE ##PHYS-BS2          PERFORM ATTRIBUTES-BS2
  VALUE ##PHYS-EMAIL        PERFORM ATTRIBUTES-EMAIL
  VALUE ##PHYS-WRTSPOOL PERFORM ATTRIBUTES-WRTSPOOL
  VALUE ##PHYS-DUMMY IGNORE
  ANY
    IF NOT ( EOMPHM-PRINTER-TYPE = ##PHYS-CMASPOOL OR=##PHYS-NAF
    OR=##PHYS-UNIXLP OR=##PHYS-NATUNIX OR=##PHYS-DISKUNIX             /*
    OR=##PHYS-EMAIL OR=##PHYS-WRTSPOOL)                               /*
      EOMPHM-ESCAPE-CHAR := '&'
    END-IF
  NONE  PERFORM ATTRIBUTES-VTAM
*
END-DECIDE
IF EOMPHM-PRINTER-TYPE = ##PHYS-DUMMY
  #I:=##PHYS-MAX-TYPES
ELSE
  EXAMINE ##PHYS-TYPES (*) FOR EOMPHM-PRINTER-TYPE GIVING INDEX #I
END-IF
IF #I NE 0
  EOMPHM-PRINT-PGM := ##PHYS-PRINT-PGM (#I)
END-IF
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE ATTRIBUTES-EMAIL
************************************************************************
RESET  EOMPHM-JCL-SKELETON EOMPHM-ESCAPE-CHAR EOMPHM-ATTRIBUTES (*)
FOR #I 1 #EMAIL-VARS
  EOMPHM-ATTR-IDENT (#I) := #I
  EOMPHM-ATTR-L-P-V (#I) := #EMAIL-L-P-V (#I)
END-FOR
*
END-SUBROUTINE /* ATTRIBUTES-EMAIL
*
/*SU3 DEFINE SUBROUTINE ATTRIBUTES-BS2
/*SU3 DEFINE SUBROUTINE ATTRIBUTES-SYSPR-PWR
/*SU3 DEFINE SUBROUTINE ATTRIBUTES-TAPE-VSE
*
************************************************************************
DEFINE SUBROUTINE ATTRIBUTES-SYSPR-JES
************************************************************************
EOMPHM-JCL-SKELETON := 'SYSPRJES'
RESET EOMPHM-ATTRIBUTES (*)
FOR #I 1 #JES-VARS
  EOMPHM-ATTR-IDENT (#I) := #I
  EOMPHM-ATTR-L-P-V (#I) := #JES-L-P-V (#I)
END-FOR
*
END-SUBROUTINE /* ATTRIBUTES-SYSPR-JES
*
************************************************************************
DEFINE SUBROUTINE ATTRIBUTES-VTAM
************************************************************************
RESET  EOMPHM-JCL-SKELETON EOMPHM-ESCAPE-CHAR EOMPHM-ATTRIBUTES (*)
FOR #I 1 #VTAM-VARS
  EOMPHM-ATTR-IDENT (#I) := #I
  EOMPHM-ATTR-L-P-V (#I) := #VTAM-L-P-V (#I)
  DECIDE ON FIRST VALUE EOMPHM-ATTR-VAR (#I)
    VALUE 'CONTROL'
      EOMPHM-ATTR-DEFAULT (#I) := 'YES'
    VALUE 'FEED-BEFORE'
      EOMPHM-ATTR-DEFAULT (#I) := '0'
    VALUE 'FEED-AFTER'
      EOMPHM-ATTR-DEFAULT (#I) := '0'
    VALUE 'TRACE'
      EOMPHM-ATTR-DEFAULT (#I) := 'NO'
    NONE IGNORE
  END-DECIDE
END-FOR
*
END-SUBROUTINE /* ATTRIBUTES-VTAM
*
************************************************************************
DEFINE SUBROUTINE ATTRIBUTES-TAPE-MVS
************************************************************************
EOMPHM-JCL-SKELETON := 'TAPEMVS'
RESET EOMPHM-ATTRIBUTES (*)
FOR #I 1 #TAPEMVS-VARS
  EOMPHM-ATTR-IDENT (#I) := #I
  EOMPHM-ATTR-L-P-V (#I) := #TAPEMVS-L-P-V (#I)
END-FOR
*
END-SUBROUTINE /* ATTRIBUTES-TAPE-MVS
*
************************************************************************
DEFINE SUBROUTINE ATTRIBUTES-DISK-MVS
************************************************************************
EOMPHM-PRINT-PGM    := 'RMPRWKF'
EOMPHM-JCL-SKELETON := 'DISKMVS'
RESET EOMPHM-ATTRIBUTES (*)
FOR #I 1 #DISKMVS-VARS
  EOMPHM-ATTR-IDENT (#I) := #I
  EOMPHM-ATTR-L-P-V (#I) := #DISKMVS-L-P-V (#I)
END-FOR
*
END-SUBROUTINE /* ATTRIBUTES-DISK-MVS
*
************************************************************************
