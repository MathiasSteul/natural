* >Natural Source Header 000000
* :Mode R
* :CP
* :LineIncrement 10
* <Natural Source Header
* COPY CODE TO BUILD TOP/BOT LINE
*
IF G-NATRP-ERC = 0
   DECIDE FOR EVERY CONDITION
     WHEN #END-OF-DATA               G-NATRP-ERC := 12 /* bottom of data
     WHEN #END-OF-DATA AND #CP = 1   G-NATRP-ERC := 14 /* all
     WHEN NOT #END-OF-DATA AND #CP=1 G-NATRP-ERC := 11 /* top of data
     WHEN NONE                       G-NATRP-ERC := 13 /* more
   END-DECIDE
END-IF
SET CONTROL 'M21'
