* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* LASTDAY ???
************************************************************************
*
DEFINE DATA PARAMETER
1 P-MONTH(N2)
1 P-YEAR(N4)
1 LAST-DAY(D)
************************************************************************
LOCAL
1 MONTH             (N2)
1 YEAR              (N4)
1 #DATE-A           (A8)
1 REDEFINE #DATE-A
  2 #DATE-DD        (N2)
  2 #DATE-MM        (N2)
  2 #DATE-YYYY      (N4)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
MONTH := P-MONTH
YEAR  := P-YEAR
*
IF MONTH = 12
  MONTH := 1
  ADD 1 TO YEAR
ELSE
  ADD 1 TO MONTH
END-IF
#DATE-MM   :=  MONTH
#DATE-YYYY :=  YEAR
#DATE-DD   :=  1
MOVE EDITED #DATE-A TO LAST-DAY(EM=DDMMYYYY)
SUBTRACT 1 FROM LAST-DAY
*
END
