* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member       EOMPHSRN
* Function     Sort printer attributes by variable
* Version      1.3
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* mrs 94-10-28 s(999999) old version saved, sort statement replaced
* fhi 02-10-30 fhi101    switch on optimizer compiler
* SU1     2016-07-25 NOMALL-1518 NOM3.5 deactivate opt.Compiler
* ----------------------------------------------------------------------
/*SU1 OPTIONS MCG=(INDX=ON,OVFLW=ON,DIGTCHCK=ON) /*fhi101 inserted
DEFINE DATA PARAMETER
*
1 P-ATTRIBUTES          (A95/1:25)
1 REDEFINE P-ATTRIBUTES
  2 P-ATTR-TAB          (1:25)
    3 #ATTR-FIL         (A7)
    3 #ATTR-VAR         (A16)
    3 #ATTR-VAL         (A72)
*
LOCAL
1 #I                    (I4)
1 #J                    (I4)
1 #K                    (I4)
1 #L                    (I4)
1 #TEMP-ATTR            (A95)
1 IS-SORTED             (L) INIT <TRUE>
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
FOR #K = 25 TO 1 STEP -1
  IF P-ATTRIBUTES (#K) NE ' '
    ESCAPE BOTTOM
  END-IF
END-FOR
*
IF #K > 1
  #L := #K - 1
  FOR #I = 1 TO #K
    RESET INITIAL IS-SORTED
    FOR #J = 1 TO #L
      IF #ATTR-VAR (#J) > #ATTR-VAR (#J+1)
        #TEMP-ATTR := P-ATTRIBUTES (#J+1)
        P-ATTRIBUTES (#J+1) := P-ATTRIBUTES (#J)
        P-ATTRIBUTES (#J) := #TEMP-ATTR
        IS-SORTED := FALSE
      END-IF
    END-FOR
    SUBTRACT 1 FROM #L
    IF IS-SORTED
      ESCAPE BOTTOM
    END-IF
  END-FOR
END-IF
*
END
