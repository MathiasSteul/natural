* <Natural Source Header
***********************************************************#************
* RMEXPBR - Export Bundle_Report
*
* Maintenance
* User  yyyy-mm-dd Issue       Remark
* ----- ---------------------- -----------------------------------------
*       2019-02-22 generated   Created for RMIMPORT from RMXML2LD
* fhi   2019-02-20 NOMALL-2215 Add object type MF Node: NO /rewritten
* SU1   2015-09-15 NOMALL-1693 NAT00059(A80)->NAT41002(A253)
* fhi   2019-02-19 NOMALL-2215 Export not complete
* BLI   2019-05-06 NOMALL-2261 Recataloged due to changes of XXUX---P
* SU2   2020-11-10 NOMALL-2440 split DDM -> NRM-MF-NODES
* SU3   2021-02-18 NOMALL-2443 restruct+MSG
* GGS01 2021-07-06 NOMALL-2474 RECAT since RMEXP-C changed
* SU4   2021-08-18 NOMALL-2467 RMEXPBRL
************************************************************************
DEFINE DATA
PARAMETER USING XXUX---P
PARAMETER USING RMEXP-A
PARAMETER
1 #TRACING               (L)
1 #ID                    (A250) BY VALUE OPTIONAL
/***********************************************************************
INDEPENDENT
1 +ID                    (A/*) DYNAMIC
1 +ID-INDEX              (I2)
/***********************************************************************
/*SU4 LOCAL USING RMEXPBRL
LOCAL USING RMBAS64P
LOCAL USING VUXDEF-L
/*SU2 LOCAL USING VMONITUL /* NOMALL-2215 fhi in
LOCAL USING N-41002L /*SU1
/***********************************************************************
LOCAL
1 BR VIEW OF NRM-BUNDLE-REPORT /*SU4 was RMEXPBRL
  2 BR-OBJECT-TYPE       (A10)
  2 BR-OBJECT-TIME       (T)
  2 BR-BUNDLE-REPORT     (A50)
  2 BR-BUNDLE            (A25)
  2 BR-REPNAME           (A25)
  2 BR-PRINTER           (A8)
  2 BR-GROUP             (A8)
  2 BR-SEQNO             (P3)
  2 BR-SEPNO             (P3)
  2 BR-REPNO             (P3)
  2 BR-PAGEDEF           (A8)
  2 BR-FORMDEF           (A8)
1 WRITE-FILE VIEW OF WRITE-FILE
  2 ERROR-CODE
  2 ERROR-TEXT
*
1 #FIELD                 (A32)
1 #VALUE                 (A300)
1 #LEN                   (I4)
1 #WORK-LINE             (A250)
1 #FUNCTION              (A10)
1 #I                     (I4)
1 #J                     (I4)
1 #K                     (I4)
1 #PROGRAM               (A8) INIT <*PROGRAM>
1 REDEFINE #PROGRAM
  2 FILLER               5X /*RMEXP
  2 #TYPE                (A2)
1 #KEY                   (A100)
1 #KEY-FROM              (A100)
1 #KEY-TO                (A100) INIT FULL LENGTH <H'FF'>
1 #KEY-MASK              (A25)
/*SU4 1 #KEY-LEN               (I2)
1 #KEY-LEN2              (I2) CONST <25> /*full len BR-BUNDLE SU4
1 #TRACE-MSG             (A250)
1 #IND                   (I4)
1 #POS                   (I4)
1 #DEP                   (A5)
1 #NODE                  (N5)
1 #ID-MEMBER             (A) DYNAMIC
1 #EXPORT-PROG           (A8)
1 #MASK                  (A300) INIT FULL LENGTH <'P'>
1 #PRINTABLE             (A300)
1 #BR-OBJECT-TIME        (A21)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
PERFORM #START
READ BR BY BR-BUNDLE-REPORT = #KEY-FROM THRU #KEY-TO
  #KEY := BR-BUNDLE-REPORT
  PERFORM HANDLE-MASK
* Get depending objects:
  INCLUDE RMLD2XC1 'BR-BUNDLE' '''RMEXPBU'''
  INCLUDE RMLD2XC1 'BR-REPNAME' '''RMEXPRP'''
  COMPRESS '<BR depending="' #DEP '">' TO #WORK-LINE LEAVING NO
  PERFORM WRITE-XML
  IF #OD-LOG = 'Y'
    IF #ID SPECIFIED
      COMPRESS 'Exported: BR */' BR-BUNDLE-REPORT TO #TRACE-MSG
    ELSE
      COMPRESS 'Exported: BR /' BR-BUNDLE-REPORT TO #TRACE-MSG
    END-IF
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    END TRANSACTION
  END-IF
  MOVE EDITED BR.BR-OBJECT-TIME (EM=YYYY'-'MM'-'DD'-'HH':'II':'SS'.'T)
    TO #BR-OBJECT-TIME
  #FIELD := 'BR-OBJECT-TYPE'
  #VALUE :=  BR.BR-OBJECT-TYPE
  PERFORM CONVERT-XML
  #FIELD := 'BR-OBJECT-TIME'
  #VALUE :=  #BR-OBJECT-TIME
  PERFORM CONVERT-XML
  #FIELD := 'BR-BUNDLE-REPORT'
  #VALUE :=  BR.BR-BUNDLE-REPORT
  PERFORM CONVERT-XML
  #FIELD := 'BR-BUNDLE'
  #VALUE :=  BR.BR-BUNDLE
  PERFORM CONVERT-XML
  #FIELD := 'BR-REPNAME'
  #VALUE :=  BR.BR-REPNAME
  PERFORM CONVERT-XML
  #FIELD := 'BR-PRINTER'
  #VALUE :=  BR.BR-PRINTER
  PERFORM CONVERT-XML
  #FIELD := 'BR-GROUP'
  #VALUE :=  BR.BR-GROUP
  PERFORM CONVERT-XML
  #FIELD := 'BR-SEQNO'
  #VALUE :=  BR.BR-SEQNO
  MOVE LEFT #VALUE TO #VALUE
  PERFORM CONVERT-XML
  #FIELD := 'BR-SEPNO'
  #VALUE :=  BR.BR-SEPNO
  MOVE LEFT #VALUE TO #VALUE
  PERFORM CONVERT-XML
  #FIELD := 'BR-REPNO'
  #VALUE :=  BR.BR-REPNO
  MOVE LEFT #VALUE TO #VALUE
  PERFORM CONVERT-XML
  #FIELD := 'BR-PAGEDEF'
  #VALUE :=  BR.BR-PAGEDEF
  PERFORM CONVERT-XML
  #FIELD := 'BR-FORMDEF'
  #VALUE :=  BR.BR-FORMDEF
  PERFORM CONVERT-XML
*
  PERFORM #END-OBJ
END-READ
PERFORM #END
*
INCLUDE RMEXP-C /*CALL-NPR, WRITE-XML, OPEN-XML, CLOSE-XML, WRITE-XML
*
END
