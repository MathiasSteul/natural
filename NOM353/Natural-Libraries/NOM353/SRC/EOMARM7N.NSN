* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* EOMARM7N - Convert job numbers of 5 digit to 7 digit format
*
* Creation and Maintenance History
* uuu yy-mm-dd s(999999) ...
* fhi     2005-04-21 s(999999) created from RMSPL7-N
* xsetggr 2007-07-11 NOM3201   converting node numbers to 5 byte format
* fhi     2007-07-12 NOM3202   C-NATERR changed, NAD23006 is obsolete.
* xsetggr 2008-05-05 p(304350) Restow due changes in EOMARM-P
* fhi     2009-05-20 N3463     Restow due changes in EOMARM-P
* fhi     2009-08-17 P319465   Spool parameter shifted, rewritten.
* xsetggr 2009-10-09 P320826   correct if Power segments field is blank
* fhi     2010-09-03 NOMALL-97 Extend message line
* fhi     2010-09-21 NOMALL-97 Use no more C-NATERR but C-NATERN instead
* SU1     2024-03-07 ES-34613  NOM 3.6 Remove power
* ----------------------------------------------------------------------
*
DEFINE DATA
PARAMETER
1 SPOOL-ATTRIB         (A248)
1 P-SPOOLTYPE          (I2)
************************************************************************
LOCAL USING RMSR---E
LOCAL USING EOMARM-P
LOCAL USING EOMARM3P
LOCAL USING EOMARM5P
LOCAL
1 P-ERC                (N4)
1 P-ERT                (A250)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
EOMAR3-SPOOL := EOMAR5-SPOOL := EOMARM-SPOOL := SPOOL-ATTRIB
DECIDE ON FIRST VALUE OF P-SPOOLTYPE
/*SU1  VALUE POWER ...
  VALUE JES2,JES3
    IF EOMARM-SPOOL-JES-NODE-A NE MASK(NNNNN) /* IF equal, NOM 3.2 fm
      RESET EOMARM-SPOOL
      IF EOMAR3-SPOOL-JES-JOB-NUMBER-A NE MASK(NNNNNNN)
        EOMARM-SPOOL-JES-NODE        := EOMAR5-SPOOL-JES-NODE
        EOMARM-SPOOL-JES-JOB-NAME    := EOMAR5-SPOOL-JES-JOB-NAME
        EOMARM-SPOOL-JES-JOB-NUMBER  := EOMAR5-SPOOL-JES-JOB-NUMBER
        EOMARM-SPOOL-JES-DSTYPE      := EOMAR5-SPOOL-JES-DSTYPE
        EOMARM-SPOOL-JES-DSNO-OLD    := EOMAR5-SPOOL-JES-DSNO-OLD
        EOMARM-SPOOL-JES-DATASET-KEY := EOMAR5-SPOOL-JES-DATASET-KEY
        EOMARM-SPOOL-JES-GROUP-ID    := EOMAR5-SPOOL-JES-GROUP-ID
        EOMARM-SPOOL-JES-PROCNAME    := EOMAR5-SPOOL-JES-PROCNAME
        EOMARM-SPOOL-JES-STEPNAME    := EOMAR5-SPOOL-JES-STEPNAME
        EOMARM-SPOOL-JES-DDNAME      := EOMAR5-SPOOL-JES-DDNAME
        EOMARM-SPOOL-JES-CHARS       := EOMAR5-SPOOL-JES-CHARS
        EOMARM-SPOOL-JES-FCB         := EOMAR5-SPOOL-JES-FCB
        EOMARM-SPOOL-JES-FLASH       := EOMAR5-SPOOL-JES-FLASH
        EOMARM-SPOOL-JES-FORM        := EOMAR5-SPOOL-JES-FORM
        EOMARM-SPOOL-JES-FORMDEF     := EOMAR5-SPOOL-JES-FORMDEF
        EOMARM-SPOOL-JES-PAGEDEF     := EOMAR5-SPOOL-JES-PAGEDEF
        EOMARM-SPOOL-JES-TRC         := EOMAR5-SPOOL-JES-TRC
        EOMARM-SPOOL-JES-RECFM       := EOMAR5-SPOOL-JES-RECFM
        EOMARM-SPOOL-JES-COPIES      := EOMAR5-SPOOL-JES-COPIES
        EOMARM-SPOOL-JES-UCS         := EOMAR5-SPOOL-JES-UCS
        EOMARM-SPOOL-JES-BURST       := EOMAR5-SPOOL-JES-BURST
        EOMARM-SPOOL-JES-COMPACT     := EOMAR5-SPOOL-JES-COMPACT
        EOMARM-SPOOL-JES-LINECT      := EOMAR5-SPOOL-JES-LINECT
        EOMARM-SPOOL-JES-DESTINATION := EOMAR5-SPOOL-JES-DESTINATION
        EOMARM-SPOOL-JES-TRIGGER-DSNAME:=EOMAR5-SPOOL-JES-TRIGGER-DSNAME
        EOMARM-SPOOL-JES-DSNO        := EOMAR5-SPOOL-JES-DSNO
      ELSE
        EOMARM-SPOOL-JES-NODE        := EOMAR3-SPOOL-JES-NODE
        EOMARM-SPOOL-JES-JOB-NAME    := EOMAR3-SPOOL-JES-JOB-NAME
        EOMARM-SPOOL-JES-JOB-NUMBER  := EOMAR3-SPOOL-JES-JOB-NUMBER
        EOMARM-SPOOL-JES-DSTYPE      := EOMAR3-SPOOL-JES-DSTYPE
        EOMARM-SPOOL-JES-DSNO-OLD    := EOMAR3-SPOOL-JES-DSNO-OLD
        EOMARM-SPOOL-JES-DATASET-KEY := EOMAR3-SPOOL-JES-DATASET-KEY
        EOMARM-SPOOL-JES-GROUP-ID    := EOMAR3-SPOOL-JES-GROUP-ID
        EOMARM-SPOOL-JES-PROCNAME    := EOMAR3-SPOOL-JES-PROCNAME
        EOMARM-SPOOL-JES-STEPNAME    := EOMAR3-SPOOL-JES-STEPNAME
        EOMARM-SPOOL-JES-DDNAME      := EOMAR3-SPOOL-JES-DDNAME
        EOMARM-SPOOL-JES-CHARS       := EOMAR3-SPOOL-JES-CHARS
        EOMARM-SPOOL-JES-FCB         := EOMAR3-SPOOL-JES-FCB
        EOMARM-SPOOL-JES-FLASH       := EOMAR3-SPOOL-JES-FLASH
        EOMARM-SPOOL-JES-FORM        := EOMAR3-SPOOL-JES-FORM
        EOMARM-SPOOL-JES-FORMDEF     := EOMAR3-SPOOL-JES-FORMDEF
        EOMARM-SPOOL-JES-PAGEDEF     := EOMAR3-SPOOL-JES-PAGEDEF
        EOMARM-SPOOL-JES-TRC         := EOMAR3-SPOOL-JES-TRC
        EOMARM-SPOOL-JES-RECFM       := EOMAR3-SPOOL-JES-RECFM
        EOMARM-SPOOL-JES-COPIES      := EOMAR3-SPOOL-JES-COPIES
        EOMARM-SPOOL-JES-UCS         := EOMAR3-SPOOL-JES-UCS
        EOMARM-SPOOL-JES-BURST       := EOMAR3-SPOOL-JES-BURST
        EOMARM-SPOOL-JES-COMPACT     := EOMAR3-SPOOL-JES-COMPACT
        EOMARM-SPOOL-JES-LINECT      := EOMAR3-SPOOL-JES-LINECT
        EOMARM-SPOOL-JES-DESTINATION := EOMAR3-SPOOL-JES-DESTINATION
        EOMARM-SPOOL-JES-TRIGGER-DSNAME:=EOMAR3-SPOOL-JES-TRIGGER-DSNAME
        EOMARM-SPOOL-JES-DSNO        := EOMAR3-SPOOL-JES-DSNO
      END-IF
    END-IF
*
  VALUE SEQUENTIAL-FILE-BS2
    IF EOMARM-SPOOL-BS2-NODE-A NE MASK(NNNNN)
      EOMARM-SPOOL-BS2-NODE           := EOMAR5-SPOOL-BS2-NODE
      EOMARM-SPOOL-BS2-JOB-NAME       := EOMAR5-SPOOL-BS2-JOB-NAME
      EOMARM-SPOOL-BS2-USER-ID        := EOMAR5-SPOOL-BS2-USER-ID
      EOMARM-SPOOL-BS2-JOB-ID         := EOMAR5-SPOOL-BS2-JOB-ID
      EOMARM-SPOOL-BS2-ORIGINATOR-ID  := EOMAR5-SPOOL-BS2-ORIGINATOR-ID
      EOMARM-SPOOL-BS2-COPIES         := EOMAR5-SPOOL-BS2-COPIES
      EOMARM-SPOOL-BS2-FORM           := EOMAR5-SPOOL-BS2-FORM
      EOMARM-SPOOL-BS2-CHARS          := EOMAR5-SPOOL-BS2-CHARS
      EOMARM-SPOOL-BS2-DSNAME         := EOMAR5-SPOOL-BS2-DSNAME
      EOMARM-SPOOL-BS2-CONTROL-OPTION := EOMAR5-SPOOL-BS2-CONTROL-OPTION
      EOMARM-SPOOL-BS2-DESTINATION    := EOMAR5-SPOOL-BS2-DESTINATION
      EOMARM-SPOOL-BS2-DEVICE         := EOMAR5-SPOOL-BS2-DEVICE
      EOMARM-SPOOL-BS2-ROTATION       := EOMAR5-SPOOL-BS2-ROTATION
      EOMARM-SPOOL-BS2-DIA            := EOMAR5-SPOOL-BS2-DIA
      EOMARM-SPOOL-BS2-SIZE           := EOMAR5-SPOOL-BS2-SIZE
      EOMARM-SPOOL-BS2-RECFM          := EOMAR5-SPOOL-BS2-RECFM
      EOMARM-SPOOL-BS2-RECSIZE        := EOMAR5-SPOOL-BS2-RECSIZE
      EOMARM-SPOOL-BS2-BLKSIZE        := EOMAR5-SPOOL-BS2-BLKSIZE
      EOMARM-SPOOL-BS2-SECONDARY      := EOMAR5-SPOOL-BS2-SECONDARY
    END-IF
  ANY
    SPOOL-ATTRIB := EOMARM-SPOOL
  NONE IGNORE
*
END-DECIDE
*
************************************************************************
ON ERROR
************************************************************************
  P-ERC := 0021
  CALLNAT 'C-NATERN' P-ERT
  ESCAPE ROUTINE
*
END-ERROR
*
END
