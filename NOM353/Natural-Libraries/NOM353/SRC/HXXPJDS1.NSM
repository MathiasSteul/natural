INPUT          (     IP=OFF                                           /*
                                                                       )
 018T '- JES Data Set -'(YEI)
/
/
 001T 'you may specify the SYSOUT data sets to be selected'(TU)
/
 001T 'for the report by means of'(TU)
/
/
 003T '1.'(YEI)
 006T '<file-type> <file-sequence>'(TU)
/
 006T 'file type may be SM SO SI JL'(TU)
/
 007T 'ex.'(YEI)
 011T 'so 1'(TU)
/
 011T 'so 1:2'(TU)
/
/
 003T '2.'(YEI)
 006T '<procname>.<stepname>.<ddname>'(TU)
/
 006T 'where each part may be a pattern'(TU)
/
 006T 'ending with a star(*).'(TU)
/
 004T 'ex.'(YEI)
 008T 'proc1.step1.ddn*'(TU)
/
 008T '*.ste*.ddname1'(TU)
/
 008T 'step1.ddn* - means *.step1.ddn*'(TU)
/
 008T 'ddn*       - means *.*ddn*'(TU)
/
/
 003T '3.'(YEI)
 006T 'TYPE=AL'(TU)
/
 006T 'Include all SM and SO data sets.'(TU)
