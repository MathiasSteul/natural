* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* NOXXPP-N - Return data for transfer in transfer parm
*
* Maintenance:
* XSETGGR 2005-01-29   created
* SU1     2016-08-08 NOM 3.5: remove unused code
* fhi     2016-11-15 NOMALL-1961 Use new task IDs
* ------------------------------------------------------------------
DEFINE DATA
PARAMETER USING ESMCNT-A
PARAMETER USING ESMINP-A
************************************************************************
LOCAL USING NOXXTF-L
LOCAL
1 MONITOR VIEW OF NRM-MONITOR
  2 M-MONITOR-ID
  2 M-NATRPT-DBID-N5
  2 M-NATRPT-FNR-N5
1 #ES-MSG-PREF              (A7) INIT <'NOM'>
1 REDEFINE #ES-MSG-PREF
  2 #ES-MSG-NOM             (A3)
  2 #ES-MSG-NR              (N4)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
************************************************************************
ON ERROR
************************************************************************
  ES-RC := 1
  COMPRESS *PROGRAM 'ERROR' *ERROR-NR *ERROR-LINE TO ES-MSG-TXT
  ESCAPE ROUTINE
END-ERROR
* ------------------------------------------------------------------
RESET ES-RC
IF *MACHINE-CLASS NE 'PC'
  MONITOR.M-MONITOR-ID := F#MONITOR-TASK-ID1 (<>)
  FNDMO. FIND MONITOR WITH M-MONITOR-ID = MONITOR.M-MONITOR-ID
    IF NO RECORDS FOUND
      #ES-MSG-NR := 1516
      ESCAPE BOTTOM (FNDMO.)
    END-NOREC
    NOTF-DBID-FROM := M-NATRPT-DBID-N5
    NOTF-FNR-FROM := M-NATRPT-FNR-N5
  END-FIND
ELSE
  NOTF-DBID-FROM := 11
  NOTF-FNR-FROM  := 206
END-IF
ES-KEY-PARM(1) := NOTF-PARM-1
*
END
