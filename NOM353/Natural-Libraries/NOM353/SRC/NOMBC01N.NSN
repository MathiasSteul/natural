* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    NOMBC01N
* Function  Bundle contents maintenance
* Version   1.3.4
*
* Maintenance:
* uuu    yyyy-mm-dd s(999999) ....
* gw     1995-10-31 s(230704) created
* jvd    1998-09-14 p(164220) NAT23ÖNOM141
* fhi    2000-08-24 QA03     Use NAT23006 for error values
* xsethz  2000-09-06 (CE7461) Extend Report and Bundle Names
* sju 02-02-25 NOM221    New lfile for active data
* xsetggr 2007-05-18 p(289847) restore NOM lfile when error occurs
* fhi     2007-07-12 NOM3202   C-NATERR changed, NAD23006 is obsolete.
* xsetggr 2007-07-12 NOM3201   Support P11 format run numbers
* xsetggr 2008-06-17 p(300323) add next start values of func read-next
*                              add steplibs
* xsetggr 2008-12-05 p(300323) change adding of steplibs
* xsetggr 2009-02-10 P300323   delete steplib handling, use RGETLIB to
*                              get NOM library
* fhi    2010-09-21 NOMALL-97 Use no more C-NATERR but C-NATERN instead
* xsetggr 2012-08-09 NOMALL-1162 substitue variables in error msgs
* SU1     2014-11-12 NOMALL-1527 getting rid of coding for old versions
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER USING NOMBC--P
*
LOCAL USING EOM----E
LOCAL USING EOM----P
LOCAL USING EOMMSG-P
LOCAL USING NOMBC--E
LOCAL USING EOMBCM-P
LOCAL USING SATFNC3E
LOCAL USING SATLF02P
LOCAL USING RACTLF-A
*
LOCAL
1 #LFILE-CHANGED               (L)
1 #NOM-DBID                    (N5)
1 #NOM-FNR                     (N5)
1 #LFILE-ACTIVE-CHANGED        (L)
1 #NOM-DBID-ACTIVE             (N5)
1 #NOM-FNR-ACTIVE              (N5)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
/*SU1 IF NOMBC-NOMVERS < 21 NOMBC-BUNDLE := NOMBC-BUNDLE-V14
/*SU1   NOMBC-REPORT := NOMBC-REPORT-V14 END-IF
/*SU1 IF NOMBC-NOMVERS < 32 NOMBC-BUNDLE-RNB := NOMBC-BUNDLE-RNB-V31
/*SU1   NOMBC-REPORT-RNB := NOMBC-REPORT-RNB-V31 END-IF
RESET NOMBC-ERROR-CODE NOMBC-ERROR-TEXT
*
DECIDE FOR EVERY CONDITION
  WHEN NOMBC-NOM-FNR NE 0 AND NOMBC-NOM-DBID NE 0
    SATLF-LFILE := 206
    PERFORM GET-NOM-LFILE
    #NOM-DBID := SATLF-DBID-N5
    #NOM-FNR  := SATLF-FNR-N5
    PERFORM SET-NOM-LFILE
    #LFILE-CHANGED := TRUE
  WHEN SATLF-ERROR-CODE = 0
    PERFORM SET-ACTIVE-LFILE
  WHEN NOMBC-ERROR-CODE = 0
    PERFORM OBJECT-MAINTENANCE
  WHEN #LFILE-CHANGED
    SATLF-LFILE := 206
    PERFORM SET-OLD-NOM-LFILE
  WHEN #LFILE-ACTIVE-CHANGED
    SATLF-LFILE   := 91
    SATLF-DBID-N5 := #NOM-DBID-ACTIVE
    SATLF-FNR-N5  := #NOM-FNR-ACTIVE
    PERFORM SET-LFILE
  WHEN NONE
    IGNORE
END-DECIDE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE OBJECT-MAINTENANCE
************************************************************************
CALLNAT 'RGETLIB' EOM-LIBRARY
*
DECIDE ON FIRST NOMBC-FUNCTION
  VALUE NOMBC-FCT-READ-NEXT, NOMBC-FCT-READHOLD-NEXT, NOMBC-FCT-READHOLD
    RESET NOMBC-EOF
    EOM-FUNCTION        := NOMBC-FUNCTION
    EOMBCM-I-BUNDLE     := NOMBC-BUNDLE
    EOMBCM-I-BUNDLE-RNB := NOMBC-BUNDLE-RNB
    EOMBCM-I-REPORT     := NOMBC-REPORT
    EOMBCM-I-REPORT-RNB := NOMBC-REPORT-RNB
    PERFORM CALL-INTERNAL-API
    NOMBC-ATTRIBUTES (*) := EOMBCM-ATTRIBUTES (*)
    NOMBC-EOF            := EOMBCM-EOF
  VALUE NOMBC-FCT-MODIFY
    EOM-FUNCTION          := EOM-MODIFY
    EOMBCM-I-BUNDLE       := NOMBC-BUNDLE
    EOMBCM-I-BUNDLE-RNB   := NOMBC-BUNDLE-RNB
    EOMBCM-I-REPORT       := NOMBC-REPORT
    EOMBCM-I-REPORT-RNB   := NOMBC-REPORT-RNB
    EOMBCM-ATTRIBUTES (*) := NOMBC-ATTRIBUTES (*)
    PERFORM CALL-INTERNAL-API
  VALUE NOMBC-FCT-COMMIT
    EOM-FUNCTION := EOM-COMMIT
    PERFORM CALL-INTERNAL-API
  VALUE NOMBC-FCT-BACKOUT
    EOM-FUNCTION := EOM-BACKOUT
    PERFORM CALL-INTERNAL-API
  NONE  NOMBC-ERROR-CODE := 20
    PERFORM GET-ERR-TXT
END-DECIDE
*
END-SUBROUTINE /* OBJECT-MAINTENANCE
*
************************************************************************
DEFINE SUBROUTINE CALL-INTERNAL-API
************************************************************************
RESET EOMMSG-PARMS
CALLNAT 'EOMBCM-N' EOM-PARMS EOMBCM-PARMS EOMMSG-PARMS
IF EOMMSG-NR NE 0
  NOMBC-ERROR-CODE := EOMMSG-NR
  IF EOMMSG-TEXT = ' '
    PERFORM GET-ERR-TXT
  ELSE
    NOMBC-ERROR-TEXT := EOMMSG-TEXT
  END-IF
  ESCAPE ROUTINE
END-IF
*
END-SUBROUTINE /* CALL-INTERNAL-API
*
************************************************************************
DEFINE SUBROUTINE GET-NOM-LFILE
************************************************************************
SATLF-FUNCTION := 'GET'
CALLNAT SAT-GET-SET-LFILE SATLF-SATVERS SATLF-PARMS (*)
*
END-SUBROUTINE /* GET-NOM-LFILE
*
************************************************************************
DEFINE SUBROUTINE SET-LFILE
************************************************************************
SATLF-FUNCTION := 'SET'
CALLNAT SAT-GET-SET-LFILE SATLF-SATVERS SATLF-PARMS (*)
*
END-SUBROUTINE /* SET-LFILE
*
************************************************************************
DEFINE SUBROUTINE SET-NOM-LFILE
************************************************************************
SATLF-DBID-N5 := NOMBC-NOM-DBID
SATLF-FNR-N5  := NOMBC-NOM-FNR
PERFORM SET-LFILE
*
END-SUBROUTINE /* SET-NOM-LFILE
*
************************************************************************
DEFINE SUBROUTINE SET-OLD-NOM-LFILE
************************************************************************
SATLF-DBID-N5 := #NOM-DBID
SATLF-FNR-N5  := #NOM-FNR
*
PERFORM SET-LFILE
*
END-SUBROUTINE /* SET-OLD-NOM-LFILE
*
************************************************************************
DEFINE SUBROUTINE SET-ACTIVE-LFILE
************************************************************************
IF NOMBC-NOM-DBID-ACTIVE NE 0 AND NOMBC-NOM-FNR-ACTIVE NE 0
  SATLF-LFILE      := 91
  PERFORM GET-NOM-LFILE
  #NOM-DBID-ACTIVE := SATLF-DBID-N5
  #NOM-FNR-ACTIVE  := SATLF-FNR-N5
  SATLF-DBID-N5    := NOMBC-NOM-DBID-ACTIVE
  SATLF-FNR-N5     := NOMBC-NOM-FNR-ACTIVE
  PERFORM SET-LFILE
  #LFILE-ACTIVE-CHANGED:= TRUE
  ESCAPE ROUTINE
END-IF
RESET RACTLF-LOGGING
  RACTLF-ERROR-LOGGING
RACTLF-LFILE-1:= 91
RACTLF-LFILE-2:= 206
CALLNAT 'RACTLF-N'  RACTLF-PARMS
IF RACTLF-ERROR-CODE NE 0
  NOMBC-ERROR-CODE:= 4
  ESCAPE ROUTINE
END-IF
*
END-SUBROUTINE /* SET-ACTIVE-LFILE
*
************************************************************************
DEFINE SUBROUTINE GET-ERR-TXT
************************************************************************
NOMBC-ERROR-TEXT := F#GETMSG (<NOMBC-ERROR-CODE, EOMMSG-TOKEN(1:3)>)
*
END-SUBROUTINE /* GET-ERR-TXT
*
************************************************************************
ON ERROR
************************************************************************
  IF #LFILE-CHANGED
    SATLF-LFILE := 206
    PERFORM SET-OLD-NOM-LFILE
  END-IF
  IF #LFILE-ACTIVE-CHANGED
    SATLF-LFILE   := 91
    SATLF-DBID-N5 := #NOM-DBID-ACTIVE
    SATLF-FNR-N5  := #NOM-FNR-ACTIVE
    PERFORM SET-LFILE
  END-IF
  IF *ERROR-NR = 82
    WRITE *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II':'SS'.'T)
      'Missing NOM steplibs' //
      'Please call NOM steplib routine NOMGSTEP before call of NOM API.'
  END-IF
  NOMBC-ERROR-CODE := NOMBC-ERROR-TEXT := 21
  CALLNAT 'C-NATERN' NOMBC-ERROR-TEXT 'W'
  ESCAPE ROUTINE
END-ERROR
*
END
