DEFINE DATA LOCAL
1 #NAT-VERS-A10             (A10)
1 REDEFINE #NAT-VERS-A10
  2 #NAT-VV-N2              (N02)
1 PARMS-NAT91002
  2 EDITOR-FUNC             (A1)   INIT <'F'>  /* Set forced editor flag
  2 EDITOR-FLAG             (L)    INIT <TRUE> /* enable editor 2391 end
END-DEFINE
#NAT-VERS-A10 := *NATVERS
IF #NAT-VV-N2 GE 9
  CALLNAT 'NAT91002' PARMS-NAT91002
END-IF
END
