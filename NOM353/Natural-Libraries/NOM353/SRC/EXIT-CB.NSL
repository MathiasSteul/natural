DEFINE DATA LOCAL
/* >Natural Source Header 000000
/* :Mode S
/* :CP
/* <Natural Source Header
*  ---------------------------------------------------------------------
*   LDA    EXIT-CB
*
*  Maintenance
*  uuu yy-mm-dd s(999999) ...
*  xsiszha 2000-08-15 (CE7461)          Extend Report and Bundle Names
*  xsetggr 2007-05-18 NOM3201           Support 11 byte run number
*   SU1  2021-05-28 NOMALL-2454      remove    short DBID/FNR/NODE vars
*   SU2  2024-02-19 NOMALL-2489 more than      65535(FFFF) = B2 lines
*  ---------------------------------------------------------------------
1 EXIT-CB (A250) /* EXIT ROUTINE CONTROL BLOCK
1 REDEFINE EXIT-CB /* REDEF. BEGIN : EXIT-CB
  2 EX-REQ (A1) /* REQUEST: O/C/R/W/G
  2 EX-TYPE (A1) /* TYPE: B/E
  2 EX-SES (B1) /* SESSION NUMBER
  2 EX-UFLAG (A1) /* Y - USER DATA IS GIVEN
  2 EX-RTOP (B4) /* TOP RECORDS
  2 EX-RMAX (B4) /* MAXIMUM NUMBER OF RECORDS
  2 EX-RNUM (B4) /* # OF RECORDS IN THE FILE
  2 EX-RLEN (B2) /* RECORD LENGTH
  2 EX-BNUM (B4) /* # OF RECs IN BLOCK #SU2
  2 EX-ECODE (B2) /* ERROR CODE
  2 EX-SCOL (B2) /* START COLUMN
  2 EX-STYPE (A1) /* SCAN TYPE A - ABS. N - NORM.
  2 REDEFINE EX-STYPE /* REDEF. BEGIN : EX-STYPE
    3 EX-B-STYPE (B1)
  2 EX-SLEN (B1) /* SCAN LENGTH (FOR ABS.)
  2 EX-SFROM (B1) /* SCAN START COLUMN (FOR ABS.)
  2 EX-STO (B1) /* SCAN END COLUMN (FOR ABS.)
  2 EX-REPLACE (A1) /* C - CREATE, R - REPLACE
  2 EX-INPLACE (A1) /* Y - DO UPDATE IN PLACE
  2 EX-FFU2 (A1) /* FOR FUTURE USE
  2 EX-FFU3 (A1) /* FOR FUTURE USE
  2 EX-UDATA (A64) /* USER DATA
*  ---------------------------------------------------------------------
*  NOM Fields
*  ---------------------------------------------------------------------
  2 EX-FILE (A132)
  2 REDEFINE EX-FILE /* REDEF. BEGIN : EX-FILE
    3 EX-NRM-LOCATION (A1)
    3 EX-NRM-REPNAME (A25) /* (A17) xsiszha (CE7461)
    3 EX-NRM-REPRNB (P11) /* (P7) xsetggr NOM3201
    3 EX-NRM-MAXREC (P9)
    3 EX-NRM-LAYOUT (B21)
    3 REDEFINE EX-NRM-LAYOUT /* REDEF. BEGIN : EX-NRM-LAYOUT
      4 EX-NRM-HEAD (B1)
      4 EX-NRM-RANGES (10)
        5 EX-NRM-FCOL (B1)
        5 EX-NRM-TCOL (B1)
    3 EX-NRM-FROMLINE (P9)
    3 EX-NRM-TOLINE (P9)
    3 FILLER 2X /*SU1 was EX-NRM-DBID(P3)
    3 EX-NRM-ASA-CODE-ON (A1) /* MB 91-04-29 F(182)
    3 EX-NRM-LRECL (P3) /* GW 92-04-01
    3 EX-NRM-SOURCE-ISN (P10)
    3 EX-NRM-SOURCE-TYPE (I2)
    3 EX-NRM-SOURCE-CC-TYPE (I2)
    3 EX-NRM-SOURCE-IDENT (A49) /* (A51) xsetggr NOM3201
*  ---------------------------------------------------------------------
  2 REDEFINE EX-FILE
    3 EX-S-TYPE (A3) /* DATA SET TYPE
    3 EX-S-SYS (A1) /* SYSTEM ID
    3 EX-S-REPNAME (A25) /* (A17) xsiszha (CE7461)
    3 EX-S-REPRNB (P11) /* (P7) xsetggr NOM3201
    3 EX-S-MAXREC (P9)
    3 EX-JOBNAME (A8) /* JOB NAME
    3 EX-DSTYPE (A2) /* DATA SET NAME
    3 EX-DATASET-KEY (P7) /* DATA SET NAME
    3 EX-DSNO (P3) /* DATASET NUMBER
    3 FILLER 1X /*SU1 was EX-DBID(B1)
    3 FILLER 1X /*SU1 was EX-NODE(B1)
    3 EX-FROMLINE (B4)
    3 EX-TOLINE (B4)
    3 EX-S-LAYOUT (B26)
    3 EX-LRECL (P3) /* GW 92-04-01
* **End of LDA EXIT-CB **************************************************
END-DEFINE
