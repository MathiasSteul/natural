* <Natural Source Header
* NOAROP-N - NOM API Active Report Maintenance
*
* Maintenance:
* XSETGGR 2002-03-14  created
* XSETGGR 2002-08-08  add field archive-type
* XSETGGR 2002-09-25  changes check values of time variables
* XSETGGR 2002-10-23  new field AR-STYLEHEET-URL
* XSETGGR 2002-11-04  new field AR-REP-LONGREC
* XSETGGR 2002-11-14  use new parameter ES-APP-SERVER-LIBRARY
* XSETGGR 2003-01-14  changes
* XSETHZ  2003-08-11  USER-AUTODEF
* XSETGGR 2005-01-27  allow input expiration date in format yyyymmdd
* XSETGGR 2005-04-15  NOM3107 recat dues changes in pda NOAROP-A
*      FHI 2005-04-21  NOM3107  Support 7-byte job numbers
* XSETGGR 2005-11-28  P(271774) Support more than 40 power segments
* XSETGGR 2006-03-30  correct call of rmspl7-n
* XSETGGR 2007-03-22  replace call of ES...-N  to direct call of module
* XSETGGR 2007-03-26  change validation of expiration date
* xsetggr 2007-05-03 NOM3201 Support P11 format run numbers
* fhi     2007-07-12 NOM3202 C-NATERR changed, NAD23006 is obsolete.
* xsetggr 2008-01-17 NRT2768 show size of binary docs in kbytes
* xsetggr 2008-02-16 NRT2774 mark kocation of active report
* xsetggr 2008-02-24 add parm to RBINSZ-N
* xsetggr 2008-03-11 p(302778) change format of RBINSZ-N parms
* xsetggr 2008-03-17 NRT2422   spool attributes for direct-input type
* xsetggr 2008-05-05 p(304350) get size of binary docs from spool attr.
* XSETHZ  2008-07-23 p(307577) use full name of ES-APP-SERVER-LIBRARY
* XSETHZ  2008-11-03 p(306461) bin. size for unix
* XSETHZ  2008-11-03 p(304019) NAT = NAF
* XSETHZ  2008-11-25 p(304019) NAT/NAF date+time corrupted
* fhi     2009-05-20 N3463     Extend metadata
* XSETHZ  2009-07-16 P318575   Extend metadata
* XSETHZ  2009-10-27 N3460 OPO function METADATA = NGC OP Extended=MET
* fhi     2009-12-11 N3460   Use non-opo active-reports view for NOM321
* xsetggr 2009-12-18 N3460   get NOM version with NOMVI-2N
* xsetggr 2010-01-03 N3460   do not use NOAROP1N
* xsetggr 2010-01-05 N3460   insert test print to monitor log
* fhi     2010-02-24 N3460   Non-opo active-reports view only < NOM3300
*                            No tags entered for this change.
* XSETGGR 2010-03-01 P321493   CHECK FOLDER GRANTS AND OWNER FOLDER
*                              before functions on active reports
* xsetggr 2010-07-07 NOMALL-833 correct browse location flag
* fhi     2010-09-03 NOMALL-97 Extend message line
* fhi     2011-02-10 NOMALL-926 Correct Separator Linesize
* fhi     2011-02-17 NOMALL-926 Correct Separator Linesize
* XSETHZ  2010-12-15 NOMALL-907
* xsetggr 2011-03-03 NOMALL-953 correct get folder grants
* xsetggr 2012-02-01 NOMALL-1092 correct using folder grants
* XSETHZ  2012-01-27 NOMALL-1020
* xsetggr 2012-06-19 NOMALL-1163 correct validation of retention
* xsetggr 2012-06-19 NOMALL-1163 correct validation of retention
* xsetggr 2012-08-04 NOMALL-78   disable maintenance of long records
* bli     2012-09-15 NOMALL-94 Remove old version checks
* SU1     2013-02-26 NOMALL-1004 support PDF(binaryReports)+removeUnused
* fhi     2013-06-04 OPO-36    Fill field AR-ACTIVE
* XSETHZ  2013-05-23 NOMALL-1169
* fhi     2013-08-29 NOMALL-1288 Enhance error message 406
* SU2     2014-06-13 NOMALL-1281 show last update user (nothing done)
* SU3     2014-07-03 NOMALL-1279 fill fields for Adabas Vista
* fhi     2014-08-25 NOMALL-1475 Introduce formatter uniprint
* SU4     2014-10-22 NOMALL-1511 support long file name
* CF1     2014-12-15 NOMALL-1545 Provide creation date for act. reports
* fhi     2015-05-18 NOMALL-1552 Show real size, not base64 size
* SU5     2015-06-01 NOMALL-1552 Show size 1 (instead 0)
* SU6     2015-08-11 NOMALL-1690 XXHASH restructure
* SU7     2015-12-30 NOMALL-1722 XXHASH-P changed->recat
* SU8     2016-01-15 NOMALL-1802 do not update Adabas Vista fields
* SU9     2016-02-29 NOMALL-1722 support long path names
* fhi     2016-08-01 NOMALL-1748 Backout Report Formatting
* SU10     2018-02-12 NOMALL-1823 NOM 3.5: remove CONNECT
* CF2     2018-03-19 NOMALL-1823 NOM 3.5: remove Style
* CF3     2018-07-16 NOMALL-2123 Prevent non-printable chars via RPC
* CF4     2018-12-06 NOMALL-2187 Display code page in Active Reports
* CF5     2018-12-12 NOMALL-1848 Reset empty retention completely
* SU11    2020-04-01 NOMALL-2379 recat:VREP---L mod:Unix files A26-> A50
* HEB1    2020-09-28 NOMALL-2439 return error message to client/NOMLOG
* SU12    2024-03-07 ES-34613    NOM 3.6 Remove z/VSE
* ---------------------------------------------------------------------
DEFINE DATA
PARAMETER USING ESMCNT-A
PARAMETER USING ESMINP-A
PARAMETER 1 NOAR-PARM-AREA2 (A253/1:V)
* *****
LOCAL USING NOAROP-A
LOCAL USING VREP---L
LOCAL USING NADA2000
LOCAL USING NAD-MSG
LOCAL USING NAD-FLD
LOCAL USING RMSPL--L
LOCAL USING NOMODE-A
LOCAL USING NOARRO1A
LOCAL USING RMSR---E
LOCAL USING NOUSUP-L
LOCAL USING XXHASH-P
* *****
LOCAL
1 ACTIVE-REPORTS VIEW OF NRM-ACTIVE-REPORTS
  2 AR-ACTIVE
  2 AR-SEPMEM
  2 REDEFINE AR-SEPMEM
    3 AR-SEP-START (A8)
    3 AR-SEP-END (A8)
  2 AR-SEPNO
  2 AR-KEYWORDS (1:6)
  2 AR-REPNAME
  2 AR-REPRNB
  2 AR-EXPIRATION
  2 AR-RETENTION-ACTION
  2 AR-RETENTION-PERIOD
  2 AR-DESC
  2 AR-PROCESS-TIME
  2 AR-NUMBER-OF-LINES
  2 AR-CURRENT-LOCATION
  2 AR-CC-TYPE
  2 AR-RECORD-LENGTH
  2 AR-SPOOL-ATTRIBUTES
  2 REDEFINE AR-SPOOL-ATTRIBUTES
    3 AR-SPOOL-TYPE (I2)
    3 AR-SPOOL-ATTR (A248)
  2 AR-SPOOL-ATTR-EXTENDED (1:120)
  2 AR-USERID
  2 AR-ARCHIVE
  2 AR-ARCHIVE-RETENTION
  2 AR-ARCHIVE-DATE
  2 AR-ARCHIVE-DATA-SET
  2 AR-ARCHIVE-VOLSER (1:2)
  2 AR-REVIVE
  2 AR-REVIVE-EXPIRATION
  2 AR-REVIVE-DATE
  2 AR-REVIVE-RETENTION-PERIOD
  2 AR-ARCHIVE-TYPE
  2 AR-REMOTE-CODEPAGE                           /* CF4
/*  2 AR-STYLESHEET-URL                /* CF2
*
1 DATASET-REPORT VIEW OF NRM-DATASET-REPORT
  2 DR-EXPIRATION-DATE
  2 DR-EXPIRATION-DATE-ORIG
1 MONITOR VIEW OF NRM-MONITOR
  2 M-MONITOR-ID
  2 REDEFINE M-MONITOR-ID
    3 #NOMUSR               (A6)
    3 #NOMUSR-INTERFACE     (N3)
  2 M-CUSTOM-APPL           (1:5)
  2 REDEFINE M-CUSTOM-APPL
    3 #NOMUSR-ATTR-DEF       (20)
      4 #NOMUSR-ATTR-GRP
        5 #NOMUSR-TYPE       (A1)
        5 #NOMUSR-PROMPT     (A20)
        5 #NOMUSR-OFFSET     (N3)
        5 #NOMUSR-LENGTH     (N3)
        5 #NOMUSR-GENERIC    (A1)
        5 #NOMUSR-VAR        (A8)
        5 #NOMUSR-ORDER      (N2)
1 MA VIEW OF NRM-MAIL
  2 MA-USERID
  2 MA-FO-ID
1 FO VIEW OF NRM-FOLDER
  2 FO-ID
  2 FO-NAME
  2 FO-USER-ID
  2 FO-LINKED-FO-ID         (A10)
  2 REDEFINE FO-LINKED-FO-ID
    3 FO-LINKED-USER        (A8)
    3 FO-LINKED-ID          (B2)
1 US VIEW OF NRM-USERS
  2 USER-PROFILE
1 #ES-CONTROL               (A250)
1 #ES-INPUT-AREA            (A253/1:3)
1 #ES-MSG-PREF              (A7) INIT <'NOM'>
1 REDEFINE #ES-MSG-PREF
  2 #ES-MSG-NOM             (A3)
  2 #ES-MSG-NR              (N4)
1 #ES-MSG-FIELD             (A32)
1  REDEFINE #ES-MSG-FIELD
  2 #ES-MSG-FIELD-NAME      (A28)
  2 #ES-MSG-FIELD-INDEX     (N4)
  2 REDEFINE #ES-MSG-FIELD-INDEX
    3 #ES-MSG-FIELD-INDEX1  (N2)
    3 #ES-MSG-FIELD-INDEX2  (N2)
1 #ES-MSG-TXT               (A250)
1 #I                        (I2)
1 #J                        (I2)
1 #OCC                      (I2)
1 #ARCHIVE-RETENTION        (A5)
1 REDEFINE #ARCHIVE-RETENTION
  2 #ARET                   (A1/1:5)
1 REDEFINE #ARCHIVE-RETENTION
  2 #ARCHIVE-NUMBER         (N4)
  2 #ARCHIVE-FACTOR         (A1)
1 #DATE-A8                  (A8)
1 #DATE-IN                  (D)
1 #DATE-OUT                 (D)
1 #AR-REPORT-RNB            (A31)
1 REDEFINE #AR-REPORT-RNB
  2 #AR-REPNAME             (A25)
  2 #AR-REPRNB              (P11)
1 #RET-PERIOD               (A12)
1 REDEFINE #RET-PERIOD
  2 #RET-NUMBER             (N3)
  2 #RET-FACTOR             (A1)
  2 #RET-CALENDAR           (A8)
1 #SPOOL-TYPE-N3            (N3)
1 REDEFINE #SPOOL-TYPE-N3
  2 #NOMUSR-INTERFACE-A3    (A3)
1 #CHARS-IN                 (A20)
1 #ERROR-NUMBER             (N4)
1 REDEFINE #ERROR-NUMBER
  2 #ERROR-NUMBER-A         (A4)
1 #PARM-COUNT               (N1)
1 #ERC                      (N4)
1 #ERT                      (A250)
1 #TT                       (T)
1 #DATE-0                   (D)
1 #USER-LIB                 (A8)
1 #LIBRARY-ID               (A8)
1 #BIN-SIZE                 (I4)
1 #RUN-NUMBER               (P11)
1 #RECNUM                   (I4)
1 #A4                       (A4)
1 REDEFINE #A4
  2 #I4                     (I4)
1 #NAF-DATE-TIME            (A15)
1 REDEFINE #NAF-DATE-TIME
  2 #NAF-DATE               (A8)
  2 #NAF-TIME               (A7)
1 REDEFINE #NAF-DATE-TIME
  2 #NAF-TIMX               (T)
1 #TIME-A6                  (A6)
1 OOPO-PARMS
  2 OOPO-PARM-AREA          (A253/1:20)
  2 REDEFINE OOPO-PARM-AREA
    3 OOPO-METADATA         (A2500)
  2 REDEFINE OOPO-PARM-AREA
    3 OOPO-ATTR-EXTENDED    (A250/1:10)
1 #GRANTS                   (A1/6)
1 #GR-USER                  (A8)
1 #GR-NAME                  (A25)
1 #FO-USER-NAME             (A24)
1 REDEFINE #FO-USER-NAME
  2 #FO-USER                (A8)
  2 #FO-NAME                (A16)
1 #FO-ID-N                  (N5)
1 REDEFINE #FO-ID-N
  2 #FO-ID-A                (A5)
1 #SOURCE-EXIST             (L)
1 #S-USER-FO-ID             (A10)
1 REDEFINE #S-USER-FO-ID
  2 #S-USER                 (A8)
  2 #S-FO-ID                (B2)
1 #GR-FUNC                  (L)
1 #FO-USER-FO-ID            (A10)
1 REDEFINE #FO-USER-FO-ID
  2 #FO-USER-ID             (A8)
  2 #FO-ID                  (B2)
1 #DISPLAY                  (L)
1 #MODIFY                   (L)
1 #DELETE                   (L)
1 #ARC                      (L)
1 #REV                      (L)
1 #DATN8                    (N8)
1 REDEFINE #DATN8
  2 #YEAR                   (A4)
1 #CALENDAR-ID              (A12)
1 REDEFINE #CALENDAR-ID
  2 #CA-ID                  (A8)
  2 #CA-YEAR                (A4)
1 #NATRP-ERC                (N4)                         /* HEB1
1 #NATRP-ERT                (A250)                       /* HEB1
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#OCC := *OCC(NOAR-PARM-AREA2)
NOAR-PARM-AREA (1:#OCC) := NOAR-PARM-AREA2 (1:#OCC)
** ------------------------------------------------------------------
RESET ES-RC #TT #DATE-0
#DATN8   := *DATN
#CA-YEAR := #YEAR
NOMOD-PARMS := ES-SELECT
#LIBRARY-ID := ES-APP-SERVER-LIBRARY
#PARM-COUNT := ES-KEY-PARM-COUNT
#AR-REPRNB  := VAL(ES-KEY-PARM(#PARM-COUNT))
#PARM-COUNT := ES-KEY-PARM-COUNT - 1
#AR-REPNAME := ES-KEY-PARM(#PARM-COUNT)
#ES-CONTROL := ES-CONTROL
#ES-INPUT-AREA(*) := ES-INPUT-AREA(*)
*
IF ES-USER-TYPE NE 'A'
  FIND US WITH USER-ID = ES-USER
    PROFILE-STRING := USER-PROFILE
  END-FIND
  IF  ES-KEY-CODE(1) = 'FO'
    PERFORM GET-FOLDER-GRANTS
  END-IF
END-IF
*
DECIDE ON FIRST VALUE OF ES-FUNCTION
  VALUE 'OP','PP' /*SU1 NOMALL-1004 new value 'PP'
    DECIDE ON FIRST VALUE OF ES-EXTEND-FUNCTION
      VALUE ' '
        PERFORM READ-RECORD
      VALUE 'MET'
        PERFORM READ-META
      VALUE 'UPD'
        PERFORM UPDATE-RECORD
        IF ES-RC = 0
          END TRANSACTION
        END-IF
      VALUE 'CHK'
        PERFORM UPDATE-RECORD
      NONE VALUE IGNORE
    END-DECIDE
  NONE VALUE IGNORE
END-DECIDE
NOAR-PARM-AREA2 (1:#OCC) := NOAR-PARM-AREA (1:#OCC)
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
ON ERROR
************************************************************************
  ES-RC := 1
  ES-MSG-NR := *ERROR-NR
  COMPRESS *PROGRAM 'Natural error' *ERROR-NR 'in line' *ERROR-LINE
    TO ES-MSG-TXT
  ESCAPE ROUTINE
*
END-ERROR
*
************************************************************************
DEFINE SUBROUTINE READ-RECORD
************************************************************************
RESET NOAR-PARMS #ES-MSG-FIELD #ES-MSG-NR #BIN-SIZE
*
FNDAR. FIND ACTIVE-REPORTS WITH AR-REPORT-RNB = #AR-REPORT-RNB
  IF NO RECORDS FOUND
    #ES-MSG-NR := 0490 /* NOMALL-1288 was 0406
    ESCAPE BOTTOM (FNDAR.)
  END-NOREC
*
  IF ES-USER-TYPE NE 'A' AND  ES-USER NE AR-USERID
    PERFORM CHECK-OTHER-FOLDERS
    IF (NOT(PROF-AREPS ='P' OR='M' OR='D') OR NOT(#DISPLAY OR #GR-FUNC))
      #ES-MSG-NR := 0020
      PERFORM GET-MSG-TXT
      ESCAPE ROUTINE
    END-IF
  END-IF
/* read general attributes
  NOAR-REPNAME            := ACTIVE-REPORTS.AR-REPNAME
  NOAR-REPRNB             := ACTIVE-REPORTS.AR-REPRNB
  NOAR-MASTER-OWNER       := ACTIVE-REPORTS.AR-USERID
  NOAR-CURRENT-LOCATION   := ACTIVE-REPORTS.AR-CURRENT-LOCATION
  NOAR-KEYWORDS (1:3)     := ACTIVE-REPORTS.AR-KEYWORDS (1:3)
  /*
  IF ACTIVE-REPORTS.AR-RETENTION-PERIOD = ' '
    RESET NOAR-RETENTION-NUMBER NOAR-RETENTION-FACTOR
      NOAR-RETENTION-CALENDAR
  ELSE
    #RET-PERIOD := ACTIVE-REPORTS.AR-RETENTION-PERIOD
    NOAR-RETENTION-NUMBER   := #RET-NUMBER
    NOAR-RETENTION-FACTOR   := #RET-FACTOR
    NOAR-RETENTION-CALENDAR := #RET-CALENDAR
  END-IF
  IF NOAR-RETENTION-NUMBER GT 0 AND                        /* CF5 ->
      NOAR-RETENTION-FACTOR = ' ' AND NOAR-RETENTION-CALENDAR = ' '
    RESET NOAR-RETENTION-NUMBER
  END-IF                                                   /* CF5 <-
  /*
  NOAR-RETENTION-ACTION := ACTIVE-REPORTS.AR-RETENTION-ACTION
  IF ACTIVE-REPORTS.AR-CC-TYPE NE 0005
    NOAR-NUMBER-OF-LINES  := ACTIVE-REPORTS.AR-NUMBER-OF-LINES
  END-IF
  NOAR-RECORD-LENGTH    := ACTIVE-REPORTS.AR-RECORD-LENGTH
  NOAR-REMOTE-CODEPAGE  := ACTIVE-REPORTS.AR-REMOTE-CODEPAGE     /* CF4
/*  NOAR-STYLESHEET-URL   := ACTIVE-REPORTS.AR-STYLESHEET-URL    /* CF2
  DECIDE ON FIRST ACTIVE-REPORTS.AR-CC-TYPE
    VALUE 0001  NOAR-CC-TYPE := 'asa'
    VALUE 0003  NOAR-CC-TYPE := 'ebcdic'
    VALUE 0002  NOAR-CC-TYPE := 'machine'
    VALUE 0005  NOAR-CC-TYPE := 'binary'
    NONE VALUE  RESET NOAR-CC-TYPE
  END-DECIDE
  NOAR-EXPIRATION-DATE := AR-EXPIRATION
  IF ACTIVE-REPORTS.AR-PROCESS-TIME NE #TT
    MOVE EDITED ACTIVE-REPORTS.AR-PROCESS-TIME (EM=YYYYMMDD)
      TO #DATE-A8
    CALLNAT 'IODATE-N' 'M' 'L' #DATE-A8 NOAR-CREATION-DATE
      ES-DATE-FORMAT #ERC #ERT
    MOVE EDITED ACTIVE-REPORTS.AR-PROCESS-TIME (EM=HH':'II':'SS)
      TO NOAR-CREATION-TIME
  ELSE
    RESET NOAR-CREATION-DATE NOAR-CREATION-TIME
  END-IF
/* read archive attributes
  NOAR-ARCHIVE          := ACTIVE-REPORTS.AR-ARCHIVE
  NOAR-ARCHIVE-DATA-SET := ACTIVE-REPORTS.AR-ARCHIVE-DATA-SET
  IF AR-ARCHIVE-VOLSER (1) = ACTIVE-REPORTS.AR-ARCHIVE-VOLSER (2)
    NOAR-ARCHIVE-VOLSER (1) := ACTIVE-REPORTS.AR-ARCHIVE-VOLSER (1)
  ELSE
    NOAR-ARCHIVE-VOLSER (1:2) :=
      ACTIVE-REPORTS.AR-ARCHIVE-VOLSER (1:2)
  END-IF
  IF ACTIVE-REPORTS.AR-ARCHIVE-DATE NE #TT
    MOVE EDITED ACTIVE-REPORTS.AR-ARCHIVE-DATE (EM=YYYYMMDD)
      TO #DATE-A8
    CALLNAT 'IODATE-N' 'M' 'L' #DATE-A8 NOAR-ARCHIVE-DATE
      ES-DATE-FORMAT #ERC #ERT
    MOVE EDITED ACTIVE-REPORTS.AR-ARCHIVE-DATE (EM=HH':'II':'SS)
      TO NOAR-ARCHIVE-TIME
  ELSE
    RESET NOAR-ARCHIVE-DATE NOAR-ARCHIVE-TIME
  END-IF
  IF ACTIVE-REPORTS.AR-ARCHIVE-RETENTION = ' '
    RESET NOAR-ARCHIVE-NUMBER NOAR-ARCHIVE-FACTOR
  ELSE
    #ARCHIVE-RETENTION := ACTIVE-REPORTS.AR-ARCHIVE-RETENTION
    IF #ARCHIVE-RETENTION IS (N4)
      NOAR-ARCHIVE-FACTOR := 'D'
    ELSE
      EXAMINE #ARCHIVE-RETENTION FOR 'X' GIVING LENGTH IN #I
      NOAR-ARCHIVE-FACTOR := #ARET(#I)
      RESET  #ARET (#I)
    END-IF
    IF #ARCHIVE-RETENTION IS (N4)
      NOAR-ARCHIVE-NUMBER := VAL (#ARCHIVE-RETENTION)
    ELSE
      RESET  NOAR-ARCHIVE-NUMBER
    END-IF
  END-IF
  FIND REPORTS WITH R-REPNAME = #AR-REPNAME
  END-FIND
  IF ACTIVE-REPORTS.AR-DESC = ' '
    NOAR-DESC := REPORTS.R-DESC
  ELSE
    NOAR-DESC := ACTIVE-REPORTS.AR-DESC
  END-IF
  IF ACTIVE-REPORTS.AR-RECORD-LENGTH < REPORTS.R-SEPLENG
    NOAR-RECORD-LENGTH  := REPORTS.R-SEPLENG
  END-IF
  IF REPORTS.R-SEPLENG =0 AND NOAR-RECORD-LENGTH < 132 AND AR-SEPNO NE 0
      AND
  NOT (AR-SEP-START ='NONE' OR='KEIN'  AND AR-SEP-END ='NONE' OR='KEIN')
    NOAR-RECORD-LENGTH := 132
  END-IF
  IF ACTIVE-REPORTS.AR-ARCHIVE = '*' OR= 'R'
    FIND DATASET-REPORT WITH DR-REPORT-RNB = #AR-REPORT-RNB
      CALLNAT 'IODATE-N' 'M' 'L' DATASET-REPORT.DR-EXPIRATION-DATE
        NOAR-ARCHIVE-EXPIRATION ES-DATE-FORMAT #ERC #ERT
      CALLNAT 'IODATE-N' 'M' 'L' DATASET-REPORT.DR-EXPIRATION-DATE-ORIG
        NOAR-ARCHIVE-EXPIRATION-ORIG ES-DATE-FORMAT #ERC #ERT
    END-FIND
  END-IF
  NOAR-ARCHIVE-TYPE:= ACTIVE-REPORTS.AR-ARCHIVE-TYPE
  IF NOAR-ARCHIVE-TYPE = '0'
    RESET NOAR-ARCHIVE-TYPE
  END-IF
/* read revive attributes
  NOAR-REVIVE := ACTIVE-REPORTS.AR-REVIVE
  IF AR-REVIVE-RETENTION-PERIOD = ' '
    RESET NOAR-REVIVE-NUMBER NOAR-REVIVE-FACTOR NOAR-REVIVE-CALENDAR
  ELSE
    #RET-PERIOD := ACTIVE-REPORTS.AR-REVIVE-RETENTION-PERIOD
    NOAR-REVIVE-NUMBER   := #RET-NUMBER
    NOAR-REVIVE-FACTOR   := #RET-FACTOR
    NOAR-REVIVE-CALENDAR := #RET-CALENDAR
  END-IF
  IF ACTIVE-REPORTS.AR-REVIVE-DATE NE #TT
    MOVE EDITED ACTIVE-REPORTS.AR-REVIVE-DATE (EM=YYYYMMDD)
      TO #DATE-A8
    CALLNAT 'IODATE-N' 'M' 'L' #DATE-A8 NOAR-REVIVE-DATE
      ES-DATE-FORMAT #ERC #ERT
    MOVE EDITED ACTIVE-REPORTS.AR-REVIVE-DATE (EM=HH':'II':'SS)
      TO NOAR-REVIVE-TIME
  ELSE
    RESET NOAR-REVIVE-DATE NOAR-REVIVE-TIME
  END-IF
  IF ACTIVE-REPORTS.AR-REVIVE-EXPIRATION NE ' '
    /* Date formatting on client side
    NOAR-REVIVE-EXPIRATION := ACTIVE-REPORTS.AR-REVIVE-EXPIRATION
  END-IF
/* read spool attributes
  #SPOOL-ATTRIB := ACTIVE-REPORTS.AR-SPOOL-ATTR
  #SPOOL-TYPE := ACTIVE-REPORTS.AR-SPOOL-TYPE
  CALLNAT 'RMSPL7-N' #SPOOL-ATTRIBUTES ACTIVE-REPORTS.AR-SPOOL-TYPE
  ACTIVE-REPORTS.AR-SPOOL-ATTR := #SPOOL-ATTRIB
  NOAR-SPOOL := ACTIVE-REPORTS.AR-SPOOL-ATTR
****
  IF ACTIVE-REPORTS.AR-SPOOL-TYPE > 999 /*(N3)
    RESET NOAR-SPOOL-TYPE
  ELSE
    NOAR-SPOOL-TYPE := ACTIVE-REPORTS.AR-SPOOL-TYPE
  END-IF
  IF NOT (NOAR-SPOOL-TYPE = 100 THRU 199)
    RESET NOAR-NOMUSR-PROMPT(*) NOAR-NOMUSR-VALUE(*)
  END-IF
  DECIDE ON FIRST VALUE OF NOAR-SPOOL-TYPE
    VALUE DIRECT-INPUT        /* 17
      XXHASH-PARMS.P-SHORT-NAME := NOAR-DI-FILENAME
      PERFORM GET-LONGNAME
      NOAR-FILENAME-LONG := XXHASH-PARMS.P-LONG-NAME
*
      XXHASH-PARMS.P-SHORT-NAME := NOAR-DI-PATH
      PERFORM GET-LONGNAME
      NOAR-PATHNAME-LONG := XXHASH-PARMS.P-LONG-NAME
      IF ACTIVE-REPORTS.AR-CC-TYPE = 0005         /* binary
        PERFORM GET-BINARY-SIZE
        NOAR-NUMBER-OF-LINES := #BIN-SIZE
      END-IF
    VALUE SEQUENTIAL-FILE-UNIX
      XXHASH-PARMS.P-SHORT-NAME := NOAR-UX-FILENAME
      PERFORM GET-LONGNAME
      NOAR-FILENAME-LONG := XXHASH-PARMS.P-LONG-NAME
      IF ACTIVE-REPORTS.AR-CC-TYPE = 0005         /* binary
        PERFORM GET-BINARY-SIZE
        NOAR-NUMBER-OF-LINES := #BIN-SIZE
      END-IF
/* read NAF sool
    VALUE NAF,NAT
      IF NOAR-NAF-DBID-OLD NE 0 AND NOAR-NAF-FNR-OLD NE 0
        NOAR-NAF-DBID := NOAR-NAF-DBID-OLD
        NOAR-NAF-FNR  := NOAR-NAF-FNR-OLD
      END-IF
      MOVE SUBSTR(#SPOOL-ATTRIB,32,214) TO SUBSTR(NOAR-SPOOL,35,214)
      #NAF-DATE-TIME := #SPOOL-NAF-TIME
      IF #NAF-DATE = MASK(YYYYMMDD)
        #DATE-A8:= #NAF-DATE
        #TIME-A6:= #NAF-TIME
      ELSE
        IF #NAF-DATE-TIME NE ' ' AND #NAF-TIMX NE #TT
          MOVE EDITED #NAF-TIMX (EM=YYYYMMDD) TO #DATE-A8
          MOVE EDITED #NAF-TIMX (EM=HHIISS) TO #TIME-A6
        ELSE
          RESET NOAR-NAF-DATE NOAR-NAF-TIME #DATE-A8
        END-IF
      END-IF
      IF #DATE-A8 NE ' '
        CALLNAT 'IODATE-N' 'M' 'L' #DATE-A8
          NOAR-NAF-DATE ES-DATE-FORMAT #ERC #ERT
        IF #ERC = 0
          COMPRESS SUBSTR(#TIME-A6,1,2) ':' SUBSTR(#TIME-A6,3,2) ':'
            SUBSTR(#TIME-A6,5,2) TO NOAR-NAF-TIME LEAVING NO
        ELSE
          RESET NOAR-NAF-DATE NOAR-NAF-TIME
        END-IF
      END-IF
      /*
      /* Prevent sending non-printable chars via RPC      /* CF3 ->
      /* Field NOAR-NAF-ST-ID not used on client side
      /* (Redefine NOAR-NAF-ST-ID with NOAR-NAF-ST-ID-A(A6) )
      RESET NOAR-NAF-ST-ID-A                              /* CF3 <-
      /*
/* read JES spool
    VALUE JES2,JES3           /* 1,2
      IF NOAR-JES-DSNO = 0
        NOAR-JES-DSNO := NOAR-JES-DSNO-OLD
      END-IF
/*SU12 read POWER     VALUE POWER    /* 3
/*SU12 read SAP spool VALUE SAPSPOOL /* 15  XSETHZ
/* read NOM User spool
    VALUE  100 : 199
      #SPOOL-TYPE-N3 := NOAR-SPOOL-TYPE
      RESET NOAR-SPOOL
      COMPRESS 'NOMUSR' #NOMUSR-INTERFACE-A3 TO MONITOR.M-MONITOR-ID
        LEAVING NO
      FIND (1) MONITOR WITH M-MONITOR-ID = MONITOR.M-MONITOR-ID
        RESET #J SHORT-MSG LONG-MSG(*)
        VERSION := 0
        NADA2000.OBJECT-KIND := 'U'
        NADA2000.OPT-INSERT-DYN := FALSE
        NADA2000.OPT-LANGUAGE := ES-LANGUAGE
        COMPRESS #LIBRARY-ID 'U' TO #USER-LIB LEAVING NO
        NADA2000.LIBRARY := #USER-LIB
        FOR #I 1 20
          IF #NOMUSR-PROMPT (#I) NE ' '
            ADD 1 TO #J
            IF #NOMUSR-PROMPT (#I) = MASK (NNNN)
              #ERROR-NUMBER-A := #NOMUSR-PROMPT(#I)
              NADA2000.ERROR-NUMBER := #ERROR-NUMBER
              CALLNAT 'NATA2000' NADA2000 NATA2000.EXTENDED-PARMS
                NAD-MSG NAD-FLD
              NOAR-NOMUSR-PROMPT(#J) := SHORT-MSG
            ELSE
              NOAR-NOMUSR-PROMPT(#J) := #NOMUSR-PROMPT (#I)
            END-IF
            NOAR-NOMUSR-VALUE (#J) := SUBSTR (AR-SPOOL-ATTR ,
              #NOMUSR-OFFSET (#I) , #NOMUSR-LENGTH (#I))
          END-IF
        END-FOR
      END-FIND
    NONE VALUE IGNORE
  END-DECIDE
  NOAR-ATTR-EXTENDED(1:10) :=ACTIVE-REPORTS.AR-SPOOL-ATTR-EXTENDED(1:10)
END-FIND
IF #ES-MSG-NR NE 0
  PERFORM GET-MSG-TXT
END-IF
END-SUBROUTINE /* READ-RECORD
*
************************************************************************
DEFINE SUBROUTINE READ-META
************************************************************************
RESET OOPO-PARMS #ES-MSG-FIELD #ES-MSG-NR
*
FNDARO. FIND ACTIVE-REPORTS WITH AR-REPORT-RNB = #AR-REPORT-RNB
  IF NO RECORDS FOUND
    #ES-MSG-NR := 0490 /* NOMALL-1288 was 0406
    ESCAPE BOTTOM (FNDARO.)
  END-NOREC
  OOPO-ATTR-EXTENDED(1:10) :=
    ACTIVE-REPORTS.AR-SPOOL-ATTR-EXTENDED(1:10)
  NOAR-PARM-AREA(1:20) := OOPO-PARM-AREA(1:20)
END-FIND
IF #ES-MSG-NR NE 0
  PERFORM GET-MSG-TXT
END-IF
*
END-SUBROUTINE /* READ-META
*
************************************************************************
DEFINE SUBROUTINE UPDATE-RECORD
************************************************************************
FNDMOD. FIND ACTIVE-REPORTS WITH AR-REPORT-RNB = #AR-REPORT-RNB
  IF NO RECORDS FOUND
    #ES-MSG-NR := 0490 /* NOMALL-1288 was 0406
    ESCAPE BOTTOM (FNDMOD.)
  END-NOREC
  PERFORM VALIDATION-S
  IF #ES-MSG-NR > 0
    PERFORM GET-MSG-TXT
    ESCAPE BOTTOM(FNDMOD.)
  END-IF
  IF ES-EXTEND-FUNCTION = 'UPD'
/* modify general attributes
    GETMOD. GET ACTIVE-REPORTS *ISN(FNDMOD.)
    AR-REPNAME := NOAR-REPNAME
    AR-REPRNB  := NOAR-REPRNB
    AR-USERID  := NOAR-MASTER-OWNER
    AR-KEYWORDS (1:3) := NOAR-KEYWORDS (1:3)
    IF NOAR-RETENTION-NUMBER = 0 AND NOAR-RETENTION-FACTOR = ' ' AND
        NOAR-RETENTION-CALENDAR = ' '
      RESET AR-RETENTION-PERIOD
    ELSE
      #RET-NUMBER := NOAR-RETENTION-NUMBER
      #RET-FACTOR := NOAR-RETENTION-FACTOR
      #RET-CALENDAR := NOAR-RETENTION-CALENDAR
      AR-RETENTION-PERIOD := #RET-PERIOD
    END-IF
    AR-RETENTION-ACTION := NOAR-RETENTION-ACTION
    IF NOAR-EXPIRATION-DATE = ' '
      IF NOAR-RETENTION-ACTION = ' '
        RESET AR-EXPIRATION
      ELSE
        IF AR-RETENTION-PERIOD = ' '
          AR-RETENTION-PERIOD := '010A'
        END-IF
        #RET-PERIOD := AR-RETENTION-PERIOD
        IF #RET-NUMBER = 0
          #RET-NUMBER := 10
          AR-RETENTION-PERIOD := #RET-PERIOD
        END-IF
        #DATE-IN := *DATX
        CALLNAT 'RCOMED-N' #DATE-IN AR-RETENTION-PERIOD #DATE-OUT
        IF #DATE-OUT NE #DATE-0
          MOVE EDITED #DATE-OUT (EM=YYYYMMDD) TO #DATE-A8
          AR-EXPIRATION := #DATE-A8
          CALLNAT 'IODATE-N' 'M' 'L' AR-EXPIRATION
            NOAR-EXPIRATION-DATE ES-DATE-FORMAT #ERC #ERT
        END-IF
      END-IF
    ELSE
      IF NOAR-EXPIRATION-DATE = MASK(YYYYMMDD)
        AR-EXPIRATION := NOAR-EXPIRATION-DATE
      ELSE /* validate long format
        CALLNAT 'IODATE-N' 'V' 'L' AR-EXPIRATION NOAR-EXPIRATION-DATE
          ES-DATE-FORMAT #ERC #ERT
      END-IF
    END-IF
/*    AR-STYLESHEET-URL := NOAR-STYLESHEET-URL                   /* CF2
    IF AR-CC-TYPE = 0005
        AND (NOAR-SPOOL-TYPE = DIRECT-INPUT OR = SEQUENTIAL-FILE-UNIX)
      #SPOOL-ATTRIB := ACTIVE-REPORTS.AR-SPOOL-ATTR
      PERFORM GET-BINARY-SIZE
      AR-SPOOL-ATTR := #SPOOL-ATTRIB
    END-IF
/* modify archive attributes
    AR-ARCHIVE := NOAR-ARCHIVE
    IF AR-ARCHIVE = ' '
      AR-ACTIVE := 'X'
    ELSE
      RESET AR-ACTIVE
    END-IF
    IF NOT (AR-ARCHIVE = '*' OR = 'P' OR = 'R')
      IF NOAR-ARCHIVE-NUMBER = 0 AND NOAR-ARCHIVE-FACTOR = ' '
        RESET AR-ARCHIVE-RETENTION
      ELSE
        #ARCHIVE-NUMBER := NOAR-ARCHIVE-NUMBER
        #ARCHIVE-FACTOR := NOAR-ARCHIVE-FACTOR
        AR-ARCHIVE-RETENTION := #ARCHIVE-RETENTION
      END-IF
    END-IF
    IF NOAR-ARCHIVE-TYPE IS (N1)
      AR-ARCHIVE-TYPE := VAL(NOAR-ARCHIVE-TYPE)
    ELSE
      IF NOAR-ARCHIVE-TYPE = ' '
        RESET AR-ARCHIVE-TYPE
      END-IF
    END-IF
/* modify revive attributes
    RESET #RET-PERIOD
    AR-REVIVE := NOAR-REVIVE
    IF AR-REVIVE = '*'
      IF NOAR-REVIVE-EXPIRATION = ' '
        RESET AR-REVIVE-EXPIRATION
      ELSE
        IF NOAR-REVIVE-EXPIRATION = MASK(YYYYMMDD)
          AR-REVIVE-EXPIRATION := NOAR-REVIVE-EXPIRATION
        ELSE /* validate long format
          CALLNAT 'IODATE-N' 'V' 'L' AR-REVIVE-EXPIRATION
            NOAR-REVIVE-EXPIRATION ES-DATE-FORMAT #ERC #ERT
        END-IF
      END-IF
    ELSE
      IF NOAR-REVIVE-NUMBER = 0 AND NOAR-REVIVE-FACTOR = ' '
          AND NOAR-REVIVE-CALENDAR = ' '
        RESET AR-REVIVE-RETENTION-PERIOD
      ELSE
        #RET-NUMBER   := NOAR-REVIVE-NUMBER
        #RET-FACTOR   := NOAR-REVIVE-FACTOR
        #RET-CALENDAR := NOAR-REVIVE-CALENDAR
        AR-REVIVE-RETENTION-PERIOD := #RET-PERIOD
      END-IF
    END-IF
    UPDATE(GETMOD.)
  END-IF
  PERFORM MARK-LOCATION
END-FIND
IF #ES-MSG-NR > 0
  PERFORM GET-MSG-TXT
END-IF
ES-SELECT := #NOARRO1
ES-NEWNAME := #NOARRO1.#AR-EXIST
*
END-SUBROUTINE /* UPDATE-RECORD
*
************************************************************************
DEFINE SUBROUTINE VALIDATION-S
************************************************************************
PERFORM VALIDATION
ES-CONTROL := #ES-CONTROL
ES-INPUT-AREA(*) := #ES-INPUT-AREA(*)
*
END-SUBROUTINE /* VALIDATION-S
*
************************************************************************
DEFINE SUBROUTINE VALIDATION
************************************************************************
RESET #ES-MSG-NR #ES-MSG-FIELD
/* validation of general attributes
IF NOAR-MASTER-OWNER = ' '
  #ES-MSG-NR := 0002
  #ES-MSG-FIELD-NAME := 'MASTER-OWNER'
  ESCAPE ROUTINE
END-IF
IF NOT (NOMOD-USER-AUTODEF = 'P' OR = 'Y')
  ES-OBJECT := 'US'
  ES-FUNCTION := 'EX'
  ES-KEY-PARM(1) := NOAR-MASTER-OWNER
/* check user existance
  CALLNAT 'NOXXEX-N' ES-CONTROL ES-INPUT
  IF ES-RC NE 0
    #ES-MSG-NR := 0002
    #ES-MSG-FIELD-NAME := 'MASTER-OWNER'
    ESCAPE ROUTINE
  END-IF
END-IF
IF ES-EXTEND-FUNCTION = 'UPD' AND ES-USER-TYPE NE 'A' AND
    ES-USER NE AR-USERID
  PERFORM CHECK-OTHER-FOLDERS
  IF (NOT (PROF-AREPS = 'P' OR = 'M') OR
      NOT (#MODIFY OR #GR-FUNC))
    #ES-MSG-NR := 0020
  END-IF
END-IF
*
IF NOAR-RETENTION-NUMBER = 0 AND (NOAR-RETENTION-FACTOR NE ' '
OR NOAR-RETENTION-CALENDAR NE ' ' )                                   /*
  #ES-MSG-NR := 0415
  #ES-MSG-FIELD-NAME := 'RETENTION-NUMBER'
  ESCAPE ROUTINE
END-IF
*
IF NOAR-RETENTION-NUMBER > 0
  IF NOAR-RETENTION-CALENDAR NE ' '
    ES-OBJECT   := 'CA'
    ES-FUNCTION := 'EX'
    #CA-ID := NOAR-RETENTION-CALENDAR
    ES-KEY-PARM(1) := #CALENDAR-ID
/* check calendar existance
    CALLNAT 'NOXXEX-N' ES-CONTROL ES-INPUT
    IF ES-RC NE 0
      #ES-MSG-NR := 2004
      #ES-MSG-FIELD-NAME := 'RETENTION-CALENDAR'
      ESCAPE ROUTINE
    END-IF
    NOAR-RETENTION-FACTOR := 'W'
  END-IF
  IF NOT (NOAR-RETENTION-FACTOR = 'W' OR = 'A' OR = 'V' OR = 'M')
    #ES-MSG-NR := 0634
    #ES-MSG-FIELD-NAME := 'RETENTION-FACTOR'
    ESCAPE ROUTINE
  END-IF
END-IF
IF NOAR-RETENTION-FACTOR = 'W'
  IF NOAR-RETENTION-CALENDAR = ' '
    #ES-MSG-NR := 2003
    #ES-MSG-FIELD-NAME := 'RETENTION-CALENDAR'
    ESCAPE ROUTINE
  END-IF
ELSE
  RESET NOAR-RETENTION-CALENDAR
END-IF
IF NOAR-RETENTION-ACTION = ' ' OR NOAR-CURRENT-LOCATION = 'A'
  RESET NOAR-EXPIRATION-DATE NOAR-RETENTION-ACTION
ELSE
  IF NOT (NOAR-RETENTION-ACTION = ' ' OR = 'A' OR = 'P')
    #ES-MSG-NR := 1088
    #ES-MSG-FIELD-NAME := 'RETENTION-ACTION'
    ESCAPE ROUTINE
  END-IF
END-IF
IF NOAR-EXPIRATION-DATE NE MASK(YYYYMMDD)
    AND NOAR-EXPIRATION-DATE NE ' '
* Validate Long format:
  CALLNAT 'IODATE-N' 'V' 'L' #DATE-A8 NOAR-EXPIRATION-DATE
    ES-DATE-FORMAT #ES-MSG-NR #ES-MSG-TXT
  IF #ES-MSG-NR NE 0
    #ES-MSG-FIELD-NAME := 'EXPIRATION-DATE'
    ESCAPE ROUTINE
  END-IF
END-IF
/* validation of archive attributes
IF NOAR-ARCHIVE-NUMBER = 0 AND NOAR-ARCHIVE-FACTOR NE ' '
  #ES-MSG-NR := 0415
  #ES-MSG-FIELD-NAME := 'ARCHIVE-NUMBER'
  ESCAPE ROUTINE
END-IF
IF NOAR-ARCHIVE-NUMBER > 0
AND NOT (NOAR-ARCHIVE-FACTOR = 'D' OR = 'W' OR = 'M' OR = 'Y')        /*
  #ES-MSG-NR := 1083
  #ES-MSG-FIELD-NAME := 'ARCHIVE-FACTOR'
  ESCAPE ROUTINE
END-IF
/* validation of revive attributes
IF NOAR-REVIVE = '*'
  IF NOAR-REVIVE-EXPIRATION NE MASK(YYYYMMDD)
*   Validate Long format:
    CALLNAT 'IODATE-N' 'V' 'L' #DATE-A8 NOAR-REVIVE-EXPIRATION
      ES-DATE-FORMAT #ES-MSG-NR #ES-MSG-TXT
    IF #ES-MSG-NR NE 0
      #ES-MSG-FIELD-NAME := 'REVIVE-EXPIRATION'
      ESCAPE ROUTINE
    END-IF
  END-IF
ELSE
  RESET NOAR-REVIVE-EXPIRATION
END-IF
IF NOT (NOAR-REVIVE =' ' OR='*' OR='S' OR='D')
  #ES-MSG-NR := 0465
  #ES-MSG-FIELD-NAME := 'REVIVE'
  ESCAPE ROUTINE
END-IF
IF NOAR-REVIVE-NUMBER = 0
AND (NOAR-REVIVE-FACTOR NE ' ' OR NOAR-REVIVE-CALENDAR NE ' ' )       /*
  #ES-MSG-NR := 0415
  #ES-MSG-FIELD-NAME := 'REVIVE-NUMBER'
  ESCAPE ROUTINE
END-IF
IF NOAR-REVIVE-NUMBER > 0
  IF NOAR-REVIVE-CALENDAR NE ' '
    ES-OBJECT   := 'CA'
    ES-FUNCTION := 'EX'
    #CA-ID := NOAR-REVIVE-CALENDAR
    ES-KEY-PARM(1) := #CALENDAR-ID
/* check calendar existance
    CALLNAT 'NOXXEX-N' ES-CONTROL ES-INPUT
    IF ES-RC NE 0
      #ES-MSG-NR := 2004
      #ES-MSG-FIELD-NAME := 'REVIVE-CALENDAR'
      ESCAPE ROUTINE
    END-IF
    NOAR-REVIVE-FACTOR := 'W'
  END-IF
  IF NOT (NOAR-REVIVE-FACTOR = 'W' OR = 'A' OR = 'V' OR = 'M')
    #ES-MSG-NR := 0634
    #ES-MSG-FIELD-NAME := 'REVIVE-FACTOR'
    ESCAPE ROUTINE
  END-IF
END-IF
IF NOAR-REVIVE-FACTOR = 'W' AND NOAR-REVIVE-CALENDAR = ' '
  #ES-MSG-NR := 2003
  #ES-MSG-FIELD-NAME := 'REVIVE-CALENDAR'
  ESCAPE ROUTINE
END-IF
*
END-SUBROUTINE /* VALIDATION
*
************************************************************************
DEFINE SUBROUTINE MARK-LOCATION
************************************************************************
RESET #NOARRO1.#AR-EXIST
  #NATRP-ERC #NATRP-ERT                             /* HEB1
CALLNAT 'NOSRCK-N' #AR-REPNAME #AR-REPRNB #SOURCE-EXIST
  #NATRP-ERC #NATRP-ERT ES-USER (AD=O)                  /* HEB1
  ES-APP-SERVER-LIBRARY (AD=O)                          /* HEB1
IF #NATRP-ERC NE 0                                      /* HEB1 >
  ES-RC := 1
  ES-MSG-NR := #NATRP-ERC
  ES-MSG-TXT := #NATRP-ERT
  ESCAPE MODULE
END-IF                                                  /* HEB1 <
*
DECIDE ON FIRST VALUE OF AR-CURRENT-LOCATION
  VALUE 'A'  #NOARRO1.#ARCH    := '1'
  VALUE 'S'  #NOARRO1.#SPOOL   := '1'
  VALUE 'D'  #NOARRO1.#NOM     := '1'
  NONE VALUE IGNORE
END-DECIDE
IF AR-CURRENT-LOCATION = 'S' OR = 'D'
  #NOARRO1.#BROW := '1'
END-IF
*
END-SUBROUTINE /* MARK-LOCATION
*
************************************************************************
DEFINE SUBROUTINE GET-BINARY-SIZE
************************************************************************
RESET #BIN-SIZE #ERC #RECNUM
IF NOT (#SPOOL-DI-SIZE = #I4 OR = 0)
  #BIN-SIZE := (#SPOOL-DI-SIZE / 1024) * 3 / 4 + 1
ELSE
  #RUN-NUMBER := NOAR-REPRNB
  CALLNAT 'RBINSZ-N' NOAR-REPNAME #RUN-NUMBER 'R' #RECNUM
    #BIN-SIZE #ERC #ERT
  IF #ERC = 0
    #SPOOL-DI-SIZE := #BIN-SIZE
    IF #BIN-SIZE > 0
      #BIN-SIZE := #BIN-SIZE / 1024 + 1
    END-IF
  END-IF
END-IF
************************************************************************
END-SUBROUTINE /* GET-BINARY-SIZE
*
************************************************************************
DEFINE SUBROUTINE GET-FOLDER-GRANTS
************************************************************************
IF ES-USER-TYPE = 'A'
  ESCAPE ROUTINE
END-IF
#FO-USER-NAME.#FO-NAME := ES-KEY-PARM (#PARM-COUNT - 1)
#FO-USER-NAME.#FO-USER := ES-USER
IF #FO-USER-NAME.#FO-NAME = '#Inbasket' OR = '#Listeneingang'
  #S-USER := #FO-USER-NAME.#FO-USER
  #S-FO-ID := 1
  FIND FO WITH FO-USER-FO-ID = #S-USER-FO-ID
    #FO-USER-NAME.#FO-NAME := FO.FO-NAME
  END-FIND
END-IF
*
FO1. FIND FO WITH FO-USER-NAME = #FO-USER-NAME
  RESET #GRANTS(*) #GR-NAME #GR-USER
  DECIDE FOR FIRST CONDITION
/* own folder
    WHEN FO-USER-ID = ES-USER  AND FO-ID = 0001
      #DISPLAY := #MODIFY := #DELETE := #ARC := #REV := TRUE
/* linked folder
    WHEN FO-USER-ID = ES-USER  AND FO-ID NE 0001
      IF FO-LINKED-FO-ID = ' '      /* another own folder
        #MODIFY := #DISPLAY := #DELETE := #ARC := #REV := TRUE
      ELSE
        #FO-ID-N := FO-LINKED-ID
        COMPRESS FO-LINKED-USER #FO-ID-A TO #GR-NAME LEAVING NO
        CALLNAT 'NOGROU-N' 'F' #GR-NAME ES-USER #GR-USER #GRANTS(*)
        IF NOT (#GRANTS(*) NE ' ')         /* no grants
          IF FO-LINKED-USER = ES-USER     /* linked to own folder
            #DISPLAY := #MODIFY := #DELETE := #ARC := #REV := TRUE
          END-IF
        ELSE
          IF #GRANTS(1) = 'Y'
            #DISPLAY := #MODIFY := #DELETE := #ARC := #REV := TRUE
            ESCAPE BOTTOM (FO1.)
          END-IF
          DECIDE FOR EVERY CONDITION
            WHEN #GRANTS(2) = 'Y' #MODIFY := TRUE
            WHEN #GRANTS(3) = 'Y' #DELETE := TRUE
            WHEN #GRANTS(4) = 'Y' #DISPLAY := TRUE
            WHEN #GRANTS(5) = 'Y' #ARC := TRUE
            WHEN #GRANTS(6) = 'Y' #REV := TRUE
            WHEN NONE IGNORE
          END-DECIDE
        END-IF
      END-IF
    WHEN NONE IGNORE
  END-DECIDE
END-FIND
*
END-SUBROUTINE /* GET-FOLDER-GRANTS
*
************************************************************************
DEFINE SUBROUTINE CHECK-OTHER-FOLDERS
************************************************************************
RESET #GR-USER #GR-NAME
*
IF ACTIVE-REPORTS.AR-USERID = ES-USER
  #GR-FUNC := TRUE
  ESCAPE ROUTINE
END-IF
*
FNDMA. FIND MA WITH MA-REP-RNB = #AR-REPORT-RNB
  RESET #GRANTS(*) #FO-ID-N
  DECIDE FOR FIRST CONDITION
/* mailed to g-userid own folder
    WHEN MA-USERID = ES-USER  AND MA-FO-ID = 0001
      #GR-FUNC := TRUE
/* mailed to g-userid, to linked folder
    WHEN MA-USERID = ES-USER  AND MA-FO-ID NE 0001
      #FO-ID      := MA-FO-ID
      #FO-USER-ID := MA-USERID
      FFO. FIND FO WITH FO-USER-FO-ID = #FO-USER-ID
        #FO-ID-N := FO-LINKED-ID
        COMPRESS FO-LINKED-USER #FO-ID-A TO #GR-NAME LEAVING NO
        CALLNAT 'NOGROU-N' 'F' #GR-NAME ES-USER #GR-USER #GRANTS(*)
        IF NOT(#GRANTS(*) NE ' ')
          #GR-FUNC := TRUE          /* own folder, grants not set
        ELSE
          PERFORM SET-GR-FUNC
        END-IF
        IF #GR-FUNC
          ESCAPE BOTTOM (FFO.)
        END-IF
      END-FIND
/* mailed not to g-userid, but contains in linked folder
    WHEN MA-USERID NE ES-USER
      #FO-ID-N := MA-FO-ID
      COMPRESS MA-USERID #FO-ID-A TO #GR-NAME LEAVING NO
      CALLNAT 'NOGROU-N' 'F' #GR-NAME ES-USER #GR-USER #GRANTS(*)
      PERFORM SET-GR-FUNC
    WHEN NONE IGNORE
  END-DECIDE
  IF #GR-FUNC
    ESCAPE BOTTOM(FNDMA.)
  END-IF
END-FIND
*
END-SUBROUTINE /* CHECK-OTHER-FOLDERS
*
************************************************************************
DEFINE SUBROUTINE SET-GR-FUNC
************************************************************************
RESET #GR-FUNC
*
IF #GRANTS(1) = 'Y'
  #GR-FUNC := TRUE
  ESCAPE ROUTINE
END-IF
*
DECIDE ON FIRST VALUE OF ES-EXTEND-FUNCTION
  VALUE ' '
    IF #GRANTS(4) = 'Y'
      #GR-FUNC := TRUE
    END-IF
  VALUE ' UPD'
    IF #GRANTS(2) = 'Y'
      #GR-FUNC := TRUE
    END-IF
  NONE VALUE IGNORE
END-DECIDE
*
END-SUBROUTINE /* SET-GR-FUNC
*
************************************************************************
DEFINE SUBROUTINE GET-MSG-TXT
************************************************************************
RESET SHORT-MSG LONG-MSG(*)
VERSION := 0
NADA2000.OBJECT-KIND := 'U'
NADA2000.ERROR-NUMBER := #ES-MSG-NR
NADA2000.OPT-INSERT-DYN := FALSE
NADA2000.OPT-LANGUAGE := ES-LANGUAGE
NADA2000.LIBRARY := #LIBRARY-ID
CALLNAT 'NATA2000' NADA2000 NATA2000.EXTENDED-PARMS NAD-MSG NAD-FLD
ES-MSG-NR    := #ES-MSG-NR
ES-MSG-TXT   := SHORT-MSG
EXAMINE ES-MSG-TXT FOR #ES-MSG-PREF DELETE
IF #ES-MSG-NR = 0150       /* enter date in format :1:
  EXAMINE ES-MSG-TXT FOR ':1:' REPLACE ES-DATE-FORMAT
END-IF
EXAMINE ES-MSG-TXT FOR ':1:' REPLACE ' '
EXAMINE ES-MSG-TXT FOR ':2:' REPLACE ' '
ES-MSG-FIELD := #ES-MSG-FIELD
ES-RC := 1
*
END-SUBROUTINE /* GET-MSG-TXT
*
************************************************************************
DEFINE SUBROUTINE GET-LONGNAME
************************************************************************
XXHASH-PARMS.P-FUNCTION := 'L' /*short -> long
PERFORM XXHASH XXHASH-PARMS
IF XXHASH-PARMS.P-RC NE 0
  ES-RC := 1
  ES-MSG-NR := 5
  COMPRESS *PROGRAM 'Return code' XXHASH-PARMS.P-RC 'from XXHASH. Long:'
    XXHASH-PARMS.P-SHORT-NAME TO ES-MSG-TXT
  ESCAPE MODULE
END-IF
*
END-SUBROUTINE /* GET-LONGNAME
*
END
