* mrs 91-12-13 s(141159) support languages other than english
* mrs 92-01-24 s(999999) performance problem in list functions
* mrs 92-04-28 s(999999) set confirm off implemented
* mrs 93-11-15 s(999999) line command help destroyed
* sju 95-09-27 s(999999) NAT3113 on delete for non-admin user
* sju 95-10-02 s(229945) use RDELPR for delete
* gw  96-05-29 s(999999) reinit flipline after fetch return
* gw  96-10-15 s(231722) TOP doesn't go top
* gw  98-03-13 s(278970) save search values in independent variables
* wcd 00-04-01 CE 7267   New PFkey for additional printers in RPFK---L
* xsiszha 2000-08-15 (CE7461) Extend Report and Bundle Names
* xsetoba 2002-04-16 (CE5903) BOT doesn't work
* xsetggr 2003-08-09 p(240465) don't list granted printers
* xsetggr 2004-05-31 (CE5903)
* LP      2005-02-10 p(272732)STOWED WITH CHANGED LDA VPRINT-L
*                             P-LABEL (ADABAS SHORT NAME TP) is multiple
* xsetggr 2007-11-30 NRT2771  Show status of physical printers
* xsetggr 2010-01-07 P300184  use G-LANGUAGE for checking
* fhi     2010-03-05 P307403 Don't use text and binary reports mixed
* xsetggr 2010-03-16 P307403 restow - RPFKEX-C is changed back
* fhi     2010-09-03 NOMALL-97 Extend message line
* xsetggr 2012-09-19 NOMALL-89 implement line command validation check
* xsetggr 2013-06-19 NOMALL-1198 restow due corrections in C-CHKLC
* SU1     2013-07-17 remove empty copy code CSTARTLS
* SU2     2016-08-01 NOMALL-1518 NOM3.5 deactivate opt.Compiler
* BLI     2017-07-17 NOMALL-1984 differ MODIFY/DISPLAY (C-CHKLC)
* ---------------------------------------------------------------------
DEFINE DATA
GLOBAL USING  NRM-GL
INDEPENDENT
1 +G-RLISPR-SEL-PID             (A8)
1 +G-RLISPR-SEL-PHYSICAL        (A8)
1 +G-RLISPR-SEL-AUTHORIZATION (A8)
LOCAL  USING  RLC----L
LOCAL  USING  RPFK---L
LOCAL  USING  ROT----L
LOCAL  USING  VPRINT-L
LOCAL  USING  VGRANT-L
LOCAL
*
1 LIST     VIEW OF NRM-DISTRIBUTION-LIST
1 PHYSICAL VIEW OF NRM-PHYSICAL-PRINTERS
  2 PH-LOCATION
  2 PH-STATUS
*
1 #NOFLINES                      (P2) CONST <15>
1 #NOFPAGES                      (P2) INIT <50>
1 #END-OF-DATA                   (L)
***
1 #MAXP                          (P3)
1 #BROWSE-FLAGS
  2 #NEWVAL                      (L)
  2 #BACKWARD                    (L)
  2 #FORWARD                     (L)
  2 #TOP                         (L)
  2 #BOT                         (L)
  2 #SCROLL-AMOUNT               (N3)
1 DISPLAY-IT                     (L)
1 GET-SCREEN                     (L)
*
1 #ISN                           (P10)
1 #LEN                           (N3) INIT <8>
1 L-SCREEN
  2 L-SCREEN-NO-SAVE
    3 L-SCR-NO                   (1:#NOFLINES)
      4 L-AUTHORIZATION          (A8)
      4 L-PHYSICAL               (A8)
      4 L-STATUS                 (A1)
      4 L-NAME                   (A20)
      4 L-LOCATION               (A50)
      4 L-ALTERNATIVE            (A8)
  2 L-SCREEN-SAVE-AREA
    3 L-SCR                      (1:#NOFLINES)
      4 L-IDENT                  (I2)  /*                        2
      4 L-ID                     (A8)  /*                        8
      4 L-ISN                    (P10) /*                        6
      4 L-OPTION                 (A1/1:6) /*                     6
      4 L-MARK                   (A2)  /*                        2
*                                                   =    24 * 15  =  360
    3 #CP                        (P3)  /*                        2
    3 #MAXAP                     (P3)  /*                        2
    3 #START-KEY                 (A34)
    3 REDEFINE    #START-KEY
      4 #S-TYPE                  (A1)
      4 #S-USERID                (A8)
      4 #S-OBJECT-NAME           (A25)
    3 #RSTART                    (A34)
    3 #LAST-KEY                  (A34)
    3 REDEFINE    #LAST-KEY
      4 #L-TYPE                  (A1)
      4 #L-USERID                (A8)
      4 #L-OBJECT-NAME           (A25)
    3 #TOPKEY                    (A34)
    3 #S-PID                     (A25)
    3 #S-AUTHORIZATION           (A8)
    3 #S-PHYSICAL                (A25)
    3 #S-PID-T                   (A25)
    3 #S-PHYS-T                  (A25)
    3 #S-PID-F                   (A25)
    3 #S-PHYS-F                  (A25)
    3 #PAGES                     (A34/50)
*
    3 REDEFINE    #PAGES
      4 #FROM-KEYS               (50)
        5 #F-TYPE                (A1)
        5 #F-USERID              (A8)
        5 #F-OBJECT-NAME         (A25)
*
    3 #T-KEY                     (A34)
    3 REDEFINE    #T-KEY
      4 #T-TYPE                  (A1)
      4 #T-USERID                (A8)
      4 #T-OBJECT-NAME           (A25)
*                                                                 = 1536
    3 #SCREEN-FIL                (A8)
*                                                                 = 1600
  2 REDEFINE    L-SCREEN-SAVE-AREA
    3 L-SCREEN-SEGMENT           (A200/1:12)
  2 REDEFINE    L-SCREEN-SAVE-AREA
    3 L-SCREEN-SEG               (12)
      4 L-SCREEN-SEG-F           (A199)
      4 L-SCREEN-SEG-L           (A1)
  2 L-SCREEN-SEG-FLAG            (L/1:12)
*
1 L-LCMD                         (15) /* LINE COMMANDS
  2 CV-MARK                      (C)
*
1 L-HEADER                       (A78)
*
1 I                              (N5)
1 #ALLOWED                       (L)
1 #UPDATE                        (L)
1 #DELETE                        (L)
1 #FATHER-PROG                   (A8) INIT <'RMENU'>
1 CV-SELECTION                   (C/3)
1 REDEFINE    CV-SELECTION
  2 CV-SPID                      (C)
  2 CV-SPHYS                     (C)
  2 CV-SAUTH                     (C)
*
1 GRANTED                        (L)
1 CV-LINES                       (C)
1 #ADD-PROGRAM                   (A8) INIT <'RDEFPR'>
1 #ACT-MAST                      (A8)
1 F                              (P2)
1 #LANGUAGE                      (I1)
1 #STACK-PGM                     (A8)
1 #I                             (N2)
1 #HP                            (N3)
1 #ARCHIVE                       (L)
1 #REVIVE                        (L)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
/*SU2 OPTIONS MCG=OFF
*
RESET G-COMMIT
CALLNAT 'NARPSEC' G-USER-PROFILE 'DPR' #ALLOWED
INCLUDE C-NALLOW
*
CALLNAT 'NARPSEC' G-USER-PROFILE 'MPR' #UPDATE
CALLNAT 'NARPSEC' G-USER-PROFILE 'PPR' #DELETE
*
G-C-OBJTYPE := 'PRINTERS'  /* xsetggr 2012-09-19 NOMALL-89 from below
*
IF *DATA = 5
  PERFORM READ-FROM-STACK
  PERFORM INIT-LINECOM
  PERFORM LINE-COMMANDS
  PERFORM INIT-SELECTION-KEYS
  GET-SCREEN := TRUE
ELSE
  #NEWVAL := TRUE
END-IF
*
#ADD-PROGRAM := 'RDEFPR'
/*SU1 INCLUDE CSTARTLS
INCLUDE CVIDEO
* ---
IF *DATA > 0
  INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT MARK *G-DIRECT-COMMAND
    USING MAP 'RLISPRM&'
END-IF
IF #S-PID = ' ' AND #S-AUTHORIZATION = ' ' AND #S-PHYSICAL = ' '
  #S-PID           := +G-RLISPR-SEL-PID
  #S-AUTHORIZATION := +G-RLISPR-SEL-AUTHORIZATION
  #S-PHYSICAL      := +G-RLISPR-SEL-PHYSICAL
ELSE
  +G-RLISPR-SEL-PID           := #S-PID
  +G-RLISPR-SEL-AUTHORIZATION := #S-AUTHORIZATION
  +G-RLISPR-SEL-PHYSICAL      := #S-PHYSICAL
END-IF
IF G-USER-TYPE = 'G' AND #S-PID = ' '
  #S-AUTHORIZATION := G-USERID
END-IF
MAIN-LOOP. REPEAT
*
  IF #LANGUAGE NE *LANGUAGE
    CALLNAT 'ROTINI-N' ##EQO-PRINTER G-OBJ-TYPE G-OTB
    PERFORM INIT-PFKEYS
    PERFORM INIT-LINECOM
*   #LANGUAGE := *LANGUAGE
* xsetggr 2010-01-07 P300184 line above out, next line in
    MOVE G-LANGUAGE TO #LANGUAGE *LANGUAGE
  END-IF
  PERFORM SET-PFKEYS
  INCLUDE RMVHLP-C
*
  PERFORM GET-SCREEN
  RESET GET-SCREEN
*
  INCLUDE C-TOPBOT
*
  CALLNAT 'N-HEADER' L-HEADER G-DATE-FORMAT 'ODEFWSM&'
  PERFORM FLIP-DISPLAY
  SET CONTROL 'WB'
  INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT MARK *G-DIRECT-COMMAND
    USING MAP 'RLISPRM&'
  RESET G-NATRP-ERC G-NATRP-ERT
  INCLUDE RPFKVA-C
  RESET #BROWSE-FLAGS
  INCLUDE C-DIRECT
  INCLUDE C-LOCCMD
  INCLUDE RPFKEX-C
  PERFORM LINE-COMMANDS
*
  IF CV-SELECTION(*) MODIFIED
    #NEWVAL := TRUE
    +G-RLISPR-SEL-PID             := #S-PID
    +G-RLISPR-SEL-AUTHORIZATION := #S-AUTHORIZATION
    +G-RLISPR-SEL-PHYSICAL        := #S-PHYSICAL
  END-IF
*
END-REPEAT
RESET G-NATRP-ERT G-NATRP-ERC
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE GET-SCREEN
************************************************************************
IF G-DIRECT-COMMAND = 'TOP'
  #TOP := TRUE
END-IF
RESET L-MARK(*) L-IDENT (*) G-NATRP-ERT
IF #S-AUTHORIZATION = ' ' OR = '*' OR = 'ADMIN'
  PERFORM READ-ALL-PRINTER
ELSE
  PERFORM READ-GRANTED-PRINTER
END-IF
*
END-SUBROUTINE /* GET-SCREEN
*
************************************************************************
DEFINE SUBROUTINE READ-ALL-PRINTER
************************************************************************
DECIDE FOR EVERY  CONDITION
  WHEN #NEWVAL OR #TOP
    RESET #PAGES(*) #MAXP #MAXAP
    PERFORM INIT-SELECTION-KEYS
    #PAGES(1) := #START-KEY
    #CP := 1
* xsetggr 2004-05-31 (CE5903) insert following 2 lines
    #MAXAP := 1
  WHEN #BOT
    #HP := #NOFPAGES / 2.
    #I := 0
    READ PRINTERS BY P-ID = #PAGES(1) THRU #S-PID-T
* xsetggr 2004-05-31 (CE5903) insert
      DISPLAY-IT := TRUE
      PERFORM SELECT-RECORD
      IF DISPLAY-IT
* xsetggr 2004-05-31 (CE5903) end
        ADD 1 TO #I
      END-IF              /* xsetggr 2004-05-31 (CE5903) insert
      IF #I = 16
        IF #CP = #NOFPAGES
          #PAGES(#HP - 1 : #NOFPAGES - 1) := #PAGES(#HP : #NOFPAGES)
          RESET #PAGES(#CP)
          SUBTRACT 1 FROM #CP
        END-IF
        ADD 1 TO #CP
        #PAGES(#CP) := P-ID
        #I := 1
      END-IF
    END-READ
    #MAXAP := #CP
    #CP := 1
    #CP := #MAXAP
*
  WHEN #FORWARD
    IF #END-OF-DATA
      ESCAPE ROUTINE
    END-IF
    IF #CP = #NOFPAGES
      #PAGES(1 : #NOFPAGES - 1) := #PAGES(2 : #NOFPAGES)
      RESET #PAGES(#CP)
      #PAGES(#CP) := #LAST-KEY
    ELSE
      IF #SCROLL-AMOUNT < 1
        #SCROLL-AMOUNT := 1
      END-IF
      IF #CP + #SCROLL-AMOUNT <= #MAXAP
        ADD #SCROLL-AMOUNT TO #CP
      ELSE
        IF #SCROLL-AMOUNT > 1
          #CP := #MAXAP
        ELSE
          ADD 1 TO #CP
        END-IF
      END-IF
      IF #CP > #MAXAP
        #PAGES(#CP) := #LAST-KEY
      END-IF
    END-IF
  WHEN #BACKWARD
    IF #CP GE 2
      IF #SCROLL-AMOUNT < 1
        #SCROLL-AMOUNT := 1
      END-IF
      SUBTRACT #SCROLL-AMOUNT FROM #CP
      IF #CP < 1
        #CP := 1
      END-IF
    END-IF
  WHEN GET-SCREEN IGNORE
  WHEN NONE ESCAPE ROUTINE
END-DECIDE
*
IF #CP >= #MAXAP
  #MAXAP := #CP
END-IF
*
#RSTART := #PAGES(#CP)
*
RESET I L-SCR (*) L-SCR-NO (*) #END-OF-DATA
CV-MARK(*) := (AD=P)
*
READ-LOOP. READ PRINTERS BY P-ID = #RSTART THRU #S-PID-T
  AT START OF DATA
    #PAGES(#CP) := #TOPKEY := P-ID
  END-START
*
  DISPLAY-IT := TRUE
  PERFORM SELECT-RECORD
  REJECT IF NOT DISPLAY-IT
  IF G-USER-TYPE = 'A'
    GRANTED := TRUE
    GRANTS.GR-OPTION(*) := 'Y'
    GRANTS.GR-USERID := 'ADMIN'
  ELSE
    GRANTS.GR-USERID             := G-USERID
    GRANTS.GR-OBJECT-NAME := P-ID
    CALLNAT 'RGRANT-N' GRANTS.GR-USERID 'P' GRANTS.GR-OBJECT-NAME
      GRANTED GRANTS.GR-OPTION(*)
  END-IF
  REJECT IF NOT GRANTED
  ADD 1 TO I
  IF I > #NOFLINES
    #LAST-KEY := P-ID
    ESCAPE ROUTINE
  END-IF
  IF I = 1
    #PAGES(#CP) := P-ID
  END-IF
  RESET CV-MARK(I)
  #LAST-KEY := L-ID(I) := P-ID
  #ISN := *ISN (READ-LOOP.)
  PERFORM DATA-TO-SCREEN
END-READ
#END-OF-DATA := TRUE
#MAXP := #CP
*
END-SUBROUTINE /* READ-ALL-PRINTER
*
************************************************************************
DEFINE SUBROUTINE READ-GRANTED-PRINTER
************************************************************************
DECIDE FOR EVERY  CONDITION
  WHEN #NEWVAL
* xsetggr 2004-05-31 (CE5903) insert line
      OR #TOP
    RESET #PAGES(*) #MAXP #MAXAP
    PERFORM INIT-SELECTION-KEYS
    #PAGES(1) := #START-KEY       /* xsetggr 2003-08-09 p(240465) in
    #CP := 1
* xsetggr 2004-05-31 (CE5903) insert following 2 lines
    #MAXAP := 1
  WHEN #BOT
    #HP := #NOFPAGES / 2
    #I := 0
    READ GRANTS BY GR-SUPER STARTING FROM #PAGES (1)
      ADD 1 TO #I
      IF #I = 16
        IF #CP = #NOFPAGES
          #PAGES(#HP - 1 : #NOFPAGES - 1) := #PAGES(#HP : #NOFPAGES)
          RESET #PAGES(#CP)
          SUBTRACT 1 FROM #CP
        END-IF
        ADD 1 TO #CP
        #PAGES(#CP) := P-ID
        #I := 1
      END-IF
    END-READ
    #MAXAP := #CP
  WHEN #TOP
    #CP := 1
  WHEN #FORWARD
    IF #END-OF-DATA
      ESCAPE ROUTINE
    END-IF
    IF #CP = #NOFPAGES
      #PAGES(1 : #NOFPAGES - 1) := #PAGES(2 : #NOFPAGES)
      RESET #PAGES(#CP)
      #F-TYPE (#CP) := 'P'
      #F-USERID (#CP) := #S-AUTHORIZATION
      #F-OBJECT-NAME (#CP) := #LAST-KEY
    ELSE
      IF #SCROLL-AMOUNT < 1
        #SCROLL-AMOUNT := 1
      END-IF
      IF #CP + #SCROLL-AMOUNT <= #MAXAP
        ADD #SCROLL-AMOUNT TO #CP
      ELSE
        ADD 1 TO #CP
      END-IF
      IF #CP > #MAXAP
        #F-TYPE (#CP) := 'P'
        #F-USERID (#CP) := #S-AUTHORIZATION
        #F-OBJECT-NAME (#CP) := #LAST-KEY
      END-IF
    END-IF
  WHEN #BACKWARD
    IF #CP < 2
      IGNORE
    ELSE
      IF #SCROLL-AMOUNT < 1
        #SCROLL-AMOUNT := 1
      END-IF
      SUBTRACT #SCROLL-AMOUNT FROM #CP
      IF #CP < 1
        #CP := 1
      END-IF
    END-IF
  WHEN GET-SCREEN IGNORE
  WHEN NONE ESCAPE ROUTINE
END-DECIDE
*
IF #CP >= #MAXAP
  #MAXAP := #CP
END-IF
RESET I L-SCR (*) L-SCR-NO (*) #END-OF-DATA
CV-MARK(*) := (AD=P)
#RSTART := #PAGES (#CP)
*
READ-LOOP-GRANT. READ GRANTS BY GR-SUPER = #RSTART
  IF GR-OBJECT-TYPE NE #T-TYPE OR
      GR-USERID NE #T-USERID    OR
      GR-OBJECT-NAME > #T-OBJECT-NAME
    ESCAPE BOTTOM (READ-LOOP-GRANT.)
  END-IF
  FIND-LOOP. FIND PRINTERS WITH P-ID = GRANTS.GR-OBJECT-NAME
    DISPLAY-IT := TRUE
*
    PERFORM SELECT-RECORD
    REJECT IF NOT DISPLAY-IT
*
    IF G-USER-TYPE = 'A'
      GRANTED := TRUE
      GRANTS.GR-OPTION(*) := 'Y'
    END-IF
*
    ADD 1 TO I
*
    IF I > #NOFLINES
      #LAST-KEY := PRINTERS.P-ID
      ESCAPE ROUTINE
    END-IF
    IF I = 1
      #F-TYPE (#CP) := GRANTS.GR-OBJECT-TYPE
      #F-USERID (#CP) := GRANTS.GR-USERID
      #F-OBJECT-NAME (#CP) := PRINTERS.P-ID
      #TOPKEY := #PAGES(#CP)
    END-IF
*
    RESET CV-MARK(I)
    #LAST-KEY := L-ID(I) := P-ID
    #ISN := *ISN (FIND-LOOP.)
    PERFORM DATA-TO-SCREEN
*
  END-FIND
END-READ
#END-OF-DATA := TRUE
#MAXP := #CP
*
END-SUBROUTINE /* READ-GRANTED-PRINTER
*
************************************************************************
DEFINE SUBROUTINE SELECT-RECORD
************************************************************************
DECIDE FOR EVERY CONDITION
  WHEN NOT(PRINTERS.P-PHYSICAL-NAME = #S-PHYS-F THRU #S-PHYS-T)
    DISPLAY-IT := FALSE
  WHEN NONE IGNORE
END-DECIDE
*
END-SUBROUTINE /* SELECT-RECORD
*
************************************************************************
DEFINE SUBROUTINE DATA-TO-SCREEN
************************************************************************
L-NAME(I) := PRINTERS.P-NAME
L-PHYSICAL(I) := PRINTERS.P-PHYSICAL-NAME
DECIDE ON FIRST VALUE OF PRINTERS.P-PHYSICAL-NAME
  VALUE 'TAPE'     L-LOCATION(I) := PRINTERS.P-VOLSER
  VALUE 'DISK'     L-LOCATION(I) := PRINTERS.P-DSNAME
  VALUE 'SYSPRINT' L-LOCATION(I) := 'MAIN SYSTEM PRINTER'
  NONE VALUE
    FIND PHYSICAL WITH PH-VTAMID = L-PHYSICAL(I)
* xsetggr 2010-01-07 P300184 insert next line
      L-LOCATION(I) := PH-LOCATION
    END-FIND
END-DECIDE
L-STATUS(I) := PH-STATUS
L-ISN(I) := #ISN
L-OPTION(I,1:6) := GRANTS.GR-OPTION(1:6)
L-AUTHORIZATION (I) := GRANTS.GR-USERID
RESET CV-MARK(I)
*
END-SUBROUTINE /* DATA-TO-SCREEN
*
************************************************************************
DEFINE SUBROUTINE LINE-COMMANDS
************************************************************************
IF L-MARK(*) = '.'
  INCLUDE C-ESCAPE
END-IF
INCLUDE RLCMTI-C
INCLUDE C-CHKLC             /* xsetggr 2012-09-19 NOMALL-89 in
* xsetggr 2012-09-19 NOMALL-89 remove authorization check
* --- DELETE LINE COMMANDS
FOR I 1 TO #NOFLINES
  IF L-IDENT (I) = ##EQU-DELETE
    G-C-PRINTER := L-ID(I)
    FETCH RETURN 'RDELPR'
    GET-SCREEN := TRUE
    INCLUDE L-COMMIT
  END-IF
END-FOR
* --- OTHER LINE COMMANDS
FOR I 1 TO #NOFLINES
  DECIDE ON EVERY VALUE OF L-IDENT (I)
    VALUE ##EQU-MODIFY
      RESET L-MARK (I) L-IDENT (I)
      G-C-FUNC := 'M'
      G-C-PRINTER := L-ID(I)
      PERFORM COMMIT-WORK
      PERFORM STACK-SCREEN
      FETCH 'RDEFPR'
    VALUE ##EQU-AUTHORIZE
      PERFORM COMMIT-WORK
      G-C-OBJNAME := L-ID(I)
      G-FATHER-PROG := *PROGRAM
      G-C-OBJTYPE := 'P'
      G-C-GRANTS(1:6) := L-OPTION(I,1:6)
      FETCH RETURN 'RLISGR'
      PERFORM INIT-LINECOM
    VALUE ##EQU-COPY
      G-C-PRINTER := L-ID(I)
      PERFORM COMMIT-WORK
      FETCH RETURN 'RCOPPR'
      GET-SCREEN := TRUE
    VALUE ##EQU-LOG
      FETCH RETURN 'RLISLG' 'PM' L-ID(I)
      PERFORM INIT-LINECOM
    VALUE ##EQU-DISPLAY
      RESET L-MARK (I) L-IDENT (I)
      G-C-FUNC := 'D'
      G-C-PRINTER := L-ID(I)
      PERFORM COMMIT-WORK
      PERFORM STACK-SCREEN
      FETCH 'RDEFPR'
    VALUE ##EQU-RENAME
      G-C-PRINTER := L-ID(I)
      FETCH RETURN 'RRENPR'
      PERFORM INIT-LINECOM
      GET-SCREEN := TRUE
    NONE VALUE IGNORE
  END-DECIDE
END-FOR
*
END-SUBROUTINE /* LINE-COMMANDS
*
************************************************************************
DEFINE SUBROUTINE INIT-SELECTION-KEYS
************************************************************************
PERFORM VALIDATE-SELECTION-KEYS
#LEN := 8
CALLNAT 'SELALPHA' #S-PID  #S-PID-F #S-PID-T #LEN
CALLNAT 'SELALPHA' #S-PHYSICAL #S-PHYS-F #S-PHYS-T #LEN
#START-KEY := #S-PID-F
IF #S-AUTHORIZATION NE ' '
  RESET #START-KEY
  #S-USERID      := #S-AUTHORIZATION
  #T-USERID      := #S-AUTHORIZATION
  #S-TYPE        := 'P'
  #S-OBJECT-NAME := #S-PID-F
  #T-TYPE        := 'P'
  #T-OBJECT-NAME := #S-PID-T
END-IF
*
END-SUBROUTINE /* INIT-SELECTION-KEYS
*
************************************************************************
DEFINE SUBROUTINE INIT-LINECOM
************************************************************************
G-LC-IDENT (01) := ##EQU-DISPLAY
G-LC-IDENT (02) := ##EQU-MODIFY
G-LC-IDENT (03) := ##EQU-DELETE
G-LC-IDENT (04) := ##EQU-COPY
G-LC-IDENT (05) := ##EQU-RENAME
G-LC-IDENT (06) := ##EQU-AUTHORIZE
G-LC-IDENT (07) := ##EQU-LOG
G-LC-NUM               := 7
CALLNAT 'RLCINI-N' G-OBJ-TYPE G-LC G-LCB
INCLUDE RMVHLP-C
CALLNAT 'RFLIPG-N' G-LC G-LINECOM (*)
*
END-SUBROUTINE /* INIT-LINECOM
*
************************************************************************
DEFINE SUBROUTINE INIT-PFKEYS
************************************************************************
INCLUDE RPFSTD-C
INCLUDE RPFADD-C
INCLUDE RPFBRW-C
CALLNAT 'RPFINI-N' G-PF G-PFB
*
END-SUBROUTINE /* INIT-PFKEYS
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-SELECTION-KEYS
************************************************************************
DECIDE FOR FIRST CONDITION
  WHEN (G-USER-TYPE = 'A' AND #S-AUTHORIZATION = 'ADMIN')
  OR (#S-AUTHORIZATION = '*' OR = ' ')                                /*
    RESET #S-AUTHORIZATION
  WHEN #S-AUTHORIZATION = G-USERID OR #S-AUTHORIZATION = 'PUBLIC'
    IGNORE
  WHEN NONE
    IF G-USER-TYPE NE 'A'
      FNDL. FIND NUMBER LIST WITH D-LIST-NAME = #S-AUTHORIZATION
        AND D-USER-LIST = G-USERID
      IF *NUMBER (FNDL.) = 0
        REINPUT *0911 MARK *#S-AUTHORIZATION ALARM
      END-IF
    END-IF
END-DECIDE
*
END-SUBROUTINE /* VALIDATE-SELECTION-KEYS
*
************************************************************************
DEFINE SUBROUTINE STACK-SCREEN
************************************************************************
FOR F = 1 TO 12
  IF L-SCREEN-SEG-L (F) = H'00'
    L-SCREEN-SEG-L (F) := H'01'
    L-SCREEN-SEG-FLAG (F) := TRUE
  ELSE
    L-SCREEN-SEG-FLAG (F) := FALSE
  END-IF
END-FOR
STACK TOP DATA FORMATTED L-SCREEN-SEGMENT (*) L-SCREEN-SEG-FLAG (*)
#STACK-PGM := *PROGRAM
STACK TOP DATA FORMATTED #STACK-PGM 'X' 'X' 'X' 'X'
STACK TOP COMMAND *PROGRAM
RESET F
*
END-SUBROUTINE /* STACK-SCREEN
*
************************************************************************
DEFINE SUBROUTINE READ-FROM-STACK
************************************************************************
INPUT #STACK-PGM
IF #STACK-PGM NE *PROGRAM
  *ERROR-NR := 1
END-IF
INPUT (LS=202) L-SCREEN-SEGMENT (*) L-SCREEN-SEG-FLAG (*)
FOR F = 1 TO 12
  IF L-SCREEN-SEG-FLAG (F) = TRUE
    L-SCREEN-SEG-L (F) := H'00'
  END-IF
END-FOR
*
END-SUBROUTINE /* READ-FROM-STACK
*
INCLUDE RPFSET-C
*
END
