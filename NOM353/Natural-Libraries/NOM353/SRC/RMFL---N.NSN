DEFINE DATA
PARAMETER USING RMFL---P
PARAMETER
1 P-ERROR-CODE (N4)
1 P-ERROR-TEXT (A250)
************************************************************************
LOCAL USING EOMPHTYE
LOCAL
1 PRINTOUT  VIEW  OF  NRM-PRINTOUTS
  2 PO-REPNAME
  2 PO-BUNDLE
  2 PO-BUNDRNB
  2 PO-EXITMEM
  2 PO-EXITLIB
  2 PO-COPIES
  2 PO-PRINTER-TYPE
  2 PO-PRINT-PGM
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET P-ERROR-CODE P-ERROR-TEXT
*
PERFORM READ-PRINTOUT-RECORD
PERFORM FLUSH-INTERFACE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE READ-PRINTOUT-RECORD
************************************************************************
FNDPR. FIND PRINTOUT WITH PO-ID = FLUSH-POID
  IF NO RECORDS FOUND
    P-ERROR-CODE := 0005
    P-ERROR-TEXT := 'Printout Record not found'
    ESCAPE BOTTOM (FNDPR.)
  END-NOREC
END-FIND
*
END-SUBROUTINE /* READ-PRINTOUT-RECORD
*
************************************************************************
DEFINE SUBROUTINE FLUSH-INTERFACE
************************************************************************
FLUSH-MEMBER  := PRINTOUT.PO-EXITMEM
FLUSH-LIBRARY := PRINTOUT.PO-EXITLIB
FLUSH-VERSION := 012
FLUSH-REPNAME := PRINTOUT.PO-REPNAME
FLUSH-BUNDLE  := PRINTOUT.PO-BUNDLE
FLUSH-BUNDRNB := PRINTOUT.PO-BUNDRNB
FLUSH-PROGRAM := PRINTOUT.PO-PRINT-PGM
FLUSH-COPIES  := PRINTOUT.PO-COPIES
IF FLUSH-COPIES = 0
  FLUSH-COPIES := 1
END-IF
FLUSH-PRINTER-TYPE:= PO-PRINTER-TYPE
*
DECIDE ON FIRST PRINTOUT.PO-PRINTER-TYPE
/*SU3  VALUE ##PHYS-SYSPR-PWR
  VALUE ##PHYS-DISK-MVS
    CALLNAT 'RMFLWK-N' FLUSH-PARMS P-ERROR-CODE P-ERROR-TEXT
    FLUSH-PROGRAM := 'RMPRWKF'
  VALUE ##PHYS-SYSPR-JES
    CALLNAT 'RMFLWK-N' FLUSH-PARMS P-ERROR-CODE P-ERROR-TEXT
    FLUSH-PROGRAM := 'RMPRWKF'
    FLUSH-COPIES := 1
  VALUE ##PHYS-WRTSPOOL
    CALLNAT 'RMFLWS-N' FLUSH-PARMS P-ERROR-CODE P-ERROR-TEXT
    FLUSH-PROGRAM := 'RMPRWSP'
    FLUSH-COPIES := 1
  VALUE ##PHYS-TAPE-MVS /*SU3 ##PHYS-TAPE-VSE
    CALLNAT 'RMFLWK-N' FLUSH-PARMS P-ERROR-CODE P-ERROR-TEXT
    FLUSH-PROGRAM := 'RMPRWKF'
  VALUE ##PHYS-NAF
    CALLNAT 'RMFLNF-N' FLUSH-PARMS P-ERROR-CODE P-ERROR-TEXT
    FLUSH-PROGRAM := 'RMPRNAF'
    FLUSH-COPIES := 1
  VALUE ##PHYS-CMASPOOL
    CALLNAT 'RMFLCM-N' FLUSH-PARMS P-ERROR-CODE P-ERROR-TEXT
    FLUSH-PROGRAM := 'RMPRCMA'
    FLUSH-COPIES := 1
  VALUE ##PHYS-UNIXLP
    CALLNAT 'RMFLLP-N' FLUSH-PARMS P-ERROR-CODE P-ERROR-TEXT
    FLUSH-PROGRAM := 'RMPRTCP'
  VALUE ##PHYS-NATUNIX
    CALLNAT 'RMFLDX-N' FLUSH-PARMS P-ERROR-CODE P-ERROR-TEXT
    FLUSH-PROGRAM := 'RMPRNAT'
  VALUE ##PHYS-DISKUNIX
    CALLNAT 'RMFLDU-N' FLUSH-PARMS P-ERROR-CODE P-ERROR-TEXT
    FLUSH-PROGRAM := 'RMPRDSK'
/*SU3  VALUE ##PHYS-BS2
  VALUE ##PHYS-EMAIL
    CALLNAT 'RMFLEMLN' FLUSH-PARMS P-ERROR-CODE P-ERROR-TEXT
    FLUSH-PROGRAM := 'RMPREML'
    FLUSH-COPIES := 1
  NONE VALUE /*print to VTAM
    CALLNAT 'RMFLVT-N' FLUSH-PARMS P-ERROR-CODE P-ERROR-TEXT
    FLUSH-PROGRAM := 'RMPRVTM'
END-DECIDE
*
END-SUBROUTINE /* FLUSH-INTERFACE
*
END
