DEFINE SUBROUTINE FIELD-IGNORED
************************************************************************
COMPRESS 'Field' #MSG 'ignored, wrong format detected:'
  #VALUE-CURRENT TO #MSG
PERFORM XXRLOG-WRITE-LOG 'W' #MSG
*
END-SUBROUTINE /* FIELD-IGNORED
*
************************************************************************
DEFINE SUBROUTINE ADD-LOADED
************************************************************************
#ACTION := 'loaded.'
PERFORM GET-INDEX_WRITE-MSG
ADD 1 TO #CNT-LOADED (#POS)
*
END-SUBROUTINE /* ADD-LOADED
*
************************************************************************
DEFINE SUBROUTINE ADD-NOT-LOADED /*SU3
************************************************************************
#ACTION := 'not loaded.'
PERFORM GET-INDEX_WRITE-MSG
ADD 1 TO #CNT-NOT-LOADED (#POS)
*
END-SUBROUTINE /* ADD-LOADED
*
************************************************************************
DEFINE SUBROUTINE ADD-REPLACED
************************************************************************
#ACTION := 'replaced.'
PERFORM GET-INDEX_WRITE-MSG
ADD 1 TO #CNT-REPLACED (#POS)
*
END-SUBROUTINE /* ADD-REPLACED
*
************************************************************************
DEFINE SUBROUTINE ADD-NOT-REPLACED
************************************************************************
#ACTION := 'not replaced.'
PERFORM GET-INDEX_WRITE-MSG
ADD 1 TO #CNT-NOT-REPLACED (#POS)
*
END-SUBROUTINE /* ADD-NOT-REPLACED
*
************************************************************************
DEFINE SUBROUTINE GET-INDEX_WRITE-MSG
************************************************************************
PRINT (AD=L) 'NOM0005 Import:' #TYPE #OBJ-NAME #ACTION
IF #POS NE 0
  ESCAPE ROUTINE
END-IF
EXAMINE #CNT-TYPE (*) FOR #TYPE GIVING INDEX #POS
IF #POS = 0
  EXAMINE FULL #CNT-TYPE (*) FOR FULL '  ' GIVING INDEX #POS
  #CNT-TYPE (#POS) := #TYPE
END-IF
*
END-SUBROUTINE /* GET-INDEX_WRITE-MSG
** End of Copycode RMIMP-C1 ********************************************
