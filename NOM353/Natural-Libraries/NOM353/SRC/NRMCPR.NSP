************************************************************************
* Main line
************************************************************************
*
/*SU2 OPTIONS MCG=OFF
*
RESET G-BROWSE-FLAGS
SET KEY PF3
PROFILE-STRING := G-USER-PROFILE
* MASSDEL, XREF, IXREF only admin:
IF G-USER-TYPE NE 'A'
  RESET #COMMAND(52) #COMMAND(53) #COMMAND(54)
    #COMMAND(58) /* fhi NOMALL-86 in
END-IF
MAIN-REPEAT. REPEAT
  RESET #TOK(*)
  RESET G-NATRP-ERC
  SEPARATE G-DIRECT-COMMAND LEFT INTO #TOK(1:30) WITH DELIMITER ' '
    GIVING NUMBER #NT
  IF #NT = 0 ESCAPE ROUTINE END-IF
*
* fhi     2017-01-27 NOMALL-1620 start commenting
* IF #TOK(1) = '>8'
*   #TOK(1) := '>8.0'
* END-IF
* fhi     2017-01-27 NOMALL-1620 end commenting, start insertion
  DECIDE FOR EVERY CONDITION
    WHEN #TOK(1) = '>8'
      #TOK(1) := '>8.0'
    WHEN #TOK(1) = MASK(N'.'N'.'N) OR = MASK(N'.'N'.'NN)
      +SUBMENU := SUBSTR(#TOK(1),5)
      COMPRESS '>' SUBSTR(#TOK(1),1,3) TO #TOK(1) LEAVING NO
    WHEN NONE
      IGNORE
  END-DECIDE
* fhi     2017-01-27 NOMALL-1620 end insertion
  #TOKEN-2 := #TOK(1)
  EXAMINE #COMMAND(*) FOR #TOKEN GIVING NUMBER #NOC INDEX #CN
  IF #CN = 0
    I-CMD := 1
    RESET K #CMDVEC(*) #CMDVECN(*)
    CV-MARK (*) := (AD=DP CD=TU)
    FOR J 1 TO 60
      IF #COMMAND(J) NE ' ' AND #COMMAND(J) NE SCAN '>'
          AND #COMMAND(J) NE MASK (' .')
        ADD 1 TO K
        #CMDVEC(K) := #COMMAND(J)
        #CMDVECN(K) := J
        CV-MARK (K) := (AD=I CD=GR)
      END-IF
    END-FOR
*
    CALLNAT 'RSRTCMD' #CMDVECA(1:60)
    REPEAT1.    REPEAT
      J := I-CMD         + 9
      RELEASE STACK
      SET CONTROL 'WC16L25B8/30F'
      INPUT USING MAP 'N--CPCM&'
      IF *PF-KEY = 'PF3'
        SET CONTROL 'WB'
        ESCAPE ROUTINE
      END-IF
*
      FOR K I-CMD TO J
        IF L-MARK(K) NE ' '
          #CN := #CMDVECN(K)
          ESCAPE BOTTOM(REPEAT1.)
        END-IF
      END-FOR
      IF I-CMD >= 30
        I-CMD := 1
      ELSE
        ADD 10 TO I-CMD
      END-IF
    END-REPEAT
  END-IF
  IF #NOC > 1
    RESET #CNVEC(*) #CMDVEC(*) K
    CV-MARK (*) := (AD=DP CD=TU)
    FOR J #CN TO 60
      EXAMINE #COMMAND(J) FOR #TOKEN GIVING NUMBER #CN
      IF #CN > 0
        ADD 1 TO K
        #CNVEC(K) := #CMDVECN(K) := J
        #CMDVEC(K) := #COMMAND(J)
        CV-MARK (K) := (AD=I CD=GR)
      END-IF
    END-FOR
    CALLNAT 'RSRTCMD' #CMDVECA(1:60)
    I-CMD := 1
    REPEAT2.    REPEAT
      J := I-CMD + 9
      SET CONTROL 'WC16L25B8/30F'
      INPUT USING MAP 'N--CPCM&'
      IF *PF-KEY = 'PF3' ESCAPE ROUTINE END-IF
      FOR K I-CMD TO J
        IF L-MARK(K) NE ' '
          #CN := #CMDVECN(K)
          ESCAPE BOTTOM(REPEAT2.)
        END-IF
      END-FOR
      IF I-CMD >= 20
        I-CMD := 1
      ELSE
        ADD 10 TO I-CMD
      END-IF
    END-REPEAT
  END-IF
*
  DECIDE ON FIRST VALUE OF #CN
    VALUE 12 G-DIRECT-COMMAND := 'START CONDENSE'
    VALUE 15 G-DIRECT-COMMAND := 'MENU MAIN     '
    VALUE 16 G-DIRECT-COMMAND := 'LIST REPORTS  '
    VALUE 17 G-DIRECT-COMMAND := 'LIST BUNDLES  '
    VALUE 18 G-DIRECT-COMMAND := 'LIST PRINTERS '
    VALUE 19 G-DIRECT-COMMAND := 'LIST LIST     '
    VALUE 20 G-DIRECT-COMMAND := 'MENU AREPORTS '
    VALUE 21 G-DIRECT-COMMAND := 'LIST ABUNDLES '
    VALUE 22 G-DIRECT-COMMAND := 'ADMIN         '
    VALUE 23 G-DIRECT-COMMAND := 'MENU MONITOR  '
    VALUE 24 G-DIRECT-COMMAND := 'MENU DEFAULTS '
    VALUE 25 G-DIRECT-COMMAND := 'LIST USERS    '
    VALUE 26 G-DIRECT-COMMAND := 'LIST CALENDARS'
    VALUE 27 G-DIRECT-COMMAND := 'LIST PRINTOUTS'
    VALUE 28 G-DIRECT-COMMAND := 'COPY SECURITY'
    VALUE 31 G-DIRECT-COMMAND := 'START ARCHIVE '
    VALUE 32 G-DIRECT-COMMAND := 'START REVIVER  '
    VALUE 34 G-DIRECT-COMMAND := 'EXIT           '
    VALUE 37 G-DIRECT-COMMAND := 'LIST PHYSICAL  '
    VALUE 40 G-DIRECT-COMMAND := 'LIST ARCHIVE   '
    ANY VALUE ESCAPE TOP
    NONE ESCAPE BOTTOM
  END-DECIDE
END-REPEAT
IF WITH-OBJECT (#CN)
  IF #TOK(2) = ' ' AND #DEFAULT-OBJECT(#CN) NE ' '
    #TOK(2) := #DEFAULT-OBJECT(#CN)
  END-IF
  #TOKEN-2 := #TOK(2)
  EXAMINE #OBJECTS(*) #TOKEN GIVING NUMBER #NOO INDEX #ON
  #C-CMD := #COMMAND (#CN)
  IF #ON NE 0
    MOVE EDITED #CN (EM=99) TO #SER-CN
    MOVE EDITED #ON (EM=99) TO #SER-ON
    EXAMINE FULL VALUE OF #CMD-OBJ (*) FOR #SER GIVING INDEX #FOUND
    IF #FOUND = 0
      RESET #ON
    END-IF
  END-IF
*
  IF #ON = 0 OR #TOKEN = ' '
    RESET #FUNC-TOK
    CV-MARK(*) := (AD=DP CD=TU)
    MOVE EDITED #CN(EM=99) TO #FT-CMD
    FOR #FT 1 TO #CONST-OBJTAB    /* F(017)
      IF #CMD-OBJ(#FT) = ' ' ESCAPE BOTTOM END-IF
      IF #CMD-OBJ(#FT) = MASK (.XX) #FUNC-TOK
        #FT-OBJ1 := VAL(#CO-OBJ(#FT))
        ADD 1 TO #OBJ-N
        #C-OBJ(#OBJ-N) := #OBJECTS(#FT-OBJ1)
        #C-OBJN(#OBJ-N) := #FT-OBJ1
        RESET CV-MARK(#OBJ-N)
      END-IF
    END-FOR
    I-OBJ := 1
    RESET L-MARK(*)
    CALLNAT 'RSRTOBJ' #C-OBJ-S(1:30)   /* SORT  OBJECTS
    REPEAT3.    REPEAT
      J := I-OBJ  + 9
      SET CONTROL 'WC16L24B5/45F'
      INPUT USING MAP 'N--CPOM&'
      IF *PF-KEY = 'PF3' ESCAPE ROUTINE END-IF
      FOR K I-OBJ TO J
        IF L-MARK(K) NE ' '
          #ON := #C-OBJN(K)
          RESET #NOO
          ESCAPE BOTTOM(REPEAT3.)
        END-IF
      END-FOR
      IF I-OBJ > #OBJ-N - 10
        I-OBJ := 1
      ELSE
        ADD 10 TO I-OBJ
      END-IF
    END-REPEAT
    IF WITH-VALUE(#CN) AND #TOK(3) = ' '
        AND #ON NE 5 /* MONITOR
      SET CONTROL 'WC5L32B7/48F'
      INPUT (IP=OFF) 'Object-Value' / #TOK(3)(AD=MDLT'_' AL=25)
    END-IF
  END-IF
  IF #NOO > 1  G-NATRP-ERC := 6005
    ESCAPE ROUTINE
  END-IF
END-IF
*
COMPRESS #CN-A #ON-A TO #FFFF LEAVING NO
* fhi     2016-06-09 NOMALL-1884 start insertion
RESET #PARAM1 #PARAM2
SEPARATE G-DIRECT-COMMAND
  INTO G-DIRECT-COMMAND #PARAM1 #PARAM2 IGNORE WITH DELIMITER ' '
* fhi     2016-06-09 NOMALL-1884 end   insertion
RESET G-DIRECT-COMMAND
DECIDE ON EVERY VALUE OF #CMD-REST(#CN)
  VALUE 'HELP' /* HELP COMMAND
    RESET G-DIRECT-COMMAND
    REINPUT USING HELP
  VALUE 'TECH'     /* TECH-FUNCTION
    SET CONTROL 'WB'
    FETCH RETURN 'NRMTECH'
  VALUE 'SET'    /* SET COMMAND
    PERFORM SET-COMMAND
  VALUE 'FLIP'
    PERFORM FLIP-HANDLE
  VALUE 'FOLLOW'
    PERFORM FOLLOW-MONITOR
  VALUE 'PROFILE'  /* PROFILE-FUNCTION
    FETCH RETURN 'RDEFPRF'
  VALUE 'SELECT'   /* Selection criteria
    FETCH RETURN 'RSELECT'
  VALUE 'MASSDEL'  /* Mass delete                 GGS01 >>
*   FETCH RETURN 'RMASSDEL'
* fhi     2016-06-09 NOMALL-1884 line above out, start insertion
    #PARAM1 := SUBSTR(#PARAM1,1,2)
    IF #PARAM1 = 'RE' /* direct command abbrevation does not
      #PARAM1 := 'RP' /* match expected parameter
    END-IF
    IF *USER = 'NATQA5'
      /* QA uses the MASSDEL function in Proterm tests. The tests record
      /* online functions and executed them in batch.
      /* In the new MASSDEL map, the field "Object Mask" is removed.
      /* This field however is included in the QE recordings (issuing a TAB,
      /* the field will be skipped). It is not possible to edit the recordings.
      /* About 300 tests would have to be newly recorded. To avoid this,
      /* for the QE tests using *USER= NATQA5, the old
      /* MASSDEL function will be called.
      FETCH RETURN 'RMASSDEL' #PARAM1 #PARAM2
    ELSE
      /* All modules for the new MASSDEL function start with RNMASS*.
      /* In addition, HNMASSD1 (Text) is needed. It's delivered in SYSNOMH1
      /* (Englisch) and in SYSNOMH2 (German).
      /* If only RNMASSDE is called, and not RMASSDE, modules NOM_MPAR,
      /* NOM_MKEY and NOM_MASK would be obsolete.
      FETCH RETURN 'RNMASSDE' #PARAM1 #PARAM2   /* << GGS01
    END-IF
* fhi     2016-06-09 NOMALL-1884 end   insertion
* fhi NOMALL-86 start insertion
  VALUE 'EXPORT'  /* Export NOM Objects
    FETCH RETURN 'REXPORT'
* fhi NOMALL-86 end   insertion
  VALUE 'XREF'     /* Cross reference
    FETCH RETURN 'RXREF'
  VALUE 'IXREF'     /* Cross reference
    FETCH RETURN 'RIXRF'
  VALUE 'VTAM' /*  , '>8.11'     /* NOMVPRNT
    SET CONTROL 'WB'
    FETCH RETURN 'RVTMOPT'
  ANY VALUE
    ESCAPE ROUTINE
  NONE VALUE IGNORE
END-DECIDE
*
RELEASE STACK
*
PERFORM COMMIT-WORK
COMPRESS #CN-A #ON-A TO #FFFF LEAVING NO
RESET G-DIRECT-COMMAND
DECIDE ON EVERY VALUE OF #CMD-REST(#CN)
  VALUE 'HELP' /* HELP COMMAND
    REINPUT USING HELP
  VALUE 'QUIT' /* END  COMMAND
    FETCH 'NATRPEND'
  VALUE 'ADD','MODIFY','DELETE','DISPLAY'
    IF #ON = 5
      FETCH #DEF-PROG(#ON)
    END-IF
    DECIDE ON FIRST VALUE OF #ON
      VALUE 1,29     /* ADDED ABILITY TO ACCESS USER-PROFILE
        IF #TOK(3) NE ' '
          G-C-USERID := #TOK(3)
        END-IF
      VALUE 2,20
        G-C-REPORT := #TOK(3)
      VALUE 3
        G-C-BUNDLE := #TOK(3)
      VALUE 4
        G-C-PRINTER := #TOK(3)
      VALUE 21
        G-C-PHYSICAL := #TOK(3)
      VALUE 12
        IF #CN = 1
          STACK TOP DATA #CODE (#CN)
        ELSE
          IF #TOK(4) IS (N4)
            #CALNAME := #TOK(3)
* xsetggr 2003-08-22 p(240465) insert 3 lines
            IF #CMD-REST(#CN) = 'DISPLAY'
              STACK TOP DATA 'D' #CALNAME #TOK(4)
            ELSE
              STACK TOP DATA 'M' #CALNAME #TOK(4)
            END-IF        /* xsetggr 2003-08-22 p(240465) insert
          ELSE
            G-NATRP-ERC := 2001
            ESCAPE ROUTINE
          END-IF
        END-IF
      VALUE 14,7
        IF #TOK(3) NE ' '
          G-C-LIST := #TOK(3)
        END-IF
      NONE VALUE IGNORE
    END-DECIDE
    G-C-FUNC := #CODE(#CN)
    FETCH #DEF-PROG(#ON)
  VALUE 'TRANSFER'
    FETCH #MIGRATE-PROG (#ON)
  VALUE 'FIN'
    TERMINATE
  VALUE 'TRACE'
    STACK TOP COMMAND 'RLISRP'
    FETCH 'RTRARP'
  VALUE 'LIST'
    DECIDE ON FIRST VALUE OF #ON
      VALUE  1 STACK TOP DATA FORMATTED #TOK(3)
      VALUE  2 STACK TOP DATA FORMATTED #TOK(3) #TOK(4) #TOK(5)
      VALUE  3 STACK TOP DATA FORMATTED #TOK(3)
      VALUE  4 STACK TOP DATA FORMATTED #TOK(3) #TOK (4)
      VALUE  7 STACK TOP DATA FORMATTED #TOK(3)
      VALUE  9 STACK TOP DATA FORMATTED #TOK(3) #TOK (4) #TOK (5)
      VALUE 12 STACK TOP DATA FORMATTED #TOK(3)
      VALUE 21 STACK TOP DATA FORMATTED #TOK(3)
      VALUE 13 STACK TOP DATA FORMATTED #TOK(3) #TOK(4)
      NONE IGNORE
    END-DECIDE
    FETCH #LIST-PROG(#ON)
  VALUE 'SHUTDOWN'
    FETCH 'RHANMO' G-WAIT-MINIMUM G-WAIT-MAXIMUM G-WAIT-INCREMENT 'C'
  VALUE 'START'
    IF NOT PROF-STARTUP = 'Y' AND #ON NE 21
      G-NATRP-ERC := 20
      ESCAPE ROUTINE
    END-IF
    IF #ON NE 21 AND #TOK(3) NE ' '
      RESET #TOK(3)
    END-IF
    DECIDE ON FIRST VALUE OF #ON
      VALUE 5         /* START MONITOR
        FETCH 'RHANMO' G-WAIT-MINIMUM G-WAIT-MAXIMUM G-WAIT-INCREMENT
          'S'
      VALUE 18       /* start archive task
        IF PROF-ARCHIVE NE 'Y'
          G-NATRP-ERC := 20
          ESCAPE ROUTINE
        END-IF
        CALLNAT 'RINIAR-N' 'ARC' G-USERID G-NATRP-ERC G-NATRP-ERT
        FETCH 'RADMIN'
      VALUE 19       /* start reviver task
        IF PROF-REVIVE NE 'Y'
          G-NATRP-ERC := 20
          ESCAPE ROUTINE
        END-IF
        CALLNAT 'RINIAR-N' 'REV' G-USERID G-NATRP-ERC G-NATRP-ERT
        FETCH 'RADMIN'
      VALUE 32       /* start condense task
        IF PROF-ARCHIVE NE 'Y'
          G-NATRP-ERC := 20
          ESCAPE ROUTINE
        END-IF
        CALLNAT 'RINIAR-N' 'CDN' G-USERID G-NATRP-ERC G-NATRP-ERT
        FETCH 'RADMIN'
      VALUE 21                     /* physical printer
        IF NOT (PROF-PHYSICAL = 'M' OR = 'P')
          G-NATRP-ERC := 20
          ESCAPE ROUTINE
        END-IF
        IF #TOK (3) = ' '
          SET CONTROL 'WC5L32B7/13F'
          INPUT (IP=OFF) 'Object-Value' (TU)
            / #TOK(3) (AD=MDLT'_' AL=25 CD=NE)
          SET CONTROL 'WMB'
        END-IF
        #PHYSICAL := #TOK(3)
        CALLNAT 'RHANPH-N' #PHYSICAL 'S' G-USERID G-NATRP-ERC
        IF G-NATRP-ERC = 0
          END TRANSACTION
        ELSE
          ESCAPE ROUTINE
        END-IF
      NONE VALUE IGNORE
    END-DECIDE
  VALUE 'LOGON'
    PERFORM LOGON-COMMAND
  VALUE 'MENU'
*
    RELEASE STACK
    DECIDE ON FIRST VALUE OF #ON
      VALUE 05 FETCH 'RHANMO'
      VALUE 08 FETCH 'RLISFO'
      VALUE 10 FETCH 'RMENU'
      VALUE 11 FETCH 'RADMIN'
      VALUE 30 FETCH 'RDFMEN'
      NONE IGNORE
    END-DECIDE
  VALUE 'SET'    /* SET COMMAND
    PERFORM SET-COMMAND
*
  VALUE 'COPY'    /* COPY COMMAND
    IF #ON NE 17 AND #TOK (3) = ' '
      SET CONTROL 'WC5L32B7/13F'
      INPUT (IP=OFF) 'Object-Value' (TU)
        / #TOK(3) (AD=MDLT'_' AL=25 CD=NE)
      SET CONTROL 'WMB'
    END-IF
    DECIDE ON FIRST VALUE OF #ON
      VALUE 17 IGNORE
      VALUE 01
        G-C-USERID := #TOK (3)
        STACK TOP DATA G-C-USERID
      VALUE 02 G-C-REPORT  := #TOK (3)
      VALUE 03 G-C-BUNDLE  := #TOK (3)
      VALUE 04 G-C-PRINTER := #TOK (3)
      VALUE 21
        G-C-PRINTER := #TOK (3)
        STACK TOP DATA G-C-PRINTER
      ANY      FETCH #COPY-PROG (#ON)
      NONE IGNORE
    END-DECIDE
  VALUE 'EXIT'
    G-NATRP-ERC := 9999
  VALUE 'ADMIN'
    FETCH 'RADMIN'
  VALUE 'TECH'
    FETCH RETURN 'NRMTECH'
  VALUE 'CONTENTS'
    G-C-BUNDLE := #TOK(3)
    FETCH 'RLISBR'
  VALUE 'DLOG'
    DECIDE ON FIRST VALUE OF #ON
      VALUE 1
        IF #TOK(3) NE ' '
          STACK TOP DATA #TOK(3)
        ELSE
          STACK TOP DATA G-USERID
        END-IF
        FETCH 'RLISLU'
      VALUE 5
        FETCH 'RLISLM1'
      VALUE 13
        FETCH 'RLISLP'
      NONE IGNORE
    END-DECIDE
  VALUE 'FLUSH'
    G-C-BUNDLE := #TOK(3)
    CALLNAT 'NOMFLUSH' G-C-BUNDLE G-NATRP-ERC
    IF G-NATRP-ERC = 0
      G-NATRP-ERT := G-C-BUNDLE
      G-NATRP-ERC := 7132 /* BUNDLE FLUSHED
    ELSE
      G-NATRP-ERC := 715 /* not open or does not exist
    END-IF
    FETCH 'RLISAB'
  VALUE 'SPF'
    CALLNAT 'N-SPFACT' G-USERID (AD=O) SPF-ACTIVE G-NATRP-ERC
      G-NATRP-ERT
    IF NOT SPF-ACTIVE
      G-NATRP-ERC := 24
      ESCAPE ROUTINE
    END-IF
    CALLNAT 'RGETLIB' #LIBRARY-ID
    STACK TOP COMMAND 'NRM 0'
    FETCH RETURN 'NRMPUTAI'
    STACK TOP COMMAND 'NRMGETAI'
    STACK TOP COMMAND 'LOGON' #LIBRARY-ID
    STACK TOP COMMAND 'SPF'
    RELEASE VARIABLES
    STOP
  VALUE 'FLIP'
    PERFORM FLIP-HANDLE
  VALUE 'UP'
    G-DIRECT-COMMAND := 'UP'
    IF #TOK(2) IS (N2)
      G-SCROLL-AMOUNT := VAL(#TOK(2))
    END-IF
    G-NATRP-ERC := 9997
  VALUE 'DOWN'
    G-DIRECT-COMMAND := 'DOWN'
    IF #TOK(2) IS (N2)
      G-SCROLL-AMOUNT := VAL(#TOK(2))
    END-IF
    G-NATRP-ERC := 9997
  VALUE 'TOP'
    G-DIRECT-COMMAND := 'TOP'
    G-NATRP-ERC := 9997
  VALUE 'BOT'
    G-DIRECT-COMMAND := 'BOT'
    G-NATRP-ERC := 9997
  VALUE 'NRM'
    STACK TOP COMMAND 'NRM' '*' #TOK(2) #TOK(3)
    STOP
  VALUE 'FOLLOW'
    PERFORM FOLLOW-MONITOR
  VALUE 'PROFILE'  /* PROFILE-FUNCTION
    FETCH RETURN 'RDEFPRF'
  VALUE 'CLOSE'
    IF NOT(PROF-PHYSICAL = 'M' OR = 'P')
      G-NATRP-ERC := 20
      ESCAPE ROUTINE
    END-IF
    IF #TOK (3) = ' '
      SET CONTROL 'WC5L32B7/13F'
      INPUT (IP=OFF) 'Object-Value' (TU)
        / #TOK(3) (AD=MDLT'_' AL=25 CD=NE)
      SET CONTROL 'WMB'
    END-IF
    #PHYSICAL := #TOK(3)
    CALLNAT 'RHANPH-N' #PHYSICAL 'C' G-USERID G-NATRP-ERC
    IF G-NATRP-ERC = 0
      END TRANSACTION
    ELSE
      ESCAPE ROUTINE
    END-IF
  NONE VALUE IGNORE
END-DECIDE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE SET-COMMAND
************************************************************************
DECIDE ON FIRST VALUE OF #ON
  VALUE 15     /* SET AUTOCOMMIT FLAG
    IF #TOK(3) = 'ON'
      G-AUTOCOMMIT := 'I'
    END-IF
    IF #TOK(3) = 'OFF' OR = 'OF'
      G-AUTOCOMMIT := 'E'
    END-IF
  VALUE 22     /* SET CONFIRM ON/OFF
    DECIDE ON FIRST VALUE OF #TOK(3)
      VALUE ' ','ON'    G-CONFIRM := TRUE
      VALUE 'OFF','OF'  G-CONFIRM := FALSE
      NONE VALUE IGNORE
    END-DECIDE
  VALUE 28     /* SET TEST ON/OFF
    DECIDE ON FIRST VALUE OF #TOK(3)
      VALUE ' ','ON'    G-TEST-MODE := TRUE
      VALUE 'OFF','OF'  G-TEST-MODE := FALSE
      NONE VALUE IGNORE
    END-DECIDE
  VALUE 16                    /* SET LANGUAGE
    IF NOT(#TOK(3) IS (N1))
      G-NATRP-ERC := 36
      ESCAPE ROUTINE
    END-IF
    #TOKEN := #TOK(3)
    #NUM := VAL(#TOKEN)
    IF NOT(#NUM = 1 THRU 2)
      G-NATRP-ERC := 36
      ESCAPE ROUTINE
    END-IF
    IF #NUM NE *LANGUAGE
      RESET G-LCB G-PFB G-OTB G-TXB
    END-IF
    *LANGUAGE := #NUM
    G-LANGUAGE := #NUM
  NONE VALUE IGNORE
END-DECIDE
*
END-SUBROUTINE /* SET-COMMAND
*
************************************************************************
DEFINE SUBROUTINE LOGON-COMMAND
************************************************************************
#APPLIC-TOKEN := 'APPLICATION'
EXAMINE #TOK (2) FOR 'x' GIVING LENGTH #L
IF #L = 3 THRU 10
  RESET #APL (#L + 1:11)
END-IF
*
IF #TOK (2) NE #APPLIC-TOKEN
  FETCH 'NRM'  '*' #TOK(2) #TOK(3) #TOK(4)
END-IF
*
NSCL-APPLID := #TOK (3)
PERFORM LOGON-ALLOWED
IF NOT LOGON-ALLOWED
  G-NATRP-ERC := 0020
  ESCAPE ROUTINE
END-IF
*
FETCH RETURN 'NRMPUTGL'
STACK TOP COMMAND 'RRETURN'
FETCH RETURN 'NRMPUTAI'
STACK TOP COMMAND 'NRMGETAI'
CALLNAT 'RGETLIB' #LIBRARY-ID
STACK TOP COMMAND 'LOGON' #LIBRARY-ID
COMPRESS 'LOGON'  #TOK (3) INTO #LOGON
IF #TOK (4) NE ' '
  STACK TOP COMMAND #TOK (4)
END-IF
STACK TOP COMMAND #LOGON
RELEASE VARIABLES
STOP
*
END-SUBROUTINE /* LOGON-COMMAND
*
************************************************************************
DEFINE SUBROUTINE LOGON-ALLOWED
************************************************************************
LOGON-ALLOWED := TRUE
CALLNAT 'NSC-ACT' SECURITY-ACTIVE
IF NOT SECURITY-ACTIVE
  ESCAPE ROUTINE
END-IF
*
NSCL-USERID := *USER
RESET NSCL-PPARM1
CALLNAT 'NSC---L' NSCL-APPLID NSCL-USERID NSCL-ERC NSCL-PPARM1
IF NSCL-ERC NE 0
  LOGON-ALLOWED := FALSE
END-IF
*
END-SUBROUTINE /* LOGON-ALLOWED
*
END
