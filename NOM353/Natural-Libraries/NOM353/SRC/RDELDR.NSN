* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RDELDR    DELETE REPORT FROM DATASET REPORT
*
* Maintenance
*
* mrs 91-10-17    change expiration date if active report is deleted
* mwi 96-09-06 s(253359) eot after 50 updates
* xsiszha 2000-08-01 (CE7461) Extend Report and Bundle Names
* xsetggr 2007-05-02 NOM3201  Support P11 format run numbers
* SU1     2013-01-31 unused      Deactivate unused data areas
* SU2     2014-11-05 NOMALL-1450 fill fields for Adabas Vista
* SU3     2016-01-20 NOMALL-1802 do not update Adabas Vista fields
* ----------------------------------------------------------------------
DEFINE DATA
PARAMETER
1 G-C-REPORT     (A25)
1 G-C-REPRNB     (P11)
* *****
LOCAL USING VDSNRP-L
LOCAL
1 #DR-REPORT-RNB (A31)
1 REDEFINE #DR-REPORT-RNB
  2 #REPNAME     (A25)
  2 #REPRNB      (P11)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#REPNAME := G-C-REPORT
#REPRNB := G-C-REPRNB
FIND DATASET-REPORT WITH DR-REPORT-RNB = #DR-REPORT-RNB
  DR-STATUS := 'D'
  IF DATASET-REPORT.DR-EXPIRATION-DATE-ORIG = ' '
    DATASET-REPORT.DR-EXPIRATION-DATE-ORIG :=
      DATASET-REPORT.DR-EXPIRATION-DATE
  END-IF
  MOVE EDITED *DATX (EM=YYYYMMDD) TO DR-EXPIRATION-DATE
/*SU3 DR-OBJECT-TYPE := 'DR' /*SU2
/*SU3 DR-OBJECT-TIME := *TIMX /*SU2
  UPDATE
  IF *COUNTER > 50
    END OF TRANSACTION
    RESET *COUNTER
  END-IF
END-FIND
END TRANSACTION
*
END
