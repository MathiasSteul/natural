* <Natural Source Header
* Member    RDEFPR-N
* Version   1.3
* Function  Build array for logical printer attributes
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* gw  93-05-26           created
* mrs 93-11-15 s(999999) p-printer-type commented out
* fhi 02-10-30 fhi101    switch on optimizer compiler
* sju 03-05-20 p(240452) don't suppress email duplicate attributes
* fhi 10-07-28 NOMALL-838 Avoid 1316 in 840
* xsetggr 2010-11-03 NOMALL-865 restow due to changes in EOMPHTYE
* fhi     2014-08-26 NOMALL-1475 Recat for new field 'FORMATTER'
* SU1     2016-08-01 NOMALL-1518 NOM3.5 deactivate opt.Compiler
* ----------------------------------------------------------------------
/*SU1 OPTIONS MCG=(INDX=ON,OVFLW=ON,DIGTCHCK=ON) /*fhi101 inserted
DEFINE DATA PARAMETER
1 RDEFPR-FROM-OCC                    (I1)
1 RDEFPR-P-ATTRIBUTES                (A95/1:25)
1 REDEFINE  RDEFPR-P-ATTRIBUTES
  2 RDEFPR-P-ATTRIBUTES-R          (25)
    3 RDEFPR-P-IDENT             (I1)
    3 RDEFPR-P-LENGTH            (N2)
    3 RDEFPR-P-PROMPT            (N4)
    3 RDEFPR-P-VAR               (A16)
    3 RDEFPR-P-VAL-1             (A1/1:72)
    3 REDEFINE  RDEFPR-P-VAL-1
      4 RDEFPR-P-VALUE         (A72)
1 RDEFPR-MAP                         (11)
  2 #MAP-VALUE-FROM-COL            (I2)
  2 #MAP-VALUE-TO-COL              (I2)
  2 #MAP-LINE                      (A77)
  2 REDEFINE #MAP-LINE
    3 RDEFPR-MAP-A1              (A1/1:77)
* ----------------------------------------------------------------------
LOCAL USING EOMPHTYE
LOCAL USING XXGMSG-A
LOCAL
1 #I                                 (I2)
1 #J                                 (I2)
1 #K                                 (I2)
1 #L                                 (I2)
1 #IX                                (I2)
1 #DOTS                              (A77)
  INIT <'.........................' -
  '.........................' -
  '.........................' -
  '..'>
1 #PROMPT-LENGTH                     (I2)
1 #MAX-OCC                           (I2) CONST <11>
/*SU1 1 #MAP-FIELD-LENGTH                  (I2/1:#MAX-OCC)
1 #PREV-LINE                         (A77)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
IF RDEFPR-FROM-OCC = 0
  RDEFPR-FROM-OCC := 1
END-IF
*
FOR #I 1 #MAX-OCC
  #IX := #I + RDEFPR-FROM-OCC - 1
  IF RDEFPR-P-LENGTH (#IX) = 0
    ESCAPE TOP
  END-IF
  PERFORM GET-PROMPT-TEXT
  EXAMINE #XX-SHORT-TEXT FOR ' ' GIVING LENGTH #K
  IF #PROMPT-LENGTH < #K
    #PROMPT-LENGTH := #K
  END-IF
  COMPRESS H'01' #XX-SHORT-TEXT TO #MAP-LINE (#I) LEAVING NO
  COMPRESS #MAP-LINE (#I) #DOTS TO #MAP-LINE (#I)
  IF #MAP-LINE (#I) = #PREV-LINE AND NOT #XX-ERROR-CODE = 5158 THRU 5159
    #MAP-LINE (#I) := H'01'
  ELSE
    #PREV-LINE := #MAP-LINE (#I)
  END-IF
END-FOR
ADD 3 TO #PROMPT-LENGTH
IF #PROMPT-LENGTH < 21
  #PROMPT-LENGTH := 21
END-IF
FOR #I 1 #MAX-OCC
  #IX := #I + RDEFPR-FROM-OCC - 1
  IF RDEFPR-P-LENGTH (#IX) = 0
    #MAP-LINE (#I) := H'01' /* fhi 2010-07-28 NOMALL-838 was (#IX)
    ESCAPE TOP
  END-IF
  #J := RDEFPR-P-LENGTH (#IX)
  RDEFPR-MAP-A1 (#I,#PROMPT-LENGTH) := H'02'
  #K := #PROMPT-LENGTH + 1
  #L := #PROMPT-LENGTH + #J
  IF #L > 77
    #L := 77
  END-IF
  #MAP-VALUE-FROM-COL (#I) := #K
  #MAP-VALUE-TO-COL          (#I) := #L
  #J := #L - #K + 1
  RDEFPR-MAP-A1 (#I,#K : #L ) := RDEFPR-P-VAL-1 (#IX,1:#J)
  IF #L < 77
    RDEFPR-MAP-A1 (#I,#L + 1)                := H'01'
    RESET  RDEFPR-MAP-A1 (#I,#L + 2 : 77)
  END-IF
END-FOR
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE GET-PROMPT-TEXT
************************************************************************
#J := #I + RDEFPR-FROM-OCC - 1
#XX-ERROR-CODE := RDEFPR-P-PROMPT (#J)
CALLNAT 'XXGMSG-N' #XX-GMSG-PARMS
*
END-SUBROUTINE /* GET-PROMPT-TEXT
*
END
