* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RDELGRT - delete grant record for an object
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* gw  96-09-17 s(999999) cleaned up
* xsiszha 2000-07-31 (CE7461) Extend Report and Bundle Names
* fhi     2011-05-02 NOMALL-901 Log any online delete operation
* xsetggr 2012-12-16 NOMALL-89 implement call pf EOMGRM-N
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 #USERID   (A8)
1 #OBJTYPE  (A1)
1 #OBJNAME  (A25)
************************************************************************
LOCAL USING EOM----E
LOCAL USING EOMGRM-P
LOCAL USING EOMMSG-P
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
EOMGRM-I-AUTO-COMMIT := 100
IF #OBJTYPE = 'U'
  PERFORM DELETE-GRANTS-OF-USER
ELSE
  EOMGRM-I-TYPE := #OBJTYPE
  EOMGRM-I-NAME := #OBJNAME
  RESET EOMGRM-I-USER
  CALLNAT 'EOMGRM-N' EOM-DELETE-ALL EOMGRM-PARMS EOMMSG-PARMS
END-IF
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE DELETE-GRANTS-OF-USER
************************************************************************
RESET EOMGRM-I-TYPE
RESET EOMGRM-I-NAME           /* all grants for user= del list
EOMGRM-I-USER := #OBJNAME
CALLNAT 'EOMGRM-N' EOM-DELETE-ALL EOMGRM-PARMS EOMMSG-PARMS
*
END-SUBROUTINE /* DELETE-GRANTS-OF-USER
*
END
