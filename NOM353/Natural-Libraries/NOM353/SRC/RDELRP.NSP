* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    RDELRP
* Version   1.3
* Function  Delete a Report
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* mrs 93-06-12 s(999999) rewritten
* mrs 93-08-09 s(999999) allow lower case in N-CNFRM
* jvd 94-03-14 p(163021) create mass delete function
* jvd 97-07-08 p(163579) Separator page truncation
*                        re-cat as changes made to EOMRPM-P
* wcd 00-04-01 CE 7267   re-cat as changes made to EOMRPM-E, EOMRPM-P
* xsiszha 2000-08-11 (CE7461) Extend Report and Bundle Names
* XSETHZ 2003-04-24 s(229252)
*        confirm deletion of reports with active reports
* xsetggr 2003-08-19 p(240465) accept non-defined-userid
* xsetggr 2007-08-30 NOM3201  Support P11 format run numbers
* fhi     2013-08-29 FHI285    Enhance error message 406
* SU1     2013-11-22 NOMALL-1288 No tags, only restructured
* fhi     2014-08-26 NOMALL-1475 Recat for new field 'FORMATTER'
* ----------------------------------------------------------------------
DEFINE DATA GLOBAL USING NRM-GL
* -----------------------------LDA's------------------------------------
LOCAL  USING EOM----E
LOCAL  USING EOM----P
LOCAL  USING EOMRPM-E
LOCAL  USING EOMRPM-P
LOCAL  USING EOMMSG-P
LOCAL  USING XXGMSG-A
* -----------------------------local Variables--------------------------
LOCAL
1 ACTIVE-REPORTS VIEW  OF  NRM-ACTIVE-REPORTS
1 USERS VIEW OF NRM-USERS
1 REPORT VIEW OF NRM-REPORTS-NEW
  2 R-REPNAME
*
1 #FATHER-PROG           (A8) INIT <'RLISRP'>
1 #OBJECT-NAME           (A32)
1 #CONFIRMED             (L)
1 LOWER-CASE             (L) CONST <FALSE>
1 #MASS-RPNAME           (A25)
1 REDEFINE #MASS-RPNAME
  2 #MASS-ARPNAME        (A1/1:25)
1 #MASS-START-RPNAME     (A25)
1 REDEFINE #MASS-START-RPNAME
  2 #MASS-SRPNAME        (A1/1:25)
1 #MASS-END-RPNAME       (A25)
1 REDEFINE #MASS-END-RPNAME
  2 #MASS-ERPNAME        (A1/1:25)
1 #AR-REP-RNB            (A31)
1 REDEFINE #AR-REP-RNB
  2 #AR-REP              (A25)
  2 #AR-RNB              (P11)
1 #AR-REP-RNB-E          (A31)
1 REDEFINE #AR-REP-RNB-E
  2 #AR-REP-E            (A25)
  2 #AR-RNB-E            (P11)
1 #IND1                  (I2)
1 #ANS-COMMIT            (A1)
1 #MASS-DELETE           (L)
1 #FOUND-1               (L)
1 #MASS-DEL-REC          (I2)
1 #MASS-DEL-FOUND        (N7)
1 #MASS-NOT-DEL          (I2)
1 #MASS-RPNAME-LENG      (N2) INIT <25> /* Check DB for correct length
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
G-NATRP-ERC := 17
RESET G-NATRP-ERT
*
EOMRPM-I-NAME := G-C-REPORT
*
EOM-USER-PROFILE := G-USER-PROFILE
EOM-USER         := G-USERID
EOM-USER-TYPE    := G-USER-TYPE
FIND (1) USERS WITH USER-ID = G-USERID
  IF NO RECORDS FOUND
    EOM-DEF-USER := 'Y'
  END-NOREC
END-FIND
EOM-LANGUAGE := *LANGUAGE
#MASS-RPNAME := EOMRPM-I-NAME
#MASS-DELETE := FALSE
*
RESET  EOM-LOGGING                          /* ????????????????
IF G-LOG-REP                                /* ????????????????
  EOM-LOG-TYPES (1) := 'R'                 /* ????????????????
END-IF                                      /* ????????????????
*
PERFORM CHECK-MASS-NAME
IF #MASS-DELETE
  PERFORM COUNT-MASS-DELETE
  IF #MASS-DEL-REC LT 1
    EOMMSG-NR := 0490
    G-NATRP-ERC := EOMMSG-NR
    G-NATRP-ERT := EOMMSG-TOKEN (1)
    INCLUDE C-ESCAPE
  ELSE
    #MASS-DEL-FOUND := #MASS-DEL-REC
    PERFORM MASS-DELETE
  END-IF
ELSE
  PERFORM RDEL-EOM-READ
  IF EOMMSG-NR NE 0
    G-NATRP-ERC := EOMMSG-NR
    G-NATRP-ERT := EOMMSG-TOKEN (1)
    INCLUDE C-ESCAPE
  END-IF
  PERFORM RDEL-SECURITY-CHECK
  IF EOMMSG-NR NE 0
    G-NATRP-ERC := EOMMSG-NR
    G-NATRP-ERT := EOMMSG-TOKEN (1)
    INCLUDE C-ESCAPE
  END-IF
  PERFORM RDEL-CONFIRM
END-IF
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE RDEL-EOM-READ
************************************************************************
EOM-FUNCTION := EOM-READ
EOMRPM-I-ATTRIBUTE-TYPE := REPORT-GENERAL-ATTRIBUTES
CALLNAT 'EOMRPM-N' EOM-PARMS EOMRPM-PARMS EOMMSG-PARMS
*
END-SUBROUTINE /* RDEL-EOM-READ
*
************************************************************************
DEFINE SUBROUTINE RDEL-SECURITY-CHECK
************************************************************************
EOM-FUNCTION := EOM-SECURITY-CHECK
EOMRPM-I-CHECK-FUNCTION := EOM-DELETE
CALLNAT 'EOMRPM-N' EOM-PARMS EOMRPM-PARMS EOMMSG-PARMS
*
END-SUBROUTINE /* RDEL-SECURITY-CHECK
*
************************************************************************
DEFINE SUBROUTINE RDEL-CONFIRM
************************************************************************
IF G-CONFIRM
  #OBJECT-NAME := G-C-REPORT
  #AR-REP := G-C-REPORT
  #AR-REP-E := G-C-REPORT
  #AR-RNB := 0
  #AR-RNB-E := 99999999999              /* xsetggr NOM3201 chage
  FNA. FIND NUMBER ACTIVE-REPORTS
    WITH AR-REPORT-RNB = #AR-REP-RNB THRU #AR-REP-RNB-E
  IF *NUMBER (FNA.) > 0
    #XX-ERROR-CODE := 2120
    RESET #XX-MSG-DYNA(*)
    INCLUDE XXGMSG-C
    G-NATRP-ERT := #XX-SHORT-TEXT
    EXAMINE G-NATRP-ERT FOR ':1:' REPLACE G-C-REPORT
  END-IF
  CALLNAT 'N-CNFRM' #OBJECT-NAME 'R' G-DISPLAY-LONG-NAMES
    #CONFIRMED G-NATRP-ERT LOWER-CASE
  RESET G-NATRP-ERT
END-IF
*
IF #CONFIRMED OR NOT G-CONFIRM
  EOM-FUNCTION := EOM-DELETE
  CALLNAT 'EOMRPM-N' EOM-PARMS EOMRPM-PARMS EOMMSG-PARMS
  IF EOMMSG-NR NE 0
    G-NATRP-ERC := EOMMSG-NR
    G-NATRP-ERT := EOMMSG-TOKEN (1)
    BACKOUT TRANSACTION
  ELSE
    END OF TRANSACTION
    G-NATRP-ERC := 18
  END-IF
END-IF
INCLUDE C-ESCAPE
*
END-SUBROUTINE /* RDEL-CONFIRM
*
************************************************************************
DEFINE SUBROUTINE CHECK-MASS-NAME
************************************************************************
#FOUND-1 := TRUE
#IND1 := #MASS-RPNAME-LENG
*
IF #MASS-ARPNAME (1) = '*' AND #MASS-ARPNAME (2) = ' ' /*Not MASS DELETE
  ESCAPE ROUTINE
END-IF
* Build start and end for mass delete key
REP1. REPEAT UNTIL #IND1 LT 1
  DECIDE FOR FIRST CONDITION
    WHEN #MASS-ARPNAME (#IND1) = ' '
      #MASS-SRPNAME (#IND1) := H'00' /* Build start and
      #MASS-ERPNAME(#IND1) := H'FF' /* end key values
    WHEN #MASS-ARPNAME (#IND1) = '*' AND #FOUND-1  AND
        #MASS-ARPNAME (#IND1 + 1) = ' '
      #MASS-SRPNAME (#IND1) := H'00' /* When first * found
      #MASS-ERPNAME(#IND1) := H'FF' /* build key values and
      #FOUND-1 := FALSE /* set Mass Delete on
      #MASS-DELETE := TRUE
    WHEN #MASS-ARPNAME (#IND1) NE ' '         /* move value to key
      #MASS-SRPNAME (#IND1):=#MASS-ERPNAME(#IND1):=#MASS-ARPNAME(#IND1)
    WHEN NONE IGNORE
  END-DECIDE
  SUBTRACT 1 FROM #IND1
END-REPEAT
*
END-SUBROUTINE /* CHECK-MASS-NAME
*
************************************************************************
DEFINE SUBROUTINE COUNT-MASS-DELETE
************************************************************************
HGET. HISTOGRAM REPORT FOR R-REPNAME FROM #MASS-START-RPNAME
    ENDING AT #MASS-END-RPNAME
*
END-HISTOGRAM
#MASS-DEL-REC := *COUNTER (HGET.)
*
END-SUBROUTINE /* COUNT-MASS-DELETE
*
************************************************************************
DEFINE SUBROUTINE MASS-DELETE
************************************************************************
SET CONTROL 'WC8L58B10/11F'
ANS. REPEAT    /* Send Mass DELETE Confirm
  RESET #ANS-COMMIT
  INPUT WITH TEXT ' ' ALARM USING MAP 'RDELRM&'
  IF #ANS-COMMIT = 'N'
    ESCAPE ROUTINE
  END-IF
  IF #ANS-COMMIT = 'Y'
    ESCAPE BOTTOM (ANS.)
  END-IF
END-REPEAT
*
HDEL. HISTOGRAM REPORT FOR R-REPNAME FROM #MASS-START-RPNAME
    ENDING AT #MASS-END-RPNAME
*
  EOMRPM-I-NAME := R-REPNAME
  PERFORM RDEL-EOM-READ
  IF EOMMSG-NR NE 0
    ADD 1 TO #MASS-NOT-DEL
    ESCAPE TOP
  END-IF
  PERFORM RDEL-SECURITY-CHECK
  IF EOMMSG-NR NE 0
    ADD 1 TO #MASS-NOT-DEL
    ESCAPE TOP
  END-IF
  EOM-FUNCTION := EOM-DELETE
  CALLNAT 'EOMRPM-N' EOM-PARMS EOMRPM-PARMS EOMMSG-PARMS
*
  IF EOMMSG-NR NE 0
    BACKOUT TRANSACTION
  ELSE
    END OF TRANSACTION
    G-NATRP-ERC := 18
  END-IF
*
END-HISTOGRAM
*
END-SUBROUTINE /* MASS-DELETE
*
END
