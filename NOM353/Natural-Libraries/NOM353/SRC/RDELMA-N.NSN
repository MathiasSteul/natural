* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RDELMA-N - Delete Mail Records of a given active Report
*
* Maintenance
* uuu     yyyy-mm-dd s(999999) Description
* xsiszha 2000-08-01 (CE7461)  Extend Report and Bundle Names
* xsetggr 2007-05-02  NOM3201  change run number format to P11
* fhi     2011-05-02 NOMALL-901 Log any online delete operation
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 P-REPNAME        (A25)
1 P-REPRNB         (P11)
************************************************************************
LOCAL
1 MAIL-REPORTS VIEW OF NRM-MAIL
  2 MA-REPNAME
  2 MA-REPRNB
*
1 #MA-NR           (A31)
1 REDEFINE #MA-NR
  2 #REPNAME       (A25)
  2 #REPRNB        (P11)
1 #OBJ             (A50)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#REPNAME := P-REPNAME
#REPRNB := P-REPRNB
READ MAIL-REPORTS BY MA-REP-RNB = #MA-NR
  IF MA-REPNAME NE #REPNAME OR MA-REPRNB  NE #REPRNB
    ESCAPE BOTTOM
  END-IF
  DELETE
  COMPRESS #REPNAME '/' #REPRNB TO #OBJ LEAVING NO
  PERFORM RMLOGDEL #OBJ 'MAIL'
  IF *COUNTER > 50
    END OF TRANSACTION
    RESET *COUNTER
  END-IF
END-READ
END TRANSACTION
*
END
