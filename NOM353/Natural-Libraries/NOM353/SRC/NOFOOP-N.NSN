* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* NOFOOP-N - NOM API Folder Maintenance
*
* Hint (HEB 2021-03-19):
* - GUI:
*   The "General Attributes" of a "Folder Definition":
*   - List Layout
*   - Default Location
*   are not required.
*   The list layout can be defined by the user (column order and column
*   show/hide) and the locations are listed in separate folders.
*
* Maintenance:
* XSETHZ  2002-05-13 created
* XSETHZ  2002-05-22
* XSETHZ  2002-06-04
* XSETGGR 2002-11-14 use new parameter ES-APP-SERVER-LIBRARY
* sju     2003-03-04 use new message 366 instead of 363
* fhi     2007-07-12 NOM3202   C-NATERR changed, NAD23006 is obsolete.
* xsetggr 2007-12-19 p(300375) add fo-default-location to nrm-folder
* xsetggr 2008-02-08 Option LS, if AR not exist
* xsetggr 2008-04-10 restow
* XSETHZ  2008-07-23 p(307577) use full name of ES-APP-SERVER-LIBRARY
* fhi     2010-09-03 NOMALL-97 Extend message line
* XSETHZ  2010-11-08 NOMALL-883
* XSETHZ  2010-12-15 NOMALL-907
* XSETHZ  2011-03-18 NOMALL-883
* XSETGGR 2011-08-02 nomall-902 correct NOM0369 handling
* xsetggr 2011-11-08 NOMALL-1069 do not allow cross-links
* xsetggr 2011-11-29 NOMALL-1069 corrections
* xsetggr 2013-01-02 NOMALL-89 maintain folder grants
* XSETHZ  2013-02-14 ES-1499 (new descriptors in NRM-MAIL)
* SU1     2018-02-15 NOMALL-1823 NOM 3.5: remove CONNECT
* CF1     2019-01-21 NOMALL-1964 Check if folder contains Active Reports
* fhi     2019-05-13 NOMALL-2272 Correct evaluation of time inverted
* ------------------------------------------------------------------
DEFINE DATA
PARAMETER USING ESMCNT-A
PARAMETER USING ESMINP-A
PARAMETER USING NOFOOP-A
************************************************************************
LOCAL USING NADA2000
LOCAL USING NAD-MSG
LOCAL USING NAD-FLD
LOCAL USING CONST-L
LOCAL
1 FO VIEW OF NRM-FOLDER
  2 FO-NAME
  2 FO-USER-ID
  2 FO-ID
  2 FO-DESC
  2 FO-MAP-LAYOUT
  2 FO-LINKED-FO-ID
  2 REDEFINE FO-LINKED-FO-ID
    3 FO-LINKED-USER-ID  (A8)
    3 FO-LINKED-ID       (B2)
  2 FO-DEFAULT-LOCATION
1 NEW-FO VIEW OF NRM-FOLDER
  2 FO-USER-FO-ID
  2 REDEFINE FO-USER-FO-ID
    3 FO-USER            (A8)
    3 FO-NEWID           (B2)
1 LINKED-FO VIEW OF NRM-FOLDER
  2 FO-ID
  2 FO-USER-ID
  2 FO-NAME
  2 FO-LINKED-FO-ID
  2 REDEFINE FO-LINKED-FO-ID
    3 FO-LINKED-USER-ID  (A8)
    3 FO-LINKED-ID       (B2)
  2 FO-DEFAULT-LOCATION
1 OWN-FOLD VIEW OF NRM-FOLDER
  2 FO-USER-ID
  2 FO-NAME
  2 FO-LINKED-FO-ID
1 GRANTS VIEW OF NRM-GRANTS
  2 GR-OBJECT-TYPE
  2 GR-USERID
  2 GR-OBJECT-NAME
  2 GR-OPTION            (6)
1 US VIEW OF NRM-USERS
1 MA-EXT VIEW OF NRM-MAIL
  2 MA-FOLDER-TIME
1 #ES-CONTROL                (A250)
1 #ES-INPUT-AREA             (A253/1:3)
1 #ES-MSG-PREF               (A7) INIT <'NOM'>
1 REDEFINE #ES-MSG-PREF
  2 #ES-MSG-NOM              (A3)
  2 #ES-MSG-NR               (N4)
1 #ES-MSG-FIELD              (A32)
1  REDEFINE #ES-MSG-FIELD
  2 #ES-MSG-FIELD-NAME       (A28)
  2 #ES-MSG-FIELD-INDEX      (N4)
1 #S-USER-FO-ID              (A10)
1 REDEFINE #S-USER-FO-ID
  2 #S-USER                  (A8)
  2 #S-FO-ID                 (B2)
1 #E-USER-FO-ID              (A10)
1 REDEFINE #E-USER-FO-ID
  2 #E-USER                  (A8)
  2 #E-FO-ID                 (B2)
1 #FO-USER-NAME              (A24)
1 REDEFINE #FO-USER-NAME
  2 #FO-USER-ID              (A8)
  2 #FO-NAME                 (A16)
1 #F-FOLDER-TIME             (A17)
1 REDEFINE #F-FOLDER-TIME
  2 #F-USER-ID               (A8)
  2 #F-FO-ID                 (B2)
  2 #F-TIME                  (P13)
1 #T-FOLDER-TIME             (A17)
1 REDEFINE #T-FOLDER-TIME
  2 #T-USER-ID               (A8)
  2 #T-FO-ID                 (B2)
  2 #T-TIME                  (P13)
1 #MA-FOLDER-REP             (A41)
1 REDEFINE #MA-FOLDER-REP
  2 #MA-USERID               (A8)
  2 #MA-FO-ID                (B2)
  2 #MA-REPNAME              (A25)
1 #MA-FOLDER-REP-E           (A41)
1 #GR-SUPER                  (A34)
1 REDEFINE #GR-SUPER
  2 #GR-T                    (A1)
  2 #GR-U                    (A8)
  2 #GR-N                    (A25)
1 #FOLDER                    (I4)
1 #FO-NUMBER                 (N5)
1 REDEFINE #FO-NUMBER
  2 #FO-NUMBER-A             (A5)
1 #LOG-MSG                   (L)
1 #GRANTS                    (A1/6)
1 #LS-USERID                 (A8)
1 #LN-USER-ID                (A8)
1 #MSG-TXT                   (A32)
1 #MSG-TXT1                  (A32)
1 #OPTIONS                   (A1/6)
1 #GR-TYPE-NAME              (A26)
1 REDEFINE #GR-TYPE-NAME
  2 #GR-OBJ-TYPE             (A1)
  2 #GR-OBJ-NAME             (A25)
1 #FUNC                      (A1)
1 #FO-LINKED-FO-ID           (A10)
1 REDEFINE #FO-LINKED-FO-ID
  2 #FO-LINKED-USER          (A8)
  2 #FO-LINKED-ID            (B2)
1 #FO-USER-FO-ID             (A10)
1 REDEFINE #FO-USER-FO-ID
  2 #FO-USER                 (A8)
  2 #FO-ID                   (B2)
1 #CNT                       (I4)
1 #FOLDER-ID                 (B2)
1 #FOLDER-NAME               (A25)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET ES-RC
#ES-CONTROL := ES-CONTROL
#ES-INPUT-AREA(*) := ES-INPUT-AREA(*)
DECIDE ON FIRST VALUE OF ES-FUNCTION
  VALUE 'OP'
    DECIDE ON FIRST VALUE OF ES-EXTEND-FUNCTION
      VALUE ' '
        PERFORM READ-RECORD
      VALUE 'NEW'
        PERFORM NEW-RECORD
        IF ES-RC = 0
          END TRANSACTION
        END-IF
      VALUE 'UPD'
        PERFORM UPDATE-RECORD
        IF ES-RC = 0
          END TRANSACTION
        END-IF
      VALUE 'CHK'
        IF ES-ORIG-FUNCTION = 'NW'
          PERFORM NEW-RECORD
        ELSE
          PERFORM UPDATE-RECORD
        END-IF
      NONE VALUE IGNORE
    END-DECIDE
  NONE VALUE IGNORE
END-DECIDE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE READ-RECORD
************************************************************************
RESET NOFO-PARMS
RESET #ES-MSG-FIELD #ES-MSG-NR
* #FO-USER-ID := ES-USER
* #FO-NAME    := ES-KEY-PARM(1)
IF ES-KEY-PARM-COUNT = 1
  #FO-USER-ID := ES-USER
  #FO-NAME    := ES-KEY-PARM(1)
ELSE
  #FO-USER-ID := ES-KEY-PARM(1)
  #FO-NAME    := ES-KEY-PARM(2)
END-IF
IF #FO-NAME = '#Inbasket' OR = '#Listeneingang'
  #S-USER := #FO-USER-ID
  #S-FO-ID := 1
  FIND FO WITH FO-USER-FO-ID = #S-USER-FO-ID
    #FO-NAME := FO.FO-NAME
  END-FIND
END-IF
FIND FO WITH FO-USER-NAME = #FO-USER-NAME
  IF NO RECORDS FOUND
    #ES-MSG-NR := 0352                      /* folder not defined
    #ES-MSG-FIELD-NAME := 'NAME'
    PERFORM GET-MSG-TXT
    ESCAPE BOTTOM
  END-NOREC
  IF FO.FO-ID = 1
    DECIDE FOR FIRST CONDITION
      WHEN ES-LANGUAGE = 1 AND FO.FO-NAME = '#Listeneingang'
        FO.FO-NAME := '#Inbasket'
      WHEN ES-LANGUAGE = 2 AND FO.FO-NAME = '#Inbasket'
        FO.FO-NAME := '#Listeneingang'
      WHEN NONE IGNORE
    END-DECIDE
  END-IF
  NOFO-NAME := FO.FO-NAME
  NOFO-ID := FO.FO-ID
  NOFO-DESC := FO-DESC
  NOFO-USER-ID := FO.FO-USER-ID
  NOFO-MAP-LAYOUT := FO-MAP-LAYOUT
  IF ES-ORIG-FUNCTION NE 'LN'
    NOFO-LINKED-USER-ID := FO.FO-LINKED-USER-ID
    NOFO-LINKED-ID := FO.FO-LINKED-ID
    IF FO.FO-LINKED-USER-ID NE ' '
      #S-USER := NOFO-LINKED-USER-ID
      #S-FO-ID := NOFO-LINKED-ID
      FIND LINKED-FO WITH FO-USER-FO-ID = #S-USER-FO-ID
        NOFO-LINKED-USER-ID := LINKED-FO.FO-USER-ID
        NOFO-LINKED-ID := LINKED-FO.FO-ID
        IF NOFO-LINKED-ID = 1
          DECIDE FOR FIRST CONDITION
           WHEN ES-LANGUAGE = 1 AND LINKED-FO.FO-NAME = '#Listeneingang'
              NOFO-LINKED-NAME := '#Inbasket'
            WHEN ES-LANGUAGE = 2 AND LINKED-FO.FO-NAME = '#Inbasket'
              NOFO-LINKED-NAME := '#Listeneingang'
            WHEN NONE
              NOFO-LINKED-NAME := LINKED-FO.FO-NAME
          END-DECIDE
        ELSE
          NOFO-LINKED-NAME := LINKED-FO.FO-NAME
        END-IF
        NOFO-DEFAULT-LOCATION := LINKED-FO.FO-DEFAULT-LOCATION
      END-FIND
    ELSE
      NOFO-DEFAULT-LOCATION := FO.FO-DEFAULT-LOCATION
    END-IF
  ELSE
    LINKED-FO.FO-USER-ID := FO.FO-USER-ID
    LINKED-FO.FO-ID := FO.FO-ID
    LINKED-FO.FO-NAME := FO.FO-NAME
    LINKED-FO.FO-LINKED-FO-ID := FO.FO-LINKED-FO-ID
    REPEAT WHILE LINKED-FO.FO-LINKED-FO-ID NE ' '
      #S-USER := LINKED-FO.FO-LINKED-USER-ID
      #S-FO-ID := LINKED-FO.FO-LINKED-ID
      FIND LINKED-FO WITH FO-USER-FO-ID = #S-USER-FO-ID
      END-FIND
    END-REPEAT
    NOFO-LINKED-USER-ID := LINKED-FO.FO-USER-ID
    NOFO-LINKED-ID := LINKED-FO.FO-ID
    IF NOFO-LINKED-ID = 1
      DECIDE FOR FIRST CONDITION
        WHEN ES-LANGUAGE = 1 AND LINKED-FO.FO-NAME = '#Listeneingang'
          NOFO-LINKED-NAME := '#Inbasket'
        WHEN ES-LANGUAGE = 2 AND LINKED-FO.FO-NAME = '#Inbasket'
          NOFO-LINKED-NAME := '#Listeneingang'
        WHEN NONE
          NOFO-LINKED-NAME := LINKED-FO.FO-NAME
      END-DECIDE
    ELSE
      NOFO-LINKED-NAME := LINKED-FO.FO-NAME
    END-IF
  END-IF
END-FIND
*
#F-USER-ID := NOFO-USER-ID                       /* CF1 ->
#F-FO-ID   := NOFO-ID
RESET  #F-TIME
#T-FOLDER-TIME := #F-FOLDER-TIME
#T-TIME    := #CONST-INV-TIME
HISMA1. HISTOGRAM (1) MA-EXT FOR MA-FOLDER-TIME FROM #F-FOLDER-TIME
ENDING AT #T-FOLDER-TIME                                              /*
  /* Set flag to tell client that folder contains Active Reports
  /* (so, folder may not be changed into a link)
  /* Note: NOFO-DEFAULT-LOCATION is used for this flag,
  /*       as original usage is only checked in NOM, not NGC)
  NOFO-DEFAULT-LOCATION := '#'
END-HISTOGRAM                                    /* CF1 <-
*
END-SUBROUTINE /* READ-RECORD
*
************************************************************************
DEFINE SUBROUTINE NEW-RECORD
************************************************************************
RESET NOFO-ID
IF NOFO-NAME = ' '
  #ES-MSG-NR := 0351
  #ES-MSG-FIELD-NAME := 'NAME'
  PERFORM GET-MSG-TXT
  ESCAPE ROUTINE
END-IF
IF NOFO-USER-ID = ' '
  IF ES-ORIG-FUNCTION NE 'LN'
    IF ES-KEY-PARM-COUNT = 0
      NOFO-USER-ID := ES-USER
    ELSE
      NOFO-USER-ID := ES-KEY-PARM(1)
    END-IF
  ELSE
    #ES-MSG-NR := 0366
    #ES-MSG-FIELD-NAME := 'FOR-USER-ID'
    PERFORM GET-MSG-TXT
    ESCAPE ROUTINE
  END-IF
END-IF
#FO-USER-ID := NOFO-USER-ID
#FO-NAME    := NOFO-NAME
FNNEW. FIND NUMBER FO WITH FO-USER-NAME = #FO-USER-NAME
IF *NUMBER(FNNEW.) = 0
  IF (#FO-NAME = '#Inbasket' OR = '#Listeneingang')
    IF #FO-NAME = '#Inbasket'
      #FO-NAME := '#Listeneingang'
    ELSE
      #FO-NAME := '#Inbasket'
    END-IF
    FND2. FIND NUMBER FO WITH FO-USER-NAME = #FO-USER-NAME
  END-IF
END-IF
IF *NUMBER(FNNEW.) = 0  AND *NUMBER(FND2.) = 0
  PERFORM VALIDATION
  #FO-USER-ID := NOFO-USER-ID
  #FO-NAME    := NOFO-NAME
  IF #ES-MSG-NR NE 0
    PERFORM GET-MSG-TXT
    ESCAPE ROUTINE
  ELSE
    IF ES-EXTEND-FUNCTION = 'CHK'
      ESCAPE ROUTINE
    END-IF
    #S-USER := #FO-USER-ID
    RESET  #S-FO-ID
    #E-USER := #FO-USER-ID
    #E-FO-ID := H'FFFF'
    HISTOGRAM NEW-FO FOR FO-USER-FO-ID
        STARTING FROM #S-USER-FO-ID ENDING AT #E-USER-FO-ID
      #FOLDER := FO-NEWID
    END-HISTOGRAM
    IF #FOLDER < 100
       #FOLDER := 100
    END-IF
    #FOLDER := #FOLDER + 1
    #FOLDER-ID := #FOLDER
    FO.FO-ID := #FOLDER
    NOFO-ID := #FOLDER
    FO.FO-NAME := NOFO-NAME
    PERFORM ASSIGN-ATTRIBUTE-VALUES
    NOFO-OPTIONS(*) := ' '
    NOFO-OPTIONS(1) := 'LS'
    IF FO.FO-LINKED-FO-ID NE ' '
      PERFORM GET-OPTIONS
    END-IF
    STORE FO
    PERFORM UPDATE-FOLDER-GRANTS
  END-IF
ELSE
  #ES-MSG-NR := 0353                       /* folder already exist
  #ES-MSG-FIELD-NAME := 'NAME'
  PERFORM GET-MSG-TXT
END-IF
*
END-SUBROUTINE /* NEW-RECORD
*
************************************************************************
DEFINE SUBROUTINE MAINTAIN-GRANTS
************************************************************************
#GR-T := 'F'
/* #GR-N and #GR-U are assigned in UPDATE-FOLDER-GRANTS
*
IF #FOLDER-NAME > ' '              /* delete
  #GR-N := #FOLDER-NAME
END-IF
*
FNDGR. FIND GRANTS WITH GR-SUPER = #GR-SUPER
  IF NO RECORDS FOUND
    IF #FUNC = 'A'
      GR-OBJECT-TYPE := 'F'
      GR-OBJECT-NAME := #GR-N
      GR-USERID      := NOFO-USER-ID
      GR-OPTION  (*) := #OPTIONS(*)
      STORE GRANTS
      ESCAPE BOTTOM(FNDGR.)
    ELSE
      ESCAPE BOTTOM(FNDGR.)
    END-IF
  END-NOREC
*
  DECIDE ON FIRST VALUE OF #FUNC
    VALUE 'M'
      IF GR-OPTION(*) NE #OPTIONS(*)
        GR-OPTION (*) := #OPTIONS(*)
        UPDATE (FNDGR.)
      END-IF
    VALUE 'D'               /* delete grants if no more linked folder
      DELETE(FNDGR.)
    VALUE 'P'                /* delete no more needed owner grants
      IF NOT (GR-OPTION(*) NE 'Y')
        DELETE (FNDGR.)
      END-IF
    NONE VALUE IGNORE
  END-DECIDE
END-FIND
*
END-SUBROUTINE /* MAINTAIN-GRANTS
*
************************************************************************
DEFINE SUBROUTINE UPDATE-FOLDER-GRANTS
************************************************************************
RESET #GRANTS(*) #LS-USERID #OPTIONS(*) #FOLDER-NAME #FUNC
* check already existed grants
NOFO-USER-ID := FO.FO-USER-ID
IF NOFO-LINKED-NAME > ' '
  #FO-NUMBER := NOFO-LINKED-ID
  COMPRESS NOFO-LINKED-USER-ID #FO-NUMBER-A TO #GR-N LEAVING NO
ELSE
  #FO-NUMBER := #FOLDER-ID
  COMPRESS NOFO-USER-ID #FO-NUMBER-A TO #GR-N LEAVING NO
END-IF
CALLNAT 'NOGROU-N'
  'F' #GR-N NOFO-USER-ID #LS-USERID #GRANTS(*)
*
#GR-U := NOFO-USER-ID
DECIDE FOR EVERY CONDITION
  WHEN (NOFO-LINKED-USER-ID = ' ' OR (NOFO-LINKED-USER-ID > ' '
  AND NOFO-LINKED-USER-ID = NOFO-USER-ID)) AND #GRANTS(*) NE 'Y'      /*
    #OPTIONS (*) := 'Y'
    IF #LS-USERID > ' '
      #FUNC := 'M'
    ELSE
      #FUNC := 'A'
    END-IF
    PERFORM MAINTAIN-GRANTS      /* add-owner grants
  WHEN NOFO-LINKED-USER-ID > ' ' AND NOFO-LINKED-USER-ID NE NOFO-USER-ID
  AND #LS-USERID = ' ' AND ES-USER-TYPE = 'A'                         /*
    #OPTIONS(1)   := 'N'
    #OPTIONS(2:6) := 'Y'
    #FUNC := 'A'
    PERFORM MAINTAIN-GRANTS
* delete grants if no more linked folders for the same user
  WHEN ES-EXTEND-FUNCTION = 'UPD' AND NOFO-ID > 1
  AND NOFO-LINKED-USER-ID = ' ' AND NOFO-LINKED-NAME = ' '            /*
  AND #FO-LINKED-FO-ID > ' '                                          /*
    IF #LS-USERID = ' '              /* if no grants
      #OPTIONS(*) := 'Y'             /* add owner grants
      #FUNC       := 'A'
      PERFORM MAINTAIN-GRANTS
    ELSE
      IF #GRANTS(*) NE 'Y'      /* exist grants
        #FUNC       := 'M'
        #OPTIONS(*) := 'Y'
        PERFORM MAINTAIN-GRANTS
      END-IF
    END-IF
/* check folders - are there more own folders linked to tha same folder
    #FO-USER := NOFO-USER-ID
    RESET #FO-ID
    RDFO. READ OWN-FOLD WITH FO-USER-FO-ID = #FO-USER-FO-ID
      IF OWN-FOLD.FO-USER-ID NE #FO-USER
        ESCAPE BOTTOM(RDFO.)
      END-IF
      IF OWN-FOLD.FO-LINKED-FO-ID = #FO-LINKED-FO-ID AND
          OWN-FOLD.FO-USER-ID NE #FO-LINKED-USER AND
          OWN-FOLD.FO-NAME NE #FO-NAME
        #CNT := #CNT + 1
      END-IF
    END-READ
    IF #CNT = 0
      #FUNC := 'D'
      #FO-NUMBER := #FO-LINKED-ID
      COMPRESS #FO-LINKED-USER #FO-NUMBER-A TO #FOLDER-NAME LEAVING NO
      PERFORM MAINTAIN-GRANTS
    END-IF
* delete owner grants, if link added
  WHEN ES-EXTEND-FUNCTION = 'UPD' AND NOFO-LINKED-USER-ID > ' '
  AND NOFO-LINKED-NAME > ' ' AND #FO-LINKED-FO-ID = ' '               /*
    #FO-NUMBER := #FO-ID
    COMPRESS FO.FO-USER-ID #FO-NUMBER-A TO #FOLDER-NAME LEAVING NO
    #FUNC := 'P'
    PERFORM MAINTAIN-GRANTS
  WHEN NONE IGNORE
END-DECIDE
*
END-SUBROUTINE /* UPDATE-FOLDER-GRANTS
*
************************************************************************
DEFINE SUBROUTINE UPDATE-RECORD
************************************************************************
IF ES-KEY-PARM-COUNT = 1
  #FO-USER-ID := ES-USER
  #FO-NAME    := ES-KEY-PARM(1)
ELSE
  #FO-USER-ID := ES-KEY-PARM(1)
  #FO-NAME    := ES-KEY-PARM(2)
END-IF
IF #FO-NAME = '#Inbasket' OR = '#Listeneingang'
  #S-USER := #FO-USER-ID
  #S-FO-ID := 1
  FIND FO WITH FO-USER-FO-ID = #S-USER-FO-ID
    #FO-NAME := FO.FO-NAME
  END-FIND
END-IF
FNDMOD. FIND FO WITH FO-USER-NAME = #FO-USER-NAME
  IF NO RECORDS FOUND
    #ES-MSG-NR := 0352                      /* folder not defined
    #ES-MSG-FIELD-NAME := 'NAME'
    ESCAPE BOTTOM (FNDMOD.)
  END-NOREC
  #FO-LINKED-FO-ID := FO.FO-LINKED-FO-ID
  #FOLDER-ID       := FO.FO-ID
  #FO-USER         := FO.FO-USER-ID
  #FO-ID           := FO.FO-ID
*
  PERFORM VALIDATION
  IF #ES-MSG-NR = 0 AND ES-EXTEND-FUNCTION = 'UPD'
    GETMOD. GET FO *ISN(FNDMOD.)
    PERFORM ASSIGN-ATTRIBUTE-VALUES
    NOFO-OPTIONS(*) := ' '
    PERFORM GET-OPTIONS
    UPDATE (GETMOD.)
    PERFORM UPDATE-FOLDER-GRANTS
  END-IF
END-FIND
IF #ES-MSG-NR NE 0
  PERFORM GET-MSG-TXT
END-IF
*
END-SUBROUTINE /* UPDATE-RECORD
*
************************************************************************
DEFINE SUBROUTINE ASSIGN-ATTRIBUTE-VALUES
************************************************************************
FO.FO-DESC := NOFO-DESC
FO.FO-USER-ID := NOFO-USER-ID
FO-MAP-LAYOUT := NOFO-MAP-LAYOUT
IF NOFO-LINKED-USER-ID NE ' '
  FO.FO-LINKED-USER-ID := NOFO-LINKED-USER-ID
  FO.FO-LINKED-ID := NOFO-LINKED-ID
ELSE
  RESET FO.FO-LINKED-FO-ID
END-IF
FO.FO-DEFAULT-LOCATION := NOFO-DEFAULT-LOCATION
*
END-SUBROUTINE /* ASSIGN-ATTRIBUTE-VALUES
*
************************************************************************
DEFINE SUBROUTINE VALIDATION
************************************************************************
IF NOT (NOFO-MAP-LAYOUT = 1 THRU 3)
  NOFO-MAP-LAYOUT := 2
END-IF
*
RESET #ES-MSG-NR #ES-MSG-FIELD
DECIDE FOR EVERY CONDITION
  WHEN ES-ORIG-FUNCTION = 'LN'              /* link folder
    IF ES-KEY-PARM-COUNT = 0
      #LN-USER-ID := ES-USER
    ELSE
      #LN-USER-ID := ES-KEY-PARM(1)
    END-IF
    IF #LN-USER-ID NE NOFO-USER-ID
      FNU. FIND NUMBER US WITH USER-ID = NOFO-USER-ID
      IF *NUMBER(FNU.) = 0
        #ES-MSG-NR := 2       /* userid :1: not defined
        #ES-MSG-FIELD-NAME := 'FOR-USER-ID'
        #MSG-TXT := NOFO-USER-ID
        ESCAPE ROUTINE
      END-IF
      #FO-NUMBER := NOFO-LINKED-ID
      COMPRESS NOFO-LINKED-USER-ID #FO-NUMBER-A TO #GR-N LEAVING NO
    END-IF
  WHEN NOFO-LINKED-USER-ID NE ' ' AND NOFO-LINKED-NAME = ' '
    #ES-MSG-NR := 0356                     /* enter folder name
    #ES-MSG-FIELD-NAME := 'LINKED-NAME'
    ESCAPE ROUTINE
  WHEN NOFO-LINKED-USER-ID = ' ' AND NOFO-LINKED-NAME NE ' '
    #ES-MSG-NR := 0355                     /* enter user
    #ES-MSG-FIELD-NAME := 'LINKED-USER-ID'
    ESCAPE ROUTINE
  WHEN NOFO-LINKED-USER-ID NE ' ' AND NOFO-ID = 1 THRU 100
    #ES-MSG-NR := 0357      /* default folder can not have link
    #ES-MSG-FIELD-NAME := 'LINKED-NAME'
    ESCAPE ROUTINE
  WHEN NOFO-LINKED-USER-ID = ' '
    #FO-NUMBER := NOFO-ID
    COMPRESS NOFO-LINKED-USER-ID #FO-NUMBER-A TO #GR-N LEAVING NO
  WHEN NOFO-LINKED-USER-ID NE ' '
    #FO-NUMBER := NOFO-LINKED-ID
    COMPRESS NOFO-LINKED-USER-ID #FO-NUMBER-A TO #GR-N LEAVING NO
    IF NOFO-LINKED-USER-ID = NOFO-USER-ID AND
        NOFO-LINKED-NAME = NOFO-NAME    /* link to the same folder
      #ES-MSG-NR := 0357
      #ES-MSG-FIELD-NAME := 'LINKED-NAME'
      ESCAPE ROUTINE
    END-IF
*
    #FO-USER-ID := NOFO-LINKED-USER-ID
    #FO-NAME    := NOFO-LINKED-NAME
    FNDLNK. FIND LINKED-FO WITH FO-USER-NAME = #FO-USER-NAME
      IF NO RECORDS FOUND
        IF #FO-NAME = '#Inbasket' OR = '#Listeneingang'
          #S-USER := #FO-USER-ID
          #S-FO-ID := 1
          FIND LINKED-FO WITH FO-USER-FO-ID = #S-USER-FO-ID
            IF NO RECORDS FOUND
              #ES-MSG-NR := 0352
              #ES-MSG-FIELD-NAME := 'LINKED-USER-ID'
              ESCAPE ROUTINE
            END-NOREC
          END-FIND
        ELSE
          #ES-MSG-NR := 0352
          #ES-MSG-FIELD-NAME := 'LINKED-USER-ID'
          ESCAPE ROUTINE
        END-IF
      END-NOREC
      IF LINKED-FO.FO-LINKED-USER-ID = NOFO-USER-ID
        #S-USER  := LINKED-FO.FO-LINKED-USER-ID
        #S-FO-ID := LINKED-FO.FO-LINKED-ID
        FIND LINKED-FO WITH FO-USER-FO-ID = #S-USER-FO-ID
          IF  LINKED-FO.FO-NAME = NOFO-NAME
            #ES-MSG-NR := 0357
            #ES-MSG-FIELD-NAME := 'LINKED-NAME'
            ESCAPE ROUTINE
          END-IF
        END-FIND
      END-IF
      NOFO-LINKED-ID := LINKED-FO.FO-ID
      IF LINKED-FO.FO-USER-ID NE NOFO-USER-ID
        IF LINKED-FO.FO-LINKED-FO-ID NE ' '
          #ES-MSG-NR := 0369
          #ES-MSG-FIELD-NAME := 'LINKED-USER-ID'
          ESCAPE ROUTINE
        ELSE
          IF ES-USER-TYPE NE 'A'
            #FO-NUMBER := LINKED-FO.FO-ID
            COMPRESS LINKED-FO.FO-USER-ID #FO-NUMBER-A TO #GR-N LEAVING NO
            CALLNAT 'NOGROU-N'
              'F' #GR-N NOFO-USER-ID #LS-USERID #GRANTS(*)
            IF NOT #GRANTS(*) = 'Y'
              #ES-MSG-NR := 0361
              #ES-MSG-FIELD-NAME := 'LINKED-USER-ID'
              #MSG-TXT := NOFO-USER-ID
              ESCAPE ROUTINE
            END-IF
          END-IF
        END-IF
      ELSE
        IF LINKED-FO.FO-LINKED-FO-ID NE ' '
          #ES-MSG-NR := 0369
          #ES-MSG-FIELD-NAME := 'LINKED-USER-ID'
          ESCAPE ROUTINE
        END-IF
      END-IF
    END-FIND
    #F-USER-ID := NOFO-USER-ID
    #F-FO-ID   := NOFO-ID
    RESET  #F-TIME
    #T-FOLDER-TIME := #F-FOLDER-TIME
    #T-TIME    := #CONST-INV-TIME
    HISMA. HISTOGRAM (1) MA-EXT FOR MA-FOLDER-TIME FROM #F-FOLDER-TIME
    ENDING AT #T-FOLDER-TIME                                          /*
      #ES-MSG-NR := 0354
      #ES-MSG-FIELD-NAME := 'NAME'
      ESCAPE ROUTINE
    END-HISTOGRAM
*
  WHEN NOT(NOFO-DEFAULT-LOCATION='*' OR=' ' OR='B' OR='A' OR='S' OR='D')
    #ES-MSG-NR := 0486
    #ES-MSG-FIELD-NAME := 'DEFAULT-LOCATION'
    ESCAPE ROUTINE
  WHEN ES-EXTEND-FUNCTION = 'UPD' AND NOFO-LINKED-USER-ID > ' '
  AND NOFO-LINKED-NAME > ' ' AND #FO-LINKED-FO-ID = ' ' /* add link   /*
    #FO-NUMBER := #FO-ID
    COMPRESS #FO-USER #FO-NUMBER-A TO #FOLDER-NAME LEAVING NO
*
    #GR-OBJ-TYPE := 'F'
    #GR-OBJ-NAME := #FOLDER-NAME
    LNKFO. FIND GRANTS GR-TYPE-NAME = #GR-TYPE-NAME
      IF GR-USERID NE #FO-USER
        #ES-MSG-NR := 0371
        #ES-MSG-FIELD-NAME := 'NAME'
        ESCAPE ROUTINE
      END-IF
      RESET #FO-NAME
      #FO-USER-ID := #FO-USER
      FNDOWN. READ OWN-FOLD WITH FO-USER-NAME = #FO-USER-NAME
        IF OWN-FOLD.FO-USER-ID NE #FO-USER-ID
          ESCAPE BOTTOM(FNDOWN.)
        END-IF
        IF OWN-FOLD.FO-LINKED-FO-ID = #FO-USER-FO-ID
          #ES-MSG-NR := 0371
          #ES-MSG-FIELD-NAME := 'NAME'
          ESCAPE BOTTOM(FNDOWN.)
        END-IF
      END-READ
    END-FIND
  WHEN NONE IGNORE
END-DECIDE
*
END-SUBROUTINE /* VALIDATION
*
************************************************************************
DEFINE SUBROUTINE GET-MSG-TXT
************************************************************************
RESET SHORT-MSG LONG-MSG(*)
VERSION := 0
NADA2000.OBJECT-KIND := 'U'
NADA2000.ERROR-NUMBER := #ES-MSG-NR
NADA2000.OPT-INSERT-DYN := FALSE
NADA2000.OPT-LANGUAGE := ES-LANGUAGE
NADA2000.LIBRARY := ES-APP-SERVER-LIBRARY
CALLNAT 'NATA2000' NADA2000 NATA2000.EXTENDED-PARMS NAD-MSG NAD-FLD
EXAMINE SHORT-MSG FOR #ES-MSG-PREF DELETE
IF NOT #LOG-MSG
  ES-MSG-NR    := #ES-MSG-NR
  ES-MSG-TXT   := SHORT-MSG
  IF #ES-MSG-NR = 369
    #S-USER := LINKED-FO.FO-LINKED-USER-ID
    #S-FO-ID := LINKED-FO.FO-LINKED-ID
    FIND LINKED-FO WITH FO-USER-FO-ID = #S-USER-FO-ID
      IF LINKED-FO.FO-ID = 1
        DECIDE FOR FIRST CONDITION
          WHEN ES-LANGUAGE = 1 AND LINKED-FO.FO-NAME = '#Listeneingang'
            #MSG-TXT := '#Inbasket'
          WHEN ES-LANGUAGE = 2 AND LINKED-FO.FO-NAME = '#Inbasket'
            #MSG-TXT := '#Listeneingang'
          WHEN NONE
            #MSG-TXT := LINKED-FO.FO-NAME
        END-DECIDE
      ELSE
        #MSG-TXT := LINKED-FO.FO-NAME
      END-IF
      #MSG-TXT1 := LINKED-FO.FO-USER-ID
    END-FIND
    COMPRESS LINKED-FO.FO-USER-ID #MSG-TXT TO #MSG-TXT
    EXAMINE ES-MSG-TXT FOR ':1:' REPLACE #MSG-TXT
    EXAMINE ES-MSG-TXT FOR ':2:' REPLACE #MSG-TXT1
  END-IF
  IF #ES-MSG-NR = 354
    EXAMINE ES-MSG-TXT FOR ':1:' REPLACE #FO-NAME
  END-IF
  IF #ES-MSG-NR = 2 OR = 361
    EXAMINE ES-MSG-TXT FOR ':1:' REPLACE #MSG-TXT
  END-IF
  EXAMINE ES-MSG-TXT FOR ':1:' REPLACE ' '
  EXAMINE ES-MSG-TXT FOR ':2:' REPLACE ' '
  ES-MSG-FIELD := #ES-MSG-FIELD
  ES-RC := 1
END-IF
*
END-SUBROUTINE /* GET-MSG-TXT
*
************************************************************************
DEFINE SUBROUTINE GET-OPTIONS
************************************************************************
NOFO-OPTIONS(*) := ' '
NOFO-OPTIONS(1) := 'LS'
LINKED-FO.FO-USER-ID := FO.FO-USER-ID
LINKED-FO.FO-ID := FO.FO-ID
LINKED-FO.FO-LINKED-FO-ID := FO.FO-LINKED-FO-ID
PERFORM READ-MAIL
IF NOFO-OPTIONS(1) = ' '
  NOFO-OPTIONS(2) := 'DL'
END-IF
REPEAT WHILE LINKED-FO.FO-LINKED-FO-ID NE ' ' AND NOFO-OPTIONS(1) = 'LS'
  #S-USER := LINKED-FO.FO-LINKED-USER-ID
  #S-FO-ID := LINKED-FO.FO-LINKED-ID
  FIND LINKED-FO WITH FO-USER-FO-ID = #S-USER-FO-ID
    PERFORM READ-MAIL
  END-FIND
END-REPEAT
#FO-NUMBER := FO.FO-ID
IF #FO-NUMBER = 1 THRU 100
  NOFO-OPTIONS(2) := 'DL'
  NOFO-OPTIONS(3) := 'RN'
END-IF
IF FO.FO-LINKED-FO-ID NE ' '
  NOFO-OPTIONS(4) := 'LN'
END-IF
*
END-SUBROUTINE /* GET-OPTIONS
*
************************************************************************
DEFINE SUBROUTINE READ-MAIL
************************************************************************
#MA-USERID := LINKED-FO.FO-USER-ID
#MA-FO-ID := LINKED-FO.FO-ID
#MA-REPNAME := H'FF'
#MA-FOLDER-REP-E := #MA-FOLDER-REP
#MA-REPNAME := H'00'
FMA. FIND NUMBER MA-EXT
  WITH MA-FOLDER-REP-RNB = #MA-FOLDER-REP THRU #MA-FOLDER-REP-E
IF *NUMBER(FMA.) > 0
  NOFO-OPTIONS(1) := ' '
END-IF
*
END-SUBROUTINE /* READ-MAIL
*
END
