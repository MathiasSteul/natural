DEFINE DATA PARAMETER
/* >Natural Source Header 000000
/* :Mode S
/* :CP
/* <Natural Source Header
*  --------------------------------------------------------------------
*   Program    NOMPUT-P
*   Version    1.3
*   FUNCTION   PUT GIVEN RECORDS     INTO A NOMCONTAINER FILE
*
*   Maintenance:
*   uuu yy-mm-dd s(999999) ...
*   gw  94-12-29 p(135435) *TIMESTMP  tomake IDENT unique
*   JVD 98-09-14 P(164220) NOM141
*   gw  98-10-27 s(999999)(N3) dbid/ fnrback in for compatibility
*   FHI ??         NOMALL-921new     field:NAF:DEST
*   SU1 2019-12-13 NOMALL-2366 new   field:NAF:OUTPUT(DEFINE PRINTER)
*   SU2 2020-01-03 NOMALL-2370 new   field:NAF:OUTPUT - store as attr.
*  --------------------------------------------------------------------
1 NOMPUT-PARMS
  2 NOMPUT-CB (A32)
  2 REDEFINE NOMPUT-CB
    3 NOMPUT-CB-GROUP
      4 NOMPUT-FUNCTION (I2)
*   0001 - Open
*   0002 - Put
*   0003 - Close
*   0004 - Abort
*   0005 - End Transaction
*   0006 - Backout Transaction
*   0007 - Trigger
*
      4 NOMPUT-CC-TYPE (I2)
*   0001 - ASA
*   0002 - Machine
*   0003 - E (BS2000)
*   0004 - no CC's
*
      4 NOMPUT-SOURCE-TYPE (I2)
*   0001 - JES2
*   0002 - JES3
*   0003 - POWER
*
*   0011 - NAF
*
      4 NOMPUT-ERROR-CODE (I4)
      4 NOMPUT-ET-POSSIBLE (I2)
*   0001 - NO
*   0002 - YES
      4 NOMPUT-ETBT-NEEDED (I2)
*   0000 - NO
*   0001 - YES -> CALL ME IF ET/BE   ISSUED
      4 NOMPUT-REPORT-IS-OPENED (I2)
*   0000 - NO
*   0001 - YES -> CALL ME IF CLOSE
      4 NOMPUT-ISSUE-ET (I2)
*   0000 - NO
*   0001 - YES
  2 NOMPUT-SOURCE-ATTRIBUTES (A80) /*SU1 was 72
*  --------------------------------------------------------------------
  2 REDEFINE NOMPUT-SOURCE-ATTRIBUTES
    3 NOMPUT-NAF-GROUP
      4 NAF-DBID-OLD (B1) /* FSPOOL DBID
      4 NAF-FNR-OLD (B1) /* FSPOOL FNR
      4 NAF-PNR (B1) /* Logical Destination 1-31
      4 NAF-USER-ID (A8) /* *USER
      4 NAF-NATPGM (A8) /* *PROGRAM
      4 NAF-NATLIB (A8) /* *LIBRARY-ID
      4 NAF-NAME (A8) /* DEFINE PRINTER Report name
      4 NAF-FORMS (A8) /* DEFINE PRINTER Forms
      4 NAF-PROFILE (A8) /* Logical Printer Profile (LPF)
      4 NAF-COPIES (I2) /* DEFINE PRINTER Copies
      4 NAF-DISP (A1) /* Disposition
      4 NAF-DBID (B2) /* FSPOOL DBID
      4 NAF-FNR (B2) /* FSPOOL FNR
      4 NAF-DEST (A8) /* NOMALL-921 FHI IN
      4 NAF-OUTPUT (A8) /*SU1
*
  2 NOMPUT-LINE-LENGTH (I4) /* Length of print record
  2 NOMPUT-LINE (A250) /* Print record
  2 NOMPUT-WORK (A251/1:09)
  2 REDEFINE NOMPUT-WORK
    3 #NOMPUT-FILLER (A251)
    3 #ST-TEXT-BUFFER (A2008)
    3 REDEFINE #ST-TEXT-BUFFER
      4 #ST-TEXT-BUFFER-LENGTH (B2)
  2 REDEFINE NOMPUT-WORK
    3 #WORK-AREA (A251)
    3 REDEFINE #WORK-AREA
      4 #WORK-AREA-GROUP
        5 WORK-INIT (A1)
        5 REPORT-IS-OPENED (L)
        5 IN-BUFFER (L)
        5 #SOURCE-TEXT-ID (P10)
        5 #QUEUE-ENTRY-ISN (P10)
        5 #BUFF-ISN (P10)
        5 #RECORD-NUMBER (P10)
        5 #LINE-SIZE (P3)
        5 #BUFF-ISN-ET (P10)
        5 #RECORD-NUMBER-ET (P10)
        5 #LINE-SIZE-ET (P3)
        5 #LINE-START (P10)
        5 #LINE-END (P10)
        5 #NSMCOMP-WORK (B4)
        5 #QUEUE-ENTRY-STATUS (I2)
        5 #TIME (A15)
        5 #NOM-DBID (N5)
        5 #NOM-FNR (N5)
        5 #NP-NAF-DBID (B2)
        5 #NP-NAF-FNR (B2)
        5 #NP-NAF-PNR (B1)
        5 #NP-NAF-USER-ID (A8)
        5 #NP-NAF-NATPGM (A8)
        5 #NP-NAF-NATLIB (A8)
        5 #NP-NAF-NAME (A8)
        5 #NP-NAF-FORMS (A8)
        5 #NP-NAF-PROFILE (A8)
        5 #NP-NAF-COPIES (I2)
        5 #NP-NAF-DISP (A1)
        5 #NP-CC-TYPE (I2)
        5 #NP-SOURCE-TYPE (I2)
        5 #NP-NAF-DEST (A8)
        5 #TIME-STAMP (B8)
        5 REDEFINE #TIME-STAMP
          6 #TIME-STAMP-1 (I4)
          6 #TIME-STAMP-2 (I4)
        5 #NP-NAF-OUTPUT (A8) /*SU2
    3 #DATA-BUFFER (A251/1:08)
*   /* work  area and compressed     print data
* **End of PDA NOMPUT-P *************************************************
END-DEFINE
