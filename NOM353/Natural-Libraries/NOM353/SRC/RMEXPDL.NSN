* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
************************************************************************
* RMEXPPR - Export Distribution List
*
* Maintenance
* User  yyyy-mm-dd Issue       Remark
* ----- ---------------------- -----------------------------------------
*       2019-02-22 generated   Created from RMXML2LD
* SU1   2015-09-15 NOMALL-1693 NAT00059(A80)->NAT41002(A253)
* fhi   2019-02-19 NOMALL-2215 Export not complete
* BLI   2019-05-06 NOMALL-2261 Recataloged due to changes of XXUX---P
* SU2   2020-11-10 NOMALL-2440 split DDM -> NRM-MF-NODES
* SU3   2021-02-18 NOMALL-2443 restruct+MSG
* GGS01 2021-07-06 NOMALL-2474 RECAT since RMEXP-C changed
* SU5   2021-08-18 NOMALL-2467 RMEXPDLL
************************************************************************
DEFINE DATA
PARAMETER USING XXUX---P
PARAMETER USING RMEXP-A
PARAMETER
1 #TRACING               (L)
1 #ID                    (A250) BY VALUE OPTIONAL
/***********************************************************************
INDEPENDENT
1 +ID                    (A/*) DYNAMIC
1 +ID-INDEX              (I2)
/***********************************************************************
/*SU5 LOCAL USING RMEXPDLL
LOCAL USING RMBAS64P
LOCAL USING VUXDEF-L
/*SU2 LOCAL USING VMONITUL /* NOMALL-2215 fhi in
LOCAL USING N-41002L /*SU1
/***********************************************************************
LOCAL
1 DL VIEW OF NRM-DISTRIBUTION-LIST /*SU5 was RMEXPDLL
  2 D-OBJECT-TYPE        (A10)
  2 D-OBJECT-TIME        (T)
  2 D-LIST-NAME          (A8)
  2 D-LIST-DESC          (A50)
  2 D-USER-LIST          (A8/1:191) /*SU5: 191 ??
  2 D-DESCRIPTION        (A60/1:1)
  2 D-LAST-UPDATE        (T)
  2 D-LAST-UPDATE-USER   (A16)
1 WRITE-FILE VIEW OF WRITE-FILE
  2 ERROR-CODE
  2 ERROR-TEXT
*
1 #FIELD                 (A32)
1 #VALUE                 (A300)
1 #LEN                   (I4)
1 #WORK-LINE             (A250)
1 #FUNCTION              (A10)
1 #I                     (I4)
1 #J                     (I4)
1 #K                     (I4)
1 #L                     (I4)
1 #PROGRAM               (A8) INIT <*PROGRAM>
1 REDEFINE #PROGRAM
  2 FILLER               5X /*RMEXP
  2 #TYPE                (A2)
1 #KEY                   (A100)
1 #KEY-FROM              (A100)
1 #KEY-TO                (A100) INIT FULL LENGTH <H'FF'>
1 #KEY-MASK              (A25)
/*SU5 1 #KEY-LEN               (I2)
1 #KEY-LEN2              (I2) CONST <8> /*full len D-LIST-NAME SU5
1 #TRACE-MSG             (A250)
1 #IND                   (I4)
1 #POS                   (I4)
1 #DEP                   (A5)
1 #NODE                  (N5)
1 #ID-MEMBER             (A) DYNAMIC
1 #EXPORT-PROG           (A8)
1 #MASK                  (A300) INIT FULL LENGTH <'P'>
1 #PRINTABLE             (A300)
1 #D-OBJECT-TIME         (A21)
1 #D-LAST-UPDATE         (A21)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
PERFORM #START
READ DL BY D-LIST-NAME = #KEY-FROM THRU #KEY-TO
  #KEY := D-LIST-NAME
  PERFORM HANDLE-MASK
* Get depending objects:
  INCLUDE RMLD2XC2 '191' 'D-USER-LIST' '''RMEXPUS'''
  INCLUDE RMLD2XC3 'D-LIST-NAME' '''L''' /*RMEXPGR
  COMPRESS '<DL depending="' #DEP '">' TO #WORK-LINE LEAVING NO
  PERFORM WRITE-XML
  IF #OD-LOG = 'Y'
    IF #ID SPECIFIED
      COMPRESS 'Exported: DL */' D-LIST-NAME TO #TRACE-MSG
    ELSE
      COMPRESS 'Exported: DL /' D-LIST-NAME TO #TRACE-MSG
    END-IF
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    END TRANSACTION
  END-IF
  MOVE EDITED DL.D-OBJECT-TIME (EM=YYYY'-'MM'-'DD'-'HH':'II':'SS'.'T)
    TO #D-OBJECT-TIME
  MOVE EDITED DL.D-LAST-UPDATE (EM=YYYY'-'MM'-'DD'-'HH':'II':'SS'.'T)
    TO #D-LAST-UPDATE
  #FIELD := 'D-OBJECT-TYPE'
  #VALUE :=  DL.D-OBJECT-TYPE
  PERFORM CONVERT-XML
  #FIELD := 'D-OBJECT-TIME'
  #VALUE :=  #D-OBJECT-TIME
  PERFORM CONVERT-XML
  #FIELD := 'D-LIST-NAME'
  #VALUE :=  DL.D-LIST-NAME
  PERFORM CONVERT-XML
  #FIELD := 'D-LIST-DESC'
  #VALUE :=  DL.D-LIST-DESC
  PERFORM CONVERT-XML
  FOR #L := 191 TO 1 STEP -1
    IF DL.D-USER-LIST (#L) NE ' '
      ESCAPE BOTTOM
    END-IF
  END-FOR
  FOR #I = 1 TO #L
    #FIELD := 'D-USER-LIST'
    #VALUE :=  DL.D-USER-LIST(#I)
    PERFORM CONVERT-XML1
  END-FOR
  FOR #L := 1 TO 1 STEP -1
    IF DL.D-DESCRIPTION (#L) NE ' '
      ESCAPE BOTTOM
    END-IF
  END-FOR
  FOR #I = 1 TO #L
    #FIELD := 'D-DESCRIPTION'
    #VALUE :=  DL.D-DESCRIPTION(#I)
    PERFORM CONVERT-XML1
  END-FOR
  #FIELD := 'D-LAST-UPDATE'
  #VALUE :=  #D-LAST-UPDATE
  PERFORM CONVERT-XML
  #FIELD := 'D-LAST-UPDATE-USER'
  #VALUE :=  DL.D-LAST-UPDATE-USER
  PERFORM CONVERT-XML
*
  PERFORM #END-OBJ
END-READ
PERFORM #END
*
INCLUDE RMEXP-C /*CALL-NPR, WRITE-XML, OPEN-XML, CLOSE-XML, WRITE-XML
*
END
