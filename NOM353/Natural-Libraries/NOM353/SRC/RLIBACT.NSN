* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RLIBACT   Check if library exist in steplib table
*
* Maintenance
* -----------
* uuuuuu  yyyy-mm-dd P999999 Remark
* xsetggr 2009-02-24 P300323 created
* fhi     2009-02-27 P300323 Rename RGETSTEP to NOMGSTEP delivered in SYSTEM
* fhi     2009-03-06 P300323 Avoid function 20 of NAT00009, it's faulty on Unix.
* xsetggr 2012-03-07 NOMALL-1099 pass current library as optional parm
* SU1     2018-07-25 NOMALL-1643 NOM 3.5:remove steplibs SYSLIB,SYSLIBS
* SU2     2023-08-25 NOMALL-2647 NAT00009->NAT82009+more than 8 steplibs
* SU3     2024-06-04 NOMALL-2680 >20 steplibs: show it (seems error)
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 P-LIBRARY           (A8)     /* in
1 P-EXIST             (L)      /* out
1 P-CURRENT-LIB       (A8) OPTIONAL /*SU2 for what ??
************************************************************************
LOCAL
1 #NAT82009
  2 P-FUNCTION                 (A1)
    /* A = Add entry to table
    /* D = Display stepl. table
    /* I = Init steplib table
    /* P = Purge entry
  2 P-STEPLIB-TABLE            (*)   /* Output for Fct = D only:
    3 P-STEPLIB-NAME           (A8)  /* 1st entry is always
    3 P-STEPLIB-DBID           (I4)  /* *STEPLIB, then the other
    3 P-STEPLIB-FNR            (I4)  /* steplib entries w/o 2 SYSTM
  2 P-ADD-STEPLIB-DATA               /* Input for Fct = A only
    3 P-ADD-STEPLIB-NAME       (A8)
    3 P-ADD-STEPLIB-DBID       (I4)
    3 P-ADD-STEPLIB-FNR        (I4)
    3 P-ADD-STEPLIB-PASSWORD   (A8)
    3 P-ADD-STEPLIB-CIPHER     (A8)
  2 P-ADD-PURGE-ENTRY-NUMBER   (I2)  /* Input for Fct = A and P
  2 P-IGNORE-NSC               (A1)  /*NSC active:
    /* Y = all Fcts allowed,
    /* others = only Fct = D allowed
  2 P-RETURN-MSG               (A) DYNAMIC
  2 P-RETURN-CODE              (I4)
    /* 0 = OK
    /* < 0 = Natural Runtime error
    /* 1 = Version nn for NAT82009 is not implemented yet.
    /* 4 = Valid function codes are "A", "D", "I", "P".
    /* 8 = NATURAL SECURITY installed; function not allowed.
    /* 20 = First character of library is invalid. (Fct=A)
    /* 24 = Position must be 1 through nn (Fct=P)
    /* 28 = Invalid DBID (1..65535) or FNR (1..5000). (Fct=A)
    /* 36 = The steplib is already included in the list.(Fct=A)
1 #NAT82009-FUTURE-EXTENSIONS  (A1/1:1)
1 REDEFINE #NAT82009-FUTURE-EXTENSIONS
  2 P-FUTURE-VERSION           (I1)
*
1 #MSG (A250)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
P-EXIST := TRUE
IF P-LIBRARY = *LIBRARY-ID /*e.g. SYSNOM ...
  ESCAPE ROUTINE
END-IF
*
P-FUNCTION := 'D' /* Display
CALLNAT 'NAT82009' #NAT82009 #NAT82009-FUTURE-EXTENSIONS (*)
DECIDE ON FIRST VALUE OF P-RETURN-CODE
  VALUE 0 /*ok
    IF NOT (P-STEPLIB-NAME (*) = P-LIBRARY)
      RESET P-EXIST
    END-IF
    IF *OCC(P-STEPLIB-NAME) > 20 /*just as a warning SU3
      COMPRESS NUMERIC '0040' *PROGRAM P-LIBRARY 'number steplibs:'
        *OCC(P-STEPLIB-NAME) TO #MSG
      PERFORM XXRLOG-WRITE-LOG 'W' #MSG
    END-IF
  NONE
    COMPRESS NUMERIC '0040' *PROGRAM P-LIBRARY P-RETURN-CODE
      P-RETURN-MSG TO #MSG
    PERFORM XXRLOG-WRITE-LOG 'W' #MSG
    RESET P-EXIST /*what else ?
END-DECIDE
*
END
