* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RPFACT-C       ACTIVE PF-key Assignment
*
* MAINTENANCE:
* xsisgg 00-08-09 CE 7461 New PF-key to toggle between display long
*                 or short Report and Bundle names
* ----------------------------------------------------------------------
G-PF-IDENT (09) := ##PFN-ACTIVE
G-PF-CODE  (09) := ##PFK-ACTIVE
IF G-SUPPORT-LONG-NAMES
  G-PF-IDENT (21) := ##PFN-DISPLAY-LONG-NAMES
  G-PF-CODE  (21) := ##PFK-DISPLAY-LONG-NAMES
ELSE
  G-PF-IDENT (21) := ##PFN-ACTIVE
  G-PF-CODE  (21) := ##PFK-ACTIVE
END-IF
