*
************************************************************************
* Main line
************************************************************************
*
FORMAT (0) LS=133 PS=60
*
IF G-TRACE GE *LEVEL AND G-TRACE-SET = SCAN ('SCAN')
  #TRACING := TRUE
  RMSETTIM.FUNCTION := 'S'
  PERFORM RMSETTIM-SETTIME RMSETTIM
  LG-FUNCTION := 'W' /*RLOG: write log to output to SU 2018-08
END-IF
INCLUDE CMRDC
IF #TRACING
  COMPRESS 'Start Scanning JES2;node=' +NOD-CURRENT-NODE
    +NOD-LOCAL-NAME TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  PERFORM XXCATAL-GET-CATDATE #CATDATE
  COMPRESS *PROGRAM 'cataloged at' #CATDATE TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
CALLNAT 'N-MONERR' #MAX-RETRIES #RETRY-INTERVAL
*
IF +NOD-CURRENT-CLASSES (*) NE ' ' /*necessary(NPR CLASS=' ') SU13
  PERFORM PROCESS-SPOOL-QUEUE /* <= main routine
ELSE
  IF #TRACING
    G-TRACE-MSG := 'No Sysout Classes defined - nothing scanned.'
    PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
    END TRANSACTION
  END-IF
END-IF
*
#TYPE1 := 'jes2'
#NP-TYPE := JES2
PERFORM PROCESS-TRIGGER-QUEUE /*RMSC-C2
*
IF #TRACING
  COMPRESS 'End of Scanning JES2. Found:' #COUNT
    'err:' G-NATRP-ERC G-NATRP-ERT TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  RMSETTIM.FUNCTION := 'G'
  PERFORM RMSETTIM-SETTIME RMSETTIM
  PERFORM XXRLOG-WRITE-LOG 'T' RMSETTIM.MSG
  END TRANSACTION
END-IF
*
RESET G-NATRP-ERC G-NATRP-ERT
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE PROCESS-NOMPUT-QUEUE-SPEC
************************************************************************
#SOURCE-ATTRIBUTES := NP-ATTRIBUTES-IDENT
#P-SOURCE-TYPE-BIN := #NP-TYPE
CALLNAT 'RMSR7--N' #SOURCE-ATTRIBUTES #P-SOURCE-TYPE-BIN
IF #NP-TYPE = SEQUENTIAL-FILE-MVS
  PERFORM PROCESS-NOMPUT-QUEUE-FMVS
  ESCAPE ROUTINE
END-IF
#DO-TYPE-AL:= TRUE
IF #JES-TYPE = 'AL'
  #JES-TYPE-NOP := #JES-TYPE
  FNDSFAL. FIND (1) SPOOL-FILE WITH NODE = #JES-NODE
  AND JOB-NUMBER = #JES-JOB-NUMBER AND JOB-NAME = #JES-JOB-NAME       /*
    IF SPOOL-FILE.ERROR-CODE NE 0
      PERFORM HANDLE-SPOOL-FILE-ERR
      ESCAPE ROUTINE
    END-IF
    PERFORM PROCESS-NOMPUT-COMMON
  END-FIND
ELSE
  RESET #JES-TYPE-NOP
  FNDSFNP. FIND SPOOL-FILE WITH NODE = #JES-NODE
  AND JOB-NUMBER = #JES-JOB-NUMBER AND JOB-NAME = #JES-JOB-NAME       /*
  AND TYPE = #JES-TYPE AND DATA-SET-KEY = #JES-DATA-SET-KEY           /*
    IF SPOOL-FILE.ERROR-CODE NE 0
      PERFORM HANDLE-SPOOL-FILE-ERR
      ESCAPE ROUTINE
    END-IF
    PERFORM PROCESS-NOMPUT-COMMON
  END-FIND
END-IF
*
END-SUBROUTINE /* PROCESS-NOMPUT-QUEUE-SPEC
*
************************************************************************
DEFINE SUBROUTINE HANDLE-SPOOL-FILE-ERR
************************************************************************
COMPRESS #JES-NODE '/' #JES-JOB-NAME '/' #JES-JOB-NUMBER '/'
  #JES-TYPE '/' TO LG-OBJECT-NAME LEAVING NO
IF #JES-TYPE = 'AL'
  COMPRESS LG-OBJECT-NAME #JES-DATA-SET-KEY TO LG-OBJECT-NAME LEAVING NO
END-IF
WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
  'Unable to read Spool Files' LG-OBJECT-NAME
WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
  SPOOL-FILE.ERROR-TEXT
G-NATRP-ERC := 0005
COMPRESS SPOOL-FILE.ERROR-TEXT '/' +NOD-CURRENT-NAME '/'
  *PROGRAM '/' *LINE TO G-NATRP-ERT
PERFORM WRITE-ERROR-LOG /*RMSC-C
G-NATRP-ERC := 0005
COMPRESS 'Deleting' LG-OBJECT-NAME TO G-NATRP-ERT
PERFORM WRITE-ERROR-LOG /*RMSC-C
RESET G-CYCLE-WAS-IDLE /* check for further entries
*
END-SUBROUTINE /* HANDLE-SPOOL-FILE-ERR
*
************************************************************************
DEFINE SUBROUTINE PROCESS-NOMPUT-COMMON
************************************************************************
RESET #ATTRIBUTES #SOURCE-ATTRIBUTES
*
#QUEUE-HOLD           := 'NO'
#CONTROL-FLAG         := 'X'
#SOURCE-TYPE          := JES2-QUEUE-ENTRY
#JES-QUEUE-NODE       := SPOOL-FILE.NODE
#JES-QUEUE-JOB-NAME   := SPOOL-FILE.JOB-NAME
#JES-QUEUE-JOB-NUMBER := ABS(SPOOL-FILE.JOB-NUMBER)
IF SPOOL-FILE.TYPE = 'SI' OR = 'JL'
  #JES-QUEUE-GROUP-ID := '*'
ELSE
  #JES-QUEUE-GROUP-ID := SPOOL-FILE.GROUP-ID
END-IF
IF #TRACING
  COMPRESS 'Find spool queue' SPOOL-FILE.JOB-NAME
    SPOOL-FILE.JOB-NUMBER SPOOL-FILE.GROUP-ID TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
FIND (1) SPOOL-QUEUE WITH  NODE = SPOOL-FILE.NODE
AND JOB-NAME =SPOOL-FILE.JOB-NAME AND JOB-NUMBER = SPOOL-FILE.JOB-NUMBER
AND  GROUP-ID   = #JES-QUEUE-GROUP-ID                                 /*
  IF #TRACING
    COMPRESS 'Spool queue' JOB-NAME JOB-NUMBER GROUP-ID TO G-TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END-IF
*
  IF SPOOL-QUEUE.ERROR-CODE NE 0
    COMPRESS SPOOL-FILE.NODE '/' SPOOL-FILE.JOB-NAME '/'
      SPOOL-FILE.JOB-NUMBER '/' SPOOL-FILE.GROUP-ID '/'
      TO LG-OBJECT-NAME LEAVING NO
    WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
      'Unable to read Spool Queue' LG-OBJECT-NAME
    WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
      SPOOL-QUEUE.ERROR-TEXT
    G-NATRP-ERC := 0005
    COMPRESS SPOOL-QUEUE.ERROR-TEXT '/' +NOD-CURRENT-NAME '/'
      *PROGRAM '/' *LINE TO G-NATRP-ERT
    PERFORM WRITE-ERROR-LOG /*RMSC-C
    PERFORM CHANGE-SPOOL-CLASS-TO-ERROR
    ESCAPE ROUTINE
  END-IF
*
  #JES-QUEUE-GROUP-ID := '*'
  #CONTROL-TYPE       := JES2-QUEUE-ENTRY
  #CONTROL-IDENT := SUBSTR (#JES-QUEUE-IDENT,6,58)
*
  FNDNP. FIND SOURCE WITH SR-CONTROL-SHORT = #CONTROL
    IF NO RECORDS FOUND
      PERFORM CREATE-SOURCE-RECORD
    END-NOREC
    IF G-NATRP-ERC = 0
      #QUEUE-ID  := SOURCE.SR-ID
      PERFORM PROCESS-SPOOL-FILE
    END-IF
  END-FIND
END-FIND
*
END-SUBROUTINE /* PROCESS-NOMPUT-COMMON
*
************************************************************************
DEFINE SUBROUTINE PROCESS-NOMPUT-QUEUE-FMVS
************************************************************************
#DO-TYPE-AL := FALSE
RMSCCD-SOURCE-TYPE := #NP-TYPE
RMSCCD-NODE        := #FMVS-NODE
RMSCCD-DSN         := #FMVS-DSNAME
#IDENT-FILE := #FMVS-DSNAME
CALLNAT 'RMSCCD-N' RMSCCD-PARMS G-NATRP-ERC G-NATRP-ERT
IF #TRACING
  COMPRESS 'Rmsccd attributes:' 'RC:' G-NATRP-ERC-A G-NATRP-ERT
    'RMSCCD-ATTRIBUTES:'      RMSCCD-ATTRIBUTES
    'RMSCCD-CC-TYPE:'         RMSCCD-CC-TYPE
    'RMSCCD-NUMBER-OF-LINES:' RMSCCD-NUMBER-OF-LINES
    'RMSCCD-RECORD-LENGTH:'   RMSCCD-RECORD-LENGTH TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
RESET #ATTRIBUTES
IF G-NATRP-ERC = 0
  #SOURCE-ATTRIBUTES := RMSCCD-ATTRIBUTES
  #CONTROL-TYPE      := SEQUENTIAL-FILE-MVS
  #CONTROL-IDENT     := #FMVS-IDENT
  #SOURCE-TYPE       := SEQUENTIAL-FILE-MVS
  #CC-TYPE           := RMSCCD-CC-TYPE
  #NUMBER-OF-LINES   := RMSCCD-NUMBER-OF-LINES
  #RECORD-LENGTH     := RMSCCD-RECORD-LENGTH
  #CONTROL-FLAG      := 'X'
  #SPOOL-ATTRIBUTES  := NP-SPOOL-ATTRIBUTES
  CALLNAT 'RMSPL7-N' #SPOOL-ATTRIBUTES #SPOOL-TYPE /*conv. node number
  #JOB-NAME          := #SPOOL-JES-JOB-NAME
  #DESTINATION       := #SPOOL-JES-DESTINATION
  IF #TRACING
    COMPRESS '#CONTROL:' #CONTROL '#JOB-NAME:' #JOB-NAME TO G-TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END-IF
  FNDSRCFMVS. FIND NUMBER SOURCE WITH SR-CONTROL = #CONTROL
  IF *NUMBER (FNDSRCFMVS.) = 0
    PERFORM CREATE-SOURCE-RECORD
    IF G-NATRP-ERC = 0
      SOURCE-RECORD-CREATED := TRUE
      PERFORM CREATE-ORDER-RECORDS
    END-IF
  END-IF
ELSE
  COMPRESS #FMVS-DSNAME TO LG-OBJECT-NAME
  COMPRESS #FMVS-DSNAME TO G-NATRP-ERT
  PERFORM WRITE-ERROR-LOG /*RMSC-C
END-IF
*
END-SUBROUTINE /* PROCESS-NOMPUT-QUEUE-FMVS
*
************************************************************************
DEFINE SUBROUTINE PROCESS-SPOOL-QUEUE
************************************************************************
IF #TRACING
  G-TRACE-MSG := 'Process spool queue'
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
RESET #SC-COUNT
JES. FIND SPOOL-QUEUE WITH  NODE  = +NOD-CURRENT-NODE AND QUEUE = 'OUT'
AND  CLASS = +NOD-CURRENT-CLASSES (01) OR = +NOD-CURRENT-CLASSES(02)  /*
OR = +NOD-CURRENT-CLASSES(03) OR = +NOD-CURRENT-CLASSES(04)           /*
OR = +NOD-CURRENT-CLASSES(05) OR = +NOD-CURRENT-CLASSES(06)           /*
OR = +NOD-CURRENT-CLASSES(07) OR = +NOD-CURRENT-CLASSES(08)           /*
OR = +NOD-CURRENT-CLASSES(09) OR = +NOD-CURRENT-CLASSES(10)           /*
OR = +NOD-CURRENT-CLASSES(11) OR = +NOD-CURRENT-CLASSES(12)           /*
OR = +NOD-CURRENT-CLASSES(13) OR = +NOD-CURRENT-CLASSES(14)           /*
OR = +NOD-CURRENT-CLASSES(15) OR = +NOD-CURRENT-CLASSES(16)           /*
  RESET G-NATRP-ERC G-NATRP-ERT
  #SET-TO-TEMP := TRUE
*
  IF SPOOL-QUEUE.ERROR-CODE NE 0
    COMPRESS G-MONITOR-ID '/' +NOD-CURRENT-NODE '/' *PROGRAM
      TO LG-OBJECT-NAME LEAVING NO
    WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
      'Unable to read Spool Queue' LG-OBJECT-NAME
    WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
      SPOOL-QUEUE.ERROR-TEXT
    G-NATRP-ERC := 0005
    COMPRESS SPOOL-QUEUE.ERROR-TEXT '/' +NOD-CURRENT-NAME '/' *PROGRAM
      '/' *LINE TO G-NATRP-ERT
    PERFORM WRITE-ERROR-LOG /*RMSC-C
    PERFORM CHANGE-SPOOL-CLASS-TO-ERROR
    ESCAPE BOTTOM (JES.)
  END-IF
*
  IF #TRACING
    COMPRESS 'Spool-queue' JOB-NAME JOB-NUMBER CLASS TO G-TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END-IF
  RESET #ATTRIBUTES #SOURCE-ATTRIBUTES #SPOOL-ATTRIBUTES
  #QUEUE-HOLD           := 'NO'
  #CONTROL-FLAG         := 'X'
  #SOURCE-TYPE          := JES2-QUEUE-ENTRY
  #JES-QUEUE-NODE       := NODE (JES.)
  #JES-QUEUE-JOB-NAME   := JOB-NAME (JES.)
  #JES-QUEUE-JOB-NUMBER := ABS(JOB-NUMBER (JES.))
  #JES-QUEUE-GROUP-ID   := '*'
  #CONTROL-TYPE         := JES2-QUEUE-ENTRY
  #CONTROL-IDENT        := SUBSTR (#JES-QUEUE-IDENT,6,58)
*
  FNDP. FIND NUMBER SOURCE WITH SR-CONTROL-SHORT = #CONTROL
  IF *NUMBER (FNDP.) = 0
    #PREP-INDEX := 1
    PERFORM PREP-SOURCE
    ADD 1 TO #SC-COUNT
    IF G-NATRP-ERC = 0
      #QUEUE-ID := SOURCE.SR-ID
      PERFORM PROCESS-JL-AND-SI-ENTRIES
    END-IF
    #DO-TYPE-AL:= TRUE
    #CONTROL1-TYPE:= #CONTROL2-TYPE:= JES2
    #CONTROL1-NODE:= #JES-QUEUE-NODE
    #CONTROL1-JOBNAME:= #JES-QUEUE-JOB-NAME
    #CONTROL1-JOBID:= #JES-QUEUE-JOB-NUMBER
    #CONTROL1-SOTYPE:= 'AL'
    #CONTROL2-PREFIX:= #CONTROL1-PREFIX
    #CONTROL1-REST:= H'00'
    #CONTROL2-REST:= H'FF'
    FNRAL. FIND NUMBER JES-FILE WITH SR-CONTROL=#CONTROL1 THRU #CONTROL2
    IF *NUMBER (FNRAL.) GT 0
      #DO-TYPE-AL:= FALSE
    END-IF
  END-IF
  RESET #ATTRIBUTES #SOURCE-ATTRIBUTES #SPOOL-ATTRIBUTES
  #QUEUE-HOLD           := HOLD (JES.)
  #CONTROL-FLAG         := 'X'
  #SOURCE-TYPE          := JES2-QUEUE-ENTRY
  #JES-QUEUE-NODE       := NODE (JES.)
  #JES-QUEUE-JOB-NAME   := JOB-NAME (JES.)
  #JES-QUEUE-JOB-NUMBER := ABS(JOB-NUMBER (JES.))
  #JES-QUEUE-GROUP-ID   := GROUP-ID (JES.)
  #CONTROL-TYPE         := JES2-QUEUE-ENTRY
  #CONTROL-IDENT        := SUBSTR (#JES-QUEUE-IDENT,6,58)
  FNDQ. FIND NUMBER SOURCE WITH SR-CONTROL-SHORT = #CONTROL
  IF *NUMBER (FNDQ.) = 0
    #PREP-INDEX := 1
    PERFORM PREP-SOURCE
    IF G-NATRP-ERC = 0
      #QUEUE-ID := SOURCE.SR-ID
      PERFORM PROCESS-QUEUE-ENTRIES
    END-IF
  END-IF
  IF #SET-TO-TEMP /*SU12 moved here
    PERFORM CHANGE-SPOOL-CLASS-TO-TEMP
  END-IF
  IF #SC-COUNT >= #SC-MAX
    ESCAPE BOTTOM (JES.)
  END-IF
/*SU12  above IF #SET-TO-TEMP PERFORM CHANGE-SPOOL-CLASS-TO-TEMP END-IF
END-FIND
*
END-SUBROUTINE /* PROCESS-SPOOL-QUEUE
*
************************************************************************
DEFINE SUBROUTINE PROCESS-JL-AND-SI-ENTRIES
************************************************************************
RESET #I1
REPEAT
  ADD 1 TO #I1
  FNDJS. FIND SPOOL-FILE WITH NODE = SPOOL-QUEUE.NODE
  AND JOB-NUMBER = SPOOL-QUEUE.JOB-NUMBER AND TYPE='JL' OR='SI'       /*
  AND JOB-NAME   = SPOOL-QUEUE.JOB-NAME AND CLASS = SPOOL-QUEUE.CLASS /*
    IF SPOOL-FILE.ERROR-CODE NE 0
      COMPRESS SPOOL-QUEUE.JOB-NAME '/' SPOOL-QUEUE.JOB-NUMBER '/'
        'JL-SI' TO LG-OBJECT-NAME LEAVING NO
      IF SPOOL-FILE.ERROR-CODE = 724
        WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
          'Waiting for Spool Files' LG-OBJECT-NAME
        PERFORM WAIT-A-FEW-SECONDS
        IF #I1 < 10
          ESCAPE BOTTOM (FNDJS.)
        END-IF
      END-IF
      WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
        'Unable to read Spool Files' LG-OBJECT-NAME
      WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
        SPOOL-FILE.ERROR-TEXT
      G-NATRP-ERC := 0005
      COMPRESS SPOOL-FILE.ERROR-TEXT '/' +NOD-CURRENT-NAME '/' *PROGRAM
        '/' *LINE TO G-NATRP-ERT
      PERFORM WRITE-ERROR-LOG /*RMSC-C
      ESCAPE BOTTOM (FNDJS.)
    END-IF
    PERFORM PROCESS-SPOOL-FILE
  END-FIND
  IF #I1 = 10 OR SPOOL-FILE.ERROR-CODE NE 724
    ESCAPE BOTTOM
  END-IF
END-REPEAT
*
END-SUBROUTINE /* PROCESS-JL-AND-SI-ENTRIES
*
************************************************************************
DEFINE SUBROUTINE PROCESS-QUEUE-ENTRIES
************************************************************************
RESET #I1
REPEAT
  ADD 1 TO #I1
  #NO-SPOOL-FILES := FALSE
  FNDSF. FIND SPOOL-FILE WITH NODE = SPOOL-QUEUE.NODE
  AND JOB-NUMBER = SPOOL-QUEUE.JOB-NUMBER AND CLASS =  SPOOL-QUEUE.CLASS
  AND JOB-NAME =SPOOL-QUEUE.JOB-NAME AND GROUP-ID = SPOOL-QUEUE.GROUP-ID
    IF NO RECORDS FOUND
      #NO-SPOOL-FILES := TRUE
      SPOOL-FILE.ERROR-CODE := 724
    END-NOREC
    IF SPOOL-FILE.ERROR-CODE NE 0
      COMPRESS SPOOL-QUEUE.JOB-NAME   '/' SPOOL-QUEUE.JOB-NUMBER '/'
        SPOOL-QUEUE.GROUP-ID TO LG-OBJECT-NAME LEAVING NO
      IF SPOOL-FILE.ERROR-CODE = 724
        WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
          'Waiting for Spool Files' LG-OBJECT-NAME
        IF #NO-SPOOL-FILES
        WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
            'No Spool Files found'
        END-IF
        PERFORM WAIT-A-FEW-SECONDS
        IF #I1 < 10
          ESCAPE BOTTOM (FNDSF.)
        END-IF
      END-IF
      WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
        'Unable to read Spool Files' LG-OBJECT-NAME
      IF #NO-SPOOL-FILES
        PRINT NOTITLE NOHDR (AD=L) /*SU12 ->
          *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
          'unexpected change in class or group'
        PRINT 'nr:' SPOOL-QUEUE.JOB-NUMBER 'cl:' SPOOL-QUEUE.CLASS
          'name:' SPOOL-QUEUE.JOB-NAME 'group:' SPOOL-QUEUE.GROUP-ID
        SPOOL-FILE.ERROR-TEXT :=
          'Logical error - no spool files for job'
      END-IF
      WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
        SPOOL-FILE.ERROR-TEXT
      G-NATRP-ERC := 0005
      COMPRESS SPOOL-FILE.ERROR-TEXT '/' +NOD-CURRENT-NAME '/' *PROGRAM
        '/' *LINE TO G-NATRP-ERT
      PERFORM WRITE-ERROR-LOG /*RMSC-C
      ESCAPE BOTTOM (FNDSF.)
    END-IF
    PERFORM PROCESS-SPOOL-FILE
  END-FIND
  IF #I1 = 10 OR SPOOL-FILE.ERROR-CODE NE 724
    ESCAPE BOTTOM
  END-IF
END-REPEAT
*
END-SUBROUTINE /* PROCESS-QUEUE-ENTRIES
*
************************************************************************
DEFINE SUBROUTINE PROCESS-SPOOL-FILE
************************************************************************
IF #TRACING
  COMPRESS 'Process spool file' SPOOL-FILE.JOB-NAME SPOOL-FILE.JOB-NUMBER
    SPOOL-FILE.TYPE SPOOL-FILE.DATA-SET TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
RESET #SOURCE-ATTRIBUTES #SPOOL-ATTRIBUTES #ATTRIBUTES RMSCTR-PARMS
#SOURCE-TYPE := JES2
IF SPOOL-FILE.TYPE = 'SO' AND #QUEUE-HOLD = 'YES' OR #PROCESS-TRIGGER
  #CONTROL-FLAG := 'X'
END-IF
IF NOT (SPOOL-FILE.TYPE = 'JL' OR = 'SI')
  #DESTINATION := SPOOL-QUEUE.DESTINATION
END-IF
#JOB-NAME         := SPOOL-FILE.JOB-NAME
#WRITER           := SPOOL-FILE.WRITER
#FORM             := SPOOL-FILE.FORM
#JES-NODE         := SPOOL-FILE.NODE
#JES-JOB-NAME     := SPOOL-FILE.JOB-NAME
#JES-JOB-NUMBER   := ABS(SPOOL-FILE.JOB-NUMBER)
IF #JES-TYPE-NOP NE 'AL'
  #JES-TYPE         := SPOOL-FILE.TYPE
ELSE
  #JES-TYPE         := #JES-TYPE-NOP
END-IF
#JES-DATA-SET-KEY := ABS(SPOOL-FILE.DATA-SET-KEY)
#JES-PROCNAME     := SPOOL-FILE.PROCNAME
#JES-STEPNAME     := SPOOL-FILE.STEPNAME
#JES-DDNAME       := SPOOL-FILE.DDNAME
#JES-DATA-SET     := SPOOL-FILE.DATA-SET
EXAMINE SPOOL-FILE.CHARS FOR '*' REPLACE WITH ' '
EXAMINE SPOOL-FILE.FLASH FOR '*' REPLACE WITH ' '
EXAMINE SPOOL-FILE.FCB   FOR '*' REPLACE WITH ' '
EXAMINE SPOOL-FILE.UCS   FOR '*' REPLACE WITH ' '
#SPOOL-TYPE            := JES2
#SPOOL-JES-NODE        := SPOOL-FILE.NODE
#SPOOL-JES-JOB-NAME    := SPOOL-FILE.JOB-NAME
#SPOOL-JES-JOB-NUMBER  := SPOOL-FILE.JOB-NUMBER
#SPOOL-JES-DSTYPE      := SPOOL-FILE.TYPE
#SPOOL-JES-DSNO        := SPOOL-FILE.DATA-SET
#SPOOL-JES-DATASET-KEY := SPOOL-FILE.DATA-SET-KEY
#SPOOL-JES-GROUP-ID    := SPOOL-FILE.GROUP-ID
#SPOOL-JES-PROCNAME    := SPOOL-FILE.PROCNAME
#SPOOL-JES-STEPNAME    := SPOOL-FILE.STEPNAME
#SPOOL-JES-DDNAME      := SPOOL-FILE.DDNAME
#SPOOL-JES-CHARS       := SPOOL-FILE.CHARS
#SPOOL-JES-FCB         := SPOOL-FILE.FCB
#SPOOL-JES-FLASH       := SPOOL-FILE.FLASH
#SPOOL-JES-FORM        := SPOOL-FILE.FORM
#SPOOL-JES-TRC         := SPOOL-FILE.TRC
#SPOOL-JES-RECFM       := SPOOL-FILE.RECFM
#SPOOL-JES-UCS         := SPOOL-FILE.UCS
#SPOOL-JES-BURST       := SPOOL-FILE.BURST
#SPOOL-JES-LINECT      := SPOOL-FILE.LINECT
#SPOOL-JES-COMPACT     := SPOOL-FILE.COMPACT
EXAMINE SPOOL-FILE.PAGEDEF FOR H'00' REPLACE ' '
EXAMINE SPOOL-FILE.FORMDEF FOR H'00' REPLACE ' '
#SPOOL-JES-PAGEDEF     := SPOOL-FILE.PAGEDEF
#SPOOL-JES-FORMDEF     := SPOOL-FILE.FORMDEF
#SPOOL-JES-DESTINATION := #DESTINATION
IF #TRACING
  COMPRESS 'Some spool attributes: jes node' #SPOOL-JES-NODE
    '- current npr usr:' G-NPR-CURRENT-USERID
    '- local npr usr:' G-NPR-USERID
    '- +Current node:' +NOD-CURRENT-NODE
    '- +Current name:' +NOD-CURRENT-NAME
    '- +Active ESY user:' F#WHOAMI(<#SPOOL-JES-NODE>)
    TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
IF SPOOL-FILE.COPIES > 99
  #SPOOL-JES-COPIES := 99
ELSE
  #SPOOL-JES-COPIES := SPOOL-FILE.COPIES
END-IF
*
#NUMBER-OF-LINES := SPOOL-FILE.RECORD-COUNT
#RECORD-LENGTH   := SPOOL-FILE.LRECL
FIND RCOUNT WITH NODE = SPOOL-FILE.NODE AND JOB-NAME=SPOOL-FILE.JOB-NAME
AND JOB-NUMBER = SPOOL-FILE.JOB-NUMBER AND TYPE = SPOOL-FILE.TYPE     /*
AND DATA-SET = SPOOL-FILE.DATA-SET AND RECORD-NUMBER >  #NUMBER-OF-LINES
AND DATA-SET-KEY = SPOOL-FILE.DATA-SET-KEY                            /*
  IF RCOUNT.ERROR-CODE NE 0
    WRITE *PROGRAM *TIMX (EM=YYYY-MM-DD' 'HH:II:SS)
      'Error reading TYPE=AL for' SPOOL-FILE.JOB-NAME
      SPOOL-FILE.JOB-NUMBER
    PRINT (AD=L) 'Type:' SPOOL-FILE.TYPE 'Dataset:' SPOOL-FILE.DATA-SET
      'Datasetkey:' SPOOL-FILE.DATA-SET-KEY 'Rec-No:' #NUMBER-OF-LINES
    WRITE RCOUNT.ERROR-CODE RCOUNT.ERROR-TEXT
    ESCAPE BOTTOM
  END-IF
END-FIND
IF RCOUNT.RECORD-NUMBER > #NUMBER-OF-LINES
  #NUMBER-OF-LINES := RCOUNT.RECORD-NUMBER
END-IF
*
DECIDE FOR FIRST CONDITION
  WHEN SPOOL-FILE.RECFM = SCAN 'M' #CC-TYPE := MACHINE-CODE
  WHEN SPOOL-FILE.RECFM = SCAN 'A' #CC-TYPE := ASA-CODE
  WHEN NONE                        #CC-TYPE := NO-CC
END-DECIDE
IF #CC-TYPE = MACHINE-CODE
  CALLNAT 'RMRECN-N' #SOURCE-TYPE #SOURCE-ATTRIBUTES #NUMBER-OF-RECORDS
    G-NATRP-ERC G-NATRP-ERT
  IF G-NATRP-ERC = 0
    #NUMBER-OF-LINES := #NUMBER-OF-RECORDS
  ELSE
    RESET G-NATRP-ERC G-NATRP-ERT
  END-IF
END-IF
RESET #IDENT-FILE
#PROCNAME := #JES-PROCNAME
#STEPNAME := #JES-STEPNAME
#DDNAME   := #JES-DDNAME
#DSTYPE   := #JES-TYPE
#DSNO     := #JES-DATA-SET
PERFORM CHECK-IF-LOAD
IF SPOOL-FILE.STEPNAME = 'NOMDSN' AND SPOOL-FILE.TYPE = 'SO'
  PERFORM CHECK-IF-TRIGGER
END-IF
IF G-NATRP-ERC = 0
  #CONTROL-TYPE  := #SOURCE-TYPE
  #CONTROL-IDENT := SUBSTR (#JES-IDENT,6,58)
  IF #TRACING
    COMPRESS 'Find source' #CONTROL-TYPE #CONTROL-IDENT TO G-TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END-IF
  FNDSRC. FIND NUMBER SOURCE WITH SR-CONTROL-SHORT = #CONTROL
  IF *NUMBER (FNDSRC.) = 0
    #PREP-INDEX := 2
    PERFORM PREP-SOURCE
    IF G-NATRP-ERC = 0
      PERFORM CREATE-ORDER-RECORDS
    END-IF
  END-IF
END-IF
*
END-SUBROUTINE /* PROCESS-SPOOL-FILE
*
************************************************************************
DEFINE SUBROUTINE CHECK-IF-TRIGGER
************************************************************************
RESET RMSCTR-PARMS
RMSCTR-IN-SOURCE-TYPE := JES2
RMSCTR-IN-ATTRIBUTES  := #SOURCE-ATTRIBUTES
CALLNAT 'RMSCTR-N' RMSCTR-PARMS G-NATRP-ERC G-NATRP-ERT
IF G-NATRP-ERC NE 0
  COMPRESS #JES-NODE '/' #JES-JOB-NAME '/' #JES-JOB-NUMBER '/'
    #JES-TYPE '/' #JES-DATA-SET-KEY TO LG-OBJECT-NAME LEAVING NO
  WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
    'Error from trigger interface' G-NATRP-ERC LG-OBJECT-NAME
  PRINT NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
    G-NATRP-ERT /*SU11 (AL=70)
  PERFORM WRITE-ERROR-LOG /*RMSC-C
  PERFORM CHANGE-SPOOL-CLASS-TO-ERROR
  ESCAPE ROUTINE
END-IF
IF RMSCTR-IS-TRIGGER
  #SOURCE-ATTRIBUTES := RMSCTR-OUT-ATTRIBUTES
  RMSCCD-SOURCE-TYPE := RMSCTR-OUT-SOURCE-TYPE
  RMSCCD-NODE        := #FMVS-NODE
  RMSCCD-DSN         := #FMVS-DSNAME
  #SPOOL-JES-TRIGGER-DSNAME := #FMVS-DSNAME
  CALLNAT 'RMSCCD-N' RMSCCD-PARMS G-NATRP-ERC G-NATRP-ERT
  RESET #ATTRIBUTES
  IF G-NATRP-ERC = 0
    #SOURCE-ATTRIBUTES := RMSCCD-ATTRIBUTES
    #CONTROL-TYPE      := SEQUENTIAL-FILE-MVS
    #CONTROL-IDENT     := #FMVS-IDENT
    #JOB-NAME          := SPOOL-FILE.JOB-NAME
    #SOURCE-TYPE       := SEQUENTIAL-FILE-MVS
    #CC-TYPE           := RMSCCD-CC-TYPE
    #NUMBER-OF-LINES   := RMSCCD-NUMBER-OF-LINES
    #RECORD-LENGTH     := RMSCCD-RECORD-LENGTH
    #CONTROL-FLAG      := 'X'
    IF #TRACING
      COMPRESS 'Is trigger' #SOURCE-ATTRIBUTES TO G-TRACE-MSG
      PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
    END-IF
  ELSE
    COMPRESS #JES-JOB-NUMBER '/' #JES-JOB-NAME TO LG-OBJECT-NAME
      LEAVING NO
    COMPRESS #JES-JOB-NUMBER '/' #JES-JOB-NAME '/' #FMVS-DSNAME
      TO G-NATRP-ERT LEAVING NO
    PERFORM WRITE-ERROR-LOG /*RMSC-C
    PERFORM CHANGE-SPOOL-CLASS-TO-ERROR
    ESCAPE ROUTINE
  END-IF
END-IF
*
END-SUBROUTINE /* CHECK-IF-TRIGGER
*
************************************************************************
DEFINE SUBROUTINE CHANGE-SPOOL-CLASS-TO-TEMP
************************************************************************
#NEW-CLASS := +NOD-CURRENT-TEMP-CLASS
PERFORM CHANGE-SPOOL-CLASS
*
END-SUBROUTINE /* CHANGE-SPOOL-CLASS-TO-TEMP
*
************************************************************************
DEFINE SUBROUTINE CHANGE-SPOOL-CLASS-TO-ERROR
************************************************************************
IF +NOD-CURRENT-ERROR-CLASS = ' ' OR SPOOL-QUEUE.JOB-NAME = ' '
  #SET-TO-TEMP := TRUE
  ESCAPE ROUTINE
END-IF
RESET #SET-TO-TEMP
#NEW-CLASS := +NOD-CURRENT-ERROR-CLASS
PERFORM CHANGE-SPOOL-CLASS
PERFORM WRITE-LOG-RECORD
*
END-SUBROUTINE /* CHANGE-SPOOL-CLASS-TO-ERROR
*
************************************************************************
DEFINE SUBROUTINE CHANGE-SPOOL-CLASS
************************************************************************
IF #TRACING
  COMPRESS 'Change spool class' SPOOL-QUEUE.JOB-NAME
    SPOOL-QUEUE.JOB-NUMBER 'to' #NEW-CLASS TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
FIND SPOOL-UPDATE WITH NODE = SPOOL-QUEUE.NODE AND CLASS = #NEW-CLASS
AND JOB-NAME =SPOOL-QUEUE.JOB-NAME AND JOB-NUMBER=SPOOL-QUEUE.JOB-NUMBER
AND GROUP-ID = SPOOL-QUEUE.GROUP-ID AND FUNCTION   = 'CHANGE'         /*
  IF SPOOL-UPDATE.ERROR-CODE > 0
    COMPRESS SPOOL-QUEUE.JOB-NAME '/' SPOOL-QUEUE.JOB-NUMBER '/'
      SPOOL-QUEUE.GROUP-ID TO LG-OBJECT-NAME LEAVING NO
    IF #NEW-CLASS = +NOD-CURRENT-TEMP-CLASS
      G-NATRP-ERT := 'temporary'
    ELSE
      G-NATRP-ERT := 'error'
    END-IF
    PRINT NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
      'Cannot change to' G-NATRP-ERT /*SU11 (AL=9) 'Class'
    WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
      SPOOL-UPDATE.ERROR-TEXT
    G-NATRP-ERC := 0005
    COMPRESS SPOOL-UPDATE.ERROR-TEXT '/' +NOD-CURRENT-NAME '/' *PROGRAM '/' *LINE
      TO G-NATRP-ERT
    PERFORM WRITE-ERROR-LOG /*RMSC-C
  END-IF
END-FIND
*
END-SUBROUTINE /* CHANGE-SPOOL-CLASS
*
************************************************************************
DEFINE SUBROUTINE CREATE-SOURCE-RECORD
************************************************************************
REPEAT
  CALLNAT 'RMSRID-N' SOURCE.SR-ID G-NATRP-ERC G-NATRP-ERT
  UNTIL G-NATRP-ERC NE 3145
END-REPEAT
*
IF G-NATRP-ERC NE 0
  RESET LG-OBJECT-NAME
  PERFORM WRITE-ERROR-LOG /*RMSC-C
  PERFORM CHANGE-SPOOL-CLASS-TO-ERROR
  ESCAPE ROUTINE
END-IF
IF #SOURCE-TYPE = JES2-QUEUE-ENTRY OR = SEQUENTIAL-FILE-MVS
  RESET SOURCE.SR-RELATED-ID
ELSE
  SOURCE.SR-RELATED-ID := #QUEUE-ID
END-IF
IF +G-NOMEXIT-ACTIVE (2)
  PERFORM CALL-NOM-EXIT-002 /*RMSC-C
END-IF
#SPOOL-JES-NODE := +NOD-CURRENT-NODE
SOURCE.SR-CONTROL-FLAG             := #CONTROL-FLAG
SOURCE.SR-TYPE                     := #SOURCE-TYPE
SOURCE.SR-ATTRIBUTES-IDENT         := #SOURCE-ATTRIBUTES
SOURCE.SR-SPOOL-ATTRIBUTES         := #SPOOL-ATTRIBUTES
SOURCE.SR-CC-TYPE                  := #CC-TYPE
SOURCE.SR-RECORD-LENGTH            := #RECORD-LENGTH
SOURCE.SR-NUMBER-OF-LINES          := #NUMBER-OF-LINES
SOURCE.SR-MONITOR-ID               := G-MONITOR-ID
SOURCE.SR-REMOTE-CODEPAGE := F#GETCP (<REPORT.R-REPNAME>) /* NOMALL-2061
IF #TRACING
  COMPRESS 'Create source record with'
    'Control Flag:'     SOURCE.SR-CONTROL-FLAG
    'Type:'             SOURCE.SR-TYPE
    'IDENT:'            SOURCE.SR-ATTRIBUTES-IDENT
    'Spool Attributes:' SOURCE.SR-SPOOL-ATTRIBUTES
    'CC-Type:'          SOURCE.SR-CC-TYPE
    'Record length:'    SOURCE.SR-RECORD-LENGTH
    'No of lines:'      SOURCE.SR-NUMBER-OF-LINES
    'Monitor ID:'       SOURCE.SR-MONITOR-ID TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
*
SR-OBJECT-TYPE := 'SR'
SR-OBJECT-TIME := *TIMX
STORE SOURCE
END OF TRANSACTION
*
END-SUBROUTINE /* CREATE-SOURCE-RECORD
*
************************************************************************
DEFINE SUBROUTINE CHECK-IF-LOAD
************************************************************************
RESET LOAD-SOURCE #FOUND
*
IF #DESTINATION NE ' '
  EXAMINE FULL VALUE OF G-COPY-IDENT (*)
    FOR FULL VALUE OF #DESTINATION GIVING INDEX IN #FOUND
  DECIDE FOR EVERY CONDITION
    WHEN #FOUND > 0 OR G-COPY-IDENT (1) = '*'
      LOAD-SOURCE := TRUE
    WHEN G-COPY-IDENT (1) = '*'
      #FOUND := 1 /* take definition from first line
    WHEN NONE
      IGNORE
  END-DECIDE
END-IF
IF +NOD-LOCAL-NODE NE +NOD-CURRENT-NODE
  LOAD-SOURCE := TRUE
END-IF
IF #TRACING
  MOVE EDITED LOAD-SOURCE (EM='no'/'yes') TO G-TRACE-MSG
  COMPRESS 'Check if load' '#DESTINATION:' #DESTINATION
    'G-COPY-IDENT:' G-COPY-IDENT (*) 'LOAD-SOURCE:'  G-TRACE-MSG
    TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  IF +NOD-LOCAL-NODE NE +NOD-CURRENT-NODE
    COMPRESS 'Processing remote node' +NOD-CURRENT-NODE TO G-TRACE-MSG
  ELSE
    COMPRESS 'Processing local node' +NOD-LOCAL-NODE TO G-TRACE-MSG
  END-IF
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
*
END-SUBROUTINE /* CHECK-IF-LOAD
*
************************************************************************
DEFINE SUBROUTINE CREATE-ORDER-RECORDS
************************************************************************
IF #TRACING
  COMPRESS 'Create order records:' TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
RESET #IDENT (*) #TJ G-TRACE-MSG
CALLNAT 'N-IDENT' #JOB-NAME #TJ REPORT-IDENT-JES-JOB-NAME
  #IDENT-TYPE  (*) #IDENT-VALUE (*) #TRACING G-TRACE-MSG
IF #WRITER NE ' '
  ADD 1 TO #TJ
  #IDENT-VALUE (#TJ) := #WRITER
  #IDENT-TYPE  (#TJ) := REPORT-IDENT-JES-WRITER
END-IF
IF #DESTINATION NE ' '
  ADD 1 TO #TJ
  #IDENT-VALUE (#TJ) := #DESTINATION
  #IDENT-TYPE  (#TJ) := REPORT-IDENT-JES-DESTINATION
END-IF
IF #FORM NE ' '
  ADD 1 TO #TJ
  #IDENT-VALUE (#TJ) := #FORM
  #IDENT-TYPE  (#TJ) := REPORT-IDENT-JES-FORM
END-IF
IF #TRACING
  COMPRESS G-TRACE-MSG '/writer:' #WRITER '/form:' #FORM
    '/destination:' #DESTINATION TO G-TRACE-MSG LEAVING NO
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
#IDENT-RTYPE (1:#TJ) := 'M' /*Master
RESET #COUNT
PERFORM MASTER-DEFINITIONS-GEN
RESET #TYPE-AL-SOURCE-ID #DO-TYPE-AL
IF #TRACING
  COMPRESS 'After MASTER-DEFINITIONS: found=' #COUNT TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
IF #COUNT = 0
  IF #ONLY-TYPE-AL
    RESET #ONLY-TYPE-AL
    PERFORM CREATE-DELAYED-SOURCES
    ESCAPE ROUTINE
  END-IF
  #IDENT-RTYPE (1:#TJ) := 'D' /*Default
  PERFORM DEFAULT-DEFINITIONS-GEN /*RMSC-C
  IF #TRACING
    COMPRESS 'After DEFAULT-DEFINITIONS: found=' #COUNT TO G-TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END-IF
END-IF
*
IF #COUNT = 0 /*no report for output found
  IF +G-NOMEXIT-ACTIVE (1)
    PERFORM CALL-NOM-EXIT-001 /*RMSC-C
    IF PROCESSED-BY-NOM
      PERFORM CREATE-DELAYED-SOURCES
    ELSE
      RESET #SET-TO-TEMP
    END-IF
  ELSE
    PERFORM CHANGE-SPOOL-CLASS-TO-ERROR
  END-IF
ELSE
  PERFORM CREATE-DELAYED-SOURCES
  IF LOAD-SOURCE = TRUE
    PERFORM CREATE-LOAD-ORDER
  END-IF
  PERFORM START-FIRST-ORDER
END-IF
*
END-SUBROUTINE /* CREATE-ORDER-RECORDS
*
************************************************************************
DEFINE SUBROUTINE HANDLE-IT-SPEC /*special
************************************************************************
IF #IDENT-RTYPE (1) NE 'M' /*not Master
  PERFORM HANDLE-IT /*RMSC-C
  ESCAPE ROUTINE
END-IF
IF NOT F#NODEMATCH (<REPORT.R-INTERNAL-NODE-ID>) /*SU8
  ESCAPE TOP /*nodes different - ignore
END-IF
IF #TRACING
  COMPRESS #TYPE 'report=' REPORT.R-REPNAME TO G-TRACE-MSG LEAVING NO
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
*
RESET #THIS-IS-TYPE-AL
IF REPORT.C*R-IDENT-FILES > 0
  IF REPORT.R-IDENT-FILES(1) = 'TYPE=AL'
    IF NOT #DO-TYPE-AL
      #ONLY-TYPE-AL := TRUE
      IF #TRACING
        COMPRESS '/TYPE=AL not' TO G-TRACE-MSG
        PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
      END-IF
      ESCAPE TOP
    END-IF
    #THIS-IS-TYPE-AL:= TRUE
  ELSE
    PERFORM FILL-IDENT-FILE
    PERFORM IS-DATASET-DEFINED
    IF NOT DATASET-FOUND
      ESCAPE TOP
    END-IF
  END-IF
END-IF
*
ADD 1 TO #COUNT
IF #TRACING
  COMPRESS 'After HANDLE-IT-SPEC: #COUNT =' #COUNT TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
IF #JES-TYPE = 'AL'
  #THIS-IS-TYPE-AL := TRUE
END-IF
*
IF #THIS-IS-TYPE-AL
  PERFORM WRITE-ORDER-RECORD-AL
ELSE
  PERFORM WRITE-ORDER-RECORD
END-IF
*
END-SUBROUTINE /* HANDLE-IT-SPEC
*
************************************************************************
DEFINE SUBROUTINE FILL-IDENT-FILE
************************************************************************
IF #SOURCE-TYPE = JES2
  #PROCNAME := #JES-PROCNAME
  #STEPNAME := #JES-STEPNAME
  #DDNAME   := #JES-DDNAME
  #DSTYPE   := #JES-TYPE
  #DSNO     := #JES-DATA-SET
ELSE
  #IDENT-FILE := RMSCTR-OUT-IDENT-FILE
END-IF
*
END-SUBROUTINE /* FILL-IDENT-FILE
*
************************************************************************
DEFINE SUBROUTINE WRITE-ORDER-RECORD
************************************************************************
REPEAT
  CALLNAT 'RMODID-N' ORDER.OD-ID G-NATRP-ERC G-NATRP-ERT
  UNTIL G-NATRP-ERC NE 3145
END-REPEAT
*
PERFORM CREATE-DELAYED-SOURCES
IF #TRACING
  COMPRESS 'Order' SOURCE.SR-ID REPORT.R-REPNAME TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
IF G-NATRP-ERC NE 0
  RESET LG-OBJECT-NAME
  PERFORM WRITE-ERROR-LOG /*RMSC-C
  ESCAPE ROUTINE
END-IF
ORDER.OD-REPNAME := REPORT.R-REPNAME
#OD-TYPE := OD-CREATE-AR
PERFORM WRITE-ORDER-RECORD-GEN /*RMSC-C
*
#LAST-ORDER-ISN := #ISN
*
END-SUBROUTINE /* WRITE-ORDER-RECORD
*
************************************************************************
DEFINE SUBROUTINE WRITE-ORDER-RECORD-AL
************************************************************************
REPEAT
  CALLNAT 'RMODID-N' ORDER.OD-ID G-NATRP-ERC G-NATRP-ERT
  UNTIL G-NATRP-ERC NE 3145
END-REPEAT
*
PERFORM CREATE-DELAYED-SOURCES
IF #TRACING
  COMPRESS 'Order type=al' SOURCE.SR-ID REPORT.R-REPNAME TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
IF G-NATRP-ERC NE 0
  RESET LG-OBJECT-NAME
  PERFORM WRITE-ERROR-LOG /*RMSC-C
  ESCAPE ROUTINE
END-IF
IF #TYPE-AL-SOURCE-ID = 0
  FIND SOURCE-AL WITH SR-ID = SOURCE.SR-ID
  END-FIND
  #SOURCE-ATTR-SAVE  := #SOURCE-ATTRIBUTES
  #SPOOL-ATTR-SAVE   := #SPOOL-ATTRIBUTES
  #SOURCE-ATTRIBUTES := SOURCE-AL.SR-ATTRIBUTES-IDENT
  CALLNAT 'RMSR7--N' #SOURCE-ATTRIBUTES SOURCE-AL.SR-TYPE /*conv.node nr
  #SPOOL-ATTRIBUTES := SOURCE-AL.SR-SPOOL-ATTRIBUTES
  CALLNAT 'RMSPL7-N' #SPOOL-ATTRIBUTES #SPOOL-TYPE        /*conv.node nr
  #JES-TYPE := #SPOOL-JES-DSTYPE := 'AL'
  SOURCE-AL.SR-SPOOL-ATTRIBUTES := #SPOOL-ATTRIBUTES
  SOURCE-AL.SR-ATTRIBUTES-IDENT := #SOURCE-ATTRIBUTES
  #SPOOL-ATTRIBUTES    := #SPOOL-ATTR-SAVE
  #SOURCE-ATTRIBUTES   := #SOURCE-ATTR-SAVE
  RESET SOURCE-AL.SR-RECORD-LENGTH
  SOURCE-AL.SR-CC-TYPE := NO-CC
  FIND SPOOLF-AL WITH NODE=#SPOOL-JES-NODE /*lreclAnd whether or not any
  AND JOB-NAME = #SPOOL-JES-JOB-NAME  /* file has carriage control.   /*
  AND JOB-NUMBER = #SPOOL-JES-JOB-NUMBER AND TYPE = 'SM' OR = 'SO'    /*
    IF SPOOLF-AL.ERROR-CODE NE 0
      WRITE *PROGRAM *TIMX (EM=YYYY-MM-DD' 'HH:II:SS)
        'Unable to determine TYPE=AL lrecl/recfm'
        / 'Job:' #SPOOL-JES-JOB-NAME 'Num:' #SPOOL-JES-JOB-NUMBER
        / SPOOLF-AL.ERROR-CODE SPOOLF-AL.ERROR-TEXT
    END-IF
    IF LRECL GT SOURCE-AL.SR-RECORD-LENGTH
      SOURCE-AL.SR-RECORD-LENGTH:= LRECL
    END-IF
    IF RECFM = SCAN 'A' OR = SCAN 'M'
      SOURCE-AL.SR-CC-TYPE:= ASA-CODE
    END-IF
  END-FIND
  FIND (1) SYSOUT-AL WITH NODE = #SPOOL-JES-NODE AND TYPE = 'AL'
  AND JOB-NAME = #SPOOL-JES-JOB-NAME AND RECORD-NUMBER GE -1          /*
  AND JOB-NUMBER = #SPOOL-JES-JOB-NUMBER                              /*
    IF NO RECORDS FOUND
      WRITE *PROGRAM *TIMX (EM=YYYY-MM-DD' 'HH:II:SS)
        'Error reading TYPE=AL for' #SPOOL-JES-JOB-NAME
        #SPOOL-JES-JOB-NUMBER / 'no records found'
      ESCAPE BOTTOM
    END-NOREC
    IF SYSOUT-AL.ERROR-CODE NE 0
      WRITE *PROGRAM *TIMX (EM=YYYY-MM-DD' 'HH:II:SS)
        'Error reading TYPE=AL for' #SPOOL-JES-JOB-NAME
        #SPOOL-JES-JOB-NUMBER /
        SYSOUT-AL.ERROR-CODE SYSOUT-AL.ERROR-TEXT
      ESCAPE BOTTOM
    END-IF
    SOURCE-AL.SR-NUMBER-OF-LINES:= RECORD-NUMBER
  END-FIND
  REPEAT
    CALLNAT 'RMSRID-N' SOURCE-AL.SR-ID G-NATRP-ERC G-NATRP-ERT
    UNTIL G-NATRP-ERC NE 3145
  END-REPEAT
*
  IF G-NATRP-ERC NE 0
    WRITE *PROGRAM *TIMX (EM=YYYY-MM-DD' 'HH:II:SS)
      'Unable to create new source record'
    ESCAPE BOTTOM
  END-IF
  #TYPE-AL-SOURCE-ID:= SOURCE-AL.SR-ID
  SOURCE-AL.SR-CONTROL-FLAG:= 'X'
  STORE SOURCE-AL
  END OF TRANSACTION
  IF #TRACING
    COMPRESS 'Create type=al source record with SR-'
      'CONTROL-FLAG:'     SOURCE-AL.SR-CONTROL-FLAG
      'TYPE:'             SOURCE-AL.SR-TYPE
      'ATTRIBUTES-IDENT:' SOURCE-AL.SR-ATTRIBUTES-IDENT
      'SPOOL-ATTRIBUTES:' SOURCE-AL.SR-SPOOL-ATTRIBUTES
      'CC-TYPE:'          SOURCE-AL.SR-CC-TYPE
      'RECORD-LENGTH:'    SOURCE-AL.SR-RECORD-LENGTH
      'NUMBER-OF-LINES:'  SOURCE-AL.SR-NUMBER-OF-LINES
      'MONITOR-ID.'       SOURCE-AL.SR-MONITOR-ID TO G-TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END-IF
END-IF
RESET ORDER.OD-PARAMETER (1) ORDER.OD-TIME-SCHEDULED
ORDER.OD-TYPE             := OD-CREATE-AR
ORDER.OD-MONITOR-ID       := G-MONITOR-ID
ORDER.OD-USER-ID          := REPORT.R-USERID
ORDER.OD-MASTER           := REPORT.R-REPNAME
ORDER.OD-SOURCE-ID        := #TYPE-AL-SOURCE-ID
ORDER.OD-TIME-CREATED     := *TIMX
ORDER.OD-MAX-RETRIES      := #MAX-RETRIES
ORDER.OD-RETRY-INTERVAL   := #RETRY-INTERVAL
ORDER.OD-INTERNAL-NODE-ID := +NOD-CURRENT-INTERNAL-ID
*
IF #TRACING
  COMPRESS 'Write type=al order record OD-'
    'PARAMETER:'  ORDER.OD-PARAMETER (1) 'TYPE:'    ORDER.OD-TYPE
    'MONITOR-ID:' ORDER.OD-MONITOR-ID    'USER-ID:' ORDER.OD-USER-ID
    'MASTER:'     ORDER.OD-MASTER        'SOURCE-ID:' ORDER.OD-SOURCE-ID
    'TIME-CREATED:'   ORDER.OD-TIME-CREATED
    'TIME-SCHEDULED:' ORDER.OD-TIME-SCHEDULED
    'MAX-RETRIES:'    ORDER.OD-MAX-RETRIES
    'RETRY-INTERVAL:' ORDER.OD-RETRY-INTERVAL TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
*
STOAL. STORE ORDER
#LAST-TYPAL-ISN := *ISN (STOAL.)
END OF TRANSACTION
*
END-SUBROUTINE /* WRITE-ORDER-RECORD-AL
*
************************************************************************
DEFINE SUBROUTINE CREATE-LOAD-ORDER
************************************************************************
IF #TRACING
  COMPRESS 'Create load order' 'SR-ID:' SOURCE.SR-ID TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
*
REPEAT
  CALLNAT 'RMODID-N' ORDER.OD-ID G-NATRP-ERC G-NATRP-ERT
  UNTIL G-NATRP-ERC NE 3145
END-REPEAT
*
IF G-NATRP-ERC NE 0
  RESET LG-OBJECT-NAME
  PERFORM WRITE-ERROR-LOG /*RMSC-C
  ESCAPE ROUTINE
END-IF
*
RESET ORDER.OD-PARAMETER (1)
ORDER.OD-TYPE                := OD-LOAD-SOURCE
ORDER.OD-MONITOR-ID          := G-MONITOR-ID
ORDER.OD-USER-ID             := REPORT.R-USERID
RESET ORDER.OD-DBID ORDER.OD-FNR
IF #FOUND > 0 AND +NOD-LOCAL-NODE = +NOD-CURRENT-NODE
  ORDER.OD-IDENT   := G-COPY-IDENT (#FOUND)
  RESET ORDER.OD-REP-FORMAT
  ORDER.OD-DBID-N5 := G-COPY-DBID  (#FOUND)
  ORDER.OD-FNR-N5  := G-COPY-FNR   (#FOUND)
ELSE
  ORDER.OD-IDENT   := 'NOM'
  ORDER.OD-DBID-N5 := G-SCAN-TRIGGER-DBID
  ORDER.OD-FNR-N5  := G-SCAN-TRIGGER-FNR
END-IF
ORDER.OD-SOURCE-ID      := SOURCE.SR-ID
ORDER.OD-TIME-CREATED   := *TIMX
ORDER.OD-MAX-RETRIES    := #MAX-RETRIES
ORDER.OD-RETRY-INTERVAL := #RETRY-INTERVAL
ORDER.OD-INTERNAL-NODE-ID  := +NOD-CURRENT-INTERNAL-ID
*
STOOD. STORE ORDER
#LAST-ORDER-ISN := *ISN (STOOD.)
END OF TRANSACTION
*
END-SUBROUTINE /* CREATE-LOAD-ORDER
*
************************************************************************
DEFINE SUBROUTINE START-FIRST-ORDER
************************************************************************
IF #LAST-ORDER-ISN GT 0
  PERFORM START-FIRST-ORDER-GEN1 /*RMSC-C
END-IF
IF #LAST-TYPAL-ISN GT 0
  #LAST-ORDER-ISN := #LAST-TYPAL-ISN
  PERFORM START-FIRST-ORDER-GEN1 /*RMSC-C
END-IF
RESET #LAST-ORDER-ISN #LAST-TYPAL-ISN G-CYCLE-WAS-IDLE
CALLNAT 'N-WAKEUP' /*Wake up monitor to "create RP" + copy source
*
END-SUBROUTINE /* START-FIRST-ORDER
*
************************************************************************
DEFINE SUBROUTINE WRITE-LOG-RECORD
************************************************************************
COMPRESS SPOOL-FILE.NODE '/' SPOOL-FILE.JOB-NAME   '/'
  SPOOL-FILE.JOB-NUMBER '/' SPOOL-FILE.TYPE '/' SPOOL-FILE.DATA-SET
  TO LG-OBJECT-NAME LEAVING NO
LG-MSG := LG-OBJECT-NAME
COMPRESS '1100' LG-MSG TO LG-MSG
LG-USERID := G-LG-USERID
LG-CODE   := 'NP'
CALLNAT 'RLOG' PL-PARMS
END OF TRANSACTION
*
END-SUBROUTINE /* WRITE-LOG-RECORD
*
************************************************************************
DEFINE SUBROUTINE PREP-SOURCE
************************************************************************
IF #TRACING
  G-TRACE-MSG := 'Prepare source'
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
*
#PREP-SOURCE-CREATE          (#PREP-INDEX) := TRUE
#PREP-SOURCE-CONTROL-TYPE    (#PREP-INDEX) := #CONTROL-TYPE
#PREP-SOURCE-CONTROL-IDENT   (#PREP-INDEX) := #CONTROL-IDENT
#PREP-SOURCE-CONTROL-FLAG    (#PREP-INDEX) := #CONTROL-FLAG
#PREP-SOURCE-TYPE            (#PREP-INDEX) := #SOURCE-TYPE
#PREP-SOURCE-ATTR-IDENT      (#PREP-INDEX) := #SOURCE-ATTRIBUTES
#PREP-SOURCE-SPOOL-ATTR      (#PREP-INDEX) := #SPOOL-ATTRIBUTES
#PREP-SOURCE-CC-TYPE         (#PREP-INDEX) := #CC-TYPE
#PREP-SOURCE-RECORD-LENGTH   (#PREP-INDEX) := #RECORD-LENGTH
#PREP-SOURCE-NUMBER-OF-LINES (#PREP-INDEX) := #NUMBER-OF-LINES
#PREP-SOURCE-MONITOR-ID      (#PREP-INDEX) := G-MONITOR-ID
*
END-SUBROUTINE /* PREP-SOURCE
*
************************************************************************
DEFINE SUBROUTINE CREATE-DELAYED-SOURCES
************************************************************************
IF #TRACING
  G-TRACE-MSG := 'Create delayed sources'
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
*
FOR #PREP-INDEX 1 2
  IF NOT #PREP-SOURCE-CREATE (#PREP-INDEX)
    ESCAPE TOP
  END-IF
  IF #TRACING
    COMPRESS 'Create delayed sources, index:' #PREP-INDEX TO G-TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END-IF
  #CONTROL-TYPE      := #PREP-SOURCE-CONTROL-TYPE    (#PREP-INDEX)
  #CONTROL-IDENT     := #PREP-SOURCE-CONTROL-IDENT   (#PREP-INDEX)
  #CONTROL-FLAG      := #PREP-SOURCE-CONTROL-FLAG    (#PREP-INDEX)
  #SOURCE-TYPE       := #PREP-SOURCE-TYPE            (#PREP-INDEX)
  #SOURCE-ATTRIBUTES := #PREP-SOURCE-ATTR-IDENT      (#PREP-INDEX)
  #SPOOL-ATTRIBUTES  := #PREP-SOURCE-SPOOL-ATTR      (#PREP-INDEX)
  #CC-TYPE           := #PREP-SOURCE-CC-TYPE         (#PREP-INDEX)
  #RECORD-LENGTH     := #PREP-SOURCE-RECORD-LENGTH   (#PREP-INDEX)
  #NUMBER-OF-LINES   := #PREP-SOURCE-NUMBER-OF-LINES (#PREP-INDEX)
  G-MONITOR-ID       := #PREP-SOURCE-MONITOR-ID      (#PREP-INDEX)
  IF #PREP-INDEX = 2
    #QUEUE-ID := #PREP-QUEUE-ID
  END-IF
  PERFORM CREATE-SOURCE-RECORD
  IF #PREP-INDEX = 1
    #PREP-QUEUE-ID := SOURCE.SR-ID
  END-IF
  #PREP-SOURCE-CREATE (#PREP-INDEX) := FALSE
END-FOR
*
END-SUBROUTINE /* CREATE-DELAYED-SOURCES
*
************************************************************************
DEFINE SUBROUTINE WAIT-A-FEW-SECONDS
************************************************************************
CALLNAT 'NAT00031' #WAIT-TIME /* 5 seconds
*
END-SUBROUTINE /* WAIT-A-FEW-SECONDS
*
************************************************************************
ON ERROR
************************************************************************
  PERFORM CHANGE-SPOOL-CLASS-TO-ERROR
*
END-ERROR
