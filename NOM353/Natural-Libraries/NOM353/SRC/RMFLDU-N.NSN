* Version      3.2
* Function     Get attributes for flush via DISKUNIX
*
* Maintenance
* uuu     yyyy-mm-dd s(999999) ...
* fhi     2008-06-25 P306560   created from RMFLDX-N
* fhi     2009-07-13 N3463     parameter shifted
* fhi     2009-07-16 N3463     parameter shifted backouted
* fhi     2010-03-03 P308272   parameter shifted
* fhi     2010-09-03 NOMALL-97 Extend message line
* xsetggr 2010-12-21 NOMALL-865 restow due to changes in RMFL---P
* fhi     2012-06-12 NOMALL-1004 Extensions for NOM 3.4
* fhi     2013-02-18 NOMALL-1004 Variable names converted to upper.
* fhi     2013-12-04 NOMALL-1004 Same. Additional stuff.
* fhi      2014-08-25 NOMALL-1475 Introduce formatter uniprint
* SU1     2020-04-09 remove unused
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER USING RMFL---P
PARAMETER
1 P-ERROR-CODE                 (N4)
1 P-ERROR-TEXT                 (A250)
************************************************************************
LOCAL USING EOMPHTYE
LOCAL
1 PRINTOUT VIEW OF NRM-PRINTOUTS
  2 PO-ATTRIBUTES              (1:25)
  2 REDEFINE PO-ATTRIBUTES
    3 PO-ATTRIB                (1:25)
      4 PO-IDENT               (I1)
      4 PO-LENGTH              (N2)
      4 PO-PROMPT              (N4)
      4 PO-VAR                 (A16)
      4 PO-VALUE               (A72)
  2 C*PO-ATTRIBUTES
*
1 F                            (I2)
1 NOE                          (I2)
1 #PO-VAR                      (A16)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET P-ERROR-CODE P-ERROR-TEXT
*
PERFORM READ-PRINTOUT-RECORD
IF P-ERROR-CODE = 0
  PERFORM DISKUNIX-INTERFACE
END-IF
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE READ-PRINTOUT-RECORD
************************************************************************
FNDPR. FIND PRINTOUT WITH PO-ID = FLUSH-POID
  IF NO RECORDS FOUND
    P-ERROR-CODE := 0005
    P-ERROR-TEXT := 'Printout Record not found'
    ESCAPE BOTTOM (FNDPR.)
  END-NOREC
END-FIND
*
END-SUBROUTINE /* READ-PRINTOUT-RECORD
*
************************************************************************-
DEFINE SUBROUTINE DISKUNIX-INTERFACE
************************************************************************
RESET DISKUNIX-ATTRIBUTES
IF PRINTOUT.C*PO-ATTRIBUTES > 25
  NOE := 25
ELSE
  NOE := PRINTOUT.C*PO-ATTRIBUTES
END-IF
FOR F = 1 TO NOE
  #PO-VAR := PO-VAR (F)
  EXAMINE #PO-VAR TRANSLATE INTO UPPER
  DECIDE ON FIRST #PO-VAR
    VALUE 'SERVICE'  DISKUNIX-SERVICE  := PO-VALUE (F)
    VALUE 'PATH'     DISKUNIX-PATH     := PO-VALUE (F)
    VALUE 'LOGPATH'  DISKUNIX-LOGPATH  := PO-VALUE (F)
    VALUE 'FILENAME' DISKUNIX-FILENAME := PO-VALUE (F)
    VALUE 'FILETYPE' DISKUNIX-FILETYPE := PO-VALUE (F)
    VALUE 'COMMAND'  DISKUNIX-COMMAND  := PO-VALUE (F)
    VALUE 'OPT1'     DISKUNIX-OPT1     := PO-VALUE (F)
    VALUE 'OPT2'     DISKUNIX-OPT2     := PO-VALUE (F)
    VALUE 'PARM1'    DISKUNIX-PARM1    := PO-VALUE (F)
    VALUE 'PARM2'    DISKUNIX-PARM2    := PO-VALUE (F)
    VALUE 'PARM3'    DISKUNIX-PARM3    := PO-VALUE (F)
*   /* DESIRED FILE FORMAT: 'PS','EPS','PDF','PCL','RTF','HTML'
*   /*                      'TIFF','JPEG','PNG','BMP',
    VALUE 'OUTPUT-FORMAT' DISKUNIX-OUTPUT-FORMAT := PO-VALUE (F)
*   ENSCRIPT --
    VALUE 'HEADER'      DISKUNIX-HEADER      := PO-VALUE (F)
    VALUE 'HEADER-FONT' DISKUNIX-HEADER-FONT := PO-VALUE (F)
    VALUE 'FOOTER'      DISKUNIX-FOOTER      := PO-VALUE (F)
    VALUE 'FONT'        DISKUNIX-FONT        := PO-VALUE (F)
    VALUE 'LINES'       DISKUNIX-LINES       := PO-VALUE (F) /*LINES-PP
    VALUE 'LANDSCAPE'   DISKUNIX-LANDSCAPE   := PO-VALUE (F) /* -R / -R
    VALUE 'CODEPAGE'    DISKUNIX-CODEPAGE    := PO-VALUE (F) /*ENCODING
    VALUE 'ADDITIONAL'  DISKUNIX-ADDITIONAL  := PO-VALUE (F)/*USER PARMS
    VALUE 'MEDIA'       DISKUNIX-MEDIA       := PO-VALUE (F) /* -M
    VALUE 'MASK'        DISKUNIX-MASK        := PO-VALUE (F) /* -M
    VALUE 'FORMATTER'   DISKUNIX-FORMATTER   := PO-VALUE (F)
    VALUE 'TRACE'       DISKUNIX-TRACE       := PO-VALUE (F)
    NONE VALUE IGNORE
  END-DECIDE
END-FOR
*
END-SUBROUTINE /* DISKUNIX-INTERFACE
*
END
