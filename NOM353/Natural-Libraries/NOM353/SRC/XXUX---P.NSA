DEFINE DATA PARAMETER
/* >Natural Source Header 000000
/* :Mode S
/* :CP
/* <Natural Source Header
*  **********************************      ************************************
*  *XXUX---P
*  *PARAMETERS FOR UNIX NODES
*  *CORRESPONDING PROGRAM: XXUX---N
*  *MODIFICATIONS
*  *USER ID YYYY-MM-DD MARK                    COMMENT
*  *FHI     2000-09-12                         CREATED
*  **********************************      ************************************
1 XXUX---P
  2 P-FUNCTION (A8) /*IN, SEE XXUX---N
  2 P-NODE-NAME (A16) /*IN, UNIX / WINDOWS NODE NAME
  2 P-USERID (A8) /*IN, USER ID ON NODE
  2 P-PASSWORD (A16) /*IN, PASSWORD OF USER ID
  2 P-CIPHER-PASSWORD (A32) /*IN, ENCRYPTED PASSWORD
  2 P-GROUP (A20) /*IN, UNIX: GROUP, WIN: DOMAIN
  2 P-OPSYS (A8) /*OUT, OPERATING SYSTEM
  2 P-NPR-VERSION (A10) /*NOMALL-1620 WAS A5     R
  2 P-FILE-NAME (A250) /*IN, FILE TO BE PROCESSED
  2 P-FILE-HANDLE (N10) /*IN, FILE HANDLE        D
  2 P-STATUS (N2) /*OUT, STATUS CODE
*                                              OR OUTPUT FILE OF 'JOB' FUNCTNS
  2 P-RECORD (A250)
*                                              OR COMMAND TO BE EXECUTED
  2 REDEFINE P-RECORD /* REDEF. BEGIN : P-RECORD
    3 P-TARGET-FILE (A200)
  2 P-CC (A1) /*ASA CONTROL CHR FOR CURR LINE
  2 P-ERC (N4) /*OUT, ERROR NUMBER
  2 P-ERT (A250) /*OUT, ERROR TEXT
  2 P-ETB-ERC (A8) /*OUT, BROKER ERROR, FUTURE USE
  2 P-PROCESS-ID (N10) /*OUT, PROCESS ID OF STARRE USE
  2 P-BINARY (A1) /*OUT, PROCESS ID OF STARRE USE
  2 P-EXIT-CODE (N10) /*OUT, EXIT CODE  OF STARRE USE
  2 P-LOG-FUNCTION (A1) /*IN, 'W','S',' '-> RLOG RE USE
*  **********************************      ************************************
*  *NOW SOME HANDLES FOLLOW.
*  *DON'T CHANGE THEM, THEY ARE FOR
*  *INTERNAL USE OF XXUX* MODULES.
*  **********************************      ************************************
  2 #MR-P-POSITION (I4) /*POSITION IN READ BUFFER
*  2#MR-P-BUFFER-600                A       600/*P300605 out            YTES
*  2#MR-P-BUFFER-9700               A      9700/*NOMALL-1903 FHI OUT    YTES
  2 #MR-P-BUFFER (A) DYNAMIC /*NOMALL-1903 FHI IN     YTES
  2 #MR-P-FILE-NAME (A250) /*SAVED FILE NAME FOR READ
  2 #XS-FIRW-CONTROL-CHAR (A10) /*SAVED CONTROL CHR OF NPR
  2 #XS-FIRW-LINE-NUMBER (I4) /*SAVED LINE NUMBER FOR DIR
  2 #EOF (L) /*OUT OF PHYSICAL RECORDS,
*                                              BUT BUFFER MAYBE STILL FILLED
  2 P-NODE-SUSPEND (A1) /*NODE TYPE ("M" OR "L") E
  2 P-MIME-TYPE (A81) /*MIME TYPE OF CMD 'FILE'
  2 P-OUTPUT-MODE (A1) /*A=APPEND OUTPUT FILE
  2 P-WAIT-TERM (A1) /*Y=COMMAND IS SYNCHRONOUS
*                                              /* EMPTY: ASYNCHRONOUS
*                                              /* 'Z':   SYNCHRONOUS AND
*                                              /* NO EXIT CODE LINE
  2 P-COMMAND-PART-2-3 (A750) /*NOMALL-2261 WAS 250
  2 P-CODEPAGE (A64) /*NOMALL-1454            RE USE
END-DEFINE
