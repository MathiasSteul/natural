*
END-DEFINE
************************************************************************
* Main line
************************************************************************
* PRINT *PROGRAM *LINE 'start' 'HEB-KY' '=' ES-FUNCTION /* HEB-TEMP
*
IF ES-FUNCTION = 'LS3'
  ES-FUNCTION := 'LS2'
END-IF
CALLNAT 'ESMAVC-N' 'N' P-VERSION-A10 P-ERC ES-CONTROL /*1 char->2 digit
IF #VER < 3 OR (#VER = 3 AND #REL < 4) /* NGC33
  RESET ES-EXTEND-FUNCTION
  NOMVER-PRODUCTNAME := 'EOM'
  CALLNAT 'PRDVER-N' NOMVER-PARMS P-ERC P-ERT
  COMPRESS 'NOM' NOMVER-VERSION '.' NOMVER-RELEASE '.' NOMVER-SP
    ' does not support this NGC' #VER '.' #REL '.' #SM
    ' function (' *PROGRAM ')' TO ES-MSG-TXT LEAVING NO
  ES-RC := 1
  ESCAPE ROUTINE
END-IF
*
IF SUBSTR(ES-EXTEND-FUNCTION,1,2) NE 'VL'
OR NOT (ES-EXPAND = 'E' AND (ES-FUNCTION = 'LS2' OR='LS1' OR= 'LS'))  /*
  RESET ES-EXTEND-FUNCTION
  CALLNAT 'NOARLS1N' ES-CONTROL ES-INPUT ES-WORK NOARLS-PARMS
  ESCAPE ROUTINE
END-IF
IF ES-CLIENT-TIMEOUT > 10 AND ES-CLIENT-TIMEOUT < 9999
  #TIMEOUT := *TIMX + (ES-CLIENT-TIMEOUT - 10) * 10
ELSE
  #TIMEOUT := *TIMX + 450
END-IF
#V-PARM(1:2) := NOARLS-PARM-AREA(1:2)
RESET NOARLS-PARM-AREA(*)
RESET ES-RC ES-NUMBER ES-STARTINDEX #TT ES-INVCOL-NUM
ES-EOF := 'X'
#NOARSL := ES-SELECT
* PRINT *PROGRAM *LINE 'start' 'HEB-KY' '=' #POSTFIX
EXAMINE #NOARSL.#SOURCE FOR '*' DELETE
EXAMINE #NOARSL.#SENDER FOR '*' DELETE
COMPRESS #NOARSL.#SOURCE H'00' TO #SOURCE-F LEAVING NO
COMPRESS #NOARSL.#SOURCE H'FF' TO #SOURCE-T LEAVING NO
COMPRESS #NOARSL.#SENDER H'00' TO #SENDER-F LEAVING NO
COMPRESS #NOARSL.#SENDER H'FF' TO #SENDER-T LEAVING NO
/* HEB2 >
#KY-SEL (1)   := #NOARSL.#KEYWORD
#KY-SEL (2:4) := #NOARSL.#KEYWORD-2-4 (1:3)
IF #KY-SEL (*) = '*'
AND #KEYWORD-AND-OR NE 'A'
  RESET #KY-SEL (*)
END-IF
EXAMINE #KY-SEL (1) FOR '*' REPLACE WITH ' '
        GIVING NUMBER #NUM LENGTH #L1
IF #L1 < 1
OR #NUM = 0 /* Deactivate this line => Keyword prefix search
  #L1 := 15
END-IF
EXAMINE #KY-SEL (2) FOR '*' REPLACE WITH ' '
        GIVING NUMBER #NUM LENGTH #L2
IF #L2 < 1
OR #NUM = 0 /* Deactivate this line => Keyword prefix search
  #L2 := 15
END-IF
EXAMINE #KY-SEL (3) FOR '*' REPLACE WITH ' '
        GIVING NUMBER #NUM LENGTH #L3
IF #L3 < 1
OR #NUM = 0 /* Deactivate this line => Keyword prefix search
  #L3 := 15
END-IF
EXAMINE #KY-SEL (4) FOR '*' REPLACE WITH ' '
        GIVING NUMBER #NUM LENGTH #L4
IF #L4 < 1
OR #NUM = 0 /* Deactivate this line => Keyword prefix search
  #L4 := 15
END-IF
/* HEB2 <
FIND USERS WITH USER-ID = ES-USER
  PROFILE-STRING := USER-PROFILE
END-FIND
EXAMINE #NOARSL.#KEYWORD FOR '*' DELETE
EXAMINE #NOARSL.#REPNAME FOR '*' DELETE
PERFORM INIT-DAT-KEY
IF ES-KEY-CODE(3) = 'LC'
  #LOC := ES-KEY-PARM(3)
END-IF
ES-OPTION-COUNT := 10
IF ES-EXPAND = 'E'
  ES-FIELD-COUNT := 1
  DECIDE ON FIRST VALUE OF ES-FUNCTION
    VALUE 'LSA'
      #IMAX := 816
      NOAREX-FIELD-LENGTH(1) := 11
    VALUE 'LS1'
      ES-FIELD-COUNT := 4
      #IMAX := 495
      NOARVX-FIELD-LENGTH(1) := 11
      NOARVX-FIELD-LENGTH(2) := 8
      NOARVX-FIELD-LENGTH(3) := 5
      NOARVX-FIELD-LENGTH(4) := 7
      #R-NAME-E := ES-KEY-PARM(3)
      IF ES-EXTEND-FUNCTION = 'VL2'
        IF #V-PARM(2) NE ' '
          SEPARATE #V-PARM(2) LEFT INTO #R-RNB-E #R-USER-E #R-FO-ID-E
          IGNORE WITH DELIMITERS ';'
          MOVE RIGHT #R-RNB-E TO #R-RNB-E
          IF #R-RNB-E IS (N11)
            #R-RNB-EN := VAL(#R-RNB-E)
          ELSE
            #R-RNB-EN := 9999999999
          END-IF
        ELSE
          #R-RNB-EN := 9999999999
          #R-USER-E := H'FF'
          #R-FO-ID-E := H'FFFF'
        END-IF
      END-IF
    VALUE 'LS'
      ES-FIELD-COUNT := 4
      #IMAX := 561
      ES-OPTION-COUNT := 0
      NOARV1-FIELD-LENGTH(1) := 25
      NOARV1-FIELD-LENGTH(2) := 8
      NOARV1-FIELD-LENGTH(3) := 5
      NOARV1-FIELD-LENGTH(4) := 7
      IF ES-EXTEND-FUNCTION = 'VL2'
        IF #V-PARM(2) NE ' '
          SEPARATE #V-PARM(2) LEFT INTO
            #MA-REP-E #MA-FOLDER-USER-ID-E #R-FO-ID-E
          IGNORE WITH DELIMITERS ';'
          #MA-FOLDER-ID-E := #R-FO-ID-E
        ELSE
          #MA-REP-E := H'FF'
          #MA-FOLDER-USER-ID-E := H'FF'
          #MA-FOLDER-ID-E := H'FFFF'
        END-IF
        #MA-RNB-E := 99999999999
        #R-NAME-E := #MA-REP-E
        #R-USER-E := #MA-FOLDER-USER-ID-E
        #R-FO-ID-E := #MA-FOLDER-ID-E
      END-IF
    VALUE 'LS2'
      ES-FIELD-COUNT := 4
      #IMAX := 328
      NOARV2-FIELD-LENGTH(1) := 37
      NOARV2-FIELD-LENGTH(2) := 8
      NOARV2-FIELD-LENGTH(3) := 5
      NOARV2-FIELD-LENGTH(4) := 7
      IF ES-EXTEND-FUNCTION = 'VL2'
        IF #V-PARM(2) NE ' '
          SEPARATE #V-PARM(2) LEFT INTO
            #R-NAME-E #R-RNB-E #R-USER-E #R-FO-ID-E
          IGNORE WITH DELIMITERS ';'
          MOVE RIGHT #R-RNB-E TO #R-RNB-E
          IF #R-RNB-E IS (N11)
            #R-RNB-EN := VAL(#R-RNB-E)
          ELSE
            #R-RNB-EN := 9999999999
          END-IF
        ELSE
          #R-NAME-E := H'FF'
          #R-RNB-EN := 9999999999
          #R-USER-E := H'FF'
          #R-FO-ID-E := H'FFFF'
        END-IF
      END-IF
    NONE VALUE IGNORE
  END-DECIDE
  #MAX-NA := #V-PARM(1)
  IF #MAX-N(1) = 0 OR #MAX-N(1) >= #IMAX
    #MAX-N(1) := #IMAX - 1
  END-IF
  IF #MAX-N(2) = 0 OR #MAX-N(2) >= #IMAX
    #MAX-N(2) := #IMAX - 1
  END-IF
/* Remainder without separation #MAX-N(2) should be      /* CF2
/* at least twice the number of intervals #MAX-N(1)
/* to get proper intervals with real gaps inbetween.
/* But no problems occur if not regarding this hint.     /* CF2
  IF #MAX-N(2) < #MAX-N(1)
    #MAX-N(2) := #MAX-N(1)
  END-IF
  IF #MAX-N(3) <= #IMAX
    #MAX-N(3) := 0
  END-IF
  IF #MAX-N(4) = 0 OR #MAX-N(4) > (ES-CLIENT-TIMEOUT - 10)
    #TIMELIMIT := *TIMX + (ES-CLIENT-TIMEOUT - 10) * 10
  ELSE
    #TIMELIMIT := *TIMX + #MAX-N(4) * 10
  END-IF
ELSE
  DECIDE ON FIRST VALUE OF ES-FUNCTION
    VALUE 'LSA'
      ES-SORTKEY := 0
      ES-SORTORDER := 1
      IF #NOARSL.#SOURCE NE ' ' OR #NOARSL.#SENDER NE ' '
        ES-SORTKEY := 12
        ES-SORTORDER := 0
      END-IF
      #IMAX := 139
      ES-FIELD-COUNT := 13
      NOARLA-FIELD-LENGTH(1) := 812
      NOARLA-FIELD-LENGTH(2) := 911
      NOARLA-FIELD-LENGTH(3) := 909
      NOARLA-FIELD-LENGTH(4) := 909
      NOARLA-FIELD-LENGTH(5) := 1
      NOARLA-FIELD-LENGTH(6) := 1
      NOARLA-FIELD-LENGTH(7) := 1
      NOARLA-FIELD-LENGTH(8) := 808
      NOARLA-FIELD-LENGTH(9) := 808
      NOARLA-FIELD-LENGTH(10):= 808
      NOARLA-FIELD-LENGTH(11) := 10
      NOARLA-FIELD-LENGTH(12) := 50
      NOARLA-FIELD-LENGTH(13) := 33
    VALUE 'LS'
      ES-SORTKEY := 0
      ES-SORTORDER := 0
      #IMAX := 308
      ES-FIELD-COUNT := 3
      ES-OPTION-COUNT := 0
      NOARLS-FIELD-LENGTH(1) := 25
      NOARLS-FIELD-LENGTH(2) := 50
      NOARLS-FIELD-LENGTH(3) := 907
    VALUE 'LS1'
      ES-SORTKEY := 0
      ES-SORTORDER := 1
      IF #NOARSL.#SOURCE NE ' ' OR #NOARSL.#SENDER NE ' '
        ES-SORTKEY := 13
        ES-SORTORDER := 0
      END-IF
      #IMAX := 130
      ES-FIELD-COUNT := 14
      NOARL1-FIELD-LENGTH(1) := 812
      NOARL1-FIELD-LENGTH(2) := 812
      NOARL1-FIELD-LENGTH(3) := 911
      NOARL1-FIELD-LENGTH(4) := 909
      NOARL1-FIELD-LENGTH(5) := 909
      NOARL1-FIELD-LENGTH(6) := 1
      NOARL1-FIELD-LENGTH(7) := 1
      NOARL1-FIELD-LENGTH(8) := 1
      NOARL1-FIELD-LENGTH(9) := 808
      NOARL1-FIELD-LENGTH(10) := 808
      NOARL1-FIELD-LENGTH(11) := 808
      NOARL1-FIELD-LENGTH(12) := 10
      NOARL1-FIELD-LENGTH(13) := 50
      NOARL1-FIELD-LENGTH(14) := 33
    VALUE 'LS2'
      IF PROF-AR-SORT = 'D'
          OR #NOARSL.#REPNAME = ' '
          OR #NOARSL.#REPNAME = '*'
        ES-SORTKEY := 2
        ES-SORTORDER := 1
      ELSE
        ES-SORTKEY := 0
        ES-SORTORDER := 0
      END-IF
      IF #NOARSL.#SOURCE NE ' ' OR #NOARSL.#SENDER NE ' '
        ES-SORTKEY := 14
        ES-SORTORDER := 0
      END-IF
      #IMAX := 115
      ES-FIELD-COUNT := 15
      NOARL2-FIELD-LENGTH(1) := 25
      NOARL2-FIELD-LENGTH(2) := 911
      NOARL2-FIELD-LENGTH(3) := 812
      NOARL2-FIELD-LENGTH(4) := 812
      NOARL2-FIELD-LENGTH(5) := 909
      NOARL2-FIELD-LENGTH(6) := 909
      NOARL2-FIELD-LENGTH(7) := 1
      NOARL2-FIELD-LENGTH(8) := 1
      NOARL2-FIELD-LENGTH(9) := 1
      NOARL2-FIELD-LENGTH(10) := 808
      NOARL2-FIELD-LENGTH(11) := 808
      NOARL2-FIELD-LENGTH(12) := 808
      NOARL2-FIELD-LENGTH(13) := 10
      NOARL2-FIELD-LENGTH(14) := 50
      NOARL2-FIELD-LENGTH(15) := 33
    NONE VALUE IGNORE
  END-DECIDE
END-IF
DECIDE ON FIRST VALUE OF ES-FUNCTION
  VALUE 'LS'
    PERFORM LIST-ACTIVE-REPORTS-IN-FOLDER-SUMMARY-VIRT
    PERFORM CALCULATE-INTERVAL
    FOR #I2 = 1 TO #MAX-N12
      #II1 := (#I2 - 1) * #II + 1 + #II2
      IF #II1 > #I-ISN
        ESCAPE BOTTOM
      END-IF
      GET MA #ISN-LIST(#II1)
      PERFORM DATA-TO-PDA
      ES-NUMBER := #I2
      IF #II2 < #IR
        ADD 1 TO #II2
        NOARV1-NUM(#I2) := #II + 1
      ELSE
        NOARV1-NUM(#I2) := #II
      END-IF
    END-FOR
    IF ES-EXTEND-FUNCTION = 'VL1' OR = 'VL3' AND #I-ISN > #MAX-N(2)
      ADD 1 TO #I-ISN
      #I2 := #MAX-N12 + 1
      ES-NUMBER := #I2
      GET MA #ISN-LIST(#I-ISN)
      PERFORM DATA-TO-PDA
      NOARV1-NUM(#I2) := 1
    END-IF
  VALUE 'LS1'
    PERFORM LIST-ACTIVE-REPORTS-IN-FOLDER-REPORT-VIRT
    PERFORM CALCULATE-INTERVAL
    FOR #I2 = 1 TO #MAX-N12
      #II1 := (#I2 - 1) * #II + 1 + #II2
      IF #II1 > #I-ISN
        ESCAPE BOTTOM
      END-IF
      GET MA #ISN-LIST(#II1)
      PERFORM DATA-TO-PDA
      ES-NUMBER := #I2
      IF #II2 < #IR
        ADD 1 TO #II2
        NOARVX-NUM(#I2) := #II + 1
      ELSE
        NOARVX-NUM(#I2) := #II
      END-IF
    END-FOR
    IF ES-EXTEND-FUNCTION = 'VL1' OR = 'VL3' AND #I-ISN >= #MAX-N(2)
      ADD 1 TO #I-ISN
      #I2 := #MAX-N12 + 1
      ES-NUMBER := #I2
      GET MA #ISN-LIST(#I-ISN)
      PERFORM DATA-TO-PDA
      NOARVX-NUM(#I2) := 1
    END-IF
  VALUE 'LS2'
    PERFORM LIST-ACTIVE-REPORTS-IN-FOLDER-VIRT
    PERFORM CALCULATE-INTERVAL
    FOR #I2 = 1 TO #MAX-N12
      #II1 := (#I2 - 1) * #II + 1 + #II2
      IF #II1 > #I-ISN
        ESCAPE BOTTOM
      END-IF
      GET MA #ISN-LIST(#II1)
      PERFORM DATA-TO-PDA
      ES-NUMBER := #I2
      IF #II2 < #IR
        ADD 1 TO #II2
        NOARV2-NUM(#I2) := #II + 1
      ELSE
        NOARV2-NUM(#I2) := #II
      END-IF
    END-FOR
    IF ES-EXTEND-FUNCTION = 'VL1' OR = 'VL3' AND #I-ISN > #MAX-N(2)
      ADD 1 TO #I-ISN
      #I2 := #MAX-N12 + 1
      ES-NUMBER := #I2
      GET MA #ISN-LIST(#I-ISN)
      PERFORM DATA-TO-PDA
      NOARV2-NUM(#I2) := 1
    END-IF
  NONE VALUE IGNORE
END-DECIDE
ES-EXTEND-FUNCTION := 'VL'
IF NOT(ES-LINE-NUMBER >= 9990000000 OR ES-LINE-NUMBER = 9999999)
  ES-LINE-NUMBER := #I-ISN
END-IF
REDUCE ARRAY #ISN-LIST TO 0
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE CALCULATE-INTERVAL
************************************************************************
IF ES-EXTEND-FUNCTION = 'VL1' OR = 'VL3' AND #I-ISN > #MAX-N(2)
  SUBTRACT 1 FROM #I-ISN
END-IF
IF #I-ISN > #MAX-N(2)
  #MAX-N12 := #MAX-N(1)
  DIVIDE #MAX-N(1) INTO #I-ISN GIVING #II REMAINDER #IR
ELSE
  #MAX-N12 := #I-ISN
  #II := 0
  #IR := #I-ISN
END-IF
RESET #II2
*
END-SUBROUTINE /* CALCULATE-INTERVAL
*
************************************************************************
DEFINE SUBROUTINE LIST-ACTIVE-REPORTS-IN-FOLDER-VIRT /* LS2 & VL*
************************************************************************
IF ES-NEXT-KEY-PARM(1) NE ' '
  /* Get folder grants again (next buffer)                 /* CF4 ->
  /* (old coding removed - see former version if required)
  #FO-USER := ES-USER
  #FO-NAME := ES-KEY-PARM(1)
  PERFORM GET-BASE-FOLDER
  PERFORM GET-FOLDER-GRANTS                                /* CF4 <-
  /*
  #MA-FOLDER-USER-ID := ES-NEXT-KEY-PARM(2)
  #NEXT-FO-ID := ES-NEXT-KEY-PARM(3)
  #MA-FOLDER-ID := #NEXT-FO-ID-N
  SEPARATE ES-NEXT-KEY-PARM(1) LEFT INTO #MA-REP #MA-RNB-A11 IGNORE
    WITH DELIMITERS ';'
  MOVE RIGHT #MA-RNB-A11 TO #MA-RNB-A11
  IF #MA-RNB-A11 IS (N11)
    #MA-RNBR := #MA-RNB-N11
  ELSE
    #MA-RNBR := 0
  END-IF
  #S-USER := #MA-FOLDER-USER-ID
  #S-FO-ID := #MA-FOLDER-ID
  FIND FO WITH FO-USER-FO-ID = #S-USER-FO-ID
  END-FIND
  IF #NOARSL.#POSTFIX NE 'Y'
    #NAME-F := #NOARSL.#REPNAME
    COMPRESS #NAME-F H'FF' TO #NAME-T LEAVING NO
  ELSE
    #NAME-F := H'00'
    #NAME-T := H'FF'
  END-IF
ELSE
  IF ES-EXPAND NE 'E'
    ES-STARTINDEX := 2
    #I2 := ES-NUMBER := 1
    RESET INITIAL #J
    RESET NOARL2-HEADER(1) #I
    PERFORM GET-TEXT
    COMPRESS LONG-MSG(#J) TO NOARL2-HEADER(1) LEAVING NO
    SUBTRACT 1 FROM #J
    FOR #I = #J TO 1 STEP -1
      COMPRESS  LONG-MSG(#I) C-HEADER-DELIMITER NOARL2-HEADER(1)
        TO NOARL2-HEADER(1) LEAVING NO
    END-FOR
  END-IF
  /* Get base folder and folder grants                     /* CF4 ->
  /* (old coding removed - see former version if required)
  #FO-USER := ES-USER
  #FO-NAME := ES-KEY-PARM(1)
  PERFORM GET-BASE-FOLDER
  PERFORM GET-FOLDER-GRANTS                                /* CF4 <-
  /*
  IF #NOARSL.#POSTFIX NE 'Y'
    #NAME-F := #NOARSL.#REPNAME
    COMPRESS #NAME-F H'FF' TO #NAME-T LEAVING NO
  ELSE
    #NAME-F := H'00'
    #NAME-T := H'FF'
  END-IF
  FIND FO WITH FO-USER-NAME = #FO-USERNAME
    #MA-FOLDER-USER-ID := FO-USER-ID
    #MA-FOLDER-ID  := FO-ID
    #MA-REP := #NAME-F
    #MA-RNBR := 0
  END-FIND
END-IF
RESET #I-ISN
/*
/* ToDo: Check if loop over several folder-ids is necessary/meaningful
/*       (active report lists are always seen from a base folders view
/*        and a folder-link never contains active reports)
/*
REPEAT WHILE FO.FO-USER-ID NE ' ' AND NOT #END-VL
  IF (#LOC = 'A' OR = 'B') OR #NOARSL.#ARCHIVE ='*'
  OR (#NOARSL.#LOCATION ='A' OR='D' OR='S') /*SU7 OR='C')             /*
    IF #LOC = 'A' OR = 'B'
      #MA-CURRENT-LOC-R := #LOC
    ELSE
      IF #NOARSL.#ARCHIVE = '*'
        #MA-CURRENT-LOC-R := 'A'
      ELSE
        IF #NOARSL.#LOCATION = 'A'
          #MA-CURRENT-LOC-R := 'A'
        ELSE
          #MA-CURRENT-LOC-R := 'B'
        END-IF
      END-IF
    END-IF
    IF #NOARSL.#ARCHIVE = '*' AND #NOARSL.#REVIVE = '*'   /* CF1 ->
      #MA-CURRENT-LOC-R := 'B'
    END-IF                                                /* CF1 <-
    #MA-USERID-R := #MA-FOLDER-USER-ID
    #MA-FO-ID-R := #MA-FOLDER-ID
    #MA-REP-R := #MA-REP
    #MA-RNB-R := #MA-RNBR
    RIRL. READ MA BY MA-LOC-USER-FOLDER-REP-RNB = #MA-L-FOLDER-REP
      IF MA.MA-CURRENT-LOCATION NE #MA-CURRENT-LOC-R
        ESCAPE BOTTOM
      END-IF
      PERFORM CHECK-RECORD
      IF #ESC = 'B'
        ESCAPE BOTTOM
      END-IF
      IF #ESC = 'T'
        ESCAPE TOP
      END-IF
      #ISN-LIST(#I-ISN) := *ISN(RIRL.)
    END-READ
  ELSE
    RIR. READ MA BY MA-FOLDER-REP-RNB = #MA-FOLDER-REP
      PERFORM CHECK-RECORD
      IF #ESC = 'B'
        ESCAPE BOTTOM
      END-IF
      IF #ESC = 'T'
        ESCAPE TOP
      END-IF
      #ISN-LIST(#I-ISN) := *ISN(RIR.)
    END-READ
  END-IF
  PERFORM READ-NEXT-FOLDER
END-REPEAT
*
END-SUBROUTINE /* LIST-ACTIVE-REPORTS-IN-FOLDER-VIRT
*
************************************************************************
DEFINE SUBROUTINE CHECK-RECORD
************************************************************************
#ESC := 'B' /*bottom
IF MA.MA-USERID NE #MA-FOLDER-USER-ID
    OR MA.MA-FO-ID NE #MA-FOLDER-ID OR MA-REPNAME > #NAME-T
    OR ES-EXTEND-FUNCTION = 'VL2'
    AND (MA-REPNAME > #R-NAME-E OR MA-REPRNB = #R-RNB-EN)
  ESCAPE ROUTINE
END-IF
IF *TIMX GE #TIMEOUT
  ES-LINE-NUMBER := 9999999999
  ESCAPE ROUTINE
END-IF
IF *TIMX >= #TIMELIMIT
  ES-LINE-NUMBER := 9990000000
  ESCAPE ROUTINE
END-IF
PERFORM READ-FOLDERS
IF NOT #NEXT
  PERFORM READ-ACTIVE-REPORTS
END-IF
IF #NEXT
  #ESC := 'T' /*top
  ESCAPE ROUTINE
END-IF
IF #MAX-N(3) > 0 AND #I-ISN = #MAX-N(3)
  ES-LINE-NUMBER := 9999999
  ESCAPE ROUTINE
END-IF
*
#TIME-P13 :=  MA-PROCESS-TIME
IF NOT (#TIME = #F-DATE-C THRU #T-DATE-C)
  #ESC := 'T'                              /*top
  ESCAPE ROUTINE
END-IF
RESET #ESC /*record ok
ADD 1 TO #I-ISN
EXPAND ARRAY #ISN-LIST TO (1:#I-ISN)
*
END-SUBROUTINE /* CHECK-RECORD
*
************************************************************************
DEFINE SUBROUTINE LIST-ACTIVE-REPORTS-IN-FOLDER-REPORT-VIRT /* LS1 & VL*
************************************************************************
IF ES-NEXT-KEY-PARM(1) NE ' '
  /* Get base folder and folder grants                     /* CF4 ->
  /* (old coding removed - see former version if required)
  #FO-USER := ES-USER
  #FO-NAME := ES-KEY-PARM(1)
  PERFORM GET-BASE-FOLDER
  PERFORM GET-FOLDER-GRANTS                                /* CF4 <-
  /*
  #MA-FOLDER-USER-ID := ES-NEXT-KEY-PARM(2)
  #NEXT-FO-ID := ES-NEXT-KEY-PARM(3)
  #MA-FOLDER-ID := #NEXT-FO-ID-N
  #MA-REP := ES-KEY-PARM(3)
  #MA-RNB-A11 := ES-NEXT-KEY-PARM(1)
  MOVE RIGHT #MA-RNB-A11 TO #MA-RNB-A11
  IF #MA-RNB-A11 IS (N11)
    #MA-RNBR := #MA-RNB-N11
  ELSE
    #MA-RNBR := 0
  END-IF
  #S-USER := #MA-FOLDER-USER-ID
  #S-FO-ID := #MA-FOLDER-ID
  FIND FO WITH FO-USER-FO-ID = #S-USER-FO-ID
  END-FIND
  #NAME-F := ES-KEY-PARM(3)
  COMPRESS #NAME-F H'FF' TO #NAME-T LEAVING NO
ELSE
  IF ES-EXPAND NE 'E'
    ES-STARTINDEX := 2
    #I2 := ES-NUMBER := 1
    RESET INITIAL #J
    RESET NOARL2-HEADER(1) #I
    PERFORM GET-TEXT
    COMPRESS LONG-MSG(#J) TO NOARL2-HEADER(1) LEAVING NO
    SUBTRACT 1 FROM #J
    FOR #I = #J TO 1 STEP -1
      COMPRESS  LONG-MSG(#I) C-HEADER-DELIMITER NOARL2-HEADER(1)
        TO NOARL2-HEADER(1) LEAVING NO
    END-FOR
  END-IF
  /* Get base folder and folder grants                     /* CF4 ->
  /* (old coding removed - see former version if required)
  #FO-USER := ES-USER
  #FO-NAME := ES-KEY-PARM(1)
  PERFORM GET-BASE-FOLDER
  PERFORM GET-FOLDER-GRANTS                                /* CF4 ->
  /*
  RESET #FO-ID-N
  #NAME-F := ES-KEY-PARM(3)
  COMPRESS #NAME-F H'FF' TO #NAME-T LEAVING NO
  FIND FO WITH FO-USER-NAME = #FO-USERNAME
    #MA-FOLDER-USER-ID := FO-USER-ID
    #MA-FOLDER-ID  := FO-ID
    #MA-REP := #NAME-F
    #MA-RNBR := 0
  END-FIND
END-IF
RESET #I-ISN
/*
/*
/* ToDo: Check if loop over several folder-ids is necessary/meaningful
/*       (active report lists are always seen from a base folders view
/*        and a folder-link never contains active reports)
/*
/*
REPEAT WHILE FO.FO-USER-ID NE ' ' AND NOT #END-VL
  RIRR. READ MA BY MA-FOLDER-REP-RNB = #MA-FOLDER-REP
    IF MA.MA-USERID NE #MA-FOLDER-USER-ID OR
        MA.MA-FO-ID NE #MA-FOLDER-ID OR
        MA-REPNAME > #R-NAME-E OR
        MA-REPNAME > #NAME-T OR
        ES-EXTEND-FUNCTION = 'VL2' AND
        MA-REPRNB = #R-RNB-EN
      ESCAPE BOTTOM
    END-IF
    IF *TIMX >= #TIMEOUT
      ES-LINE-NUMBER := 9999999999
      ESCAPE BOTTOM
    END-IF
    IF *TIMX >= #TIMELIMIT
      ES-LINE-NUMBER := 9990000000
      ESCAPE BOTTOM
    END-IF
    PERFORM READ-FOLDERS
    IF NOT #NEXT
      PERFORM READ-ACTIVE-REPORTS
    END-IF
    REJECT IF #NEXT
    IF #MAX-N(3) > 0 AND #I-ISN = #MAX-N(3)
      ES-LINE-NUMBER := 9999999
      ESCAPE BOTTOM
    END-IF
    ADD 1 TO #I-ISN
    EXPAND ARRAY #ISN-LIST TO (1:#I-ISN)
    #ISN-LIST(#I-ISN) := *ISN(RIRR.)
  END-READ
  PERFORM READ-NEXT-FOLDER
END-REPEAT
*
END-SUBROUTINE /* LIST-ACTIVE-REPORTS-IN-FOLDER-REPORT-VIRT
*
************************************************************************
DEFINE SUBROUTINE LIST-ACTIVE-REPORTS-IN-FOLDER-SUMMARY-VIRT /* LS & VL*
************************************************************************
IF ES-NEXT-KEY-PARM(1) NE ' '
  #MA-FOLDER-USER-ID := ES-NEXT-KEY-PARM(2)
  #NEXT-FO-ID := ES-NEXT-KEY-PARM(3)
  #MA-FOLDER-ID := #NEXT-FO-ID-N
  #MA-REP := ES-NEXT-KEY-PARM(1)
  #MA-RNBR := 0
  #S-USER := #MA-FOLDER-USER-ID
  #S-FO-ID := #MA-FOLDER-ID
  FIND FO WITH FO-USER-FO-ID = #S-USER-FO-ID
*     PERFORM GET-FOLDER-GRANTS        /* no grants with 'LS'  /* CF4
  END-FIND
  IF #NOARSL.#POSTFIX NE 'Y'
    #NAME-F := #NOARSL.#REPNAME
    COMPRESS #NAME-F H'FF' TO #NAME-T LEAVING NO
  ELSE
    #NAME-F := H'00'
    #NAME-T := H'FF'
  END-IF
ELSE
  IF ES-EXPAND NE 'E'
    ES-STARTINDEX := 2
    #I2 := ES-NUMBER := 1
    RESET INITIAL #J
    RESET NOARL2-HEADER(1) #I
    PERFORM GET-TEXT
    COMPRESS LONG-MSG(#J) TO NOARL2-HEADER(1) LEAVING NO
    SUBTRACT 1 FROM #J
    FOR #I = #J TO 1 STEP -1
      COMPRESS  LONG-MSG(#I) C-HEADER-DELIMITER NOARL2-HEADER(1)
        TO NOARL2-HEADER(1) LEAVING NO
    END-FOR
  END-IF
  #FO-USER := ES-USER
  #FO-NAME := ES-KEY-PARM(1)
  IF #FO-NAME = '#Inbasket' OR = '#Listeneingang'
    #S-USER := #FO-USER
    #S-FO-ID := 1
    FIND FO WITH FO-USER-FO-ID = #S-USER-FO-ID
      #FO-NAME := FO.FO-NAME
    END-FIND
  END-IF
  RESET #FO-ID-N
  IF #NOARSL.#POSTFIX NE 'Y'
    #NAME-F := #NOARSL.#REPNAME
    COMPRESS #NAME-F H'FF' TO #NAME-T LEAVING NO
  ELSE
    #NAME-F := H'00'
    #NAME-T := H'FF'
  END-IF
  FIND FO WITH FO-USER-NAME = #FO-USERNAME
    #MA-FOLDER-USER-ID := FO-USER-ID
    #MA-FOLDER-ID  := FO-ID
    #MA-REP := #NAME-F
    #MA-RNBR := 0
*     PERFORM GET-FOLDER-GRANTS        /* no grants with 'LS'  /* CF4
  END-FIND
END-IF
RESET #I-ISN
REPEAT WHILE FO.FO-USER-ID NE ' ' AND NOT #END-VL
  RESET #MA-REP-S
  #MA-FOLDER-USER-ID-E := #MA-FOLDER-USER-ID
  #MA-FOLDER-ID-E := #MA-FOLDER-ID
  #MA-REP-E := #NAME-T
  #MA-RNB-E := 99999999999
  HV. HISTOGRAM HM FOR MA-FOLDER-REP-RNB
      STARTING FROM #MA-FOLDER-REP
      ENDING AT     #MA-FOLDER-REP-E
    IF ES-EXTEND-FUNCTION = 'VL2' AND
        HV.MA-REP >= #R-NAME-E
      ESCAPE BOTTOM
    END-IF
    IF *TIMX >= #TIMEOUT
      ES-LINE-NUMBER := 9999999999
      ESCAPE BOTTOM
    END-IF
    IF *TIMX >= #TIMELIMIT
      ES-LINE-NUMBER := 9990000000
      ESCAPE BOTTOM
    END-IF
    #NEXT := TRUE
    IF (#NOARSL.#REPNAME = ' '  OR #NOARSL.#POSTFIX NE 'Y'
       OR  HV.MA-REP = SCAN #NOARSL.#REPNAME) AND HV.MA-REP NE #MA-REP-S
      #NEXT := FALSE
    END-IF
    IF NOT #NEXT
      PERFORM READ-FOLDERS
    END-IF
    REJECT IF #NEXT
    #MA-RNB := HV.MA-RNB
    #MA-USER := HV.MA-FOLDER-USER-ID
    IF #MAX-N(3) > 0 AND #I-ISN = #MAX-N(3)
      ES-LINE-NUMBER := 9999999
      ESCAPE BOTTOM
    END-IF
    FM. FIND MA WITH MA-RNB-USER = #MA-RNB-USER
      #MA-REP-S := HV.MA-REP
      ADD 1 TO #I-ISN
      EXPAND ARRAY #ISN-LIST TO (1:#I-ISN)
      #ISN-LIST(#I-ISN) := *ISN(FM.)
      ESCAPE BOTTOM
    END-FIND
  END-HISTOGRAM
  PERFORM READ-NEXT-FOLDER
END-REPEAT
*
END-SUBROUTINE /* LIST-ACTIVE-REPORTS-IN-FOLDER-SUMMARY-VIRT
*
************************************************************************
DEFINE SUBROUTINE READ-FOLDERS
************************************************************************
RESET #NEXT
#MA-RNB := MA-REPRNB
FO-L.FO-LINKED-FO-ID := FO.FO-LINKED-FO-ID
REPFOL2V. REPEAT WHILE FO-L.FO-LINKED-USER-ID NE ' '
  #MA-USER := FO-L.FO-LINKED-USER-ID
  FIND MA-N WITH MA-RNB-USER = #MA-RNB-USER
      WHERE MA-N.MA-FO-ID = FO-L.FO-LINKED-ID
    #NEXT := TRUE
    ESCAPE BOTTOM (REPFOL2V.)
  END-FIND
  #S-USER := FO-L.FO-LINKED-USER-ID
  #S-FO-ID := FO-L.FO-LINKED-ID
  FIND FO-L WITH FO-USER-FO-ID = #S-USER-FO-ID
    IF NO RECORDS FOUND
      ESCAPE BOTTOM (REPFOL2V.)
    END-NOREC
  END-FIND
END-REPEAT
*
END-SUBROUTINE /* READ-FOLDERS
*
************************************************************************
DEFINE SUBROUTINE READ-ACTIVE-REPORTS
************************************************************************
#REPORT-RNB.#REPNAME := MA-REPNAME
#REPRNB  := MA-REPRNB
FIND ACTIVE-REPORTS WITH AR-REPORT-RNB = #REPORT-RNB
  IF NO RECORDS FOUND
    #NEXT := TRUE
    ESCAPE BOTTOM
  END-NOREC
  RESET #OWNER-REPORT
  IF AR-USERID = ES-USER
    #OWNER-REPORT := TRUE
  END-IF
  PERFORM SELECT-RECORD
  IF NOT #SELECTED
    #NEXT := TRUE
  END-IF
END-FIND
*
END-SUBROUTINE /* READ-ACTIVE-REPORTS
*
************************************************************************
DEFINE SUBROUTINE READ-NEXT-FOLDER
************************************************************************
#END-VL := FALSE
FO.FO-USER-ID := ' '
IF FO.FO-LINKED-FO-ID NE ' '
  #S-USER := FO.FO-LINKED-USER-ID
  #S-FO-ID := FO.FO-LINKED-ID
  FIND FO WITH FO-USER-FO-ID = #S-USER-FO-ID
    #MA-FOLDER-USER-ID := FO-USER-ID
    #MA-FOLDER-ID  := FO-ID
    #MA-REP := #NAME-F
    #MA-RNBR := 0
  END-FIND
END-IF
IF ES-EXTEND-FUNCTION = 'VL2' AND FO.FO-USER-ID NE ' ' AND
    (FO.FO-USER-ID > #R-USER-E OR FO.FO-ID > #R-FO-ID-EN) OR
    FO.FO-USER-ID = ' '
  /*ES-EXTEND-FUNCTION := 'VL'
  #END-VL := TRUE
END-IF
*
END-SUBROUTINE /* READ-NEXT-FOLDER
*
************************************************************************
DEFINE SUBROUTINE READ-PROFILE
************************************************************************
IF ES-USER-TYPE NE 'A'
  FIND USERS WITH USER-ID = ES-USER
    PROFILE-STRING := USER-PROFILE
  END-FIND
END-IF
*
END-SUBROUTINE /* READ-PROFILE
*
************************************************************************
DEFINE SUBROUTINE INIT-DAT-KEY
************************************************************************
IF #CREAT-DATE-FROM = ' '
  MOVE EDITED '19010101000000'         TO #F-DATE-C(EM=YYYYMMDDHHIISS)
ELSE
  IF #CREAT-TIME-FROM = ' '
    COMPRESS #CREAT-DATE-FROM '000000' TO #DATE-14 LEAVING NO
  ELSE
    COMPRESS #CREAT-DATE-FROM SUBSTR(#CREAT-TIME-FROM,1,4) '00'
      TO #DATE-14 LEAVING NO
  END-IF
  MOVE EDITED #DATE-14                 TO #F-DATE-C(EM=YYYYMMDDHHIISS)
END-IF
IF #CREAT-DATE-TO = ' '
  MOVE EDITED '20991231235959'         TO #T-DATE-C(EM=YYYYMMDDHHIISS)
ELSE
  IF #CREAT-TIME-TO = ' '
    COMPRESS #CREAT-DATE-TO '235959'   TO #DATE-14 LEAVING NO
  ELSE
    COMPRESS #CREAT-DATE-TO SUBSTR(#CREAT-TIME-TO,1,4) '59'
      TO #DATE-14 LEAVING NO
  END-IF
  MOVE EDITED #DATE-14                 TO #T-DATE-C(EM=YYYYMMDDHHIISS)
END-IF
* Deleted former Mail-date / create-date see above  BLI 2013-11-08
*
END-SUBROUTINE /* INIT-DAT-KEY
*
************************************************************************
DEFINE SUBROUTINE SELECT-RECORD
************************************************************************
#SELECTED := TRUE
PERFORM SELECT-LOCATION
IF NOT #SELECTED
  ESCAPE ROUTINE
END-IF
IF ES-USER-TYPE NE 'A' AND ES-FUNCTION = 'LSA'
  #MA-USER:= ES-USER
  #MA-REPORT:= ACTIVE-REPORTS.AR-REPNAME
  #MA-REPRNB:= ACTIVE-REPORTS.AR-REPRNB
  #MA-RNB := ACTIVE-REPORTS.AR-REPRNB
  FNDMA. FIND NUMBER MA WITH MA-RNB-USER = #MA-RNB-USER
    AND  MA-REP-RNB  = #MA-REP-RNB
  IF *NUMBER(FNDMA.) = 0
    RESET #SELECTED
    ESCAPE ROUTINE    /* Useless to do further checks...  CF2
  END-IF
END-IF
IF #NOARSL NE ' '
  /* PRINT *PROGRAM *LINE 'HEB-KY' '=' #NOARSL
  DECIDE FOR EVERY CONDITION
    WHEN #NOARSL.#SOURCE NE ' ' AND
        NOT (ACTIVE-REPORTS.AR-SOURCE = #SOURCE-F THRU #SOURCE-T)
      #SELECTED := FALSE
      ESCAPE ROUTINE
    WHEN #NOARSL.#SENDER NE ' ' AND
        NOT (ACTIVE-REPORTS.AR-SENDER = #SENDER-F THRU #SENDER-T)
      #SELECTED := FALSE
      ESCAPE ROUTINE
*   WHEN #NOARSL.#KEYWORD NE ' '                            HEB2 > --
*     EXAMINE #NOARSL.#KEYWORD FOR H'00' GIVING LENGTH #L
*     FOR #K = 1 TO 6
*       IF SUBSTR(ACTIVE-REPORTS.AR-KEYWORDS(#K),1,#L) =#NOARSL.#KEYWORD
*         ESCAPE BOTTOM
*       END-IF
*     END-FOR
*     IF #K > 6
*       #SELECTED := FALSE
*       ESCAPE ROUTINE
*     END-IF                                                HEB2 <
    WHEN #KY-SEL (*) NE ' '                              /* HEB2 > ++
      IF #KEYWORD-AND-OR NE 'A' /* OR
        FOR #K = 1 TO 6
         IF AR-KEYWORDS(#K) NE ' '
         AND (    SUBSTR(AR-KEYWORDS(#K),1,#L1) = #KY-SEL (1)
               OR SUBSTR(AR-KEYWORDS(#K),1,#L2) = #KY-SEL (2)
               OR SUBSTR(AR-KEYWORDS(#K),1,#L3) = #KY-SEL (3)
               OR SUBSTR(AR-KEYWORDS(#K),1,#L4) = #KY-SEL (4) )
           ESCAPE BOTTOM
         END-IF
        END-FOR
        IF #K > 6
          #SELECTED := FALSE
          ESCAPE ROUTINE
        END-IF
      ELSE                      /* AND
        IF  ( #KY-SEL (1) = ' '
            OR SUBSTR(AR-KEYWORDS(*),1,#L1) = #KY-SEL (1) )
        AND ( #KY-SEL (2) = ' '
            OR SUBSTR(AR-KEYWORDS(*),1,#L2) = #KY-SEL (2) )
        AND ( #KY-SEL (3) = ' '
            OR SUBSTR(AR-KEYWORDS(*),1,#L3) = #KY-SEL (3) )
        AND ( #KY-SEL (4) = ' '
            OR SUBSTR(AR-KEYWORDS(*),1,#L4) = #KY-SEL (4) )
           IGNORE
        ELSE
          #SELECTED := FALSE
          ESCAPE ROUTINE
        END-IF
      END-IF                                             /* HEB2 <
    WHEN (ES-FUNCTION = 'LSA' OR = 'LS1' OR = 'LS2') AND
        NOT (ACTIVE-REPORTS.AR-PROCESS-TIME = #F-DATE-C THRU #T-DATE-C)
      #SELECTED := FALSE
      ESCAPE ROUTINE
    WHEN ES-FUNCTION = 'LS2' AND #NOARSL.#POSTFIX NE 'Y'
      IF #NOARSL.#REPNAME NE ' '
        EXAMINE #NOARSL.#REPNAME FOR H'00' GIVING LENGTH #L
        IF SUBSTR(ACTIVE-REPORTS.AR-REPNAME,1,#L) NE #NOARSL.#REPNAME
          #SELECTED := FALSE
          ESCAPE ROUTINE
        END-IF
      END-IF
    WHEN ES-FUNCTION = 'LS2' AND #NOARSL.#POSTFIX = 'Y'
      IF #NOARSL.#REPNAME NE ' '
        IF ACTIVE-REPORTS.AR-REPNAME NE SCAN #NOARSL.#REPNAME
          #SELECTED := FALSE
          ESCAPE ROUTINE
        END-IF
      END-IF
    WHEN #NOARSL.#EXPIR-DATE NE ' ' AND
        ACTIVE-REPORTS.AR-EXPIRATION NE #NOARSL.#EXPIR-DATE
      #SELECTED := FALSE
      ESCAPE ROUTINE
    WHEN #NOARSL.#ARCHIVE NE ' ' AND
        #NOARSL.#ARCHIVE NE ACTIVE-REPORTS.AR-ARCHIVE
      #SELECTED := FALSE
      ESCAPE ROUTINE
    WHEN #NOARSL.#REVIVE NE ' ' AND
        #NOARSL.#REVIVE NE ACTIVE-REPORTS.AR-REVIVE
      #SELECTED := FALSE
      ESCAPE ROUTINE
    WHEN #NOARSL.#LOCATION NE ' ' AND
        #NOARSL.#LOCATION NE ACTIVE-REPORTS.AR-CURRENT-LOCATION
      #SELECTED := FALSE
      ESCAPE ROUTINE
    WHEN NONE IGNORE
  END-DECIDE
END-IF
*
END-SUBROUTINE /* SELECT-RECORD
*
************************************************************************
DEFINE SUBROUTINE SELECT-LOCATION
************************************************************************
IF #LOC NE '*' AND
    (#LOC NE 'B' AND ACTIVE-REPORTS.AR-CURRENT-LOCATION NE #LOC OR
    #LOC = 'B' AND
    NOT(ACTIVE-REPORTS.AR-CURRENT-LOCATION ='S' OR='D')) /*SU7 OR='C'))
  #SELECTED := FALSE
END-IF
*
END-SUBROUTINE /* SELECT-LOCATION
*
************************************************************************
DEFINE SUBROUTINE DATA-TO-PDA
************************************************************************
RESET #SPOOL-ATTRIBUTES #BIN-REPRNB  #BIN-REPNAME
IF ACTIVE-REPORTS.AR-CC-TYPE = 0005 AND ES-FUNCTION NE 'LS'
  #SPOOL-ATTRIBUTES := ACTIVE-REPORTS.AR-SPOOL-ATTRIBUTES
  #BIN-REPNAME      := ACTIVE-REPORTS.AR-REPNAME
  #BIN-REPRNB       := ACTIVE-REPORTS.AR-REPRNB
  PERFORM GET-BINARY-SIZE
END-IF
IF ES-FUNCTION NE 'LS'
  PERFORM OPTIONS
END-IF
IF ES-EXPAND = 'E'
  DECIDE ON FIRST VALUE OF ES-FUNCTION
    VALUE 'LSA'
      NOAREX-REPRNB(#I2)    := ACTIVE-REPORTS.AR-REPRNB
      NOAREX-OPTIONS(#I2,*) := #OPTIONS(*)
    VALUE 'LS1'
      IF NOT(ES-EXTEND-FUNCTION = SCAN'VL')
        NOAREX-REPRNB(#I2)    := ACTIVE-REPORTS.AR-REPRNB
        NOAREX-OPTIONS(#I2,*) := #OPTIONS(*)
      ELSE
        NOARVX-REPRNB(#I2) := MA-REPRNB
        NOARVX-OPTIONS(#I2,*) := #OPTIONS(*)
        NOARVX-USER(#I2) := MA.MA-USERID
        NOARVX-FO-ID(#I2) := MA.MA-FO-ID
        NOARVX-NUM(#I2) := 1
      END-IF
    VALUE 'LS'
      IF NOT(ES-EXTEND-FUNCTION = SCAN'VL')
        NOARE1-REPNAME(#I2) := MA-REP
      ELSE
        NOARV1-REPNAME(#I2) := MA-REPNAME
        NOARV1-USER(#I2) := MA.MA-USERID
        NOARV1-FO-ID(#I2) := MA.MA-FO-ID
        NOARV1-NUM(#I2) := 1
      END-IF
    VALUE 'LS2'
      IF NOT(ES-EXTEND-FUNCTION = SCAN'VL')
        COMPRESS MA-REPNAME C-PARM-DELIMITER MA-REPRNB  /* ':' #ISN-N10
          TO NOARE2-REPNAME-RNB(#I2) LEAVING NO
        NOARE2-OPTIONS(#I2,*) := #OPTIONS(*)
      ELSE
        COMPRESS MA-REPNAME C-PARM-DELIMITER MA-REPRNB  /* ':' #ISN-N10
          TO NOARV2-REPNAME-RNB(#I2) LEAVING NO
        NOARV2-OPTIONS(#I2,*) := #OPTIONS(*)
        NOARV2-USER(#I2) := MA.MA-USERID
        NOARV2-FO-ID(#I2) := MA.MA-FO-ID
        NOARV2-NUM(#I2) := 1
      END-IF
    NONE VALUE IGNORE
  END-DECIDE
ELSE
  DECIDE ON FIRST VALUE OF ES-FUNCTION
    VALUE 'LSA'
      NOARLA-REPRNB(#I2) := ACTIVE-REPORTS.AR-REPRNB
      MOVE RIGHT JUSTIFIED NOARLA-REPRNB(#I2) TO NOARLA-REPRNB(#I2)
      NOARLA-DESC(#I2)   := ACTIVE-REPORTS.AR-DESC
      IF ACTIVE-REPORTS.AR-SOURCE = ' ' AND
          ACTIVE-REPORTS.AR-SENDER = ' '
        RESET NOARLA-OWNER(#I2)
      ELSE
        COMPRESS ACTIVE-REPORTS.AR-SOURCE '/'
          ACTIVE-REPORTS.AR-SENDER TO NOARLA-OWNER(#I2) LEAVING NO
      END-IF
      IF ACTIVE-REPORTS.AR-PROCESS-TIME NE #TT
        MOVE EDITED ACTIVE-REPORTS.AR-PROCESS-TIME (EM=YYYYMMDDHHII)
          TO NOARLA-TIME (#I2)
      ELSE
        RESET NOARLA-TIME (#I2)
      END-IF
      IF ACTIVE-REPORTS.AR-CC-TYPE = 0005
        RESET NOARLA-NUMBER-OF-LINES(#I2)
        NOARLA-BYTES(#I2) := #BIN-SIZE
        MOVE RIGHT JUSTIFIED NOARLA-BYTES(#I2) TO NOARLA-BYTES(#I2)
      ELSE
        RESET NOARLA-BYTES(#I2)
        NOARLA-NUMBER-OF-LINES(#I2) :=
          ACTIVE-REPORTS.AR-NUMBER-OF-LINES
        MOVE RIGHT JUSTIFIED NOARLA-NUMBER-OF-LINES(#I2) TO
          NOARLA-NUMBER-OF-LINES(#I2)
      END-IF
      NOARLA-ARCHIVE(#I2) := ACTIVE-REPORTS.AR-ARCHIVE
      NOARLA-REVIVE(#I2)  := ACTIVE-REPORTS.AR-REVIVE
      NOARLA-CURRENT-LOCATION(#I2) :=
        ACTIVE-REPORTS.AR-CURRENT-LOCATION
      IF ACTIVE-REPORTS.AR-EXPIRATION NE ' '
        NOARLA-EXPIRATION (#I2) := ACTIVE-REPORTS.AR-EXPIRATION
      ELSE
        RESET  NOARLA-EXPIRATION (#I2)
      END-IF
      IF ACTIVE-REPORTS.AR-REVIVE-EXPIRATION NE ' '
        NOARLA-REVIVE-EXPIRATION (#I2) :=
          ACTIVE-REPORTS.AR-REVIVE-EXPIRATION
      ELSE
        RESET NOARLA-REVIVE-EXPIRATION (#I2)
      END-IF
      #REPORT-RNB.#REPNAME := ACTIVE-REPORTS.AR-REPNAME
      #REPRNB              := ACTIVE-REPORTS.AR-REPRNB
      RESET NOARLA-ARCHIVE-EXPIRATION(#I2)
      FIND DR WITH DR-REPORT-RNB = #REPORT-RNB
        IF DR-EXPIRATION-DATE NE ' '
          NOARLA-ARCHIVE-EXPIRATION (#I2) := DR-EXPIRATION-DATE
        ELSE
          RESET NOARLA-ARCHIVE-EXPIRATION (#I2)
        END-IF
      END-FIND
      NOARLA-OPTIONS(#I2,*) := #OPTIONS(*)
      #REPORT-RNB.#REPNAME := ACTIVE-REPORTS.AR-REPNAME
      #REPRNB              := ACTIVE-REPORTS.AR-REPRNB
    VALUE 'LS'
      NOARLS-REPNAME(#I2) := MA-REP
      NOARLS-REP-NUMBER(#I2) := #NUMBER
      MOVE RIGHT JUSTIFIED NOARLS-REP-NUMBER(#I2) TO
        NOARLS-REP-NUMBER(#I2)
    VALUE 'LS1'
      NOARL1-REPRNB(#I2) := ACTIVE-REPORTS.AR-REPRNB
      MOVE RIGHT JUSTIFIED NOARL1-REPRNB(#I2) TO NOARL1-REPRNB(#I2)
      IF ACTIVE-REPORTS.AR-SOURCE =' ' AND ACTIVE-REPORTS.AR-SENDER =' '
        RESET NOARL1-OWNER(#I2)
      ELSE
        COMPRESS ACTIVE-REPORTS.AR-SOURCE '/'
          ACTIVE-REPORTS.AR-SENDER TO NOARL1-OWNER(#I2) LEAVING NO
      END-IF
      IF ACTIVE-REPORTS.AR-PROCESS-TIME NE #TT
        MOVE EDITED ACTIVE-REPORTS.AR-PROCESS-TIME (EM=YYYYMMDDHHII) TO
          NOARL1-TIME (#I2)
      ELSE
        RESET NOARL1-TIME (#I2)
      END-IF
      #TIME-P13 := MA-PROCESS-TIME
      IF #TIME NE #TT
        MOVE EDITED #TIME (EM=YYYYMMDDHHII) TO NOARL1-MAIL(#I2)
      ELSE
        RESET NOARL1-MAIL(#I2)
      END-IF
      IF ACTIVE-REPORTS.AR-CC-TYPE = 0005
        RESET NOARL1-NUMBER-OF-LINES(#I2)
        NOARL1-BYTES(#I2) := #BIN-SIZE
        MOVE RIGHT JUSTIFIED NOARL1-BYTES(#I2) TO NOARL1-BYTES(#I2)
      ELSE
        RESET NOARL1-BYTES(#I2)
        NOARL1-NUMBER-OF-LINES(#I2) := ACTIVE-REPORTS.AR-NUMBER-OF-LINES
        MOVE RIGHT JUSTIFIED NOARL1-NUMBER-OF-LINES(#I2)
          TO NOARL1-NUMBER-OF-LINES(#I2)
      END-IF
      NOARL1-ARCHIVE(#I2) := ACTIVE-REPORTS.AR-ARCHIVE
      NOARL1-REVIVE(#I2)  := ACTIVE-REPORTS.AR-REVIVE
      NOARL1-CURRENT-LOCATION(#I2) := ACTIVE-REPORTS.AR-CURRENT-LOCATION
      IF ACTIVE-REPORTS.AR-EXPIRATION > ' '
        NOARL1-EXPIRATION(#I2) := ACTIVE-REPORTS.AR-EXPIRATION
      ELSE
        RESET  NOARL1-EXPIRATION(#I2)
      END-IF
      IF ACTIVE-REPORTS.AR-REVIVE-EXPIRATION > ' '
        NOARL1-REVIVE-EXPIRATION(#I2) :=
          ACTIVE-REPORTS.AR-REVIVE-EXPIRATION
      ELSE
        RESET  NOARL1-REVIVE-EXPIRATION(#I2)
      END-IF
      #REPORT-RNB.#REPNAME := ACTIVE-REPORTS.AR-REPNAME
      #REPRNB              := ACTIVE-REPORTS.AR-REPRNB
      RESET NOARL1-ARCHIVE-EXPIRATION(#I2)
      FIND DR WITH DR-REPORT-RNB = #REPORT-RNB
        IF DR-EXPIRATION-DATE > ' '
          NOARL1-ARCHIVE-EXPIRATION(#I2) := DR-EXPIRATION-DATE
        ELSE
          RESET NOARL1-ARCHIVE-EXPIRATION(#I2)
        END-IF
      END-FIND
      NOARL1-OPTIONS(#I2,*) := #OPTIONS(*)
      NOARL1-MESSAGE(#I2)   := MA-STATUS
    VALUE 'LS2'
      NOARL2-REPNAME(#I2) := ACTIVE-REPORTS.AR-REPNAME
      NOARL2-REPRNB(#I2)  := ACTIVE-REPORTS.AR-REPRNB
      MOVE RIGHT JUSTIFIED NOARL2-REPRNB(#I2) TO NOARL2-REPRNB(#I2)
      IF ACTIVE-REPORTS.AR-SOURCE =' ' AND ACTIVE-REPORTS.AR-SENDER =' '
        RESET NOARL2-OWNER(#I2)
      ELSE
        COMPRESS ACTIVE-REPORTS.AR-SOURCE '/'
          ACTIVE-REPORTS.AR-SENDER TO NOARL2-OWNER(#I2) LEAVING NO
      END-IF
      IF ACTIVE-REPORTS.AR-PROCESS-TIME NE #TT
        MOVE EDITED ACTIVE-REPORTS.AR-PROCESS-TIME (EM=YYYYMMDDHHII)
          TO NOARL2-TIME (#I2)
      ELSE
        RESET NOARL2-TIME (#I2)
      END-IF
      #TIME-P13 := MA-PROCESS-TIME
      IF #TIME NE #TT
        MOVE EDITED #TIME (EM=YYYYMMDDHHII) TO NOARL2-MAIL (#I2)
      ELSE
        RESET NOARL2-MAIL (#I2)
      END-IF
      IF ACTIVE-REPORTS.AR-CC-TYPE = 0005
        RESET NOARL2-NUMBER-OF-LINES(#I2)
        NOARL2-BYTES(#I2) := #BIN-SIZE
        MOVE RIGHT JUSTIFIED NOARL2-BYTES(#I2) TO NOARL2-BYTES(#I2)
      ELSE
        RESET NOARL2-BYTES(#I2)
        NOARL2-NUMBER-OF-LINES(#I2) := ACTIVE-REPORTS.AR-NUMBER-OF-LINES
        MOVE RIGHT JUSTIFIED NOARL2-NUMBER-OF-LINES(#I2) TO
          NOARL2-NUMBER-OF-LINES(#I2)
      END-IF
      NOARL2-ARCHIVE(#I2) := ACTIVE-REPORTS.AR-ARCHIVE
      NOARL2-REVIVE(#I2)  := ACTIVE-REPORTS.AR-REVIVE
      NOARL2-CURRENT-LOCATION(#I2) := ACTIVE-REPORTS.AR-CURRENT-LOCATION
      IF ACTIVE-REPORTS.AR-EXPIRATION NE ' '
        NOARL2-EXPIRATION (#I2) := ACTIVE-REPORTS.AR-EXPIRATION
      ELSE
        RESET  NOARL2-EXPIRATION (#I2)
      END-IF
      IF ACTIVE-REPORTS.AR-REVIVE-EXPIRATION NE ' '
        NOARL2-REVIVE-EXPIRATION (#I2) :=
          ACTIVE-REPORTS.AR-REVIVE-EXPIRATION
      ELSE
        RESET NOARL2-REVIVE-EXPIRATION (#I2)
      END-IF
      #REPORT-RNB.#REPNAME := ACTIVE-REPORTS.AR-REPNAME
      #REPRNB              := ACTIVE-REPORTS.AR-REPRNB
      RESET NOARL2-ARCHIVE-EXPIRATION(#I2)
      FIND DR WITH DR-REPORT-RNB = #REPORT-RNB
        IF DR-EXPIRATION-DATE NE ' '
          NOARL2-ARCHIVE-EXPIRATION (#I2) := DR-EXPIRATION-DATE
        ELSE
          RESET NOARL2-ARCHIVE-EXPIRATION (#I2)
        END-IF
      END-FIND
      NOARL2-OPTIONS(#I2,*) := #OPTIONS(*)
      NOARL2-MESSAGE(#I2)   := MA-STATUS
    NONE VALUE IGNORE
  END-DECIDE
END-IF
*
END-SUBROUTINE /* DATA-TO-PDA
*
************************************************************************
DEFINE SUBROUTINE GET-BINARY-SIZE
************************************************************************
RESET #BIN-SIZE #RECNUM #ERC #ERT
IF NOT (#SPOOL-DI-SIZE = #I4 OR = 0)
* #BIN-SIZE := #SPOOL-DI-SIZE / 1024 + 1
* fhi     2015-05-18 NOMALL-1552 line above out, below in
/*SU5 #BIN-SIZE := (#SPOOL-DI-SIZE / 1024 + 1) * 3 / 4
  #BIN-SIZE := (#SPOOL-DI-SIZE / 1024) * 3 / 4 + 1 /*SU5
ELSE
  CALLNAT 'RBINSZ-N' #BIN-REPNAME #BIN-REPRNB 'R' #RECNUM #BIN-SIZE
    #ERC #ERT
  IF #ERC = 0 AND #BIN-SIZE NE 0
    #BIN-SIZE := #BIN-SIZE / 1024 + 1
  END-IF
END-IF
*
END-SUBROUTINE /* GET-BINARY-SIZE
*
************************************************************************
DEFINE SUBROUTINE OPTIONS                        /* - reworked - CF4 ->
************************************************************************
RESET #OPTIONS(*) #NEW-OPTIONS(*) #I
      P-NATRP-ERC P-NATRP-ERT                           /* HEB1
/*
/* Set functional restrictions for logical and physical reasons
CALLNAT 'NOSRCK-N' ACTIVE-REPORTS.AR-REPNAME ACTIVE-REPORTS.AR-REPRNB
  #SOURCE-EXIST
  P-NATRP-ERC P-NATRP-ERT ES-USER (AD=O)                /* HEB1
  ES-APP-SERVER-LIBRARY (AD=O)                          /* HEB1
IF P-NATRP-ERC NE 0                                     /* HEB1 >
  ES-RC := 1
  ES-MSG-NR := P-NATRP-ERC
  ES-MSG-TXT := P-NATRP-ERT
  ESCAPE MODULE
END-IF                                                  /* HEB1 <
IF NOT #SOURCE-EXIST
  #OPTIONS(1) := 'BB'
  #OPTIONS(2) := 'PR'
  #OPTIONS(3) := 'AR'
  #OPTIONS(4) := 'DI'
  #OPTIONS(5) := 'BU'
  #I := 5
ELSE
  IF ACTIVE-REPORTS.AR-CC-TYPE = 0005 AND #BIN-SIZE = 0
    ADD 1 TO #I
    #OPTIONS(#I) := 'BB'     /* Browse
  END-IF
  IF NOT (ACTIVE-REPORTS.AR-ARCHIVE = ' ' OR = 'A')
    ADD 1 TO #I
    #OPTIONS(#I) := 'AR'     /* Archive
  END-IF
END-IF
/*
IF NOT #IS-ORIGINAL-FOLDER   /* Is a link...     /* CF3 +
  ADD 1 TO #I
  #OPTIONS(#I) := 'FI'       /* File active report
END-IF                                           /* CF3 -
** IF NOT (ACTIVE-REPORTS.AR-ARCHIVE = '*' OR = 'P' OR = 'R') OR
IF NOT (ACTIVE-REPORTS.AR-ARCHIVE = '*') OR   /* BLI NOMALL-1829
    ACTIVE-REPORTS.AR-REVIVE = '*'
  ADD 1 TO #I
  #OPTIONS(#I) := 'RV'       /* Revive
END-IF
#BC-REPORT := ACTIVE-REPORTS.AR-REPNAME
#BC-REPRNB := ACTIVE-REPORTS.AR-REPRNB
FNBC1. FIND NUMBER BC WITH BC-REPORT-RNB = #BC-REPORT-RNB
IF *NUMBER(FNBC1.) = 0
  ADD 1 TO #I
  #OPTIONS(#I) := 'LX'       /* XREFs
END-IF
/*
/* Set functional restrictions for user profile or granting reasons
IF ES-USER-TYPE NE 'A'
  DECIDE FOR EVERY CONDITION
    WHEN PROF-ARCHIVE NE 'Y' AND PROF-ARCHIVE NE 'M'
      #NEW-OPTIONS(1) := 'AR'
    WHEN PROF-REVIVE NE 'Y' AND PROF-REVIVE NE 'M'
      #NEW-OPTIONS(2) := 'RV'
    WHEN (ES-FUNCTION = 'LS1' OR = 'LS2')
      PERFORM SET-FOLDER-GRANTS
    WHEN ANY
      CALLNAT 'NOOPT--N'  #NEW-OPTIONS(*) #OPTIONS(*)
    WHEN NONE IGNORE
  END-DECIDE
END-IF
/*
END-SUBROUTINE /* OPTIONS                                     /* CF4 <-
*
************************************************************************
DEFINE SUBROUTINE GET-FOLDER-GRANTS              /* - reworked - CF4 ->
************************************************************************
/*
RESET #GR-USERID #GRANTS(*) #GR-NAME
IF ES-USER-TYPE = 'A'
  #GRANTS(*) := 'Y'
ELSE
  /* Last check to get a real folder (not a link) for grantings
  IF ##FO-LINKED-FO-ID = ' '
    #FO-ID-N := ##FO-ID
    COMPRESS ##FO-USER-ID #FO-ID-A TO #GR-NAME LEAVING NO
  ELSE
    #FO-ID-N := ##FO-LINKED-ID
    COMPRESS ##FO-LINKED-USER-ID #FO-ID-A TO #GR-NAME LEAVING NO
  END-IF
  CALLNAT 'NOGROU-N' 'F' #GR-NAME ES-USER #GR-USERID #GRANTS(*)
END-IF
/*
END-SUBROUTINE /* GET-FOLDER-GRANTS                           /* CF4 <-
/*
************************************************************************
DEFINE SUBROUTINE SET-FOLDER-GRANTS              /* - reworked - CF4 ->
************************************************************************
/*
IF #GRANTS(1) = 'Y'   /* Authorized as folder owner
  ESCAPE ROUTINE
END-IF
/* In the following, an empty GRANTS list is treated like       /* CF2
/* granted for owner rights.
/* May be for compatibility reasons for objects existing before
/* the authorization system was implemented ?                   /* CF2
IF NOT(#GRANTS(*) NE ' ')
  ESCAPE ROUTINE
END-IF
/*
IF NOT #OWNER-REPORT           /* (Report owner always has full rights)
  DECIDE FOR EVERY CONDITION
    WHEN #GRANTS(4) NE 'Y'
      #NEW-OPTIONS(3) := 'BB'  /* Browse
      /*
    WHEN #GRANTS(2) NE 'Y'
      #NEW-OPTIONS(4) := 'OP'  /* Modify/Open
      /*
    WHEN #GRANTS(2) NE 'Y'
      #NEW-OPTIONS(5) := 'FI'  /* File report
      /*
    WHEN #GRANTS(2) NE 'Y'
      #NEW-OPTIONS(6) := 'BU'  /* Put report in bundle
      /*
    WHEN #GRANTS(3) NE 'Y'
      #NEW-OPTIONS(7) := 'DL'  /* Delete
      /*
    WHEN #GRANTS(2) NE 'Y'
      #NEW-OPTIONS(8) := 'DI'  /* Distribute
      /*
    WHEN #GRANTS(5) NE 'Y'
      #NEW-OPTIONS(1) := 'AR'  /* Archive
      /*
    WHEN #GRANTS(6) NE 'Y'
      #NEW-OPTIONS(2) := 'RV'  /* Revive
      /*
    WHEN NONE IGNORE
  END-DECIDE
END-IF
/*
END-SUBROUTINE /* SET-FOLDER-GRANTS                           /* CF4 <-
/*
************************************************************************
DEFINE SUBROUTINE GET-TEXT
************************************************************************
RESET SHORT-MSG LONG-MSG(*) #HEADER
VERSION := 0
NADA2000.OBJECT-KIND := 'U'
NADA2000.ERROR-NUMBER := #MSG-NR
NADA2000.OPT-INSERT-DYN := FALSE
NADA2000.OPT-LANGUAGE := ES-LANGUAGE
NADA2000.LIBRARY := ES-APP-SERVER-LIBRARY
CALLNAT 'NATA2000' NADA2000 NATA2000.EXTENDED-PARMS NAD-MSG NAD-FLD
*
END-SUBROUTINE /* GET-TEXT
/*
************************************************************************
DEFINE SUBROUTINE GET-BASE-FOLDER                     /* - new - CF4 ->
************************************************************************
/*
/*   Identify the folder where the Active Reports are
/*   really contained. In case of a folder-link the base folder
/*   has to be retrieved.
/*
/*   To be compatible with an old structure, where folder-links
/*   could be set on folder-links, a loop to get the base folder
/*   is furthermore used.
/*   At least with NOM351 no longer folder-links on folder-links
/*   are possible.
/*
/*   To be used in list types LS1 and LS2/LS3
/*
/*   #FO-USER            :  Input   (e.g. ES-USER)
/*   #FO-NAME            :  Input   (e.g. ES-KEY-PARM(1) )
/*
/*   ##FO-ID             :  Output
/*   ##FO-USER-ID        :  Output
/*   ##FO-LINKED-FO-ID   :  Output
/*   #IS-ORIGINAL-FOLDER :  Output
/*
/* ---------------------------------------------------------------------
/*
IF #FO-NAME = '#Inbasket' OR = '#Listeneingang'
  ##FO-LINKED-USER-ID := #FO-USER
  ##FO-LINKED-ID      := 1
  FIND FO WITH FO-USER-FO-ID = ##FO-LINKED-FO-ID
    #FO-NAME := FO.FO-NAME
  END-FIND
END-IF
/*
RESET #FO-ID-N ##FO-ID ##FO-USER-ID ##FO-LINKED-FO-ID
/*
FIND FO WITH FO-USER-NAME = #FO-USERNAME
  ##FO-ID           := FO.FO-ID
  ##FO-USER-ID      := FO.FO-USER-ID
  ##FO-LINKED-FO-ID := FO.FO-LINKED-FO-ID
  /*
  IF FO.FO-LINKED-USER-ID = ' '
    #IS-ORIGINAL-FOLDER := TRUE
  END-IF
  /*
  RPT. REPEAT WHILE ##FO-LINKED-FO-ID NE ' '
    FIND FO-L WITH FO-USER-FO-ID = ##FO-LINKED-FO-ID
      IF NO RECORDS FOUND
        ESCAPE BOTTOM (RPT.)
      END-NOREC
      ##FO-ID           := FO-L.FO-ID
      ##FO-USER-ID      := FO-L.FO-USER-ID
      ##FO-LINKED-FO-ID := FO-L.FO-LINKED-FO-ID
    END-FIND
  END-REPEAT
  /*
END-FIND
/*
END-SUBROUTINE /* GET-BASE-FOLDER                             /* CF4 <-
/*
** ---------------------------------------------------------------------
ON ERROR
  ES-RC := 1
  COMPRESS ES-MSG-TXT
    *PROGRAM 'Error' *ERROR-NR 'in line' *ERROR-LINE TO ES-MSG-TXT
  ESCAPE ROUTINE
END-ERROR
**-------------------------------------------------------------------
END
