* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    NOMPH02N
* Function  Physical printer maintenance API
* Version 2.1.1
*
* Maintenance:
* uuu yy-mm-dd s(999999) ....
* xsiszha  2000-05-30 s(CE7760) created
* fhi      2000-08-24 QA03      Use NAT23006 for error values
* xsetggr  2005-03-30 nom31
* xsetggr  2005-06-30 p(265613) evaluate eom-def-user
* xsetggr 2007-05-18 p(289847) restore NOM lfile when error occurs
* fhi     2007-07-12 NOM3202   C-NATERR changed, NAD23006 is obsolete.
* xsetggr 2008-08-11 p(300323) add steplibs
* xsetggr 2008-12-05 p(300323) change adding of steplibs
* xsetggr 2009-02-10 P300323   delete steplib handling, get EOM-LIBRARY
*                              by RGETLIB
* fhi     2009-02-27 P300323 Rename RGETSTEP to NOMGSTEP delivered in SYSTEM
* fhi     2010-09-21 NOMALL-97 Use no more C-NATERR but C-NATERN instead
* SU1     2014-11-12 NOMALL-1527 getting rid of coding for old versions-
*                                only restruct
* SU2     2018-04-05 NOMALL-1961 Use new task IDs
* SU3     2019-12-23 NOMALL-2368 avoid NOM0051 (NOMPH--P changed)
* ----------------------------------------------------------------------
DEFINE DATA
PARAMETER USING NOMPH--P
************************************************************************
LOCAL USING NOMPH--E
LOCAL USING EOM----P
LOCAL USING EOM----E
LOCAL USING EOMPHM-P
LOCAL USING EOMPHM-E
LOCAL USING EOMMSG-P
LOCAL USING SATFNC3E
LOCAL USING SATLF02P
LOCAL
1 #LFILE-CHANGED             (L)
1 #NOM-DBID                  (N5)
1 #NOM-FNR                   (N5)
1 #I                         (I4)
1 #J                         (I4)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET NOMPH-ERROR-CODE NOMPH-ERROR-TEXT
*
DECIDE FOR EVERY CONDITION
  WHEN NOMPH-NOM-FNR NE 0 AND NOMPH-NOM-DBID NE 0
    PERFORM GET-NOM-LFILE
    PERFORM SET-NOM-LFILE
    #LFILE-CHANGED := TRUE
  WHEN SATLF-ERROR-CODE =0
    PERFORM PHYSICAL-PRINTER-MAINTENANCE
  WHEN #LFILE-CHANGED
    PERFORM SET-OLD-NOM-LFILE
  WHEN NONE
    IGNORE
END-DECIDE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE GET-NOM-LFILE
************************************************************************
SATLF-LFILE    := 206
SATLF-FUNCTION := 'GET'
CALLNAT SAT-GET-SET-LFILE SATLF-SATVERS SATLF-PARMS (*)
#NOM-DBID := SATLF-DBID-N5
#NOM-FNR  := SATLF-FNR-N5
*
END-SUBROUTINE /* GET-NOM-LFILE
*
************************************************************************
DEFINE SUBROUTINE SET-LFILE
************************************************************************
SATLF-LFILE    := 206
SATLF-FUNCTION := 'SET'
CALLNAT SAT-GET-SET-LFILE SATLF-SATVERS SATLF-PARMS (*)
*
END-SUBROUTINE /* SET-LFILE
*
************************************************************************
DEFINE SUBROUTINE SET-NOM-LFILE
************************************************************************
SATLF-DBID-N5 := NOMPH-NOM-DBID
SATLF-FNR-N5  := NOMPH-NOM-FNR
PERFORM SET-LFILE
*
END-SUBROUTINE /* SET-NOM-LFILE
*
************************************************************************
DEFINE SUBROUTINE SET-OLD-NOM-LFILE
************************************************************************
SATLF-DBID-N5 := #NOM-DBID
SATLF-FNR-N5  := #NOM-FNR
PERFORM SET-LFILE
*
END-SUBROUTINE /* SET-OLD-NOM-LFILE
*
************************************************************************
DEFINE SUBROUTINE CALL-INTERNAL-API
************************************************************************
RESET EOMMSG-PARMS
CALLNAT 'EOMPHM-N' EOM-PARMS EOMPHM-PARMS EOMMSG-PARMS
*
IF EOMMSG-NR NE 0
  NOMPH-ERROR-CODE := EOMMSG-NR
  IF EOMMSG-TEXT = ' '
    NOMPH-ERROR-TEXT := F#GETMSG (<EOMMSG-NR, EOMMSG-TOKEN(1:3)>)
  ELSE
    NOMPH-ERROR-TEXT := EOMMSG-TEXT
  END-IF
END-IF
*
END-SUBROUTINE /* CALL-INTERNAL-API
*
************************************************************************
DEFINE SUBROUTINE PHYSICAL-PRINTER-MAINTENANCE
************************************************************************
RESET EOM-LOGGING EOM-LOG-TYPES (*)
EOMPHM-I-ATTRIBUTE-TYPE := NOMPH-ATTRIBUTE-TYPE
EOMPHM-I-COPY-AUTHORIZATION := NOMPH-COPY-AUTHORIZATION
EOMPHM-I-TARGET-DBID := NOMPH-NOM-DBID
EOMPHM-I-TARGET-FNR := NOMPH-NOM-FNR
EOMPHM-I-ID := NOMPH-PRINTER-ID
EOMPHM-I-NEWID := NOMPH-PRINTER-NEWID
IF NOT (NOMPH-LANGUAGE = 1 OR = 2)
  EOM-LANGUAGE := *LANGUAGE
ELSE
  EOM-LANGUAGE := NOMPH-LANGUAGE
END-IF
EOM-USER := NOMPH-USER-ID
EOM-VERSION := NOMPH-NOMVERS
EOM-LOG-TYPES(1) := NOMPH-LOG-TYP
EOM-FUNCTION := NOMPH-FUNCTION
EOMPHM-OUT-PARMS (*) := NOMPH-ATTR (*)
CALLNAT 'RGETLIB' EOM-LIBRARY
COMPRESS EOM-LIBRARY 'U' TO EOM-USER-LIBRARY LEAVING NO
*
/*SU2 FIND MONITOR WITH M-MONITOR-ID = EOM-LIBRARY
EOM-DEF-USER := F#MONITOR-USER-AUTODEF (<>) /*SU2
*
IF NOMPH-FUNCTION = NOMPH-FCT-MODIFY
AND NOMPH-ATTRIBUTE-TYPE = PRINTER-SPECIAL-ATTRIBUTES                 /*
  EOM-FUNCTION := EOM-READHOLD
  PERFORM CALL-INTERNAL-API
  IF EOMMSG-NR = 0
    PERFORM MODIFY-SPECIAL-ATTRIBUTES
    EOM-FUNCTION := EOM-MODIFY
  END-IF
END-IF
*
IF EOMMSG-NR = 0
  PERFORM CALL-INTERNAL-API
END-IF
*
IF EOMMSG-NR = 0
  IF NOMPH-FUNCTION = NOMPH-FCT-READ OR = NOMPH-FCT-READ-NEXT
  OR = NOMPH-FCT-READ-HOLD OR = NOMPH-FCT-READ-HOLD-NEXT              /*
    NOMPH-ATTR (*) := EOMPHM-OUT-PARMS (*)
    NOMPH-PRINTER-ID := EOMPHM-I-ID
    NOMPH-EOF := EOMPHM-EOF
  END-IF
*
  IF NOMPH-FUNCTION = NOMPH-FCT-ADD
    EOMPHM-I-ATTRIBUTE-TYPE := PRINTER-SPECIAL-ATTRIBUTES
    EOM-FUNCTION := EOM-READHOLD
    PERFORM CALL-INTERNAL-API
    IF EOMMSG-NR = 0
      PERFORM MODIFY-SPECIAL-ATTRIBUTES
      IF EOMMSG-NR = 0
        EOM-FUNCTION := EOM-MODIFY
        PERFORM CALL-INTERNAL-API
      END-IF
    END-IF
  END-IF
END-IF
*
END-SUBROUTINE /* PHYSICAL-PRINTER-MAINTENANCE
*
************************************************************************
DEFINE SUBROUTINE MODIFY-SPECIAL-ATTRIBUTES
************************************************************************
FOR #I 1 25
  IF EOMPHM-ATTR-VAR (*) = NOMPH-ATTR-VAR (#I)
    EXAMINE FULL EOMPHM-ATTR-VAR (*) FOR FULL NOMPH-ATTR-VAR (#I)
      GIVING INDEX #J
    IF #J NE 0
      EOMPHM-ATTR-DEFAULT (#J) := NOMPH-ATTR-VALUE (#I)
    END-IF
  ELSE
    IF NOMPH-ATTR-VAR (#I) NE ' '
      NOMPH-ERROR-CODE := 126
      NOMPH-ERROR-TEXT :=F#GETMSG(<NOMPH-ERROR-CODE,NOMPH-ATTR-VAR(#I)>)
      ESCAPE ROUTINE
    END-IF
  END-IF
END-FOR
*
END-SUBROUTINE /* MODIFY-SPECIAL-ATTRIBUTES
*
************************************************************************
ON ERROR
************************************************************************
  IF #LFILE-CHANGED
    PERFORM SET-OLD-NOM-LFILE
  END-IF
  IF *ERROR-NR = 3009 OR = 3145
    NOMPH-ERROR-CODE := *ERROR-NR
  ELSE
    IF *ERROR-NR = 82
      WRITE *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II':'SS'.'T)
        'Missing NOM steplibs' //
      'Please call NOM steplib routine NOMGSTEP before call of NOM API.'
    END-IF
    NOMPH-ERROR-CODE := 21
    CALLNAT 'C-NATERN' NOMPH-ERROR-TEXT
  END-IF
  NOMPH-ERROR-TEXT :=F#GETMSG(<NOMPH-ERROR-CODE,NOMPH-ERROR-TEXT>) /*SU2
  ESCAPE ROUTINE
END-ERROR
*
END
