* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RLOGERR - log on line error in log file
*
* gw  98-06-26 p(171906) delete old log messages where L-TIME-INV was
*                        not filled by RLOGERR.
* sju 00-11-14 s(999999) SAT logging
* xsetggr 2008-05-03 p(303852) use SATLGW2P/N
* SU1     2013-01-31 unused      Deactivate unused data areas
* RAYA    2013-06-25 use SATLGW3N/P
* SU2     2015-09-17 NOMALL-1726 show full message
* fhi     2017-01-04 NOMALL-1913 Use microseconds for logging
* fhi     2019-03-07 NOMALL-2233 Correct CALLNAT
* ---------------------------------------------------------------------
*
DEFINE DATA
LOCAL USING SATLGW4P          /* NOMALL-1913 fhi was SATLGW3P
LOCAL
1 #ERROR-NR                          (N5)
1 #ERROR-LINE                        (N5)
1 #ERROR-PROG                        (A8)
1 #ERROR-TEXT                        (A200) /*SU2
1 SATLGW-MESSAGE                     (A250)
*
END-DEFINE
*
INPUT (LS=250) #ERROR-NR #ERROR-LINE #ERROR-PROG #ERROR-TEXT /*SU2
SATLGW-PRODUCT-CODE := 'NOM'
SATLGW-ET           := SATLGW-INVERT-TIME := TRUE
SATLGW-NOM-TYPE     := 'OE'
COMPRESS 'NUM' #ERROR-NR 'LINE:' #ERROR-LINE 'PROG:' #ERROR-PROG
  #ERROR-TEXT TO SATLGW-MESSAGE
* CALLNAT 'SATLGW3N' SATLGW-PARMS SATLGW-MESSAGE
* fhi     2019-03-07 NOMALL-2233 line above out, below in
CALLNAT 'SATLGW4N' SATLGW-PARMS SATLGW-MESSAGE
IF SATLGW-RC NE 0
  WRITE NOHDR *PROGRAM 'Error:' SATLGW-RC 'writing to SAT log'
END-IF
*
END
