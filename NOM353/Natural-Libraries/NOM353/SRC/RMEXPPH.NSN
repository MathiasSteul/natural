* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
************************************************************************
* RMEXPPH - Export PHysical printer
*
* Maintenance
* User  yyyy-mm-dd Issue       Remark
* ----- ---------------------- -----------------------------------------
*       2019-02-22 generated   Created from RMXML2LD
* SU1   2015-09-15 NOMALL-1693 NAT00059(A80)->NAT41002(A253)
* fhi   2019-02-19 NOMALL-2215 Export not complete
* BLI   2019-05-06 NOMALL-2261 Recataloged due to changes of XXUX---P
* SU2   2020-11-10 NOMALL-2440 split DDM -> NRM-MF-NODES
* SU3   2021-02-18 NOMALL-2443 restruct+MSG
* GGS01 2021-07-06 NOMALL-2474 RECAT since RMEXP-C changed
* SU4   2021-08-18 NOMALL-2467 RMEXPPHL
*******************************************************************************
DEFINE DATA
PARAMETER USING XXUX---P
PARAMETER USING RMEXP-A
PARAMETER
1 #TRACING               (L)
1 #ID                    (A250) BY VALUE OPTIONAL
/***********************************************************************
INDEPENDENT
1 +ID                    (A/*) DYNAMIC
1 +ID-INDEX              (I2)
/***********************************************************************
/*SU4 LOCAL USING RMEXPPHL
LOCAL USING RMBAS64P
LOCAL USING VUXDEF-L
/*SU2 LOCAL USING VMONITUL /* NOMALL-2215 fhi in
LOCAL USING N-41002L /*SU1
/***********************************************************************
LOCAL
1 PH VIEW OF NRM-PHYSICAL-PRINTERS /*SU4 was RMEXPPHL
  2 PH-OBJECT-TYPE       (A10)
  2 PH-OBJECT-TIME       (T)
  2 PH-VTAMID            (A8)
  2 PH-STATUS            (A1)
  2 PH-FORM              (A10)
  2 PH-LOCATION          (A30)
  2 PH-PRINTER-TYPE      (A8)
  2 PH-ATTRIBUTES        (A95/1:25)
  2 REDEFINE PH-ATTRIBUTES
    3 PH-ATTR-GROUP      (1:25)
      4 PH-ATTR-ID       (I1)
      4 PH-ATTRIB        (A94)
  2 PH-JCL-SKELETON      (A8)
  2 PH-PRINT-PGM         (A8)
  2 PH-ESCAPE-CHAR       (A1)
  2 PH-MAX-LINES         (P10)
  2 PH-TIME-WINDOWS      (A8/1:8) /* MU-FIELD
  2 PH-LAST-UPDATE       (T)
  2 PH-LAST-UPDATE-USER  (A16)
1 WRITE-FILE VIEW OF WRITE-FILE
  2 ERROR-CODE
  2 ERROR-TEXT
*
1 #FIELD                 (A32)
1 #VALUE                 (A300)
1 #LEN                   (I4)
1 #WORK-LINE             (A250)
1 #FUNCTION              (A10)
1 #I                     (I4)
1 #J                     (I4)
1 #K                     (I4)
1 #L                     (I4)
1 #PROGRAM               (A8) INIT <*PROGRAM>
1 REDEFINE #PROGRAM
  2 FILLER               5X /*RMEXP
  2 #TYPE                (A2)
1 #KEY                   (A100)
1 #KEY-FROM              (A100)
1 #KEY-TO                (A100) INIT FULL LENGTH <H'FF'>
1 #KEY-MASK              (A25)
/*SU4 1 #KEY-LEN               (I2)
1 #KEY-LEN2              (I2) CONST <8> /*full len PH-VTAMID SU4
1 #TRACE-MSG             (A250)
1 #IND                   (I4)
1 #POS                   (I4)
1 #DEP                   (A5)
1 #NODE                  (N5)
1 #ID-MEMBER             (A) DYNAMIC
1 #MASK                  (A300) INIT FULL LENGTH <'P'>
1 #PRINTABLE             (A300)
1 #PH-OBJECT-TIME        (A21)
1 #PH-LAST-UPDATE        (A21)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
PERFORM #START
READ PH BY PH-VTAMID = #KEY-FROM THRU #KEY-TO
  #KEY := PH-VTAMID
  PERFORM HANDLE-MASK
* Get depending objects:
  INCLUDE RMLD2XC3 'PH-VTAMID' '''H''' /*RMEXPGR
  COMPRESS '<PH depending="' #DEP '">' TO #WORK-LINE LEAVING NO
  PERFORM WRITE-XML
  IF #OD-LOG = 'Y'
    IF #ID SPECIFIED
      COMPRESS 'Exported: PH */' PH-VTAMID TO #TRACE-MSG
    ELSE
      COMPRESS 'Exported: PH /' PH-VTAMID TO #TRACE-MSG
    END-IF
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    END TRANSACTION
  END-IF
  MOVE EDITED PH.PH-OBJECT-TIME (EM=YYYY'-'MM'-'DD'-'HH':'II':'SS'.'T)
    TO #PH-OBJECT-TIME
  MOVE EDITED PH.PH-LAST-UPDATE (EM=YYYY'-'MM'-'DD'-'HH':'II':'SS'.'T)
    TO #PH-LAST-UPDATE
  #FIELD := 'PH-OBJECT-TYPE'
  #VALUE :=  PH.PH-OBJECT-TYPE
  PERFORM CONVERT-XML
  #FIELD := 'PH-OBJECT-TIME'
  #VALUE :=  #PH-OBJECT-TIME
  PERFORM CONVERT-XML
  #FIELD := 'PH-VTAMID'
  #VALUE :=  PH.PH-VTAMID
  PERFORM CONVERT-XML
  #FIELD := 'PH-STATUS'
  #VALUE :=  PH.PH-STATUS
  PERFORM CONVERT-XML
  #FIELD := 'PH-FORM'
  #VALUE :=  PH.PH-FORM
  PERFORM CONVERT-XML
  #FIELD := 'PH-LOCATION'
  #VALUE :=  PH.PH-LOCATION
  PERFORM CONVERT-XML
  #FIELD := 'PH-PRINTER-TYPE'
  #VALUE :=  PH.PH-PRINTER-TYPE
  PERFORM CONVERT-XML
  FOR #L := 25 TO 1 STEP -1
    IF PH.PH-ATTR-ID (#L) NE 0
      ESCAPE BOTTOM
    END-IF
  END-FOR
  FOR #I = 1 TO #L
    #FIELD := 'PH-ATTR-ID'
    #VALUE :=  PH.PH-ATTR-ID(#I)
    PERFORM CONVERT-XML1
  END-FOR
  FOR #L := 25 TO 1 STEP -1
    IF PH.PH-ATTRIB (#L) NE ' '
      ESCAPE BOTTOM
    END-IF
  END-FOR
  FOR #I = 1 TO #L
    #FIELD := 'PH-ATTRIB'
    #VALUE :=  PH.PH-ATTRIB(#I)
    PERFORM CONVERT-XML1
  END-FOR
  #FIELD := 'PH-JCL-SKELETON'
  #VALUE :=  PH.PH-JCL-SKELETON
  PERFORM CONVERT-XML
  #FIELD := 'PH-PRINT-PGM'
  #VALUE :=  PH.PH-PRINT-PGM
  PERFORM CONVERT-XML
  #FIELD := 'PH-ESCAPE-CHAR'
  #VALUE :=  PH.PH-ESCAPE-CHAR
  PERFORM CONVERT-XML
  #FIELD := 'PH-MAX-LINES'
  #VALUE :=  PH.PH-MAX-LINES
  MOVE LEFT #VALUE TO #VALUE
  PERFORM CONVERT-XML
  FOR #L := 8 TO 1 STEP -1
    IF PH.PH-TIME-WINDOWS (#L) NE ' '
      ESCAPE BOTTOM
    END-IF
  END-FOR
  FOR #I = 1 TO #L
    #FIELD := 'PH-TIME-WINDOWS'
    #VALUE :=  PH.PH-TIME-WINDOWS(#I)
    PERFORM CONVERT-XML1
  END-FOR
  #FIELD := 'PH-LAST-UPDATE'
  #VALUE :=  #PH-LAST-UPDATE
  PERFORM CONVERT-XML
  #FIELD := 'PH-LAST-UPDATE-USER'
  #VALUE :=  PH.PH-LAST-UPDATE-USER
  PERFORM CONVERT-XML
*
  PERFORM #END-OBJ
END-READ
PERFORM #END
*
INCLUDE RMEXP-C /*CALL-NPR, WRITE-XML, OPEN-XML, CLOSE-XML, WRITE-XML
*
END
