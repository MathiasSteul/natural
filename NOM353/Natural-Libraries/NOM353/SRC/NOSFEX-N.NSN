* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
** NOSFEX-N
** Version    2.2.1
** Function   Natural member existance check
**
**            Input keys:
**            ES-KEY-PARM(1)  library name
**            ES-KEY-PARM(2)  member name
**            ES-KEY-PARM(3)  member type
**
**            ES-RC=1 library or member not found
**            ES-RC=2 specified library is not a steplib;
**                    only for membar type 'PRTEXIT'
**            ES-RC=3 error during setting lfile 219
**
** Maintenance:
** XSETGGR 2002-06-17  created (made from N-CHKSRC)
** XSETGGR 2003-01-15  new version
* HH 04-12-13 use callnat NATA1100 instead of SYSTEM-FNAT/SYSTEM-FUSER
* SU1     2014-06-27 NOMALL-1281 show last update user => restructured
* -------------------------------------------------------------------
DEFINE DATA
PARAMETER USING ESMCNT-A
PARAMETER USING ESMINP-A
* *****
LOCAL USING NAD-MSG   /* Data for message exchange
LOCAL USING NAD-FLD   /* Description of the field in error
*
LOCAL
1 NADA1100
  2 OBJEKT-KEY
    3 DBID                    (N5)
    3 FNR                     (N5)
    3 PASSWORD                (A8)
    3 CIPHERCODE              (N8)
    3 OBJECT-CLASS            (I1)
    3 LIBRARY                 (A8)
    3 OBJECT-NAME             (A32)
    3 OBJECT-TYPE             (A2)
    3 OBJECT-KIND             (A1)
*
  2 INPUTS
    3 OPT-ACCESS              (A1)
    3 OPT-ET                  (L)
    3 OPT-REPLACE             (A1)
    3 OPT-LINE-NUM            (A1)
    3 OPT-STEPLIBS            (L)
    3 OPT-REDEF-DIR           (L)
    3 OPT-STREAM              (A1)
    3 OPT-AMOUNT              (I2)
    3 OPT-LINESIZE            (I2)
/*
  2 INPUT-OUTPUTS
    3 INT-HANDLE              (I4)
    3 NEXT-SEQ                (I4)
    3 NEXT-NUM                (I2)
/*
  2 OUTPUTS                        /* Output for READ, input for WRITE
    3 RETURNED                (I2)
    3 SRC-NUM                 (I2/1:20)
    3 SRC-TEXT                (A1/1:20,1:92)
    3 REDEFINE SRC-TEXT
      4 SRC-GROUP             (1:20)
        5 SRC-LINE            (A92)
    3 SRC-SEQ                 (I4/1:20)
    3 SRC-LONG                (A1/1:20)
*
1 NATA1100
  2 VERSION                   (I1) INIT <1>
  2 V1-NSC-CHECK              (A1) /* Check against NSC
1 REDEFINE NATA1100
  2 EXTENDED-PARMS
    3 EXTENDED-DATA           (A1/1:2)
*
1 #CH                         (A250)
1 REDEFINE #CH
  2 #FIL                      (A28)
  2 #LIBB                     (A8)
  2 #MEMB                     (A8)
1 K1                          (A18)
1 REDEFINE K1
  2 #L1                       (A8)
  2 #M1                       (A8)
  2 #S1                       (B2)
1 K2                          (A18)
1 REDEFINE K2
  2 #L2                       (A8)
  2 #M2                       (A8)
  2 #S2                       (B2)
1 #MEMBER                     (A8)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
/* check steplibs and set lfile 219
CALLNAT 'NOSFXX1N' ES-CONTROL ES-INPUT
/* check member existance
IF ES-RC NE 0
  ESCAPE ROUTINE
END-IF
#L1 := ES-KEY-PARM(1)
#L2 := #L1
#M1 := ES-KEY-PARM(2)
#M2 := #M1
ES-RC := 1
RESET #S1
MOVE H'FFFF' TO #S2
*
LIBRARY       := #L1
OBJECT-NAME   := #M1
OPT-LINE-NUM  := 'Y'
OPT-AMOUNT    := 20
OPT-LINESIZE  := 79
OPT-STREAM    := 'B'
V1-NSC-CHECK  := 'Y'
OPT-ACCESS   := 'O'
*
REPEAT
  CALLNAT 'NATA1100' NADA1100 NATA1100.EXTENDED-PARMS NAD-MSG NAD-FLD
  OPT-ACCESS := 'R'
  IF NOT (NAD-MSG.MSG-NR = 0 OR= 100)
    ESCAPE BOTTOM
  END-IF
  IF SUBSTR(OBJECT-NAME,1,8) = #M1 AND LIBRARY = #L1
    RESET ES-RC
  END-IF
  ESCAPE BOTTOM
END-REPEAT
*
PERFORM CLOSE-NATA1100
/* reset lfile 219
CALLNAT 'NOSFXX2N' ES-CONTROL ES-INPUT
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE CLOSE-NATA1100
************************************************************************
OPT-ACCESS := 'C'
CALLNAT 'NATA1100' NADA1100 NATA1100.EXTENDED-PARMS NAD-MSG NAD-FLD
*
END-SUBROUTINE
*
END
