* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RMIGSFIL
* FUNCTION : Change physical DBID and File-Number of logical File
*
* Maintenance
* uuu yyyy-mm-dd s(999999) ...
* jvd 1997-09-18 s(164220) Change call 'CMMPP' NAT23 compatiable
* jvd 1998-09-10 s(164220) NOM141ÖNAT23
* -------------------------------------------------------------------
DEFINE DATA
PARAMETER
1 P-RC            (I4)   /* OUT
1 P-NEW-DBID      (P5)   /* IN
1 P-NEW-FNR       (P5)   /* IN
*
LOCAL
1 #PARM-DBID      (N5)
1 #PARM-FNR       (N5)
1 #PARM-LFILE     (N5)  INIT <158>
1 #PARM-PASSWORD  (A8)
1 #PARM-CIPHER    (A8)
1 #PARM-RC        (I4)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#PARM-DBID := P-NEW-DBID
#PARM-FNR  := P-NEW-FNR
*
RESET P-RC
CALLNAT 'SETNRMLN' #PARM-DBID #PARM-FNR #PARM-LFILE
  #PARM-PASSWORD #PARM-CIPHER P-RC
*
END
