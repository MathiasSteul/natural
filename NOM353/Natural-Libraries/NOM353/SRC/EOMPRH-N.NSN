* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member       EOMPRH-N
* Function     Logical Printer Field Help
* Version      1.3
*
* Maintenance
* UUU YY-MM-DD Sagsis Desciption
* --- -------- ------ --------------------------------------------------
* mwi 96-04-26        preparing for new design of helproutine
* gw  93-06-17        created
* SU1     2014-12-23 NOMALL-1548 removed unused definitions
* SU2     2018-01-15 NOM 3.5: EOMPRH-1+EOMPRH-2 included
* ----------------------------------------------------------------------
DEFINE DATA
PARAMETER
1 #FIELD-NAME      (A65)
*
LOCAL
1 F                (P2)
1 #FIELD           (A65)
1 REDEFINE #FIELD
  2 #F             (A1/1:65)
1 #L               (A65/18)  /* help text lines
1 #T               (A32)     /* help window title
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#FIELD := #FIELD-NAME
EXAMINE #FIELD FOR '.' GIVING POSITION F
IF F > 0
  RESET #F (1:F)
  MOVE LEFT #FIELD TO #FIELD
END-IF
*
DECIDE ON FIRST #FIELD
  VALUE '#PRINTER'              INPUT USING MAP 'HPRPPRT&'
  VALUE 'EOMPRM-COPIES'         INPUT USING MAP 'HPRPCOP&'
  VALUE 'EOMPRM-PRIORITY'       INPUT USING MAP 'HPRPPRI&'
  VALUE 'EOMPRM-EXITMEM'        INPUT USING MAP 'HPRPUEX&'
  VALUE 'EOMPRM-EXITLIB'        INPUT USING MAP 'HPRPLIB&'
  VALUE 'EOMPRM-PHYSICAL-NAME'  INPUT USING MAP 'HPRPHYS&'
  VALUE 'EOMPRM-JOBCARDS'       INPUT USING MAP 'HPRPJBC&'
  VALUE 'EOMPRM-RESTRICTED'     INPUT USING MAP 'HPRPRSU&'
  VALUE '#LOCATION'             IGNORE /* only output field
  VALUE 'RDEFPRG1', 'RDEFPRG2'
    FETCH RETURN 'NRMHELP' 'HPR30000'
    ESCAPE ROUTINE
  VALUE 'EOMPRM-DESC'
    IF *LANGUAGE = 2
      #T   :='Beschreibung'
      #L(1):='Kurzbeschreibung des Logischen Druckers.'
    ELSE
      #T   :='Description'
      #L(1):='A short description of the logical Printer'
    END-IF
  NONE VALUE
    #T   :='Sorry'
    IF *LANGUAGE = 2
      #L(1):='Keine Hilfe fuer dieses Feld vorhanden.'
    ELSE
      #L(1):='No Help available for this field.'
    END-IF
*
END-DECIDE
*
IF #T = ' '
  ESCAPE ROUTINE
END-IF
*
DEFINE WINDOW HELP TITLE #T
INPUT WINDOW = 'HELP' (IP=OFF AD=O DY=<I>) / #L(01) / #L(02) / #L(03)
  / #L(04) / #L(05) / #L(06) / #L(07) / #L(08) / #L(09) / #L(10)
  / #L(11) / #L(12) / #L(13) / #L(14) / #L(15) / #L(16) / #L(17)
  / #L(18)
*
END
