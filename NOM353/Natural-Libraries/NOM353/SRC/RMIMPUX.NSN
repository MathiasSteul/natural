************************************** data ***********************************
DEFINE DATA
PARAMETER USING RMIMP-A
PARAMETER
1 UX-FILL
  2 UX-NODE-NAME        (A16)
  2 UX-NODE-DESCRIPTION (A50)
  2 UX-NODE-USERID      (A8)
  2 UX-NODE-PASSWORD    (A32)
  2 UX-NODE-GROUP       (A8)
  2 UX-NODE-SUSPEND     (A1)
  2 UX-NODE-TIMEOUT     (N2)
  2 UX-NODE-TEMPDIR     (A70)
  2 UX-NODE-ACCESS
    3 UX-NODE-PATH      (A70/1:10)
    3 UX-NODE-CONTAINER-DB (N5/1:10)
    3 UX-NODE-CONTAINER-FNR (N5/1:10)
  2 UX-OBJECT-TYPE      (A10)
  2 UX-OBJECT-TIME      (T)
  2 UX-LAST-UPDATE      (T)
  2 UX-LAST-UPDATE-USER (A16)
/*SU3   2 UX-EMAIL-RECIPIENTS (A250/2)
/***********************************************************************
LOCAL USING RMIMP-L /*SU5
LOCAL USING RMBAS64P
/*SU6 LOCAL USING RMIMPUXL
*
LOCAL
1 UX VIEW OF NRM-UX-NODES /*SU6 was RMIMPUXL
  2 UX-OBJECT-TYPE          (A10)
  2 UX-OBJECT-TIME          (T)
  2 UX-LAST-UPDATE          (T)
  2 UX-LAST-UPDATE-USER     (A16)
  2 UX-NODE-NAME            (A16)
  2 UX-NODE-DESCRIPTION     (A50)
  2 UX-NODE-USERID          (A8)
  2 UX-NODE-PASSWORD        (A32)
  2 UX-NODE-GROUP           (A8)
  2 UX-NODE-SUSPEND         (A1)
  2 UX-NODE-TIMEOUT         (N2)
  2 UX-NODE-TEMPDIR         (A70)
  2 UX-NODE-ACCESS
    3 UX-NODE-PATH          (A70/1:10)
    3 UX-NODE-CONTAINER-DB  (N5/1:10)
    3 UX-NODE-CONTAINER-FNR (N5/1:10)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
IF *OCC(B64-TEXT-ARRAY) = 0
  EXPAND ARRAY B64-TEXT-ARRAY TO (1:5)
END-IF
IF NOT #SAVE
  IF #TAG-CURRENT = #TAG-OLD
    ADD 1 TO #IND
  ELSE
    #IND := 1
  END-IF
  IF #VALUE-CURRENT = ' '
    ESCAPE MODULE
  END-IF
  DECIDE ON FIRST VALUE OF #TAG-CURRENT
    VALUE 'UX-OBJECT-TYPE'
      UX-FILL.UX-OBJECT-TYPE := #VALUE-CURRENT
    VALUE 'UX-OBJECT-TIME'
      MOVE EDITED #VALUE-CURRENT TO UX-FILL.UX-OBJECT-TIME
        (EM=YYYY'-'MM'-'DD'-'HH':'II':'SS'.'T)
    VALUE 'UX-LAST-UPDATE'
      MOVE EDITED #VALUE-CURRENT TO UX-FILL.UX-LAST-UPDATE
        (EM=YYYY'-'MM'-'DD'-'HH':'II':'SS'.'T)
    VALUE 'UX-LAST-UPDATE-USER'
      UX-FILL.UX-LAST-UPDATE-USER := #VALUE-CURRENT
/*SU3     VALUE 'UX-EMAIL-RECIPIENTS'
/*SU3       UX-FILL.UX-EMAIL-RECIPIENTS (#IND) := #VALUE-CURRENT
    VALUE 'UX-NODE-NAME'
      UX-FILL.UX-NODE-NAME := #VALUE-CURRENT
    VALUE 'UX-NODE-DESCRIPTION'
      UX-FILL.UX-NODE-DESCRIPTION := #VALUE-CURRENT
    VALUE 'UX-NODE-USERID'
      UX-FILL.UX-NODE-USERID := #VALUE-CURRENT
    VALUE 'UX-NODE-PASSWORD'
      UX-FILL.UX-NODE-PASSWORD := #VALUE-CURRENT
    VALUE 'UX-NODE-GROUP'
      UX-FILL.UX-NODE-GROUP := #VALUE-CURRENT
    VALUE 'UX-NODE-SUSPEND'
      UX-FILL.UX-NODE-SUSPEND := #VALUE-CURRENT
    VALUE 'UX-NODE-TIMEOUT'
      IF #VALUE-CURRENT IS (N2)
        UX-FILL.UX-NODE-TIMEOUT := VAL (#VALUE-CURRENT)
      ELSE
        #MSG := 'UX-NODE-TIMEOUT'
        PERFORM FIELD-IGNORED /*RMIMP-C1
      END-IF
    VALUE 'UX-NODE-TEMPDIR'
      UX-FILL.UX-NODE-TEMPDIR := #VALUE-CURRENT
    VALUE 'UX-NODE-PATH'
      UX-FILL.UX-NODE-PATH (#IND) := #VALUE-CURRENT
    VALUE 'UX-NODE-CONTAINER-DB'
      IF #VALUE-CURRENT IS (N5)
        UX-FILL.UX-NODE-CONTAINER-DB (#IND) := VAL (#VALUE-CURRENT)
      ELSE
        #MSG := 'UX-NODE-CONTAINER-DB'
        PERFORM FIELD-IGNORED /*RMIMP-C1
      END-IF
    VALUE 'UX-NODE-CONTAINER-FNR'
      IF #VALUE-CURRENT IS (N5)
        UX-FILL.UX-NODE-CONTAINER-FNR (#IND) := VAL (#VALUE-CURRENT)
      ELSE
        #MSG := 'UX-NODE-CONTAINER-FNR'
        PERFORM FIELD-IGNORED /*RMIMP-C1
      END-IF
    NONE IGNORE
  END-DECIDE
ELSE
  #OBJ-NAME := UX-FILL.UX-NODE-NAME
  OBJ. FIND (1) UX WITH UX-NODE-NAME = UX-FILL.UX-NODE-NAME /*SU4:#KEY
    IF NO RECORDS FOUND
      MOVE BY NAME UX-FILL TO UX
      STORE UX
      PERFORM ADD-LOADED
      ESCAPE BOTTOM (OBJ.)
    END-NOREC
    MOVE BY NAME UX-FILL TO UX
    IF #REPL = 'Y'
      UPDATE (OBJ.)
      PERFORM ADD-REPLACED
    ELSE
      COMPRESS UX-FILL.UX-NODE-NAME 'not replaced for UX' TO #MSG /*SU4
      PERFORM XXRLOG-WRITE-LOG 'W' #MSG
      PERFORM ADD-NOT-REPLACED
    END-IF
  END-FIND
  END TRANSACTION
END-IF
*
INCLUDE RMIMP-C1
*
END
