* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* EOMPOM-N - Maintenance of EOM Object >>> Printout <<<
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* gw  93-07-01           created
* sju     2004-04-22 p(250355) correct handling of recfm
* xsetggr 2007-05-30 p(294790) add functions read-next, readhold-next,
*                              hold-print, release, restart-print
* xsetggr 2007-06-27 NOM3201   support 5 byte node and P11format run
*                              numbers, restow - changes in eompom-parms
* xsetggr 2007-10-05 p(297910) honored default recfm=vba, if recfm = ' '
* xsetggr 2008-02-26 p(294790) read texts from syserr
* xsetggr 2009-09-02 P314431   allow only DISKUNIX&NATUNIX printers for
*                    Unix systems,UNIXLP printers only for mainframe
* fhi     2010-09-03 NOMALL-97 Extend message line
* xsetggr 2010-10-07 NOMALL-865 add printer type WRTSPOOL
* xsetggr 2011-09-12 NOMALL-1058 use pda when call eompomvn
* xsetggr 2011-10-17 NOMALL-970  implement new report flag - print once
* xsetggr 2013-01-22 NOMALL-970  implementation cancelled
* SU1     2013-06-05 NOMALL-1262 remove OS2PM,HPSPOOL,WINPM,WINPM32
* RAYA    2013-07-21 NOMALL-1271 avoid nom0108 error
* SU2     2016-07-20 NOM 3.5: remove unused code
* SU3     2017-10-09 NOMALL-1823 NOM 3.5: remove CONNECT
* ----------------------------------------------------------------------
*
DEFINE DATA
PARAMETER USING EOM----P
PARAMETER USING EOMPOM-P
PARAMETER USING EOMMSG-P
************************************************************************
LOCAL USING EOMPOM-E
LOCAL USING EOM----E
LOCAL USING SATMS--P
LOCAL USING RTXT---L
LOCAL USING SATFNC3E
LOCAL USING EOMPHTYE
*
LOCAL
1 USERS VIEW OF NRM-USERS
  2 USER-PROFILE
  2 REDEFINE USER-PROFILE
    3 PROF-TYPE      (A1)
1 PRINTOUT VIEW OF NRM-PRINTOUTS
  2 PO-ID
  2 PO-STATUS
  2 PO-BUNDLE
  2 PO-LANGUAGE
  2 PO-PRINTER-TYPE
*
1 #NOF               (I2) CONST <3>
1 #FUNCTION          (A1/1:#NOF) CONST <'P','M','D'>
1 #SECURITY-OPTION   (A3)
1 ALLOWED            (L)
1 #I                 (I2)
1 OT                 (I2)
1 OJ                 (I2)
1 #FIX-VAR           (A1)
1 #J                 (I2)
1 #K                 (I2)
1 #LRECL             (A5)
1 REDEFINE #LRECL
  2 #LRECL-A1        (A1/5)
1 #LRECL-N           (N5)
1 #NEXT-ID           (N7)
1 #PO-ID             (N7)
1 REDEFINE #PO-ID
  2 #PO-ID-A         (A7)
1 #MSG-NR            (N4)
1 #MSG-TXT           (A250)
1 #PRINTER-TYPE      (A8)
1 #EXIST             (L)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET EOMMSG-PARMS
*
PERFORM SECURITY-CHECK
IF EOMMSG-NR NE 0
******************************************************************0) in
  ESCAPE ROUTINE
END-IF
*
PERFORM LOGGING-CHECK
*
IF EOM-FUNCTION NE EOM-SECURITY-CHECK
  EOMPOM-I-CHECK-FUNCTION := EOM-FUNCTION
  PERFORM FUNCTION-SECURITY
  IF EOMMSG-NR NE 0
    ESCAPE ROUTINE
  END-IF
END-IF
*
DECIDE ON FIRST EOM-FUNCTION
  VALUE EOM-ADD     PERFORM MODIFY-PRINTOUT-ATTRIBUTES
  VALUE EOM-MODIFY  PERFORM MODIFY-PRINTOUT-ATTRIBUTES
  VALUE EOM-DELETE  PERFORM DELETE-PRINTOUT-DEFINITION
  VALUE EOM-COPY    IGNORE
  VALUE EOM-RENAME  IGNORE
  VALUE EOM-COMMIT  END OF TRANSACTION
  VALUE EOM-BACKOUT BACKOUT TRANSACTION
  VALUE EOM-READ, EOM-READHOLD, EOM-READ-NEXT, EOM-READHOLD-NEXT
    PERFORM READ-PRINTOUT-ATTRIBUTES
  VALUE EOM-HOLD-PRINT, EOM-RELEASE, EOM-RESTART-PRINT
    PERFORM HOLD-RELEASE-RESTART
  NONE  IGNORE
END-DECIDE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE LOGGING-CHECK
************************************************************************
IF EOM-LOG-OBJTYP = 'R'
  ESCAPE ROUTINE
END-IF
*
RESET  EOM-LOGGING
*
EOM-LOG-OBJTYP := 'R'
*
IF EOM-LOG-TYPES (*) = 'R'
  EOM-LOG := TRUE
END-IF
*
END-SUBROUTINE /* LOGGING-CHECK
*
************************************************************************
DEFINE SUBROUTINE SECURITY-CHECK
************************************************************************
IF EOM-OBJTYP NE 'H'
  IF EOM-USER-TYPE NE 'A'
    FNDUS. FIND USERS WITH USER-ID = EOM-USER
      IF NO RECORDS FOUND
        IF EOM-DEF-USER NE 'Y'
          EOMMSG-NR := 2
          EOMMSG-TOKEN(1) := EOM-USER
          EOMMSG-FIELD-NAME := 'EOM-USER'
          ESCAPE ROUTINE
        ELSE
          FIND USERS WITH USER-ID = 'DEFAULT'
            EOM-USER-PROFILE := USER-PROFILE
            EOM-USER-TYPE := PROF-TYPE
          END-FIND
          ESCAPE BOTTOM(FNDUS.)
        END-IF
      END-NOREC
      EOM-USER-PROFILE := USER-PROFILE
      EOM-USER-TYPE := PROF-TYPE
    END-FIND
  END-IF
  RESET  EOM-OBJECT-NAME
  EOM-OBJTYP := 'H'
  IF EOM-USER-TYPE = 'A'
    EOM-OBJTYP-SECURITY (*) := 'Y'
  ELSE
    EOM-OBJTYP-SECURITY (*) := 'N'
    FOR #I = 1 TO 3
      COMPRESS #FUNCTION (#I) 'PO' TO #SECURITY-OPTION LEAVING NO
      RESET ALLOWED
      CALLNAT 'NARPSEC' EOM-USER-PROFILE #SECURITY-OPTION ALLOWED
      IF ALLOWED
        EOM-OBJTYP-SECURITY (#I:6) := 'Y'
        ESCAPE BOTTOM
      END-IF
    END-FOR
  END-IF
END-IF
RESET EOMPOM-EOF
IF EOM-FUNCTION = EOM-READ-NEXT OR = EOM-READHOLD-NEXT
  IF EOM-FUNCTION = EOM-READ-NEXT AND
      NOT (EOM-OBJTYP-SECURITY(1:4) = 'Y') OR
      EOM-FUNCTION = EOM-READHOLD-NEXT AND
      NOT (EOM-OBJTYP-SECURITY(1:3) = 'Y')
    EOMMSG-NR := 0020
    ESCAPE ROUTINE
  END-IF
  RESET EOM-OBJECT-NAME EOMPOM-EOF
  EOMPOM-EOF := 'X'
  #NEXT-ID := EOMPOM-I-ID
  ADD 1 TO #NEXT-ID
  READ PRINTOUT WITH PO-ID = #NEXT-ID
    IF PO-ID = 9999999
      RESET EOMPOM-I-ID
      ESCAPE BOTTOM
    END-IF
    IF EOM-USER-TYPE = 'A'
      EOM-OBJECT-SECURITY (*) := 'Y'
    END-IF
    RESET EOMPOM-EOF
    #PO-ID := PO-ID
    IF EOMPOM-EOF = ' '
      EOM-OBJECT-NAME := EOMPOM-I-ID-ALPHA := #PO-ID-A
      ESCAPE BOTTOM
    END-IF
  END-READ
END-IF
IF EOM-OBJECT-NAME NE EOMPOM-I-ID-ALPHA
    AND EOMPOM-EOF = ' '
  EOM-OBJECT-NAME := EOMPOM-I-ID-ALPHA
  IF EOM-USER-TYPE = 'A'
    EOM-OBJECT-SECURITY (*) := 'Y'
  ELSE
    EOM-OBJECT-SECURITY (*) := EOM-OBJTYP-SECURITY (*)
  END-IF
END-IF
*
IF NOT (EOM-OBJTYP-SECURITY (*) = 'Y') AND EOMPOM-EOF = ' '
  EOMMSG-NR := 0020
  ESCAPE ROUTINE
END-IF
*
END-SUBROUTINE /* SECURITY-CHECK
*
************************************************************************
DEFINE SUBROUTINE FUNCTION-SECURITY
************************************************************************
EXAMINE EOM-OBJECT-SECURITY (*) FOR 'Y' GIVING INDEX IN OJ
EXAMINE EOM-OBJTYP-SECURITY (*) FOR 'Y' GIVING INDEX IN OT
*
DECIDE ON FIRST EOMPOM-I-CHECK-FUNCTION
  VALUE EOM-SECURITY-CHECK, EOM-COMMIT, EOM-BACKOUT
    IGNORE
  VALUE EOM-ADD,EOM-READHOLD,EOM-MODIFY,EOM-INIT, EOM-COPY, EOM-RENAME,
      EOM-READHOLD-NEXT
    IF OJ > 3 OR OT > 3
      EOMMSG-NR := 0020
    END-IF
  VALUE EOM-READ, EOM-READ-NEXT, EOM-HOLD-PRINT, EOM-RELEASE,
      EOM-RESTART-PRINT
    IF OJ > 4 OR OT > 4
      EOMMSG-NR := 0020
    END-IF
  VALUE EOM-DELETE
    IF OJ > 2 OR OT > 2
      EOMMSG-NR := 0020
    END-IF
  NONE VALUE
    EOMMSG-NR := 2600
END-DECIDE
*
END-SUBROUTINE /* FUNCTION-SECURITY
*
************************************************************************
DEFINE SUBROUTINE READ-PRINTOUT-ATTRIBUTES
************************************************************************
IF EOM-OBJTYP-SECURITY (3) = 'N' OR EOM-OBJECT-SECURITY (3) = 'N'
  EOMMSG-NR := 0020
  ESCAPE ROUTINE
END-IF
IF EOMPOM-I-ID  EQ 0
  ESCAPE ROUTINE IMMEDIATE
END-IF
RESET #MSG-NR #MSG-TXT
FIND PRINTOUT WITH PO-ID = EOMPOM-I-ID
  IF PO-BUNDLE = ' '
    #MSG-NR := ##TXT-REPORT
  ELSE
    #MSG-NR := ##TXT-BUNDLE
  END-IF
  PERFORM GET-MESSAGE
  EOMPOM-TYPE-TEXT := #MSG-TXT
*
  RESET #MSG-TXT
  DECIDE ON FIRST VALUE PO-LANGUAGE
    VALUE  1
      #MSG-NR := ##TXT-ENGLISH
    VALUE  2
      #MSG-NR := ##TXT-GERMAN
    NONE
      #MSG-NR := ##TXT-ENGLISH
      EOMPOM-LANGUAGE := 1
  END-DECIDE
  PERFORM GET-MESSAGE
  EOMPOM-LANGUAGE-TEXT := #MSG-TXT
END-FIND
PERFORM PRINTOUT-ATTRIBUTE-INTERFACE
*
END-SUBROUTINE /* READ-PRINTOUT-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE GET-MESSAGE
************************************************************************
SATMS-GET-ERROR-TYPE := 'U'
SATMS-GET-ERROR-CODE := #MSG-NR
SATMS-GET-LANGUAGE := EOM-LANGUAGE
SATMS-GET-ERROR-APPL := EOM-LIBRARY
SATMS-GET-MSG-DYNA(1:3) := EOMMSG-TOKEN(1:3)
CALLNAT SAT-GET-ERROR-TEXT SAT-CURRENT-VERSION SATMS-PARMS (*)
IF SATMS-ERROR-CODE = 0
  #MSG-TXT := SATMS-GET-SHORT-TEXT
ELSE
  #MSG-TXT := 'Text not found'
END-IF
*
END-SUBROUTINE /* GET-MESSAGE
*
************************************************************************
DEFINE SUBROUTINE MODIFY-PRINTOUT-ATTRIBUTES
************************************************************************
IF EOM-OBJTYP-SECURITY (2) = 'N' OR EOM-OBJECT-SECURITY (2) = 'N'
  EOMMSG-NR := 0020
  ESCAPE ROUTINE
END-IF
*
IF EOMPOM-I-ID EQ 0
  ESCAPE ROUTINE IMMEDIATE
END-IF

PERFORM VALIDATE-FUNCTION
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
*
PERFORM VALIDATION
IF EOMMSG-NR = 0
  PERFORM PRINTOUT-ATTRIBUTE-INTERFACE
END-IF
*
END-SUBROUTINE /* MODIFY-PRINTOUT-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-FUNCTION
************************************************************************
FIND PRINTOUT WITH PO-ID = EOMPOM-I-ID
  #PRINTER-TYPE := PO-PRINTER-TYPE
END-FIND
DECIDE ON FIRST VALUE OF EOM-FUNCTION
  VALUE EOM-MODIFY
    IF NOT (PRINTOUT.PO-STATUS = 'H' OR = 'R' )
      EOMMSG-NR := 0705    /* can not modify
      ESCAPE ROUTINE
    END-IF
  VALUE EOM-HOLD-PRINT
    IF PRINTOUT.PO-STATUS = 'H'
      EOMMSG-NR := 0702          /* already in hold status
      ESCAPE ROUTINE
    END-IF
    IF PRINTOUT.PO-STATUS = 'C'
      EOMMSG-NR := 0020
      ESCAPE ROUTINE
    END-IF
  VALUE EOM-RELEASE
    IF PRINTOUT.PO-STATUS NE 'H'
      EOMMSG-NR := 0703
      ESCAPE ROUTINE
    END-IF
    PERFORM CHECK-PRINTER-TYPE
    IF EOMMSG-NR NE 0
      ESCAPE ROUTINE
    END-IF
  VALUE EOM-RESTART-PRINT
    IF PRINTOUT.PO-BUNDLE > ' '
      EOMMSG-NR := 0723
      ESCAPE ROUTINE
    END-IF
    IF PRINTOUT.PO-STATUS NE 'E'
      EOMMSG-NR := 0724
      ESCAPE ROUTINE
    END-IF
    PERFORM CHECK-PRINTER-TYPE
    IF EOMMSG-NR NE 0
      ESCAPE ROUTINE
    END-IF
  NONE VALUE IGNORE
END-DECIDE
*
END-SUBROUTINE /* VALIDATE-FUNCTION
*
************************************************************************
DEFINE SUBROUTINE VALIDATION
************************************************************************
DECIDE ON FIRST EOMPOM-I-ATTRIBUTE-TYPE
  VALUE PRINTOUT-GENERAL-ATTRIBUTES  IGNORE
  VALUE PRINTOUT-PRINTER-ATTRIBUTES PERFORM VALIDATE-PRINTING-ATTRIBUTES
  VALUE PRINTOUT-SPECIAL-ATTRIBUTES PERFORM VALIDATE-SPECIAL-ATTRIBUTES
  NONE  IGNORE
END-DECIDE
*
END-SUBROUTINE /* VALIDATION
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-PRINTING-ATTRIBUTES
************************************************************************
DECIDE FOR EVERY CONDITION
  WHEN NOT(EOMPOM-PRINTER-TYPE=##PHYS-VTAM OR=##PHYS-NAF OR=##PHYS-EMAIL
      OR=##PHYS-CMASPOOL OR=##PHYS-UNIXLP OR=##PHYS-NATUNIX
      OR=##PHYS-DISKUNIX OR=##PHYS-WRTSPOOL OR=##PHYS-DUMMY)
    IF EOMPOM-JCL-SKELETON > ' '
      CALLNAT 'N-CHKSRC' EOM-USER-LIBRARY EOMPOM-JCL-SKELETON #EXIST
      IF NOT #EXIST
        EOMMSG-NR := 0117            /* 'Skeleton does not exist'
        EOMMSG-FIELD-NAME := 'EOMPOM-JCL-SKELETON'
        ESCAPE ROUTINE
      END-IF
    ELSE
      IF NOT (EOMPOM-PRINTER-TYPE = ##PHYS-UNIXLP OR = ##PHYS-NATUNIX
          OR = ##PHYS-DISKUNIX OR = ##PHYS-WRTSPOOL)
        RESET EOMPOM-JOBCARD (*)
      END-IF
      EOMMSG-NR := 2126            /* Job skeleton required
      EOMMSG-FIELD-NAME := 'EOMPOM-JCL-SKELETON'
      ESCAPE ROUTINE
    END-IF
    IF EOMPOM-ESCAPE-CHAR = ' '
      EOMMSG-NR := 0186                  /* Escape char required
      EOMMSG-FIELD-NAME := 'EOMPOM-ESCAPE-CHAR'
      ESCAPE ROUTINE
    END-IF
    IF EOMPOM-ESCAPE-CHAR  = MASK (A) OR = MASK (N)
      EOMMSG-NR := 0115                 /* Invalid escape char
      EOMMSG-FIELD-NAME := 'EOMPOM-ESCAPE-CHAR'
      ESCAPE ROUTINE
    END-IF
  WHEN (EOMPOM-PRINTER-TYPE =##PHYS-VTAM OR=##PHYS-NAF OR=##PHYS-EMAIL
  OR=##PHYS-CMASPOOL OR=##PHYS-UNIXLP OR=##PHYS-NATUNIX               /*
  OR=##PHYS-DISKUNIX OR=##PHYS-WRTSPOOL OR=##PHYS-DUMMY)              /*
    IF EOMPOM-JCL-SKELETON > ' '
      EOMMSG-NR := 0184     /* Skeleton not needed for this printer type
      EOMMSG-FIELD-NAME := 'EOMPOM-JCL-SKELETON'
      RESET EOMPOM-JCL-SKELETON
      ESCAPE ROUTINE
    END-IF
    IF EOMPOM-ESCAPE-CHAR >  ' '
      EOMMSG-NR := 0185             /* Escape char not necessary
      EOMMSG-FIELD-NAME := 'EOMPOM-ESCAPE-CHAR'
      RESET EOMPOM-ESCAPE-CHAR
      ESCAPE ROUTINE
    END-IF
  WHEN EOMPOM-PRINTER-TYPE = 'VTAM'
    RESET EOMPOM-JCL-SKELETON EOMPOM-ESCAPE-CHAR
  WHEN NONE IGNORE
END-DECIDE
END-SUBROUTINE /* VALIDATE-PRINTING-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE CHECK-PRINTER-TYPE
************************************************************************
IF *MACHINE-CLASS = 'MAINFRAME'
  IF PRINTOUT.PO-PRINTER-TYPE = ##PHYS-NATUNIX
    EOMMSG-NR := 0130
  END-IF
ELSE
  IF NOT(PRINTOUT.PO-PRINTER-TYPE = ##PHYS-DISKUNIX OR = ##PHYS-NATUNIX)
    EOMMSG-NR := 0131
  END-IF
END-IF
*
END-SUBROUTINE /* CHECK-PRINTER-TYPE
*
************************************************************************
DEFINE SUBROUTINE VALIDATE-SPECIAL-ATTRIBUTES
************************************************************************
CALLNAT 'EOMPHATN' #PRINTER-TYPE EOMPOM-ATTRIBUTES-OCC-MAX
  EOMPOM-ATTRIBUTES (*) EOMMSG-PARMS
*
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
*
FOR #I 1 25
  IF EOMPOM-ATTR-VAR (#I) = ' '
    ESCAPE TOP
  END-IF
  IF EOMPOM-ATTR-VAR     (#I) = 'DCB1' OR = 'DCB2'
    EXAMINE EOMPOM-ATTR-VALUE(#I) FOR 'RECFM' GIVING POSITION #J
    IF #J GT 0
      #J:= #J + 6
      #FIX-VAR := SUBSTRING (EOMPOM-ATTR-VALUE(#I),#J,1)
    END-IF
  END-IF
  IF EOMPOM-ATTR-VAR     (#I) = 'RECFM'
    IF EOMPOM-ATTR-VALUE(#I) NE ' '
      #FIX-VAR := EOMPOM-ATTR-VALUE (#I)
    END-IF
  END-IF
  IF EOMPOM-ATTR-VAR     (#I) = 'WKF'
    IF #FIX-VAR = 'V' OR = 'v' OR = ' '
      EOMPOM-ATTR-VALUE (#I) := '01'
    ELSE
      EOMPOM-ATTR-VALUE (#I) := '02'
    END-IF
  END-IF
END-FOR
*
IF NOT #FIX-VAR = 'V' OR = 'v' OR = ' '
  EXAMINE EOMPOM-ATTR-VAR(*) FOR 'LRECL' GIVING INDEX IN #I
  IF #I GT 0
    #LRECL:= EOMPOM-ATTR-VALUE(#I)
  END-IF
  IF #LRECL = ' '
    EXAMINE EOMPOM-ATTR-VAR(*) FOR 'DCB1' GIVING INDEX IN #I
    IF #I GT 0
      EXAMINE EOMPOM-ATTR-VALUE(#I) FOR 'LRECL=' GIVING POSITION IN #J
      IF #J GT 0
        #J:= #J + 6
        #K:= 73 - #J
        IF #K GT 5
          #K:= 5
        END-IF
        MOVE SUBSTRING (EOMPOM-ATTR-VALUE(#I), #J, #K) TO #LRECL
        FOR #K = 1 TO 5
          IF NOT #LRECL-A1(#K) IS (N1)
            RESET #LRECL-A1(#K)
          END-IF
        END-FOR
      END-IF
    END-IF
    IF #LRECL = ' '
      EXAMINE EOMPOM-ATTR-VAR(*) FOR 'DCB2' GIVING INDEX IN #I
      IF #I GT 0
        EXAMINE EOMPOM-ATTR-VALUE(#I) FOR 'LRECL=' GIVING POSITION IN #J
        IF #J GT 0
          #J:= #J + 6
          #K:= 73 - #J
          IF #K GT 5
            #K:= 5
          END-IF
          MOVE SUBSTRING (EOMPOM-ATTR-VALUE(#I), #J, #K) TO #LRECL
          FOR #K = 1 TO 5
            IF NOT #LRECL-A1(#K) IS (N1)
              RESET #LRECL-A1(#K)
            END-IF
          END-FOR
        END-IF
      END-IF
    END-IF
  END-IF
  IF #LRECL NE ' '
    IF #LRECL IS (N5)
      #LRECL-N:= VAL(#LRECL)
      IF #LRECL-N GT 0 AND #LRECL-N LT 251
        EOMMSG-NR:= 0107
      END-IF
    END-IF
  END-IF
END-IF
*
END-SUBROUTINE /* VALIDATE-SPECIAL-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE DELETE-PRINTOUT-DEFINITION
************************************************************************
IF EOM-OBJTYP-SECURITY (1) = 'N' OR EOM-OBJECT-SECURITY (1) = 'N'
  EOMMSG-NR := 0020
  ESCAPE ROUTINE
END-IF
IF EOMPOM-I-ID  EQ 0
  ESCAPE ROUTINE IMMEDIATE
END-IF
CALLNAT 'EOMPOMVN' EOM-PARMS EOMPOM-PARMS EOMMSG-PARMS
*
END-SUBROUTINE /* DELETE-PRINTOUT-DEFINITION
*
************************************************************************
DEFINE SUBROUTINE HOLD-RELEASE-RESTART
************************************************************************
PERFORM VALIDATE-FUNCTION
IF EOMMSG-NR NE 0
  ESCAPE ROUTINE
END-IF
IF EOMPOM-I-ID  EQ 0
  ESCAPE ROUTINE IMMEDIATE
END-IF
CALLNAT 'EOMPOMVN' EOM-PARMS EOMPOM-PARMS EOMMSG-PARMS
*
END-SUBROUTINE /* HOLD-RELEASE-RESTART
*
************************************************************************
DEFINE SUBROUTINE PRINTOUT-ATTRIBUTE-INTERFACE
************************************************************************
DECIDE ON FIRST EOMPOM-I-ATTRIBUTE-TYPE
  VALUE PRINTOUT-GENERAL-ATTRIBUTES
    CALLNAT 'EOMPOMGN' EOM-FUNCTION EOMPOM-PARMS EOMMSG-PARMS
  VALUE PRINTOUT-PRINTER-ATTRIBUTES
    CALLNAT 'EOMPOMPN' EOM-FUNCTION EOMPOM-PARMS EOMMSG-PARMS
  VALUE PRINTOUT-SPECIAL-ATTRIBUTES
    CALLNAT 'EOMPOMSN' EOM-FUNCTION EOMPOM-PARMS EOMMSG-PARMS
  NONE  IGNORE
END-DECIDE
*
END-SUBROUTINE /* PRINTOUT-ATTRIBUTE-INTERFACE
*
END
