* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* NORPFN-N - Find Report Definitions(s) and build a RETAIN SET
*            Filter for NGC
*
* Maintenance
* XSETHZ  2009-02-02 P(311768) created
* CF1     2017-10-05 NOMALL-2077 Multi-node filter criteria
* CF2     2019-10-21 NOMALL-2282 Search criteria UNIX attributes
* HEB1    2023-10-19 ES-34375    active help for keyword + and/or
* SU1     2024-03-07 ES-34613    NOM 3.6 Remove power
* ----------------------------------------------------------------------
DEFINE DATA
PARAMETER USING NORPSL-A
PARAMETER
1 #P-RETAIN-SET              (A16)
1 #P-NUMBER                  (N4)
************************************************************************
LOCAL USING EOMRPM-E
LOCAL
1 REPORT VIEW OF NRM-REPORTS-NEW
*
1 #F-REPNAME                   (A25)
1 #F-MASTER                    (A25)
1 #F-DIST                      (A8)
1 #F-PRINTER                   (A11)
1 #F-IDENT-JOBNAME             (A8)
1 #F-IDENT-WRITER              (A8)
1 #F-IDENT-DESTINATION         (A8)
1 #F-IDENT-FORM                (A6)
1 #F-IDENT-USER-ID             (A8)
1 #F-IDENT-LIBRARY             (A8)              /* CF2 ->
1 #F-IDENT-FORM8               (A8)
1 #F-IDENT-UNIX-FILE           (A50)
1 #F-IDENT-UNIX-PATH           (A72)             /* CF2 <-
1 REDEFINE #F-IDENT-UNIX-PATH
  2 #F-IDENT-UNIX-PATH-TYPE    (I2)
  2 #F-IDENT-UNIX-PATH-VALUE   (A70)
*
1 #T-REPNAME                   (A25)
1 #T-MASTER                    (A25)
1 #T-DIST                      (A8)
1 #T-PRINTER                   (A11)
1 #T-IDENT-JOBNAME             (A8)
1 #T-IDENT-WRITER              (A8)
1 #T-IDENT-DESTINATION         (A8)
1 #T-IDENT-FORM                (A6)
1 #T-IDENT-USER-ID             (A8)
1 #T-IDENT-LIBRARY             (A8)              /* CF2 ->
1 #T-IDENT-FORM8               (A8)
1 #T-IDENT-UNIX-FILE           (A50)
1 #T-IDENT-UNIX-PATH           (A72)             /* CF2 <-
1 REDEFINE #T-IDENT-UNIX-PATH
  2 #T-IDENT-UNIX-PATH-TYPE    (I2)
  2 #T-IDENT-UNIX-PATH-VALUE   (A70)
*
1 #F-IDENT                     (A10)
1 REDEFINE #F-IDENT
  2 #F-IDENT-TYPE              (I2)
  2 #F-IDENT-VALUE             (A8)
1 #T-IDENT                     (A10)
1 REDEFINE #T-IDENT
  2 #T-IDENT-TYPE              (I2)
  2 #T-IDENT-VALUE             (A8)
*
1 #A253                        (A253)
*
1 #REPORT-IDENT-JOB-NAME       (I2)
1 #REPORT-IDENT-WRITER         (I2)
1 #REPORT-IDENT-DESTINATION    (I2)
1 #REPORT-IDENT-FORM           (I2)
1 #REPORT-IDENT-USER-ID        (I2)
1 #REPORT-IDENT-LIBRARY        (I2)              /* CF2
1 #REPORT-IDENT-FORM8          (I2)              /* CF2
*
1 #NO-FILTER-PARMS             (L)               /* CF2
*
1 #I2                          (I2)              /* HEB1
1 #F-KY                        (A15/1:2)         /* HEB1
1 #T-KY                        (A15/1:2)         /* HEB1
1 #L-15                        (N3) INIT <15>    /* HEB1
1 #FIRST                       (L)               /* HEB1
*
END-DEFINE
*
RESET #P-NUMBER
RELEASE SET #P-RETAIN-SET
#A253 := #NORPSL
* EXAMINE SUBSTRING(#A253,1,25) FOR '*' DELETE     CF2
* EXAMINE SUBSTRING(#A253,43,211) FOR '*' DELETE   CF2
*
DECIDE ON FIRST VALUE #NORPSL.#SPOOL-TYPE
/*SU1  VALUE 'POW'
  VALUE 'BS2'
    #REPORT-IDENT-JOB-NAME      := REPORT-IDENT-BS2-JOB-NAME
    #REPORT-IDENT-WRITER        := 0
    #REPORT-IDENT-DESTINATION   := 0
    #REPORT-IDENT-FORM          := REPORT-IDENT-BS2-FORM
    #REPORT-IDENT-USER-ID       := REPORT-IDENT-BS2-USER-ID
    #REPORT-IDENT-LIBRARY       := 0
    #REPORT-IDENT-FORM8         := 0
  VALUE 'JES'                                              /* CF2 ->
    #REPORT-IDENT-JOB-NAME      := REPORT-IDENT-JES-JOB-NAME
    #REPORT-IDENT-WRITER        := REPORT-IDENT-JES-WRITER
    #REPORT-IDENT-DESTINATION   := REPORT-IDENT-JES-DESTINATION
    #REPORT-IDENT-FORM          := REPORT-IDENT-JES-FORM
    #REPORT-IDENT-USER-ID       := 0
    #REPORT-IDENT-LIBRARY       := 0
    #REPORT-IDENT-FORM8         := 0
  VALUE 'NAF'
    #REPORT-IDENT-USER-ID       := REPORT-IDENT-NAF-USER-ID
    #REPORT-IDENT-JOB-NAME      := REPORT-IDENT-NAF-REPORT-NAME
    #REPORT-IDENT-WRITER        := REPORT-IDENT-NAF-PROFILE
    #REPORT-IDENT-DESTINATION   := REPORT-IDENT-NAF-NATPGM
    #REPORT-IDENT-LIBRARY       := REPORT-IDENT-NAF-NATLIB
    #REPORT-IDENT-FORM8         := REPORT-IDENT-NAF-FORM
    #REPORT-IDENT-FORM          := 0
  VALUE 'CMA'
    #REPORT-IDENT-JOB-NAME      := REPORT-IDENT-CMA-FILE-NAME
    #REPORT-IDENT-WRITER        := REPORT-IDENT-CMA-WRITER
    #REPORT-IDENT-DESTINATION   := 0
    #REPORT-IDENT-FORM          := REPORT-IDENT-CMA-FORM
    #REPORT-IDENT-USER-ID       := REPORT-IDENT-CMA-USER-ID
    #REPORT-IDENT-LIBRARY       := 0
    #REPORT-IDENT-FORM8         := 0
  ANY                 /* POWER, BS2000, JES, CMA, NAF
    #F-IDENT-JOBNAME            := #NORPSL.#IDENT-JOBNAME
    #F-IDENT-WRITER             := #NORPSL.#IDENT-WRITER
    #F-IDENT-DESTINATION        := #NORPSL.#IDENT-DESTINATION
    #F-IDENT-FORM               := #NORPSL.#IDENT-FORM
    #F-IDENT-USER-ID            := #NORPSL.#IDENT-USER-ID
    #F-IDENT-LIBRARY            := #NORPSL.#IDENT-LIBRARY
    #F-IDENT-FORM8              := #NORPSL.#IDENT-FORM8
    EXAMINE #F-IDENT-JOBNAME     FOR '*' DELETE
    EXAMINE #F-IDENT-WRITER      FOR '*' DELETE
    EXAMINE #F-IDENT-DESTINATION FOR '*' DELETE
    EXAMINE #F-IDENT-FORM        FOR '*' DELETE
    EXAMINE #F-IDENT-USER-ID     FOR '*' DELETE
    EXAMINE #F-IDENT-LIBRARY     FOR '*' DELETE
    EXAMINE #F-IDENT-FORM8       FOR '*' DELETE
    COMPRESS #F-IDENT-JOBNAME H'FF' TO #T-IDENT-JOBNAME LEAVING NO
    COMPRESS #F-IDENT-WRITER H'FF'  TO #T-IDENT-WRITER LEAVING NO
    COMPRESS #F-IDENT-DESTINATION H'FF'
      TO #T-IDENT-DESTINATION LEAVING NO
    COMPRESS #F-IDENT-FORM H'FF'    TO #T-IDENT-FORM LEAVING NO
    COMPRESS #F-IDENT-USER-ID H'FF' TO #T-IDENT-USER-ID LEAVING NO
    COMPRESS #F-IDENT-LIBRARY H'FF' TO #T-IDENT-LIBRARY LEAVING NO
    COMPRESS #F-IDENT-FORM8 H'FF'   TO #T-IDENT-FORM8 LEAVING NO
  NONE                /* UNIX
    #F-IDENT-UNIX-PATH-TYPE     := REPORT-IDENT-UNIX-PATH
    #T-IDENT-UNIX-PATH-TYPE     := REPORT-IDENT-UNIX-PATH
    #F-IDENT-UNIX-PATH-VALUE    := #NORPSL.#IDENT-UNIX-PATH
    EXAMINE #F-IDENT-UNIX-PATH-VALUE  FOR '*' DELETE
    COMPRESS #F-IDENT-UNIX-PATH-VALUE H'FF'
      TO #T-IDENT-UNIX-PATH-VALUE LEAVING NO
    /*
*     #F-IDENT-UNIX-FILE          := #NORPSL.#IDENT-UNIX-FILE
*     EXAMINE #F-IDENT-UNIX-FILE  FOR '*' DELETE
*     COMPRESS #F-IDENT-UNIX-FILE H'FF'
*           TO #T-IDENT-UNIX-FILE LEAVING NO
    /*
    #REPORT-IDENT-JOB-NAME      := 0
    #REPORT-IDENT-WRITER        := 0
    #REPORT-IDENT-DESTINATION   := 0
    #REPORT-IDENT-FORM          := 0
    #REPORT-IDENT-USER-ID       := 0
    #REPORT-IDENT-LIBRARY       := 0
    #REPORT-IDENT-FORM8         := 0                       /* CF2 <-
END-DECIDE
*
#F-REPNAME := #NORPSL.#NAME
#F-MASTER  := #NORPSL.#MASTER-REPNAME
#F-DIST    := #NORPSL.#DISTRIBUTE-TO
#F-PRINTER := #NORPSL.#PRINTER
*
EXAMINE #F-REPNAME FOR '*' DELETE
EXAMINE #F-MASTER FOR '*' DELETE
EXAMINE #F-DIST FOR '*' DELETE
EXAMINE #F-PRINTER FOR '*' DELETE
*
COMPRESS #F-REPNAME H'FF' TO #T-REPNAME LEAVING NO
COMPRESS #F-MASTER H'FF' TO #T-MASTER LEAVING NO
COMPRESS #F-DIST H'FF' TO #T-DIST LEAVING NO
COMPRESS #F-PRINTER H'FF' TO #T-PRINTER LEAVING NO
*
/* Check if any of the filter parameters, evaluated herein,
/* are set. If not, get all records and do post-selection
/* in the calling routine (NORPLS-N).
#NO-FILTER-PARMS := TRUE
IF #F-MASTER            NE ' ' OR #F-DIST              NE ' ' OR
    #F-PRINTER           NE ' ' OR #NORPSL.#KEYWORDS(*) NE ' ' OR
    #F-IDENT-JOBNAME     NE ' ' OR #F-IDENT-WRITER      NE ' ' OR
    #F-IDENT-USER-ID     NE ' ' OR #F-IDENT-FORM        NE ' ' OR
    #F-IDENT-LIBRARY     NE ' ' OR #F-IDENT-FORM8       NE ' ' OR
    #F-IDENT-DESTINATION NE ' ' OR #F-IDENT-UNIX-PATH-VALUE NE ' '
  RESET #NO-FILTER-PARMS
END-IF
*
DECIDE FOR EVERY CONDITION
*  WHEN #F-REPNAME NE ' ' OR SUBSTRING(#A253,43,169) = ' ' /* CF1 CF2
  WHEN #F-REPNAME NE ' ' OR #NO-FILTER-PARMS                   /* CF2
*        (SUBSTRING(#A253,43,101) = ' ' AND #IDENT-PART = ' ')   /* CF2
    FND12. FIND NUMBER REPORT
      WITH R-REPNAME = #F-REPNAME THRU #T-REPNAME
      RETAIN AS #P-RETAIN-SET
    #P-NUMBER := *NUMBER (FND12.)
    IF #P-NUMBER = 0
      ESCAPE ROUTINE
    END-IF
  WHEN #F-MASTER  NE ' '
    IF #P-NUMBER = 0
      FND21. FIND NUMBER REPORT
        WITH R-MASTER-REPNAME = #F-MASTER THRU #T-MASTER
        RETAIN AS #P-RETAIN-SET
      #P-NUMBER := *NUMBER (FND21.)
    ELSE
      FND22. FIND NUMBER REPORT
        WITH R-MASTER-REPNAME = #F-MASTER THRU #T-MASTER
        AND #P-RETAIN-SET
        RETAIN AS #P-RETAIN-SET
      #P-NUMBER := *NUMBER (FND22.)
    END-IF
    IF #P-NUMBER = 0
      ESCAPE ROUTINE
    END-IF
  WHEN #NORPSL.#KEYWORDS(*) NE ' '
    RELEASE SET 'TSERKY01'                            /* HEB1 > ++
    #FIRST := TRUE
    FOR #I2= 1 TO 2
      /* Activate next 2 lines => Keyword prefix search
      /* COMPRESS #NORPSL.#KEYWORDS (#I2) '*'
      /*     INTO #NORPSL.#KEYWORDS (#I2) LEAVING NO
      CALLNAT 'SELALPHA' #NORPSL.#KEYWORDS (#I2) #F-KY (#I2)
        #T-KY (#I2) #L-15
    END-FOR
    FOR #I2= 1 TO 2
      IF #NORPSL.#KEYWORDS (#I2) =' ' OR='*'
        ESCAPE TOP
      END-IF
      IF #FIRST
        RESET #FIRST
        KW0. FIND NUMBER REPORT
          WITH R-KEYWORDS = #F-KY(#I2) THRU #T-KY(#I2)
          RETAIN AS 'TSERKY01'
        ESCAPE TOP
      END-IF
      IF #KEYWORD-AND-OR = 'A'
        KWA. FIND NUMBER REPORT WITH 'TSERKY01'
          AND R-KEYWORDS =#F-KY(#I2) THRU #T-KY(#I2)
          RETAIN AS 'TSERKY01'
      ELSE /* OR
        KWO. FIND NUMBER REPORT WITH 'TSERKY01'
          OR R-KEYWORDS = #F-KY(#I2) THRU #T-KY(#I2)
          RETAIN AS 'TSERKY01'
      END-IF
    END-FOR
    IF NOT #FIRST
      IF #P-NUMBER > 0
        KY1. FIND NUMBER REPORT WITH 'TSERKY01'
          AND #P-RETAIN-SET
          RETAIN AS #P-RETAIN-SET
        #P-NUMBER := *NUMBER (KY1.)
      ELSE
        KY2. FIND NUMBER REPORT WITH 'TSERKY01'
          RETAIN AS #P-RETAIN-SET
        #P-NUMBER := *NUMBER (KY2.)
      END-IF
      RELEASE SET 'TSERKY01'
      IF #P-NUMBER = 0
        ESCAPE ROUTINE
      END-IF
    END-IF                                            /* HEB1 <
*   IF #P-NUMBER = 0                                  /* HEB1 > --
*     FND31. FIND NUMBER REPORT
*              WITH R-KEYWORDS = #NORPSL.#KEYWORDS(1)
*                           OR = #NORPSL.#KEYWORDS(2)
*              RETAIN AS #P-RETAIN-SET
*     #P-NUMBER := *NUMBER (FND31.)
*   ELSE
*     FND32. FIND NUMBER REPORT
*              WITH R-KEYWORDS = #NORPSL.#KEYWORDS(1)
*                           OR = #NORPSL.#KEYWORDS(2)
*              AND #P-RETAIN-SET
*              RETAIN AS #P-RETAIN-SET
*     #P-NUMBER := *NUMBER (FND32.)
*   END-IF
*   IF #P-NUMBER = 0
*     ESCAPE ROUTINE
*   END-IF                                            /* HEB1 <
  WHEN #F-DIST NE ' '
    IF #P-NUMBER = 0
      FND41. FIND NUMBER REPORT
        WITH R-NATRPT-DIST = #F-DIST THRU #T-DIST
        RETAIN AS #P-RETAIN-SET
      #P-NUMBER := *NUMBER (FND41.)
    ELSE
      FND42. FIND NUMBER REPORT
        WITH R-NATRPT-DIST = #F-DIST THRU #T-DIST
        AND #P-RETAIN-SET
        RETAIN AS #P-RETAIN-SET
      #P-NUMBER := *NUMBER (FND42.)
    END-IF
    IF #P-NUMBER = 0
      ESCAPE ROUTINE
    END-IF
  WHEN #F-PRINTER NE ' '
    IF #P-NUMBER = 0
      FND51. FIND NUMBER REPORT
        WITH R-PRINTERS = #F-PRINTER THRU #T-PRINTER
        RETAIN AS #P-RETAIN-SET
      #P-NUMBER := *NUMBER (FND51.)
    ELSE
      FND52. FIND NUMBER REPORT
        WITH R-PRINTERS = #F-PRINTER THRU #T-PRINTER
        AND #P-RETAIN-SET
        RETAIN AS #P-RETAIN-SET
      #P-NUMBER := *NUMBER (FND52.)
    END-IF
    IF #P-NUMBER = 0
      ESCAPE ROUTINE
    END-IF
  WHEN #F-IDENT-JOBNAME NE ' '
    #F-IDENT-TYPE  := #REPORT-IDENT-JOB-NAME
    #T-IDENT-TYPE  := #REPORT-IDENT-JOB-NAME
    #F-IDENT-VALUE := #F-IDENT-JOBNAME
    #T-IDENT-VALUE := #T-IDENT-JOBNAME
    IF #P-NUMBER = 0
      FND61. FIND NUMBER REPORT
        WITH R-IDENT = #F-IDENT THRU #T-IDENT
        RETAIN AS #P-RETAIN-SET
      #P-NUMBER := *NUMBER (FND61.)
    ELSE
      FND62. FIND NUMBER REPORT
        WITH R-IDENT = #F-IDENT THRU #T-IDENT
        AND #P-RETAIN-SET
        RETAIN AS #P-RETAIN-SET
      #P-NUMBER := *NUMBER (FND62.)
    END-IF
    IF #P-NUMBER = 0
      ESCAPE ROUTINE
    END-IF
  WHEN #F-IDENT-WRITER NE ' '
    #F-IDENT-TYPE  := #REPORT-IDENT-WRITER
    #T-IDENT-TYPE  := #REPORT-IDENT-WRITER
    #F-IDENT-VALUE := #F-IDENT-WRITER
    #T-IDENT-VALUE := #T-IDENT-WRITER
    IF #P-NUMBER = 0
      FND71. FIND NUMBER REPORT
        WITH R-IDENT = #F-IDENT THRU #T-IDENT
        RETAIN AS #P-RETAIN-SET
      #P-NUMBER := *NUMBER (FND71.)
    ELSE
      FND72. FIND NUMBER REPORT
        WITH R-IDENT = #F-IDENT THRU #T-IDENT
        AND #P-RETAIN-SET
        RETAIN AS #P-RETAIN-SET
      #P-NUMBER := *NUMBER (FND72.)
    END-IF
    IF #P-NUMBER = 0
      ESCAPE ROUTINE
    END-IF
  WHEN #F-IDENT-DESTINATION NE ' '
    #F-IDENT-TYPE  := #REPORT-IDENT-DESTINATION
    #T-IDENT-TYPE  := #REPORT-IDENT-DESTINATION
    #F-IDENT-VALUE := #F-IDENT-DESTINATION
    #T-IDENT-VALUE := #T-IDENT-DESTINATION
    IF #P-NUMBER = 0
      FND81. FIND NUMBER REPORT
        WITH R-IDENT = #F-IDENT THRU #T-IDENT
        RETAIN AS #P-RETAIN-SET
      #P-NUMBER := *NUMBER (FND81.)
    ELSE
      FND82. FIND NUMBER REPORT
        WITH R-IDENT = #F-IDENT THRU #T-IDENT
        AND #P-RETAIN-SET
        RETAIN AS #P-RETAIN-SET
      #P-NUMBER := *NUMBER (FND82.)
    END-IF
    IF #P-NUMBER = 0
      ESCAPE ROUTINE
    END-IF
  WHEN #F-IDENT-FORM NE ' '
    #F-IDENT-TYPE  := #REPORT-IDENT-FORM
    #T-IDENT-TYPE  := #REPORT-IDENT-FORM
    #F-IDENT-VALUE := #F-IDENT-FORM
    #T-IDENT-VALUE := #T-IDENT-FORM
    IF #P-NUMBER = 0
      FND91. FIND NUMBER REPORT
        WITH R-IDENT = #F-IDENT THRU #T-IDENT
        RETAIN AS #P-RETAIN-SET
      #P-NUMBER := *NUMBER (FND91.)
    ELSE
      FND92. FIND NUMBER REPORT
        WITH R-IDENT = #F-IDENT THRU #T-IDENT
        AND #P-RETAIN-SET
        RETAIN AS #P-RETAIN-SET
      #P-NUMBER := *NUMBER (FND92.)
    END-IF
    IF #P-NUMBER = 0
      ESCAPE ROUTINE
    END-IF
  WHEN #F-IDENT-USER-ID NE ' '
    #F-IDENT-TYPE  := #REPORT-IDENT-USER-ID
    #T-IDENT-TYPE  := #REPORT-IDENT-USER-ID
    #F-IDENT-VALUE := #F-IDENT-USER-ID
    #T-IDENT-VALUE := #T-IDENT-USER-ID
    IF #P-NUMBER = 0
      FND01. FIND NUMBER REPORT
        WITH R-IDENT = #F-IDENT THRU #T-IDENT
        RETAIN AS #P-RETAIN-SET
      #P-NUMBER := *NUMBER (FND01.)
    ELSE
      FND02. FIND NUMBER REPORT
        WITH R-IDENT = #F-IDENT THRU #T-IDENT
        AND #P-RETAIN-SET
        RETAIN AS #P-RETAIN-SET
      #P-NUMBER := *NUMBER (FND02.)
    END-IF
    IF #P-NUMBER = 0
      ESCAPE ROUTINE
    END-IF
  WHEN #F-IDENT-LIBRARY NE ' '                             /* CF2 ->
    #F-IDENT-TYPE  := #REPORT-IDENT-LIBRARY
    #T-IDENT-TYPE  := #REPORT-IDENT-LIBRARY
    #F-IDENT-VALUE := #F-IDENT-LIBRARY
    #T-IDENT-VALUE := #T-IDENT-LIBRARY
    IF #P-NUMBER = 0
      FND93. FIND NUMBER REPORT
        WITH R-IDENT = #F-IDENT THRU #T-IDENT
        RETAIN AS #P-RETAIN-SET
      #P-NUMBER := *NUMBER (FND93.)
    ELSE
      FND94. FIND NUMBER REPORT
        WITH R-IDENT = #F-IDENT THRU #T-IDENT
        AND #P-RETAIN-SET
        RETAIN AS #P-RETAIN-SET
      #P-NUMBER := *NUMBER (FND94.)
    END-IF
    IF #P-NUMBER = 0
      ESCAPE ROUTINE
    END-IF
  WHEN #F-IDENT-FORM8 NE ' '
    #F-IDENT-TYPE  := #REPORT-IDENT-FORM8
    #T-IDENT-TYPE  := #REPORT-IDENT-FORM8
    #F-IDENT-VALUE := #F-IDENT-FORM8
    #T-IDENT-VALUE := #T-IDENT-FORM8
    IF #P-NUMBER = 0
      FND95. FIND NUMBER REPORT
        WITH R-IDENT = #F-IDENT THRU #T-IDENT
        RETAIN AS #P-RETAIN-SET
      #P-NUMBER := *NUMBER (FND95.)
    ELSE
      FND96. FIND NUMBER REPORT
        WITH R-IDENT = #F-IDENT THRU #T-IDENT
        AND #P-RETAIN-SET
        RETAIN AS #P-RETAIN-SET
      #P-NUMBER := *NUMBER (FND96.)
    END-IF
    IF #P-NUMBER = 0
      ESCAPE ROUTINE
    END-IF                                                 /* CF2 <-
*   WHEN #F-IDENT-UNIX-FILE NE ' '                           /* CF2 ->
*
*  ###   Temporary disabled until decision is made
*  ###   where to store the files and/or how to access
*  ###   the non-descriptor R-IDENT-FILES
*
*     #F-IDENT-TYPE  := #REPORT-IDENT-UNIX-FILE
*     #T-IDENT-TYPE  := #REPORT-IDENT-UNIX-FILE
*     #F-IDENT-VALUE := #F-IDENT-UNIX-FILE
*     #T-IDENT-VALUE := #T-IDENT-UNIX-FILE
*     IF #P-NUMBER = 0
*       FND03. FIND NUMBER REPORT
*                WITH R-IDENT = #F-IDENT THRU #T-IDENT
*                RETAIN AS #P-RETAIN-SET
*       #P-NUMBER := *NUMBER (FND03.)
*     ELSE
*       FND04. FIND NUMBER REPORT
*                WITH R-IDENT = #F-IDENT THRU #T-IDENT
*                AND #P-RETAIN-SET
*                RETAIN AS #P-RETAIN-SET
*       #P-NUMBER := *NUMBER (FND04.)
*     END-IF
*     IF #P-NUMBER = 0
*       ESCAPE ROUTINE
*     END-IF
  WHEN #F-IDENT-UNIX-PATH-VALUE NE ' '
    IF #P-NUMBER = 0
      FND05. FIND NUMBER REPORT
        WITH R-IDENT = #F-IDENT-UNIX-PATH
        THRU #T-IDENT-UNIX-PATH
        RETAIN AS #P-RETAIN-SET
      #P-NUMBER := *NUMBER (FND05.)
    ELSE
      FND06. FIND NUMBER REPORT
        WITH R-IDENT = #F-IDENT-UNIX-PATH
        THRU #T-IDENT-UNIX-PATH
        AND #P-RETAIN-SET
        RETAIN AS #P-RETAIN-SET
      #P-NUMBER := *NUMBER (FND06.)
    END-IF
    IF #P-NUMBER = 0
      ESCAPE ROUTINE
    END-IF                                                 /* CF2 <-
  WHEN NONE IGNORE
END-DECIDE
*
END
