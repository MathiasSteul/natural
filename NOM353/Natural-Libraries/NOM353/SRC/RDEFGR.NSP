* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    RDEFGR
* Version   1.3
* Function  Define Grants
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* gw  95-12-13           cleanup
* wcd 00-04-01 CE 7267   New PFkey for additional printers in RPFK---L
* xsiszha 2000-08-07 (CE7461) Extend Report and Bundle Names
* xsetoba 2002-08-22 (CE7553) Default Profile non-defined users
* xsetggr 2002-10-12 (CE7553) add parameters to Y-OR-N make changes
*                             as in other modules
* xsetggr 03-07-30 p(240465)  correct  CE7553
* xsetggr 2005-10-26 p(270950) ISN fields must be P10, not P8
* xsetggr 2008-07-29 p(297859) honour folder grants
* raya    2011-12-11 NOMALL-1074 obj-type'B' can not fill archive/revive
* xsetggr 2012-09-25 NOMALL-89 correct validation of added grants
* fhi     2016-11-15 NOMALL-1961 Use new task IDs
* BLI     2017-02-20 NOMALL-1983 omit arc/rev for reports
* ----------------------------------------------------------------------
DEFINE DATA
GLOBAL USING  NRM-GL
LOCAL  USING  RPFK---L
LOCAL  USING  ROT----L
LOCAL  USING  VGRANT-L
LOCAL
1 #FATHER-PROG      (A8) INIT <'RLISGR'>
1 GRANTS1    VIEW  OF  NRM-GRANTS
1 CV-OPT            (C/6)
1 CV-MAP            (C)
1 CV-USER           (C)
1 #HEADER-2         (A20)
1 L-GRISN           (P10)
1 #ADD              (L)
1 J                 (N3)
1 #ALLOWED          (L)
1 #EXIST            (L)
1 #FUNC             (A1)
1 #GR-SUPER         (A34)
1 REDEFINE    #GR-SUPER
  2 #GR-T           (A1)
  2 #GR-U           (A8)
  2 #GR-N           (A25)
*
1 #OBJECT-TYPE      (A32)
1 #OBJECT-IDENT     (I2)
1 #LANGUAGE         (I1)
1 #OBJECT-NAME      (A25)
1 REDEFINE #OBJECT-NAME
  2 #OBJECT-NAME-A  (A1/25)
1 #YES              (L)
1 #AUTODEF          (A1)
1 #DEF-USER         (L)
1 #CHK-USER         (L)
1 #USERID           (A8)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET G-COMMIT
* security check
IF G-C-GRANTS(1) NE 'Y'
  #ALLOWED := FALSE
ELSE
  #ALLOWED := TRUE
END-IF
INCLUDE C-NALLOW
*
GRANTS.GR-OBJECT-TYPE := #GR-T := G-C-OBJTYPE
#GR-N := G-C-OBJNAME
#GR-U := G-C-GUSERID
#AUTODEF := F#MONITOR-USER-AUTODEF (<>)
REPEAT
  IF G-C-FUNC = 'A'
    RESET G-C-USERID #GR-U L-GRISN
  END-IF
*
  FIND-LOOP. FIND GRANTS WITH GR-SUPER  = #GR-SUPER
    IF NO RECORDS FOUND
      IF NOT G-C-FUNC = 'A'
        G-NATRP-ERC := 0910
        INCLUDE C-ESCAPE
      END-IF
    END-NOREC
    L-GRISN := *ISN
    #USERID := GRANTS.GR-USERID
    DECIDE ON EVERY VALUE OF G-C-FUNC
      VALUE 'M'
        #HEADER-2 := 'Modify Authorization'
        CV-USER := (AD=P)
      VALUE 'A' /*DISPLAY
        #HEADER-2 := ' Add Authorization'
        #ADD := TRUE
        CV-USER := (AD=I)
      NONE IGNORE
    END-DECIDE
*
    DECIDE ON FIRST VALUE OF G-C-OBJTYPE
      VALUE 'R'
        #OBJECT-IDENT := ##EQO-REPORT
      VALUE 'B'
        #OBJECT-IDENT := ##EQO-BUNDLE
        CV-OPT(5:6) := (AD=NP)
      VALUE 'L'
        #OBJECT-IDENT := ##EQO-LIST
        CV-OPT(5:6) := (AD=NP)
      VALUE 'P'
        CV-OPT(5:6) := (AD=NP)
        #OBJECT-IDENT := ##EQO-PRINTER
      VALUE 'F'
        #OBJECT-IDENT := ##EQO-FOLDER
      NONE IGNORE
    END-DECIDE
    SCREEN-LOOP. REPEAT
      #OBJECT-NAME := G-C-OBJNAME
      DECIDE ON FIRST VALUE OF G-C-OBJTYPE
        VALUE 'R'
          IF NOT G-DISPLAY-LONG-NAMES
            #OBJECT-NAME-A(18):= H'FA'
          END-IF
        VALUE 'B'
          IF NOT G-DISPLAY-LONG-NAMES
            #OBJECT-NAME-A(9):= H'FA'
          END-IF
        VALUE 'L','P'
          #OBJECT-NAME-A(9):= H'FA'
        VALUE 'F'
          #OBJECT-NAME-A(17):= H'FA'
        NONE IGNORE
      END-DECIDE
      IF #LANGUAGE NE *LANGUAGE
        #LANGUAGE := *LANGUAGE
        PERFORM INIT-PFKEYS
        CALLNAT 'ROTINI-N' #OBJECT-IDENT #OBJECT-TYPE G-OTB
      END-IF
*
      PERFORM SET-PFKEYS
      RESET G-MAP-MODIFIED
      SET CONTROL 'WC18L50B5/15F'
      SET CONTROL 'M13'
***   IF G-C-OBJTYPE = 'R' OR = 'F' /* xsetggr 2012-09-25 NOMALL-89
      IF G-C-OBJTYPE = 'F' /* BLI 2017-02-20 NOMALL-1983 'R' in 'ELSE'
        INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT USING MAP 'RDEFGRM&'
      ELSE                              /*raya nomall-1074 start in
        INPUT WITH TEXT *G-NATRP-ERC,G-NATRP-ERT USING MAP 'RDEFGR2&'
      END-IF                            /*raya nomall-1074 end in
      RESET G-NATRP-ERC G-NATRP-ERT
      INCLUDE RPFKVA-C
      INCLUDE C-DIRECT
      INCLUDE RPFKED-C
      IF G-PF-FUNC = 'EXT' AND G-SUPPORT-LONG-NAMES
        IF G-DISPLAY-LONG-NAMES
          G-DISPLAY-LONG-NAMES := FALSE
        ELSE
          G-DISPLAY-LONG-NAMES := TRUE
        END-IF
      END-IF
      IF CV-MAP MODIFIED OR G-MAP-MODIFIED
          OR #DEF-USER
        IF #CHK-USER
          RESET #DEF-USER
        END-IF
        IF GRANTS.GR-USERID = ' '
          REINPUT *0905 MARK *GRANTS.GR-USERID ALARM
        END-IF
* xsetggr 2012-09096 NOMALL-89 insert next 3 lines
        IF GRANTS.GR-USERID = SCAN '*'
          REINPUT USING HELP MARK *GRANTS.GR-USERID
        END-IF
        IF NOT #DEF-USER
         IF #USERID NE GRANTS.GR-USERID AND GRANTS.GR-USERID NE 'PUBLIC'
            CALLNAT 'RCHKUL' GRANTS.GR-USERID #EXIST
            IF NOT #EXIST
              IF #AUTODEF = 'P'
                RESET #YES
                #DEF-USER := TRUE
                CALLNAT 'Y-OR-N' GRANTS.GR-USERID #YES
              END-IF
              IF #AUTODEF = 'Y' OR (#AUTODEF = 'P' AND #YES)
                RESET #CHK-USER
                #USERID := GRANTS.GR-USERID
              ELSE
                IF #AUTODEF = 'P' AND #YES = FALSE
                  #CHK-USER := TRUE
                ELSE
                  REINPUT *0002, GRANTS.GR-USERID
                    MARK *GRANTS.GR-USERID ALARM
                END-IF
              END-IF
              IF #DEF-USER
                G-NATRP-ERC := 0509
                ESCAPE TOP
              END-IF
            END-IF
          END-IF
        ELSE
          RESET #DEF-USER
        END-IF
*
        PERFORM VALIDATE-OPTIONS       /* xsetggr 2012-09-25 NOMALL-89
*
        IF L-GRISN = 0
          #GR-T := G-C-OBJTYPE
          #GR-U := GRANTS.GR-USERID
          #GR-N := G-C-OBJNAME
          FINDNUM. FIND NUMBER GRANTS1 WITH GR-SUPER=#GR-SUPER
          IF *NUMBER(FINDNUM.) > 0
            REINPUT *0907 MARK *GRANTS.GR-USERID ALARM
          END-IF
          GRANTS.GR-OBJECT-TYPE := G-C-OBJTYPE
          GRANTS.GR-OBJECT-NAME := G-C-OBJNAME
          STORE1. STORE GRANTS
          L-GRISN := *ISN(STORE1.)
          G-COMMIT := TRUE
          G-NATRP-ERC := 031
          #USERID := GRANTS.GR-USERID
          G-C-FUNC := 'M'
          INCLUDE C-COMMIT
          INCLUDE REXDO--C
          ESCAPE BOTTOM (FIND-LOOP.)
        END-IF
        UPDATE(FIND-LOOP.)
        G-NATRP-ERC := 32
        #USERID := GRANTS.GR-USERID
        INCLUDE C-COMMIT
      END-IF
*
      DECIDE ON FIRST VALUE OF G-PF-FUNC
        VALUE 'DO'
          END TRANSACTION
          G-NATRP-ERC := 0015
          #ADD := FALSE
          RESET G-COMMIT
        VALUE 'MENU'
          INCLUDE C-MENU
        NONE VALUE IGNORE
      END-DECIDE
*
      INCLUDE REXDO--C
    END-REPEAT
  END-FIND
END-REPEAT
*
************************************************************************
* Main line
************************************************************************
*
* xsetggr 2012-09-15 NOMALL-89 insert subroutine (add lines from above)
************************************************************************
DEFINE SUBROUTINE VALIDATE-OPTIONS
************************************************************************
IF NOT(GRANTS.GR-OPTION(*) NE  ' ')
  REINPUT *0906 MARK *GRANTS.GR-OPTION(1)
END-IF
*
FOR J 1 TO 6
  IF J=5 AND G-C-OBJTYPE NE 'F'     /* BLI 2017-02-20 NOMALL-1983 start
    ESCAPE BOTTOM
  END-IF                            /* BLI 2017-02-20 NOMALL-1983 end
*
  IF NOT(GRANTS.GR-OPTION(J) = ' ' OR = 'Y' OR = 'N')
    REINPUT *666 MARK *GRANTS.GR-OPTION(J) ALARM
  END-IF
  IF GRANTS.GR-OPTION(J) = ' '
    GRANTS.GR-OPTION(J) := 'N'
  END-IF
END-FOR
*
IF GRANTS.GR-OPTION(1) = 'Y'
  GRANTS.GR-OPTION(*) := 'Y'
ELSE
  DECIDE FOR FIRST CONDITION
    WHEN GRANTS.GR-OPTION(3) = 'Y'    /* purge
      GRANTS.GR-OPTION(2:4) := 'Y'
    WHEN GRANTS.GR-OPTION(2) = 'Y' AND GRANTS.GR-OPTION(3) NE 'Y'
      GRANTS.GR-OPTION(4) := 'Y'
    WHEN NONE IGNORE
  END-DECIDE
END-IF
IF G-C-OBJTYPE NE 'F'               /* BLI 2017-02-20 NOMALL-1983 start
  GRANTS.GR-OPTION(5:6) := 'N'
END-IF                              /* BLI 2017-02-20 NOMALL-1983 end
*
END-SUBROUTINE /* VALIDATE-OPTIONS  /* xsetggr 2012-09-25 NOMALL-89 end
*
************************************************************************
DEFINE SUBROUTINE INIT-PFKEYS
************************************************************************
INCLUDE RPFSTD-C
INCLUDE RPFADD-C
INCLUDE RPFCOM-C
INCLUDE RPFEXT-C
CALLNAT 'RPFINI-N' G-PF G-PFB
*
END-SUBROUTINE /* INIT-PFKEYS
*
INCLUDE RPFSET-C
*
END
