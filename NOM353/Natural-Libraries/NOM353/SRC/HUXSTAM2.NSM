INPUT          (     IP=OFF                                           /*
                                                                       )
 004T 'Sie koennen einen der folgenden Status Codes'(YEI)
/
 014T 'des Unix-Knotens auswaehlen:'(YEI)
/
/
 004T 'A'(YEI)
 008T 'Aktivieren des Knotens. Er wird in die Identi-'(TU)
/
 008T 'fikation der Outputs einbezogen.'(TU)
/
 004T 'S'(YEI)
 008T 'Suspendieren des Knotens. Der Knoten ist vom'(TU)
/
 008T 'Monitor solange ausgeschlossen, bis der LOGIN'(TU)
/
 008T 'Vorgang wieder funktioniert.'(TU)
/
 004T 'D'(YEI)
 008T 'Knoten ist deaktiviert, kein LOGIN moeglich.'(TU)
/
 004T 'M'(YEI)
 008T 'Der Knoten ist als Umgebung fuer den Monitor'(TU)
/
 008T 'definiert. Er wird nie suspendiert. Der Entire'(TU)
/
 008T 'System Server wird ueber Entire X angesprochen.'(TU)
/
 008T 'Nur fuer Unix-Systeme.'(TU)
/
 004T 'L'(YEI)
 008T 'Lokaler Monitor. Wie ''M'', jedoch wird der Entire'(TU)
/
 008T 'System Server als Subprogramm angesprochen,'(TU)
/
 008T 'ohne Entire X zu benutzen. Nur fuer Unix Systeme'(TU)
/
/
 008T 'Select =>'(TU)
 019T #CODE  (AD=MIT ) /*.99U001 A001            .
/
