* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* NOVSLV-N - NOM API List of Volsers in Archive Dataset
* Input keys: ES-KEY-PARM(1) - archive dsname
*
* Maintenance:
* XSETGGR 2005-02-20 created
* SU1     2013-01-31 unused      Deactivate unused data areas
* --------------------------------------------------------------------
DEFINE DATA
PARAMETER USING ESMCNT-A
PARAMETER USING ESMINP-A
PARAMETER USING ESMWORKA
PARAMETER USING NOVSLV-A
************************************************************************
LOCAL
1 ARCHIVE-DATASET VIEW OF NRM-ARCHIVE-DATASET
  2 C*AD-VOLSERS
  2 AD-VOLSERS     (1:191)
1 #I2              (I4)
1 #IMAX            (I4)
1 #DSNAME          (A44)
1 #I               (I4)
1 #IND             (N3)
1 #IND-A           (A3)
1 REDEFINE #IND-A
  2 #IND-N         (N3)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
************************************************************************
ON ERROR
************************************************************************
  ES-RC := 1
  COMPRESS *PROGRAM 'ERROR' *ERROR-NR *ERROR-LINE TO ES-MSG-TXT
  ESCAPE ROUTINE
*
END-ERROR
*
RESET ES-RC ES-NUMBER ES-STARTINDEX ES-SORTKEY ES-SORTORDER
  ES-OPTION-COUNT ES-EXPAND
#DSNAME := ES-KEY-PARM(1)
ES-EOF := 'X'
#IMAX := 3162
ES-FIELD-COUNT := 1
NOVSLV-FIELD-LENGTH(1) := 8
IF ES-NEXT-KEY-PARM(1) > ' '
  #IND := VAL(ES-KEY-PARM(1))
ELSE
  #IND := 1
  ES-STARTINDEX := 2
  #I2 := 1
  NOVSLV-HEADER := 'VOLSERS'
END-IF
FNDAD. FIND ARCHIVE-DATASET WITH AD-ARCHIVE-DSNAME = #DSNAME
  IF C*AD-VOLSERS > 0
    FOR #I = #IND TO C*AD-VOLSERS
      IF AD-VOLSERS(#I) > ' '
        ADD 1 TO #I2
        IF #I2 > #IMAX
          #IND-N := #I
          ES-NEXT-KEY-PARM(1) := #IND-A
          ES-NUMBER := #IMAX
          RESET ES-EOF
          ESCAPE BOTTOM
        ELSE
          NOVSLV-VOLSER(#I2):= AD-VOLSERS(#I)
        END-IF
        ES-NUMBER := #I2
      END-IF
    END-FOR
    IF ES-NUMBER = #IMAX
      ESCAPE BOTTOM
    END-IF
  END-IF
END-FIND
*
END
