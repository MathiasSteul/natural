* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* NRMPUTGL - COPY CURRENT GDA NATOP-GL  TO EDITOR SESSION NUMBER 49
*
* Maintenance
* mrs 91-12-13 s(141159) number of entries changed from 42 to 68
* gw  95-01-09 s(999999) ED-USER := *USER
* xsiszha 2000-08-07 (CE7461) Extend Report and Bundle Names
* fhi 03-09-01 p(244091) Use PROF-LANGUAGE=1
* sju 05-03-01 NOM31     PROF-LANGUAGE X'01' not C'1'
* fhi 08-06-18 P296314   SAVE GDA for Unix
* fhi     2009-03-17 P296314 Don't save GDA under Unix
* xsetggr 2009-10-09 P320995 do not stack AIVs here - NRMPUTAI
* ----------------------------------------------------------------------
DEFINE DATA GLOBAL USING NRM-GL
* *****
LOCAL USING EDIT-CB
LOCAL
1 EDIT-PREF
  2 L-PREFIX                  (A2/1:14)
1 EDIT-DATA
  2 L-DATA                    (A250/1)
1 EDIT-ALIN                   (A14)
1 REDEFINE  EDIT-ALIN
  2 CB-ALIN-V                 (N1/14)
1 EDIT-ADAT                   (A14)
1 REDEFINE  EDIT-ADAT
  2 CB-ADAT-V                 (N1/14)
1 I                           (N3)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
IF *MACHINE-CLASS NE 'MAINFRAME'
  ESCAPE MODULE
END-IF
ED-DSTYPE  := 'DAT'
ED-SESNUM  := 49
ED-REQUEST := 'CLSS'
CALL 'EDITOR' EDIT-CB
IF ED-ERRNUM NE 0
  G-NATRP-ERC := 3
  G-NATRP-ERT := ED-ERRNUM
  ESCAPE ROUTINE
END-IF
*
ED-SESNUM  := 49
ED-USER    := *USER
ED-BPUSE   := 1
ED-DTPLACE := 1
ED-PRFLEN  := 2
ED-PRFENT  := 2
ED-LINENTL := 250
ED-SCRLEN  := 250
ED-RECLEN  := 250
ED-SCRNUM  := 1
ED-SCRMAX  := 1
ED-RECMAX  := 80
PROF-CAPS  := 'N'
PROF-LANGUAGE := H'01'
ED-REQUEST := 'OPEN'
CALL 'EDITOR' EDIT-CB  EDIT-ALIN EDIT-PREF  EDIT-ADAT EDIT-DATA
IF ED-ERRNUM NE 0
  G-NATRP-ERC := 3
  G-NATRP-ERT := ED-ERRNUM
  ESCAPE ROUTINE
END-IF
ED-REQUEST := 'DELA'
CALL 'EDITOR' EDIT-CB
IF ED-ERRNUM NE 0
  G-NATRP-ERC := 3
  G-NATRP-ERT := ED-ERRNUM
  ESCAPE ROUTINE
END-IF
*
ED-SCRMAX := 0
FOR I = 1 TO *OCC(GLOBAL-SEGMENT)
  L-DATA(1) := GLOBAL-SEGMENT(I)
  ED-REQUEST := 'ADDL'
  CALL 'EDITOR' EDIT-CB  EDIT-ALIN EDIT-PREF EDIT-ADAT EDIT-DATA
  IF ED-ERRNUM NE 0
    G-NATRP-ERC := 3
    G-NATRP-ERT := ED-ERRNUM
    ESCAPE ROUTINE
  END-IF
END-FOR
*
END
