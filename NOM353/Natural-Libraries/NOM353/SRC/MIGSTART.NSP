* ----------------------------------------------------------------------
* Migstart handles the following migration programs using the flags in
* M-VERS-MIGRATION-COMPL:
*
* (1) - MIGPRT
* (5) - MIGMON
*
* Number of migration programs that must be completed to complete the
* whole migration: See MIGEND for details.
*
* ----------------------------------------------------------------------
DEFINE DATA /*GLOBAL USING NRM-GL /*SU1 out
LOCAL
1 MONITOR VIEW OF NRM-MONITOR
  2 M-MONITOR-ID
  2 M-VERSION
  2 REDEFINE M-VERSION
    3 #VVRRSSPPPP            (A10)
    3 #MIGRATION-IN-PROGRESS (A1)
    3 M-VERS-DATE            (A8)
    3 M-VERS-NO-OF-MIG-PROGS (N2)
    3 M-VERS-MIGRATION-COMPL (A1/10)
  2 REDEFINE M-VERSION /* format NOM 3.4 and above
    3 #VERSION4              (N2)
    3 #RELEASE4              (N2)
    3 #SMLEVEL4              (N2)
    3 #IUPDLEVEL4            (N4)
*
1 #MONITOR-ID                (A20)
1 #FOUND                     (L)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
INCLUDE MIG----C 'SET-VALUES' 'MONITOR'
END TRANSACTION
* fhi     2019-02-15 NOMALL-2234 start commenting
*  IF NOT #FOUND
*    *ERROR-NR := 999 /* No monitor record found, neither NOM 3.4 nor 3.5.
*  END-IF
* fhi     2019-02-15 NOMALL-2234 end   commenting
*
************************************************************************
* Subroutines
************************************************************************
DEFINE SUBROUTINE SET-VALUES /* called by MIG----C
*                 ----------
M-MONITOR-ID               := F#MONITOR-TASK-ID1 (<>)
#MIGRATION-IN-PROGRESS     := 'Y'
M-VERS-NO-OF-MIG-PROGS     := 2
M-VERS-MIGRATION-COMPL (*) := 'N'
END-SUBROUTINE
************************************************************************
*
END
