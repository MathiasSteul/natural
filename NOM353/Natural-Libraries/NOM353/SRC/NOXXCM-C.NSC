* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* MEMBER    NOXXCM-C
* VERSION   3.4.0
* FUNCTION  COMPARE STRING WITH MASK - IT IS CALLED MANY TIMES,
*  SO IT WAS REALIZED AS COPYCODE, NOT SUBPROGRAM.
* PARAMETER :
*    &1& = #STRING  - STRING, WHICH SHOULD BE CHECKED WITH MASK
*    &2& = #STRING-A1
*    &3& = #MASK  - MASK, WHICH CAN CONSISTS OF :
*          #WILDCARD (USUALLY '*')
*          #MASK-CHAR (USUALLY '?')
*          AND ANY OTHER CHARACTER
*         EXAMPLE :
*         #MASK     ! #STRING    ! #MASK-CORRECT
*         "ABC?K*G" !"ABCDKIIIG" !  TRUE
*         "ABC?K*G" !"ABCKIIIG"  !  FALSE
*         "ABC?K*G" !"ABCDKG"    !  TRUE
*    &4& = #MASK-A1  - THE SAME #MASK STRING ONLY REDEFINED AS A1
*    &5& = #WILDCARD   - USUALLY '*'
*    &6& = #MASK-CHAR  - USUALLY '?'
*    &7& = #MASK-CORRECT - REPLY IF MASK IS CORRECT - TRUE/ FALSE
*    &8& = #SL  - RANDOM (I4)
*    &9& = #ML  - RANDOM (I4)
*    &10& = #MC - RANDOM (I4)
*    &11& = #C  - RANDOM (I4)
*    &12& = #POS - RANDOM (I4)
*    &13& = #POS2 - RANDOM (I4)
*    &14& = #FIN  - RANDOM (L)
*    &15& = #W-CARD-PREV  - RANDOM (L)
*
* MAINTENANCE
* UUU YY-MM-DD S(999999) ...
* XKO 2012-10-09 CREATED FOR NOMALL-860 DIRECT COMAND DELETE WITH *
* ----------------------------------------------------------------
DEFINE SUBROUTINE COMPARE_WITH_MASK
EXAMINE &1& FOR H'FF' GIVING LENGTH &8&
EXAMINE &3& FOR H'FF' GIVING LENGTH &9&
&7& := TRUE
&15& := FALSE /* WILD CARD WAS PREVIOUS -TRUE/FALSE
&14& := FALSE /* MASK ENDS - FINISHES
&10& := 1      /* MASK CHAR COUNTER
&12& := 0
&13& := 0
FOR &11& = 1 TO &8&
  IF &4&(&10&) EQ &6&
    IF &10& EQ &9&
      &14& := TRUE
      IF &15& = TRUE
        ESCAPE ROUTINE
      ELSE
        IF (&11& < &8&)
          IF &12& NE 0
            &14& := FALSE
            &15& := TRUE
            &10& := &12&
            &11& := &13&
            &12& := 0
            ESCAPE TOP
          ELSE
            &7& := FALSE
            ESCAPE ROUTINE
          END-IF
        END-IF
      END-IF
    END-IF
  ELSE
    IF &4&(&10&) EQ &5&
     &12& := 0
     &15& := TRUE
     IF &10& NE &9&
       &10& := &10& + 1
       IF &4&(&10&) = &5& OR = &6&
         &11& := &11& - 1
         ESCAPE TOP
       END-IF
     ELSE
       ESCAPE ROUTINE
     END-IF
   END-IF
   IF (&4&(&10&) = &2&(&11&))
     IF &15& = TRUE
       &15& := FALSE
       &12& := &10&
       &13& := &11&
     END-IF
   ELSE
     IF &15& = FALSE
       IF &12& NE 0
        &15& := TRUE
        &10& := &12&
        &11& := &13&
        &12& := 0
        ESCAPE TOP
       ELSE
        &7& := FALSE
        ESCAPE ROUTINE
       END-IF
     ELSE
       ESCAPE TOP
     END-IF
   END-IF
   IF &10& = &9&
     &14& := TRUE
     IF (&11& < &8&)
       IF &12& NE 0
         &14& := FALSE
         &15& := TRUE
         &10& := &12&
         &11& := &13&
         &12& := 0
         ESCAPE TOP
       ELSE
         &7& := FALSE
         ESCAPE ROUTINE
       END-IF
     END-IF
   END-IF
  END-IF
  &10& := &10& + 1
END-FOR
IF &15& = TRUE
  IF NOT (&10& = &9& AND &4&(&10& - 1) = &6&
      AND &4&(&10& ) = &5&)
    &7& := FALSE
  END-IF
ELSE
  IF &14& = FALSE
    IF &4&(&10&) NE &5& OR &10& NE &9&
      &7& := FALSE
    END-IF
  END-IF
END-IF
END-SUBROUTINE
