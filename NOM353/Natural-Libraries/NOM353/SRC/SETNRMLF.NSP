* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* **********************************************************************
* MEMBER    SETNRMLF
* FUNCTION  This program will be used to set the logical file
*           depending on which version of NATURAL and the number
*           of parameters passed.
*
* VERSION   1.4
*
* Maintenance:
* JWO 1977-09-18 S(164220) NAT23 solution
*
* **********************************************************************
*
DEFINE DATA LOCAL
1 #PARM-DBID        (N5)
1 #PARM-FNR         (N5)
1 #PARM-LFILE       (N5)
1 #PARM-RC          (I4)
1 #NOM-SYS-LFILE    (N5) CONST <206>
1 #NO-OF-PARM       (N2)
1 #PARM-PASSWORD    (A8) /* not use but needed for callnat
1 #PARM-CIPHER      (A8) /* not use but needed for callnat
*
END-DEFINE
* *--------- Get the number of parameters -----------------------------
* The number of parameters should be
*      2 to set LFILE to 206
*      3 to set LFILE to given fnr.
*
* *--------------------------------------------------------------------
RESET #PARM-DBID #PARM-FNR #PARM-LFILE #NO-OF-PARM
MOVE *DATA TO #NO-OF-PARM
DECIDE ON FIRST VALUE OF #NO-OF-PARM
  VALUE 2
    INPUT #PARM-DBID #PARM-FNR
    #PARM-LFILE := #NOM-SYS-LFILE
  VALUE 3 , 0 , -1
    INPUT #PARM-DBID #PARM-FNR #PARM-LFILE
  NONE VALUE
    ESCAPE ROUTINE
END-DECIDE
*
CALLNAT 'SETNRMLN'
  #PARM-DBID #PARM-FNR #PARM-LFILE
  #PARM-PASSWORD #PARM-CIPHER #PARM-RC
*
END
