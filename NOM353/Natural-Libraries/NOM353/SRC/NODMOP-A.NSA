DEFINE DATA PARAMETER
/* >Natural Source Header 000000
/* :Mode S
/* :CP
/* <Natural Source Header
* *PARAMETER  NODMOP-A
* *VERSION    3.5.0
* *FUNCTION   NOM MONITOR DEFAULTS
*  *
* *MAINTENANCE:
* *XSETGGR  2004-06-04 CREATED
* *XSETGGR  2005-05-12 CORRECT
* *xsetggr  2007-05-03 NOM3201                Support 5 byte node number
* *XSETGGR 2012-08-04  NOMALL-78     DISABLED LONG RECORDS
* *SU1     2013-03-26  NOMALL-82    34:monitordefaults:new class:error
* SU2     2014-06-23  NOMALL-1281            show last update user
* CF1     2017-11-01  NOMALL-2050 Adapt Monitor Defaults to 3.5.0
* CF2     2018-11-14  NOMALL-2050 Add emergency email
* ----------------------------------------------------------------------
1 NODM-PARMS
  2 NODM-PARM-AREA (A253/1:20)
  2 REDEFINE NODM-PARM-AREA
    3 NODM-MONITOR-ID (A20)
    3 NODM-MONITOR-NODE (N5) /*(N3) xsetggr NOM3201
    3 NODM-NTDB-PROCESS (N3)
    3 NODM-SPOOL-TYPE (A8)
    3 NODM-SYSTEM-TYPE (A8)
    3 NODM-JOBCARD (A72/1:3)
    3 NODM-WAIT-MINIMUM (N9)
    3 NODM-WAIT-MAXIMUM (N9)
    3 NODM-WAIT-INCREMENT (N3)
    3 NODM-MAX-RETRIES (N3)
    3 NODM-RETRY-INT (N5)
    3 NODM-PRT-TASK-NO (N2)
    3 NODM-EMERGENCY-EMAILS (A250/1:2) /*CF2
    3 NODM-CP-FILES (1:20) /*XSETGGR WAS 10
      4 NODM-CP-IDENT (A16)
      4 NODM-CP-DBID (N5)
      4 NODM-CP-FNR (N5)
* *-- ATTRIBUTES FOR JES SPOOL ------------------------
    3 NODM-BATCH-MODULE (A8)
    3 NODM-JOBNAME (A8)
    3 NODM-TEMP-CLASS (A4)
    3 NODM-PRINT-CLASS (A1)
    3 NODM-CLASSES (A1/1:20)
* **NODM-ERROR-CLASS                           /*SU1 NOMALL-82 see below
* *----------------- ATTRIBUTES ONLY  FOR SPOOLTYPE JES2 ----------------
    3 NODM-LONGREC-DBID-RESERVER (N5) /*XSETGGR NOMALL-78
    3 NODM-LONGREC-FNR-RESERVED (N5) /*XSETGGR NOMALL-78
* *---------------- ATTRIBUTES ONLY  FOR SPOOLTYPE JES3 ----------------
    3 NODM-JES3-OUTPUT-CLASSES (A1/1:20)
* *--------------- ATTRIBUTES FOR BS 2----------------------------------
* **NODM-TIME-SCHEDULE                /* CF1 removed
    3 NODM-BS2-DEST (A8/1:4)
    3 NODM-BS2-RENAME (A1)
    3 NODM-BS2-COPY (A1)
* *--------------- ATTRIBUTES FOR UNIX----------------------------------
    3 NODM-MONITOR-TYPE (A1) /*CF1
* *------- REPRESENTS FUNCTIONS OF MONITOR-SUBTASKS --------------------
    3 NODM-SUBT-NUMBER (N3/1:12) /*CF1
* * Occ( 1) - SUBTASK for SCAN QUEUES
* * Occ( 2 : 10) - SUBTASKs for COPY SOURCE
* * Occ(11) - SUBTASK for CREATE REPORTS
* * Occ(12) - SUBTASK for MANAGE PRINTOUTS
    3 NODM-SUBTASK (A11/1:4) /*CF1
    3 REDEFINE NODM-SUBTASK
      4 NODM-SUBT (1:4) /*CF1
        5 NODM-SUBT-WAIT-MIN (N4)
        5 NODM-SUBT-WAIT-MAX (N4)
        5 NODM-SUBT-WAIT-INCR (N3)
    3 NODM-ERROR-CLASS (A1) /*SU1 NOMALL-82
    3 NODM-LAST-UPDATE-USER (A16) /*SU2
    3 NODM-LAST-UPDATE (A15) /*SU2
* **End of PDA NODMOP-A *************************************************
END-DEFINE
