DEFINE DATA PARAMETER
1 #FOLDER (A016)
1 #XX-TITLE (A132)
1  CV-KEY (C)
1  CV-LINK (C)
1  CV-LOC (C)
1  CV-MAP (C)
1 EOMFOM-DEFAULT-LOCATION (A001)
