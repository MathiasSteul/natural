* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* MAP2: PROTOTYPE VERSION 820 --- CREATED BY NAT 0802030000 ---
* INPUT USING MAP 'XXXXXXXX'
*     #CODE
DEFINE DATA PARAMETER
1 #CODE (A001)
END-DEFINE
FORMAT PS=021 LS=056 ZP=OFF SG=OFF KD=OFF IP=OFF
* MAP2: MAP PROFILES *****************************        410***********
* .TTAAAMMOO   D I D I N D I D I        ?_)^&:+(                       *
* 021055        N0NNUCN             X        01 SYSPROF NLH          1 *
************************************************************************
INPUT          (     IP=OFF                                           /*
                                                                       )
 016T 'Automatische Bestaetigung'(I)
/
/
 001T 'Wenn Sie Objekte hinzufuegen oder aktualisieren, kann'
/
 001T 'die physische Aktualisierung auf verschiedene Arten'
/
 001T 'ausgefuehrt werden.'
/
 001T 'Die Aktualisierung kann implizit, sofort nachdem die'
/
 001T 'Veraenderungen getaetigt wurden, ausgefuehrt werden.'
/
 001T 'In diesem Fall haben Sie keine Moeglichkeit, die Ver-'
/
 001T 'aenderungen mit der Funktion Verwerfen (PF6) zurueck-'
/
 001T 'zusetzen.'
/
/
 001T 'Sie koennen die Aktualisierung aber auch explizit aus-'
/
 001T 'fuehren; entweder durch Druecken der Taste PF5 (Bestae-'
/
 001T 'tigen) in einer Maske, oder durch die Bestaetigung ei-'
/
 001T 'ner Aktualisierungsabfrage, beim Verlassen einer ver-'
/
 001T 'aenderten Maske.'
/
/
 007T 'E.'(I)
 010T 'Explizite Bestaetigung (PF5 oder Abfrage)'
/
 007T 'I.'(I)
 010T 'Implizite Bestaetigung (automatisch)'
/
/
 022T 'Auswahl'(I)
 030T '=>'
 033T #CODE  (AD=MDLT'_' ) /*.99U001 A001 .
* MAP2: VALIDATION *****************************************************
RULEVAR F00#CODE
INCDIC                                 ;
IF NOT (& = 'I' OR = 'E')
REINPUT 'ENTER ''I'' OR ''E'''
ALARM
END-IF
SET CONTROL 'Q'
* MAP2: END OF MAP *****************************************************
END
