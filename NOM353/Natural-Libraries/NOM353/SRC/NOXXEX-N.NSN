* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* NOXXEX-N - NOM API : Object exist
*
* XSETHZ 2001-06-12   created
* XSETHZ 2002-11-05   modified
* XSETHZ 2003-08-11   USER-AUTODEF
* XSETHZ 2007-10-19   add archived reports
* CF1    2017-12-06 NOMALL-2062 Define new objects for NOM35
* SU1     2024-04-30 NOM 3.6     remove unused
************************************************************************
DEFINE DATA
PARAMETER USING ESMCNT-A
PARAMETER USING ESMINP-A
************************************************************************
LOCAL
1 RP VIEW OF NRM-REPORTS-NEW
/*SU1  2 R-REPNAME
1 BN VIEW OF NRM-BUNDLES
/*SU1  2 B-BUNDLE
1 PR VIEW OF NRM-PRINTERS
/*SU1  2 P-ID
1 DL VIEW OF NRM-DISTRIBUTION-LIST
/*SU1  2 D-LIST-NAME
1 FO VIEW OF NRM-FOLDER
/*SU1  2 FO-USER-NAME
1 AB VIEW OF NRM-ACTIVE-BUNDLES
/*SU1  2 AB-BUNDLE-RNB
1 PO VIEW OF NRM-PRINTOUTS
/*SU1  2 PO-ID
1 US VIEW OF NRM-USERS
/*SU1  2 USER-ID
1 CA VIEW OF NRM-CALENDARS
/*SU1  2 CA-CALENDAR-ID
1 PH VIEW OF NRM-PHYSICAL-PRINTERS
/*SU1  2 PH-VTAMID
1 DA VIEW OF NRM-USER-DEFINED-ARCHIVE
/*SU1  2 M-MONITOR-ID 2 REDEFINE M-MONITOR-ID
/*SU1 3 M-MONITOR-TYPE (A7) /* 'USERARC'
/*SU1   3 M-USERARC-NUMBER(N2)
  2 M-USERARC-NAME
1 D3 VIEW OF NRM-MONITOR
/*SU1  2 M-MONITOR-ID
1 DU VIEW OF NRM-UX-NODES
/*SU1  2 UX-NODE-NAME
1 #KEY-FROM      (A50)
1 #KEY-TO        (A50)
1 #KEY-FROM-N    (N7)
1 #KEY-TO-N      (N7)
1 #FO-USER-NAME   (A24)
1 REDEFINE #FO-USER-NAME
  2 #FO-USER     (A8)
  2 #FO-NAME     (A16)
1 #FO-USER-NAME-E(A24)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
ES-RC := 1
DECIDE ON FIRST VALUE OF ES-OBJECT
  VALUE 'RP','BN','PR','DL','AB','US','CA','PH','DU'
    PERFORM INIT-VALUES
  VALUE 'FO'
    #FO-USER-NAME := ES-USER
    #FO-NAME := H'FF'
    #FO-USER-NAME-E := #FO-USER-NAME
    #FO-NAME := H'00'
  VALUE 'PO'
    PERFORM INIT-VALUES-N
  VALUE 'DA'
    #KEY-FROM := 'USERARC01'
    #KEY-TO   := 'USERARC09'
  VALUE 'D3'
    #KEY-FROM := 'NOMUSR001'
    #KEY-TO   := 'NOMUSR999'
  NONE VALUE IGNORE
END-DECIDE
DECIDE ON FIRST VALUE OF ES-OBJECT
  VALUE 'RP'
    FNRP. FIND NUMBER RP WITH R-REPNAME = #KEY-FROM THRU #KEY-TO
    IF *NUMBER(FNRP.) > 0
      RESET ES-RC
    END-IF
  VALUE 'BN'
    FNBN. FIND NUMBER BN WITH B-BUNDLE = #KEY-FROM THRU #KEY-TO
    IF *NUMBER(FNBN.) > 0
      RESET ES-RC
    END-IF
  VALUE 'PR'
    FNPR. FIND NUMBER PR WITH P-ID = #KEY-FROM THRU #KEY-TO
    IF *NUMBER(FNPR.) > 0
      RESET ES-RC
    END-IF
  VALUE 'DL'
    FNDL. FIND NUMBER DL WITH D-LIST-NAME = #KEY-FROM THRU #KEY-TO
    IF *NUMBER(FNDL.) > 0
      RESET ES-RC
    END-IF
  VALUE 'FO'
    FNFO. FIND NUMBER FO
      WITH FO-USER-NAME = #FO-USER-NAME THRU #FO-USER-NAME-E
    IF *NUMBER(FNFO.) > 0
      RESET ES-RC
    END-IF
  VALUE 'AB'
    FNAB. FIND NUMBER AB WITH AB-BUNDLE-RNB = #KEY-FROM THRU #KEY-TO
    IF *NUMBER(FNAB.) > 0
      RESET ES-RC
    END-IF
  VALUE 'PO'
    FNPO. FIND NUMBER PO WITH PO-ID = #KEY-FROM-N THRU #KEY-TO-N
    IF *NUMBER(FNPO.) > 0
      RESET ES-RC
    END-IF
  VALUE 'US'
    IF NOT(#KEY-FROM = 'DEFAULT' AND #KEY-TO = 'DEFAULT')
      FNUS. FIND NUMBER US WITH USER-ID = #KEY-FROM THRU #KEY-TO
      IF *NUMBER(FNUS.) > 0
        RESET ES-RC
      END-IF
    END-IF
  VALUE 'CA'
    FNCA. FIND NUMBER CA WITH CA-CALENDAR-ID = #KEY-FROM THRU #KEY-TO
    IF *NUMBER(FNCA.) > 0
      RESET ES-RC
    END-IF
  VALUE 'PH'
    FNPH. FIND NUMBER PH WITH PH-VTAMID = #KEY-FROM THRU #KEY-TO
    IF *NUMBER(FNPH.) > 0
      RESET ES-RC
    END-IF
  VALUE 'DA'
    IF ES-KEY-PARM(1) = ' '
      FNDA1. FIND NUMBER DA WITH M-MONITOR-ID = #KEY-FROM THRU #KEY-TO
      IF *NUMBER(FNDA1.) > 0
        RESET ES-RC
      END-IF
    ELSE
      FNDA2. FIND DA WITH M-MONITOR-ID = #KEY-FROM THRU #KEY-TO
          WHERE M-USERARC-NAME = ES-KEY-PARM(1)
        RESET ES-RC
        ESCAPE BOTTOM(FNDA2.)
      END-FIND
    END-IF
  VALUE 'D3'
    FND3. FIND NUMBER D3 WITH M-MONITOR-ID = #KEY-FROM THRU #KEY-TO
    IF *NUMBER(FND3.) > 0
      RESET ES-RC
    END-IF
  VALUE 'DU'
    FNDU. FIND NUMBER DU WITH UX-NODE-NAME = #KEY-FROM THRU #KEY-TO
    IF *NUMBER(FNDU.) > 0
      RESET ES-RC
    END-IF
  VALUE 'MT','AR','AD','RD','VS','RR','MM','EV'            /* CF1
    RESET ES-RC
  NONE VALUE IGNORE
END-DECIDE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE INIT-VALUES
************************************************************************
IF ES-KEY-PARM(1) = ' '
  #KEY-FROM := H'00'
  #KEY-TO   := H'FF'
ELSE
  #KEY-FROM := ES-KEY-PARM(1)
  #KEY-TO   := ES-KEY-PARM(1)
END-IF
*
END-SUBROUTINE /* INIT-VALUES
*
************************************************************************
DEFINE SUBROUTINE INIT-VALUES-N
************************************************************************
IF ES-KEY-PARM(1) = ' ' OR NOT (ES-KEY-PARM(1) IS (N7))
  #KEY-FROM-N := 0
  #KEY-TO-N   := 9999999
ELSE
  #KEY-FROM-N := VAL(ES-KEY-PARM(1))
  #KEY-TO-N   := #KEY-FROM-N
END-IF
*
END-SUBROUTINE /* INIT-VALUES-N
*
END
