* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* NOGROU-N - read grants for object + user
*
* Maintenance:
* XSETHZ 2002-12-04   created
************************************************************************
DEFINE DATA PARAMETER
1 #OBJECT-TYPE           (A1)    /*  in
1 #OBJECT-NAME           (A25)   /*  in
1 #USER-ID               (A8)    /*  in
1 #GR-USER-ID            (A8)    /*  out
1 #GRANTS                (A1/6)  /*  out
************************************************************************
LOCAL
1 GRANTS VIEW OF NRM-GRANTS
  2 GR-USERID
  2 GR-OPTION (1:6)
1 LIST VIEW OF NRM-DISTRIBUTION-LIST
  2 D-USER-LIST (191)
1 #GR-TYPE-NAME          (A26)
1 REDEFINE #GR-TYPE-NAME
  2 #GR-OBJECT-TYPE      (A1)
  2 #GR-OBJECT-NAME      (A25)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#GRANTS(*) := 'N'
RESET #GR-USER-ID
#GR-OBJECT-TYPE := #OBJECT-TYPE
#GR-OBJECT-NAME := #OBJECT-NAME
FG. FIND GRANTS WITH GR-TYPE-NAME = #GR-TYPE-NAME
  DECIDE ON FIRST VALUE OF GR-USERID
    VALUE #USER-ID
      #GRANTS(*) := GR-OPTION(*)
      #GR-USER-ID := GR-USERID
      ESCAPE BOTTOM
    VALUE 'PUBLIC'
      IF #GR-USER-ID = ' '
        #GRANTS(*) := GR-OPTION(*)
        #GR-USER-ID := GR-USERID
      END-IF
    NONE VALUE
      FIND LIST WITH D-LIST-NAME = GR-USERID
        IF D-USER-LIST(*) = #USER-ID
          #GRANTS(*) := GR-OPTION(*)
          #GR-USER-ID := GR-USERID
        END-IF
      END-FIND
  END-DECIDE
END-FIND
*
END
