DEFINE DATA PARAMETER
/* >Natural Source Header 000000
/* :Mode S
/* :CP
/* <Natural Source Header
* ***********************************************************************
*   PDA RMIMP-A common fields for              IMPORT programs
*
*   Maintenance
*   uuu  yyyy-mm-dd iTrac
*   SU   2021-04-22 NOMALL-2460      created   show actions
*   SU1  2021-08-18 NOMALL-2467      load FO:  check if user exist
* *************************     *****************************************
*
1 #IMPORT
  2 #IMPORT-PARMS (A700)
  2 REDEFINE #IMPORT-PARMS
    3 #REPL (A1)
    3 #TRACE (A1)
    3 #TAG-CURRENT (A50)
    3 #TAG-OLD (A50)
    3 #VALUE-CURRENT (A300)
    3 #KEY (A250)
    3 #IND (I2)
  2 #SAVE (L)
*
  2 #COUNT (1:20)
    3 #CNT-TYPE (A2) /*like USer(GRant/..
    3 #CNT-LOADED (I4)
    3 #CNT-NOT-LOADED (I4) /*SU1
    3 #CNT-REPLACED (I4)
    3 #CNT-NOT-REPLACED (I4)
* **End of PDA RMIMP-A **************************************************
END-DEFINE
