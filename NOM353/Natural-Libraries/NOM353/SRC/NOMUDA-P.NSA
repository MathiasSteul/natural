DEFINE DATA PARAMETER
/* >Natural Source Header 000000
/* :Mode S
/* :CP
/* <Natural Source Header
*   API for user defined archive/revi      ve/condense
*
*   NOM221
*   xsetggr 2007-08-29 NOM3201       Change runnumber to format P11
*                                    this version of pda for version=02
*                                    (NOM version 3.2 and above)
*  ---------------------------------------------------------------------
1 NOMUDA-API-VERSION (N2) /* Interface version
1 NOMUDA-PARMS (A250/1:4)
1 REDEFINE NOMUDA-PARMS /* REDEF. BEGIN : NOMUDA-PARMS
  2 NOMUDA-RC (N4) /* Return code
  2 NOMUDA-RT (A72) /* Returned text (for log)
  2 NOMUDA-FUNCTION (A1) /* A(rchive), R(evive),
*                                                 C(ondense) or D(elete)
  2 NOMUDA-SUBFUNC (A1) /* R(ead),W(rite),F(inish)
*   For condense only - indicates whe      therto read a record from dataset 1
*   or to write a record to dataset 2       (ifNOMUDA-CONDENSE-ACTION is C)
*   For condense and archive a final       call with subfunc F is made when
*   there are no more records to writ         e
  2 NOMUDA-CONDENSE-ACTION (A1) /* C(opy),S(uppress) - whether
*   or not the current input record i       sto be written to the output
  2 NOMUDA-EXPIRY-DATE (A8) /* YYYYMMDD dataset expiry
  2 NOMUDA-DATA-SET-NAME-1 (A44) /* Dataset name for archive/
*   revive; current input dataset for          condense
  2 NOMUDA-DATA-SET-NAME-2 (A44) /* Condense output dataset
  2 NOMUDA-AR-NAME (A25) /* Current active report
  2 NOMUDA-AR-RNB (P11) /* (P7) xsetggr NOM3201
  2 NOMUDA-ARCHIVE-NAME (A8) /* Name of archive type
  2 NOMUDA-ARCHIVE-NUMBER (N1) /* Archive number
  2 NOMUDA-RECORD (A252) /* Record to be written or read
  2 NOMUDA-RECORD-LENGTH (I4) /* Length of record
  2 NOMUDA-ESY-USERID (A8) /* ESY userid
  2 NOMUDA-ESY-NODE (I4) /* ESY node
  2 NOMUDA-END-OF-DATA (A3) /* Exit must set this to YES
*   when end of data is reached (revi        veand condense)
  2 NOMUDA-WORK (A250) /* Work area for exit
  2 NOMUDA-RFFU (A1/1:262) /* Reserved
END-DEFINE
