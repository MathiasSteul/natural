1 +FILE-HANDLE               (N10)
1 +LOGFILE-ID                (A120)
1 +TEMP-PATH                 (A70)
1 +P-RC                      (N4)
1 +FORCE-UNIPRINT            (L)
1 +FILE-NUMBER               (N5)
1 +DISKUNIX-SAVE             (A1000)
1 REDEFINE +DISKUNIX-SAVE
  2 #DISKUNIX-SAVE
    3  DISKUNIX-SERVICE      (A16)
    3  DISKUNIX-PATH         (A70)
    3  DISKUNIX-LOGPATH      (A70)
    3  DISKUNIX-FILENAME     (A50)
    3  DISKUNIX-FILETYPE     (A50)
    3  DISKUNIX-COMMAND      (A70)
    3  DISKUNIX-OPT1         (A32)
    3  DISKUNIX-OPT2         (A32)
    3  DISKUNIX-PARM1        (A32)
    3  DISKUNIX-PARM2        (A32)
    3  DISKUNIX-PARM3        (A32)
    3  DISKUNIX-OUTPUT-FORMAT(A16) /* (IN) desired file format:
    3  DISKUNIX-HEADER       (A50) /* (IN) enscript --header
    3  DISKUNIX-HEADER-FONT  (A50) /* (IN) enscript --header-font
    3  DISKUNIX-FOOTER       (A50) /* (IN) enscript --footer
    3  DISKUNIX-FONT         (A50) /* (IN) enscript --font
    3  DISKUNIX-LINES        (A3)  /* (IN) enscript --lines-per-page
    3  DISKUNIX-LANDSCAPE    (A1)  /* (IN) enscript -r / -R
    3  DISKUNIX-MEDIA        (A50) /* (IN) enscript -M
    3  DISKUNIX-CODEPAGE     (A50) /* (IN) enscript --encoding
    3  DISKUNIX-ADDITIONAL   (A50) /* (IN) user parameters
    3  DISKUNIX-MASK         (A50) /* (IN) mask file definition
    3  DISKUNIX-FORMATTER    (A50) /* (IN) renderer
    3  DISKUNIX-TRACE        (A1)
1 +P-OPSYS                   (A8)
1 +TOP-OF-PAGE               (L)
1 +TYPE-WELL-KNOWN           (L)
1 +AR-CC-TYPE                (B2)
1 +NOM-USE-TRIGRAPH-HTML     (L) /*see XXUX---N SU11
1 +NOM-TRIGRAPH-HTML_WRITE   (I1) /*xee XXUX---N/UEX-HTML SU13
  /*-1=subpgm not avail.=old handl. / 0=initial /1=avoid HTML conversion
************************************************************************
LOCAL USING P-PEXIT /*SU8 RMPRAPIP
LOCAL USING RCCTYP-E
LOCAL USING RMASAC-E
LOCAL USING RMMCASAP
LOCAL USING VUXDEF-L
LOCAL USING RMSPL--L
LOCAL USING RMSR---E
LOCAL USING RCONV--P
LOCAL USING XXHASH-P
*
LOCAL
1 ORDER-STATUS VIEW OF NRM-PRINTOUTS
  2 PO-STATUS
  2 PO-USERID
  2 PO-MSG
  2 PO-LAST-PRINTED-RECNO
  2 PO-BUNDRNB
1 ACTIVE-REPORTS VIEW OF NRM-ACTIVE-REPORTS
  2 AR-REPNAME
  2 AR-REPRNB
  2 AR-CC-TYPE
  2 AR-SPOOL-ATTRIBUTES
  2 AR-NUMBER-OF-LINES
* *****
1 #GETATTR                   (A197) /* File Attributes
1 REDEFINE #GETATTR
  2 #FILLER1                 (A13)
  2 #FILE-SIZE               (N10) /* Bytes
  2 #FILLER2                 (A172)
  2 #FILE-LOCKED             (A1)
1 I                          (P3)
1 J                          (P3)
1 K                          (P3)
1 #STATUS                    (A1)
1 #MSG                       (A60)
1 #UPD-COUNTER               (N8) INIT <10>
1 #SAVE-LINE                 (A251)
1 FIRST-SEGMENT-BUFFER       (L) /* the portion of an output
1 LAST-SEGMENT-BUFFER        (L)
1 FIRST-BUFFER               (L) /* the whole output
1 LAST-BUFFER                (L)
1 #DO-FORMFEED               (L)
1 #FORCE-FORMFEED            (L)
1 #NO-PRINT                  (L)
1 #FLUSH-LINE                (A251)
1 REDEFINE #FLUSH-LINE
  2 #FLUSH-CC                (A1)
  2 #FLUSH-TEXT              (A250)
1 #IND                       (I4)
1 #PO-USERID                 (A8)
1 #BYTES                     (P11)
1 #REPORT-RNB                (A31)
1 REDEFINE #REPORT-RNB
  2 #REPNAME                 (A25)
  2 #REPRNB                  (P11)
1 #UX-FUNCTION               (A8)
1 #POS                       (P3)
1 #LEN                       (P3)
1 #NUM                       (I2)
1 #SEARCH                    (A50)
1 #LINE                      (A251)
1 #LINE-CHECK                (A251)
1 #TEMPNAME                  (A34)
1 #TIMESTAMP                 (A20)
1 #HEX                       (A1)   CONST <'H'>
1 #FLUSH-POID-A              (A7)
1 #FLUSH-RNB-A               (A11)
1 #PO-BUNDRNB-A              (A11)
1 #NPR-TRACE-INT             (I2)
1 #STACK-FUNCTION            (A10)
1 #STACK-RC                  (N1)
1 #TRACE-MSG                 (A250)
1 #TRACING                   (L)
1 #INSERT-FILENAME           (L)
1 #P-ERROR-TEXT              (A250)
1 #P-ERROR-CODE              (N4)
1 #FILE-NUMBER               (A9)
1 #FILETYPE                  (A50)
1 #FILETYPE_LOW              (A50)
1 #LASTPROG                  (A8)
1 #P-FILE-NAME               (A250)
1 #P-TARGET-FILE             (A200)
1 #FLUSH-LINES               (I4)
1 #LINES                     (I4)
1 #SYMBOLS                   (A) DYNAMIC
1 #ERC                       (N4)
1 #I                         (I4)
1 #EXTENSIONS                (A10/14)
  INIT <'ps','eps','pdf','prn','jpg','jpeg',
  'png','bmp','rtf','htm','html','tif','tiff','txt'>
1 #FILE-ID                   (A) DYNAMIC
1 #PATH                      (A) DYNAMIC
1 #FILE-PATH                 (A) DYNAMIC
1 #FILE-NAME                 (A) DYNAMIC
1 #FILE-NAME2                (A) DYNAMIC
1 #FILE-TYPE                 (A) DYNAMIC
1 #FILE-ID-SUF               (A) DYNAMIC
1 #LOGFILE-ID                (A) DYNAMIC
1 #RC                        (N4)
1 #BIN-ALLOWED               (L) CONST <TRUE> /*SU8
1 #BS2-ALLOWED               (L) CONST <FALSE> /*SU8
1 #NOM-USE-TRIGRAPH-HTML     (L) /*SU11
1 NOMCHCKP-PARMS /*SU13 ->
  2 #OBJ     (A8)
  2 ERC      (N4)
  2 ERT      (A250)
  2 #LIB     (A8)
1 #AVOID-TRIGRAPH-HTML_READ  (I1)
1 #AVOID-TRIGRAPH-HTML_WRITE (I1) /*SU13 <-
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
FORMAT (0) PS=0 LS=250
*
RESET +NOM-USE-TRIGRAPH-HTML /*SU11
IF FLUSH-PARMS.DISKUNIX-TRACE ='1' OR='Y'
  #NPR-TRACE-INT := *LEVEL + 1
  #TRACING       := TRUE
END-IF
#TIMESTAMP := +HEX-TIMESTAMP
IF #TIMESTAMP = ' '
  PERFORM SATTIMST-GET-TIME #HEX #TIMESTAMP
END-IF
COMPRESS 'nomout-' *PID '-' #TIMESTAMP '-' TO #TEMPNAME LEAVING NO
PERFORM XXLSLEVL-GET-LAST-LEVEL #LASTPROG
#UX-FUNCTION := 'INFO'
PERFORM UNIX-FUNCTION
IF P-ERROR-CODE NE 0
  ESCAPE ROUTINE
END-IF
ADD 1 TO FLUSH-BUFFERS
ADD 1 TO FLUSH-COUNTER
*
DECIDE FOR EVERY CONDITION
  WHEN FLUSH-SEG-BRACKET = 'L' OR = 'A'
    LAST-SEGMENT-BUFFER := TRUE
  WHEN FLUSH-SEG-BRACKET = 'F' OR = 'A'
    FIRST-SEGMENT-BUFFER := TRUE
  WHEN FLUSH-SEGMENT = 'L' OR = 'A' AND FLUSH-SEG-BRACKET = 'L' OR = 'A'
  AND FLUSH-BRACKET = 'L'                                             /*
    LAST-BUFFER := TRUE
  WHEN FLUSH-SEGMENT = 'F' OR = 'A' AND FLUSH-SEG-BRACKET = 'F' OR = 'A'
    FIRST-BUFFER := TRUE
  WHEN NONE IGNORE
END-DECIDE
*
IF +DISKUNIX-SAVE = ' ' OR  FIRST-SEGMENT-BUFFER
  MOVE BY NAME DISKUNIX-ATTRIBUTES TO #DISKUNIX-SAVE
END-IF
*
IF FLUSH-PARMS.DISKUNIX-TRACE ='1' OR='Y'
  MOVE EDITED LAST-SEGMENT-BUFFER (EM=FALSE/TRUE) TO #TRACE-MSG
  COMPRESS 'Bracketing:' *LINE 'FLUSH-SEG-BRACKET:' FLUSH-SEG-BRACKET
    '- FLUSH-BRACKET:' FLUSH-BRACKET '- FLUSH-SEGMENT:' FLUSH-SEGMENT
    '- FLUSH-SEG-BRACKET:' FLUSH-SEG-BRACKET
    '- FLUSH-CC-TYPE:' FLUSH-CC-TYPE
    '- LAST-SEGMENT-BUFFER:' #TRACE-MSG TO #TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
  END TRANSACTION
END-IF
IF FIRST-SEGMENT-BUFFER /*extra files for each report portion (segment)
  PERFORM PRINTER-OPEN
  IF P-ERROR-CODE NE 0 OR FLUSH-ERROR
    ESCAPE ROUTINE
  END-IF
END-IF
*
FOR. FOR I = 1 TO LINE-CURRENT
  PERFORM CALL-PRINTER-EXIT /* and print the line
  DECIDE FOR EVERY CONDITION
    WHEN P-ERROR-CODE NE 0                         ESCAPE ROUTINE
    WHEN LAST-SEGMENT-BUFFER AND I = LINE-CURRENT  PERFORM PRINTER-CLOSE
    WHEN NONE IGNORE
  END-DECIDE
END-FOR
IF FLUSH-PARMS.DISKUNIX-TRACE ='1' OR='Y'
  COMPRESS 'Bracketing:' *LINE  'FLUSH-SEG-BRACKET:' FLUSH-SEG-BRACKET
    '- FLUSH-BRACKET:' FLUSH-BRACKET '- FLUSH-SEGMENT:' FLUSH-SEGMENT
    '- FLUSH-SEG-BRACKET:' FLUSH-SEG-BRACKET
    '- FLUSH-CC-TYPE:' FLUSH-CC-TYPE TO #TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
  END TRANSACTION
END-IF
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE UPDATE-STATUS
************************************************************************
IF FLUSH-PARMS.DISKUNIX-TRACE = '1' OR='Y'
  COMPRESS 'Update-Status: FLUSH-POID:' FLUSH-POID
    '- FLUSH-LINES:' FLUSH-LINES '- calc. lines:' #LINES
    '- #STATUS:' #STATUS '- #MSG:' #MSG '- PO-USERID:' PO-USERID
    TO #TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
  END TRANSACTION
END-IF
IF FLUSH-POID = 0
  ESCAPE ROUTINE
END-IF
*
FNDOS. FIND ORDER-STATUS WITH PO-ID = FLUSH-POID
  PO-STATUS := #STATUS
  PO-MSG    := #MSG
  IF +AR-CC-TYPE = BINARY
    #P-FILE-NAME    := P-FILE-NAME
    #P-TARGET-FILE  := P-TARGET-FILE
    +FILE-HANDLE    := P-FILE-HANDLE
    #STACK-FUNCTION := 'PUSH' /* get parameter for XXUX---N back
    CALLNAT 'XXUXST-N' #STACK-FUNCTION #STACK-RC XXUX---P
    IF #STACK-RC NE 0
      P-ERC := 5
      COMPRESS *PROGRAM 'Internal error: Stack overflow' *LINE TO P-ERT
    END-IF
    IF #UX-FUNCTION = 'CLOSE'
      #FILE-LOCKED        := '-' /* avoid lsof utility in NPR Unix
      XXUX---P.P-RECORD   := #GETATTR
      #UX-FUNCTION := 'GETATTR'
      P-FILE-NAME  := +FILE-ID
      PERFORM UNIX-FUNCTION
      IF P-ERROR-CODE = 0
        #GETATTR := XXUX---P.P-RECORD
        PO-LAST-PRINTED-RECNO := #FILE-SIZE / 1024 + 1
        UPDATE (FNDOS.)
      END-IF
    END-IF
    #STACK-FUNCTION := 'POP' /* get parameter for XXUX---N back
    CALLNAT 'XXUXST-N' #STACK-FUNCTION #STACK-RC XXUX---P
    IF #STACK-RC NE 0
      P-ERC := 5
      COMPRESS *PROGRAM 'Internal error: Stack overflow' *LINE TO P-ERT
    END-IF
    XXUX---P.P-FILE-NAME   := #P-FILE-NAME
    XXUX---P.P-TARGET-FILE := #P-TARGET-FILE
    XXUX---P.P-FILE-HANDLE := +FILE-HANDLE
  ELSE
    PO-LAST-PRINTED-RECNO := FLUSH-LINES
  END-IF
  #PO-USERID := PO-USERID
  UPDATE (FNDOS.)
  END OF TRANSACTION
END-FIND
*
END-SUBROUTINE /* UPDATE-STATUS
*
************************************************************************
DEFINE SUBROUTINE PRINTER-OPEN
************************************************************************
IF FIRST-BUFFER
  DECIDE FOR EVERY CONDITION
    WHEN +FILE-HANDLE NE 0 AND P-FILE-HANDLE = 0
      P-FILE-HANDLE := +FILE-HANDLE
    WHEN P-FILE-HANDLE NE 0
      #UX-FUNCTION := 'CLOSE'
      PERFORM UNIX-FUNCTION
    WHEN NONE IGNORE
  END-DECIDE
  RESET +PRINTER_OPEN +FILE-HANDLE P-FILE-HANDLE +FILE-NUMBER +FILE-TYPE
    +FILE-TYPE-TEMP +FORCE-UNIPRINT +TOP-OF-PAGE +TYPE-WELL-KNOWN
    +TEMP-PATH
  REDUCE DYNAMIC +FILE-ID-SUF TO 0
  REDUCE DYNAMIC +FILE-ID     TO 0
  IF #TRACING
    COMPRESS 'Opening output with parameters:'
      'Service:'      FLUSH-PARMS.DISKUNIX-SERVICE
      '- command:'    FLUSH-PARMS.DISKUNIX-COMMAND
      '- opt1:'       FLUSH-PARMS.DISKUNIX-OPT1
      '- opt2:'       FLUSH-PARMS.DISKUNIX-OPT2
      '- parm1:'      FLUSH-PARMS.DISKUNIX-PARM1
      '- parm2:'      FLUSH-PARMS.DISKUNIX-PARM2
      '- parm3:'      FLUSH-PARMS.DISKUNIX-PARM3
      '- format:'     FLUSH-PARMS.DISKUNIX-OUTPUT-FORMAT
      '- formatter:'  FLUSH-PARMS.DISKUNIX-FORMATTER
      '- header:'     FLUSH-PARMS.DISKUNIX-HEADER
      '- hd-font:'    FLUSH-PARMS.DISKUNIX-HEADER-FONT
      '- footer:'     FLUSH-PARMS.DISKUNIX-FOOTER
      '- font:'       FLUSH-PARMS.DISKUNIX-FONT
      '- lines:'      FLUSH-PARMS.DISKUNIX-LINES
      '- landscape:'  FLUSH-PARMS.DISKUNIX-LANDSCAPE
      '- media:'      FLUSH-PARMS.DISKUNIX-MEDIA
      '- codepage:'   FLUSH-PARMS.DISKUNIX-CODEPAGE
      '- additional:' FLUSH-PARMS.DISKUNIX-ADDITIONAL
      '- mask:'       FLUSH-PARMS.DISKUNIX-MASK TO #TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
  END-IF
END-IF
ADD 1 TO  +FILE-NUMBER
END TRANSACTION
IF +FILE-NUMBER = 1
  +TOP-OF-PAGE := TRUE
ELSE
  IF NOT +TOP-OF-PAGE AND (FLUSH-PARMS.DISKUNIX-OUTPUT-FORMAT = ' '
  AND (NOT +TYPE-WELL-KNOWN OR +FILE-TYPE = +FILE-TYPE-TEMP))         /*
    #FORCE-FORMFEED := TRUE
  ELSE
    #FORCE-FORMFEED := FALSE
  END-IF
END-IF
PERFORM GET-SPOOL-ATTRIBUTES
IF FLUSH-ERROR
  ESCAPE ROUTINE
END-IF
IF #TRACING
  COMPRESS 'Path:' FLUSH-PARMS.DISKUNIX-PATH
    '- filename:'  FLUSH-PARMS.DISKUNIX-FILENAME
    '- type:' FLUSH-PARMS.DISKUNIX-FILETYPE
    '- file-id:'  +FILE-ID-SUF TO #TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
END-IF
P-FILE-NAME := +FILE-ID-SUF
#UX-FUNCTION := 'OPEN'
PERFORM UNIX-FUNCTION
+PRINTER_OPEN := TRUE
END TRANSACTION
*
END-SUBROUTINE /* PRINTER-OPEN
*                                                                       -
************************************************************************
DEFINE SUBROUTINE PRINT-IT
************************************************************************
*** Handle carriage control for TYPE=AL. (TYPE=AL reports may contain
*** a micture of ASA, Machine, and no carriage control).
*** 1. If first character is a valid ASA carriage control, do nothing
*** 2. If first character is printable (but not X'89' or X'8B' which
***    are machine skip to channel 1), assume the record has no
***    carriage control - shift the record right 1 position and put a
***    space in column 1.
*** 3. Otherwise, first character must be machine carriage control so
***    translate it to ASA.
*
IF FLUSH-TYPE-AL = 'Y'
  #FLUSH-LINE  := LINE(I)
  EXAMINE FULL RMASAC-ASA-CODES(*) FOR #FLUSH-CC INDEX #IND
  IF #IND = 0                            /* not ASA
    IF #FLUSH-CC = MASK(P) AND #FLUSH-CC NE H'89' AND #FLUSH-CC NE H'8B'
      RESET #FLUSH-CC
      #FLUSH-TEXT:= LINE(I)
      LINE(I):= #FLUSH-LINE
      RESET FLUSH-SAVE-CC
    ELSE
      RMMCASA-PARMS.P-RECORD := LINE (I)
      RMMCASA-PARMS.P-PREV-CC := FLUSH-SAVE-CC
      CALLNAT 'RMMCASAN' RMMCASA-PARMS
      FLUSH-SAVE-CC := RMMCASA-PARMS.P-PREV-CC
      IF RMMCASA-PARMS.P-PRINT-NUMBER > 0
        LINE (I) := RMMCASA-PARMS.P-RECORD
      ELSE
        ESCAPE ROUTINE
      END-IF
    END-IF
  ELSE
    RESET FLUSH-SAVE-CC
  END-IF
ELSE
  DECIDE ON  FIRST VALUE OF FLUSH-CC-TYPE
    VALUE MACHINE-CODE
      PERFORM MACHINE-TO-ASA
    VALUE NO-CC
      PERFORM NO-CC-TO-ASA
    NONE IGNORE
  END-DECIDE
END-IF
DECIDE FOR EVERY CONDITION
  WHEN FLUSH-CC-TYPE NE BINARY OR #LASTPROG ='RMSPFL-N' OR='RMBVFL-N'
    PERFORM ASA-TO-NO-CC /*sep page=txt
  WHEN FLUSH-CC-TYPE NE BINARY
    ADD 1 TO FLUSH-LINES
  WHEN FLUSH-CC-TYPE = BINARY
    EXAMINE LINE (I) FOR ' ' LENGTH #BYTES
    ADD #BYTES TO FLUSH-LINES
  WHEN NONE IGNORE
END-DECIDE
IF FLUSH-COUNTER > #UPD-COUNTER OR LAST-BUFFER
  #STATUS := 'P'
  PERFORM UPDATE-STATUS
  RESET FLUSH-COUNTER
END-IF
*
IF #NO-PRINT
  ESCAPE ROUTINE
END-IF
IF LINE(I) = '??+' /* empty line on top of page
  +TOP-OF-PAGE := TRUE
ELSE
  RESET +TOP-OF-PAGE
END-IF
*
P-FILE-NAME       := +FILE-ID-SUF
XXUX---P.P-RECORD := LINE(I)
#UX-FUNCTION      := 'WRITE'
PERFORM UNIX-FUNCTION
END TRANSACTION
*
END-SUBROUTINE /* PRINT-IT
*
************************************************************************-
DEFINE SUBROUTINE PRINTER-CLOSE
************************************************************************
P-FILE-NAME := +FILE-ID-SUF
#UX-FUNCTION := 'CLOSE'
PERFORM UNIX-FUNCTION
END TRANSACTION
IF P-ERROR-CODE = 0
  IF LAST-BUFFER
    RESET P-ERROR-CODE P-ERROR-TEXT
    DECIDE ON EVERY VALUE OF P-ERROR-CODE
      VALUE 0
        DECIDE FOR FIRST CONDITION
          WHEN +FILE-NUMBER > 1
            IF #TRACING
              COMPRESS 'Executing conversion: Number of files is'
                +FILE-NUMBER TO #TRACE-MSG
              PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
            END-IF
            PERFORM EXEC-CONVERSION
          WHEN FLUSH-PARMS.DISKUNIX-OUTPUT-FORMAT NE ' '
/*SU9         OR (+TYPE-WELL-KNOWN AND +FILE-TYPE NE +FILE-TYPE-TEMP)
          AND ((+TYPE-WELL-KNOWN AND +FILE-TYPE NE +FILE-TYPE-TEMP)/*SU9
          OR (NOT +TYPE-WELL-KNOWN AND +FILE-TYPE=' '              /*SU9
          AND +FILE-TYPE-TEMP=' '))                                /*SU9
            IF #TRACING
              MOVE EDITED +TYPE-WELL-KNOWN(EM=FALSE/TRUE) TO #TRACE-MSG
              COMPRESS 'Executing conversion: Well_known_type:'
                #TRACE-MSG '- file_type:' +FILE-TYPE
                '- file_type_temp:' +FILE-TYPE-TEMP TO #TRACE-MSG
              PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
            END-IF
            PERFORM EXEC-CONVERSION
          WHEN NONE
            P-FILE-NAME := +FILE-ID-SUF
            IF +FILE-ID = SCAN ('?') /* it's a short name
              P-SHORT-NAME := +FILE-ID
              EXAMINE P-SHORT-NAME FOR +FILE-PATH AND DELETE
              PERFORM GET-LONG-NAME
              COMPRESS +FILE-PATH P-LONG-NAME TO
                P-TARGET-FILE LEAVING NO
            ELSE
              P-TARGET-FILE := +FILE-ID
            END-IF
            IF P-TARGET-FILE = ' '
              P-TARGET-FILE := +FILE-ID
            END-IF
            #UX-FUNCTION  := 'MOVE'
            PERFORM UNIX-FUNCTION
            IF P-ERROR-CODE = 2036  /* BLI1
            OR P-ERROR-TEXT = SCAN('3339') /* file already moved      /*
              RESET P-ERC P-ERT P-ERROR-CODE P-ERROR-TEXT
            END-IF
            END TRANSACTION
        END-DECIDE
      VALUE 0
        COMPRESS +TEMP-PATH '/' #TEMPNAME TO #FILE-ID LEAVING NO
        PERFORM CHECK-FILENAME
        COMPRESS #FILE-ID '*' TO P-FILE-NAME LEAVING NO
        #UX-FUNCTION := 'DELETE'
        PERFORM UNIX-FUNCTION
        END TRANSACTION
        RESET P-ERROR-CODE P-ERROR-TEXT P-OUTPUT-MODE /*ign err here
      VALUE 0
        PERFORM EXEC-COMMAND
      VALUE 0
        RESET +FILE-NUMBER +TOP-OF-PAGE
        IF #TRACING
          #NPR-TRACE-INT := 0
          #TRACE-MSG := 'Output closed with RC 0'
          PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
          END TRANSACTION
        END-IF
      VALUE 0
        #STATUS := 'P'
        PERFORM UPDATE-STATUS
        END TRANSACTION
      NONE IGNORE
    END-DECIDE
  ELSE
/*SU10  #TRACE-MSG := 'Portion file closed with RC 0'
/*SU10  PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    END TRANSACTION
    #NPR-TRACE-INT := 0
  END-IF
END-IF
IF P-ERROR-CODE NE 0
  IF #TRACING
    COMPRESS 'Printing abended with return code'
      P-ERROR-CODE P-ERROR-TEXT TO #TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    END TRANSACTION
  END-IF
END-IF
RESET +PRINTER_OPEN XXUX---P +FILE-HANDLE P-FILE-HANDLE P-STATUS P-ERC
  P-PROCESS-ID P-EXIT-CODE #MR-P-POSITION #XS-FIRW-LINE-NUMBER #EOF
  +P-RC
*
END-SUBROUTINE /* PRINTER-CLOSE
*
************************************************************************
DEFINE SUBROUTINE ASA-TO-NO-CC
************************************************************************
#NOM-USE-TRIGRAPH-HTML := TRUE /*for XXUX---N SU11
RESET #LINE
IF +P-OPSYS = SCAN('WIN')
  DECIDE ON FIRST VALUE OF LINE-L(I,1)
    VALUE '1'                 /* form feed
      #LINE := H'0C'
      +TOP-OF-PAGE := TRUE
    VALUE '-'                 /* 3 line feeds
      #LINE := H'0D0A0D0A0D0A'
    VALUE '0'                 /* 2 line feeds
      #LINE := H'0D0A0D0A'
    NONE IGNORE
  END-DECIDE
ELSE
  DECIDE ON FIRST VALUE OF LINE-L(I,1)
    VALUE '1'
      #LINE := H'0C'     /* form feed
      +TOP-OF-PAGE := TRUE
    VALUE '-'
      #LINE := H'0A0A0A' /* 3 line feeds
    VALUE '0'
      #LINE := H'0A0A'   /* 2 line feeds
    NONE IGNORE
  END-DECIDE
END-IF
IF #LINE NE ' ' OR *CODEPAGE NE ' ' /*convert ASA and/or text SU11
  PERFORM CHECK-HTML-TRIGRAPH /*WRITE SU13
  IF *CODEPAGE NE ' ' /*convert text trigraph/HTML
  OR +NOM-TRIGRAPH-HTML_WRITE = 1 /*use trigraph / no HTML SU13       /*
    COMPRESS #LINE SUBSTR(LINE(I),2) TO #LINE LEAVING NO
  END-IF
  IF +NOM-TRIGRAPH-HTML_WRITE = 1 /*new: use trigraph / no HTML SU13
**INCLUDE #SU-C-DE
**    PRINT *DAT4I *TIME(AL=8) '1a' #LINE
    CALLNAT 'XXCPAGT' #LINE
**    PRINT *DAT4I *TIME(AL=8) '1b' #LINE
  ELSE /*old: use trigraph and HTML
    /*there is no HTML enconding, so nothing to do here - see XXUX---N Ü
    CALLNAT 'XXCPAGE' 'T' #LINE #ERC #TRACE-MSG 2X #TRACING
    IF #TRACING OR #ERC NE 0 /*SU11 error handling ??
      PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
      END TRANSACTION
      RESET #ERC #TRACE-MSG P-ERROR-CODE P-ERROR-TEXT
    END-IF
  END-IF
  IF *CODEPAGE = ' ' AND +NOM-TRIGRAPH-HTML_WRITE NE 1 /*SU13
    COMPRESS #LINE SUBSTR(LINE(I),2) TO #LINE LEAVING NO
  END-IF
ELSE
  #LINE := LINE(I)
END-IF
/* Now suppress formfeeds at the beginning and the very end
IF FLUSH-PARMS.DISKUNIX-OUTPUT-FORMAT NE ' '
OR (+TYPE-WELL-KNOWN AND +FILE-TYPE NE +FILE-TYPE-TEMP)               /*
  RESET #NO-PRINT
  K := I + 1
  IF FIRST-BUFFER
    IF NOT #DO-FORMFEED AND #LINE = MASK('??+')
      EXAMINE #LINE FOR '??+' AND DELETE FIRST
      IF #LINE = ' '
        #NO-PRINT := TRUE
      END-IF
    ELSE
      #DO-FORMFEED := TRUE
    END-IF
  END-IF
  IF FIRST-SEGMENT-BUFFER AND I = 1 AND #LINE = MASK('??+')
    EXAMINE #LINE FOR '??+' AND DELETE FIRST
  END-IF
  IF LAST-BUFFER AND #LINE = '??+'
    FORJ. FOR J = K TO LINE-CURRENT
      IF LINE(J) NE '1'
        ESCAPE BOTTOM (FORJ.)
      END-IF
    END-FOR
    IF J > LINE-CURRENT
      LINE-CURRENT := I
      #NO-PRINT := TRUE /* no formfeeds, get out of (FOR.)
    END-IF
  END-IF
END-IF
/* Now ensure that all document portions are on different pages
IF #FORCE-FORMFEED AND I=1 AND #LINE NE MASK('??+')
  COMPRESS '??+' #LINE TO #LINE LEAVING NO
END-IF
RESET #FORCE-FORMFEED
IF FIRST-SEGMENT-BUFFER AND I=2 AND LINE(1) ='??+' AND #LINE=MASK('??+')
  EXAMINE #LINE FOR '??+' AND DELETE FIRST
END-IF
IF FLUSH-PARMS.DISKUNIX-FORMATTER = 'auto'
  #LINE-CHECK := #LINE
  IF #LINE-CHECK = SCAN('&euro;')
    +FORCE-UNIPRINT := TRUE
  ELSE
    LCHECK. REPEAT
      EXAMINE #LINE-CHECK FOR '&#x00' REPLACE '&#x' POSITION #POS
      IF #POS NE 0
        #LINE-CHECK := SUBSTR(#LINE-CHECK,#POS)
        EXAMINE #LINE-CHECK FOR ';' POSITION #LEN
        IF #LEN > 6 OR #LEN < 1
          +FORCE-UNIPRINT := TRUE /* more than one byte character
          ESCAPE BOTTOM (LCHECK.)
        END-IF
        #LINE-CHECK := SUBSTR(#LINE-CHECK,#LEN)
      END-IF
      UNTIL #POS = 0
    END-REPEAT
  END-IF
END-IF
LINE(I) := #LINE
*
END-SUBROUTINE /* ASA-TO-NO-CC
*
************************************************************************
DEFINE SUBROUTINE MACHINE-TO-ASA
************************************************************************
RMMCASA-PARMS.P-RECORD := LINE (I)
RMMCASA-PARMS.P-PREV-CC := FLUSH-SAVE-CC
CALLNAT 'RMMCASAN' RMMCASA-PARMS
FLUSH-SAVE-CC := RMMCASA-PARMS.P-PREV-CC
IF RMMCASA-PARMS.P-PRINT-NUMBER > 0
  LINE (I) := RMMCASA-PARMS.P-RECORD
ELSE
  ESCAPE ROUTINE
END-IF
*
END-SUBROUTINE /* MACHINE-TO-ASA
*
************************************************************************-
DEFINE SUBROUTINE NO-CC-TO-ASA
************************************************************************
COMPRESS '&' LINE(I) TO LINE(I) LEAVING NO
EXAMINE LINE(I) FOR '&' AND REPLACE FIRST WITH ' '
*
END-SUBROUTINE /* NO-CC-TO-ASA
*
************************************************************************-
DEFINE SUBROUTINE GET-FILENAME
************************************************************************
DECIDE ON FIRST VALUE OF #SPOOL-TYPE
  VALUE DIRECT-INPUT
    IF FLUSH-PARMS.DISKUNIX-FILENAME = ' ' AND #SPOOL-DI-FILENAME NE ' '
      FLUSH-PARMS.DISKUNIX-FILENAME := #SPOOL-DI-FILENAME
    END-IF
    IF FLUSH-PARMS.DISKUNIX-FILETYPE = ' '
      FLUSH-PARMS.DISKUNIX-FILETYPE := #SPOOL-DI-FILETYPE
    END-IF
  VALUE SEQUENTIAL-FILE-UNIX /*Separate path/filename.filetype
    IF FLUSH-PARMS.DISKUNIX-FILENAME = ' '
      RESET FLUSH-PARMS.DISKUNIX-FILENAME FLUSH-PARMS.DISKUNIX-FILETYPE
      PERFORM XXCHKFN-CHECK-FILENAME #SPOOL-UNIX-FILE-NAME #RC #PATH
        FLUSH-PARMS.DISKUNIX-FILENAME FLUSH-PARMS.DISKUNIX-FILETYPE
      IF #RC > 1
        FLUSH-ERROR := TRUE
        P-ERROR-CODE := 1121
        P-ERROR-TEXT := #SPOOL-UNIX-FILE-NAME
        ESCAPE ROUTINE
      END-IF
      IF FLUSH-PARMS.DISKUNIX-PATH = ' '
        FLUSH-PARMS.DISKUNIX-PATH := #PATH
      END-IF
    END-IF
  NONE
    IF FLUSH-BUNDLE NE ' '
      COMPRESS FLUSH-BUNDLE '-' FLUSH-BUNDRNB
        TO FLUSH-PARMS.DISKUNIX-FILENAME LEAVING NO
    ELSE
      COMPRESS AR-REPNAME '-' AR-REPRNB
        TO FLUSH-PARMS.DISKUNIX-FILENAME LEAVING NO
    END-IF
END-DECIDE
*
END-SUBROUTINE /* GET-FILENAME
*
************************************************************************-
DEFINE SUBROUTINE GET-SPOOL-ATTRIBUTES
************************************************************************
MOVE BY NAME #DISKUNIX-SAVE TO DISKUNIX-ATTRIBUTES
EXAMINE FLUSH-PARMS.DISKUNIX-FORMATTER TRANSLATE INTO LOWER
IF NOT (FLUSH-PARMS.DISKUNIX-FORMATTER
    = 'uniprint' OR = 'enscript' OR = 'auto')
  FLUSH-PARMS.DISKUNIX-FORMATTER := 'auto'
END-IF
FNDPO. FIND ORDER-STATUS WITH PO-ID = FLUSH-POID
  IF FLUSH-POID = 0
    ESCAPE BOTTOM
  END-IF
  RESET ACTIVE-REPORTS
  #REPNAME := FLUSH-REPNAME
  #REPRNB  := FLUSH-REPRNB
  FNDAR. FIND ACTIVE-REPORTS WITH AR-REPORT-RNB = #REPORT-RNB
    #SPOOL-ATTRIBUTES := AR-SPOOL-ATTRIBUTES
    +AR-CC-TYPE := ACTIVE-REPORTS.AR-CC-TYPE
    IF FLUSH-PARMS.DISKUNIX-FILENAME NE ' '
      ESCAPE BOTTOM
    END-IF
    PERFORM GET-FILENAME
    IF FLUSH-ERROR
      ESCAPE ROUTINE
    END-IF
    IF FLUSH-PARMS.DISKUNIX-PATH = ' '
      FLUSH-PARMS.DISKUNIX-PATH := '$EOM_WORK'
    END-IF
    IF +AR-CC-TYPE = BINARY
      #UX-FUNCTION := 'GETATTR'
      P-FILE-NAME  := +FILE-ID
      PERFORM UNIX-FUNCTION
      IF P-ERROR-CODE = 0
        #GETATTR := XXUX---P.P-RECORD
        PO-LAST-PRINTED-RECNO := #FILE-SIZE
        UPDATE (FNDPO.)
        END TRANSACTION
      END-IF
    END-IF
  END-FIND
END-FIND
*
* Build file-id
*
*
* Get the path and filename first
*
#LINES  := AR-NUMBER-OF-LINES * FLUSH-COPIES
COMPRESS '&LIN=' #LINES TO #SYMBOLS LEAVING NO
IF FLUSH-PARMS.DISKUNIX-FILENAME = ' '
  IF FLUSH-BUNDLE NE ' '
    COMPRESS FLUSH-BUNDLE '-' FLUSH-BUNDRNB
      TO FLUSH-PARMS.DISKUNIX-FILENAME LEAVING NO
  ELSE
    COMPRESS FLUSH-REPNAME '-' FLUSH-REPRNB
      TO FLUSH-PARMS.DISKUNIX-FILENAME LEAVING NO
  END-IF
END-IF
+FILE-ID := FLUSH-PARMS.DISKUNIX-PATH
IF FLUSH-PARMS.DISKUNIX-PATH NE ' '
  EXAMINE +FILE-ID FOR '/' LENGTH #LEN
  IF SUBSTR(+FILE-ID,#LEN,1) NE '/'
    COMPRESS +FILE-ID '/' TO +FILE-ID  LEAVING NO
  END-IF
END-IF
IF +TEMP-PATH = ' '
  PERFORM GET-NODE
END-IF
+FILE-PATH   := +FILE-ID
+FILE-ID-SUF := +TEMP-PATH
P-SHORT-NAME := FLUSH-PARMS.DISKUNIX-FILENAME
PERFORM GET-LONG-NAME
COMPRESS +FILE-ID P-LONG-NAME TO +FILE-ID LEAVING NO
#FILE-ID := +FILE-ID
PERFORM RMFL---S-SUBSTITUTE-SYMBOLS FLUSH-PARMS #FILE-ID
  #SPOOL-ATTRIBUTES #SYMBOLS
+FILE-ID := #FILE-ID
#FILE-NAME := FLUSH-PARMS.DISKUNIX-FILENAME
PERFORM RMFL---S-SUBSTITUTE-SYMBOLS FLUSH-PARMS #FILE-NAME
  #SPOOL-ATTRIBUTES #SYMBOLS
+FILE-NAME := #FILE-NAME
MOVE EDITED +FILE-NUMBER (EM=99999) TO #FILE-NUMBER
COMPRESS +FILE-ID-SUF #TEMPNAME #FILE-NUMBER TO +FILE-ID-SUF LEAVING NO
*
* Now get the file type
*
RESET #FILETYPE
IF FLUSH-PARMS.DISKUNIX-FILETYPE NE ' '
  COMPRESS +FILE-ID '.' FLUSH-PARMS.DISKUNIX-FILETYPE
    TO +FILE-ID LEAVING NO
  #FILE-ID := +FILE-ID
  PERFORM RMFL---S-SUBSTITUTE-SYMBOLS FLUSH-PARMS #FILE-ID
    #SPOOL-ATTRIBUTES #SYMBOLS
  +FILE-ID := #FILE-ID
  +FILE-TYPE := FLUSH-PARMS.DISKUNIX-FILETYPE
  #FILE-TYPE := +FILE-TYPE
  PERFORM RMFL---S-SUBSTITUTE-SYMBOLS FLUSH-PARMS #FILE-TYPE
    #SPOOL-ATTRIBUTES #SYMBOLS
  +FILE-TYPE := #FILE-TYPE
  IF #LASTPROG ='RMSPFL-N' OR='RMBVFL-N' /*sep. page
      OR FLUSH-CC-TYPE NE BINARY
    COMPRESS +FILE-ID-SUF '.txt' TO +FILE-ID-SUF LEAVING NO
    +FILE-TYPE-TEMP := 'txt'
  ELSE
    DECIDE ON FIRST VALUE OF #SPOOL-TYPE
      VALUE DIRECT-INPUT
        +FILE-TYPE-TEMP := #SPOOL-DI-FILETYPE
      VALUE SEQUENTIAL-FILE-UNIX
        RESET +FILE-TYPE-TEMP
        EXAMINE DIRECTION BACKWARD #SPOOL-UNIX-FILE-NAME FOR '.'
          POSITION #POS LENGTH #LEN
        IF #POS < #LEN AND #POS > 0
          ADD 1 TO #POS
          +FILE-TYPE-TEMP := SUBSTR(#SPOOL-UNIX-FILE-NAME,#POS)
        END-IF
      NONE IGNORE
    END-DECIDE
    IF +FILE-TYPE-TEMP NE ' '
      COMPRESS +FILE-ID-SUF '.' +FILE-TYPE-TEMP
        TO +FILE-ID-SUF LEAVING NO
    END-IF
    EXAMINE +FILE-TYPE-TEMP TRANSLATE INTO LOWER
  END-IF
ELSE
  IF FLUSH-CC-TYPE = BINARY
    DECIDE ON FIRST VALUE OF #SPOOL-TYPE
      VALUE DIRECT-INPUT
        #FILETYPE := #SPOOL-DI-FILETYPE
        +FILE-TYPE := #SPOOL-DI-FILETYPE
        +FILE-TYPE-TEMP := +FILE-TYPE
      VALUE SEQUENTIAL-FILE-UNIX
        EXAMINE DIRECTION BACKWARD #SPOOL-UNIX-FILE-NAME FOR '.'
          POSITION #POS LENGTH #LEN
        IF #POS < #LEN AND #POS > 0
          #POS := #POS + 1
          #FILETYPE := SUBSTR(#SPOOL-UNIX-FILE-NAME,#POS)
          +FILE-TYPE := #FILETYPE
          +FILE-TYPE-TEMP := +FILE-TYPE
        END-IF
      NONE IGNORE
    END-DECIDE
    IF #FILETYPE NE ' '
      +FILE-TYPE := #FILETYPE
      COMPRESS +FILE-ID '.' #FILETYPE TO +FILE-ID LEAVING NO
      IF #LASTPROG ='RMSPFL-N' OR='RMBVFL-N' /*sep. page
      OR FLUSH-CC-TYPE NE BINARY                                      /*
        COMPRESS +FILE-ID-SUF '.txt' TO +FILE-ID-SUF LEAVING NO
        +FILE-TYPE-TEMP := 'txt'
      ELSE
        COMPRESS +FILE-ID-SUF '.' #FILETYPE TO +FILE-ID-SUF LEAVING NO
        +FILE-TYPE-TEMP := #FILETYPE
      END-IF
    END-IF
  END-IF
END-IF
#FILETYPE_LOW := +FILE-TYPE
EXAMINE #FILETYPE_LOW TRANSLATE INTO LOWER
EXAMINE #EXTENSIONS(*) FOR #FILETYPE_LOW INDEX #I
IF #I NE 0
  +TYPE-WELL-KNOWN := TRUE
ELSE
  +TYPE-WELL-KNOWN := FALSE
END-IF
IF +FILE-TYPE NE ' '
  COMPRESS '.' +FILE-TYPE TO #SEARCH LEAVING NO
  REPEAT
    EXAMINE +FILE-ID FOR #SEARCH NUMBER #NUM
    IF #NUM > 1
      EXAMINE +FILE-ID FOR #SEARCH AND DELETE FIRST
    END-IF
    UNTIL #NUM < 2
  END-REPEAT
  REPEAT
    EXAMINE +FILE-NAME FOR #SEARCH NUMBER #NUM
    IF #NUM > 0
      EXAMINE +FILE-NAME FOR #SEARCH AND DELETE FIRST
    END-IF
    UNTIL #NUM < 1
  END-REPEAT
END-IF
EXAMINE +FILE-PATH   FOR '//' REPLACE '/'
EXAMINE +TEMP-PATH   FOR '//' REPLACE '/'
EXAMINE +FILE-ID-SUF FOR '//' REPLACE '/'
EXAMINE +FILE-ID     FOR '//' REPLACE '/'
IF #TRACING
  COMPRESS 'File-IDs built: ID:' +FILE-ID 'suf:' +FILE-ID-SUF
    'name:' +FILE-NAME 'type:' +FILE-TYPE TO #TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
  END TRANSACTION
END-IF
*
* Build logfile-id
*
IF FLUSH-PARMS.DISKUNIX-LOGPATH NE ' '
  +LOGFILE-ID := FLUSH-PARMS.DISKUNIX-LOGPATH
ELSE
  +LOGFILE-ID := +TEMP-PATH
END-IF
EXAMINE +LOGFILE-ID FOR '//' REPLACE '/' LENGTH #LEN
IF SUBSTR(+LOGFILE-ID,#LEN,1) NE '/'
  COMPRESS +LOGFILE-ID '/' TO +LOGFILE-ID  LEAVING NO
END-IF
COMPRESS +LOGFILE-ID FLUSH-PARMS.DISKUNIX-FILENAME *PID '.log'
  TO +LOGFILE-ID LEAVING NO
* Replace special characters
MOVE LEFT FLUSH-POID   TO #FLUSH-POID-A
MOVE LEFT FLUSH-REPRNB TO #FLUSH-RNB-A
IF #FLUSH-RNB-A = ' '
  MOVE LEFT FLUSH-BUNDRNB TO #FLUSH-RNB-A
END-IF
MOVE LEFT PO-BUNDRNB TO #PO-BUNDRNB-A
#FILE-ID-SUF := +FILE-ID-SUF
PERFORM RMFL---S-SUBSTITUTE-SYMBOLS FLUSH-PARMS #FILE-ID-SUF
  #SPOOL-ATTRIBUTES
+FILE-ID-SUF := #FILE-ID-SUF
#LOGFILE-ID := +LOGFILE-ID
PERFORM RMFL---S-SUBSTITUTE-SYMBOLS FLUSH-PARMS #LOGFILE-ID
  #SPOOL-ATTRIBUTES
+LOGFILE-ID := #LOGFILE-ID
* Ü ?????
* SU3:Line below resets FLUSH-LINES ÜÜ Order is not updated for each
* part, but for last part for each line ÜÜ MUST BE CHECKED ÜÜ
* Ü ?????
IF FLUSH-CC-TYPE = BINARY OR #FLUSH-LINES NE 0
  FLUSH-LINES := #FLUSH-LINES
END-IF
*
END-SUBROUTINE /* GET-SPOOL-ATTRIBUTES
*
************************************************************************
DEFINE SUBROUTINE UNIX-FUNCTION
************************************************************************
IF XXUX---P.P-NODE-NAME = ' '
  PERFORM GET-NODE
END-IF
XXUX---P.P-FUNCTION := #UX-FUNCTION
IF FLUSH-CC-TYPE = BINARY
  XXUX---P.P-BINARY := 'Y'
ELSE
  XXUX---P.P-BINARY := 'N'
END-IF
IF #TRACING
  COMPRESS 'Executing Unix function:' #UX-FUNCTION
    '-_Node:' P-NODE-NAME '- User:' P-USERID '- Group:' P-GROUP
    '- Node-Status:' P-NODE-SUSPEND '- Binary?' P-BINARY
    '- Record:'      SUBSTR (XXUX---P.P-RECORD,1,30)
    '- File:'        SUBSTR (XXUX---P.P-FILE-NAME,1,70) TO #TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
END-IF
*
IF #UX-FUNCTION = 'MOVE' AND P-TARGET-FILE = ' '
  COMPRESS 'Internal error: Target file is emptyÜ File name was:'
    P-FILE-NAME '*LEVEL =' *LEVEL TO #TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
  #TRACE-MSG := 'Now aborting task for error analysis'
  PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
  END TRANSACTION
  *ERROR-NR := 999 /* should not occur
END-IF
* Use AIV to control settings of NPRux switches in XXUX---N: SU13
+NOM-USE-TRIGRAPH-HTML := #NOM-USE-TRIGRAPH-HTML /*SU11
CALLNAT 'XXUX---N' XXUX---P #NPR-TRACE-INT
RESET +NOM-USE-TRIGRAPH-HTML /*SU11
IF #TRACING
  COMPRESS 'Unix function returned:' 'ERC:' XXUX---P.P-ERC
    '- ERT:'    XXUX---P.P-ERT
    '- Record:' SUBSTR (XXUX---P.P-RECORD,1,30) TO #TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
END-IF
IF P-ERC NE 0 AND #UX-FUNCTION = 'DELETE'
  RESET XXUX---P.P-ERC XXUX---P.P-ERT CONV-ERC CONV-ERT
  IF CONV-TRACING
    #TRACE-MSG := 'Error at file deletion has been ignored.'
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    END TRANSACTION
  END-IF
END-IF
P-ERROR-CODE := XXUX---P.P-ERC
P-ERROR-TEXT := XXUX---P.P-ERT
IF #UX-FUNCTION = 'INFO'
  +P-OPSYS := XXUX---P.P-OPSYS
  EXAMINE +P-OPSYS AND TRANSLATE INTO UPPER
END-IF
*
END-SUBROUTINE /* UNIX-FUNCTION
*
************************************************************************
DEFINE SUBROUTINE EXEC-COMMAND
************************************************************************
IF #TRACING
  COMPRESS 'Executing OS command'
    FLUSH-PARMS.DISKUNIX-COMMAND TO #TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
  END TRANSACTION
END-IF
#INSERT-FILENAME := TRUE
#FLUSH-LINES := FLUSH-LINES
PERFORM RMFL---S-SUBSTITUTE-SYMBOLS FLUSH-PARMS
  FLUSH-PARMS.DISKUNIX-COMMAND #SPOOL-ATTRIBUTES
EXAMINE FLUSH-PARMS.DISKUNIX-COMMAND FOR
  FLUSH-PARMS.DISKUNIX-FILENAME POSITION #POS
IF #POS NE 0
  RESET #INSERT-FILENAME
END-IF
PERFORM RMFL---S-SUBSTITUTE-SYMBOLS FLUSH-PARMS
  FLUSH-PARMS.DISKUNIX-OPT1 #SPOOL-ATTRIBUTES
EXAMINE FLUSH-PARMS.DISKUNIX-OPT1 FOR
  FLUSH-PARMS.DISKUNIX-FILENAME POSITION #POS
IF #POS NE 0
  RESET #INSERT-FILENAME
END-IF
PERFORM RMFL---S-SUBSTITUTE-SYMBOLS FLUSH-PARMS
  FLUSH-PARMS.DISKUNIX-OPT2 #SPOOL-ATTRIBUTES
EXAMINE FLUSH-PARMS.DISKUNIX-OPT2 FOR
  FLUSH-PARMS.DISKUNIX-FILENAME POSITION #POS
IF #POS NE 0
  RESET #INSERT-FILENAME
END-IF
PERFORM RMFL---S-SUBSTITUTE-SYMBOLS FLUSH-PARMS
  FLUSH-PARMS.DISKUNIX-PARM1 #SPOOL-ATTRIBUTES
EXAMINE FLUSH-PARMS.DISKUNIX-PARM1 FOR
  FLUSH-PARMS.DISKUNIX-FILENAME POSITION #POS
IF #POS NE 0
  RESET #INSERT-FILENAME
END-IF
PERFORM RMFL---S-SUBSTITUTE-SYMBOLS FLUSH-PARMS
  FLUSH-PARMS.DISKUNIX-PARM2 #SPOOL-ATTRIBUTES
EXAMINE FLUSH-PARMS.DISKUNIX-PARM2 FOR
  FLUSH-PARMS.DISKUNIX-FILENAME POSITION #POS
IF #POS NE 0
  RESET #INSERT-FILENAME
END-IF
PERFORM RMFL---S-SUBSTITUTE-SYMBOLS
  FLUSH-PARMS FLUSH-PARMS.DISKUNIX-PARM3 #SPOOL-ATTRIBUTES
EXAMINE FLUSH-PARMS.DISKUNIX-PARM3 FOR
  FLUSH-PARMS.DISKUNIX-FILENAME POSITION #POS
IF #POS NE 0
  RESET #INSERT-FILENAME
END-IF
FLUSH-LINES := #FLUSH-LINES
IF FLUSH-PARMS.DISKUNIX-COMMAND NE ' '       /* only if command defined
AND (FLUSH-PARMS.FLUSH-LAST-REPORT = 'Y'     /* and it is the last   one
OR  FLUSH-PARMS.FLUSH-BUNDLE = ' ')          /* or it was no bundle    .
  IF #INSERT-FILENAME
    XXHASH-PARMS.P-RC := 9 /* any value NE 0
    DECIDE FOR EVERY CONDITION
      WHEN +FILE-ID = SCAN ('?') /* it's a short name
        #FILE-NAME2 := +FILE-ID
        EXAMINE #FILE-NAME2 FOR +FILE-PATH AND DELETE
        XXHASH-PARMS.P-SHORT-NAME := #FILE-NAME2 /*SU4
        PERFORM GET-LONG-NAME
      WHEN XXHASH-PARMS.P-RC = 0
        COMPRESS +FILE-PATH XXHASH-PARMS.P-LONG-NAME
          TO XXHASH-PARMS.P-LONG-NAME LEAVING NO
      WHEN NONE
        XXHASH-PARMS.P-LONG-NAME := +FILE-ID
    END-DECIDE
    COMPRESS FLUSH-PARMS.DISKUNIX-COMMAND
      FLUSH-PARMS.DISKUNIX-OPT1 FLUSH-PARMS.DISKUNIX-OPT2
      XXHASH-PARMS.P-LONG-NAME
      FLUSH-PARMS.DISKUNIX-PARM1 FLUSH-PARMS.DISKUNIX-PARM2
      FLUSH-PARMS.DISKUNIX-PARM3 TO XXUX---P.P-RECORD
  ELSE
    COMPRESS FLUSH-PARMS.DISKUNIX-COMMAND FLUSH-PARMS.DISKUNIX-OPT1
      FLUSH-PARMS.DISKUNIX-OPT2 FLUSH-PARMS.DISKUNIX-PARM1
      FLUSH-PARMS.DISKUNIX-PARM2 FLUSH-PARMS.DISKUNIX-PARM3
      TO XXUX---P.P-RECORD
  END-IF
  P-FILE-NAME := +LOGFILE-ID
  #UX-FUNCTION := 'COMMAND'
  IF #TRACING
    COMPRESS 'Executing command:' XXUX---P.P-RECORD 'with log file:'
      XXUX---P.P-FILE-NAME TO #TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    END TRANSACTION
  END-IF
  PERFORM UNIX-FUNCTION
  END TRANSACTION
  IF #TRACING
    COMPRESS 'Execution of OS command returned:'
      P-ERROR-CODE P-ERROR-TEXT TO #TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    END TRANSACTION
  END-IF
  IF P-ERROR-CODE = 0
    #UX-FUNCTION := 'CLOSE'
    P-FILE-NAME := +LOGFILE-ID
    PERFORM UNIX-FUNCTION
    END TRANSACTION
    IF P-ERROR-CODE = 0
      P-FILE-NAME := +LOGFILE-ID
      #UX-FUNCTION := 'DELETE'
      PERFORM UNIX-FUNCTION
      END TRANSACTION
    END-IF
    ESCAPE ROUTINE
  END-IF
  #P-ERROR-CODE := P-ERROR-CODE
  COMPRESS P-ERROR-TEXT '/ Log:' TO #P-ERROR-TEXT
  RESET P-FILE-HANDLE P-ERC P-ERT P-ERROR-CODE P-ERROR-TEXT #EOF
  P-FILE-NAME := +LOGFILE-ID
  P-BINARY := 'N'
  #UX-FUNCTION := 'READ'
  READUX. REPEAT
    PERFORM UNIX-FUNCTION
    END TRANSACTION
    COMPRESS #P-ERROR-TEXT XXUX---P.P-RECORD TO #P-ERROR-TEXT
    EXAMINE #P-ERROR-TEXT FOR 'x' LENGTH #LEN
    IF P-ERROR-CODE NE 0 OR #EOF OR #LEN > 248
      ESCAPE BOTTOM (READUX.)
    END-IF
  END-REPEAT
  #UX-FUNCTION := 'CLOSE'
  PERFORM UNIX-FUNCTION
  END TRANSACTION
  P-ERROR-TEXT := #P-ERROR-TEXT
  P-ERROR-CODE := #P-ERROR-CODE
END-IF
*
END-SUBROUTINE /* EXEC-COMMAND
*
************************************************************************
DEFINE SUBROUTINE EXEC-CONVERSION
************************************************************************
#FLUSH-LINES := FLUSH-LINES
PERFORM RMFL---S-SUBSTITUTE-SYMBOLS FLUSH-PARMS
  FLUSH-PARMS.DISKUNIX-OUTPUT-FORMAT #SPOOL-ATTRIBUTES
PERFORM RMFL---S-SUBSTITUTE-SYMBOLS FLUSH-PARMS
  FLUSH-PARMS.DISKUNIX-FORMATTER #SPOOL-ATTRIBUTES
PERFORM RMFL---S-SUBSTITUTE-SYMBOLS FLUSH-PARMS
  FLUSH-PARMS.DISKUNIX-HEADER #SPOOL-ATTRIBUTES
PERFORM RMFL---S-SUBSTITUTE-SYMBOLS FLUSH-PARMS
  FLUSH-PARMS.DISKUNIX-FOOTER #SPOOL-ATTRIBUTES
PERFORM RMFL---S-SUBSTITUTE-SYMBOLS FLUSH-PARMS
  FLUSH-PARMS.DISKUNIX-MEDIA #SPOOL-ATTRIBUTES
PERFORM RMFL---S-SUBSTITUTE-SYMBOLS FLUSH-PARMS
  FLUSH-PARMS.DISKUNIX-ADDITIONAL #SPOOL-ATTRIBUTES
PERFORM RMFL---S-SUBSTITUTE-SYMBOLS FLUSH-PARMS
  FLUSH-PARMS.DISKUNIX-MASK #SPOOL-ATTRIBUTES
*
COMPRESS #TEMPNAME '*' TO CONV-INFILES LEAVING NO
PERFORM RMFL---S-SUBSTITUTE-SYMBOLS FLUSH-PARMS CONV-INFILES
  #SPOOL-ATTRIBUTES
IF +FILE-TYPE NE ' ' AND #SPOOL-TYPE NE DIRECT-INPUT
  COMPRESS +FILE-NAME '.' +FILE-TYPE
    TO XXHASH-PARMS.P-SHORT-NAME LEAVING NO
ELSE
  XXHASH-PARMS.P-SHORT-NAME := +FILE-NAME
END-IF
PERFORM GET-LONG-NAME
IF XXHASH-PARMS.P-RC = 0
  CONV-FILENAME := XXHASH-PARMS.P-LONG-NAME
  EXAMINE CONV-FILENAME FOR +FILE-TYPE AND DELETE
  EXAMINE CONV-FILENAME FOR '.' POSITION #POS LENGTH #LEN
  IF #POS > 2 AND #POS = #LEN
    #POS := #POS - 1
    CONV-FILENAME := SUBSTR (CONV-FILENAME,1,#POS)
  END-IF
ELSE
  CONV-FILENAME := +FILE-NAME
END-IF
CONV-FILETYPE := +FILE-TYPE
CONV-PATH     := +TEMP-PATH
PERFORM RMFL---S-SUBSTITUTE-SYMBOLS FLUSH-PARMS CONV-PATH
  #SPOOL-ATTRIBUTES
CONV-LOGPATH                := FLUSH-PARMS.DISKUNIX-LOGPATH
PERFORM RMFL---S-SUBSTITUTE-SYMBOLS FLUSH-PARMS CONV-LOGPATH
  #SPOOL-ATTRIBUTES
FLUSH-LINES := #FLUSH-LINES
CONV-OUTPUT-FORMAT := FLUSH-PARMS.DISKUNIX-OUTPUT-FORMAT
CONV-HEADER        := FLUSH-PARMS.DISKUNIX-HEADER
CONV-HEADER-FONT   := FLUSH-PARMS.DISKUNIX-HEADER-FONT
CONV-FOOTER        := FLUSH-PARMS.DISKUNIX-FOOTER
CONV-FONT          := FLUSH-PARMS.DISKUNIX-FONT
CONV-LINES         := FLUSH-PARMS.DISKUNIX-LINES
CONV-LANDSCAPE     := FLUSH-PARMS.DISKUNIX-LANDSCAPE
CONV-MEDIA         := FLUSH-PARMS.DISKUNIX-MEDIA
CONV-CODEPAGE      := FLUSH-PARMS.DISKUNIX-CODEPAGE
CONV-ADDITIONAL    := FLUSH-PARMS.DISKUNIX-ADDITIONAL
IF FLUSH-PARMS.DISKUNIX-FORMATTER = 'auto'
  IF +FORCE-UNIPRINT
    CONV-FORMATTER := 'auto' /* Use uniprint if available
  ELSE
    CONV-FORMATTER := 'enscript'
  END-IF
ELSE
  CONV-FORMATTER := FLUSH-PARMS.DISKUNIX-FORMATTER
END-IF
#FLUSH-LINES := FLUSH-LINES
PERFORM RMFL---S-SUBSTITUTE-SYMBOLS FLUSH-PARMS CONV-ADDITIONAL
  #SPOOL-ATTRIBUTES
FLUSH-LINES   := #FLUSH-LINES
CONV-MASK     := FLUSH-PARMS.DISKUNIX-MASK
CONV-TRACING  := #TRACING
*
IF #TRACING
  COMPRESS 'Executing conversion:' 'File name:'   CONV-FILENAME
    '- File type:'   CONV-FILETYPE '- Path:'      CONV-PATH
    '- Logpath:'     CONV-LOGPATH '- Output-Frm:' CONV-OUTPUT-FORMAT
    '- Header:'      CONV-HEADER '- Header-Font:' CONV-HEADER-FONT
    '- Footer:'      CONV-FOOTER '- Font:'        CONV-FONT
    '- Lines/pg:'    CONV-LINES '- Landscape:'    CONV-LANDSCAPE
    '- Media:'       CONV-MEDIA '- Codepage:'     CONV-CODEPAGE
    '- Additional:'  CONV-ADDITIONAL '- Mask:'    CONV-MASK
    TO #TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
  END TRANSACTION
END-IF
*
IF P-CODEPAGE NE ' '
  COMPRESS '1594' P-CODEPAGE CONV-FILENAME TO #TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'W' #TRACE-MSG
  END TRANSACTION
END-IF
*
CALLNAT 'RCONV--N' RCONV--P XXUX---P
IF CONV-ERC NE 0
  P-ERROR-CODE := CONV-ERC
  P-ERROR-TEXT := CONV-ERT
  FLUSH-ERROR  := TRUE
  IF #TRACING
    COMPRESS 'Conversion aborted:' '- Error:' P-ERROR-CODE
      '- Text:' P-ERROR-TEXT TO #TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    END TRANSACTION
  END-IF
ELSE /*+FILE-TYPE could have been changed to default
  +FILE-TYPE :=  CONV-FILETYPE /* type because it was empty before
  #FILE-PATH := +TEMP-PATH
  #FILE-NAME := +FILE-NAME
  #FILE-TYPE := +FILE-TYPE
  RESET #FILE-ID
  PERFORM CHECK-FILENAME
  IF #TRACING
    COMPRESS 'Final processing. Generated file:' #FILE-ID
      '- Filename check RC:' #RC TO #TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    END TRANSACTION
  END-IF
  IF #RC < 2
    P-FILE-NAME := #FILE-ID
  ELSE
    ESCAPE ROUTINE
  END-IF
  #FILE-PATH := +FILE-PATH
  #FILE-NAME := +FILE-NAME
  #FILE-TYPE := +FILE-TYPE
  RESET #FILE-ID
  PERFORM CHECK-FILENAME
  IF #TRACING
    COMPRESS 'Final file id:' #FILE-ID '- Filename check RC:' #RC
      TO #TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
    END TRANSACTION
  END-IF
  IF #RC < 2
    P-TARGET-FILE := +FILE-ID := #FILE-ID
  ELSE
    ESCAPE ROUTINE
  END-IF
  #UX-FUNCTION  := 'MOVE'
  PERFORM UNIX-FUNCTION
  END TRANSACTION
  IF P-ERROR-CODE NE 0
    IF P-ERROR-CODE = 2036  /* BLI1
        OR P-ERROR-TEXT = SCAN('3339') /* file already moved
      RESET P-ERC P-ERT P-ERROR-CODE P-ERROR-TEXT
    ELSE
      FLUSH-ERROR  := TRUE
      IF #TRACING
       COMPRESS 'Move after conversion aborted:' '- Error:' P-ERROR-CODE
          '- Text:' P-ERROR-TEXT TO #TRACE-MSG
        PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
        END TRANSACTION
      END-IF
      ESCAPE ROUTINE
    END-IF
  ELSE
    IF #TRACING
      #TRACE-MSG := 'Conversion executed successfully.'
      PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
      END TRANSACTION
    END-IF
  END-IF
END-IF
*
END-SUBROUTINE /* EXEC-CONVERSION
*
************************************************************************
DEFINE SUBROUTINE GET-NODE
************************************************************************
FIND (1) UX-NODES WITH UX-NODE-NAME = FLUSH-PARMS.DISKUNIX-SERVICE
  XXUX---P.P-NODE-NAME       := FLUSH-PARMS.DISKUNIX-SERVICE
  XXUX---P.P-USERID          := UX-NODE-USERID
  XXUX---P.P-CIPHER-PASSWORD := UX-NODE-PASSWORD
  XXUX---P.P-GROUP           := UX-NODE-GROUP
  XXUX---P.P-NODE-SUSPEND    := UX-NODE-SUSPEND
  +TEMP-PATH := UX-NODE-TEMPDIR
END-FIND
END-SUBROUTINE /* GET-NODE
************************************************************************
DEFINE SUBROUTINE CHECK-FILENAME
************************************************************************
PERFORM XXCHKFN-CHECK-FILENAME #FILE-ID #RC
  #FILE-PATH #FILE-NAME #FILE-TYPE
IF #RC > 1
  P-ERROR-CODE := 1121 /* invalid filename
  P-ERROR-TEXT := #FILE-ID
END-IF
*
END-SUBROUTINE /* CHECK-FILENAME
*
************************************************************************
DEFINE SUBROUTINE GET-LONG-NAME
************************************************************************
XXHASH-PARMS.P-FUNCTION := 'L' /*short -> long
PERFORM XXHASH XXHASH-PARMS
IF #TRACING
  IF XXHASH-PARMS.P-RC = 0
    COMPRESS 'Converted filename:' XXHASH-PARMS.P-SHORT-NAME
      '-->' XXHASH-PARMS.P-LONG-NAME TO #TRACE-MSG
  ELSE
    COMPRESS 'Filename conversion error' XXHASH-PARMS.P-RC
      'processing' XXHASH-PARMS.P-SHORT-NAME TO #TRACE-MSG
  END-IF
  PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
  END TRANSACTION
END-IF
IF XXHASH-PARMS.P-RC NE 0
  XXHASH-PARMS.P-LONG-NAME := XXHASH-PARMS.P-SHORT-NAME
  EXAMINE XXHASH-PARMS.P-LONG-NAME FOR '?' REPLACE WITH '_'
  RESET P-RC
END-IF
*
END-SUBROUTINE /* GET-LONG-NAME
*
************************************************************************
DEFINE SUBROUTINE CHECK-HTML-TRIGRAPH /*WRITE SU13
************************************************************************
* Similar coding in XXUX---N - same exit different flag.
IF +NOM-TRIGRAPH-HTML_WRITE NE 0
  ESCAPE ROUTINE /*alread checked
END-IF
+NOM-TRIGRAPH-HTML_WRITE := -1
#OBJ  := 'UEX-HTML'
PERFORM NOMCHCKP-CHECK-PROG NOMCHCKP-PARMS
IF #LIB NE ' '
  CALLNAT 'UEX-HTML' #AVOID-TRIGRAPH-HTML_READ
    #AVOID-TRIGRAPH-HTML_WRITE /*handle new flag
  IF #AVOID-TRIGRAPH-HTML_WRITE = 1
    +NOM-TRIGRAPH-HTML_WRITE := #AVOID-TRIGRAPH-HTML_WRITE
  END-IF
END-IF
IF #TRACING
  COMPRESS NUMERIC 'UEX-HTML: write - html:' +NOM-TRIGRAPH-HTML_WRITE
    ' (' #AVOID-TRIGRAPH-HTML_WRITE    ')'
    ' Lib:' #LIB TO #TRACE-MSG LEAVING NO
  PERFORM XXRLOG-WRITE-LOG 'T' #TRACE-MSG
END-IF
*
END-SUBROUTINE /* CHECK-HTML-TRIGRAPH
*
************************************************************************
ON ERROR
************************************************************************
  BACKOUT TRANSACTION
  FLUSH-ERROR := TRUE
  P-ERROR-CODE := 21
  CALLNAT 'C-NATERN' P-ERROR-TEXT
  ESCAPE ROUTINE
*
END-ERROR
*
INCLUDE RMPR-C /*V12-PRINTER-API,CALL-PRINTER-EXIT
*
END
