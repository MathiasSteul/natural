DEFINE DATA
PARAMETER USING RMFL---P
PARAMETER
1 LINE-PARMS
  2 LINE-CURRENT             (P3)
  2 LINE-TAB                 (1:100)
    3 LINE                   (A251)
    3 REDEFINE  LINE
      4 LINE-L               (A1/1:251)
    3 LINE-NUMBER            (P10)
PARAMETER USING XXUX---P
PARAMETER
1 P-ERROR-CODE               (N4)
1 P-ERROR-TEXT               (A250)
************************************************************************
INDEPENDENT
1 +HEX-TIMESTAMP             (A20)
1 +PRINTER_OPEN              (L)
1 +FILE-ID                   (A) DYNAMIC
1 +FILE-PATH                 (A) DYNAMIC
1 +FILE-NAME                 (A) DYNAMIC
1 +FILE-TYPE                 (A50)
1 +FILE-TYPE-TEMP            (A50)
