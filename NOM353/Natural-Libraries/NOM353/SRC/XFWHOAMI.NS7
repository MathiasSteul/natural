* <Natural Source Header
* XFWHOAMI - Natural function which returns the User ID which is logged
*           on to a mainframe NPR node
*
* Maintenance
* -----------
* uuuuuu  yyyy-mm-dd iTrac       Remark
* fhi     2018-03-16 NOMALL-1918 Created.
* ----------------------------------------------------------------------
*
DEFINE FUNCTION F#WHOAMI RETURNS USERID (A8)
************************************************************************
  DEFINE DATA PARAMETER
  1 #NODE  (N5) BY VALUE
************************************************************************
  LOCAL
  1 WHOAMI VIEW OF NATPROC-LOGON
    2 ERROR-CODE
    2 NODE
    2 LOGON-ID
  END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
FIND WHOAMI WITH NODE = #NODE AND FUNCTION   = 'WHOAMI'
/*  AND PASSWORD   = ' ' AND ACCOUNTING = ' '
  DECIDE FOR FIRST CONDITION
    WHEN ERROR-CODE = 0 AND LOGON-ID NE ' '
      USERID := LOGON-ID
    WHEN ERROR-CODE = 0 AND LOGON-ID  = ' '
      USERID := 'NONE'
    WHEN NONE
      USERID := 'ERROR'
  END-DECIDE
END-FIND
*
END-FUNCTION /*F#WHOAMI
*
END
