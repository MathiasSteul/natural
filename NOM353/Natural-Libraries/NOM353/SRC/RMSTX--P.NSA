DEFINE DATA PARAMETER
/* >Natural Source Header 000000
/* :Mode S
/* :CP
/* <Natural Source Header
1 STX-PARMS
  2 STX-FUNCTION (A8) /* START,STATUS,KILL
  2 STX-TASK-NAME (A250) /* NAME OF BATCH PROCESS
  2 STX-TASK-NUMBER (N2) /* NUMBER OF MONITOR TASK
  2 STX-TASK-STATUS (N2) /* JOB STATUS: JOB IS:
*                                       0: UNKNOWN
*                                       1: NOT FOUND
*                                       2: SLEEPING
*                                       3: WAITING
*                                       4: RUNNING
*                                       5: IN INTERMEDIATE STATE
*                                       6: TERMINATED
*                                       7: STOPPED
*                                       8: GROWING
*                                       9: IN UNKNOWN STATE
  2 STX-START-SCRIPT (A250)
  2 STX-LOGFILE (A250)
  2 STX-MESSAGE-CODE (N10) /* SCRIPT RETURN CODE
  2 STX-MESSAGE (A250) /* SCRIPT ABORT MESSAGE
  2 STX-ERROR-CODE (N4)
  2 STX-ERROR-TEXT (A250) /* NOMALL-853 WAS 70
END-DEFINE
