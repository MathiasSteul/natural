* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RLCMTI-C - Change L-MARK to L-IDENT
*
* MAINTENANCE:
* ----------------------------------------------------------------------
FOR I = 1 TO #NOFLINES
  DECIDE ON FIRST VALUE OF L-MARK(I)
    VALUE '*' RESET L-MARK(I)
      IF G-LCH-NUM > 0
        REINPUT USING HELP MARK *L-MARK (I)
      END-IF
    VALUE ' ' RESET L-IDENT (I)
    NONE      EXAMINE FULL VALUE OF G-LC-CODE (1:G-LC-NUM)
        FOR FULL VALUE OF L-MARK (I) GIVING INDEX F
      IF F = 0
        IF G-LCH-NUM > 0
          REINPUT USING HELP MARK *L-MARK (I)
        END-IF
      ELSE
        L-IDENT (I) := G-LC-IDENT (F)
      END-IF
  END-DECIDE
END-FOR
** End of CC RLCMTI-C **************************************************
