DEFINE SUBROUTINE ADD-STEPLIB
************************************************************************
CALLNAT 'RLIBACT' NAT00009-LIBRARY #STEPLIB-EXIST
IF NOT #STEPLIB-EXIST
  RESET NAT00009-DBID NAT00009-FNR
  CALLNAT 'RGETLIB' NAT00009-APPLIC
  NAT00009-FUNCTION := 08
  CALLNAT 'NAT00009' NAT00009-PARMS
  IF NAT00009-NUMBER-ACTIVE > 8
    IF NAT00009-LIBRARY = 'SYSSAT'
      SKIP  2
      WRITE '--> Unable to add SYSSAT Steplib'
      WRITE '--> Will attempt to initialize'
      SKIP  2
    ELSE
      G-NATRP-ERC := 0005
      G-NATRP-ERT := 'Error accessing STEPLIB Table'
      SKIP  2
      WRITE '--> Too many STEPLIBs'
    END-IF
    ESCAPE ROUTINE
  END-IF
END-IF
*
END-SUBROUTINE /* ADD-STEPLIB
*
************************************************************************
DEFINE SUBROUTINE ADD-DEFINED-STEPLIBS
************************************************************************
FOR PI = 1 TO 10
  IF SATPA-KEYWORD (PI) NE MASK ('STEPLIB'.) OR SATPA-VALUE (PI) = ' '
    ESCAPE TOP
  END-IF
  SATEL-SATVERS := 21
  SATEL-VALUE   := SATPA-VALUE (PI)
  CALLNAT SAT-EXTRACT-STEPLIB SATEL-SATVERS SATEL-PARMS (*)
  IF SATEL-ERROR-CODE NE 0
    G-NATRP-ERC := SATEL-ERROR-CODE
    G-NATRP-ERT := SATEL-ERROR-TEXT
    SKIP  2
    WRITE '--> Error extracting STEPLIB Parameters ' G-NATRP-ERC
    PRINT '-->' G-NATRP-ERT /*SU17 (AL=70)
    ESCAPE ROUTINE
  END-IF
  EXAMINE #LIB-NAME(*) FOR SATEL-LIBRARY GIVING INDEX #I
  IF #I GT 0
    IF #LIB-ADDED(#I)
      ESCAPE TOP
    END-IF
  END-IF
  RESET NAT00009-PARMS
  NAT00009-LIBRARY  := SATEL-LIBRARY
  NAT00009-DBID     := SATEL-DBID-N5
  NAT00009-FNR      := SATEL-FNR-N5
  NAT00009-CIPHER   := SATEL-CIPHER
  NAT00009-PASSWORD := SATEL-PASSWORD
  PERFORM ADD-STEPLIB
  IF G-NATRP-ERC NE 0
    ESCAPE ROUTINE
  END-IF
END-FOR
*
END-SUBROUTINE /* ADD-DEFINED-STEPLIBS
*
************************************************************************
DEFINE SUBROUTINE DISPLAY-STEPLIBS
************************************************************************
/*SU22 -> NAT00009-NUMBER-ACTIVE := 8
/* FOR PI = 1 TO NAT00009-NUMBER-ACTIVE
RESET PI
#REP. REPEAT
  ADD 1 TO PI /*SU22 <-
  NAT00009-FUNCTION := 12
  NAT00009-CURRENT-INDEX := PI
  CALLNAT 'NAT00009' NAT00009-PARMS
  RESET INITIAL #STEPLIB
  #STEPLIB-LIBRARY := NAT00009-LIBRARY
  #STEPLIB-DBID    := NAT00009-DBID
  #STEPLIB-FNR     := NAT00009-FNR
  EXAMINE #STEPLIB FOR ' ' DELETE
  IF PI = 1
    WRITE '   STEPLIBs...................' #STEPLIB
  ELSE
    WRITE '                              ' #STEPLIB
  END-IF
  IF PI GE NAT00009-NUMBER-ACTIVE /*SU22
    ESCAPE BOTTOM
  END-IF
END-REPEAT
*
END-SUBROUTINE /* DISPLAY-STEPLIBS
*
************************************************************************
DEFINE SUBROUTINE SYSTEM-INFORMATION
************************************************************************
IF G-MONITOR-NODE = 0 /*unix
  SYSTEM-INFO-VIEW.SYSTEM-TYPE := *OPSYS
  SYSTEM-INFO-VIEW.SPOOL-TYPE  := 'UNIX'
  COMPRESS '1527' SYSTEM-INFO-VIEW.SYSTEM-TYPE TO LG-MSG
  CALLNAT 'RLOG' PL-PARMS
  COMPRESS '1528' SYSTEM-INFO-VIEW.SPOOL-TYPE TO LG-MSG
  CALLNAT 'RLOG' PL-PARMS
  SKIP  2
  WRITE 'System Information'
  WRITE '   System Type ...............' SYSTEM-INFO-VIEW.SYSTEM-TYPE
  WRITE '   Spool Type ................' SYSTEM-INFO-VIEW.SPOOL-TYPE
  WRITE '   Monitor Code Page .........' *CODEPAGE
  ESCAPE ROUTINE
END-IF
/* Mainframe:
FNDSY. FIND (1) SYSTEM-INFO-VIEW WITH NODE = G-MONITOR-NODE
  IF SYSTEM-INFO-VIEW.ERROR-CODE NE 0
    G-NATRP-ERC := SYSTEM-INFO-VIEW.ERROR-CODE + 5000
    WRITE '   --> error reading system info' G-NATRP-ERC
    PRINT '      ' G-NATRP-ERT /*SU17 (AL=70)
  END-IF
  EXAMINE FULL SYSTEM-INFO-VIEW.SYSTEM-TYPE FOR H'00' REPLACE ' '
  EXAMINE FULL SYSTEM-INFO-VIEW.SPOOL-TYPE FOR H'00' REPLACE ' '
  IF SYSTEM-INFO-VIEW.SYSTEM-TYPE = SCAN 'BS2'
    SYSTEM-INFO-VIEW.SPOOL-TYPE := SYSTEM-INFO-VIEW.SYSTEM-TYPE
  END-IF
  IF SYSTEM-INFO-VIEW.SPOOL-TYPE = 'JES3'
  AND SYSTEM-INFO-VIEW.ESY-VERSION GT #ESY-NEW-VERSION                /*
    FIND SYSTEM-PARMS WITH NODE = G-MONITOR-NODE
      EXAMINE SYSTEM-PARMS.STARTUP-PARM FOR 'SPOOL=' GIVING POSITION #I
      IF #I > 0
        ADD 6 TO #I
        +SPOOL-PARM := SUBSTR (SYSTEM-PARMS.STARTUP-PARM,#I,4)
        ESCAPE BOTTOM
      END-IF
    END-FIND
  END-IF
  COMPRESS '1527' SYSTEM-INFO-VIEW.SYSTEM-TYPE TO LG-MSG
  CALLNAT 'RLOG' PL-PARMS
  COMPRESS '1528' SYSTEM-INFO-VIEW.SPOOL-TYPE TO LG-MSG
  CALLNAT 'RLOG' PL-PARMS
  SKIP  2
  WRITE 'System Information'
  WRITE '   System Type ...............' SYSTEM-INFO-VIEW.SYSTEM-TYPE
/*SU15  IF SYSTEM-INFO-VIEW.SYSTEM-TYPE = SCAN 'BS2'
/*SU15      WRITE '   System release ............' SYSTEM-RELEASE
/*SU15    END-IF
  WRITE '   Spool Type ................' SYSTEM-INFO-VIEW.SPOOL-TYPE
  WRITE '   Monitor Language ..........' *LANGUAGE
  WRITE '   Monitor Code Page .........' +NOD-LOCAL-CODEPAGE
  IF +NOD-LOCAL-CODEPAGE NE *CODEPAGE
    WRITE '   Natural System Code Page ..' *CODEPAGE
  END-IF
  IF *CODEPAGE = ' ' AND +NOD-LOCAL-CODEPAGE NE ' ' /*SU16
    LG-MSG := F#GETMSG (<-8314>) /*NAT8314 No Natural ICU handler avail.
    SKIP  2
    WRITE '--> NOM Monitor requires Natural ICU support'
    PRINT '-->' LG-MSG /*SU17 (AL=70)
    PERFORM WRITE-LOG-RECORD
    G-NATRP-ERC := 1513 /*NOM1513 Monitor initialization failed.
    ESCAPE ROUTINE
  END-IF
  IF +NOD-LOCAL-CODEPAGE NE ' ' /*check CP SU16
    CALLNAT 'N-CP-CHK' +NOD-LOCAL-CODEPAGE G-NATRP-ERC LG-MSG
    IF NOT (G-NATRP-ERC = 0 OR=4) /* 4 = user defined
      LG-MSG := F#GETMSG (<G-NATRP-ERC,LG-MSG>)
      SKIP  2
      PRINT '-->' LG-MSG /*SU17 (AL=70)
      G-NATRP-ERC := 1513 /*NOM1513 Monitor initialization failed.
      ESCAPE ROUTINE
    END-IF
  END-IF
END-FIND
*
END-SUBROUTINE /* SYSTEM-INFORMATION
*
************************************************************************
DEFINE SUBROUTINE FILL-GDA-NEW-VARIABLES
************************************************************************
* ***** CA/CMASPOOL (8.1.8):
IF #MF /*SU14
  FNDCMA. FIND (1) CMASPOOL-MONITOR WITH M-MONITOR-ID = 'CMASPOOL'
    IF M-TIME-SCHEDULE (FNDCMA.) = 'Y'
      G-SCAN-CMASPOOL := 'Y'
      G-SCAN-CMASPOOL-COPY-FILES (1:10) := M-COPY-FILES-V141 (1:10)
      G-SCAN-CMASPOOL-VERSION := M-VERSION (FNDCMA.)
      G-SCAN-CMASPOOL-TEMP-DEST := M-DEFAULT-PRINTER (FNDCMA.)
      +G-SCAN-CMASPOOL-TIME-LIMIT     := M-WAIT-INCREMENT (FNDCMA.)
      WRITE '   CA SPOOL Interface ........' 'active'
    END-IF
  END-FIND
END-IF
* ***** TRIGGER (8.1.10):
FNDTRIGGER. FIND (1) API-DEFAULTS WITH M-MONITOR-ID = 'API-DEFS'
  IF M-TIME-SCHEDULE (FNDTRIGGER.) = 'Y'
    G-SCAN-TRIGGER      := 'Y'
    G-SCAN-TRIGGER-DBID := M-NATRPT-DBID-N5
    G-SCAN-TRIGGER-FNR  := M-NATRPT-FNR-N5
    WRITE '   NOM Trigger Queue ......... active'
  END-IF
END-FIND
* ***** Unix (8.1.13 UX):
G-SCAN-UNIX := 'N'
FDUX. FIND NUMBER UX-NODES WITH UX-NODE-NAME > ' '
IF *NUMBER (FDUX.) > 0
  G-SCAN-UNIX := 'Y'
END-IF
* ***** USER EXITS (8.1.12 3GL):
FIND (1) USER-EXITS WITH M-MONITOR-ID = 'API-DEFS'
  FOR I 1 20
    IF M-NOMEXIT-ACTIVE (I) = 'Y'
      +G-NOMEXIT-ACTIVE (I) := TRUE
    ELSE
      +G-NOMEXIT-ACTIVE (I) := FALSE
    END-IF
  END-FOR
  IF M-NOMEXIT-ACTIVE (9) = 'Y'
    +G-NOMEXIT-ACTIVE-009 := TRUE
  ELSE
    +G-NOMEXIT-ACTIVE-009 := FALSE
  END-IF
END-FIND                                             /* ???????????????
*
END-SUBROUTINE /* FILL-GDA-NEW-VARIABLES
*
************************************************************************
DEFINE SUBROUTINE READ-CLEANUP-DEFAULTS /*8.1.7
************************************************************************
FNDDF. FIND CLEANUP-DEFAULTS WITH M-MONITOR-ID = 'CLEANUP'
  IF NO RECORDS FOUND
    LG-MSG := '7122'            /* Cleanup defaults missing
    PERFORM WRITE-LOG-RECORD
    G-NATRP-ERC := 1513
    ESCAPE BOTTOM (FNDDF.)
  END-NOREC
  IF M-CLEANUP-SPOOL = 'Y'
    +G-CLEANUP-SPOOL := TRUE
  END-IF
END-FIND
*
END-SUBROUTINE /* READ-CLEANUP-DEFAULTS
*
************************************************************************
DEFINE SUBROUTINE WRITE-LOG-RECORD
************************************************************************
RMTASK-P.FUNCTION       := 'L'
RMTASK-P.SUBTASK-NUMBER := G-TASK-NUMBER
CALLNAT 'RMTASKID' RMTASK-P
LG-USERID := RMTASK-P.TASK-ID
LG-CODE   := 'MO'
CALLNAT 'RLOG' PL-PARMS
END OF TRANSACTION
*
END-SUBROUTINE /* WRITE-LOG-RECORD
*
************************************************************************
DEFINE SUBROUTINE START-SUBTASKS
************************************************************************
IF NOT #SUBTASK-REQUIRED(*)
  ESCAPE ROUTINE
END-IF
CALLNAT 'RMSETSTN' #EQU-START-SUBTASK
  G-MONITOR-NODE G-NATRP-DBID G-NATRP-FNR G-SHUTDOWN G-TASK-NUMBER
IF #MF
  IF G-BATCH-MODULE = 'BATCHJOB'
    WRITE '   --> Subtasks not supported for BATCH Monitor'
    G-TASK-TABLE(1:#MAX-FUNC):= 1
    ESCAPE ROUTINE
  END-IF
  FIND (1) NRM-SUBTASK-PARMS WITH M-MONITOR-ID = 'SUBTPARM'
    IF NO RECORDS FOUND
      WRITE '   --> Subtask Definition not found'
      G-TASK-TABLE(1:#MAX-FUNC):= 1
      ESCAPE ROUTINE
    END-NOREC
    #SP-NATENV := SP-NATENV /* ÜÜ ATTENTION: A250 := A1080 ÜÜ
    CALLNAT 'SATID02N' #SP-NATENV
* set parms for SAT
    SATST-SYSTEM-TYPE        := SP-SYSTEM-TYPE
    SATST-SYSTEM-RELEASE     := SP-SYSTEM-RELEASE
    SATST-NODE-N5            := G-MONITOR-NODE
    SATST-TYPE               := SP-TASK-TYPE
    SATST-NSC-ACTIVE         := SP-NSC-ACTIVE
    SATST-NSC-USERID         := SP-NSC-USERID
    #SCRAMBLED               := SP-NSC-PASSWORD
    CALLNAT 'SATTS01N' 'U' #UNSCRAMBLED #SCRAMBLED /*SU21
    SATST-NSC-PASSWORD       := #UNSCRAMBLED
    SATST-BATCH-MODULE       := SP-BATCH-MODULE
    SATST-SUBTASK-MODULE     := SP-SUBTASK-MODULE
    RESET SATST-BATCH-JOBNAME
    SATST-SKEL-LIBRARY       := SP-SKELETON-LIBRARY
    SATST-SKEL-MEMBER        := SP-SKELETON-NAME
    SATST-SKEL-DBID-N5       := SP-SAT-DBID
    SATST-SKEL-FNR-N5        := SP-SAT-FNR
    CALLNAT 'RGETLIB' SATST-NATLIB
    SATST-NATENV             := SP-NATENV
    SATST-NATPGM             := 'RMINIT'
  END-FIND
  FOR I = 21 TO #MAX-TASKS
    RMTASK-P.FUNCTION       := 'T'
    RMTASK-P.SUBTASK-NUMBER := I
    CALLNAT 'RMTASKID' RMTASK-P
    #SUBTASK-NAME := RMTASK-P.TASK-ID
    FIND NATURAL-SUB-TASK WITH NAT-USER = #SUBTASK-NAME
    AND NODE = G-MONITOR-NODE AND FUNCTION = 'STATUS'                 /*
      IF NOT(NATURAL-SUB-TASK.ERROR-CODE = 663 /* subtask active
      OR (NATURAL-SUB-TASK.ERROR-CODE = 0 AND NAT-STATUS = 'CLOSED')) /*
        PERFORM KILL-SUBTASK
      END-IF
    END-FIND
    IF #SUBTASK-REQUIRED(I) /*subtask not active - start it
      RMTASK-P.FUNCTION       := 'S'
      RMTASK-P.SUBTASK-NUMBER := I
      CALLNAT 'RMTASKID' RMTASK-P
      SUBTWAIT.
      FIND NRM-SUBTASK-INFO WITH ST-SUBTASK-ID = RMTASK-P.TASK-ID
      END-FIND
      RMTASK-P.FUNCTION := 'T'
      CALLNAT 'RMTASKID' RMTASK-P
      SATST-SUBTASK-NAME := RMTASK-P.TASK-ID
      RMTASK-P.FUNCTION := 'L'
      CALLNAT 'RMTASKID' RMTASK-P
      COMPRESS RMTASK-P.TASK-ID ST-WAIT-MINIMUM ST-WAIT-MAXIMUM
        ST-WAIT-INCREMENT G-MONITOR-NODE #EOM-SYSF #SAT-SYSF
        #SAT-LIBRARY #SAT-MEMBER
        RMTASK-P.SUBTASK-NUMBER-A TO SATST-NATPGM-PARMS
      SATST-SATVERS:= 21
      COMPRESS SATSP-START-PRODUCT SATSP-START-PREFIX
        RMTASK-P.SUBTASK-NUMBER-A
        TO SATST-SUBTASK-MESSAGE-FILE LEAVING NO
      IF #TRACING
        COMPRESS 'Start task' I 'with params:' SATST-NATPGM-PARMS
          TO G-TRACE-MSG
        PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
        COMPRESS 'DDNAME:' SATST-SUBTASK-MESSAGE-FILE TO G-TRACE-MSG
        PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
        END TRANSACTION
      END-IF
* Create unique sysout DD name if using subtasking
      IF SATST-TYPE = 'SUBTASK'
        SETDDNAME. FOR #I = 1 TO 26
          COMPRESS 'NO' #SUFFIX-CHAR(#I) SATSP-START-PREFIX
            RMTASK-P.SUBTASK-NUMBER-A
            TO SATST-SUBTASK-MESSAGE-FILE LEAVING NO
          #COM-CREATE := FALSE
          FIND COMMON-DATA WITH NODE = +NOD-LOCAL-NODE
          AND FUNCTION ='CREATE' AND DATA-ID =SATST-SUBTASK-MESSAGE-FILE
          AND NUMBER-OF-ENTRIES = 1 AND ENTRY-LENGTH = 1              /*
            IF COMMON-DATA.ERROR-CODE = 621   /* Already exists
              IF #TRACING
                COMPRESS SATST-SUBTASK-MESSAGE-FILE 'already exists'
                  TO G-TRACE-MSG
                PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
              END-IF
              #COM-CREATE := FALSE
            ELSE
              IF #TRACING
                COMPRESS 'Create for' SATST-SUBTASK-MESSAGE-FILE
                  'RC=' COMMON-DATA.ERROR-CODE TO G-TRACE-MSG
                PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
              END-IF
              #COM-CREATE := TRUE
            END-IF
          END-FIND
          IF NOT #COM-CREATE
            ESCAPE TOP    /* Next iteration of #I
          END-IF
          FIND NATURAL-SUB-TASK WITH NODE = G-MONITOR-NODE
          AND FUNCTION = 'LIST' AND NAT-STATUS = 'ACTIVE'             /*
          AND DDNAME = SATST-SUBTASK-MESSAGE-FILE                     /*
            IF NO RECORDS FOUND
              ESCAPE BOTTOM(SETDDNAME.)
            END-NOREC
            IF NATURAL-SUB-TASK.ERROR-CODE NE 0
              ESCAPE BOTTOM(SETDDNAME.)
            END-IF
          END-FIND
        END-FOR
      END-IF
      IF #TRACING
        COMPRESS 'Using DDNAME:' SATST-SUBTASK-MESSAGE-FILE
          TO G-TRACE-MSG
        PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
      END-IF
      INCLUDE CMRDC
      IF #TRACING
        CALLNAT SAT-SERVER-START SATST-SATVERS SATST-PARMS-03
      ELSE
        CALLNAT SAT-SERVER-START SATST-SATVERS SATST-PARMS-03
          TRUE /* Set Trace-off, suppress WRITE stmts
      END-IF
      IF  #COM-CREATE
        #COM-CREATE := FALSE
        FIND COMMON-DATA WITH NODE=+NOD-LOCAL-NODE AND FUNCTION='DELETE'
        AND DATA-ID = SATST-SUBTASK-MESSAGE-FILE                      /*
          IF COMMON-DATA.ERROR-CODE = 0 AND #TRACING /* NOMALL-1272 BLI
            COMPRESS SATST-SUBTASK-MESSAGE-FILE 'un-created'
              TO G-TRACE-MSG
            PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
          END-IF
        END-FIND
      END-IF
      IF SATST-ERROR-CODE = 0
        #ESY-VERSION := SYSTEM-INFO-VIEW.ESY-VERSION
        IF SYSTEM-INFO-VIEW.SYSTEM-TYPE = SCAN 'BS2'
        AND #ESY-MAIN-VERSION > 2 /* NPR 3.1.1 and above              /*
          FIND (1) NATPROC-USERS WITH NODE = G-MONITOR-NODE
          AND TASK-ID = SATST-SUBTASK-NAME AND FULL-SCAN = 'YES'      /*
            COMPRESS '1563&' I '/' JOB-ID TO LG-MSG LEAVING NO
            EXAMINE LG-MSG FOR '&' AND REPLACE WITH ' '
            PERFORM WRITE-LOG-RECORD
          END-FIND
        ELSE
          COMPRESS '1563' I TO LG-MSG
          PERFORM WRITE-LOG-RECORD
        END-IF
      ELSE
        COMPRESS '1564' I TO LG-MSG
        PERFORM WRITE-LOG-RECORD
        WRITE '   --> Subtask start failed for:' #SUBTASK-ID
          / '   --> Error:'  SATST-ERROR-CODE SATST-ERROR-TEXT
        FOR J = 1 TO #MAX-FUNC
          IF G-TASK-TABLE(J) = I
            G-TASK-TABLE(J):= 1
          END-IF
        END-FOR /* J = 1 TO #MAX-FUNC
      END-IF    /* SATST-ERROR-CODE = 0
    END-IF      /* #SUBTASK-REQUIRED(I)
  END-FOR       /* I = 21 TO #MAX-TASKS
ELSE
  FOR I = 21 TO #MAX-TASKS
    IF #SUBTASK-REQUIRED(I)
      STX-TASK-NUMBER := I
      RMTASK-P.FUNCTION       := 'S'
      RMTASK-P.SUBTASK-NUMBER := I
      CALLNAT 'RMTASKID' RMTASK-P
      STX-TASK-NAME := RMTASK-P.TASK-ID
      STX-FUNCTION  := 'STATUS'
      CALLNAT 'RMSTX--N' STX-PARMS G-TRACE
      END TRANSACTION
      IF #TRACING
        COMPRESS 'Subtask' I 'got Unix status code' STX-TASK-STATUS
          'with error' STX-ERROR-CODE 'in task' STX-TASK-NAME
          TO G-TRACE-MSG
        PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
      END-IF
      IF STX-ERROR-CODE = 0 AND STX-TASK-STATUS = 0
        PERFORM KILL-SUBTASK
      END-IF
      STX-FUNCTION      := 'START'
      STX-START-SCRIPT  := '$NOMDIR/$NOMVERS/nommon.bsh'
      COMPRESS '$EOM_WORK/nommon.task' STX-TASK-NUMBER '.stdout'
        TO STX-LOGFILE LEAVING NO
      RMTASK-P.FUNCTION       := 'S'
      RMTASK-P.SUBTASK-NUMBER := I
      CALLNAT 'RMTASKID' RMTASK-P
      STX-TASK-NAME   := RMTASK-P.TASK-ID
      STX-TASK-NUMBER := I
      CALLNAT 'RMSTX--N' STX-PARMS G-TRACE
      END TRANSACTION
      IF STX-ERROR-CODE = 0
        COMPRESS '1563' I TO LG-MSG
      ELSE
        COMPRESS '1564' I TO LG-MSG
      END-IF
      PERFORM WRITE-LOG-RECORD
    END-IF
  END-FOR
END-IF
*
END-SUBROUTINE /* START-SUBTASKS
*
************************************************************************
DEFINE SUBROUTINE KILL-SUBTASK
************************************************************************
IF #TRACING
  COMPRESS 'Subtask' #SUBTASK-NAME 'still active - to be killed'
    TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
*
IF G-MONITOR-NODE NE 0
  FIND(1) NATURAL-SUB-TASK WITH NODE = G-MONITOR-NODE
  AND NAT-USER = #SUBTASK-NAME AND FUNCTION = 'CLOSE'                 /*
  END-FIND
  IF NATURAL-SUB-TASK.ERROR-CODE NE 0
    WRITE '   --> Error' NATURAL-SUB-TASK.ERROR-CODE
      'closing' #SUBTASK-NAME
  END-IF
ELSE
  STX-FUNCTION := 'KILL'
  CALLNAT 'RMSTX--N' STX-PARMS G-TRACE
  END TRANSACTION
  IF STX-ERROR-CODE NE 0
    COMPRESS 'Kill of' STX-TASK-NAME 'returned error' STX-ERROR-TEXT
      TO G-TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END-IF
END-IF
*
END-SUBROUTINE /* KILL-SUBTASK
*
************************************************************************
DEFINE SUBROUTINE CLEANUP-PRINTER-TASKS
************************************************************************
IF NOT #MF
  FIND NRM-SUBTASK-INFO WITH ST-SUBTASK-ID = 'PRT0' THRU 'PRT9'
    DELETE
    END TRANSACTION
  END-FIND
END-IF
*
END-SUBROUTINE /* CLEANUP-PRINTER-TASKS
*
************************************************************************
DEFINE SUBROUTINE RESET-REPORT-PROCESSING-NOW
************************************************************************
CLEANUP. FIND (1) DAILY-CLEANUP WITH M-MONITOR-ID = 'SYNCHCLN'
  IF NO RECORDS FOUND
    RMTASK-P.FUNCTION       := 'S'
    RMTASK-P.SUBTASK-NUMBER := 1
    CALLNAT 'RMTASKID' RMTASK-P
    FIND (1) DAILY-CLEANUP-OLD WITH M-MONITOR-ID = RMTASK-P.TASK-ID
      DAILY-CLEANUP.M-ARCHIVE-PREFIX:=
        DAILY-CLEANUP-OLD.M-ARCHIVE-PREFIX
      IF DAILY-CLEANUP-OLD.CLEANUP-ACTIVE-NOW
* if NOMCLEAN is running it will be working off the old control
* record so we write a warning and force NOMCLEAN to go into an
* endless sleep - it will have to be cancelled.
        WRITE '   --> Batch Daily Cleanup is active in parallel'
          / '   --> Please cancel the batch job'
        DAILY-CLEANUP-OLD.REPORT-PROCESSING-NOW:= TRUE
        UPDATE
      END-IF
    END-FIND
    M-MONITOR-ID:= 'SYNCHCLN'
    DAILY-CLEANUP.CLEANUP-IDENTIFIER:= 'CLEAN'
    RESET DAILY-CLEANUP.REPORT-PROCESSING-NOW
      DAILY-CLEANUP.CLEANUP-ACTIVE-NOW
    STORE DAILY-CLEANUP
    ESCAPE BOTTOM
  END-NOREC
  IF DAILY-CLEANUP.CLEANUP-IDENTIFIER = 'CLEAN'
  AND DAILY-CLEANUP.REPORT-PROCESSING-NOW                             /*
    RESET DAILY-CLEANUP.REPORT-PROCESSING-NOW
    UPDATE(CLEANUP.)
    WRITE '   --> Report processing now indicator reset'
  END-IF
END-FIND
END TRANSACTION
*
END-SUBROUTINE /* RESET-REPORT-PROCESSING-NOW
*
************************************************************************
DEFINE SUBROUTINE CHECK-SAT-LOG-FILE
************************************************************************
CALLNAT 'SATLGFVN' SATLGV-PARMS
IF SATLGV-RC NE 0
  WRITE NOTITLE NOHDR *PROGRAM *TIMX(EM=YYYY'-'MM'-'DD' 'HH':'II)
    SATLGV-ERROR-TEXT
  IF SATLGV-LOG-DBID NE 0 OR SATLGV-LOG-FNR NE 0
    WRITE NOTITLE NOHDR *PROGRAM *TIMX(EM=YYYY'-'MM'-'DD' 'HH':'II)
      'Dbid:' SATLGV-LOG-DBID 'Fnr:' SATLGV-LOG-FNR
  END-IF
  COMPRESS 'NOM0005' SATLGV-ERROR-TEXT TO P-ERT
  CALLNAT 'XXCONTRM' 'T' G-TASK-NUMBER 5 P-ERT #TRACING
END-IF
*
END-SUBROUTINE /* CHECK-SAT-LOG-FILE
*
************************************************************************
DEFINE SUBROUTINE LOCAL-MONITOR-RECORD
************************************************************************
#G-NPR-USERID := G-NPR-USERID
CALLNAT 'RMSWNODE' 'L'            /* switch to local node
  G-TASK-NUMBER G-NATRP-DBID G-NATRP-FNR #TRACING
IF G-NATRP-ERC NE 0
  PERFORM XXRLOG-WRITE-LOG 'W' G-NATRP-ERT
  G-SHUTDOWN:= TRUE
  END TRANSACTION
  FETCH 'RMCHKDWN'
END-IF
RESET +NOD-CURRENT-ID /* begin first cycle with local node
G-NPR-USERID := +NOD-LOCAL-USER
*
END-SUBROUTINE /* LOCAL-MONITOR-RECORD
*
************************************************************************
DEFINE SUBROUTINE DELETE-START-EVENT
************************************************************************
FIND NATURAL-SUB-TASK WITH NODE = G-MONITOR-NODE AND NAT-STATUS='ACTIVE'
AND FUNCTION = 'LIST' AND NAT-USER = 'NO*'                            /*
  IF NAT-USER = MASK('NO'.'X') AND NAT-USER = SCAN(#EOM-SYSF)
    P-FUNCTION := 'DELETE' /* No more needed, product start complete.
    #EVENT     := DDNAME   /* Had been set in NOMSATxx.
    PERFORM EVENTING
  END-IF
END-FIND
*
END-SUBROUTINE /* DELETE-START-EVENT
*
************************************************************************
DEFINE SUBROUTINE INIT-UX-EVENTS
************************************************************************
EVENTING.P-FUNCTION := 'INIT'
#EVENT              := 'all' /* dummy entry
PERFORM EVENTING
*
END-SUBROUTINE /* INIT-UX-EVENTS
*
************************************************************************
DEFINE SUBROUTINE EVENTING
************************************************************************
P-NODE       := +NOD-LOCAL-NODE
P-EVENT-NAME := #EVENT
IF P-EVENT-NAME = ' '
  ESCAPE ROUTINE /* no eventing required.
END-IF
P-WAIT-TIME  := 0
CALLNAT 'RMEVNT-N' EVENTING
IF P-ERROR-CODE NE 0 AND P-ERROR-CODE NE 890 /* does not exist
AND P-ERROR-CODE NE 888 /* NPR VSE Bug P288164 in                     /*
  G-NATRP-ERC := P-ERROR-CODE
  G-NATRP-ERT := P-ERROR-TEXT
  SKIP 3
  WRITE '--> Error starting monitor' G-NATRP-ERC
  PRINT '                          ' G-NATRP-ERT /*SU17 (AL=70)
  PERFORM WRITE-MESSAGE-TO-LOG
END-IF
*
END-SUBROUTINE /* EVENTING
*
************************************************************************
DEFINE SUBROUTINE WRITE-MESSAGE-TO-LOG
************************************************************************
IF G-NATRP-ERC = 5500 THRU 5999 OR G-NATRP-ERC = 3148
  LG-MSG:= G-NATRP-ERT
ELSE
  COMPRESS G-NATRP-ERC G-NATRP-ERT TO LG-MSG
END-IF
RMTASK-P.FUNCTION       := 'L'
RMTASK-P.SUBTASK-NUMBER := G-TASK-NUMBER
CALLNAT 'RMTASKID' RMTASK-P
LG-USERID := RMTASK-P.TASK-ID
*
LG-CODE := 'MO'
CALLNAT 'RLOG' PL-PARMS
END TRANSACTION
RESET G-NATRP-ERC G-NATRP-ERT
*
END-SUBROUTINE /* WRITE-MESSAGE-TO-LOG
*
************************************************************************
DEFINE SUBROUTINE CHECK-LFILE91
************************************************************************
RMTASK-P.FUNCTION       := 'S'
RMTASK-P.SUBTASK-NUMBER := 1
CALLNAT 'RMTASKID' RMTASK-P
CALLNAT 'RMCHK91N' RMTASK-P.TASK-ID G-NATRP-ERC G-NATRP-ERT
DECIDE ON FIRST VALUE OF G-NATRP-ERC
  VALUE 1538, 1544, 1571
    PERFORM LONG-MESSAGE
  NONE IGNORE
END-DECIDE
*
END-SUBROUTINE              /* CHECK-LFILE91
*
************************************************************************
DEFINE SUBROUTINE LONG-MESSAGE  /* BLI 2015-12-25 NOMALL-1572 created
************************************************************************
RESET SHORT-MSG LONG-MSG(*)
VERSION := 0
NADA2000.OBJECT-KIND    := 'U'
NADA2000.ERROR-NUMBER   := G-NATRP-ERC
NADA2000.OPT-INSERT-DYN := FALSE
NADA2000.OPT-LANGUAGE   := *LANGUAGE
CALLNAT 'RGETLIB' NADA2000.LIBRARY
REPEAT
* get short and long message
  CALLNAT 'NATA2000' NADA2000  NATA2000.EXTENDED-PARMS NAD-MSG NAD-FLD
  #XX-SHORT-TEXT := SHORT-MSG
  IF G-NATRP-ERT NE ' '       /* dynamic variables from RMCHK91N
    SEPARATE G-NATRP-ERT INTO #XX-MSG-DYNA (1:8)
      REMAINDER #XX-MSG-DYNA (9) WITH DELIMITER ' '
    CALLNAT 'XXSUBS-N' #XX-SUBS-PARMS
  END-IF
  WRITE '-->'
  PRINT '-->' #XX-SHORT-TEXT /*SU17 (AL=70)
  WRITE '-->'
* log the short message - note: RLOG makes its own resolution of
* of message numbers in front of message, which means a mixture of
* message parameters, too. The compressed hyphen ('-') prevents a
* change of text
  COMPRESS '-' #XX-SHORT-TEXT   TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'W' G-TRACE-MSG
*
  FOR #I = 1 TO 20
    IF LONG-MSG(#I) NE ' ' AND LONG-MSG(#I) NE '.'
      PRINT '-->' LONG-MSG(#I) /*SU17 (AL=75)
      G-TRACE-MSG := LONG-MSG(#I)
      PERFORM XXRLOG-WRITE-LOG 'W' G-TRACE-MSG
      RESET #FILLER-LINE
    ELSE
      IF #FILLER-LINE EQ FALSE
        WRITE '-->'
        #FILLER-LINE := TRUE
      END-IF
    END-IF
  END-FOR
* get English
  IF  OPT-LANGUAGE GT 1
    OPT-LANGUAGE := 1
    ESCAPE TOP
  END-IF
  END TRANSACTION
  ESCAPE BOTTOM
END-REPEAT
*
END-SUBROUTINE /* LONG-MESSAGE
*
************************************************************************
ON ERROR
************************************************************************
  CALLNAT 'C-NATERN' LG-MSG
  PRINT NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
    'Initialization failed in' LG-MSG /*SU17 (AL=30)
  WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
    'MONITOR goes down'
  COMPRESS '0021' LG-MSG TO LG-MSG
  IF NOT (*ERROR-NR = 3000 THRU 3255)
    CALLNAT 'RLOG' PL-PARMS
    LG-MSG := P-ERT := '1513'
    CALLNAT 'RLOG' PL-PARMS
    CALLNAT 'XXCONTRM' 'C' G-TASK-NUMBER 1513 P-ERT #TRACING
    END OF TRANSACTION
  END-IF
  STACK TOP COMMAND 'FIN'
  STACK TOP COMMAND 'LASTMSG'
  STOP
END-ERROR
*
END
