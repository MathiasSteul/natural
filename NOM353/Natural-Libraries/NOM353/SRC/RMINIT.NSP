*
************************************************************************
* Main line
************************************************************************
*
FORMAT PS=60 LS=133
*
IF +DEVICE = ' ' /* not set by RMINIONL for testing purposes
  +DEVICE := *DEVICE
END-IF
IF *MACHINE-CLASS = 'MAINFRAME' /*SU16
  #MF := TRUE
END-IF
CALLNAT 'NSC-ACT' SECURITY-ACTIV
IF NOT SECURITY-ACTIV
  FOR #I = 1 TO *OCC(#LIB-NAME)
    IF #LIB-NAME(#I) = ' '
      ESCAPE BOTTOM
    END-IF
    #USER-STEPLIB := #LIB-NAME(#I)
    PERFORM ADD-USER-STEPLIB
    #LIB-ADDED(#I):= TRUE
  END-FOR
END-IF
PERFORM XXPARAMS-SET-PARAM 'WH=ON'
RESET +ERROR-COUNT-UX
*
WRITE NOTITLE NOHDR ' '
WRITE 'E O M   M O N I T O R'
WRITE '====================='
WRITE *PROGRAM 'started at' *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
SKIP 1
NOMVER-PRODUCTNAME := 'EOM'
CALLNAT 'PRDVER-N' NOMVER-PARMS G-NATRP-ERC G-NATRP-ERT
COMPRESS NOMVER-VERSION '.' NOMVER-RELEASE
  '.' NOMVER-SP '.' NOMVER-CF TO #PRODUCT-VER LEAVING NO
WRITE 'Running NOM version ' #PRODUCT-VER 'of date' NOMVER-DATE
SKIP 3
* --------------------------------------- main -------------------------
FETCH RETURN 'RM-ETR-P' 'RM-ERRTA'
*ERROR-TA := 'RM-ERRTA'
*LANGUAGE := 1
*
RESET G-NATRP-ERC G-NATRP-ERT
*
DECIDE FOR EVERY CONDITION
  WHEN G-NATRP-ERC = 0
    PERFORM INPUT-PARAMETER
  WHEN G-NATRP-ERC = 0
    PERFORM ADD-SAT-STEPLIB
  WHEN G-NATRP-ERC = 0
    PERFORM CHECK-SAT-LOG-FILE
  WHEN G-NATRP-ERC = 0
    PERFORM SET-EOM-SYSTEM-FILE
  WHEN G-NATRP-ERC = 0 AND #MF
    PERFORM EVALUATE-START-RECORD
  WHEN G-NATRP-ERC = 0 AND #MF
    PERFORM EVALUATE-MY-PARAMETERS
  WHEN G-NATRP-ERC = 0
    PERFORM LOCAL-MONITOR-RECORD
  WHEN G-NATRP-ERC = 0
    PERFORM READ-MONITOR-DEFINITION
  WHEN G-NATRP-ERC = 0
    PERFORM CHECK-LFILE91
  WHEN G-NATRP-ERC = 0
    CALLNAT 'RMCKCMPR'      /* Check for valid NOMCOMPR routine
      G-NATRP-ERC G-NATRP-ERT G-TRACE
    IF G-NATRP-ERC NE 0
      COMPRESS '0005' 'RMCKCMPR reports:' G-NATRP-ERT TO G-TRACE-MSG
      PERFORM XXRLOG-WRITE-LOG 'W' G-TRACE-MSG
    END-IF
  WHEN G-NATRP-ERC = 0
    FETCH RETURN 'NOMSTCSR' /*write MSG Ü (was:Reset statistics values)
/*SU23    WRITE / 'RMINIT -- O4I Statistics = ' +O4I (EM='OFF'/'ON') /
  WHEN G-NATRP-ERC = 0
    FETCH RETURN 'RMUNLOCK' /* Reset all usage stamps for sources (lock)
  WHEN G-NATRP-ERC = 0
    PERFORM SYSTEM-INFORMATION
  WHEN G-NATRP-ERC = 0
    PERFORM CORRECT-ORDER-NUMBERS
  WHEN G-NATRP-ERC = 0 AND NOT #MF
    #POINT := 'start of monitor task'
  WHEN G-NATRP-ERC = 0 AND NOT #MF
    PERFORM SHOW-NOMCOMPR-VERSION
  WHEN G-NATRP-ERC = 0 AND NOT #MF AND G-TASK-NUMBER = 1
    PERFORM INIT-UX-EVENTS
  WHEN G-NATRP-ERC = 0 AND #MF
    PERFORM DELETE-START-EVENT
  WHEN G-NATRP-ERC = 0
    PERFORM FILL-GDA-NEW-VARIABLES
  WHEN G-NATRP-ERC = 0
    PERFORM EVALUATE-NAF-PARAMETERS
  WHEN G-NATRP-ERC = 0 AND #MF /*SU14
    PERFORM EVALUATE-NOMUSR-PARAMETERS
  WHEN G-NATRP-ERC = 0
    IF SYSTEM-INFO-VIEW.SYSTEM-TYPE = SCAN 'BS2'
      PERFORM EVALUATE-BS2000-USER
    END-IF
  WHEN G-NATRP-ERC = 0 AND #MF AND G-PRTASK-NUMBER > 0
    PERFORM EVALUATE-PRTASK-PARAMETERS
  WHEN G-NATRP-ERC = 0 AND #MF AND G-NSC-ACTIVE
    PERFORM EVALUATE-ARC-PARAMETERS
  WHEN G-NATRP-ERC = 0 AND #MF AND G-NSC-ACTIVE
    PERFORM EVALUATE-REV-PARAMETERS
  WHEN G-NATRP-ERC = 0
    PERFORM READ-CLEANUP-DEFAULTS
  WHEN G-NATRP-ERC = 0 AND G-TASK-NUMBER = 1
    FETCH RETURN 'RMODRS'        /* set unfinished orders to 'failed'
  WHEN G-NATRP-ERC = 0 AND G-TASK-NUMBER = 1
    PERFORM RESET-REPORT-PROCESSING-NOW
    PERFORM START-SUBTASKS        /* start subordinate tasks
    CALLNAT 'RMSETSTN' #EQU-INIT
      G-MONITOR-NODE G-NATRP-DBID G-NATRP-FNR G-SHUTDOWN G-TASK-NUMBER
  WHEN G-NATRP-ERC = 0
    PERFORM CLEANUP-PRINTER-TASKS
  WHEN NONE IGNORE
END-DECIDE
************************************************************************
IF G-NATRP-ERC NE 0 /* error occured
  G-TRACE-MSG := P-ERT := '1513'
  PERFORM XXRLOG-WRITE-LOG 'W' G-TRACE-MSG
  IF G-TASK-NUMBER = 1 /* speaks for the whole monitor
    CALLNAT 'XXCONTRM' 'C' G-TASK-NUMBER 1513 P-ERT #TRACING
  END-IF
  END TRANSACTION
  IF #MF
    FETCH RETURN 'RMRDCDSP'  /* Display RDC statistics in batch
    FETCH RETURN 'RDCDISIO'
  END-IF
  STACK TOP COMMAND 'FIN'
  STACK TOP COMMAND 'LASTMSG'
  STOP
END-IF
* ***** ok Ü
G-TRACE-MSG := P-ERT := '1510'
PERFORM XXRLOG-WRITE-LOG 'W' G-TRACE-MSG
IF G-TASK-NUMBER = 1 /* speaks for the whole monitor
  CALLNAT 'XXCONTRM' 'S'
    G-TASK-NUMBER 1510 P-ERT #TRACING
END-IF
END TRANSACTION
*
FETCH 'RMONITOR'
*
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE INPUT-PARAMETER
************************************************************************
IF #MF
  INPUT (AD=MI)
    'MONITOR ID .............' G-MONITOR-ID
    / 'MONITOR Minimum-Wait ...' G-WAIT-MINIMUM
    / 'MONITOR Maximum-Wait ...' G-WAIT-MAXIMUM
    / 'MONITOR Increment ......' G-WAIT-INCREMENT
    / 'MONITOR Node ...........' G-MONITOR-NODE
    / 'NOM     SYSF ...........' #EOM-SYSF
    / 'SAT     SYSF ...........' #SAT-SYSF
    / 'SAT     Library ........' #SAT-LIBRARY
    / 'SAT     Member .........' #SAT-MEMBER
    / 'MONITOR Task Number.....' G-TASK-NUMBER
ELSE
  INPUT (AD=MI)
    / 'MONITOR Task Number.....' G-TASK-NUMBER
    / 'NOM     SYSF ...........' #EOM-SYSF
  RMTASK-P.FUNCTION       := 'L'
  RMTASK-P.SUBTASK-NUMBER := G-TASK-NUMBER
  CALLNAT 'RMTASKID' RMTASK-P
  G-MONITOR-ID      := RMTASK-P.TASK-ID
  G-WAIT-MINIMUM    := 5
  G-WAIT-MAXIMUM    := 30
  G-WAIT-INCREMENT  := 5
  #SAT-LIBRARY      := 'SYSSATU'
END-IF
IF G-TASK-NUMBER LT 1
  G-TASK-NUMBER:= 1
END-IF
RMTASK-P.FUNCTION       := 'S'
RMTASK-P.SUBTASK-NUMBER := G-TASK-NUMBER
CALLNAT 'RMTASKID' RMTASK-P
#SUBTASK-ID             := RMTASK-P.TASK-ID
G-NATRP-DBID            := #EOM-DBID
G-NATRP-FNR             := #EOM-FNR
G-LG-USERID             := G-MONITOR-ID
+G-TASK-NUMBER          := G-TASK-NUMBER
RMTASK-P.FUNCTION       := 'L'
RMTASK-P.SUBTASK-NUMBER := G-TASK-NUMBER
CALLNAT 'RMTASKID' RMTASK-P
LG-USERID := RMTASK-P.TASK-ID
LG-CODE   := 'MO'
IF #MF
  PRINT *PROGRAM 'Input Parameter '
    / 'MONITOR ID .............' G-MONITOR-ID
    / 'MONITOR Minimum-Wait ...' G-WAIT-MINIMUM
    / 'MONITOR Maximum-Wait ...' G-WAIT-MAXIMUM
    / 'MONITOR Increment ......' G-WAIT-INCREMENT
    / 'MONITOR Node ...........' G-MONITOR-NODE
    / 'NOM     SYSF ...........' #EOM-SYSF
    / 'SAT     SYSF ...........' #SAT-SYSF
    / 'SAT     Library ........' #SAT-LIBRARY
    / 'SAT     Member .........' #SAT-MEMBER /
    'MONITOR Task Number.....' G-TASK-NUMBER /
ELSE
  PRINT *PROGRAM 'Input Parameter '
    / 'MONITOR Task Number.....' G-TASK-NUMBER
    / 'NOM     SYSF ...........' #EOM-SYSF
END-IF
*
END-SUBROUTINE /* INPUT-PARAMETER
*
************************************************************************
DEFINE SUBROUTINE SET-EOM-SYSTEM-FILE
************************************************************************
SATLF-FUNCTION := 'SET'
SATLF-LFILE    := 206
SATLF-DBID-N5  := #EOM-DBID
SATLF-FNR-N5   := #EOM-FNR
SATLF-SATVERS  := 21
CALLNAT SAT-GET-SET-LFILE SATLF-SATVERS SATLF-PARMS (*)
IF SATLF-ERROR-CODE NE 0
  G-NATRP-ERC := SATLF-ERROR-CODE
  G-NATRP-ERT := SATLF-ERROR-TEXT
  SKIP  2
  WRITE '--> Error setting NOM System File ' G-NATRP-ERC
  PRINT '-->' G-NATRP-ERT /*SU17 (AL=70)
END-IF
RESET RACTLF-ERROR-LOGGING
RACTLF-LOGGING    := TRUE
RACTLF-LOG-USERID := G-LG-USERID
RACTLF-LOG-CODE   := 'MO'
RACTLF-LFILE-1    := 91
RACTLF-LFILE-2    := 206
CALLNAT 'RACTLF-N' RACTLF-PARMS
IF RACTLF-ERROR-CODE NE 0
  G-NATRP-ERC := RACTLF-ERROR-CODE
  WRITE '--> Error setting NOM System File ' G-NATRP-ERC
  WRITE '--> Dbid1:' RACTLF-DBID-1 'Fnr1:' RACTLF-FNR-1
  WRITE '--> Dbid2:' RACTLF-DBID-2 'Fnr2:' RACTLF-FNR-2
END-IF
*
END-SUBROUTINE /* SET-EOM-SYSTEM-FILE
*
************************************************************************
DEFINE SUBROUTINE EVALUATE-START-RECORD
************************************************************************
RESET SATSP-PARMS (*)
SATSP-SATLIB            := #SAT-LIBRARY
SATSP-SATMEM            := #SAT-MEMBER
SATSP-SATDBID-N5        := #SAT-DBID
SATSP-SATFNR-N5         := #SAT-FNR
SATSP-START-SERVDBID-N5 := #EOM-DBID
SATSP-START-SERVFNR-N5  := #EOM-FNR
SATSP-SATVERS           := 21
CALLNAT SAT-START-PARMS SATSP-SATVERS SATSP-PARMS (*)
IF SATSP-ERROR-CODE NE 0
  G-NATRP-ERC := SATSP-ERROR-CODE
  G-NATRP-ERT := SATSP-ERROR-TEXT
  SKIP  2
  WRITE '--> Error reading start record ' G-NATRP-ERC
  PRINT '-->' G-NATRP-ERT /*SU17 (AL=70)
  ESCAPE ROUTINE
END-IF
*
IF SATSP-START-MEMBER = ' '
  #PRD-MEMBER := #SAT-MEMBER
ELSE
  #PRD-MEMBER := SATSP-START-MEMBER
END-IF
*
COMPRESS SATSP-START-PRODUCT SATSP-START-PREFIX TO #PRD-NAME LEAVING NO
*
#PRT-MEMBER := #PRD-MEMBER
COMPRESS #PRD-NAME 'PRT' TO #PRT-NAME LEAVING NO
*
#ARC-MEMBER := #PRD-MEMBER
COMPRESS #PRD-NAME 'ARC' TO #ARC-NAME LEAVING NO
*
#REV-MEMBER := #PRD-MEMBER
COMPRESS #PRD-NAME 'REV' TO #REV-NAME LEAVING NO
*
END-SUBROUTINE /* EVALUATE-START-RECORD
*
************************************************************************
DEFINE SUBROUTINE READ-MONITOR-DEFINITION
************************************************************************
IF #MF
  CALLNAT 'RMSETSTN' #EQU-INIT G-MONITOR-NODE G-NATRP-DBID G-NATRP-FNR
    G-SHUTDOWN G-TASK-NUMBER
END-IF
RESET G-SHUTDOWN
LG-MSG := '1509'
CALLNAT 'RLOG' PL-PARMS
END TRANSACTION
*
RMTASK-P.TASK-ID := F#MONITOR-TASK-ID1 (<>)
FIND-MONIT. FIND NRM-MONITOR WITH M-MONITOR-ID = RMTASK-P.TASK-ID
  IF NO RECORDS FOUND
    G-NATRP-ERC := 9999
    WRITE '   --> Monitor definitions not found'
    ESCAPE BOTTOM (FIND-MONIT.)
  END-NOREC
*
  IF #MF
    READ(1) MF-NODE BY MF-TYPE-ID = 'MR-'
    END-READ
    IF MF-TYPE NE 'M'
      G-NATRP-ERC := 9999
      WRITE '   --> Spool data of monitor definitions not found'
      ESCAPE BOTTOM (FIND-MONIT.)
    END-IF
  ELSE
    RESET MF-NODE /*SU18
  END-IF
*
  DECIDE FOR FIRST CONDITION
    WHEN #EOM-DBID < 1 OR #EOM-FNR < 1
      IGNORE
    WHEN M-NATRPT-DBID-N5 NE #EOM-DBID OR M-NATRPT-FNR-N5 NE #EOM-FNR
      GET NRM-MONITOR *ISN(FIND-MONIT.)
      M-NATRPT-DBID-N5 := #EOM-DBID
      M-NATRPT-FNR-N5  := #EOM-FNR
      UPDATE
    WHEN NONE IGNORE
  END-DECIDE
  FOR #I = 1 TO #MAX-FUNC
    IF M-TASK-NUMBER (#I) NE 0
      G-TASK-TABLE(#I):= M-TASK-NUMBER(#I)
      I:= G-TASK-TABLE(#I)
      #SUBTASK-REQUIRED(I):= TRUE
    END-IF
  END-FOR
  PERFORM RMGTRACE-GET-SETTINGS
  IF G-TRACE > 0
    #TRACING := TRUE
  ELSE
    #TRACING := FALSE
  END-IF
  IF G-TRACE > 0
    WRITE 'RMINIT -- TRACE-Level =' G-TRACE
    WRITE 'RMINIT -- TRACE-Set   =' G-TRACE-SET (AL=100)
    WRITE 'RMINIT -- Wrap-Around =' +TRACE-WRAP 'sec'
  ELSE
    WRITE 'RMINIT -- TRACE = OFF'
  END-IF
  G-TRACE-MSG := 'Scheduling of monitor tasks:'
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  IF G-TASK-NUMBER = 1
    FOR #I = 1 TO #MAX-FUNC
      IF G-TASK-TABLE (#I) > 0
        COMPRESS 'Task' G-TASK-TABLE (#I) 'takes over function'
          #FUNCTION-TABLE (#I) TO G-TRACE-MSG
        PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
      END-IF
    END-FOR
  END-IF
*
  G-CLASSES (*)             := MF-CLASSES (*)
  G-JES3-OUTPUT-CLASSES (*) := MF-JES3-OUTPUT-CLASSES (*)
  RESET +G-BS2-RENAME +G-BS2-COPY
  DECIDE ON FIRST VALUE OF MF-TIME-SCHEDULE /*SU18 (FIND-MONIT.)
    VALUE 'K'  +G-BS2-COPY   := TRUE
    VALUE 'Y'  +G-BS2-RENAME := TRUE
    NONE IGNORE /*  VALUE 'N',' '
  END-DECIDE
  G-BS2-DEST (1:4)  := MF-BS2-DEST (1:4)
  IF M-USE-OWNER = 'Y'
    G-USE-OWNER := TRUE
  ELSE
    RESET G-USE-OWNER
  END-IF
  G-TEMP-CLASS      := MF-TEMP-CLASS
  G-PRINT-CLASS     := MF-PRINT-CLASS
  G-ERROR-CLASS     := MF-ERR-CLASS
  G-MONITOR-JOBNAME := M-XCOM-JOBNAME
  G-BATCH-MODULE    := M-BATCH-MODULE
  G-DEF-FLUSH-TIME  := M-FLUSH-TIME
  G-DEF-PRINTER     := M-DEFAULT-PRINTER
  IF G-TASK-NUMBER > 1
    RMTASK-P.FUNCTION       := 'S'
    RMTASK-P.SUBTASK-NUMBER := G-TASK-NUMBER
    CALLNAT 'RMTASKID' RMTASK-P
    FND-SUBT. FIND NRM-SUBTASK-INFO WITH ST-SUBTASK-ID=RMTASK-P.TASK-ID
      IF NO RECORDS FOUND
        WRITE '   --> Subtask Definition not found'
        ST-SUBTASK-ID     := #SUBTASK-ID
        ST-WAIT-MINIMUM   := M-WAIT-MINIMUM
        ST-WAIT-MAXIMUM   := M-WAIT-MAXIMUM
        ST-WAIT-INCREMENT := M-WAIT-INCREMENT
        ST-WAIT-CURRENT   := M-WAIT-CURRENT
      END-NOREC
      G-WAIT-MINIMUM  := ST-WAIT-MINIMUM
      G-WAIT-MAXIMUM  := ST-WAIT-MAXIMUM
      G-WAIT-INCREMENT:= ST-WAIT-INCREMENT
      G-WAIT-FACTOR   := ST-WAIT-CURRENT
      IF *PID IS (N10)
        ST-PID := VAL(*PID)
      ELSE
        RESET ST-PID
      END-IF
      RESET ST-STATUS
      IF *NUMBER (FND-SUBT.) = 0
        ST-OBJECT-TYPE := 'SI'
        ST-OBJECT-TIME := *TIMX
        STORE NRM-SUBTASK-INFO
      ELSE
        UPDATE (FND-SUBT.)
      END-IF
    END-FIND
  ELSE
    RMTASK-P.FUNCTION       := 'S'
    RMTASK-P.SUBTASK-NUMBER := 1
    CALLNAT 'RMTASKID' RMTASK-P
    FIND NRM-SUBTASK-INFO WITH ST-SUBTASK-ID = RMTASK-P.TASK-ID
      IF *PID IS (N10)
        ST-PID := VAL(*PID)
      ELSE
        RESET ST-PID
      END-IF
      RESET ST-STATUS
      UPDATE
    END-FIND
    G-WAIT-MINIMUM   := M-WAIT-MINIMUM
    G-WAIT-MAXIMUM   := M-WAIT-MAXIMUM
    G-WAIT-INCREMENT := M-WAIT-INCREMENT
    G-WAIT-FACTOR    := M-WAIT-CURRENT
  END-IF
  FOR FI = 1 TO 20
    IF M-COPY-FILES-V141 (FI) = ' '
      ESCAPE TOP
    END-IF
    ADD 1 TO CI
    G-COPY-FILES (CI) := M-COPY-FILES-V141 (FI)
  END-FOR
  G-JOBCARDS (*)  := M-JOBCARD (*)
  G-PRTASK-NUMBER := M-PRT-TASK-NO
  #NOM-SUBTASK-VERSION := SUBSTR(#PRD-NAME,4)
  IF G-TASK-NUMBER = 1
    GET NRM-MONITOR *ISN(FIND-MONIT.)
    RESET M-STATUS
    UPDATE
  END-IF
  END TRANSACTION
END-FIND
*
G-WAIT-FACTOR := G-WAIT-MINIMUM
DECIDE FOR EVERY CONDITION
  WHEN G-WAIT-MINIMUM < 1
    G-WAIT-MINIMUM := 30
  WHEN G-WAIT-MAXIMUM = 0
    G-WAIT-MAXIMUM := 300
  WHEN G-WAIT-MAXIMUM < G-WAIT-MINIMUM
    G-WAIT-MAXIMUM := G-WAIT-MINIMUM
  WHEN G-WAIT-INCREMENT = 0
    G-WAIT-INCREMENT := 5
  WHEN G-MONITOR-NODE = 0 AND #MF
    G-MONITOR-NODE := 148
  WHEN NONE IGNORE
END-DECIDE
*
G-WAIT-FACTOR := G-WAIT-MINIMUM
COMPRESS '1503' G-WAIT-MINIMUM   TO LG-MSG CALLNAT 'RLOG' PL-PARMS
COMPRESS '1504' G-WAIT-MAXIMUM   TO LG-MSG CALLNAT 'RLOG' PL-PARMS
COMPRESS '1505' G-WAIT-INCREMENT TO LG-MSG CALLNAT 'RLOG' PL-PARMS
COMPRESS '1506' G-MONITOR-NODE +NOD-LOCAL-NAME TO LG-MSG
CALLNAT 'RLOG' PL-PARMS
COMPRESS '1507' G-NATRP-DBID     TO LG-MSG CALLNAT 'RLOG' PL-PARMS
COMPRESS '1508' G-NATRP-FNR      TO LG-MSG CALLNAT 'RLOG' PL-PARMS
END TRANSACTION
IF NOT #MF AND G-TASK-NUMBER GT 1  /* BLI1 start
* G-TASK-NUMBER 1 will be handled below (INIT-UX-EVENTS, START-SUBTASKS)
* RESET G-SHUTDOWN after RMSETSTN might be another option  BLI1 end
  CALLNAT 'RMSETSTN' #EQU-INIT G-MONITOR-NODE G-NATRP-DBID G-NATRP-FNR
    G-SHUTDOWN G-TASK-NUMBER
  END TRANSACTION
END-IF
*
END-SUBROUTINE /* READ-MONITOR-DEFINITION
*
************************************************************************
DEFINE SUBROUTINE CORRECT-ORDER-NUMBERS
************************************************************************
READ (1) ACTIVE-REPORTS DESCENDING BY AR-ORDER-REPNAME
END-READ
FIND ORDER WITH OD-ID = 9999999999
  IF OD-LAST-ID LT AR-ORDER-ID         /* POTENTIAL FOR DUPLICATES
    WRITE NOTITLE *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
      'Order number updated from:' OD-LAST-ID
    OD-LAST-ID := AR-ORDER-ID + 1
    WRITE NOTITLE *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
      '                       to:' OD-LAST-ID
    UPDATE
  END-IF
*
END-FIND
END OF TRANSACTION
*
END-SUBROUTINE /* CORRECT-ORDER-NUMBERS
*
************************************************************************
DEFINE SUBROUTINE EVALUATE-NOMUSR-PARAMETERS
************************************************************************
RESET G-SCAN-NOMUSR (*)
FNDUSR. READ NOMUSR BY M-MONITOR-ID = 'NOMUSR'
  IF M-MONITOR-ID NE MASK ('NOMUSR') OR NOT ( #NOMUSR-NR = 100 THRU 105)
    ESCAPE BOTTOM
  END-IF
  IF M-TIME-SCHEDULE (FNDUSR.) = 'Y'
    G-SCAN-NOMUSR (#NOMUSR-NR) := 'Y'
    WRITE '   NOM User Interface' #NOMUSR-NR (EM=999)
      '.... active'
  ELSE
    WRITE '   NOM User Interface' #NOMUSR-NR (EM=999)
      '.... inactive'
  END-IF
END-READ
*
END-SUBROUTINE /* EVALUATE-NOMUSR-PARAMETERS
*
************************************************************************
DEFINE SUBROUTINE EVALUATE-NAF-PARAMETERS
************************************************************************
FNDNAF. FIND NRM-MONITOR WITH M-MONITOR-ID = 'NAF' /* 8.1.9
  IF M-TIME-SCHEDULE NE 'Y' /*SU20 was MF-
    ESCAPE BOTTOM (FNDNAF.)
  END-IF
  RESET NI
  DECIDE FOR FIRST CONDITION
    WHEN C*M-COPY-FILES-V141 > 0
      FOR FI = 1 TO 20
        IF M-COPY-FILES-V141 (FI) = ' '
          ESCAPE TOP
        END-IF
        IF M-CP-IDENT (FI) = MASK ('FS=('............)
          ADD 1 TO NI
          G-NP-IDENT (NI) := M-CP-IDENT (FI)
          G-NP-DBID  (NI) := M-CP-DBID (FI)
          G-NP-FNR   (NI) := M-CP-FNR  (FI)
        END-IF
      END-FOR
    WHEN NONE IGNORE
  END-DECIDE
  G-NP-ENTRIES := NI
  IF G-NP-ENTRIES > 0
    WRITE '   NAF Interface .............' 'active'
    +G-SCAN-NP-TIME-LIMIT := M-WAIT-INCREMENT
  END-IF
END-FIND
*
END-SUBROUTINE /* EVALUATE-NAF-PARAMETERS
*
************************************************************************
DEFINE SUBROUTINE SHOW-NOMCOMPR-VERSION
************************************************************************
CALL 'NSMCMPV' #NOMCOMPR-VERS
#NOMCOMPR-RC := RET('NSMCMPV')
*
IF #NOMCOMPR-RC NE 0
  CALLNAT 'XXCONTRM' 'C' G-TASK-NUMBER 1513
    'NOM1513 Error accessing NOM Compression Routine' #TRACING
  WRITE '   --> Error accessing NOM Compression Routine:'
    #NOMCOMPR-RC
  WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
    'MONITOR goes down'
  STACK TOP COMMAND 'FIN'
  STACK TOP COMMAND 'LASTMSG'
  STOP /* <<== STOP ==>>
END-IF
WRITE / '   Compression Routine Version:' #NOMCOMPR-VERS /
*
END-SUBROUTINE /* SHOW-NOMCOMPR-VERSION
*
************************************************************************
DEFINE SUBROUTINE EVALUATE-MY-PARAMETERS
************************************************************************
RESET  SATPA-PARMS (*)
SATPA-SATDBID-N5    := #SAT-DBID
SATPA-SATFNR-N5     := #SAT-FNR
SATPA-TYPE          := 'SATENV'
SATPA-LIBRARY (1:2) := #SAT-LIBRARY
SATPA-MEMBER  (1)   := #SAT-MEMBER
SATPA-MEMBER  (2)   := #PRD-MEMBER
SATPA-NAME    (1)   := #SAT-NAME
SATPA-NAME    (2)   := #PRD-NAME
SATPA-KEYWORD (1)   := 'ESYUSER'
SATPA-KEYWORD (2)   := 'NSC'
SATPA-KEYWORD (3)   := 'NSCUSER'
SATPA-KEYWORD (4)   := 'NSCPSWD'
*
PI := 5
FOR SI = 1 TO 6
  COMPRESS 'STEPLIB' SI-A TO SATPA-KEYWORD (PI) LEAVING NO
  ADD 1 TO PI
END-FOR
*
SATPA-SATVERS := 21
CALLNAT SAT-GET-MERGED-PARM-ARRAY SATPA-SATVERS SATPA-PARMS (*)
*
IF SATPA-ERROR-CODE NE 0
  G-NATRP-ERC := SATPA-ERROR-CODE
  G-NATRP-ERT := SATPA-ERROR-TEXT
  SKIP  2
  WRITE '--> Error reading SATENV Parameters ' G-NATRP-ERC
  PRINT '-->' G-NATRP-ERT /*SU17 (AL=70)
  ESCAPE ROUTINE
END-IF
*
G-NPR-USERID := SATPA-VALUE (1)
IF G-NPR-USERID = ' '
  G-NPR-USERID := 'NOMMON'
END-IF
RESET G-NPR-CURRENT-USERID
*
SKIP  2
WRITE 'Monitor parameters'
WRITE '   NOM Active Data ...........' RACTLF-DBID-1 RACTLF-FNR-1
WRITE '   ESY UserId ................' G-NPR-USERID
*
IF SATPA-VALUE (2) = 'YES'
  G-NSC-ACTIVE   := TRUE
  +G-NSC-USERID  := G-NSC-USERID := SATPA-VALUE (3)
  G-NSC-PASSWORD := SATPA-VALUE (4)
  WRITE '   NSC UserId ................' G-NSC-USERID
  WRITE '   NSC Password ..............' '$$$$$$$$'
ELSE
  G-NSC-ACTIVE := FALSE
  PERFORM ADD-DEFINED-STEPLIBS
  IF G-NATRP-ERC NE 0
    ESCAPE ROUTINE
  END-IF
END-IF
PERFORM DISPLAY-STEPLIBS
*
END-SUBROUTINE /* EVALUATE-MY-PARAMETERS
*
************************************************************************
DEFINE SUBROUTINE EVALUATE-BS2000-USER
************************************************************************
RESET  SATPA-PARMS (*)
SATPA-SATDBID-N5      := #SAT-DBID
SATPA-SATFNR-N5       := #SAT-FNR
SATPA-TYPE            := 'NOMENV'
SATPA-LIBRARY   (1:2) := #SAT-LIBRARY
SATPA-MEMBER    (1)   := #SAT-MEMBER
SATPA-MEMBER    (2)   := #PRD-MEMBER
SATPA-NAME      (1)   := #SAT-NAME
SATPA-NAME      (2)   := #PRD-NAME
SATPA-KEYWORD   (1)   := 'BS2USER'
SATPA-SATVERS         := 21
CALLNAT SAT-GET-MERGED-PARM-ARRAY SATPA-SATVERS SATPA-PARMS (*)
IF SATPA-ERROR-CODE NE 0
  G-NATRP-ERC := SATPA-ERROR-CODE
  G-NATRP-ERT := SATPA-ERROR-TEXT
  SKIP  2
  WRITE '--> Error reading BS2USER' G-NATRP-ERC
  PRINT '-->' G-NATRP-ERT /*SU17 (AL=70)
  ESCAPE ROUTINE
END-IF
IF SATPA-VALUE (1) = ' '
  G-BS2-USERID := G-NPR-USERID
ELSE
  G-BS2-USERID := SATPA-VALUE (1)
END-IF
WRITE '   BS2000 UserID .............' G-BS2-USERID
*
END-SUBROUTINE /* EVALUATE-BS2000-USER
*
************************************************************************
DEFINE SUBROUTINE EVALUATE-PRTASK-PARAMETERS
************************************************************************
RESET  SATPA-PARMS (*)
SATPA-SATDBID-N5  := #SAT-DBID
SATPA-SATFNR-N5   := #SAT-FNR
SATPA-TYPE        := 'SATENV'
SATPA-LIBRARY (*) := #SAT-LIBRARY
SATPA-MEMBER  (1) := #SAT-MEMBER
SATPA-MEMBER  (2) := #PRD-MEMBER
SATPA-MEMBER  (3) := #PRT-MEMBER
SATPA-NAME    (1) := #SAT-NAME
SATPA-NAME    (2) := #PRD-NAME
SATPA-NAME    (3) := #PRT-NAME
SATPA-KEYWORD (1) := 'NSC'
SATPA-KEYWORD (2) := 'NSCUSER'
SATPA-KEYWORD (3) := 'NSCPSWD'
SATPA-KEYWORD (4) := 'JOBPREF'
SATPA-KEYWORD (5) := 'NATSKEL'
SATPA-KEYWORD (6) := 'NATTASK'
SATPA-KEYWORD (7) := 'NATBATCH'
SATPA-SATVERS := 21
CALLNAT SAT-GET-MERGED-PARM-ARRAY SATPA-SATVERS SATPA-PARMS (*)
IF SATPA-ERROR-CODE NE 0
  G-NATRP-ERC := SATPA-ERROR-CODE
  G-NATRP-ERT := SATPA-ERROR-TEXT
  SKIP  2
  WRITE '--> Error reading SATENV Parameters ' G-NATRP-ERC
  PRINT '-->' G-NATRP-ERT /*SU17 (AL=70)
  ESCAPE ROUTINE
END-IF
G-PRTASK-TYPE                := SATSP-START-TYPE
G-PRTASK-SUBT-MODULE         := SATPA-VALUE (6)
G-PRTASK-SKEL-LIBRARY := #SAT-LIBRARY
G-PRTASK-SKEL-MEMBER         := SATPA-VALUE (5)
G-PRTASK-SKEL-DBID           := #SAT-DBID
G-PRTASK-SKEL-FNR            := #SAT-FNR
G-PRTASK-BTCH-MODULE         := SATPA-VALUE (7)
IF G-NSC-ACTIVE
  G-PRTASK-NSC-USERID := SATPA-VALUE (2)
  G-PRTASK-NSC-PASSWORD := SATPA-VALUE (3)
END-IF
RESET SATMM-PARMS (*)
SATMM-SATDBID-N5     := #SAT-DBID
SATMM-SATFNR-N5      := #SAT-FNR
SATMM-TYPE           := 'NATENV'
SATMM-LIBRARY   (*)  := #SAT-LIBRARY
SATMM-MEMBER    (1)  := #SAT-MEMBER
SATMM-MEMBER    (2)  := #PRD-MEMBER
SATMM-MEMBER    (3)  := #PRT-MEMBER
SATMM-NAME      (1)  := #SAT-NAME
SATMM-NAME      (2)  := #PRD-NAME
SATMM-NAME      (3)  := #PRT-NAME
SATMM-SATVERS        := 21
CALLNAT SAT-MERGE-PARM-MEMBERS SATMM-SATVERS SATMM-PARMS (*)
IF SATMM-ERROR-CODE NE 0
  G-NATRP-ERC := SATMM-ERROR-CODE
  G-NATRP-ERT := SATMM-ERROR-TEXT
  SKIP  2
  WRITE '--> Error reading NATENV Parameters ' G-NATRP-ERC
  PRINT '-->' G-NATRP-ERT /*SU17 (AL=70)
  ESCAPE ROUTINE
END-IF
G-PRTASK-NATENV := SATMM-BLOCK-RESULT
RESET  SATPA-PARMS (*)
SATPA-SATDBID-N5  := #SAT-DBID
SATPA-SATFNR-N5   := #SAT-FNR
SATPA-TYPE        := 'NOMENV'
SATPA-LIBRARY (*) := #SAT-LIBRARY
SATPA-MEMBER  (1) := #SAT-MEMBER
SATPA-MEMBER  (2) := #PRD-MEMBER
SATPA-MEMBER  (3) := #PRT-MEMBER
SATPA-NAME    (1) := #SAT-NAME
SATPA-NAME    (2) := #PRD-NAME
SATPA-NAME    (3) := #PRT-NAME
SATPA-KEYWORD (1) := 'ETID'
SATPA-KEYWORD (2) := 'ETIDPREF'
SATPA-SATVERS     := 21
CALLNAT SAT-GET-MERGED-PARM-ARRAY SATPA-SATVERS SATPA-PARMS (*)
IF SATPA-ERROR-CODE NE 0
  G-NATRP-ERC := SATPA-ERROR-CODE
  G-NATRP-ERT := SATPA-ERROR-TEXT
  SKIP  2
  WRITE '--> Error reading NOMENV Parameters ' G-NATRP-ERC
  PRINT '-->' G-NATRP-ERT /*SU17 (AL=70)
  ESCAPE ROUTINE
END-IF
IF SATPA-VALUE (1) = 'YES'
  +G-PRTASK-ETID := TRUE
  DECIDE FOR FIRST CONDITION
    WHEN SATPA-VALUE (2) NE ' '
      +G-PRTASK-ETID-PREFIX := SATPA-VALUE (2)
    WHEN G-NSC-ACTIVE
      +G-PRTASK-ETID-PREFIX := G-PRTASK-NSC-USERID
    WHEN NONE
      +G-PRTASK-ETID-PREFIX := 'NOMPRT'
  END-DECIDE
ELSE
  RESET +G-PRTASK-ETID +G-PRTASK-ETID-PREFIX
END-IF
CALLNAT 'SATID02N' G-PRTASK-NATENV
PERFORM DISPLAY-PRTASK-PARAMETERS
*
END-SUBROUTINE /* EVALUATE-PRTASK-PARAMETERS
*
************************************************************************
DEFINE SUBROUTINE DISPLAY-PRTASK-PARAMETERS
************************************************************************
RMTASK-P.FUNCTION       := 'L'
RMTASK-P.SUBTASK-NUMBER := G-TASK-NUMBER
CALLNAT 'RMTASKID' RMTASK-P
LG-USERID := RMTASK-P.TASK-ID
LG-CODE   := 'MO'
SKIP  2
WRITE 'Printer Task parameters'
WRITE '   Number of Tasks ...........' G-PRTASK-NUMBER
COMPRESS '1524' G-PRTASK-NUMBER TO LG-MSG
CALLNAT 'RLOG' PL-PARMS
END OF TRANSACTION
WRITE '   Type ......................' G-PRTASK-TYPE
COMPRESS '1525' G-PRTASK-TYPE TO LG-MSG
CALLNAT 'RLOG' PL-PARMS
END OF TRANSACTION
IF G-PRTASK-TYPE = 'SUBTASK'
  WRITE '   NATURAL Subtask Module ....' G-PRTASK-SUBT-MODULE
ELSE
  WRITE '   NATURAL Batch Module ......' G-PRTASK-BTCH-MODULE
  WRITE '   NATURAL Batch Skeleton ....' G-PRTASK-SKEL-MEMBER
  WRITE '   NATURAL Skeleton Library ..' G-PRTASK-SKEL-LIBRARY
  WRITE '   NATURAL Skeleton DBID .....' G-PRTASK-SKEL-DBID
  WRITE '   NATURAL Skeleton FNR ......' G-PRTASK-SKEL-FNR
END-IF
IF G-NSC-ACTIVE
  WRITE '   NSC UserID ................' G-PRTASK-NSC-USERID
  WRITE '   NSC Password ..............' '$$$$$$$$'
END-IF
IF +G-PRTASK-ETID
  WRITE '   ETID Prefix ...............' +G-PRTASK-ETID-PREFIX
END-IF
#NATENV := G-PRTASK-NATENV
RESET J
FOR I = 1 TO 5
  IF #NATENV-L (I) = ' '
    ESCAPE TOP
  END-IF
  ADD 1 TO J
  IF J = 1
    WRITE '   NATENV ....................' #NATENV-L (I)
  ELSE
    WRITE '                              ' #NATENV-L (I)
  END-IF
END-FOR
*
END-SUBROUTINE /* DISPLAY-PRTASK-PARAMETERS
*
************************************************************************
