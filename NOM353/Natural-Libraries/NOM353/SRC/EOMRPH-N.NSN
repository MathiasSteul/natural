* <Natural Source Header
* EOMRPH-N - Report Field Help
*
* Maintenance
* UUU YY-MM-DD Sagsis Desciption
* --- -------- ------ --------------------------------------------------
* mrs 93-06-09        created
* gw  94-11-17        SAP fields added
* SJU 95-07-23        SAP LIST IDS ADDED, PLUS CMA, NAT AND 3GL
* jvd 97-07-09 p(163579) Separator Page length truncation
* fhi 00-09-28 p(196560) Add Unix File Support
* sju 02-04-23 NOM221 Archive type
* sju 02-10-08 NOM221 XML printers
* sju 02-10-31 NOM221 Long records (Jes2 only)
* sju 05-02-21 NOM31  Long records other than Jes2
* xsethz 2008-10-21 p(309624) online help for field EOMPRM-UNIX-FORMST
* fhi 12-08-10 NOMALL-1004 Add help for formatting parameters
* raya 2012-08-20 NOMALL-78 disable long records
* fhi      2014-08-25 NOMALL-1475 Introduce formatter uniprint
* SU1     2015-01-14 NOMALL-1548 removed unused definitions
* fhi     2016-08-01 NOMALL-1748 Backout Report Formatting
* fhi     2016-08-15 NOMALL-1620 Add field EOMRPM-REMOTE-NODE
* SU2     2017-10-09 NOMALL-1823 NOM 3.5: remove CONNECT,ECL,XML
* fhi     2018-10-29 NOMALL-2125 Use codepages at identification only
* SU3     2023-04-13 ES-33831    same help: act. RP = RP: HRPPKEY
* SU4     2024-03-07 ES-34613    NOM 3.6:Remove SAP / z/VSE(power)
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 #FIELD-NAME       (A65)
************************************************************************
LOCAL
1 F                 (P2)
1 #FIELD            (A65)
1 REDEFINE #FIELD
  2 #F              (A1/1:65)
1 REDEFINE #FIELD
  2 #FIELD_A7       (A7)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#FIELD := #FIELD-NAME
EXAMINE #FIELD FOR '.' GIVING POSITION F
IF F > 0
  RESET #F (1:F)
  MOVE LEFT #FIELD TO #FIELD
END-IF
IF #FIELD_A7 = 'EOMARM-' /*e.g. 'EOMARM-KEYWORDS' SU3
  #FIELD_A7 := 'EOMRPM-' /*use same help for AR as for RP
END-IF
*
DECIDE ON FIRST #FIELD
  VALUE 'EOMRPM-DESC'                    INPUT USING MAP 'HRPPDSC&'
  VALUE 'EOMRPM-REPORT-TYPE'             INPUT USING MAP 'HRPPTYP&'
  VALUE 'EOMRPM-MASTER-OWNER'            INPUT USING MAP 'HRPPOWN&'
  VALUE 'EOMRPM-KEYWORDS'                INPUT USING MAP 'HRPPKEY&'
  VALUE '#S-KEYWORDS','#L-KEYWORD','#S-AND' /*RFNDRP- SU3
    SET CONTROL 'WA' /*avoid garbadge on screen from pass. help
    INPUT USING MAP 'HRPPKY&'
