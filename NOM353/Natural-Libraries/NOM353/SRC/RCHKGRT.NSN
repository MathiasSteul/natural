* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RCHKGRT
* CHECK IF USER IS ALLOWED TO MODIFY AN OBJECT
* mrs 91-05-27 f(218) grant options not checked correctly
* mrs 92-01-24 check if distribution list grants exist
* xsiszha 2000-08-01 (CE7461) Extend Report and Bundle Names
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 #FUNC             (A1)
1 #USERID           (A8)
1 #OBJTYPE          (A1)
1 #OBJNAME          (A25)
1 #OPTIONS          (A1/1,1:6) /*not used
1 GRANTED           (L)
************************************************************************
LOCAL USING VGRANT-L
LOCAL
1 LIST VIEW OF NRM-DISTRIBUTION-LIST
  2 D-LIST-NAME
1 #GR-SUPER         (A34)
1 REDEFINE #GR-SUPER
  2 #GR-T           (A1)
  2 #GR-U           (A8)
  2 #GR-N           (A25)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET GRANTED
#GR-T := #OBJTYPE
#GR-U := #USERID
#GR-N := #OBJNAME
FIND-GR. FIND GRANTS WITH GR-SUPER = #GR-SUPER
  DECIDE ON FIRST VALUE OF #FUNC
    VALUE 'D'  /* DISPLAY
      IF GR-OPTION(1:4) = 'Y' GRANTED := TRUE END-IF
    VALUE 'M'  /* modify
      IF GR-OPTION(1:3) = 'Y' GRANTED := TRUE END-IF
    VALUE 'P'  /* purge
      IF GR-OPTION(1) = 'Y' OR GR-OPTION(3) = 'Y' GRANTED := TRUE END-IF
    NONE VALUE IGNORE
  END-DECIDE
  ESCAPE ROUTINE
END-FIND
*
FNDDL. FIND LIST WITH D-USER-LIST = #USERID
  #GR-U := D-LIST-NAME
  FIND-GR2. FIND GRANTS WITH GR-SUPER = #GR-SUPER
    DECIDE ON FIRST VALUE OF #FUNC
      VALUE 'D'  /* DISPLAY
        IF GR-OPTION(1:4) = 'Y' GRANTED := TRUE END-IF
      VALUE 'M'  /* modify
        IF GR-OPTION(1:3) = 'Y' GRANTED := TRUE END-IF
      VALUE 'P'  /* purge
        IF GR-OPTION(1) ='Y' OR GR-OPTION(3) ='Y' GRANTED := TRUE END-IF
      NONE VALUE IGNORE
    END-DECIDE
    IF GRANTED
      ESCAPE ROUTINE
    END-IF
  END-FIND
END-FIND
#GR-U := 'PUBLIC'
FIND-GR1. FIND GRANTS WITH GR-SUPER = #GR-SUPER
  DECIDE ON FIRST VALUE OF #FUNC
    VALUE 'D'  /* DISPLAY
      IF GR-OPTION(1:4) = 'Y' GRANTED := TRUE END-IF
    VALUE 'M'  /* DISPLAY
      IF GR-OPTION(1:3) = 'Y' GRANTED := TRUE END-IF
    VALUE 'P'  /* DISPLAY
      IF GR-OPTION(1) = 'Y' OR GR-OPTION(3) = 'Y' GRANTED := TRUE END-IF
    NONE VALUE IGNORE
  END-DECIDE
END-FIND
*
END
