* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* XSETVAR -  Return a string based on the machine and the language
*            -  First parameter is string arr for mainframe text
*            -  Second parameter is string arr for unix text
* ----------------------------------------------------------------------
* Maintenance
* -----------
* uuuuuu  yyyy-mm-dd iTrac       Remark
* NKEW1   2024-07-24 EF-4541     Decide according to OS and language
* ----------------------------------------------------------------------
*
DEFINE FUNCTION F#SETVAR RETURNS #STRING (A) DYNAMIC
  DEFINE DATA PARAMETER
  1 #MF_STRS (A/1:2) DYNAMIC BY VALUE
  1 #UNIX_STRS (A/1:2) DYNAMIC BY VALUE
************************************************************************
  END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
IF *MACHINE-CLASS = 'UNIX'
  IF *LANGUAGE = 2
    #STRING := #UNIX_STRS(2)
  ELSE
    #STRING := #UNIX_STRS(1)
  END-IF
ELSE /* If it is not UNIX or mainframe else is safer option
  IF *LANGUAGE = 2
    #STRING := #MF_STRS(2)
  ELSE
    #STRING := #MF_STRS(1)
  END-IF
END-IF
END-FUNCTION
END
