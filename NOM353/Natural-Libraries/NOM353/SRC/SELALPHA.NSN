* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    SELALPHA
* Version   1.3
* Function  Init FROM and TO values for search
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* gw  96-11-14           cleanup
* xsiszha 2000-08-04 (CE7461) Extend Report and Bundle Names
* fhi     2009-12-18 P320734  NAT1317 if long selection strings
* SU1     2019-11-14 NOMALL-2253 feedback customer:longer path+filename
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 #VALUE                (A250) BY VALUE RESULT /*SU1 was (A25)
1 #FROM                 (A250) BY VALUE RESULT /*SU1 was (A25)
1 REDEFINE #FROM
  2 #FROM-V             (A1/250) /*SU1 was 25
1 #TO                   (A250) BY VALUE RESULT /*SU1 was (A25)
1 #LEN                  (N3)
1 #USE-AS-START-VALUE   (L) OPTIONAL /*SU1
************************************************************************
LOCAL
1 #POS                  (P3)
************************************************************************
/*SU1 INDEPENDENT 1 +G-USE-AS-START-VALUE (L) -> #USE-AS-START-VALUE
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
IF #VALUE = ' '
  #FROM := '*'
ELSE
  #FROM := #VALUE
END-IF
*
EXAMINE #FROM FOR '*' GIVING POSITION #POS LENGTH #LEN
*
IF #POS > 0
  RESET #FROM-V (#POS:#LEN)
  COMPRESS #FROM '*' TO #VALUE LEAVING NO
  #TO := #FROM
  EXAMINE FULL #TO ' ' REPLACE H'FF'
ELSE
  #FROM := #VALUE
/*SU1  IF +G-USE-AS-START-VALUE
  IF #USE-AS-START-VALUE SPECIFIED AND #USE-AS-START-VALUE /*SU1
    MOVE ALL H'FF' TO #TO
  ELSE
    #TO := #VALUE
  END-IF
END-IF
*
IF #VALUE = '*'
  RESET #VALUE
END-IF
*
END
