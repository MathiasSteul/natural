* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    NOMBR01N
* Function  Add/modify report in bundle definition
* Version   1.3.4
*
* Note      If the report is not contained in the bundle definition
*           it is added. If it already exists, attributes are modified.
*
* Maintenance:
* uuu     yyyy-mm-dd s(999999) ....
* gw      1995-10-31 s(230704) created
* jvd     1998-09-14 p(164220) NAT23ÖNOM141
* fhi     2000-08-24 QA03      Use NAT23006 for error values
* xsethz  2000-09-06 (CE7461) Extend Report and Bundle Names
* xsetggr 2007-05-18 p(289847) restore NOM lfile when error occurs
* fhi     2007-07-12 NOM3202   C-NATERR changed, NAD23006 is obsolete.
* xsetggr 2008-08-11 p(300323) add steplibs to work with NOM API
* xsetggr 2008-12-05 p(300323) change adding of steplibs
* xsetggr 2009-02-10 P300323   delete steplib handling, use RGETLIB to
*                              get NOM library
* fhi     2009-02-27 P300323 Rename RGETSTEP to NOMGSTEP delivered in SYSTEM
* fhi    2010-09-21 NOMALL-97 Use no more C-NATERR but C-NATERN instead
* SU1     2014-11-12 NOMALL-1527 getting rid of coding for old versions
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER USING NOMBR--P
*
LOCAL USING EOM----E
LOCAL USING EOM----P
LOCAL USING EOMMSG-P
LOCAL USING NOMBR--E
LOCAL USING EOMBRM-P
LOCAL USING SATFNC3E
LOCAL USING SATLF02P
*
LOCAL
1 #LFILE-CHANGED      (L)
1 #NOM-DBID           (N5)
1 #NOM-FNR            (N5)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
/*SU1 IF NOMBR-NOMVERS < 21
/*SU1   NOMBR-BUNDLE := NOMBR-BUNDLE-V14
/*SU1   NOMBR-REPORT := NOMBR-REPORT-V14
/*SU1 END-IF
*
RESET NOMBR-ERROR-CODE NOMBR-ERROR-TEXT
*
DECIDE FOR EVERY CONDITION
  WHEN NOMBR-NOM-FNR NE 0 AND NOMBR-NOM-DBID NE 0
    PERFORM GET-NOM-LFILE
    PERFORM SET-NOM-LFILE
    #LFILE-CHANGED := TRUE
  WHEN SATLF-ERROR-CODE = 0
    PERFORM OBJECT-MAINTENANCE
  WHEN #LFILE-CHANGED
    PERFORM SET-OLD-NOM-LFILE
  WHEN NONE
    IGNORE
END-DECIDE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE OBJECT-MAINTENANCE
************************************************************************
CALLNAT 'RGETLIB' EOM-LIBRARY
*
DECIDE ON FIRST NOMBR-FUNCTION
  VALUE NOMBR-FCT-READ-NEXT, NOMBR-FCT-READHOLD-NEXT, NOMBR-FCT-READHOLD
    EOM-FUNCTION    := NOMBR-FUNCTION
    EOMBRM-I-BUNDLE := NOMBR-BUNDLE
    EOMBRM-I-REPORT := NOMBR-REPORT
    PERFORM CALL-INTERNAL-API
    NOMBR-ATTRIBUTES (*) := EOMBRM-ATTRIBUTES (*)
    NOMBR-EOF            := EOMBRM-EOF
  VALUE NOMBR-FCT-MODIFY
    EOM-FUNCTION          := EOM-MODIFY
    EOMBRM-I-BUNDLE       := NOMBR-BUNDLE
    EOMBRM-I-REPORT       := NOMBR-REPORT
    EOMBRM-ATTRIBUTES (*) := NOMBR-ATTRIBUTES (*)
    PERFORM CALL-INTERNAL-API
  VALUE NOMBR-FCT-COMMIT
    EOM-FUNCTION := EOM-COMMIT
    PERFORM CALL-INTERNAL-API
  VALUE NOMBR-FCT-BACKOUT
    EOM-FUNCTION := EOM-BACKOUT
    PERFORM CALL-INTERNAL-API
  NONE NOMBR-ERROR-CODE := 20
    PERFORM GET-ERR-TXT
END-DECIDE
*
END-SUBROUTINE /* OBJECT-MAINTENANCE
*
************************************************************************
DEFINE SUBROUTINE CALL-INTERNAL-API
************************************************************************
RESET EOMMSG-PARMS
CALLNAT 'EOMBRM-N' EOM-PARMS EOMBRM-PARMS EOMMSG-PARMS
*
IF EOMMSG-NR NE 0
  NOMBR-ERROR-CODE := EOMMSG-NR
  IF EOMMSG-TEXT = ' '
    PERFORM GET-ERR-TXT
  ELSE
    NOMBR-ERROR-TEXT := EOMMSG-TEXT
  END-IF
  ESCAPE ROUTINE
END-IF
*
END-SUBROUTINE /* CALL-INTERNAL-API
*
************************************************************************
DEFINE SUBROUTINE GET-NOM-LFILE
************************************************************************
SATLF-LFILE    := 206
SATLF-FUNCTION := 'GET'
*
CALLNAT SAT-GET-SET-LFILE SATLF-SATVERS SATLF-PARMS (*)
*
#NOM-DBID := SATLF-DBID-N5
#NOM-FNR  := SATLF-FNR-N5
*
END-SUBROUTINE /* GET-NOM-LFILE
*
************************************************************************
DEFINE SUBROUTINE SET-LFILE
************************************************************************
SATLF-LFILE    := 206
SATLF-FUNCTION := 'SET'
*
CALLNAT SAT-GET-SET-LFILE SATLF-SATVERS SATLF-PARMS (*)
*
END-SUBROUTINE /* SET-LFILE
*
************************************************************************
DEFINE SUBROUTINE SET-NOM-LFILE
************************************************************************
SATLF-DBID-N5 := NOMBR-NOM-DBID
SATLF-FNR-N5  := NOMBR-NOM-FNR
*
PERFORM SET-LFILE
*
END-SUBROUTINE /* SET-NOM-LFILE
*
************************************************************************
DEFINE SUBROUTINE SET-OLD-NOM-LFILE
************************************************************************
SATLF-DBID-N5 := #NOM-DBID
SATLF-FNR-N5  := #NOM-FNR
*
PERFORM SET-LFILE
*
END-SUBROUTINE /* SET-OLD-NOM-LFILE
*
************************************************************************
DEFINE SUBROUTINE GET-ERR-TXT
************************************************************************
NOMBR-ERROR-TEXT := F#GETMSG (<NOMBR-ERROR-CODE, EOMMSG-TOKEN(1:3)>)
*
END-SUBROUTINE /* GET-ERR-TXT
*
************************************************************************
ON ERROR
************************************************************************
  IF #LFILE-CHANGED
    PERFORM SET-OLD-NOM-LFILE
  END-IF
  IF *ERROR-NR = 82
    WRITE *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II':'SS'.'T)
      'Missing NOM steplibs' //
      'Please call NOM steplib routine NOMGSTEP before call of NOM API.'
  END-IF
  NOMBR-ERROR-CODE := NOMBR-ERROR-TEXT := 21
  CALLNAT 'C-NATERN' NOMBR-ERROR-TEXT 'W'
  ESCAPE ROUTINE
END-ERROR
*
END
