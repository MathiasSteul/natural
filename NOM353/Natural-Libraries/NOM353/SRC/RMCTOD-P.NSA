DEFINE DATA PARAMETER
/* >Natural Source Header 000000
/* :Mode S
/* :CP
/* <Natural Source Header
* **RMCTOD-P PARAMETERS FOR CATALOG  NATURAL   SOURCE /* NOMALL-2008
* **---------------------------------------------------------------------
1 RMCTOD
  2 RMCTOD-COMMAND (A50) /* STOW,CAT,CHECK,SAVE
  2 RMCTOD-LIBRARY (A8) /* NAT LIB OF PROGRAM
  2 RMCTOD-PROGRAM (A8) /* PROGRAM NAME
  2 RMCTOD-TYPE (A1) /* NATURAL PROGR. TYPE EXT
  2 RMCTOD-ORDER-ID (P10) /* ORDER ID GENERATED
  2 RMCTOD-SOURCE (A/1:*) DYNAMIC /* SOURCE LINES
  2 RMCTOD-LAST-IX (I4) /* LAST WRITTEN SOURCE LIN
  2 RMCTOD-SHORTMSG (L) /* GET SHORT MESSAGES
  2 RMCTOD-ERROR-CODE (N4)
  2 RMCTOD-ERROR-TEXT (A250)
  2 RMCTOD-TRACING (L) OPTIONAL
END-DEFINE
