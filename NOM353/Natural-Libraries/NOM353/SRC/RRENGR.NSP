* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RRENGR - RENAME MENTRY IN GRANT FILE
*
* XSISZHA 2000-08-07 (CE7461) EXTEND REPORT AND BUNDLE NAMES
* xsetggr 2012-12-18 NOMAL-89 implement using EOMGRM-N and rename for DL
* ----------------------------------------------------------------------
DEFINE DATA
LOCAL USING VGRANT-L
LOCAL USING EOMGRM-P
LOCAL USING EOMMSG-P
LOCAL USING EOM----E
LOCAL
1 #T        (A1)
1 #O        (A25)
1 #NEWNAME  (A25)
1 #I        (I4)
1 #TYPE     (A1/5)  INIT <'B','F','L','P','R'>
1 #GR-SUPER (A34)
1 REDEFINE #GR-SUPER
  2 #GR-T   (A1)
  2 #GR-U   (A8)
  2 #GR-N   (A25)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
SET KEY PF3
*
INPUT #T #O #NEWNAME
EOMGRM-I-TYPE := #T
EOMGRM-I-NAME := #O
EOMGRM-I-NEWNAME := #NEWNAME
CALLNAT 'EOMGRM-N' EOM-RENAME EOMGRM-PARMS EOMMSG-PARMS
* rename all records with user=list name
IF #T = 'L'
  FOR #I = 1 TO 5
    #GR-T := #TYPE(#I)
    #GR-U := #O
    RESET #GR-N
    RDGR. READ GRANTS WITH GR-SUPER = #GR-SUPER
      IF GR-OBJECT-TYPE NE #GR-T OR GR-USERID NE #GR-U
        ESCAPE BOTTOM(RDGR.)
      END-IF
      GETGR. GET GRANTS *ISN(RDGR.)
      GR-USERID := #O
      UPDATE (GETGR.)
    END-READ
  END-FOR
END-IF
*
END
