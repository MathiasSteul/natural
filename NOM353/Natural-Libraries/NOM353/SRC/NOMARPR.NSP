* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    NOMARPR
* Version   1.4.1
* Function  Example - Print all Active Reports to the specified logical
*                     printer
*
* Parameters in : 1. NOM dbid, if necessary to set NOM lfile
*                 2. NOM fnr, if necessary to set NOM lfile
*                 3. Name of defined Logical printer
*                 4. NOM library (if not specified set default = SYSNOM)
*                 5. Active Report/Bundle name for selection
*                    ('*' allowed)
*                 6. start rnb for Active Reports
*                 7. end rnb for Active Rreports
*           out:  8. number of created printout records
*                 9. error code:
*                    1 - Invalid parameter value
*                    2 - No Active Reports found for specified range
*                10. error text
* Maintenance
* uuu     yy-mm-dd   s(999999) ...
* XSETGGR 2005-11-22 s(999999) created
* XSETGGR 2007-09-04 NOM3201   support P11 format run numbers
* fhi     2010-09-03 NOMALL-97 Extend message line
* SU1     2020-06-19 NOMALL-2349 show full msg
* ----------------------------------------------------------------------
DEFINE DATA
LOCAL
1 NOMARPR-PARMS      /* parms
  2 P-NOM-DBID (N5)  /* in: NOM file dbid (optional)
  2 P-NOM-FNR  (N5)  /* in: NOM file fnr (optional)
  2 P-PRINTER  (A8)  /* in: name of valid logical printer(mandatory)
  2 P-LIBRARY  (A8)  /* in: NOM library(optional), if not specified,
    /*     default value = 'SYSNOM' will be set
  2 P-NAME     (A25) /* in: name of Active Report for selection range
    /*     '*' allowed (optional)
  2 P-RNB-S    (P11) /* in: start run number(optional)
  2 P-RNB-E    (P11) /* in: end run number(optional)
  2 P-NUMBER   (P10) /* out: number of created printout records
  2 P-ERC      (N4)  /* out: error code;
  2 P-ERT      (A250)
/*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
RESET P-NOM-DBID P-NOM-FNR /* nom file dbid and fnr to set NOM lfile
P-PRINTER := 'SGGRJES' /* printer will be checked is it a valid printer
P-LIBRARY := 'NOM311M' /*if not specified, set default value = 'SYSNOM'
RESET P-NAME /* name selection: = '*' or = ' ' - all Active
/* If p-name, p-rnb-s and p-rnb-e not specified,
/* for all Active Reports will be created printout records
/* to print on selected printer
RESET P-RNB-S  /* start run number, if = 0 & :
/* 1. end run number = 0 - all Active Reports specified
/*            by name will be marked
/* 2. end run number > 0 - all specified by name
/*              Active Reports until end run number
/*              will be marked
RESET P-RNB-E  /* end run number, if = 0 & :
/* 1. start run number > 0 - all specified by name Active
/*          Reports from specified start run number will
/*          be marked
/* 2. start run numeb = 0 - all Active Reports specified
/*          by name will be marked
WRITE 'PRINTING ACTIVE REPORTS TO PRINTER' P-PRINTER
/*
CALLNAT 'NOMARPRN' NOMARPR-PARMS
IF P-ERC NE 0
  PRINT *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
    'ERROR:' P-ERC P-ERT /*SU1 (AL=70)
ELSE
  PRINT (AD=L) *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
    P-NUMBER 'PRINTOUT RECORDS HAVE BEEN CREATED'
END-IF
*
END
