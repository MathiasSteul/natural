* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* XXCPAGT  Change trigraphs in text: '??%' -> '??*??*%' so that NPR OS
*   can decode it ('??%' -> '?').
*   Switch XS-C-TRIGRAPH in XXUX---N must be set to 'Y' to be
*   able to send formfeed. Table contains ALL trigraphs (XXCPAGU does
*   not). Used in RMPRDSK (DISKUNIX printer) if switch in exit UEX-HTML
*   is set (new handling with NOMALL-2646).
*   So in XXUX---N XS-C-TRIGRAPH is set to 'Y', to be able to use
*   formfeed '??+' (changed here from H'0C').
*   NO HTML encoding is used (XS-C-HTML-CODE-HANDLING = 'N').
*
* Maintenance
* -----------
* uuuuuu  yyyy-mm-dd iTrac       Remark
* SU      2023-09-22 NOMALL-2646 created from XXCPAGA
************************************************************************
DEFINE DATA
*
PARAMETER
1 #STRING   (A) DYNAMIC BY VALUE RESULT
************************************************************************
LOCAL
1 #I        (I4)
1 #A3       (A3)
1 #NPR-MAX  (I2) CONST <14>
1 #NPR-TAB  (A3/#NPR-MAX,1:2) CONST /*1. column just for info
  (01,V) <U'?',    '??*' >  /* ?  Question mark             H'3F'
  (02,V) <UH'0009','??&' >  /* Öt tab                       H'09'
  (03,V) <UH'000C','??+' >  /* Öf formfeed                  H'0C'
  (04,V) <UH'005C','??/' >  /* Ö  Backslash                 H'5C'
  (05,V) <UH'005E','??'''>  /* ?  Caret/Dach/Hochzeichen    H'5E'
  (06,V) <UH'007C','??_' >  /* !  Vertical bar, Pipe        H'7C'
  (07,V) <UH'0040','??%' >  /* §  At sign                   (not H'40')
  (08,V) <UH'007B','??<' >  /* ä  opening Curly bracket     H'7B'
  (09,V) <UH'007D','??>' >  /* ü  closing Curly bracket     H'7D'
  (10,V) <UH'005B','??(' >  /* ?  opening Square bracket    H'5B'
  (11,V) <UH'005D','??)' >  /* ]  closing Square bracket    H'5D'
  (12,V) <U'Ü',    '??:' >  /* Ü  Exclamation mark          H'21'
  (13,V) <UH'0060','??;' >  /* `  Grave accent              H'60'
  (14,V) <UH'007E','??-' >  /* ß  Tilde                     H'7E'
1 #REP    (A7) /* 6+1: '??*??**'+<x>
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
* 1. part: mask trigraphs: '??&' -> '??*??*&' / '??-' -> '??*??*-'
IF #STRING = SCAN '??'
  FOR #I = 1 TO #NPR-MAX
    #A3 := #NPR-TAB (#I,2)
    COMPRESS '??*??*' SUBSTR(#A3,3) TO #REP LEAVING NO
    EXAMINE #STRING FOR #NPR-TAB (#I,2) REPLACE #REP
  END-FOR
END-IF
* 2. part: formfeed (H'0C') -> '??+':
EXAMINE #STRING FOR #NPR-TAB (3,1) REPLACE #NPR-TAB (3,2)
*
END
