* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RDELPO-N  Delete Printouts for Report-RNB
*
* Maintenance
* gw 96-03-18  s(242610) intermittent ETs
* xsiszha 2000-08-01 (CE7461) Extend Report and Bundle Names
* xsetggr 2007-05-03 NOM3201  Support P11 format run numbers
* fhi     2011-05-02 NOMALL-901 Log any online delete operation
* fhi     2011-09-14 NOMALL-901 Add printer name to logging
* xsetggr 2011-09-28 NOMALL-901 add report/bundle + rnb info to logging
* ----------------------------------------------------------------------
DEFINE DATA
PARAMETER USING RDELPO-A
************************************************************************
LOCAL
1 PRINTOUTS VIEW OF NRM-PRINTOUTS
  2 PO-REPNAME
  2 PO-REPRNB
  2 PO-USERID
  2 PO-LOGICAL
  2 PO-BUNDLE
  2 PO-BUNDRNB
  2 PO-ID
*
1 #PO-REPORT-RNB           (A31)
1 REDEFINE #PO-REPORT-RNB
  2 #REPNAME               (A25)
  2 #REPRNB                (P11)
*
1 L-OWNER-OR-ADMIN         (L)
1 #OBJ                     (A60)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#REPNAME := P-REPORT
#REPRNB := P-REPRNB
*
IF P-USER-TYPE = 'A' OR P-OWNER
  L-OWNER-OR-ADMIN := TRUE
END-IF
*
FIND PRINTOUTS WITH PO-REPORT-RNB = #PO-REPORT-RNB
  IF L-OWNER-OR-ADMIN OR P-USERID = PO-USERID
    DELETE
    IF PO-REPNAME > ' '
      COMPRESS PO-REPNAME '/' PO-REPRNB TO #OBJ LEAVING NO
    ELSE
      COMPRESS PO-BUNDLE '/' PO-BUNDRNB TO #OBJ LEAVING NO
    END-IF                      /* xsetggr 2011-09-20 NOMALL-901 end
    COMPRESS #OBJ '/' PO-LOGICAL '/' PO-ID TO #OBJ LEAVING NO
    PERFORM RMLOGDEL #OBJ 'PRINTOUT'
  END-IF
  IF *COUNTER > 50
    RESET *COUNTER
    END OF TRANSACTION
  END-IF
END-FIND
END OF TRANSACTION
*
END
