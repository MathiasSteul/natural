************************************************************************
* Main line
************************************************************************
*
FORMAT LS=133 PS=60
*
IF *MACHINE-CLASS NE 'MAINFRAME'
  FETCH 'RJARCUX'
END-IF
#MF := TRUE /*SU15
*
PERFORM #INIT
* compare #NATCARDS1 in RMARCJOB: two cards mean two INPUT
INPUT G-MONITOR-JOBNAME
  /  G-NPR-USERID
  /  G-MONITOR-NODE
  /  #CURRENT-ARCHIVE-NO
  /  #SAVE-ARCHIVE-NO
  /  #ARCHIVE-DSNAME
INPUT #AD-EXPIRATION-DATE-PHYS
  /  #NOMEX008
  /  #USERARC-NUMBER
PERFORM PRINT-PARMS
*
IF #NOMEX008 = 'Y'
  +G-NOMEXIT-ACTIVE(8):= TRUE
END-IF
*
PERFORM CHECK_SET-LFILES
PERFORM CHECK-ARCHIVE-DATASET
PERFORM CHECK-USER-ARCHIVE
PERFORM CHECK-NAT_LIB_MEM
* *****
COMPRESS '0442' #ARCHIVE-NAME TO LG-MSG /*:1:Archiver started.
PERFORM #RLOG
* *****
PERFORM GET-ENVIRONMENT-INFORMATION
*
G-NPR-CURRENT-USERID := G-NPR-USERID
CALLNAT 'N-ESYLG' 1X G-MONITOR-NODE G-NPR-CURRENT-USERID #CALLER
  G-NATRP-ERC G-NATRP-ERT 1X 'x' /*err:terminate
PERFORM PURGE-ACTIVE-REPORTS
PERFORM ARCHIVE-ACTIVE-REPORTS  /*1. part:write to work ÜÜ
PERFORM UPD-AR /*2. part:mark AR as archived ÜÜ
PERFORM FINALIZE-USER-ARCHIVE
PERFORM FINALIZE
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE READ-SYSOUT-PORTION
************************************************************************
DECIDE ON FIRST VALUE OF SOURCE.SR-TYPE /*SU 2018-10-10 G-SOURCE-TYPE
  VALUE JES2, JES3            PERFORM READ-JES-PORTION
/*SU23  VALUE POWER                 PERFORM READ-POWER-PORTION
/*SU23  VALUE SEQUENTIAL-FILE-VSE   PERFORM READ-FVSE-PORTION
  VALUE SEQUENTIAL-FILE-MVS   PERFORM READ-FMVS-PORTION
  VALUE SEQUENTIAL-FILE-BS2   PERFORM READ-FBS2-PORTION
  VALUE NOM-DATA-BASE         PERFORM READ-NOMDB-PORTION
  NONE
    SPOOL-ERROR := TRUE
    MOVE EDITED SOURCE.SR-TYPE (EM=HH) TO #ERR-TXT
    COMPRESS 'Invalid source type of report' #ERR-TXT TO #ERR-TXT
    PERFORM WRITE-ERROR-IN-SYSOUT
END-DECIDE
*
END-SUBROUTINE /* READ-SYSOUT-PORTION
*
************************************************************************
DEFINE SUBROUTINE READ-JES-PORTION
************************************************************************
JES. FIND READ-SPOOL WITH NODE = #JES-NODE AND JOB-NAME = #JES-JOB-NAME
AND JOB-NUMBER     = #JES-JOB-NUMBER AND TYPE           = #JES-TYPE   /*
AND DATA-SET-KEY = #JES-DATA-SET-KEY AND RECORD-NUMBER >= #FROM-LINE  /*
  IF READ-SPOOL.ERROR-CODE > 0
    #ERROR-CODE := READ-SPOOL.ERROR-CODE
    PERFORM CHECK-FATAL-ERROR
    #ERR-TXT := READ-SPOOL.ERROR-TEXT
    PERFORM WRITE-ERROR-IN-SYSOUT
    SPOOL-ERROR := TRUE
    ESCAPE ROUTINE
  END-IF
  IF RECORD-NUMBER > #TO-LINE
    ESCAPE BOTTOM
  END-IF
  #I-TEXT := RECORD
  COMPCB-ILEN := RECORD-LENGTH
  COMPCB-ILEN-OLD := RECORD-LENGTH /* for compat
  IF RECORD-LENGTH > 251
    COMPCB-ILEN := 251
    COMPCB-ILEN-OLD := 251 /* for compat
    COMPRESS '7205' RECORD-NUMBER #JES-JOB-NUMBER TO LG-MSG
    PERFORM #RLOG
  END-IF
  PERFORM SYSOUT-PORTION-COMMON
END-FIND
*
END-SUBROUTINE /* READ-SYSOUT-PORTION
*
************************************************************************
DEFINE SUBROUTINE READ-FMVS-PORTION
************************************************************************
FMVS. FIND READ-FILE WITH NODE = #FMVS-NODE AND DSNAME = #FMVS-DSNAME
AND RECFM = #FMVS-RECFM AND LRECL = #FMVS-LRECL AND SEGMENT-LENGTH = 251
AND BLKSIZE = #FMVS-BLKSIZE AND RECORD-NUMBER >= #FROM-LINE           /*
  IF READ-FILE.ERROR-CODE > 0
    #ERROR-CODE := READ-FILE.ERROR-CODE
    PERFORM CHECK-FATAL-ERROR
    #ERR-TXT := READ-FILE.ERROR-TEXT
    PERFORM WRITE-ERROR-IN-SYSOUT
    SPOOL-ERROR := TRUE
    ESCAPE ROUTINE
  END-IF
  IF RECORD-NUMBER > #TO-LINE
    ESCAPE BOTTOM
  END-IF
  #I-TEXT := RECORD
  COMPCB-ILEN := SEGMENT-LENGTH
  COMPCB-ILEN-OLD := SEGMENT-LENGTH /* for compat
  IF SEGMENT-NUMBER > 1 AND SEGMENT-LENGTH < 251
    COMPRESS '§' #I-TEXT TO #I-TEXT LEAVING NO /*1. byte is cc-character
    EXAMINE SUBSTRING (#I-TEXT,1,1) FOR '§' REPLACE WITH ' '
  END-IF
  PERFORM SYSOUT-PORTION-COMMON
*
END-FIND
*
END-SUBROUTINE /* READ-FMVS-PORTION
*
************************************************************************
DEFINE SUBROUTINE READ-FBS2-PORTION
************************************************************************
FBS2. FIND READ-FILE WITH NODE = #FBS2-NODE AND DSNAME = #FBS2-DSNAME
AND RECORD-NUMBER >= #FROM-LINE AND SEGMENT-LENGTH = 251              /*
  IF READ-FILE.ERROR-CODE > 0
    #ERROR-CODE := READ-FILE.ERROR-CODE
    PERFORM CHECK-FATAL-ERROR
    #ERR-TXT := SUBSTR(READ-FILE.ERROR-TEXT,1,7)
    IF SYSTEM-MESSAGE-CODE NE ' '
      COMPRESS #ERR-TXT '('SYSTEM-MESSAGE-CODE ')' TO #ERR-TXT
    ELSE
      #ERR-TXT := READ-FILE.ERROR-TEXT
    END-IF
    PERFORM WRITE-ERROR-IN-SYSOUT
    SPOOL-ERROR := TRUE
    ESCAPE ROUTINE
  END-IF
  IF RECORD-NUMBER > #TO-LINE
    ESCAPE BOTTOM
  END-IF
  #I-TEXT := RECORD
  COMPCB-ILEN := SEGMENT-LENGTH
  COMPCB-ILEN-OLD := SEGMENT-LENGTH /* for compat
  IF SEGMENT-NUMBER > 1 AND SEGMENT-LENGTH < 251
    COMPRESS '§' #I-TEXT TO #I-TEXT LEAVING NO /*1. byte is cc-character
    EXAMINE SUBSTRING (#I-TEXT,1,1) FOR '§' REPLACE WITH ' '
  END-IF
  PERFORM SYSOUT-PORTION-COMMON
*
END-FIND
*
END-SUBROUTINE /* READ-FBS2-PORTION
*
************************************************************************
DEFINE SUBROUTINE DELETE-DATASET
************************************************************************
FIND CATALOG WITH NODE = G-MONITOR-NODE AND DSNAME = #DELDSNAME
AND PREFIX = 'NO'                                                     /*
  IF CATALOG.ERROR-CODE > 0
    WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
      'Error reading catalog information' #DELDSNAME
    WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
      CATALOG.ERROR-TEXT
    ESCAPE ROUTINE
  END-IF
*
  IF CLASS = 'DASD'
    FIND VTOC-UPDATE WITH NODE = G-MONITOR-NODE AND DSNAME = #DELDSNAME
    AND VOLSER = VOLSER AND FUNCTION = 'PURGE'                        /*
      /*purge
    END-FIND
  END-IF
END-FIND
FIND CATALOG-UPDATE WITH NODE = G-MONITOR-NODE AND DSNAME = #DELDSNAME
AND FUNCTION = 'UNCATLG'                                              /*
  IF CATALOG-UPDATE.ERROR-CODE > 0
    WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
      'Error uncataloging dataset' #DELDSNAME
    WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
      CATALOG-UPDATE.ERROR-TEXT
    ESCAPE ROUTINE
  END-IF
END-FIND
*
END-SUBROUTINE /* DELETE-DATASET
*
************************************************************************
DEFINE SUBROUTINE GET-ENVIRONMENT-INFORMATION
************************************************************************
FIND MF-MONITOR-NODE WITH MF-TYPE-ID = 'MR-'-H'00' THRU 'MR-'-H'FF'
/*SU22 #MONIT-ID := F#MONITOR-TASK-ID1 (<>)
/*SU22 FIND ENVIRONMENT WITH M-MONITOR-ID = #MONIT-ID
  IF NO RECORDS FOUND
    WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
      'Environment Definitions not found'
    STOP
  END-NOREC
  #SYSTEM-TYPE := MF-SYSTEM-TYPE /*SU22
END-FIND
*
END-SUBROUTINE /* GET-ENVIRONMENT-INFORMATION
*
************************************************************************
