*
************************************************************************
* Main line
************************************************************************
*
FORMAT LS=132
*
PERFORM RMGTRACP-GET-SETTINGS
IF G-TRACE GE *LEVEL AND G-TRACE-SET = SCAN ('PRINT')
  #TRACING := TRUE
END-IF
#HEX-TIMESTAMP := +HEX-TIMESTAMP
PERFORM SATTIMST-GET-TIME #HEX #HEX-TIMESTAMP
+HEX-TIMESTAMP := #HEX-TIMESTAMP
*
INPUT (AD=MIT) '=' #PO-ID '=' #ESY-USER '=' #FOLLOW-PRINTOUT
  '=' #NOMEXIT-6 '=' #OPTION '=' #TASK-TYPE #NSC-ACTIVE
*
RESET G-NATRP-ERC G-NATRP-ERT #BUCP
PERFORM INIT-FUNCTION
*
IF G-NATRP-ERC = 0
  PERFORM GET-FLAGS
  DECIDE FOR FIRST CONDITION
    WHEN G-NATRP-ERC NE 0
      IGNORE
    WHEN #OPTION = 'ALL'
      REPEAT
        UNTIL G-NATRP-ERC NE 0 OR #BUCP >= #BUCOPIES
        ADD 1 TO #BUCP
        PERFORM PRINT-ACTIVE-BUNDLE
      END-REPEAT
      LAST-PORTION := TRUE               /* does not work here
    WHEN NONE
      PERFORM PRINT-ACTIVE-BUNDLE-PORTION
  END-DECIDE
END-IF
NOMWK-TASK-TYPE:= EQU-MANAGE-PRINTOUTS
CALLNAT NOM-WAKE-MONITOR NOMWK-NOMVERS NOMWK-PARMS (*)
IF LOGOFF-FROM-ESY /*AND *MACHINE-CLASS = 'MAINFRAME'
  CALLNAT 'N-ESYLG' SATSL-LOGOFF PRINTOUT.PO-NODE #ESY-USER #CALLER
    G-NATRP-ERC G-NATRP-ERT 2X #TRACING
END-IF
IF STEPLIB-ADDED
  PERFORM REMOVE-STEPLIB
END-IF
*
PERFORM UPDATE-PRINTOUT-RECORD
*
IF #FOLLOW-PRINTOUT = 'N' OR G-NATRP-ERC NE 0
  PERFORM RMPRSTCS-WRITE-STATISTICS PO-UPD.PO-LOGICAL
    PO-UPD.PO-LAST-PRINTED-RECNO PO-UPD.PO-STATUS PO-UPD.PO-MSG
    FLUSH-CC-TYPE
  IF #NOMEXIT-6 = 'Y'
    PERFORM CALL-STATISTIC-EXIT
  END-IF
END-IF
COMPRESS PRINTOUT.PO-BUNDLE '/' PRINTOUT.PO-BUNDRNB TO #ERROR-TEXT /*SU8
  LEAVING NO
IF G-NATRP-ERC = 0
  PRINT NOTITLE NOHDR *PROGRAM 10T *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
    'Print Bundle terminated normally:' #ERROR-TEXT /*SU8
ELSE
  PRINT NOTITLE NOHDR *PROGRAM 10T *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
    'Print Bundle' #ERROR-TEXT /*SU8
    'terminated with condition code' G-NATRP-ERC
  PRINT NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
    'Error Text' G-NATRP-ERT /*SU6 (AL=70)
  IF #TASK-TYPE NE 'SUBTASK' AND *MACHINE-CLASS = 'MAINFRAME'
    TERMINATE 50
  END-IF
END-IF
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
************************************************************************
DEFINE SUBROUTINE PRINT-ACTIVE-BUNDLE
************************************************************************
#BC-BUNDLE-RNB-GROUP-SEQNO.#BC-BUNDLE  := PRINTOUT.PO-BUNDLE
#BC-BUNDLE-RNB-GROUP-SEQNO.#BC-BUNDRNB := PRINTOUT.PO-BUNDRNB
RESET #BC-BUNDLE-RNB-GROUP-SEQNO.#BC-GROUP
RESET #BC-BUNDLE-RNB-GROUP-SEQNO.#BC-SEQNO
*
FLUSH-BRACKET := 'F'
CALLNAT 'RGETLIB' NAT00053-LIBRARY
+G-L9-EXISTS:= TRUE
CALLNAT 'NAT00053' NAT00053-PARMS
IF NAT00053-RSP = 0
  CALLNAT 'RMBUNSEQ' #BC-BUNDLE-RNB-GROUP-SEQNO.#BC-BUNDLE (AD=O)
    #BC-BUNDLE-RNB-GROUP-SEQNO.#BC-BUNDRNB (AD=O) +G-L9-EXISTS
END-IF
IF +G-L9-EXISTS
  PERFORM READ-BUNDLE-CONTENTS-NEW
ELSE
  PERFORM READ-BUNDLE-CONTENTS-OLD
END-IF
IF G-NATRP-ERC = 0
  IF +WKF-NUMBER NE 2                 /* NOT RECFM=Fxx P306371 +WKF-NUMBER
    FLUSH-RECORD-LENGTH := 133
  END-IF
  RESET ACTIVE-REPORT.AR-RECORD-LENGTH
  IF #PRINT-BUNDLE-SEP AND NOT(AB-SEP-END = 'NONE' OR = 'KEIN')
    IF #BUCP = #BUCOPIES
      FLUSH-SEGMENT := 'L'
      IF FLUSH-PRINTER-TYPE = 'DISKUNIX' OR = 'NATUNIX'
        FLUSH-BRACKET := 'L'
      END-IF
    END-IF
    RMSPFL-TYPE := BUNDLE-END-SEPARATOR
    PERFORM PRINT-SEPARATOR
    IF G-NATRP-ERC = 1006 /* member not found
      RESET G-NATRP-ERC
      AB-SEP-END := 'NONE'
    END-IF
  END-IF
END-IF
*
END-SUBROUTINE /* PRINT-ACTIVE-BUNDLE
*
************************************************************************
DEFINE SUBROUTINE READ-BUNDLE-CONTENTS-NEW
************************************************************************
READ BUNDLE-CONTENTS BY BC-BUNDLE-RNB-GROUP-SEQNO-REPRNB
= #BC-BUNDLE-RNB-GROUP-SEQNO                                          /*
  AT START OF DATA
    IF #BUCP = 1
      FLUSH-SEGMENT := 'F'
    END-IF
    IF +WKF-NUMBER NE 2                 /* NOT RECFM=Fxx P306371 +WKF-NUMBER
      FLUSH-RECORD-LENGTH := 133
    END-IF
    IF #PRINT-BUNDLE-SEP
    AND NOT(ACTIVE-BUNDLE.AB-SEP-START = 'NONE' OR = 'KEIN')          /*
      RMSPFL-TYPE := BUNDLE-START-SEPARATOR
      PERFORM PRINT-SEPARATOR
      IF G-NATRP-ERC = 1006 /* member not found
        RESET G-NATRP-ERC
        AB-SEP-START := 'NONE'
      END-IF
    END-IF
    IF G-NATRP-ERC = 0
      PERFORM PRINT-BUNDLE-VTOC
    END-IF
    IF G-NATRP-ERC NE 0
      ESCAPE ROUTINE
    END-IF
  END-START
  #PRINT-REPORT-SEP := TRUE
  IF BC-BUNDLE NE #BC-BUNDLE-RNB-GROUP-SEQNO.#BC-BUNDLE OR
      BC-BUNDRNB NE #BC-BUNDLE-RNB-GROUP-SEQNO.#BC-BUNDRNB
    ESCAPE ROUTINE
  END-IF
  RESET FLUSH-PARMS.FLUSH-LAST-REPORT
  #BC-BUNDLE-REPRNB.#BC-BUNDLE  := BUNDLE-CONTENTS.BC-BUNDLE
  #BC-BUNDLE-REPRNB.#BC-BUNDRNB := BUNDLE-CONTENTS.BC-BUNDRNB
  #BC-BUNDLE-REPRNB.#BC-GROUP   := BUNDLE-CONTENTS.BC-GROUP
  #BC-BUNDLE-REPRNB.#BC-SEQNO   := BUNDLE-CONTENTS.BC-SEQNO
  #BC-BUNDLE-REPRNB.#BC-REPNAME := BUNDLE-CONTENTS.BC-REPNAME
  #BC-BUNDLE-REPRNB.#BC-REPRNB  := BUNDLE-CONTENTS.BC-REPRNB
  IF #TRACING
    COMPRESS 'Read curr.contents:' 'BC-Bundle:' BC-BUNDLE
      'BC-Bundle RNB:' BC-BUNDRNB 'BC-Report RNB:' BC-REPRNB
      TO G-TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END-IF
  INCLUDE CMRDC
  FLUSH-PARMS.FLUSH-LAST-REPORT := 'Y'
  CONT-CHECK. READ (2) BUNDLE-CONT-CHECK /*next record still sameBundle?
  BY BC-BUNDLE-RNB-GROUP-SEQNO-REPRNB = #BC-BUNDLE-REPRNB             /*
    IF *COUNTER EQ 1
      ESCAPE TOP
    END-IF
    IF #TRACING
      COMPRESS 'Read next contents:' 'BC-Bundle:' BC-BUNDLE
        'BC-Bundle RNB:' BC-BUNDRNB 'BC-Report RNB:' BC-REPRNB
        TO G-TRACE-MSG
      PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
    END-IF
    IF BUNDLE-CONT-CHECK.BC-BUNDLE       = BUNDLE-CONTENTS.BC-BUNDLE
    AND BUNDLE-CONT-CHECK.BC-BUNDRNB = BUNDLE-CONTENTS.BC-BUNDRNB     /*
      RESET FLUSH-PARMS.FLUSH-LAST-REPORT
    END-IF
  END-READ
  IF #TRACING
    COMPRESS 'Flush Last Report:' FLUSH-PARMS.FLUSH-LAST-REPORT
      TO G-TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END-IF
  IF (BC-SEP-START ='NONE' OR='KEIN' AND BC-SEP-END ='NONE' OR='KEIN')
  OR #FLAG-REPSEP NE 'Y' OR BC-SEPNO = 0                              /*
    RESET #PRINT-REPORT-SEP
  END-IF
  PERFORM BUNDLE-CONTENTS
  IF G-NATRP-ERC NE 0
    ESCAPE BOTTOM
  END-IF
END-READ
*
END-SUBROUTINE /* READ-BUNDLE-CONTENTS-NEW
*
************************************************************************
DEFINE SUBROUTINE READ-BUNDLE-CONTENTS-OLD
************************************************************************
READ BUNDLE-CONTENTS BY BC-BUNDLE-RNB-GROUP-SEQNO
= #BC-BUNDLE-RNB-GROUP-SEQNO                                          /*
  AT START OF DATA
    IF #BUCP = 1
      FLUSH-SEGMENT := 'F'
    END-IF
    IF +WKF-NUMBER NE 2                 /* NOT RECFM=Fxx
      FLUSH-RECORD-LENGTH := 133
    END-IF
    IF #PRINT-BUNDLE-SEP
    AND NOT(ACTIVE-BUNDLE.AB-SEP-START = 'NONE' OR = 'KEIN')          /*
      RMSPFL-TYPE := BUNDLE-START-SEPARATOR
      PERFORM PRINT-SEPARATOR
      IF G-NATRP-ERC = 1006 /* member not found
        RESET G-NATRP-ERC
        ACTIVE-BUNDLE.AB-SEP-START := 'NONE'
      END-IF
    END-IF
    IF G-NATRP-ERC = 0
      PERFORM PRINT-BUNDLE-VTOC
    END-IF
    IF G-NATRP-ERC NE 0
      ESCAPE ROUTINE
    END-IF
  END-START
  #PRINT-REPORT-SEP := TRUE
  IF BC-BUNDLE NE #BC-BUNDLE-RNB-GROUP-SEQNO.#BC-BUNDLE
  OR  BC-BUNDRNB NE #BC-BUNDLE-RNB-GROUP-SEQNO.#BC-BUNDRNB            /*
    ESCAPE ROUTINE
  END-IF
  IF BC-SEPNO = 0 OR ((BC-SEP-START = 'NONE' OR = 'KEIN')
  AND (BC-SEP-END = 'NONE' OR = 'KEIN'))                              /*
  OR #FLAG-REPSEP NE 'Y'                                              /*
    RESET #PRINT-REPORT-SEP
  END-IF
  PERFORM BUNDLE-CONTENTS
  IF G-NATRP-ERC NE 0
    ESCAPE ROUTINE
  END-IF
END-READ
*
END-SUBROUTINE /* READ-BUNDLE-CONTENTS-OLD
*
************************************************************************
DEFINE SUBROUTINE BUNDLE-CONTENTS
************************************************************************
IF BUNDLE-CONTENTS.BC-REPNO = 0
  BUNDLE-CONTENTS.BC-REPNO := 1
END-IF
#AR-REPNAME := BUNDLE-CONTENTS.BC-REPNAME
#AR-REPRNB  := BUNDLE-CONTENTS.BC-REPRNB
PERFORM READ-ACTIVE-REPORT
IF G-NATRP-ERC NE 0
  RESET G-NATRP-ERC G-NATRP-ERT
  ESCAPE TOP
END-IF
#RPCOPIES := BUNDLE-CONTENTS.BC-REPNO
RESET #RPCP
REPEAT
  UNTIL G-NATRP-ERC NE 0 OR #RPCP >= #RPCOPIES
  ADD 1 TO #RPCP
  PERFORM PRINT-ACTIVE-REPORT
END-REPEAT
IF G-NATRP-ERC NE 0
  ESCAPE ROUTINE
END-IF
*
END-SUBROUTINE /* BUNDLE-CONTENTS
*
************************************************************************
DEFINE SUBROUTINE PRINT-ACTIVE-BUNDLE-PORTION
************************************************************************
RESET CP SSEP ESEP SCP
INPUT (AD=MIT) #NEXT-TYPE TYPE NAME RNB CP
IF #NEXT-TYPE = 'RP'
  INPUT (AD=MIT) SSEP ESEP SCP
END-IF
IF #NEXT-TYPE = '.'
  END-OF-PORTION := TRUE
END-IF
*
FLUSH-SEGMENT := 'F'
FLUSH-LINES := PRINTOUT.PO-LAST-PRINTED-RECNO
*
REPEAT
  UNTIL END-OF-PORTION OR G-NATRP-ERC NE 0
*
  #TYPE         := #NEXT-TYPE
  #PARMS := #NEXT-PARMS
  RESET CP SSEP ESEP SCP
  INPUT (AD=MIT) #NEXT-TYPE TYPE NAME RNB CP
  IF #NEXT-TYPE = 'RP'
    INPUT (AD=MIT) SSEP ESEP SCP
  END-IF
  IF #NEXT-TYPE = '.' OR = 'EP'
    IF #NEXT-TYPE = '.'
      END-OF-PORTION := TRUE
    END-IF
    LAST-SEGMENT := TRUE
  END-IF
  DECIDE ON FIRST #TYPE
    VALUE 'EP' LAST-PORTION := TRUE
    VALUE 'BS' PERFORM PORTION-BUNDLE-SEPARATOR
    VALUE 'BV' PERFORM PRINT-BUNDLE-VTOC
    VALUE 'RP' PERFORM PORTION-ACTIVE-REPORT
    NONE IGNORE
  END-DECIDE
  IF FLUSH-SEGMENT NE 'L'
    FLUSH-SEGMENT := 'M'
  END-IF
END-REPEAT
*
END-SUBROUTINE /* PRINT-ACTIVE-BUNDLE-PORTION
*
************************************************************************
DEFINE SUBROUTINE PORTION-ACTIVE-REPORT
************************************************************************
BUNDLE-CONTENTS.BC-REPNAME   := #NAME
BUNDLE-CONTENTS.BC-REPRNB    := #RNB
BUNDLE-CONTENTS.BC-REPNO     := #CP
BUNDLE-CONTENTS.BC-SEP-START := #SSEP
BUNDLE-CONTENTS.BC-SEP-END   := #ESEP
BUNDLE-CONTENTS.BC-SEPNO     := #SCP
*
#PRINT-REPORT-SEP := TRUE
IF BUNDLE-CONTENTS.BC-SEPNO = 0
OR ((BUNDLE-CONTENTS.BC-SEP-START = 'NONE' OR = 'KEIN')               /*
AND (BUNDLE-CONTENTS.BC-SEP-END = 'NONE' OR = 'KEIN'))                /*
  RESET #PRINT-REPORT-SEP
END-IF
IF BUNDLE-CONTENTS.BC-REPNO = 0
  BUNDLE-CONTENTS.BC-REPNO := 1
END-IF
#AR-REPNAME := BUNDLE-CONTENTS.BC-REPNAME
#AR-REPRNB  := BUNDLE-CONTENTS.BC-REPRNB
PERFORM READ-ACTIVE-REPORT
IF G-NATRP-ERC NE 0
  RESET G-NATRP-ERC G-NATRP-ERT
  ESCAPE ROUTINE
END-IF
#RPCOPIES := BUNDLE-CONTENTS.BC-REPNO
RESET #RPCP
REPEAT
  UNTIL G-NATRP-ERC NE 0 OR #RPCP >= #RPCOPIES
  ADD 1 TO #RPCP
  PERFORM PRINT-ACTIVE-REPORT-PORTION
END-REPEAT
*
END-SUBROUTINE /* PORTION-ACTIVE-REPORT
*
************************************************************************
DEFINE SUBROUTINE PORTION-BUNDLE-SEPARATOR
************************************************************************
IF LAST-SEGMENT
  IF FLUSH-SEGMENT = 'F'
    FLUSH-SEGMENT := 'A'
  ELSE
    FLUSH-SEGMENT := 'L'
  END-IF
END-IF
IF +WKF-NUMBER NE 2 /* NOT RECFM=Fxx
  FLUSH-RECORD-LENGTH := 133
END-IF
IF #STYPE = 'START'
  RMSPFL-TYPE := BUNDLE-START-SEPARATOR
ELSE
  RMSPFL-TYPE := BUNDLE-END-SEPARATOR
END-IF
IF #PRINT-BUNDLE-SEP
  PERFORM PRINT-SEPARATOR
  IF G-NATRP-ERC = 1006 /* member not found
    RESET G-NATRP-ERC
    IF #STYPE = 'START'
      ACTIVE-BUNDLE.AB-SEP-START := 'NONE'
    ELSE
      ACTIVE-BUNDLE.AB-SEP-END   := 'NONE'
    END-IF
  END-IF
END-IF
*
END-SUBROUTINE /* PORTION-BUNDLE-SEPARATOR
*
************************************************************************
DEFINE SUBROUTINE PRINT-ACTIVE-REPORT-PORTION
************************************************************************
PERFORM ACTIVE-REPORT-INTERFACE
PERFORM SUBSTITUTION-VARIABLES-REPORT
IF +WKF-NUMBER NE 2 /* NOT RECFM=Fxx
  FLUSH-RECORD-LENGTH := ACTIVE-REPORT.AR-RECORD-LENGTH
END-IF
IF #PRINT-REPORT-SEP AND  NOT (BC-SEP-START = 'NONE' OR = 'KEIN')
  RMSPFL-TYPE := REPORT-START-SEPARATOR
  PERFORM PRINT-SEPARATOR
  IF G-NATRP-ERC = 1006 /* member not found
    RESET G-NATRP-ERC
    BC-SEP-START := 'NONE'
  END-IF
END-IF
FLUSH-CC-TYPE := ACTIVE-REPORT.AR-CC-TYPE
FLUSH-REPRNB  := ACTIVE-REPORT.AR-REPRNB
FLUSH-BUNDRNB := PRINTOUT.PO-BUNDRNB
FLUSH-TYPE-AL:= 'N'                  /* assume not type=al
IF (#SPOOL-TYPE = JES2 OR = JES3) AND #SPOOL-JES-DSTYPE = 'AL'
  FLUSH-TYPE-AL:= 'Y'                /* it is type=al
END-IF
IF +WKF-NUMBER NE 2                 /* NOT RECFM=Fxx P306371 +WKF-NUMBER
  FLUSH-RECORD-LENGTH := ACTIVE-REPORT.AR-RECORD-LENGTH
END-IF
IF G-NATRP-ERC NE 0
  ESCAPE ROUTINE
END-IF
IF #TRACING
  IF +G-NOMEXIT-ACTIVE (14)
    G-TRACE-MSG := 'Nomexit 14 is active.'
  ELSE
    G-TRACE-MSG := 'Nomexit 14 is not active.'
  END-IF
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
IF +G-NOMEXIT-ACTIVE (14)
  PERFORM CALL-NOMEX014
  IF G-NATRP-ERC NE 0
    ESCAPE ROUTINE
  END-IF
END-IF
IF LAST-SEGMENT AND ((BUNDLE-CONTENTS.BC-SEP-END = 'NONE' OR = 'KEIN')
OR NOT #PRINT-REPORT-SEP)                                             /*
  FLUSH-SEGMENT := 'L'
  IF FLUSH-PRINTER-TYPE = 'DISKUNIX' OR = 'NATUNIX'
    FLUSH-BRACKET := 'L'
  END-IF
END-IF
PERFORM CALL-IT
IF #PRINT-REPORT-SEP AND NOT (BC-SEP-END = 'NONE' OR = 'KEIN')
  IF LAST-SEGMENT
    FLUSH-SEGMENT := 'L'
  END-IF
  RMSPFL-TYPE := REPORT-END-SEPARATOR
  PERFORM PRINT-SEPARATOR
  IF G-NATRP-ERC = 1006 /* member not found
    RESET G-NATRP-ERC
    BC-SEP-END := 'NONE'
  END-IF
END-IF
G-SUBST-ENTRIES := #SUBST-ENTRIES-FIX
*
END-SUBROUTINE /* PRINT-ACTIVE-REPORT-PORTION
*
************************************************************************
DEFINE SUBROUTINE PRINT-ACTIVE-REPORT
************************************************************************
PERFORM ACTIVE-REPORT-INTERFACE
PERFORM SUBSTITUTION-VARIABLES-REPORT
IF +WKF-NUMBER NE 2                 /* NOT RECFM=Fxx P306371 +WKF-NUMBER
  FLUSH-RECORD-LENGTH := ACTIVE-REPORT.AR-RECORD-LENGTH
END-IF
*
IF NOT( BUNDLE-CONTENTS.BC-SEP-START = 'NONE' OR = 'KEIN')
AND #PRINT-REPORT-SEP                                                 /*
  RMSPFL-TYPE := REPORT-START-SEPARATOR
  PERFORM PRINT-SEPARATOR
  IF G-NATRP-ERC = 1006 /* member not found
    RESET G-NATRP-ERC
    BC-SEP-START := 'NONE'
  END-IF
END-IF
*
FLUSH-CC-TYPE := ACTIVE-REPORT.AR-CC-TYPE
FLUSH-REPRNB         := ACTIVE-REPORT.AR-REPRNB
FLUSH-BUNDRNB := PRINTOUT.PO-BUNDRNB
FLUSH-TYPE-AL:= 'N'                  /* assume not type=al
IF (#SPOOL-TYPE = JES2 OR = JES3) AND #SPOOL-JES-DSTYPE = 'AL'
  FLUSH-TYPE-AL:= 'Y'                /* it is type=al
END-IF
IF +WKF-NUMBER NE 2                 /* NOT RECFM=Fxx P306371 +WKF-NUMBER
  FLUSH-RECORD-LENGTH := ACTIVE-REPORT.AR-RECORD-LENGTH
END-IF
*
IF G-NATRP-ERC NE 0
  ESCAPE ROUTINE
END-IF
IF (NOT #PRINT-BUNDLE-SEP OR ACTIVE-BUNDLE.AB-SEP-END ='NONE' OR='KEIN')
AND #BUCP = #BUCOPIES       /* the last copy of the bundle            /*
AND #RPCP = #RPCOPIES       /* the last copy of the report            /*
AND FLUSH-LAST-REPORT = 'Y' /* the last report in bundle              /*
  FLUSH-SEGMENT := 'L'
  IF FLUSH-PRINTER-TYPE = 'DISKUNIX' OR = 'NATUNIX'
  AND (NOT #PRINT-REPORT-SEP                                          /*
  OR (ACTIVE-REPORT.AR-SEP-END = 'NONE' OR = 'KEIN'))                 /*
    FLUSH-BRACKET := 'L'
  END-IF
END-IF
IF #TRACING
  IF +G-NOMEXIT-ACTIVE (14)
    G-TRACE-MSG := 'Nomexit 14 is active.'
  ELSE
    G-TRACE-MSG := 'Nomexit 14 is not active.'
  END-IF
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
IF +G-NOMEXIT-ACTIVE (14)
  PERFORM CALL-NOMEX014
  IF G-NATRP-ERC NE 0
    ESCAPE ROUTINE
  END-IF
END-IF
/*PERFORM CALL-NOMEX015 /*???? SU why not here ?
PERFORM CALL-IT
*
IF (((NOT #PRINT-BUNDLE-SEP
OR (ACTIVE-BUNDLE.AB-SEP-END = 'NONE' OR = 'KEIN'))                   /*
AND #BUCP = #BUCOPIES)) /* last copy of bundle                        /*
AND #PRINT-REPORT-SEP                                                 /*
AND NOT (BUNDLE-CONTENTS.BC-SEP-END = 'NONE' OR = 'KEIN')             /*
AND #RPCP = #RPCOPIES                  /* the last copy of the report /*
AND FLUSH-LAST-REPORT = 'Y'            /* the last report in bundle   /*
  FLUSH-SEGMENT := 'L'
  IF FLUSH-PRINTER-TYPE = 'DISKUNIX' OR = 'NATUNIX'
    FLUSH-BRACKET := 'L'
  END-IF
END-IF
*
IF NOT( BUNDLE-CONTENTS.BC-SEP-END = 'NONE' OR = 'KEIN')
AND #PRINT-REPORT-SEP                                                 /*
  RMSPFL-TYPE := REPORT-END-SEPARATOR
  PERFORM PRINT-SEPARATOR
  IF G-NATRP-ERC = 1006 /* member not found
    RESET G-NATRP-ERC
    BC-SEP-END := 'NONE'
  END-IF
END-IF
*
G-SUBST-ENTRIES := #SUBST-ENTRIES-FIX
*
END-SUBROUTINE /* PRINT-ACTIVE-REPORT
*
************************************************************************
DEFINE SUBROUTINE ACTIVE-REPORT-INTERFACE
************************************************************************
RMARFL-REPNAME   := ACTIVE-REPORT.AR-REPNAME
RMARFL-REPRNB    := ACTIVE-REPORT.AR-REPRNB
RMARFL-LINE-FROM := 1
RMARFL-LINE-TO   := ACTIVE-REPORT.AR-NUMBER-OF-LINES
RESET RMARFL-LAYOUT-HEADER-LINES RMARFL-LAYOUT-ENTRIES
FLUSH-REPNAME:= ACTIVE-REPORT.AR-REPNAME
*
END-SUBROUTINE /* ACTIVE-REPORT-INTERFACE
*
************************************************************************
DEFINE SUBROUTINE FLUSH-INTERFACE
************************************************************************
RESET  FLUSH-COMMON-FIELDS
FLUSH-POID := #PO-ID
FLUSH-DESC := BUNDLE.B-DESC
*
CALLNAT 'RMFL---N' FLUSH-PARMS G-NATRP-ERC G-NATRP-ERT
*
IF +WKF-NUMBER = 2          /* RECFM=Fxx P306371 +WKF-NUMBER
  FLUSH-CC-TYPE := ACTIVE-REPORT.AR-CC-TYPE
  DECIDE FOR FIRST CONDITION
    WHEN FLUSH-CC-TYPE = BINARY
      FLUSH-RECORD-LENGTH:= 0
    WHEN FLUSH-RECORD-LENGTH = 0  /* NO LRECL ON PRINTOUT DEFINITION
        AND FLUSH-CC-TYPE NE BINARY
      FLUSH-RECORD-LENGTH:= 251
    WHEN NONE
      IGNORE
  END-DECIDE
END-IF
FLUSH-BRACKET := 'F'
#BUCOPIES     := FLUSH-COPIES
*
END-SUBROUTINE /* FLUSH-INTERFACE
*
************************************************************************
DEFINE SUBROUTINE INIT-FUNCTION
************************************************************************
IF G-TRACE < 2
  CALLNAT 'NOMGSTEP' '*' G-NATRP-ERC
ELSE
  CALLNAT 'NOMGSTEP' '*' G-NATRP-ERC G-TRACE
END-IF
CALLNAT 'SATLGFVN' SATLGV-PARMS
IF SATLGV-RC NE 0
  WRITE NOTITLE NOHDR *PROGRAM *TIMX(EM=YYYY'-'MM'-'DD' 'HH':'II)
    SATLGV-ERROR-TEXT
  IF SATLGV-LOG-DBID NE 0 OR SATLGV-LOG-FNR NE 0
    WRITE NOTITLE NOHDR *PROGRAM *TIMX(EM=YYYY'-'MM'-'DD' 'HH':'II)
      'Dbid:' SATLGV-LOG-DBID 'Fnr:' SATLGV-LOG-FNR
  END-IF
  IF *MACHINE-CLASS = 'MAINFRAME'
    IF #TASK-TYPE = 'SUBTASK'
      STOP
    END-IF
    TERMINATE 50
  END-IF
  ESCAPE MODULE
END-IF
RESET RACTLF-LOGGING
RACTLF-ERROR-LOGGING:= TRUE
RMTASK-P.FUNCTION       := 'L'
RMTASK-P.SUBTASK-NUMBER := 1
CALLNAT 'RMTASKID' RMTASK-P
RACTLF-LOG-USERID := RMTASK-P.TASK-ID
RACTLF-LOG-CODE := 'MO'
RACTLF-LFILE-1:= 91
RACTLF-LFILE-2:= 206
CALLNAT 'RACTLF-N' RACTLF-PARMS
IF RACTLF-ERROR-CODE NE 0
  WRITE NOTITLE NOHDR *PROGRAM *TIMX(EM=YYYY'-'MM'-'DD' 'HH':'II)
    RACTLF-ERROR-CODE RACTLF-ERROR-TEXT
  WRITE NOTITLE NOHDR *PROGRAM *TIMX(EM=YYYY'-'MM'-'DD' 'HH':'II)
    'Dbid1:' RACTLF-DBID-1 'Fnr1:' RACTLF-FNR-1
  WRITE NOTITLE NOHDR *PROGRAM *TIMX(EM=YYYY'-'MM'-'DD' 'HH':'II)
    'Dbid2:' RACTLF-DBID-2 'Fnr2:' RACTLF-FNR-2
  IF *MACHINE-CLASS = 'MAINFRAME'
    IF #TASK-TYPE = 'SUBTASK'
      STOP
    END-IF
    TERMINATE 50
  END-IF
  ESCAPE MODULE
END-IF
#AUTODEF := F#MONITOR-USER-AUTODEF (<>)
DECIDE FOR EVERY CONDITION
  WHEN G-NATRP-ERC = 0
    PERFORM READ-PRINTOUT-RECORD
    PERFORM CHECK-BINARY
  WHEN G-NATRP-ERC = 0
    PERFORM READ-TRACE
  WHEN G-NATRP-ERC = 0 AND PRINTOUT.PO-NODE NE 0
    CALLNAT 'N-ESYLG' 1X PRINTOUT.PO-NODE #ESY-USER #CALLER
      G-NATRP-ERC G-NATRP-ERT 1X
    IF G-NATRP-ERC NE 0
      G-NATRP-ERC := 0005
    ELSE
      LOGOFF-FROM-ESY := TRUE
    END-IF
  WHEN G-NATRP-ERC = 0
    PERFORM READ-ACTIVE-BUNDLE
  WHEN G-NATRP-ERC = 0
    PERFORM READ-BUNDLE
  WHEN G-NATRP-ERC = 0
    PERFORM READ-USER
  WHEN G-NATRP-ERC = 0
    PERFORM READ-COORDINATOR
  WHEN G-NATRP-ERC = 0
    PERFORM SUBSTITUTION-VARIABLES-BUNDLE
  WHEN G-NATRP-ERC = 0
    PERFORM FLUSH-INTERFACE
  WHEN NONE
    IGNORE
END-DECIDE
IF PRINTOUT.PO-USERID = ACTIVE-BUNDLE.AB-COORDINATOR-ID
  #USER-TYPE := 'A'
ELSE
  #USER-TYPE := USER.PROF-TYPE
END-IF
*
END-SUBROUTINE /* INIT-FUNCTION
*
************************************************************************
DEFINE SUBROUTINE READ-PRINTOUT-RECORD
************************************************************************
FNDPR. FIND PRINTOUT WITH PO-ID = #PO-ID
  IF NO RECORDS FOUND
    G-NATRP-ERC := 0005
    G-NATRP-ERT := 'Printout Record not found'
    ESCAPE BOTTOM (FNDPR.)
  END-NOREC
  RESET #SKIP-PAGES
  EXAMINE PRINTOUT.PO-JOBCARD (*) FOR 'SKIP' GIVING INDEX #IND
  IF #IND = 0
    EXAMINE PRINTOUT.PO-JOBCARD (*) FOR 'skip' GIVING INDEX #IND
  END-IF
  IF #IND > 0
    #PO-JOBCARD := PRINTOUT.PO-JOBCARD (#IND)
    EXAMINE #PO-JOBCARD FOR 'SKIP' GIVING POSITION #POS LENGTH #LEN
    IF #POS = 0
      EXAMINE #PO-JOBCARD FOR 'skip' GIVING POSITION #POS LENGTH #LEN
    END-IF
    ADD 4 TO #POS /* start position for number
    RESET #DIGIT
    FORPOS. FOR #J = #POS TO #LEN
      IF SUBSTR(#PO-JOBCARD,#J,1) = ' ' OR = MASK(N)
        #DIGIT := TRUE
        ESCAPE TOP
      END-IF
      ESCAPE BOTTOM (FORPOS.)
    END-FOR
    IF #DIGIT = TRUE
      #K := #J - #POS /* number of digits and blanks
      #PO-JOBCARD := SUBSTR(#PO-JOBCARD,#POS,#K)
      MOVE LEFT #PO-JOBCARD TO #PO-JOBCARD
      #SKIP-PAGES := VAL(#PO-JOBCARD)
    END-IF
  END-IF
  IF PRINTOUT.PO-EXITMEM NE ' ' AND PRINTOUT.PO-EXITLIB NE ' '
    PERFORM ADD-STEPLIB
    IF G-NATRP-ERC = 0
      CALLNAT 'N-CHKCAT' G-NATRP-ERC G-NATRP-ERT /*SU6
        PRINTOUT.PO-EXITMEM PRINTOUT.PO-EXITLIB #CALLER
        #CAT-DATE-1 #CAT-DATE-2
      IF G-NATRP-ERC NE 0
        COMPRESS PRINTOUT.PO-BUNDLE '/' PRINTOUT.PO-BUNDRNB
          TO #MEMBER LEAVING NO
        COMPRESS PRINTOUT.PO-EXITLIB '(' PRINTOUT.PO-EXITMEM ')'
          TO LG-MSG LEAVING NO
        COMPRESS '1587' #MEMBER LG-MSG PRINTOUT.PO-LOGICAL  TO LG-MSG
        RMTASK-P.FUNCTION       := 'L'
        RMTASK-P.SUBTASK-NUMBER := 1
        CALLNAT 'RMTASKID' RMTASK-P
        LG-USERID := RMTASK-P.TASK-ID
        LG-CODE := 'MO'
        CALLNAT 'RLOG' PL-PARMS
        IF #TRACING
          COMPRESS PRINTOUT.PO-EXITLIB '(' PRINTOUT.PO-EXITMEM ')'
            TO G-TRACE-MSG LEAVING NO
          COMPRESS 'Unable to find exitmem' G-TRACE-MSG
            TO G-TRACE-MSG
          PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
        END-IF
      END-IF
    END-IF
  END-IF
END-FIND
*
END-SUBROUTINE /* READ-PRINTOUT-RECORD
*
************************************************************************
DEFINE SUBROUTINE READ-ACTIVE-REPORT
************************************************************************
FNDAR. FIND ACTIVE-REPORT WITH AR-REPORT-RNB = #AR-REPORT-RNB
  IF NO RECORDS FOUND
    G-NATRP-ERC := 0005
    G-NATRP-ERT := 'Active Report not found'
    ESCAPE BOTTOM (FNDAR.)
  END-NOREC
  IF ACTIVE-REPORT.AR-CURRENT-LOCATION = 'A'
    G-NATRP-ERC := 0005
    G-NATRP-ERT := 'Active Report on Archive'
    ESCAPE BOTTOM (FNDAR.)
  END-IF
*
  #SPOOL-ATTRIBUTES := ACTIVE-REPORT.AR-SPOOL-ATTRIBUTES
  CALLNAT 'RMSPL7-N' #SPOOL-ATTRIBUTES #SPOOL-TYPE
  IF ACTIVE-REPORT.AR-DESC = ' '
    FNDRP. FIND REPORT WITH R-REPNAME = ACTIVE-REPORT.AR-REPNAME
      ACTIVE-REPORT.AR-DESC := REPORT.R-DESC
    END-FIND
  END-IF
END-FIND
*
END-SUBROUTINE /* READ-ACTIVE-REPORT
*
************************************************************************
DEFINE SUBROUTINE PRINT-BUNDLE-VTOC
************************************************************************
IF LAST-SEGMENT AND #BUCP = #BUCOPIES
  IF FLUSH-SEGMENT = 'F'
    FLUSH-SEGMENT := 'A'
  ELSE
    FLUSH-SEGMENT := 'L'
  END-IF
END-IF
*
RMBVFL-BUNDLE      := PRINTOUT.PO-BUNDLE
RMBVFL-BUNDRNB     := PRINTOUT.PO-BUNDRNB
RMBVFL-USER-ID     := PRINTOUT.PO-USERID
RMBVFL-LANGUAGE    := PRINTOUT.PO-LANGUAGE
RMBVFL-DATE-FORMAT := G-DATE-FORMAT
RMBVFL-USER-TYPE   := USER.PROF-TYPE
*
CALLNAT 'RMBVFL-N' RMBVFL-PARMS FLUSH-PARMS G-LINE-PARMS
  G-NATRP-ERC G-NATRP-ERT
*
FLUSH-SEGMENT := 'M'             /* always follows printing of reports
*
END-SUBROUTINE /* PRINT-BUNDLE-VTOC
*
************************************************************************
DEFINE SUBROUTINE PRINT-SEPARATOR
************************************************************************
DECIDE ON FIRST RMSPFL-TYPE
  VALUE REPORT-START-SEPARATOR
    RMSPFL-MEMBER := BUNDLE-CONTENTS.BC-SEP-START
    IF #FLAG-REPSEP = 'N'
      RESET RMSPFL-COPIES
    ELSE
      RMSPFL-COPIES := BUNDLE-CONTENTS.BC-SEPNO
    END-IF
    IF FLUSH-RC = 97
      RESET FLUSH-RC FLUSH-WORK-PRINTER-EXIT
    END-IF
  VALUE REPORT-END-SEPARATOR
    RMSPFL-MEMBER := BUNDLE-CONTENTS.BC-SEP-END
    IF #FLAG-REPSEP = 'N'
      RESET RMSPFL-COPIES
    ELSE
      RMSPFL-COPIES := BUNDLE-CONTENTS.BC-SEPNO
    END-IF
  VALUE BUNDLE-START-SEPARATOR
    RMSPFL-COPIES := ACTIVE-BUNDLE.AB-SEPNO
    RMSPFL-MEMBER := ACTIVE-BUNDLE.AB-SEP-START
    PERFORM EXTRA-BUNDLE-VARIABLES
  VALUE BUNDLE-END-SEPARATOR
    IF FLUSH-RC = 97
      RESET FLUSH-RC FLUSH-WORK-PRINTER-EXIT
    END-IF
    RMSPFL-COPIES := ACTIVE-BUNDLE.AB-SEPNO
    RMSPFL-MEMBER := ACTIVE-BUNDLE.AB-SEP-END
    PERFORM EXTRA-BUNDLE-VARIABLES
  NONE VALUE
    IGNORE
END-DECIDE
*
IF +WKF-NUMBER NE 2                 /* NOT RECFM=Fxx P306371 +WKF-NUMBER
  RMSPFL-RECORD-LENGTH := ACTIVE-REPORT.AR-RECORD-LENGTH
ELSE
  RMSPFL-RECORD-LENGTH := FLUSH-RECORD-LENGTH
END-IF
RMSPFL-LANGUAGE := PRINTOUT.PO-LANGUAGE
*
IF NOT(RMSPFL-MEMBER ='NONE' OR='KEIN') AND (FLUSH-CC-TYPE NE BINARY
OR FLUSH-PRINTER-TYPE = 'DISKUNIX')                                   /*
  /* Flush Lines of an Separator Member
  CALLNAT 'RMSPFL-N' RMSPFL-PARMS G-SUBST-PARMS FLUSH-PARMS
    G-LINE-PARMS G-NATRP-ERC G-NATRP-ERT
  IF G-NATRP-ERC NE 1006 /* sep page not found, treated like NONE.
  AND FLUSH-SEGMENT NE 'L'                                            /*
    FLUSH-SEGMENT := 'M'
  END-IF
END-IF
IF RMSPFL-TYPE = BUNDLE-START-SEPARATOR OR = BUNDLE-END-SEPARATOR
  G-SUBST-ENTRIES:= #SUBST-ENTRIES-FIX
END-IF
*
END-SUBROUTINE /* PRINT-SEPARATOR
*
************************************************************************
DEFINE SUBROUTINE READ-TRACE
************************************************************************
FIND PRINTERS WITH P-ID = PRINTOUT.PO-LOGICAL
  EXAMINE P-ATTRIBUTES (*) FOR 'TRACE' GIVING POSITION #POS INDEX #IND
  IF #IND = 0
    ESCAPE TOP
  END-IF
  ADD 5 TO #POS
  #P-ATTRIBUTES := SUBSTR (P-ATTRIBUTES (#IND),#POS)
  SEPARATE #P-ATTRIBUTES LEFT JUSTIFIED INTO #G-TRACE IGNORE
  RESET G-TRACE
  IF SUBSTR(#G-TRACE,1,1) = 'Y' OR = '1' OR = '2' OR = '3'
    G-TRACE := 100
  END-IF
END-FIND
*
END-SUBROUTINE /* READ-TRACE
*
************************************************************************
DEFINE SUBROUTINE READ-USER
************************************************************************
FNDUS. FIND USER WITH USER-ID = PRINTOUT.PO-USERID
  IF NO RECORDS FOUND
    IF NOT(#AUTODEF ='Y' OR='P')
      G-NATRP-ERC := 0005
      G-NATRP-ERT := 'User not found'
      ESCAPE BOTTOM (FNDUS.)
    END-IF
    FIND USER WITH USER-ID = 'DEFAULT'
    END-FIND
  END-NOREC
END-FIND
*
END-SUBROUTINE /* READ-USER
*
************************************************************************
DEFINE SUBROUTINE READ-COORDINATOR
************************************************************************
FNDCO. FIND COORDINATOR WITH USER-ID = ACTIVE-BUNDLE.AB-COORDINATOR-ID
  IF NO RECORDS FOUND
    IF NOT(#AUTODEF ='Y' OR='P')
      G-NATRP-ERC := 0005
      G-NATRP-ERT := 'Coordinator not found'
      ESCAPE BOTTOM (FNDCO.)
    ELSE
      FIND USER WITH USER-ID = 'DEFAULT'
      END-FIND
    END-IF
  END-NOREC
END-FIND
*
END-SUBROUTINE /* READ-COORDINATOR
*
************************************************************************
DEFINE SUBROUTINE READ-ACTIVE-BUNDLE
************************************************************************
#AB-BUNDLE        := PRINTOUT.PO-BUNDLE
#AB-BUNDRNB       := PRINTOUT.PO-BUNDRNB
#PRINT-BUNDLE-SEP := TRUE
*
FNDAB. FIND ACTIVE-BUNDLE WITH AB-BUNDLE-RNB = #AB-BUNDLE-RNB
  IF NO RECORDS FOUND
    G-NATRP-ERC := 0005
    G-NATRP-ERT := 'Coordinator not found'
    ESCAPE BOTTOM (FNDAB.)
  END-NOREC
  #OPENT := AB-OPEN-TIME
  #OPENP := #OPENT
  #OPENP := - (#OPENP - #MAX-INV-TIME)
  #OPENT := #OPENP
  IF AB-SEPNO = 0 OR ((AB-SEP-START = 'NONE' OR = 'KEIN')
  AND (AB-SEP-END = 'NONE' OR = 'KEIN'))                              /*
    RESET #PRINT-BUNDLE-SEP
  END-IF
*
END-FIND
*
END-SUBROUTINE /* READ-ACTIVE-BUNDLE
*
************************************************************************
DEFINE SUBROUTINE READ-BUNDLE
************************************************************************
FIND BUNDLE WITH B-BUNDLE = PRINTOUT.PO-BUNDLE
  IF NO RECORDS FOUND
    MOVE ALL '?' TO B-DESC
  END-NOREC
  FLUSH-DESC := B-DESC
  #FLAG-REPSEP := B-FLAG-REPSEP
END-FIND
*
END-SUBROUTINE /* READ-BUNDLE
*
************************************************************************
DEFINE SUBROUTINE SUBSTITUTION-VARIABLES-REPORT
************************************************************************
ADD 1 TO G-SUBST-ENTRIES
G-SUBST-VAR  (G-SUBST-ENTRIES) := '§REPORT'
G-SUBST-TEXT (G-SUBST-ENTRIES) := ACTIVE-REPORT.AR-REPNAME
*
ADD 1 TO G-SUBST-ENTRIES
G-SUBST-VAR  (G-SUBST-ENTRIES) := '§CDATE'
MOVE EDITED ACTIVE-REPORT.AR-PROCESS-TIME (EM=YYYYMMDD) TO #DATE
CALLNAT 'IODATE-N' 'M' 'S' #DATE #FORMATED-DATE G-DATE-FORMAT
  #ERROR-CODE #ERROR-TEXT
IF #ERROR-CODE = 0
  #DATE := #S-FORMATED-DATE
END-IF
G-SUBST-TEXT (G-SUBST-ENTRIES) := #DATE
ADD 1 TO G-SUBST-ENTRIES
G-SUBST-VAR         (G-SUBST-ENTRIES) := '§CTIME'
MOVE EDITED ACTIVE-REPORT.AR-PROCESS-TIME (EM=HH':'II) TO #DATE
G-SUBST-TEXT (G-SUBST-ENTRIES) := #DATE
ADD 1 TO G-SUBST-ENTRIES
G-SUBST-VAR         (G-SUBST-ENTRIES) := '§DESCR'
G-SUBST-TEXT (G-SUBST-ENTRIES) := ACTIVE-REPORT.AR-DESC
DECIDE ON FIRST #SPOOL-TYPE
  VALUE JES2, JES3
    ADD 1 TO G-SUBST-ENTRIES
    G-SUBST-VAR  (G-SUBST-ENTRIES) := '§JOBNAME'
    G-SUBST-TEXT (G-SUBST-ENTRIES) := #SPOOL-JES-JOB-NAME
    ADD 1 TO G-SUBST-ENTRIES
    G-SUBST-VAR  (G-SUBST-ENTRIES) := '§JOBNO'
    G-SUBST-TEXT (G-SUBST-ENTRIES) := #SPOOL-JES-JOB-NUMBER
/*SU8  VALUE POWER
  VALUE SEQUENTIAL-FILE-BS2
    ADD 1 TO G-SUBST-ENTRIES
    G-SUBST-VAR  (G-SUBST-ENTRIES) := '§JOBNAME'
    G-SUBST-TEXT (G-SUBST-ENTRIES) := #SPOOL-BS2-JOB-NAME
    ADD 1 TO G-SUBST-ENTRIES
    G-SUBST-VAR  (G-SUBST-ENTRIES) := '§JOBNO'
    G-SUBST-TEXT (G-SUBST-ENTRIES) := #SPOOL-BS2-JOB-ID
  NONE VALUE
    ADD 1 TO G-SUBST-ENTRIES
    G-SUBST-VAR        (G-SUBST-ENTRIES) := '§JOBNAME'
    RESET G-SUBST-TEXT (G-SUBST-ENTRIES)
    ADD 1 TO G-SUBST-ENTRIES
    G-SUBST-VAR        (G-SUBST-ENTRIES) := '§JOBNO'
    RESET G-SUBST-TEXT (G-SUBST-ENTRIES)
END-DECIDE
*
END-SUBROUTINE /* SUBSTITUTION-VARIABLES-REPORT
*
************************************************************************
DEFINE SUBROUTINE SUBSTITUTION-VARIABLES-BUNDLE
************************************************************************
RESET G-SUBST-ENTRIES
ADD 1 TO G-SUBST-ENTRIES
G-SUBST-VAR (G-SUBST-ENTRIES) := '§DATE'
MOVE EDITED *DATX (EM=YYYYMMDD) TO #DATE
CALLNAT 'IODATE-N' 'M' 'S' #DATE #FORMATED-DATE G-DATE-FORMAT
  #ERROR-CODE #ERROR-TEXT
IF #ERROR-CODE = 0
  #DATE := #S-FORMATED-DATE
END-IF
G-SUBST-TEXT (G-SUBST-ENTRIES) := #DATE
*
ADD 1 TO G-SUBST-ENTRIES
G-SUBST-VAR  (G-SUBST-ENTRIES) := '§TIME'
MOVE EDITED *TIMX (EM=HH':'II)  TO #DATE
G-SUBST-TEXT (G-SUBST-ENTRIES) := #DATE
*
ADD 1 TO G-SUBST-ENTRIES
G-SUBST-VAR  (G-SUBST-ENTRIES) := '§COORDINATOR'
G-SUBST-TEXT (G-SUBST-ENTRIES) := COORDINATOR.USER-ID
*
ADD 1 TO G-SUBST-ENTRIES
G-SUBST-VAR  (G-SUBST-ENTRIES) := '§COORD-NAME'
COMPRESS COORDINATOR.LAST-NAME ',' COORDINATOR.FIRST-NAME
  TO G-SUBST-TEXT (G-SUBST-ENTRIES) LEAVING NO
*
ADD 1 TO G-SUBST-ENTRIES
G-SUBST-VAR  (G-SUBST-ENTRIES) := '§COORD-DEPTNO'
G-SUBST-TEXT (G-SUBST-ENTRIES) := COORDINATOR.WORK-DEPT-NUM
*
ADD 1 TO G-SUBST-ENTRIES
G-SUBST-VAR  (G-SUBST-ENTRIES) := '§COORD-DEPTNAME'
G-SUBST-TEXT (G-SUBST-ENTRIES) := COORDINATOR.WORK-DEPT-NAME
*
ADD 1 TO G-SUBST-ENTRIES
G-SUBST-VAR (G-SUBST-ENTRIES) := '§COORD-PHONE'
IF COORDINATOR.WORK-PHONE = ' '
  G-SUBST-TEXT (G-SUBST-ENTRIES) := COORDINATOR.WORK-PHONE-EXT
ELSE
  COMPRESS COORDINATOR.WORK-PHONE '/' COORDINATOR.WORK-PHONE-EXT
    TO G-SUBST-TEXT (G-SUBST-ENTRIES) LEAVING NO
END-IF
*
ADD 1 TO G-SUBST-ENTRIES
G-SUBST-VAR  (G-SUBST-ENTRIES) := '§COORD-LOCATION'
G-SUBST-TEXT (G-SUBST-ENTRIES) := COORDINATOR.WORK-LOCATION
*
ADD 1 TO G-SUBST-ENTRIES
G-SUBST-VAR  (G-SUBST-ENTRIES) := '§COORD-ORGANIZATION'
G-SUBST-TEXT (G-SUBST-ENTRIES) := COORDINATOR.WORK-ORGANIZATION
*
ADD 1 TO G-SUBST-ENTRIES
G-SUBST-VAR  (G-SUBST-ENTRIES) := '§COORD-ADDRESS1'
G-SUBST-TEXT (G-SUBST-ENTRIES) := COORDINATOR.WORK-ADDRESS (01)
*
ADD 1 TO G-SUBST-ENTRIES
G-SUBST-VAR  (G-SUBST-ENTRIES) := '§COORD-ADDRESS2'
G-SUBST-TEXT (G-SUBST-ENTRIES) := COORDINATOR.WORK-ADDRESS (02)
*
ADD 1 TO G-SUBST-ENTRIES
G-SUBST-VAR  (G-SUBST-ENTRIES) := '§COORD-ADDRESS3'
G-SUBST-TEXT (G-SUBST-ENTRIES) := COORDINATOR.WORK-ADDRESS (03)
*
ADD 1 TO G-SUBST-ENTRIES
G-SUBST-VAR  (G-SUBST-ENTRIES) := '§USER'
G-SUBST-TEXT (G-SUBST-ENTRIES) := USER.USER-ID
*
ADD 1 TO G-SUBST-ENTRIES
G-SUBST-VAR  (G-SUBST-ENTRIES) := '§NAME'
COMPRESS USER.LAST-NAME ',' USER.FIRST-NAME
  TO G-SUBST-TEXT (G-SUBST-ENTRIES) LEAVING NO
*
ADD 1 TO G-SUBST-ENTRIES
G-SUBST-VAR  (G-SUBST-ENTRIES) := '§DEPTNO'
G-SUBST-TEXT (G-SUBST-ENTRIES) := USER.WORK-DEPT-NUM
*
ADD 1 TO G-SUBST-ENTRIES
G-SUBST-VAR  (G-SUBST-ENTRIES) := '§DEPTNAME'
G-SUBST-TEXT (G-SUBST-ENTRIES) := USER.WORK-DEPT-NAME
*
ADD 1 TO G-SUBST-ENTRIES
G-SUBST-VAR  (G-SUBST-ENTRIES) := '§LOCATION'
G-SUBST-TEXT (G-SUBST-ENTRIES) := USER.WORK-LOCATION
*
ADD 1 TO G-SUBST-ENTRIES
G-SUBST-VAR  (G-SUBST-ENTRIES) := '§ORGANIZATION'
G-SUBST-TEXT (G-SUBST-ENTRIES) := USER.WORK-ORGANIZATION
*
ADD 1 TO G-SUBST-ENTRIES
G-SUBST-VAR  (G-SUBST-ENTRIES) := '§PHONE'
IF USER.WORK-PHONE = ' '
  G-SUBST-TEXT (G-SUBST-ENTRIES) := USER.WORK-PHONE-EXT
ELSE
  COMPRESS USER.WORK-PHONE '/' USER.WORK-PHONE-EXT
    TO G-SUBST-TEXT (G-SUBST-ENTRIES) LEAVING NO
END-IF
*
ADD 1 TO G-SUBST-ENTRIES
G-SUBST-VAR  (G-SUBST-ENTRIES) := '§ADDRESS1'
G-SUBST-TEXT (G-SUBST-ENTRIES) := USER.WORK-ADDRESS (01)
*
ADD 1 TO G-SUBST-ENTRIES
G-SUBST-VAR  (G-SUBST-ENTRIES) := '§ADDRESS2'
G-SUBST-TEXT (G-SUBST-ENTRIES) := USER.WORK-ADDRESS (02)
*
ADD 1 TO G-SUBST-ENTRIES
G-SUBST-VAR  (G-SUBST-ENTRIES) := '§ADDRESS3'
G-SUBST-TEXT (G-SUBST-ENTRIES) := USER.WORK-ADDRESS (03)
*
ADD 1 TO G-SUBST-ENTRIES
G-SUBST-VAR  (G-SUBST-ENTRIES) := '§BUNDLE'
G-SUBST-TEXT (G-SUBST-ENTRIES) := ACTIVE-BUNDLE.AB-BUNDLE
*
ADD 1 TO G-SUBST-ENTRIES
G-SUBST-VAR  (G-SUBST-ENTRIES) := '§EXIT'
G-SUBST-TEXT (G-SUBST-ENTRIES) := PRINTOUT.PO-EXITMEM
*
#SUBST-ENTRIES-FIX := G-SUBST-ENTRIES
*
END-SUBROUTINE /* SUBSTITUTION-VARIABLES-BUNDLE
*
************************************************************************
DEFINE SUBROUTINE EXTRA-BUNDLE-VARIABLES
************************************************************************
ADD 1 TO G-SUBST-ENTRIES
G-SUBST-VAR  (G-SUBST-ENTRIES):= '§DESCR'
G-SUBST-TEXT (G-SUBST-ENTRIES):= FLUSH-DESC
IF #OPENT NE T'00:00:00'
  ADD 1 TO G-SUBST-ENTRIES
  G-SUBST-VAR(G-SUBST-ENTRIES):= '§CDATE'
  MOVE EDITED #OPENT (EM=YYYYMMDD) TO #DATE
  CALLNAT 'IODATE-N' 'M' 'S' #DATE #FORMATED-DATE G-DATE-FORMAT
    #ERROR-CODE #ERROR-TEXT
  IF #ERROR-CODE = 0
    #DATE := #S-FORMATED-DATE
  END-IF
  G-SUBST-TEXT(G-SUBST-ENTRIES):= #DATE
*
  ADD 1 TO G-SUBST-ENTRIES
  G-SUBST-VAR(G-SUBST-ENTRIES):= '§CTIME'
  MOVE EDITED #OPENT (EM=HH':'II) TO #DATE
  G-SUBST-TEXT(G-SUBST-ENTRIES):= #DATE
END-IF
*
END-SUBROUTINE /* EXTRA-BUNDLE-VARIABLES
*
************************************************************************
DEFINE SUBROUTINE UPDATE-PRINTOUT-RECORD
************************************************************************
IF NOT LAST-PORTION AND G-NATRP-ERC = 0
  ESCAPE ROUTINE
END-IF
FNDPO. FIND PO-UPD WITH PO-ID = #PO-ID
  IF PO-MSG = '8861' /* RMPRTJOB did not find jobvariable in BS2
    RESET G-NATRP-ERC G-NATRP-ERT PO-MSG
    #FOLLOW-PRINTOUT := 'N'
  END-IF
  IF #FOLLOW-PRINTOUT = 'Y' AND G-NATRP-ERC = 0
    ESCAPE ROUTINE
  END-IF
  LG-BUNDLE  := PO-UPD.PO-BUNDLE
  LG-BUNDRNB := PO-UPD.PO-BUNDRNB
  LG-PRINTER := PO-UPD.PO-LOGICAL
  COMPRESS PO-UPD.PO-BUNDLE '/' PO-UPD.PO-BUNDRNB
    TO LG-MSG LEAVING NO
  LG-OBJECT-NAME := LG-MSG
  IF G-NATRP-ERC = 0
    PO-UPD.PO-STATUS := 'D'
    FOR-JOBC. FOR #I = 1 TO 3
      #PO-JOBCARD := PO-UPD.PO-JOBCARD (#I)
      EXAMINE #PO-JOBCARD TRANSLATE INTO UPPER
      IF #PO-JOBCARD = SCAN ('EXTERNAL-OK')  /* confirm manually
        PO-UPD.PO-STATUS := 'X'
        ESCAPE BOTTOM (FOR-JOBC.)
      END-IF
    END-FOR
    IF PO-UPD.PO-STATUS NE 'X'
      PO-PRINTED := *TIMX
      RESET  PO-MSG
    END-IF
    COMPRESS '7212' LG-MSG TO LG-MSG
  ELSE
    PO-UPD.PO-STATUS := 'E'
    IF G-NATRP-ERC = 5
      COMPRESS 'Log:' *TIME G-NATRP-ERT TO PO-MSG
      PERFORM XXRLOG-WRITE-LOG 'W' G-NATRP-ERT
    ELSE
      #RC := G-NATRP-ERC
      COMPRESS #RC-A G-NATRP-ERT TO PO-MSG
    END-IF
    COMPRESS '7214' LG-MSG TO LG-MSG
  END-IF
  LG-CODE := 'PR'
  COMPRESS LG-MSG PO-UPD.PO-LOGICAL TO LG-MSG
  RMTASK-P.FUNCTION       := 'L'
  RMTASK-P.SUBTASK-NUMBER := 1
  CALLNAT 'RMTASKID' RMTASK-P
  LG-USERID := RMTASK-P.TASK-ID
  CALLNAT 'RLOG' PL-PARMS
  UPDATE (FNDPO.)
  END OF TRANSACTION
END-FIND
*
END-SUBROUTINE /* UPDATE-PRINTOUT-RECORD
*
************************************************************************
DEFINE SUBROUTINE CALL-STATISTIC-EXIT
************************************************************************
INCLUDE NOMEXC06
*
END-SUBROUTINE /* CALL-STATISTIC-EXIT
*
************************************************************************
DEFINE SUBROUTINE ADD-STEPLIB
************************************************************************
** check existence of po-exitlib in steplib table
CALLNAT 'RLIBACT' PRINTOUT.PO-EXITLIB #STEPLIB-EXIST
IF NOT #STEPLIB-EXIST
  NAT00009-LIBRARY := PRINTOUT.PO-EXITLIB
  RESET  NAT00009-FNR NAT00009-DBID
  CALLNAT 'RGETLIB' NAT00009-APPLIC
  NAT00009-FUNCTION := 08
  CALLNAT 'NAT00009' NAT00009-PARMS
  IF NAT00009-RESPONSE NE 0
    G-NATRP-ERC := 1078
    RMTASK-P.FUNCTION       := 'L'
    RMTASK-P.SUBTASK-NUMBER := 1
    CALLNAT 'RMTASKID' RMTASK-P
    LG-USERID := RMTASK-P.TASK-ID
    LG-CODE   := 'MO'
    COMPRESS  '1078'  PRINTOUT.PO-EXITLIB TO LG-MSG
    CALLNAT 'RLOG' PL-PARMS
    END TRANSACTION
    IF #TRACING
      COMPRESS 'Unable to add steplib' PRINTOUT.PO-EXITLIB
        TO G-TRACE-MSG
      PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
    END-IF
  ELSE
    STEPLIB-ADDED := TRUE
  END-IF
END-IF
*
END-SUBROUTINE /* ADD-STEPLIB
*
************************************************************************
DEFINE SUBROUTINE REMOVE-STEPLIB
************************************************************************
IF NOT STEPLIB-ADDED
  ESCAPE ROUTINE
END-IF
*
** check existence of po-exitlib in steplib table
CALLNAT 'RLIBACT' PRINTOUT.PO-EXITLIB #STEPLIB-EXIST
IF #STEPLIB-EXIST
  NAT00009-FUNCTION := 16
  CALLNAT 'NAT00009' NAT00009-PARMS
END-IF
STEPLIB-ADDED := FALSE
*
END-SUBROUTINE /* REMOVE-STEPLIB
*
************************************************************************
DEFINE SUBROUTINE ERROR-HANDLING
************************************************************************
BACKOUT TRANSACTION
COMPRESS PRINTOUT.PO-BUNDLE '/' PRINTOUT.PO-BUNDRNB /*SU8 ->
  TO #ERROR-TEXT LEAVING NO
PRINT NOTITLE NOHDR *PROGRAM 10T *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
  'Print Bundle abnormal termination:' #ERROR-TEXT
COMPRESS 'AR:' #AR-REPNAME '/' #AR-REPRNB TO #ERROR-TEXT LEAVING NO
PRINT NOTITLE NOHDR *PROGRAM 10T *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
  #ERROR-TEXT /*SU8 <-
IF *ERROR-NR NE 0
  WRITE NOTITLE NOHDR *PROGRAM *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
    'Error' *ERROR-NR 'Line' *ERROR-LINE 'Program' *PROGRAM
  G-NATRP-ERC := 21
  COMPRESS *ERROR-NR '/' *PROGRAM '/' *ERROR-LINE
    TO G-NATRP-ERT LEAVING NO
ELSE
  PRINT NOTITLE NOHDR *PROGRAM 10T *TIMX (EM=YYYY'-'MM'-'DD' 'HH':'II)
    G-NATRP-ERT
END-IF
IF #PO-ID NE 0 AND NOT *ERROR-NR = 3000 THRU 3999
  PERFORM UPDATE-PRINTOUT-RECORD
END-IF
IF *MACHINE-CLASS = 'MAINFRAME'
  IF #TASK-TYPE = 'SUBTASK'
    STOP
  END-IF
  TERMINATE 50
END-IF
ESCAPE MODULE
*
END-SUBROUTINE /* ERROR-HANDLING
*
************************************************************************
DEFINE SUBROUTINE CHECK-BINARY
************************************************************************
#BC-BUNDLE-RNB-GROUP-SEQNO.#BC-BUNDLE  := PRINTOUT.PO-BUNDLE
#BC-BUNDLE-RNB-GROUP-SEQNO.#BC-BUNDRNB := PRINTOUT.PO-BUNDRNB
RESET  #BC-BUNDLE-RNB-GROUP-SEQNO.#BC-GROUP
RESET  #BC-BUNDLE-RNB-GROUP-SEQNO.#BC-SEQNO
READ (1) BUNDLE-CONTENTS BY BC-BUNDLE-RNB-GROUP-SEQNO
    STARTING FROM #BC-BUNDLE-RNB-GROUP-SEQNO
END-READ
#AR-REPNAME := BUNDLE-CONTENTS.BC-REPNAME
#AR-REPRNB  := BUNDLE-CONTENTS.BC-REPRNB
PERFORM READ-ACTIVE-REPORT
IF ACTIVE-REPORT.AR-CC-TYPE = BINARY
AND PRINTOUT.PO-PRINTER-TYPE NE 'DISKUNIX'                            /*
  FETCH 'RMPRBUB' /* use different module for binary processing
    #PO-ID #ESY-USER #FOLLOW-PRINTOUT #NOMEXIT-6 #OPTION #TASK-TYPE
END-IF
*
END-SUBROUTINE /* CHECK-BINARY
*
************************************************************************
DEFINE SUBROUTINE CALL-NOMEX014
************************************************************************
IF G-NATRP-ERC NE 0
  IF #TRACING
    COMPRESS 'RC' G-NATRP-ERC '/ No exit called due to error condition.'
      TO G-TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END-IF
  ESCAPE ROUTINE /* do nothing if error in preceeding step
END-IF
MOVE BY NAME PRINTOUT      TO #PRINTOUT
MOVE BY NAME ACTIVE-REPORT TO #ACTIVE-REPORT
MOVE BY NAME REPORT        TO #REPORT
RESET #SPOOL-ATTR-EXTENDED
RESIZE DYNAMIC #SPOOL-ATTR-EXTENDED TO 0
FOR-EXT. FOR #I = 1 TO 120
  IF AR-SPOOL-ATTR-EXTENDED (#I) = ' '
    ESCAPE BOTTOM (FOR-EXT.)
  END-IF
  COMPRESS #SPOOL-ATTR-EXTENDED AR-SPOOL-ATTR-EXTENDED (#I)
    TO #SPOOL-ATTR-EXTENDED LEAVING NO
END-FOR
IF #TRACING
  COMPRESS 'Calling NOMEX014 with extended spool-attributes:'
    #SPOOL-ATTR-EXTENDED TO G-TRACE-MSG
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
END-IF
IF G-TRACE > 1
  RMSETTIM.FUNCTION := 'S'
  PERFORM RMSETTIM-SETTIME RMSETTIM
END-IF
CALLNAT 'NOMEX014' #PRINTOUT #ACTIVE-REPORT #REPORT #SPOOL-ATTR-EXTENDED
  NOMEX014-ERROR-CODE NOMEX014-ERROR-TEXT
G-NATRP-ERC := NOMEX014-ERROR-CODE
G-NATRP-ERT := NOMEX014-ERROR-TEXT
IF G-TRACE > 1
  G-TRACE-MSG := 'CPU consumed by user exit NOMEX014:'
  PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  RMSETTIM.FUNCTION := 'G'
  PERFORM RMSETTIM-SETTIME RMSETTIM
  PERFORM XXRLOG-WRITE-LOG 'T' RMSETTIM.MSG
END-IF
*
IF #TRACING
  IF G-NATRP-ERC = 0
    G-TRACE-MSG := 'NOMEX014 ended with no errors.'
    PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  ELSE
    COMPRESS 'NOMEX014 ended with error fields:'
      G-NATRP-ERC-A G-NATRP-ERT TO G-TRACE-MSG
    PERFORM XXRLOG-WRITE-LOG 'T' G-TRACE-MSG
  END-IF
END-IF
*
END-SUBROUTINE /* CALL-NOMEX014
*
************************************************************************
DEFINE SUBROUTINE GET-FLAGS
************************************************************************
FIND (1) USER-EXITS WITH M-MONITOR-ID = 'API-DEFS'
  FOR #I = 1 TO 20
    IF M-NOMEXIT-ACTIVE (#I) = 'Y'
      +G-NOMEXIT-ACTIVE (#I) := TRUE
    ELSE
      +G-NOMEXIT-ACTIVE (#I) := FALSE
    END-IF
  END-FOR
END-FIND
*
END-SUBROUTINE /* GET-FLAGS
*
************************************************************************
DEFINE SUBROUTINE CALL-IT
************************************************************************
DECIDE ON FIRST ACTIVE-REPORT.AR-CURRENT-LOCATION
  VALUE 'S'
    CALLNAT 'RMARFLSN' RMARFL-PARMS FLUSH-PARMS G-LINE-PARMS #SKIP-PAGES
      G-NATRP-ERC G-NATRP-ERT
  VALUE 'D'
    CALLNAT 'RMARFLDN' RMARFL-PARMS FLUSH-PARMS G-LINE-PARMS #SKIP-PAGES
      G-NATRP-ERC G-NATRP-ERT
  NONE /*SU8
    COMPRESS 'invalid location:' ACTIVE-REPORT.AR-CURRENT-LOCATION
      TO G-NATRP-ERT
    PERFORM ERROR-HANDLING
END-DECIDE
IF G-NATRP-ERC = 4605 /*:1: :2: (show error) see XXUX---N SU8
  FLUSH-ERROR := TRUE
END-IF
IF G-NATRP-ERC NE 0
  IF FLUSH-ERROR /*SU8: all other errors ignored Ü?
    PERFORM ERROR-HANDLING
    ESCAPE ROUTINE
  END-IF
  G-LINE-CURRENT := 1
  RESET G-NATRP-ERC G-NATRP-ERT
END-IF
*
END-SUBROUTINE /* CALL-IT
*
************************************************************************
ON ERROR
************************************************************************
  PERFORM ERROR-HANDLING
*
END-ERROR
*
END
