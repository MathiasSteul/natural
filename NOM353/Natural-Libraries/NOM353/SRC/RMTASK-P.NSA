DEFINE DATA PARAMETER
/* >Natural Source Header 000000
/* :Mode S
/* :CP
/* <Natural Source Header
* ***********************************************************************
*   PDA RMTASK-p for subpgm RMTASKID
*
*   Maintenace
*   User YYYY-MM-DD itrac                      desc
*   ---- ---------- -----------------------------------------------------
*   SU1  2021-04-16 NOMALL-2454      avoid     NAT1305 if DBID > 32767
* ***********************************************************************
1 RMTASK-P
  2 FUNCTION (A1)
  2 TASK-ID (A16)
  2 REDEFINE TASK-ID
    3 #COMMON-PRODNAME (A3)
    3 #COMMON-DBID (P5)
    3 #COMMON-FNR (P5)
    3 #COMMON-SUFFIX (A3)
    3 REDEFINE #COMMON-SUFFIX
      4 #COMMON-SUBTASK-NUMBER (N3)
  2 REDEFINE TASK-ID
    3 #RMTASK-PRODNAME (A3)
    3 #RMTASK-SUBTASK-NUMBER (I1)
    3 #RMTASK-DBID (B2) /*SU1 was I2
    3 #RMTASK-FNR (B2) /*SU1 was I2
  2 NOM-DBID (N5)
  2 REDEFINE NOM-DBID
    3 NOM-DBID-A (A5)
  2 NOM-FNR (N5)
  2 REDEFINE NOM-FNR
    3 NOM-FNR-A (A5)
  2 SUBTASK-NUMBER (N2)
  2 REDEFINE SUBTASK-NUMBER
    3 SUBTASK-NUMBER-A (A2)
  2 ERC (N4)
  2 ERT (A250)
* **End of PDA RMTASK-P *************************************************
END-DEFINE
