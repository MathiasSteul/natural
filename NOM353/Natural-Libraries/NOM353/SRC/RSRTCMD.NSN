* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* RSRTCMD   SORT COMMAND TABLE FOR COMMAND PROCESSOR
*
* SJU 00-05-31 P(179982) 60 COMMANDS INSTEAD OF 50
*
* ----------------------------------------------------------------------
DEFINE DATA
PARAMETER
1 #OBJ(60)                           /* WAS 50 SJU P(179982)
  2 #OBJ-T(A12)
  2 #OBJ-N(N2)
LOCAL
1 #SORT
  2 #OBJ-T(A12)
  2 #OBJ-N(N2)
1 #N(P2)
1 I(I1)
1 J(I2)
1 #MIN(A12)
1 #IMIN(I2)
END-DEFINE
FOR I 60 TO 1 STEP -1                /* WAS 50 SJU P(179982)
  IF #OBJ.#OBJ-T(I) NE ' '
    MOVE I TO #N
    ESCAPE BOTTOM
  END-IF
END-FOR
IF #N = 0 ESCAPE ROUTINE END-IF
FOR I 1 #N
  MOVE 'ZZZZZZ' TO #MIN
  FOR J I TO #N
    IF #OBJ.#OBJ-T(J) <= #MIN
      MOVE #OBJ.#OBJ-T(J) TO #MIN
      MOVE J TO #IMIN
      MOVE BY NAME #OBJ(I) TO #SORT
      MOVE BY NAME #OBJ(#IMIN) TO #OBJ(I)
      MOVE BY NAME #SORT TO #OBJ(#IMIN)
    END-IF
  END-FOR
END-FOR
END
