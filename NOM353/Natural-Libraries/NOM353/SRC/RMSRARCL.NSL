DEFINE DATA LOCAL
/* >Natural Source Header 000000
/* :Mode S
/* :CP
/* <Natural Source Header
*   RMSR---L- Source Attribute       Definition
*
*   Maintenance
*   uuu yy-mm-dd s(999999) ...
*   mrs 94-03-01 s(999999) BS2 added
*   gw  94-12-29 s(999999) NAF timest      amp; #naf-time not always unique
*   mrs 95-01-31 s(218167) change que       uesort sequence
*   JVD 98-09-14 P(164220) NOM141
*   gw  98-10-23 s(999999) rename dbi       d,fnr (N3) fields to -OLD, keep
*                          them in to        becompatible with old data.
*   gw  98-10-23 s(999999)   comment        outNAF-IDENT-A
*   sju 02-11-04 NOM221    Long recor       ds(Jes2 only)
*   SJU 05-02-08 NOM31     LONG RECOr        DS
*   NOM3107 SUPPORT 7 BYTE JOBNUMBRS
*   XSETGGR 2005-11-28 P(271774) MORE   THAN40POWER SEGMENTS
*   xsetggr 2007-05-02 NOM3201 Support 5 byte node numbers
*   RAYA 2012-08-21    NOMALL-78               DISABLE LONG RECORDS
*   SU1  2020-01-03 NOMALL-2370 new  field:NAF:OUTPUT -store as attr.
*   SU2  2024-03-07 ES-34613         NOM 3.6:  Remove power
*   ---------------------------------      -----------------------------------
1 #ARC-SOURCE-ATTRIBUTES (A250)
*   ---------------------------------      -----------------------------------
*   CMASPOOL
*   ---------------------------------      -----------------------------------
1 REDEFINE #ARC-SOURCE-ATTRIBUTES
  2 #CMASPOOL-IDENT (A63)
  2 REDEFINE #CMASPOOL-IDENT
    3 #CMASPOOL-SID (A4) /* system id
    3 #CMASPOOL-DSKEY (B8) /* tod clock of first open
    3 #CMASPOOL-SEQNO (I4) /* sequence number
  2 #CMASPOOL-OWNNM (A8) /* file name
  2 #CMASPOOL-DEST (A8) /* destination
  2 #CMASPOOL-VERSION (A2) /* version from monitor default
*   ---------------------------------      -----------------------------------
*   NOM Data Base (Copy Files)
*   ---------------------------------      -----------------------------------
1 REDEFINE #ARC-SOURCE-ATTRIBUTES
  2 #NOMDB-IDENT (A63)
  2 REDEFINE #NOMDB-IDENT
    3 #NOMDB-FILE-IDENT (A16)
    3 #NOMDB-ID (P10)
  2 #NOMDB-DBID-OLD (N3)
  2 #NOMDB-FNR-OLD (N3)
  2 #NOMDB-DBID (N5)
  2 #NOMDB-FNR (N5)
* **SU2 POWER: #POWER-...
*   ---------------------------------      -----------------------------------
*   JES2/JES3 Spool Queue Entry
*   ---------------------------------      -----------------------------------
1 REDEFINE #ARC-SOURCE-ATTRIBUTES
  2 #JES-QUEUE-IDENT (A63)
  2 REDEFINE #JES-QUEUE-IDENT
    3 #JES-QUEUE-NODE (N5)
    3 REDEFINE #JES-QUEUE-NODE
      4 #JES-QUEUE-NODE-A (A5)
    3 #JES-QUEUE-JOB-NAME (A8)
    3 #JES-QUEUE-JOB-NUMBER (N7)
    3 REDEFINE #JES-QUEUE-JOB-NUMBER
      4 #JES-QUEUE-JOB-NUMBER-A (A7)
    3 #JES-QUEUE-GROUP-ID (A20)
*   ---------------------------------      -----------------------------------
*   JES2/JES3 Spool File
*   ---------------------------------      -----------------------------------
1 REDEFINE #ARC-SOURCE-ATTRIBUTES
  2 #JES-IDENT (A63)
  2 REDEFINE #JES-IDENT
    3 #JES-NODE (N5)
    3 REDEFINE #JES-NODE
      4 #JES-NODE-A (A5)
    3 #JES-JOB-NAME (A8)
    3 #JES-JOB-NUMBER (N7)
    3 REDEFINE #JES-JOB-NUMBER
      4 #JES-JOB-NUMBER-A (A7)
    3 #JES-TYPE (A2)
    3 #JES-DATA-SET-KEY (N7)
  2 #JES-PROCNAME (A8)
  2 #JES-STEPNAME (A8)
  2 #JES-DDNAME (A8)
  2 #JES-DATA-SET (N5)
  2 #JES-LONG-REC (A1)
  2 #JES-REP-FORMAT (A1)
*   ---------------------------------      -----------------------------------
*   seq. File VSE
*   ---------------------------------      -----------------------------------
1 REDEFINE #ARC-SOURCE-ATTRIBUTES
  2 #FVSE-IDENT (A63)
  2 REDEFINE #FVSE-IDENT
    3 #FVSE-NODE (N5)
    3 REDEFINE #FVSE-NODE
      4 #FVSE-NODE-A (A5)
    3 #FVSE-VOLSER (A6)
    3 #FVSE-DSNAME (A44)
  2 #FVSE-RECFM (A2)
  2 #FVSE-LRECL (N5)
  2 #FVSE-BLKSIZE (N5)
  2 #FVSE-REP-FORMAT (A1)
*   ---------------------------------      -----------------------------------
*   Natural Advanced Facilities
*   ---------------------------------      -----------------------------------
1 REDEFINE #ARC-SOURCE-ATTRIBUTES
  2 #NAF-IDENT (A63)
  2 REDEFINE #NAF-IDENT
    3 #NAF-TIME (A15)
    3 #NAF-DBID-OLD (N3)
    3 #NAF-FNR-OLD (N3)
    3 #NAF-USER-ID (A8)
    3 #NAF-PNR (N2)
    3 #NAF-TIMESTAMP-1 (N10) /* left 4 bytes of *TIMESTMP
    3 #NAF-TIMESTAMP-2 (N10) /* right 4 byte of *TIMESTMP
    3 #NAF-DBID (N5)
    3 #NAF-FNR (N5)
  2 #NAF-NATPGM (A8)
  2 #NAF-NATLIB (A8)
  2 #NAF-FORM (A8)
  2 #NAF-PROFILE (A8)
  2 #NAF-COPIES (N3)
  2 #NAF-NAME (A8)
  2 #NAF-DISP (A1)
  2 #NAF-DEST (A8)
  2 #NAF-OUTPUT (A8) /*SU1
*   ---------------------------------      -----------------------------------
*   seq. File MVS
*   ---------------------------------      -----------------------------------
1 REDEFINE #ARC-SOURCE-ATTRIBUTES
  2 #FMVS-IDENT (A63)
  2 REDEFINE #FMVS-IDENT
    3 #FMVS-NODE (N5)
    3 REDEFINE #FMVS-NODE
      4 #FMVS-NODE-A (A5)
    3 #FMVS-DSNAME (A44)
  2 #FMVS-RECFM (A3)
  2 #FMVS-LRECL (N5)
  2 #FMVS-BLKSIZE (N5)
  2 #FMVS-VOLSER (A6)
  2 #FMVS-REP-FORMAT (A1)
*   ---------------------------------      -----------------------------------
*   seq. File BS2000 added
*   ---------------------------------      -----------------------------------
1 REDEFINE #ARC-SOURCE-ATTRIBUTES
  2 #FBS2-IDENT (A63)
  2 REDEFINE #FBS2-IDENT
    3 #FBS2-NODE (N5)
    3 REDEFINE #FBS2-NODE
      4 #FBS2-NODE-A (A5)
    3 #FBS2-DSNAME (A54)
  2 #FBS2-RECFM (A5)
  2 #FBS2-RECSIZE (N5)
  2 #FBS2-BLKSIZE (N5)
  2 #FBS2-FILE-TYPE (A8)
  2 #FBS2-REP-FORMAT (A1)
*   ---------------------------------      -----------------------------------
*   SEQ. FILE UNIX
*   ---------------------------------      -----------------------------------
1 REDEFINE #ARC-SOURCE-ATTRIBUTES
  2 #UNIX-IDENT (A63)
  2 REDEFINE #UNIX-IDENT
    3 #UNIX-NODE-NAME (A16)
    3 #UNIX-FILE-SPEC (A47)
  2 #UNIX-REP-FORMAT (A1)
  2 #UNIX-FILETYPE (A10)
*   ---------------------------------      -----------------------------------
*   DIRECT INPUT
*   ---------------------------------      -----------------------------------
1 REDEFINE #ARC-SOURCE-ATTRIBUTES
  2 #DI-IDENT (A63)
  2 REDEFINE #DI-IDENT
    3 #DI-RPC-USER (A8)
    3 #DI-FILENAME (A26)
    3 #DI-FILETYPE (A10)
    3 #DI-TIMESTMP (A19) /* *DATI-*TIME
  2 #DI-CC-TYPE (B1)
  2 #DI-REP-FORMAT (A1)
* **End of LDA RMSRARCL *************************************************
END-DEFINE
