* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* --------------------------------------------------------------------
* Subprogram  NOUILS-N
* Version    2.2.1
* Function   NOM API User Interface List
*
* Maintenance:
* XSETHZ  2002-03-17 created
* XSETGGR 2002-06-07 change the name of subroutine
* XSETHZ  2008-07-23 p(307577) use full name of ES-APP-SERVER-LIBRARY
* SU1     2016-10-18 NOM3.5
** --------------------------------------------------------------------
DEFINE DATA
PARAMETER USING ESMCNT-A
PARAMETER USING ESMINP-A
PARAMETER USING ESMWORKA
PARAMETER USING NOUILS-A
************************************************************************
LOCAL USING NADA2000
LOCAL USING NAD-MSG
LOCAL USING NAD-FLD
LOCAL
1 NRM-MONITOR VIEW OF NRM-MONITOR
  2 M-MONITOR-ID         (A20) /*SU1 was A10
  2 REDEFINE  M-MONITOR-ID
    3 #PREFIX            (A6)
    3 #INTERFACE         (N3)
  2  M-VERSION           (A60)
  2  M-CUSTOM-APPL       (A250/1:1)
  2  REDEFINE  M-CUSTOM-APPL
    3 #NOMUSR-ATTR-DEF   (5)
      4 #NOMUSR-TYPE     (A1)
      4 #NOMUSR-PROMPT   (A20)
      4 #NOMUSR-OFFSET   (N3)
      4 #NOMUSR-LENGTH   (N3)
      4 #NOMUSR-GENERIC  (A1)
      4 #NOMUSR-VAR      (A8)
      4 #NOMUSR-ORDER    (N2)
1 #MONITOR-ID-S          (A10)
1 REDEFINE  #MONITOR-ID-S
  2 #PREFIX-S            (A6)
  2 #INTERFACE-S         (N3)
1 #MONITOR-ID-E          (A10)
1 REDEFINE  #MONITOR-ID-E
  2 #PREFIX-E            (A6)
  2 #INTERFACE-E         (N3)
1 #I                     (I4)
1 #I2                    (I4)
1 #IMAX                  (I4)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
NADA2000.OBJECT-KIND := 'U'
NADA2000.OPT-INSERT-DYN := FALSE
NADA2000.OPT-LANGUAGE := ES-LANGUAGE
COMPRESS ES-APP-SERVER-LIBRARY 'U' TO NADA2000.LIBRARY LEAVING NO
*
RESET ES-RC ES-NUMBER ES-SORTKEY ES-SORTORDER ES-STARTINDEX
ES-OPTION-COUNT := 0
#IMAX := 125
ES-FIELD-COUNT := 7
NOUILS-FIELD-LENGTH(1) := 3
NOUILS-FIELD-LENGTH(2) := 60
NOUILS-FIELD-LENGTH(3:7) := 20
ES-EOF := 'X'
RESET ES-NUMBER
#PREFIX-S := #PREFIX-E := 'NOMUSR'
#INTERFACE-E := 999
IF ES-NEXT-KEY-PARM(1) NE ' '
  #INTERFACE-S := VAL(ES-NEXT-KEY-PARM(1))
ELSE
  #INTERFACE-S := 0
END-IF
PERFORM READ-UI
*
************************************************************************
* End of main line (now subroutines):
************************************************************************
*
**********************************************************************
DEFINE SUBROUTINE READ-UI
**********************************************************************
READ NRM-MONITOR
    WITH M-MONITOR-ID = #MONITOR-ID-S THRU #MONITOR-ID-E
  PERFORM DATA-TO-PDA
END-READ
*
END-SUBROUTINE /* READ-UI
*
**********************************************************************
DEFINE SUBROUTINE DATA-TO-PDA
**********************************************************************
ADD 1 TO #I2
IF #I2 > #IMAX
  ES-NEXT-KEY-PARM(1) := #INTERFACE
  ES-NUMBER := #IMAX
  RESET ES-EOF
  ESCAPE BOTTOM
END-IF
NOUILS-INTERFACE   (#I2)     := #INTERFACE
NOUILS-DESCRIPTION (#I2)     := M-VERSION
NOUILS-PROMPT      (#I2,1:5) := #NOMUSR-PROMPT(1:5)
IF ES-FUNCTION = 'LS2'
  FOR #I = 1 TO 5
    IF NOUILS-PROMPT(#I2,#I) IS (N4)
      NADA2000.ERROR-NUMBER := VAL(NOUILS-PROMPT(#I2,#I))
      CALLNAT 'NATA2000' NADA2000 NATA2000.EXTENDED-PARMS
        NAD-MSG NAD-FLD
      NOUILS-PROMPT(#I2,#I) := SHORT-MSG
    END-IF
  END-FOR
END-IF
ES-NUMBER := #I2
*
END-SUBROUTINE /* DATA-TO-PDA
*
END
