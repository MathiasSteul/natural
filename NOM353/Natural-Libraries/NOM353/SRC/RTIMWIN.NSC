* <Natural Source Header
* RTIMWIN - please wait window - avoid NAT1009 (MADIO)
*   used vars: 1 #SCAN-RECORDS (I4) / 1 #SCAN-LIMIT (I4)
*
* SU5     2023-06-13 ES-33831    changed from time to adabas calls
*
************************************************************************
DEFINE SUBROUTINE #WAIT
************************************************************************
ADD 1 TO #SCAN-LIMIT
IF #SCAN-LIMIT < 3000 /*good enough ?
  ESCAPE ROUTINE
END-IF
ADD #SCAN-LIMIT TO #SCAN-RECORDS
RESET #SCAN-LIMIT
SET CONTROL 'WC5L30B10/25F'
SET CONTROL 'N'
INPUT USING MAP 'RTIMWIN&' /*#SCAN-RECORDS
SET CONTROL 'WMB'
*
END-SUBROUTINE /*#WAIT
** End of copycode RTIMWIN *********************************************
