* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* Member    NOMRNB
* Function  Set new run number
*
* Maintenance
* uuu yy-mm-dd s(999999) ...
* SU1     2014-03-05 NOMALL-1281 show last update user+date
* ----------------------------------------------------------------------
DEFINE DATA LOCAL
1 CONTROL-RECORD VIEW OF NRM-REPORTS-NEW
  2 R-REPNAME
  2 R-LASTRNB
  2 R-IDENT-WRITER
  2 R-SEPNO
  2 R-LAST-UPDATE      /*SU1
  2 R-LAST-UPDATE-USER /*SU1
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
SET KEY ALL
*
REP. REPEAT
  FIND CONTROL-RECORD WITH R-REPNAME = 'NOM-CONTROL-REC'
*
    IF NO RECORDS FOUND
      R-REPNAME      := 'NOM-CONTROL-REC'
      R-LASTRNB      := 10000
      R-IDENT-WRITER := 'DUMMY'
      R-LAST-UPDATE      := *TIMX /*SU1
      R-LAST-UPDATE-USER := *USER /*SU1
      STORE CONTROL-RECORD
    END-NOREC
*
    INPUT (AD=MILT'_') '*** Set new run number for Nom ***'
      // 'Run Number:' R-LASTRNB / / '(Press a PF key to stop)'
    IF *PF-KEY NE 'ENTR'
      ESCAPE BOTTOM (REP.)
    END-IF
*
    IF R-LASTRNB = 99999999999          /* xsetggr NOM3201 changed
      R-LASTRNB := 1
      ADD 1 TO R-SEPNO                   /* one more time around
    ELSE
      ADD 1 TO R-LASTRNB
    END-IF
*
    R-LAST-UPDATE      := *TIMX /*SU1
    R-LAST-UPDATE-USER := *USER /*SU1
    UPDATE
    END TRANSACTION
*
  END-FIND
END-REPEAT
*
END
