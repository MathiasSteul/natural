* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* PROGRAM     RGRANT-N
* FUNCTION    GET USER ACCESS LEVEL ON AN OBJECT
*
* Maintenance
* xsiszha 2000-08-01 (CE7461) Extend Report and Bundle Names
* ----------------------------------------------------------------------
DEFINE DATA PARAMETER
1 P-USERID                    (A8)
1 P-TYPE                      (A1)
1 P-NAME                      (A25)
1 P-GRANTED                   (L)
1 P-OPTIONS                   (A1/1:6)
************************************************************************
LOCAL USING VGRANT-L
LOCAL
1 LIST VIEW OF NRM-DISTRIBUTION-LIST
  2 D-LIST-NAME
*
1 #GR-SUPER                   (A34)
1 REDEFINE #GR-SUPER
  2 #GR-T                     (A1)
  2 #GR-U                     (A8)
  2 #GR-N                     (A25)
1 #USERID                     (A8)
*
END-DEFINE
*
************************************************************************
* Main line
************************************************************************
*
#GR-T := P-TYPE
#GR-N := P-NAME
#GR-U := P-USERID
#USERID := P-USERID
RESET P-GRANTED
* ---  check USERID
FIND-GR. FIND  GRANTS  WITH  GR-SUPER = #GR-SUPER
  P-GRANTED := TRUE
  P-OPTIONS (*) := GR-OPTION(*)
  ESCAPE ROUTINE
END-FIND
* ---  CHECK DISTRIBUTION LIST
FNDDL. FIND LIST WITH D-USER-LIST = #USERID
  #GR-U := P-USERID := D-LIST-NAME
  FIND-GR2. FIND  GRANTS  WITH  GR-SUPER = #GR-SUPER
    P-GRANTED := TRUE
    P-OPTIONS(*) := GR-OPTION(*)
    ESCAPE ROUTINE
  END-FIND
END-FIND
* ---  check PUBLIC
#GR-U := P-USERID := 'PUBLIC'
FIND-GR1. FIND  GRANTS  WITH  GR-SUPER = #GR-SUPER
  P-GRANTED := TRUE
  P-OPTIONS(*) := GR-OPTION(*)
  ESCAPE ROUTINE
END-FIND
*
END
