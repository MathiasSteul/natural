* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
* -------------------------------------------------------------------- *
* RMSTX--T
*
* Function:
* ---------
* Test RMSTX--N using a test script nomtst.bsh
*
* ----------------------------------------------------------------------
DEFINE DATA
LOCAL     USING RMSTX--P
LOCAL
1 #T        (I2)
*
END-DEFINE
* ------------------------------------ main -------------------------- *
* #TRACE := TRUE
FORMAT LS=132

PERFORM START
#T := 5
CALLNAT 'NAT00031' #T
PERFORM STATUS
PERFORM START
PERFORM STATUS
PERFORM KILL
PERFORM STATUS

* ------------------------------------ end main ---------------------- *
* ------------------------------------ sub --------------------------- *
DEFINE SUBROUTINE START
RESET STX-PARMS
STX-TASK-NAME    := 'NOMTST.BSH'
STX-FUNCTION     := 'START'
STX-START-SCRIPT := '$NOMDIR/$NOMVERS/nomtst.bsh'
STX-LOGFILE      := '$EOM_WORK/nomtst.log'
CALLNAT 'RMSTX--N' STX-PARMS
END TRANSACTION
#T               := 1
PERFORM TRACE-IT
END-SUBROUTINE

DEFINE SUBROUTINE STATUS
RESET STX-PARMS
STX-TASK-NAME    := 'NOMTST.BSH'
STX-FUNCTION     := 'STATUS'
CALLNAT 'RMSTX--N' STX-PARMS
END TRANSACTION
#T               := 5
PERFORM TRACE-IT
END-SUBROUTINE

DEFINE SUBROUTINE KILL
RESET STX-PARMS
STX-TASK-NAME    := 'NOMTST.BSH'
STX-FUNCTION     := 'KILL'
CALLNAT 'RMSTX--N' STX-PARMS
END TRANSACTION
#T               := 1
PERFORM TRACE-IT
END-SUBROUTINE

DEFINE SUBROUTINE TRACE-IT
SET CONTROL 'N'
WRITE (AD=OI)
  '=' STX-FUNCTION
  '=' STX-TASK-NAME      (AL=10)
  '=' STX-TASK-STATUS            /
  '=' STX-START-SCRIPT   (AL=70) /
  '=' STX-LOGFILE        (AL=70) /
  '=' STX-MESSAGE-CODE
  '=' STX-ERROR-CODE             /
  '=' STX-MESSAGE        (AL=70) /
  '=' STX-ERROR-TEXT     (AL=70) /
  '=' #T
WRITE '-------------------------------------------'
CALLNAT 'NAT00031' #T
END-SUBROUTINE

* ------------------------------------ end sub ----------------------- *
END
