<?xml version="1.0" encoding="UTF-8"?>
<natpage natsinglebyte="true" natkcheck="true" xmlns:njx="http://www.softwareag.com/njx/njxMapConverter">
    <titlebar valueprop="titletxt">
    </titlebar>
    <header>
        <button name="Exit" method="onExit">
        </button>
    </header>
    <pagebody>
        <itr>
            <label name="OS">
            </label>
            <field valueprop="output">
            </field>
        </itr>
        <itr>
            <textgrid2 griddataprop="lines" width="100%" height="150" selectprop="selected">
                <column name="Line" property="column" width="100" njx:natname="li">
                </column>
            </textgrid2>
        </itr>
        <itr>
            <button name="OK" method="onOk">
            </button>
        </itr>
        <itr>
            <textgrid2 griddataprop="outlines" width="100%" height="150" selectprop="selected">
                <column name="Sel" property="column" width="100">
                </column>
            </textgrid2>
        </itr>
    </pagebody>
    <statusbar>
    </statusbar>
</natpage>
